            "relationship": true,
            "role": "relationship"
          },
          "portId": "affects"
        }
      ],
      "visible": true,
      "showLabel": false,
      "data": {
        "title": "A page node is either blocked outright or visually and interactively limited",
        "statement": "Running inside a browser, Twilite can only show another web page through an iframe. Most real sites refuse to be framed at all (X-Frame-Options, CSP frame-ancestors), and the ones that do allow it still cannot be scaled, composited with the rest of the canvas, or interacted with the way a native node can.",
        "impact": "A \"page as a node\" today is either flatly unavailable for most of the real web, or a fragile, visually-boxed-in citizen of the graph rather than a real one.",
        "urgency": "Not urgent on a deadline — this is a fresh brainstorm, prompted by wanting page-nodes to actually work, not a scheduled commitment.",
        "definitionKey": "idea-problem",
        "_classBinding": {
          "key": "idea-problem",
          "sourceRef": "github://mikemartinez1974/public/templates/idea-template/classes/nodes/idea-problem.node-class.node",
