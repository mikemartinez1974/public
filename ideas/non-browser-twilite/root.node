      "id": "non-browser-twilite-idea-problem",
      "type": "idea-problem",
      "label": "Browser Sandboxing Makes Pages Second-Class Nodes",
      "root": false,
      "position": {
        "x": -940,
        "y": -160
      },
      "width": 400,
      "height": 300,
      "ports": [
        {
          "id": "root",
          "label": "root",
          "direction": "bidirectional",
          "dataType": "any",
          "angle": 210
        },
        {
