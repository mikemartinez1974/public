      "data": {
        "title": "Public Consumption Should Be Free; Repository-Backed Production Should Be Paid",
        "statement": "Twilite should remain an open browser for public graphs while requiring a subscription for the integrated production environment: GitHub account connection, repository browsing, authenticated graph resolution, persistence, commits, publishing, template installation, graph mutation, agents, and MCP authoring.",
        "status": "framed",
        "confidence": "plausible",
        "notes": "The durable github:// address remains usable for public graph navigation. The paywall protects the managed production workflow, not the readability of the graph format.",
        "identity": {
          "graphId": "public-browsing-paid-production"
        },
        "classRef": "github://mikemartinez1974/public/templates/idea-template/classes/nodes/idea.node-class.node"
