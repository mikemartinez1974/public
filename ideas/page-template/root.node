    {
      "id": "page-template-idea-proposed-approach",
      "type": "idea-proposed-approach",
      "label": "A Page Template With Named Piece Roles",
      "root": false,
      "position": {
        "x": 560,
        "y": -160
      },
      "width": 400,
      "height": 300,
      "ports": [
        {
          "id": "root",
          "label": "root",
          "direction": "bidirectional",
          "dataType": "any",
          "angle": 210
        },
        {
          "id": "questioned-by",
          "key": "questioned-by",
          "label": "questioned by",
          "direction": "bidirectional",
          "dataType": "any",
          "angle": 0,
          "role": "relationship",
          "allowedEdgeTypes": [
            "reference"
          ],
          "metadata": {
            "relationship": true,
            "role": "relationship"
          }
        },
        {
          "id": "advances",
          "key": "advances",
          "label": "advances",
          "direction": "bidirectional",
          "dataType": "any",
          "angle": 180,
          "role": "relationship",
          "allowedEdgeTypes": [
            "reference"
          ],
          "metadata": {
            "relationship": true,
            "role": "relationship"
          }
        }
      ],
      "visible": true,
      "showLabel": false,
      "data": {
        "title": "A page template with named piece roles",
        "description": "Create a page template with a class for each piece role. Each piece exposes its own view, and a region is a piece that gives graph content a titled place on the page background. The template builds the page's document by stacking the pieces' views and returns the stack in one view node for the consumer page to render, so the consumer sees one view and the author works with many pieces. Order is graph order where order applies, and a sequence edge type is a candidate for the rest. Pieces that lead somewhere (routes, utilities) are portals, so navigation stays graph-native. One Handler and Method keep the stacked view current, following the pattern already used for the Edge Class template. Begin with the roles the inventory found and grow the catalog only when a real page needs another.",
        "differentiator": "It makes the page an organized graph without inventing a page engine: pieces are ordinary nodes, ordering and refresh reuse what already works, and the result is still a normal document view any client can show.",
        "definitionKey": "idea-proposed-approach",
        "_classBinding": {
          "key": "idea-proposed-approach",
          "sourceRef": "github://mikemartinez1974/public/templates/idea-template/classes/nodes/idea-proposed-approach.node-class.node",
          "defaults": {
            "ports": [
              {
                "id": "root",
                "key": "root",
                "label": "root",
                "direction": "bidirectional",
                "dataType": "any",
                "angle": 180
              }
            ],
            "data": {
              "presentation": {
                "glyph": {
                  "kind": "icon",
                  "name": "Route"
                }
              }
            }
          }
        },
        "_bridge": {
          "classKey": "idea-proposed-approach",
          "classRef": "github://mikemartinez1974/public/templates/idea-template/classes/nodes/idea-proposed-approach.node-class.node",
