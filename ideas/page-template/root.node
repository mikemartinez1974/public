    {
      "id": "page-template-idea-question",
      "type": "idea-question",
      "label": "How Are Pieces Ordered?",
      "root": false,
      "position": {
        "x": -1180,
        "y": 700
      },
      "width": 400,
      "height": 300,
      "ports": [
        {
          "id": "root",
