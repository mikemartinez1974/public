      ],
      "visible": true,
      "showLabel": false,
      "data": {
        "title": "What exists today",
        "findings": "A graph exposes views at four semantic levels (badge, icon, summary, detail) and a document payload for a full-page presentation, and a Declaration names its default view, summary view, icon view and landing surface. Content nodes hold markdown, html, svg and other kinds. The Public Arrival Template, the Wikipedia Article template and the Question-Driven Explanation template each build a kind of page from their own classes, with no shared notion of a page or of piece roles. The Edge Class template keeps stored views current from Property, node and structure events. The Arrival landing note also states the edge convention that a parent's bottom connects to a child's top.",
        "sourceUrl": "github://mikemartinez1974/public/templates/public-arrival-template/root.node",
        "sourceType": "prototype",
        "definitionKey": "idea-research",
        "_classBinding": {
