    {
      "id": "page-template-idea-problem",
      "type": "idea-problem",
      "label": "Full Pages Are One Big Document",
      "root": false,
      "position": {
        "x": -940,
        "y": -160
      },
      "width": 400,
      "height": 300,
      "ports": [
        {
          "id": "root",
          "label": "root",
