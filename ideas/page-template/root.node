            "reference"
          ],
          "metadata": {
            "relationship": true,
            "role": "relationship"
          },
          "portId": "affects"
        }
      ],
      "visible": true,
      "showLabel": false,
      "data": {
        "title": "Full pages are one big document",
        "statement": "A graph's full page view is authored today as a single document: one content node, or one view, holding the whole page. The parts of a page (its masthead, its sections, the list of places to go next) have no identity of their own. They cannot be edited, reordered, reused or reviewed one at a time, and an agent has to rewrite the whole document to change one part. The Public Arrival Template shows the pieces a page needs but only for one kind of page, an arrival page. Graphs that do want regions build them by hand: the gallery makes regions out of markdown headings and connected portals, and the workboard makes lanes out of markdown headings with ordinally labeled edges, each with its own conventions.",
        "impact": "Every new page starts from a blank document, pages that should look related drift apart, and the pieces that matter most, like where a visitor can go next, are buried in prose.",
        "urgency": "medium",
        "definitionKey": "idea-problem",
        "_classBinding": {
          "key": "idea-problem",
          "sourceRef": "github://mikemartinez1974/public/templates/idea-template/classes/nodes/idea-problem.node-class.node",
