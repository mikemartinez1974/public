    {
      "id": "page-template-research-inventory",
      "type": "idea-research",
      "label": "Inventory of Page Parts",
      "root": false,
      "position": {
        "x": 260,
        "y": 1160
      },
      "width": 400,
      "height": 300,
      "ports": [
        {
          "id": "root",
          "label": "root",
          "direction": "bidirectional",
          "dataType": "any",
          "angle": 210
