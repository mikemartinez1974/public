      ],
      "visible": true,
      "showLabel": false,
      "data": {
        "title": "How does graph content belong to a region?",
        "question": "When a region gives graph content a place on the page background, is membership expressed by an edge from the region to the content, by the content's position inside the region, or by both?",
        "status": "open",
        "answer": "Open. The gallery and the workboard both use edges from the heading to the content, with labeled relationships (exhibits, features, opens) or ordinal ones (now · 1). Position alone never decides membership in either. Edges are graph-native and survive layout changes, so they are the lean.",
        "definitionKey": "idea-question",
        "_classBinding": {
