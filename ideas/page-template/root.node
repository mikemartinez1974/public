          "role": "relationship",
          "allowedEdgeTypes": [
            "reference"
          ],
          "metadata": {
            "relationship": true,
            "role": "relationship"
          }
        }
      ],
      "visible": true,
      "showLabel": false,
      "data": {
        "title": "How are pieces ordered?",
        "question": "Is a page's order the order of the nodes in the graph, a chain of precedes edges, or an explicit ordered list held by the page?",
        "status": "open",
        "answer": "Graph order is the rule where order applies. Ordering by edge is already in use: the workboard sequences its items with ordinal edge labels (\"now · 1\", \"then · 3\"), and the arrival classes use edge classes (arrival.contains, arrival.offers-route). A sequence edge type is a candidate, not yet a decision. Edge lanes are provisional in the model, so a new persistent schema should wait until the prototype shows graph order is not enough.",
        "definitionKey": "idea-question",
        "_classBinding": {
          "key": "idea-question",
          "sourceRef": "github://mikemartinez1974/public/templates/idea-template/classes/nodes/idea-question.node-class.node",
