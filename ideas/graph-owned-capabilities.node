      "visible": true,
      "showLabel": false,
      "data": {
        "title": "Thin Host, Capable Graphs",
        "description": "Twilite exposes generic authorized reads, atomic graph mutations, event delivery, rendering, and transient persistence protection. Graph-owned scripts combine those primitives into domain capabilities.",
        "differentiator": "Behavior remains inspectable and portable with the graph, while security-sensitive authority stays centralized in the host.",
        "definitionKey": "idea-proposed-approach",
        "_classBinding": {
          "key": "idea-proposed-approach",
          "sourceRef": "github://mikemartinez1974/public/templates/idea-template/classes/nodes/idea-proposed-approach.node-class.node"
