      ],
      "visible": true,
      "showLabel": false,
      "data": {
        "title": "Capabilities Can Belong to Graphs",
        "statement": "Reusable product capabilities should be authored in graphs and graph-owned JavaScript whenever a small, secure set of generic Twilite primitives can support them.",
        "status": "testing",
        "confidence": "supported",
        "notes": "The host owns safe execution, authorization, atomic mutations, events, rendering, and persistence boundaries. The graph owns domain rules, state transitions, placement, controls, and composition.",
        "definitionKey": "idea",
        "_classBinding": {
          "key": "idea",
          "sourceRef": "github://mikemartinez1974/public/templates/idea-template/classes/nodes/idea.node-class.node"
        },
