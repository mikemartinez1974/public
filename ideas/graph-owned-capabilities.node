      "visible": true,
      "showLabel": false,
      "data": {
        "title": "Product Features Drift Into App-Specific Code",
        "statement": "A domain feature implemented directly in React becomes part of one application build instead of a portable, inspectable graph capability.",
        "impact": "Users, template authors, and agents lose the ability to carry behavior with the graph, while the host accumulates feature-specific machinery.",
        "urgency": "high",
        "definitionKey": "idea-problem",
        "_classBinding": {
          "key": "idea-problem",
