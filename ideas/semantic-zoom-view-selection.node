      "data": {
        "title": "Scaling Cards Does Not Preserve Meaning",
        "statement": "Geometrically shrinking a detailed card makes text illegible and controls unusable before the node stops occupying visual attention.",
        "impact": "Authors lose control over what survives at distance, while readers see either cluttered miniatures or generic placeholders.",
        "urgency": "high",
        "definitionKey": "idea-problem",
