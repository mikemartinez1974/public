      "data": {
        "title": "Fixed Semantic Bands Are Too Rigid",
        "statement": "Viewport occupancy already drives semantic zoom, but every graph is forced through the same Glyph, Icon, Summary, Detail, and expanded thresholds.",
        "impact": "Graphs cannot choose the number, timing, or exact authored representations appropriate to their content. A title-card graph and a dense working graph therefore collapse according to the same global schedule.",
        "urgency": "high",
        "definitionKey": "idea-problem",
