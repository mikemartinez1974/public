      "data": {
        "title": "Semantic Zoom Selects Meaningful Views",
        "statement": "A node should change authored view as zoom changes: glyph at 0–25%, icon at 25–50%, and a selected summary, card, or detail view at 50–100%.",
        "status": "framed",
        "confidence": "plausible",
        "notes": "Zoom becomes a request for the amount and kind of meaning the canvas can support, not merely a request to scale pixels.",
        "definitionKey": "idea",
