      "data": {
        "title": "Three Semantic Zoom Bands",
        "description": "Resolve 0–25% to glyph, 25–50% to icon, and 50–100% to the selected authored content view. The selected content view may be summary, card, or detail according to node, graph, or user choice.",
        "differentiator": "The lower bands are universal and predictable, while the content band respects the views already declared by each node class instead of imposing one universal card.",
        "definitionKey": "idea-proposed-approach",
        "_classBinding": {
          "key": "idea-proposed-approach",
          "sourceRef": "github://mikemartinez1974/public/templates/idea-template/classes/nodes/idea-proposed-approach.node-class.node"
