      "visible": true,
      "showLabel": false,
      "data": {
        "title": "Views Own Their Semantic Zoom Ranges",
        "statement": "Each authored View may own its viewport-occupancy threshold. Twilite collects the Views that are actually present, orders them by threshold, and selects only from that collection before unfolding the graph.",
        "status": "proposed",
        "confidence": "plausible",
        "notes": "This is an attempted extension of the semantic-zoom model. A View may tune its range but does not need to: its exposed Icon, Summary, or Detail role supplies a conventional default. Before any authored View becomes eligible, Twilite renders a generated graph minimap, then an authored or generic glyph at the smallest band. Ports, portals, handles, and bridge apertures remain stable boundary interfaces.",
        "definitionKey": "idea",
        "_classBinding": {
          "key": "idea",
          "sourceRef": "github://mikemartinez1974/public/templates/idea-template/classes/nodes/idea.node-class.node"
