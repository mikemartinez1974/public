    {
      "id": "semantic-zoom-view-selection-instructions",
      "type": "markdown",
      "label": "Reading This Idea",
      "position": {
        "x": -220,
        "y": 700
      },
      "width": 760,
      "height": 300,
      "ports": [
        {
          "id": "root",
          "label": "root",
