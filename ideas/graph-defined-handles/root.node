    {
      "id": "graph-defined-handles-instructions",
      "type": "markdown",
      "label": "Proposed Handle Definition Graph",
      "root": false,
      "position": {
        "x": -220,
        "y": 700
      },
      "width": 900,
      "height": 760,
      "ports": [
        {
          "id": "root",
          "label": "root",
          "direction": "bidirectional",
          "dataType": "any",
          "angle": 210
        },
        {
          "id": "top",
          "label": "top",
