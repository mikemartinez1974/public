    {
      "id": "semantic-zoom-architecture-detail-view",
      "type": "view",
      "label": "Semantic Zoom Has No Middle Ground Detail",
      "root": false,
      "position": {
        "x": -1500,
        "y": -1580
      },
      "width": 420,
      "height": 280,
      "ports": [
        {
          "id": "root",
