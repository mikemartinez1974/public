    {
      "id": "semantic-zoom-architecture-idea-problem",
      "type": "idea-problem",
      "label": "Four Mechanisms, One Name",
      "root": false,
      "position": {
        "x": -940,
        "y": -160
      },
      "width": 400,
      "height": 300,
      "ports": [
        {
          "id": "root",
