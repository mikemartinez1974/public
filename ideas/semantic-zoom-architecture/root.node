{
  "fileVersion": "1.0",
  "metadata": {
    "title": "Semantic Zoom Has No Middle Ground",
    "description": "Four separate mechanisms in Twilite share the name \"semantic zoom\" and do not share a model. None of them ever repacks a layout: content scales, a node's own view swaps, and a whole graph collapses to an icon, but a graph's authored positions never move. A sparsely laid-out graph looks the same fraction empty at every zoom, right up until it vanishes into one icon.",
    "graphId": "semantic-zoom-architecture",
    "version": "0.1.0",
    "kind": "graph",
    "created": "2026-09-22T01:02:31.056Z",
    "modified": "2026-09-22T01:28:13.176Z",
    "author": "",
    "tags": [
      "idea",
      "semantic-zoom",
      "layout",
      "workspace",
      "zoom"
    ],
    "preferredViewer": "https://dev.twilite.zone"
  },
