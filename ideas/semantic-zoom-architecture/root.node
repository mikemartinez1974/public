      "data": {
        "title": "nodeContentScale.js scales content, not layout",
        "observation": "nodeZoom() and zoomsFor() in components/NodeGraph/nodeContentScale.js compute a scale factor applied to a node's rendered content by FixedNode's ScaledContent (a CSS transform). Neither reads or writes node.position. Zooming out therefore shrinks every node by the same factor without ever closing the gaps between them.",
        "kind": "behavior",
        "strength": "strong",
        "definitionKey": "idea-evidence",
