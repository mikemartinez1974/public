    {
      "id": "semantic-zoom-architecture-idea-research",
      "type": "idea-research",
      "label": "What Zoomable-Interface Research Already Found",
      "root": false,
      "position": {
        "x": -1780,
        "y": 700
      },
      "width": 400,
      "height": 300,
      "ports": [
        {
          "id": "root",
