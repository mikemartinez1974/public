          }
        }
      ],
      "visible": true,
      "showLabel": false,
      "data": {
        "title": "A repack operation can be defined without breaking what content scaling already does",
        "statement": "Content scaling (nodeContentScale.js) already keeps a node's content proportional to its frame. A separate repack step, that changes node.position to close gaps at low occupancy, would need to leave that alone and only ever be a view-time transform, never a write to the authored graph, or every zoom would dirty the document. — Refuted by Michael: there is no reflow at all. A node needing special arrangement to display is a sign the wrong view is showing, not a case for repacking positions.",
        "importance": "critical",
        "status": "refuted",
        "definitionKey": "idea-assumption",
        "_classBinding": {
          "key": "idea-assumption",
          "sourceRef": "github://mikemartinez1974/public/templates/idea-template/classes/nodes/idea-assumption.node-class.node",
