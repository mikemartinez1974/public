    {
      "id": "semantic-zoom-architecture-idea-risk",
      "type": "idea-risk",
      "label": "A Canvas That Moves Things Without Being Asked",
      "root": false,
      "position": {
        "x": -220,
        "y": -780
      },
      "width": 400,
      "height": 300,
      "ports": [
