          }
        }
      ],
      "visible": true,
      "showLabel": false,
      "data": {
        "title": "Repacking on zoom could rearrange a graph out from under someone",
        "description": "If any level of a unified model is allowed to repack positions, a person could zoom out and back in and find their graph laid out differently than they left it — the one thing classical zoomable-interface design treats as close to sacred: position stays put, only appearance changes.",
        "likelihood": "medium",
        "impact": "high",
        "mitigation": "Treat any repack as a view-time transform only, never written back to the saved graph, and settle the spatial-memory question from an actual hand-built example (see the prototype next step) before building anything automatic.",
        "definitionKey": "idea-risk",
        "_classBinding": {
          "key": "idea-risk",
          "sourceRef": "github://mikemartinez1974/public/templates/idea-template/classes/nodes/idea-risk.node-class.node",
