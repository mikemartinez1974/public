      "data": {
        "title": "Each mechanism keeps its own numbers",
        "observation": "graphViewPresentation.js keys bands on an occupancy percent (0-100, LEVEL_MIN_PERCENT). viewResolution.js keys the view sequence on a continuous 0-3 resolution (FULL_GRAPH_RESOLUTION). Individual nodes carry a data._semanticLevel string (detail/summary/icon). nodeContentScale.js reads a plain camera zoom number. occupancyResolution() in viewResolution.js converts between two of the four, but nothing unifies all four.",
        "kind": "observation",
        "strength": "moderate",
        "definitionKey": "idea-evidence",
        "_classBinding": {
