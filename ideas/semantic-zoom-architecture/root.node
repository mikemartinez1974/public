    {
      "id": "semantic-zoom-architecture-idea-question",
      "type": "idea-question",
      "label": "Does Repacking Break Spatial Memory?",
      "root": false,
      "position": {
        "x": -1180,
        "y": 700
      },
      "width": 400,
      "height": 300,
      "ports": [
        {
          "id": "root",
