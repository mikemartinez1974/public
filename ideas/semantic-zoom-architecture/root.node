    {
      "id": "semantic-zoom-architecture-idea-proposed-approach",
      "type": "idea-proposed-approach",
      "label": "One Threshold Model, and an Honest Answer on Reflow",
      "root": false,
      "position": {
        "x": 560,
        "y": -160
      },
      "width": 400,
      "height": 300,
      "ports": [
        {
          "id": "root",
          "label": "root",
          "direction": "bidirectional",
          "dataType": "any",
          "angle": 210
        },
        {
          "id": "questioned-by",
          "key": "questioned-by",
          "label": "questioned by",
          "direction": "bidirectional",
          "dataType": "any",
          "angle": 0,
          "role": "relationship",
          "allowedEdgeTypes": [
            "reference"
          ],
          "metadata": {
            "relationship": true,
            "role": "relationship"
          }
        },
        {
          "id": "advances",
          "key": "advances",
          "label": "advances",
          "direction": "bidirectional",
          "dataType": "any",
          "angle": 180,
          "role": "relationship",
          "allowedEdgeTypes": [
            "reference"
          ],
          "metadata": {
            "relationship": true,
            "role": "relationship"
          }
        }
      ],
      "visible": true,
      "showLabel": false,
      "data": {
        "title": "Name one occupancy/resolution model the four mechanisms read from, then decide whether any of them may move a position",
        "description": "Do for these four mechanisms what the wheel contract did for five scattered wheel listeners this session: write down one ordered, tested table of what each zoom situation means, and make every consumer (content scale, per-node level, workspace bands, view sequence) read the same numbers instead of keeping its own. Separately, and only once that is settled, decide on purpose whether any level is allowed to repack node positions to fit the room it has, since that is a real change to how a canvas behaves, not a wiring cleanup.",
        "differentiator": "It treats the two problems as different sizes. Unifying the vocabulary is a cleanup like the wheel contract was: mechanical, testable, low-risk. Reflowing positions is a real design decision about whether this canvas ever moves things without being asked, and it gets decided in the open rather than smuggled in as a side effect of a threshold tweak.",
        "definitionKey": "idea-proposed-approach",
        "_classBinding": {
          "key": "idea-proposed-approach",
          "sourceRef": "github://mikemartinez1974/public/templates/idea-template/classes/nodes/idea-proposed-approach.node-class.node",
