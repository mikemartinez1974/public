          "allowedEdgeTypes": [
            "reference"
          ],
          "metadata": {
            "relationship": true,
            "role": "relationship"
          }
        }
      ],
      "visible": true,
      "showLabel": false,
      "data": {
        "title": "Semantic zooming and space-scale diagrams (Pad++, Bederson and Perlin)",
        "findings": "The term \"semantic zooming\" comes from Perlin and Fox's Pad system and Bederson's Pad++: objects change appearance, not just size, as they are magnified, and \"space-scale diagrams\" were built specifically to analyze and design viewing trajectories through a zoomable space. In that lineage, position is treated as fixed across scale; what changes is which representation of an object is shown at a given size. Reflow-on-zoom, where position itself changes with scale, is not part of the classical model and is closer to a force-directed or constraint layout re-run than to zooming.",
        "sourceUrl": "https://en.wikipedia.org/wiki/Zooming_user_interface",
        "sourceType": "other",
        "definitionKey": "idea-research",
        "_classBinding": {
          "key": "idea-research",
          "sourceRef": "github://mikemartinez1974/public/templates/idea-template/classes/nodes/idea-research.node-class.node",
