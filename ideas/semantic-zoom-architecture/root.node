    {
      "id": "semantic-zoom-architecture-idea-alternative",
      "type": "idea-alternative",
      "label": "Just Tighten Every Template’s Layout By Hand",
      "root": false,
      "position": {
        "x": 1160,
        "y": -160
      },
      "width": 400,
      "height": 300,
      "ports": [
