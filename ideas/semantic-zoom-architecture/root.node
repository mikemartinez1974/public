          "role": "relationship",
          "allowedEdgeTypes": [
            "reference"
          ],
          "metadata": {
            "relationship": true,
            "role": "relationship"
          }
        }
      ],
      "visible": true,
      "showLabel": false,
      "data": {
        "title": "If a graph compacts at a smaller zoom, does a reader lose their place when they zoom back in?",
        "question": "The classical semantic-zoom model keeps position fixed for a reason: people build a spatial memory of a canvas. Does that hold for Twilite's graphs, or does structure (what connects to what) matter more than exact placement here?",
        "status": "answered",
        "answer": "Answered by Michael: when a node needs special arrangement to display itself, that means you are looking at the wrong view of the graph, not that the graph needs rearranging. Positions never move; a different authored view is shown instead. Spatial memory is preserved because nothing repositions.",
        "definitionKey": "idea-question",
        "_classBinding": {
          "key": "idea-question",
          "sourceRef": "github://mikemartinez1974/public/templates/idea-template/classes/nodes/idea-question.node-class.node",
