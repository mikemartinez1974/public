        "purpose": "The periodic table is a view. Chemistry is the graph.",
        "renderShape": {"kind": "svg"},
        "svg": "<svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 620 330\" role=\"img\" aria-label=\"Graph-Native Chemistry\"><defs><linearGradient id=\"g\" x1=\"0\" y1=\"0\" x2=\"1\" y2=\"1\"><stop offset=\"0\" stop-color=\"#0f172a\"/><stop offset=\"1\" stop-color=\"#134e4a\"/></linearGradient></defs><rect x=\"5\" y=\"5\" width=\"610\" height=\"320\" rx=\"30\" fill=\"url(#g)\" stroke=\"#5eead4\" stroke-width=\"3\"/><text x=\"38\" y=\"62\" fill=\"#99f6e4\" font-family=\"system-ui,sans-serif\" font-size=\"13\" font-weight=\"800\">ELEMENTS · VIEWS · BONDS</text><text x=\"38\" y=\"110\" fill=\"white\" font-family=\"system-ui,sans-serif\" font-size=\"36\" font-weight=\"850\">Graph-Native Chemistry</text><rect x=\"50\" y=\"150\" width=\"72\" height=\"72\" rx=\"12\" fill=\"#164e63\" stroke=\"#67e8f9\"/><rect x=\"170\" y=\"150\" width=\"72\" height=\"72\" rx=\"12\" fill=\"#164e63\" stroke=\"#67e8f9\"/><text x=\"86\" y=\"198\" text-anchor=\"middle\" fill=\"white\" font-family=\"system-ui,sans-serif\" font-size=\"30\" font-weight=\"900\">C</text><text x=\"206\" y=\"198\" text-anchor=\"middle\" fill=\"white\" font-family=\"system-ui,sans-serif\" font-size=\"30\" font-weight=\"900\">O</text><line x1=\"122\" y1=\"178\" x2=\"170\" y2=\"178\" stroke=\"white\" stroke-width=\"4\"/><line x1=\"122\" y1=\"190\" x2=\"170\" y2=\"190\" stroke=\"white\" stroke-width=\"4\"/><text x=\"300\" y=\"172\" fill=\"#ccfbf1\" font-family=\"system-ui,sans-serif\" font-size=\"18\">One element library</text><text x=\"300\" y=\"205\" fill=\"#ccfbf1\" font-family=\"system-ui,sans-serif\" font-size=\"18\">many periodic views</text><text x=\"38\" y=\"285\" fill=\"#99f6e4\" font-family=\"system-ui,sans-serif\" font-size=\"17\">Typed edges turn graph structure into chemistry.</text></svg>",
