      ],
      "visible": true,
      "showLabel": false,
      "data": {
        "title": "Canonical Elements, Reusable Views, Semantic Bonds",
        "description": "Create one reusable graph per element, build periodic-table surfaces that reference those element resources under different organizing logics, and represent molecule bond order and bond kind directly on edge instances/types.",
        "differentiator": "The same source material can support the standard periodic table, alternative periodic layouts, molecule graphs, and eventually reactions without flattening every relationship into a generic line.",
        "definitionKey": "idea-proposed-approach",
        "_classBinding": {
          "key": "idea-proposed-approach",
          "sourceRef": "github://mikemartinez1974/public/templates/idea-template/classes/nodes/idea-proposed-approach.node-class.node"
