      "data": {
        "title": "Static Chemistry Representations Hide the Underlying Graph",
        "statement": "Periodic tables, molecule diagrams, and chemistry reference pages are usually delivered as separate fixed representations even though they reuse the same entities and relationships.",
        "impact": "Learners, explorers, and graph authors cannot easily move from an element to alternative periodic arrangements, molecules, reactions, and relationship semantics in one navigable system.",
        "urgency": "low",
        "definitionKey": "idea-problem",
        "_classBinding": {
