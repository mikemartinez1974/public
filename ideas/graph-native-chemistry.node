      "data": {
        "title": "Scientific Semantics Outgrow Generic Graph Primitives",
        "description": "Chemistry introduces domain details such as aromaticity, resonance, stereochemistry, formal charge, orbital models, and reaction mechanisms that may not map cleanly onto a minimal generic node/edge vocabulary.",
        "likelihood": "medium",
        "impact": "medium",
        "mitigation": "Start with a deliberately narrow bond-order prototype and add domain semantics only when a real example requires them.",
        "definitionKey": "idea-risk",
