      "data": {
        "title": "Keep Chemistry as Static Specialized Views",
        "description": "Build a conventional periodic table and molecule diagrams as dedicated static components without canonical graph resources or semantic bond edges.",
        "tradeoffs": "Simpler rendering, but it duplicates information and misses the demonstration that one connected knowledge model can support many views.",
        "definitionKey": "idea-alternative",
