      ],
      "visible": true,
      "showLabel": false,
      "data": {
        "title": "Do for nodes what the edge template does for edges",
        "statement": "A node template is a graph you fill in: Properties for identity (key, label, meaning), rows for its fields, ports and views, and a Method that keeps its views current. Every node class then has a graph you can open and read.",
        "status": "spark",
        "confidence": "plausible",
        "notes": "The edge class template already turns Properties into a class and draws it. The pattern exists and works; the question is how much of it carries over.",
        "definitionKey": "idea",
        "_classBinding": {
          "key": "idea",
          "sourceRef": "github://mikemartinez1974/public/templates/idea-template/classes/nodes/idea.node-class.node",
