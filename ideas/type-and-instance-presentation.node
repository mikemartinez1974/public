      "visible": true,
      "showLabel": false,
      "data": {
        "title": "Separate Type Identity From Instance Presentation",
        "statement": "The Legend should identify creatable types with stable glyphs, while Elements should present existing node and edge instances through authored or data-derived compact views.",
        "status": "framed",
        "confidence": "plausible",
        "notes": "This same separation sharpens the content primitive: a Document is the durable thing, while Markdown, sanitized HTML, and plain text are formats it can render.",
        "definitionKey": "idea",
        "_classBinding": {
          "key": "idea",
          "sourceRef": "github://mikemartinez1974/public/templates/idea-template/classes/nodes/idea.node-class.node"
        },
