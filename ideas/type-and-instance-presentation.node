      "visible": true,
      "showLabel": false,
      "data": {
        "title": "A Type-and-Instance Presentation Contract",
        "description": "Create a Document primitive with an explicit markdown, html, or text format; render only stable type glyphs in the Legend; resolve authored node.web.icon surfaces in Elements with glyph fallback; and render compact edge specimens from each edge instance's class, color, stroke, direction, arrowheads, and label.",
        "differentiator": "The contract gives each surface one job without forcing edge classes into rectangular cards: node instances may author icon views, while an edge's natural compact view is a rendered line specimen.",
        "definitionKey": "idea-proposed-approach",
        "_classBinding": {
          "key": "idea-proposed-approach",
          "sourceRef": "github://mikemartinez1974/public/templates/idea-template/classes/nodes/idea-proposed-approach.node-class.node"
        },
        "_bridge": {
          "classKey": "idea-proposed-approach",
          "classRef": "github://mikemartinez1974/public/templates/idea-template/classes/nodes/idea-proposed-approach.node-class.node",
          "entryPort": "root",
          "kind": "node-class",
          "sourceRef": "github://mikemartinez1974/public/templates/idea-template/classes/nodes/idea-proposed-approach.node-class.node",
          "targetKind": "node-class"
        },
        "identity": {
          "graphId": "type-and-instance-presentation"
        }
      }
    },
