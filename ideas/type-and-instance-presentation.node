      "data": {
        "title": "Type Identity and Instance Content Are Blurred",
        "statement": "The Legend sometimes renders authored icon views and sometimes glyphs, Markdown is treated as a node identity instead of a document format, and edge instances have no visual representation in Elements.",
        "impact": "Authors cannot predict what each panel means, users see inconsistent visual language, and edges remain second-class objects during inspection.",
        "urgency": "high",
        "definitionKey": "idea-problem",
        "_classBinding": {
