    {
      "id": "graph-standardization-approach",
      "type": "idea-proposed-approach",
      "label": "Core, Profiles, and Composition Law",
      "root": false,
      "position": {
        "x": -100,
        "y": -280
      },
      "width": 460,
      "height": 260,
      "ports": [
        {
