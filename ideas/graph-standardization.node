        },
        {
          "id": "left",
          "label": "left",
          "direction": "bidirectional",
          "dataType": "value",
          "angle": 180
        }
      ],
      "visible": true,
      "showLabel": false,
      "data": {
        "title": "Universal Core Plus Family Profiles",
        "description": "Require one default declaration, one canonical Root Port, an intentional landing surface, explicit named surfaces, and meaningful authority edges. Add task-summary, collection, document, template, node-class, and edge-class requirements as separate profiles.",
        "differentiator": "The invariant core governs entry, identity, authority, and exposure; family profiles govern domain-specific behavior. Compatibility remains a runtime concern rather than an excuse for ambiguous new authoring.",
        "definitionKey": "idea-proposed-approach",
        "_classBinding": {
          "key": "idea-proposed-approach",
          "sourceRef": "github://mikemartinez1974/public/templates/idea-template/classes/nodes/idea-proposed-approach.node-class.node"
        },
        "_bridge": {
