      "visible": true,
      "showLabel": false,
      "data": {
        "title": "A Small Invariant Core",
        "statement": "Every durable Twilite graph should share a small declaration-first entry and authority contract, while graph-family profiles add only the capabilities appropriate to collections, tasks, templates, documents, and classes.",
        "status": "framed",
        "confidence": "medium",
        "notes": "The standard should make addressability, authority, and repair predictable without forcing every graph into one oversized schema.",
        "definitionKey": "idea",
        "_classBinding": {
          "key": "idea",
          "sourceRef": "github://mikemartinez1974/public/templates/idea-template/classes/nodes/idea.node-class.node"
