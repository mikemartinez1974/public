      "data": {
        "title": "Make the Standard Executable",
        "action": "Add machine-readable diagnostics and safe repair actions before enforcing stricter load behavior across the corpus.",
        "expectedEvidence": "Legacy graphs receive specific repairs; conforming graphs pass automatically; ambiguous public entries fail with actionable explanations.",
        "status": "todo",
        "definitionKey": "idea-next-step",
        "_classBinding": {
          "key": "idea-next-step",
          "sourceRef": "github://mikemartinez1974/public/templates/idea-template/classes/nodes/idea-next-step.node-class.node"
