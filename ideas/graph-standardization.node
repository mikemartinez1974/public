      "visible": true,
      "showLabel": false,
      "data": {
        "title": "Drift Creates Fragile Graphs",
        "statement": "Runtime rules, templates, class graphs, and existing authored graphs have evolved at different speeds. A graph can look correct yet fail navigation, class resolution, or reuse because an implicit contract changed.",
        "impact": "Failures propagate through portals and class instances; authors cannot tell whether content, declaration, surface, or runtime behavior is responsible.",
        "urgency": "high",
        "definitionKey": "idea-problem",
        "_classBinding": {
          "key": "idea-problem",
          "sourceRef": "github://mikemartinez1974/public/templates/idea-template/classes/nodes/idea-problem.node-class.node"
