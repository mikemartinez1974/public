      "data": {
        "title": "Convention and Runtime Inference",
        "description": "Keep authoring permissive and let the runtime infer roots, views, classes, and defaults from nearby nodes and payload conventions.",
        "tradeoffs": "Legacy graphs keep loading, but behavior remains mysterious, diagnostics stay weak, and agents cannot know which implicit rule will win.",
        "definitionKey": "idea-alternative",
