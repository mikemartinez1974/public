      ],
      "visible": true,
      "showLabel": false,
      "data": {
        "title": "Authors, Agents, Runtime, and Publishers",
        "description": "Human authors, codebase-free agents, template makers, class designers, runtime maintainers, and repository publishers all need one predictable graph contract.",
        "needs": "They need graphs to load, expose intentional surfaces, resolve classes, survive stricter validation, and remain repairable without reverse-engineering runtime assumptions.",
        "definitionKey": "idea-audience",
        "_classBinding": {
