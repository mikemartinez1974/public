          "angle": 90
        },
        {
          "id": "left",
          "label": "left",
          "direction": "bidirectional",
          "dataType": "value",
          "angle": 180
        }
      ],
      "visible": true,
      "showLabel": false,
      "data": {
        "title": "A Three-Layer Graph Standard",
        "description": "Layer 1 is a small invariant executable core: declaration, canonical root, exposed surfaces, valid handles, explicit authority, source ownership, and durable resolution. Layer 2 defines family profiles for task, idea, collection, template, class, document, and workboard graphs. Layer 3 provides advisory composition law for sections, semantic edges, density, splitting, summaries, navigation, and visual organization.",
        "differentiator": "Only the invariant core is universal. Family profiles add executable obligations for particular graph kinds, while composition guidance remains strong but adaptable enough to preserve local expression.",
        "definitionKey": "idea-proposed-approach",
        "_classBinding": {
          "key": "idea-proposed-approach",
          "sourceRef": "github://mikemartinez1974/public/templates/idea-template/classes/nodes/idea-proposed-approach.node-class.node"
        },
        "_bridge": {
          "classKey": "idea-proposed-approach",
