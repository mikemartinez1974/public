      "data": {
        "title": "What Does the Root Port Own? — Working Resolution",
        "question": "Should the Root Port normally own its presentation, delegate to an existing profile or summary port, or select a separate view node through an explicit consumption contract?",
        "status": "resolved",
        "answer": "The declaration owns the choice of canonical root. The Root Port owns a stable routing boundary and may delegate presentation to an existing profile, summary, or view surface through an explicit consumption contract. It does not need to own a duplicate card or expose internal handles.",
        "definitionKey": "idea-question",
        "_classBinding": {
