      "data": {
        "title": "Graph-Native Membrane Controls",
        "statement": "Let declaration defaults and authored membrane-control nodes define the silhouette of a graph-shaped node through inspectable graph structure.",
        "status": "framed",
        "confidence": "plausible",
        "notes": "Few controls produce parametric shapes; many controls approach explicit polygon or curve authorship. The silhouette should stay editable and persist as node structure.",
