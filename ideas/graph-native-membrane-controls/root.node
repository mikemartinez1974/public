      "visible": true,
      "showLabel": false,
      "data": {
        "title": "What Does One Control Mean?",
        "question": "Should one boundary control define a major-axis direction and magnitude for an ellipse, or should ellipse semantics require a second explicit control?",
        "status": "open",
        "answer": "A single point is not geometrically sufficient for an ellipse unless the contract interprets it as a directional control rather than merely a vertex.",
        "definitionKey": "idea-question",
        "_classBinding": {
