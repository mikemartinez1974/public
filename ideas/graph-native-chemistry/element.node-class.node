        "nodeClass": {
          "contractVersion": "1.0.0",
          "key": "element",
          "label": "Element",
          "meaning": "A chemical element as a durable chemical identity, independent of any particular periodic-table layout.",
          "description": "Stores a deliberately small set of element-level properties. Period, group, block, and table coordinates belong to periodic-table views rather than the element itself.",
          "requiredDataKeys": [
            "name",
            "symbol",
            "atomicNumber"
          ],
          "nodeDef": {
            "key": "element",
            "ref": "github://mikemartinez1974/public/ideas/graph-native-chemistry/element.node-class.node",
            "source": "local",
            "version": ">=0.1.0",
            "defaults": {
