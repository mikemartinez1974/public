        "nodeClass": {
          "contractVersion": "1.0.0",
          "key": "atom",
          "label": "Atom",
          "meaning": "An individual atom whose elemental identity comes from an Element reference and whose electron population defines its neutral or ionized state.",
          "description": "The atom is an instance-level chemical entity suitable for molecules and reactions. Element identity is referenced rather than duplicated. Proton count follows the referenced element. Isotope identity is optional. Electron count is authored because it may differ from proton count; net charge and shell occupancy are derived.",
          "requiredDataKeys": [
            "elementRef",
            "electronCount"
          ],
          "nodeDef": {
            "key": "atom",
            "ref": "github://mikemartinez1974/public/ideas/graph-native-chemistry/atom.node-class.node",
            "source": "local",
            "version": ">=0.2.0",
