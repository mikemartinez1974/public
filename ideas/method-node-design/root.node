      "visible": true,
      "showLabel": false,
      "data": {
        "title": "What happens after a Method fails is Handler composition policy",
        "statement": "A Method only knows it was invoked and what happened. Whether the next Method runs after a failure (continue, stop, retry, roll back, branch, call a failure handler) belongs to whatever composes the Methods, so the Method contract stays the same as policies grow. Continue-on-failure is a fine Handler default for now.",
        "importance": "medium",
        "status": "untested",
        "definitionKey": "idea-assumption",
        "_classBinding": {
          "key": "idea-assumption",
