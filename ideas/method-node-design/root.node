    {
      "id": "method-node-design-idea-problem",
      "type": "idea-problem",
      "label": "A Method Is a Script With a Nametag",
      "root": false,
      "position": {
        "x": -940,
        "y": -160
      },
      "width": 400,
      "height": 300,
      "ports": [
        {
          "id": "root",
