    {
      "id": "method-node-design-idea-research",
      "type": "idea-research",
      "label": "How Methods Run Today",
      "root": false,
      "position": {
        "x": -1780,
        "y": 700
      },
      "width": 400,
      "height": 300,
      "ports": [
        {
          "id": "root",
          "label": "root",
          "direction": "bidirectional",
          "dataType": "any",
          "angle": 210
        },
        {
          "id": "informs",
          "key": "informs",
          "label": "informs",
          "direction": "bidirectional",
          "dataType": "any",
          "angle": 0,
          "role": "relationship",
          "allowedEdgeTypes": [
            "reference"
          ],
          "metadata": {
            "relationship": true,
            "role": "relationship"
          }
        }
      ],
      "visible": true,
      "showLabel": false,
      "data": {
        "title": "How a Method receives input, runs, and reports",
        "findings": "A Method's source runs as the body of an async function in a sandboxed iframe and receives one api object. The return value is the result and a thrown error is the failure. api.invocation is a frozen copy of the host's run metadata: occurrence and event key and payload, Handler and Method ids, Method index and count, fragment, and the allowMutations and dry flags. Runs share one serial queue, each is limited to 200 calls and 100 mutations, and a run that exceeds 15 seconds fails and resets the runner. parameters is only a list of labels shown on the card: the Edge Class Template's Method declares eventPayload and reads it from api.invocation. The card's status comes from a window event and shows the last run of that Method, without saying which Handler or event caused it.",
        "sourceUrl": "github://TwiliteLLC/twilite/components/GraphEditor/Scripting/ScriptRunner.js",
        "sourceType": "runtime-inspection",
        "definitionKey": "idea-research",
        "_classBinding": {
          "key": "idea-research",
          "sourceRef": "github://mikemartinez1974/public/templates/idea-template/classes/nodes/idea-research.node-class.node",
