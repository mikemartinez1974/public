      "visible": true,
      "showLabel": false,
      "data": {
        "title": "api.invocation already describes an Invocation, without an identity",
        "observation": "The frozen api.invocation object the runner hands the source already carries the occurrence and root occurrence ids, the delivery id, the Handler, the Method and its position, the fragment, and the dry and mutation flags. It has no id of its own, so an Outcome or an attempted effect cannot be attached to one call. Occurrence emission already records its cause and root occurrence, so a Method that emits an event continues the chain, but only through the occurrence ids.",
        "kind": "code-inspection",
        "strength": "strong",
        "definitionKey": "idea-evidence",
        "_classBinding": {
          "key": "idea-evidence",
          "sourceRef": "github://mikemartinez1974/public/templates/idea-template/classes/nodes/idea-evidence.node-class.node",
