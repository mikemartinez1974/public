    {
      "id": "method-node-design-idea-evidence",
      "type": "idea-evidence",
      "label": "The Flag Does Not Gate Live Runs",
      "root": false,
      "position": {
        "x": -220,
        "y": 260
      },
      "width": 400,
      "height": 300,
      "ports": [
        {
          "id": "root",
          "label": "root",
          "direction": "bidirectional",
          "dataType": "any",
          "angle": 210
        },
        {
          "id": "supports",
          "key": "supports",
          "label": "supports",
          "direction": "bidirectional",
          "dataType": "any",
          "angle": 180,
          "role": "relationship",
          "allowedEdgeTypes": [
            "reference"
          ],
          "metadata": {
            "relationship": true,
            "role": "relationship"
          }
        }
      ],
      "visible": true,
      "showLabel": false,
      "data": {
        "title": "allowMutations only matters in dry runs",
        "observation": "In the host request handler, allowMutations is read at 13 sites. Twelve are the pattern \"if (isDry && !allowMutations) return simulated\", so they only apply to dry runs; the thirteenth refuses sendHandoff without it. A live updateNode or createNode is applied whether or not the Method has allowMutations set. The same handler is the single place every mutating call passes through: it lists them (createNode, createNodes, applyDeltas, composePort, sendHandoff, updateNode, updateView, deleteNode, deleteNodes, createEdge, deleteEdge) and counts them per run. The Handler editor nevertheless labels a Method without the flag \"Read-only execution\".",
        "kind": "code-inspection",
        "strength": "strong",
        "definitionKey": "idea-evidence",
        "_classBinding": {
          "key": "idea-evidence",
          "sourceRef": "github://mikemartinez1974/public/templates/idea-template/classes/nodes/idea-evidence.node-class.node",
