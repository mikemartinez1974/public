      ],
      "visible": true,
      "showLabel": false,
      "data": {
        "title": "A broad declaration reassures without limiting",
        "description": "A Method that declares \"update node\" with no target can still write to any node in scope, so a reviewer may read the declaration as safer than it is.",
        "likelihood": "medium",
        "impact": "high",
        "mitigation": "Let effects name target nodes, and show \"any node\" as a warning in the Handler's summary. Enforce at the host gate so a declaration is a limit and never only a description.",
        "definitionKey": "idea-risk",
