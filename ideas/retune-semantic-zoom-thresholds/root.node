      "visible": true,
      "showLabel": false,
      "data": {
        "title": "Content-Aware Thresholds Instead of One Global Scale",
        "description": "Instead of one shared occupancy scale for every instance, let thresholds vary by what’s actually being rendered — richly authored node.web.* HTML content may need to be much bigger on screen before detail earns its keep than a sparse handful of plain graph nodes does.",
        "tradeoffs": "More flexible and likely more correct, but turns four shared constants into a per-content-type policy — more surface area to design, tune, and keep predictable than adjusting the existing shared numbers.",
        "identity": {
          "graphId": "retune-semantic-zoom-thresholds"
        },
        "presentation": {
          "glyph": {
            "kind": "icon",
