      ],
      "visible": true,
      "showLabel": false,
      "data": {
        "title": "Widen Icon, Push Detail Toward Full Zoom",
        "description": "Raise the icon→summary boundary so icon covers more of the zoom range, and raise summary→detail (and detail→expanded) so detail only appears close to maximum zoom — matching the instinct that detail should sit near 3, the top of the camera’s range, rather than partway through it.",
        "differentiator": "A direct retune of WORKSPACE_PRESENTATION_THRESHOLDS (and the parallel LEVEL_MIN_PERCENT scale in graphViewPresentation.js) rather than a structural rewrite — the level system itself stays the same, only where each level starts changes.",
        "identity": {
          "graphId": "retune-semantic-zoom-thresholds"
        },
        "presentation": {
          "glyph": {
            "kind": "icon",
            "name": "Route"
