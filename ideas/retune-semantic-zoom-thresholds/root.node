          }
        },
        {
          "id": "affects",
          "key": "affects",
          "label": "affects",
          "direction": "bidirectional",
          "dataType": "any",
          "angle": 180,
          "role": "relationship",
          "allowedEdgeTypes": [
            "reference"
          ],
          "metadata": {
            "relationship": true,
            "role": "relationship"
          },
          "portId": "affects"
        }
      ],
      "visible": true,
      "showLabel": false,
      "data": {
        "title": "Detail Arrives Too Early, Icon Passes Too Fast",
        "statement": "Icon only spans occupancy 0.10–0.24 — a narrow band crossed almost immediately while zooming in, so it barely reads as a distinct level. Detail then starts at 0.48 occupancy, well below the 0.82 that triggers full expansion, so content reads as \"detailed\" long before the camera is actually close. The camera’s own zoom range (roughly 0.1–3, with fit() capping at 1.5) is not what these thresholds are keyed to — occupancy depends on content size too — so the felt result can diverge from what a raw zoom number would suggest.",
        "impact": "Zooming through the workspace feels like it skips a step: you leave glyph, barely see icon, and land in detail-level rendering before you meant to stop.",
        "urgency": "medium",
        "identity": {
          "graphId": "retune-semantic-zoom-thresholds"
        },
        "presentation": {
          "glyph": {
            "kind": "icon",
            "name": "ReportProblem"
          }
        },
        "classRef": "github://mikemartinez1974/public/templates/idea-template/classes/nodes/idea-problem.node-class.node"
      },
      "handles": [
