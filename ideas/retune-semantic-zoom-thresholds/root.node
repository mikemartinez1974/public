        "view": {
          "intent": "node",
          "payload": "node.web.detail"
        },
        "semanticLevel": "detail",
        "content": {
          "kind": "markdown",
          "value": "# Retune Semantic Zoom Thresholds\n\nThe workspace’s glyph/icon/summary/detail/expanded levels share one occupancy scale (WORKSPACE_PRESENTATION_THRESHOLDS: 0.10 / 0.24 / 0.48 / 0.82). Live use suggests icon’s band is too narrow and detail starts too early. This idea frames widening icon and pushing detail toward full zoom — and questions whether one shared scale is even the right model."
        },
        "interfaceContract": {
          "version": 1,
          "ownsContent": true,
          "surfaceDelegation": true
        },
        "identity": {
          "graphId": "retune-semantic-zoom-thresholds"
        }
      }
