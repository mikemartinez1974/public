      ],
      "visible": true,
      "showLabel": false,
      "data": {
        "title": "Retune Semantic Zoom Thresholds",
        "statement": "The occupancy thresholds that decide glyph/icon/summary/detail/expanded (WORKSPACE_PRESENTATION_THRESHOLDS in graphWorkspace.js: glyph<0.10, icon<0.24, summary<0.48, detail<0.82) are one shared scale for all content. Live use suggests icon’s band is too narrow to register as a resting state while zooming, and detail arrives well before a user feels genuinely close — it should hold off until much nearer full zoom.",
        "status": "framed",
        "confidence": "unproven",
        "notes": "Raised directly by Michael while reviewing the workspace persistence and camera-fit fixes made in the same session: \"detail should be much closer to 3... we aren’t spending enough time at icon size.\"",
        "identity": {
          "graphId": "retune-semantic-zoom-thresholds"
        },
        "presentation": {
          "glyph": {
            "kind": "icon",
            "name": "Lightbulb"
          }
        },
        "classRef": "github://mikemartinez1974/public/templates/idea-template/classes/nodes/idea.node-class.node"
      },
