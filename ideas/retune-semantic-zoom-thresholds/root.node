    {
      "id": "retune-semantic-zoom-thresholds-instructions",
      "type": "content",
      "label": "Sketch: Not Yet Confirmed",
      "position": {
        "x": -220,
        "y": 700
      },
      "width": 760,
      "height": 300,
      "ports": [
        {
          "id": "root",
