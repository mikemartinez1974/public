    {
      "id": "retune-semantic-zoom-thresholds-idea-problem",
      "type": "idea-problem",
      "label": "Detail Arrives Too Early, Icon Passes Too Fast",
      "position": {
        "x": -940,
        "y": -160
      },
      "width": 400,
      "height": 300,
      "ports": [
        {
          "id": "root",
          "label": "root",
          "direction": "bidirectional",
          "dataType": "any",
          "angle": 210
        },
        {
          "id": "motivates",
          "key": "motivates",
