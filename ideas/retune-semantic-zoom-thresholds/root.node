      "data": {
        "title": "Anyone Zooming Through the Workspace",
        "description": "Anyone panning/zooming across a multi-graph workspace, especially scanning several collapsed cards before committing to one — the case icon-level rendering exists for in the first place.",
        "needs": "A zoom range wide enough at icon level to comfortably scan and choose between cards, and a detail level that only takes over once they’ve actually zoomed in close, not as an early default.",
        "identity": {
