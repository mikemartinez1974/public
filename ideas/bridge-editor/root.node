      ],
      "visible": true,
      "showLabel": false,
      "data": {
        "title": "How do class scopes read in the Bridge Editor?",
        "question": "When a Bridge can expose or consume the events of a whole class, how does the editor show a class next to individual nodes without doubling every row?",
        "status": "open",
        "answer": "Group by class: a row for the class with its member count, and the members underneath. Choosing the class row covers members added later. This depends on class events crossing Bridges, which is the second next step of the Stroke Control idea (github://mikemartinez1974/public/ideas/stroke-control/root.node).",
        "definitionKey": "idea-question",
        "_classBinding": {
          "key": "idea-question",
          "sourceRef": "github://mikemartinez1974/public/templates/idea-template/classes/nodes/idea-question.node-class.node",
