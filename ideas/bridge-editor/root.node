      "visible": true,
      "showLabel": false,
      "data": {
        "title": "One Bridge Editor with role-shaped sections",
        "description": "Extend the hosted Bridge Editor. An Export Bridge shows Target, What it exposes (views, resources, declarations, and Events with a checkbox per event and per class), the effective exposure, and Status. An Import Bridge shows Target, What the neighbor exposes, Events with a Handler picker per event and per class, unresolved subscriptions with an explicit Remove, and Status. The Events section reads the neighbor live and writes only through the existing planners, so the Handler editor and the Bridge editor show one set of data. The Properties panel keeps a link to the Bridge Editor and nothing more.",
        "differentiator": "One home, one data path. The Bridge editor becomes the place the event model is authored, instead of a panel that happens to be open.",
        "definitionKey": "idea-proposed-approach",
        "_classBinding": {
          "key": "idea-proposed-approach",
          "sourceRef": "github://mikemartinez1974/public/templates/idea-template/classes/nodes/idea-proposed-approach.node-class.node",
