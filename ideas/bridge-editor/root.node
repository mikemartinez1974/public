      "id": "bridge-editor-idea-problem",
      "type": "idea-problem",
      "label": "Bridge Behavior Is Scattered",
      "root": false,
      "position": {
        "x": -940,
        "y": -160
      },
      "width": 400,
      "height": 300,
      "ports": [
        {
