      "visible": true,
      "showLabel": false,
      "data": {
        "title": "Port -> View -> Content",
        "description": "Introduce Content as a format-neutral primitive. Views may own Content inline or delegate to a Content node. Ports continue to own interfaces and their Views. New Markdown creation becomes a Content preset while legacy markdown nodes normalize read-only into the Content contract.",
        "differentiator": "It preserves simple authoring without confusing material, presentation, and connectivity, and it gives scripting one canonical structure to produce.",
        "definitionKey": "idea-proposed-approach",
        "_classBinding": {
          "key": "idea-proposed-approach",
          "sourceRef": "github://mikemartinez1974/public/templates/idea-template/classes/nodes/idea-proposed-approach.node-class.node"
