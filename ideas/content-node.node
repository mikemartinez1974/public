          "angle": 210
        },
        {
          "id": "top",
          "label": "top",
          "direction": "bidirectional",
          "dataType": "value",
          "angle": 270
        },
        {
          "id": "right",
          "label": "right",
          "direction": "bidirectional",
          "dataType": "value",
          "angle": 0
        },
        {
          "id": "bottom",
          "label": "bottom",
          "direction": "bidirectional",
          "dataType": "value",
          "angle": 90
        },
        {
          "id": "left",
          "label": "left",
          "direction": "bidirectional",
          "dataType": "value",
          "angle": 180
        }
      ],
      "visible": true,
      "showLabel": false,
      "data": {
        "title": "How Should Scripts Author Port, View, and Content Composition?",
        "question": "What is the smallest safe scripting API for declaring Ports, attaching or delegating Views, creating Content, and connecting the structure without allowing scripts to produce half-valid interfaces?",
        "status": "answered",
        "answer": "Expose composePort as a first-class validate-first scripting operation. It accepts stable author IDs, direction and type acceptance, Detail and Summary ownership or delegation, optional Content, optional Port behavior, and graph position. It computes ordinary nodes, edges, and Declaration surfaces; validates the whole composition; then commits the result atomically. Re-running the same specification upserts the same stable records. Interaction behavior scripts remain separately bounded by Port authority and return mutation intent rather than receiving unrestricted graph access.",
        "definitionKey": "idea-question",
        "_classBinding": {
          "key": "idea-question",
          "sourceRef": "github://mikemartinez1974/public/templates/idea-template/classes/nodes/idea-question.node-class.node"
        },
        "_bridge": {
          "classKey": "idea-question",
          "classRef": "github://mikemartinez1974/public/templates/idea-template/classes/nodes/idea-question.node-class.node",
          "entryPort": "root",
          "kind": "node-class",
          "sourceRef": "github://mikemartinez1974/public/templates/idea-template/classes/nodes/idea-question.node-class.node",
          "targetKind": "node-class"
        },
        "identity": {
          "graphId": "content-node"
        },
        "notes": "Resolution: composePort is a validated convenience operation over visible graph structure, not a hidden representation. Validation happens before mutation; stable IDs make the operation idempotent; the output remains inspectable and editable as ordinary graph records.",
        "resolutionPath": "First-class composePort operation -> validate complete proposed graph -> atomically upsert ordinary Port/View/Content nodes, semantic edges, and Declaration exposure."
      }
    },
