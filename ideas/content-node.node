      "data": {
        "title": "Make Content a Primitive",
        "statement": "Replace format-specific Markdown authoring with one Content primitive that supports the same content families as Views while remaining separate from presentation and interface concerns.",
        "status": "framed",
        "confidence": "supported",
        "notes": "Governing composition: Port -> View -> Content. Inline Content remains available for small cases; delegated Content nodes provide structural reuse.",
        "definitionKey": "idea",
        "_classBinding": {
          "key": "idea",
          "sourceRef": "github://mikemartinez1974/public/templates/idea-template/classes/nodes/idea.node-class.node"
