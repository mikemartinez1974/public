      "visible": true,
      "showLabel": false,
      "data": {
        "title": "Automations Live Outside the Graph They Operate On",
        "statement": "Tools like n8n, Zapier, and Make are separate products from whatever content or data they automate. Someone already using Twilite as a graph-native home for ideas, content, and tasks has to leave it entirely to build an automation, and that automation then lives disconnected from the graphs it reads or writes — not inspectable, not portable, not addressable the way everything else in Twilite is.",
        "impact": "Every automation becomes a second system to maintain, outside the durable-address, agent-and-human-editable model the rest of Twilite already provides.",
        "urgency": "low",
        "identity": {
          "graphId": "n8n-style-automation-template"
        },
        "presentation": {
          "glyph": {
            "kind": "icon",
            "name": "ReportProblem"
          }
        },
