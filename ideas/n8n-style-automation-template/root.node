      ],
      "visible": true,
      "showLabel": false,
      "data": {
        "title": "An n8n-Style Automation Template for Twilite",
        "statement": "Twilite already models everything as typed nodes connected by typed edges. n8n models a workflow the same way: trigger nodes, action nodes, and branching nodes connected by edges that carry data (n8n calls it an \"item\": an array of JSON objects, optionally with binary data). A workflow-automation template could let someone build and run n8n-style automations as ordinary Twilite graphs — durable, addressable, agent-and-human-editable — instead of a separate disconnected tool.",
        "status": "framed",
        "confidence": "unproven",
        "notes": "First-pass reasoning from one line Michael gave. No target scope, execution model, or node set confirmed yet — see the open question and alternative below before treating any of this as decided.",
        "identity": {
          "graphId": "n8n-style-automation-template"
        },
        "presentation": {
          "glyph": {
            "kind": "icon",
            "name": "Lightbulb"
          }
        },
        "classRef": "github://mikemartinez1974/public/templates/idea-template/classes/nodes/idea.node-class.node"
      },
