      "visible": true,
      "showLabel": false,
      "data": {
        "title": "A Workflow Node-Class Kit on Existing Machinery",
        "description": "A template (matching the idea-template / question-driven-explanation-template pattern) supplying trigger node classes (webhook, schedule, manual), action node classes (call an API, transform data, read/write a Twilite graph), and branching node classes (if/switch, merge) — connected by typed edges carrying data, the same role n8n’s \"items\" play. Twilite ports already carry a dataType field; n8n’s own typed connections may map onto that directly rather than needing a new type system.",
        "differentiator": "Reuses Twilite’s existing declaration/bridge/port/portal machinery for the workflow’s structure, rather than building a parallel automation engine with its own node/connection model bolted on beside it.",
        "identity": {
          "graphId": "n8n-style-automation-template"
        },
