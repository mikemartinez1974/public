      ],
      "visible": true,
      "showLabel": false,
      "data": {
        "title": "A Windowed Collection Surface",
        "description": "Treat repository structure as collection membership: include direct `.node` files except the collection’s own `root.node`, plus `root.node` from each direct child directory, without recursively flattening deeper descendants. In browse mode, resolve and render a fixed-size window such as ten root-surface cards and advance the temporary offset through wheel, touch, or explicit controls.",
        "differentiator": "Authors add graph files exactly as they do now; no second portal registry or page graph is required. Directory enumeration supplies lightweight membership, and only the visible window needs its graph root surfaces resolved.",
        "definitionKey": "idea-proposed-approach",
        "_classBinding": {
          "key": "idea-proposed-approach",
          "sourceRef": "github://mikemartinez1974/public/templates/idea-template/classes/nodes/idea-proposed-approach.node-class.node"
        },
        "_bridge": {
          "classKey": "idea-proposed-approach",
