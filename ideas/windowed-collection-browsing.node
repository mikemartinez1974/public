      "data": {
        "title": "How Does the Collection Recognize Members?",
        "question": "What is the smallest reliable membership rule that lets a collection automatically include newly added graphs?",
        "status": "answered",
        "answer": "Repository location determines membership. Include direct `.node` files other than the collection’s own `root.node`, and include `root.node` from each direct child directory. Do not recursively flatten deeper descendants; supporting files and directories without a `root.node` are not members.",
        "definitionKey": "idea-question",
        "_classBinding": {
          "key": "idea-question",
          "sourceRef": "github://mikemartinez1974/public/templates/idea-template/classes/nodes/idea-question.node-class.node"
