      "data": {
        "title": "Moving a Member Changes Its Durable Address",
        "description": "Because repository location determines collection membership and the `github://` address, moving a graph between directories can break durable references even when the move is intended only as reorganization.",
        "likelihood": "medium",
        "impact": "high",
        "mitigation": "Do not physically move source graphs merely to change how they are presented. Prefer filters, archive indexes, or an explicit redirect when a move is unavoidable.",
        "definitionKey": "idea-risk",
        "_classBinding": {
