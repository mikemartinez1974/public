      "data": {
        "title": "Collections Can Browse Through a Window",
        "statement": "A collection can discover its member graphs from its repository directory and render only a scrollable window of their root surfaces at a time.",
        "status": "framed",
        "confidence": "promising",
        "notes": "The first proof should show ten discovered graph members, advance without saving layout mutations, and automatically include a newly added `.node` file or child `root.node`.",
        "definitionKey": "idea",
