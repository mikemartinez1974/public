          "targetKind": "node-class"
        },
        "identity": {
          "graphId": "windowed-collection-view"
        },
        "resolution": "The collection directory is authoritative for membership; the collection graph owns presentation rather than a duplicated member registry.",
        "resolutionPath": "Decision recorded in this idea graph and linked to Graph Organization’s active collection-growth task."
      }
    },
