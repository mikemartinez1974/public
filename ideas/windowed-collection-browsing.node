      "visible": true,
      "showLabel": false,
      "data": {
        "title": "Maintain Explicit Page Graphs",
        "description": "Store copied member listings in separate page or partition graphs and navigate between them from a collection index.",
        "tradeoffs": "This bounds loading as well as rendering, but introduces page artifacts and changes the authoring experience. It remains a future storage strategy if a single graph payload becomes genuinely too large.",
        "definitionKey": "idea-alternative",
        "_classBinding": {
          "key": "idea-alternative",
          "sourceRef": "github://mikemartinez1974/public/templates/idea-template/classes/nodes/idea-alternative.node-class.node"
        },
        "_bridge": {
          "classKey": "idea-alternative",
          "classRef": "github://mikemartinez1974/public/templates/idea-template/classes/nodes/idea-alternative.node-class.node",
          "entryPort": "root",
          "kind": "node-class",
          "sourceRef": "github://mikemartinez1974/public/templates/idea-template/classes/nodes/idea-alternative.node-class.node",
          "targetKind": "node-class"
        },
        "identity": {
          "graphId": "windowed-collection-view"
        },
        "status": "rejected-for-now",
        "tradeoff": "More control over storage partitions, but a duplicate membership index and additional artifacts for authors to maintain.",
        "reasonNotPreferred": "Directory discovery already supplies membership automatically and avoids forcing authors to maintain page artifacts or duplicate portal registries."
      }
    },
