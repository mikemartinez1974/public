      "data":{"title":"Build one specimen conversion","action":"Choose one small public Handoff graph, capture its machine-readable representation, document the Handoff-to-Twilite mapping, and generate a Twilite graph that can be opened beside the original.","expectedEvidence":"The converted graph preserves recognizable topology and semantics while behaving as a normal Twilite graph with native focus, semantic zoom, navigation, editing, and multigraph placement.","status":"todo","definitionKey":"idea-next-step","_classBinding":{"key":"idea-next-step","sourceRef":"github://mikemartinez1974/public/templates/idea-template/classes/nodes/idea-next-step.node-class.node","defaults":{"ports":[{"id":"root","key":"root","label":"root","direction":"bidirectional","dataType":"any","angle":180}],"data":{"presentation":{"glyph":{"kind":"icon","name":"ArrowForward"}}}}},"_bridge":{"classKey":"idea-next-step","classRef":"github://mikemartinez1974/public/templates/idea-template/classes/nodes/idea-next-step.node-class.node","entryPort":"root","kind":"node-class","sourceRef":"github://mikemartinez1974/public/templates/idea-template/classes/nodes/idea-next-step.node-class.node","targetKind":"node-class"},"identity":{"graphId":"handoff-graph-rendering"},"presentation":{"glyph":{"kind":"icon","name":"ArrowForward"}}}
