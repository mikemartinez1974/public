        {"id": "bottom", "label": "bottom", "direction": "bidirectional", "dataType": "value", "angle": 90}
      ],
      "visible": true,
      "showLabel": false,
      "data": {
        "title": "Foreign graph adapter",
        "approach": "Resolve a Handoff graph through the best available public/exported representation, normalize its nodes, edges, labels, hierarchy, layout, and references into an intermediate mapping, then emit a Twilite graph document. Preserve source provenance on every imported object and let Twilite own rendering, ports, views, navigation, and later editing behavior.",
        "definitionKey": "idea-proposed-approach",
        "identity": {"graphId": "handoff-graph-rendering"}
      }
    },
    {
      "id": "handoff-rendering-question-source",
