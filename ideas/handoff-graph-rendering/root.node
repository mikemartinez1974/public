      "showLabel": false,
      "data": {
        "title": "Render a Handoff graph natively in Twilite",
        "statement": "Build an adapter that reads Handoff graph structure and materializes an equivalent Twilite-native graph without treating Handoff's visual presentation as the source model.",
        "status": "spark",
        "confidence": "plausible",
        "notes": "This is an interoperability experiment and a test of Twilite's claim that foreign graph systems can be represented through the Twilite document/runtime model.",
        "definitionKey": "idea",
        "identity": {"graphId": "handoff-graph-rendering"}
      }
    },
    {
      "id": "handoff-rendering-problem",
      "type": "idea-problem",
      "label": "Problem",
      "root": false,
      "position": {"x": 120, "y": -180},
      "width": 420,
