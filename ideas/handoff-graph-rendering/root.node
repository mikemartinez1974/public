        {"id": "right", "label": "right", "direction": "bidirectional", "dataType": "value", "angle": 0}
      ],
      "visible": true,
      "showLabel": false,
      "data": {
        "title": "Handoff's graph is meaningful but application-bound",
        "problem": "Handoff exposes graph-like structure, but its objects, relationships, layout, and context are expressed through Handoff's own product model. Twilite needs to determine what can be recovered as portable graph semantics rather than copying screenshots or UI conventions.",
        "definitionKey": "idea-problem",
        "identity": {"graphId": "handoff-graph-rendering"}
      }
    },
    {
      "id": "handoff-rendering-approach",
      "type": "idea-proposed-approach",
