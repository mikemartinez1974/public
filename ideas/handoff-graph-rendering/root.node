        "identity": {"graphId": "handoff-graph-rendering", "portId": "root", "name": "Render Handoff Graphs in Twilite"},
        "title": "Render Handoff Graphs in Twilite",
        "purpose": "Treat Handoff as a foreign graph source and test whether Twilite can faithfully resolve its structure into native graph objects.",
        "markdown": "# Render Handoff Graphs in Twilite\n\nImport a Handoff graph as source data, translate its meaningful objects and relationships into Twilite nodes and edges, and render it through Twilite's own semantic model rather than reproducing Handoff's UI.\n\nThe experiment is valuable if Twilite can preserve useful Handoff structure while gaining Twilite-native navigation, semantic zoom, editing, expansion, and multigraph composition.",
        "view": {"intent": "node", "payload": "node.web.summary", "label": "Render Handoff Graphs in Twilite"},
        "target": {"graphId": "handoff-graph-rendering", "mode": "navigate"}
      }
    },
