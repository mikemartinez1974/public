      ],
      "visible": true,
      "showLabel": false,
      "data": {
        "title": "Mistaking presentation for semantics",
        "risk": "A naive importer could reproduce Handoff's boxes, coordinates, and labels while importing little actual meaning. The adapter should intentionally discard product chrome and preserve only structure that remains useful when rendered differently in Twilite.",
        "definitionKey": "idea-risk",
        "identity": {"graphId": "handoff-graph-rendering"}
      }
    },
    {
      "id": "handoff-rendering-next-step",
      "type": "idea-next-step",
