    {
      "id":"handoff-graph-rendering-notes","type":"markdown","label":"Design Notes","root":false,"position":{"x":260,"y":700},"width":680,"height":420,
      "ports":[{"id":"root","label":"root","direction":"bidirectional","dataType":"any","angle":210}],
