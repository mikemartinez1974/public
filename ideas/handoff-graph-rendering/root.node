    {
      "id": "handoff-rendering-risk",
      "type": "idea-risk",
      "label": "Risk",
      "root": false,
      "position": {"x": 1220, "y": 180},
      "width": 460,
      "height": 260,
      "ports": [
        {"id": "root", "label": "root", "direction": "bidirectional", "dataType": "any", "angle": 210},
