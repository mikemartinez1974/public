      ],
      "visible": true,
      "showLabel": false,
      "data": {
        "title": "What can Twilite actually read from Handoff?",
        "question": "Does Handoff expose a stable export, API, document representation, DOM structure, or other source rich enough to reconstruct graph identity and relationships without scraping pixels?",
        "definitionKey": "idea-question",
        "identity": {"graphId": "handoff-graph-rendering"}
      }
    },
    {
      "id": "handoff-rendering-question-semantics",
      "type": "idea-question",
      "label": "Question: Semantics",
      "root": false,
      "position": {"x": 700, "y": 20},
      "width": 420,
      "height": 240,
      "ports": [
        {"id": "root", "label": "root", "direction": "bidirectional", "dataType": "any", "angle": 210},
        {"id": "left", "label": "left", "direction": "bidirectional", "dataType": "value", "angle": 180}
      ],
      "visible": true,
      "showLabel": false,
      "data": {
        "title": "Which Handoff concepts deserve native Twilite meaning?",
        "question": "Map only concepts that carry durable semantics. Do not confuse visual grouping, temporary UI state, or application chrome with graph identity. Determine which Handoff objects become nodes, which relationships become edges, and which metadata remains provenance only.",
        "definitionKey": "idea-question",
        "identity": {"graphId": "handoff-graph-rendering"}
      }
    },
    {
      "id": "handoff-rendering-assumption",
      "type": "idea-assumption",
      "label": "Assumption",
      "root": false,
      "position": {"x": 700, "y": 340},
      "width": 420,
      "height": 240,
      "ports": [
        {"id": "root", "label": "root", "direction": "bidirectional", "dataType": "any", "angle": 210},
        {"id": "left", "label": "left", "direction": "bidirectional", "dataType": "value", "angle": 180}
      ],
      "visible": true,
      "showLabel": false,
      "data": {
        "title": "Twilite should be the renderer, not an emulator",
        "assumption": "The useful experiment is not visual fidelity to Handoff. It is semantic fidelity to the underlying graph. Once imported, the graph should behave like Twilite and gain Twilite's own views, navigation, expansion, editing, and workspace behavior.",
        "definitionKey": "idea-assumption",
        "identity": {"graphId": "handoff-graph-rendering"}
      }
    },
