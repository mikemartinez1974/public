      ],
      "visible": true,
      "showLabel": false,
      "data": {
        "title": "Graph Interfaces Should Materialize Usable Nodes",
        "statement": "Creating a bridge to a graph URL should enable edge creation of that graph's exposed node, and dragging an exposed port from the created node should materialize the resource behind that port.",
        "status": "framed",
        "confidence": "plausible",
        "notes": "Ports remain graph-boundary interfaces. The created product and document are content nodes inside the receiving graph; neither the bridge nor its port proxy participates in semantic zoom.",
        "definitionKey": "idea",
        "_classBinding": {"key": "idea", "sourceRef": "github://mikemartinez1974/public/templates/idea-template/classes/nodes/idea.node-class.node"},
        "_bridge": {"classKey": "idea", "classRef": "github://mikemartinez1974/public/templates/idea-template/classes/nodes/idea.node-class.node", "entryPort": "root", "kind": "node-class", "sourceRef": "github://mikemartinez1974/public/templates/idea-template/classes/nodes/idea.node-class.node", "targetKind": "node-class"},
        "identity": {"graphId": "bridge-port-materialization"}
      }
    },
