    {
      "id": "bridge-port-materialization-approach",
      "type": "idea-proposed-approach",
      "label": "Proposed Approach",
      "position": {"x": 300, "y": -220},
      "width": 400,
      "height": 300,
      "ports": [
        {"id": "root", "label": "root", "direction": "bidirectional", "dataType": "any", "angle": 210},
        {"id": "top", "label": "top", "direction": "bidirectional", "dataType": "value", "angle": 270},
        {"id": "right", "label": "right", "direction": "bidirectional", "dataType": "value", "angle": 0},
        {"id": "bottom", "label": "bottom", "direction": "bidirectional", "dataType": "value", "angle": 90},
        {"id": "left", "label": "left", "direction": "bidirectional", "dataType": "value", "angle": 180}
      ],
      "visible": true,
      "showLabel": false,
      "data": {
        "title": "Materialize A Named View Without Changing Identity Or Type",
        "description": "Resolve the product graph through a URL bridge and contribute Twilite to the receiving graph's Legend. Creating from the Legend makes a Twilite projection. Its declared document handle targets the same addressed Twilite object, the same Twilite semantic type, and the document surface. Dragging the handle creates a second Twilite projection pinned to that surface and connects the projections.",
        "differentiator": "The bridge contributes vocabulary, the Legend owns instantiation, and the view handle owns projection. No Document type or second Twilite domain entity is invented.",
        "definitionKey": "idea-proposed-approach",
        "_classBinding": {"key": "idea-proposed-approach", "sourceRef": "github://mikemartinez1974/public/templates/idea-template/classes/nodes/idea-proposed-approach.node-class.node"},
        "_bridge": {"classKey": "idea-proposed-approach", "classRef": "github://mikemartinez1974/public/templates/idea-template/classes/nodes/idea-proposed-approach.node-class.node", "entryPort": "root", "kind": "node-class", "sourceRef": "github://mikemartinez1974/public/templates/idea-template/classes/nodes/idea-proposed-approach.node-class.node", "targetKind": "node-class"},
        "identity": {"graphId": "bridge-port-materialization"}
      }
    },
