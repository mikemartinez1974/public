      ],
      "visible": true,
      "showLabel": false,
      "data": {
        "title": "Exposed Views Should Materialize Same-Type Projections",
        "statement": "Bridging a graph URL should contribute its creatable type to the Legend. A named view handle on an instance should materialize another canvas projection of the same addressed object and semantic type, pinned to that exposed view.",
        "status": "framed",
        "confidence": "plausible",
        "notes": "In the product example, both visible nodes are Twilite. The first uses the product/default surface; the second uses the document surface. They are separate canvas projections, not separate domain entities and not different node types. Bridges and ports remain outside semantic zoom.",
        "definitionKey": "idea",
        "_classBinding": {"key": "idea", "sourceRef": "github://mikemartinez1974/public/templates/idea-template/classes/nodes/idea.node-class.node"},
        "_bridge": {"classKey": "idea", "classRef": "github://mikemartinez1974/public/templates/idea-template/classes/nodes/idea.node-class.node", "entryPort": "root", "kind": "node-class", "sourceRef": "github://mikemartinez1974/public/templates/idea-template/classes/nodes/idea.node-class.node", "targetKind": "node-class"},
        "identity": {"graphId": "bridge-port-materialization"}
      }
    },
