      ],
      "visible": true,
      "showLabel": false,
      "data": {
        "title": "Ports, Portals, and Nodes Are Being Conflated",
        "statement": "Current creation language tends to treat a handle target as a new resource or node type, even when the handle actually names another authored view of the same addressed object.",
        "impact": "Twilite can mistakenly create a Document entity or change semantic type when it should preserve Twilite identity and type while selecting the document surface for a new canvas projection.",
        "urgency": "high",
        "definitionKey": "idea-problem",
        "_classBinding": {"key": "idea-problem", "sourceRef": "github://mikemartinez1974/public/templates/idea-template/classes/nodes/idea-problem.node-class.node"},
