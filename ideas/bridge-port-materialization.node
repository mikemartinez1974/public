      "data": {
        "title": "Graph Authors Composing Across URLs",
        "description": "People who know the durable address of a graph and want to bring its declared content into the graph they are editing.",
        "needs": "A small number of legible gestures: bridge to an address, create the contributed type from the Legend, then drag a named view handle to create another projection of that same object.",
        "definitionKey": "idea-audience",
        "_classBinding": {"key": "idea-audience", "sourceRef": "github://mikemartinez1974/public/templates/idea-template/classes/nodes/idea-audience.node-class.node"},
