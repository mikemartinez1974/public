        {"id": "left", "label": "left", "direction": "bidirectional", "dataType": "value", "angle": 180}
      ],
      "visible": true,
      "showLabel": false,
      "data": {
        "title": "The Runtime Could Duplicate The Entity Instead Of Its Projection",
        "description": "If edge creation reuses ordinary node-instantiation logic, dragging the document handle may mint a second Twilite entity or a Document-typed node instead of another canvas projection of the same addressed Twilite object.",
        "likelihood": "medium",
        "impact": "high",
        "mitigation": "Give the exposed handle an explicit same-identity view-projection target and preserve semantic type, source address, and selected surface in the resulting projection record.",
        "definitionKey": "idea-risk",
        "_classBinding": {"key": "idea-risk", "sourceRef": "github://mikemartinez1974/public/templates/idea-template/classes/nodes/idea-risk.node-class.node"},
        "_bridge": {"classKey": "idea-risk", "classRef": "github://mikemartinez1974/public/templates/idea-template/classes/nodes/idea-risk.node-class.node", "entryPort": "root", "kind": "node-class", "sourceRef": "github://mikemartinez1974/public/templates/idea-template/classes/nodes/idea-risk.node-class.node", "targetKind": "node-class"},
        "identity": {"graphId": "bridge-port-materialization"}
      }
    },
