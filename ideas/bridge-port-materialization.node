      "data": {
        "title": "Implement Same-Identity View Projection From A Handle",
        "action": "Extend the exposed-handle and edge-creation contracts so the live Twilite product graph can contribute Twilite to the Legend, create a Twilite product projection, and materialize a second Twilite projection pinned to its document surface without changing addressed identity or semantic type.",
        "owner": "Michael and Codex",
        "status": "ready",
        "expectedEvidence": "A runtime smoke fixture proves: the bridge contributes Twilite to the Legend; Legend creation produces a Twilite projection; its document handle is visible; dragging it produces exactly one connected projection with the same source address and semantic type, a distinct canvas projection ID, and presentation.surfaceId=document.",
        "definitionKey": "idea-next-step",
        "_classBinding": {"key": "idea-next-step", "sourceRef": "github://mikemartinez1974/public/templates/idea-template/classes/nodes/idea-next-step.node-class.node"},
