      ],
      "visible": true,
      "showLabel": false,
      "data": {
        "title": "Ports, Portals, and Nodes Are Being Conflated",
        "statement": "A rectangular portal can look like a node even though it is a boundary reference, while the authored document behind a port is the content object users expect to manipulate.",
        "impact": "Semantic zoom and edge creation become ambiguous: the UI does not know whether it is presenting an interface, navigating across a boundary, or creating graph-owned content.",
        "urgency": "high",
        "definitionKey": "idea-problem",
        "_classBinding": {"key": "idea-problem", "sourceRef": "github://mikemartinez1974/public/templates/idea-template/classes/nodes/idea-problem.node-class.node"},
