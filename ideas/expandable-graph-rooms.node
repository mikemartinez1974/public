      "data": {
        "title": "A Graph Can Open Another Graph as a Room",
        "statement": "A separately owned .node file can be mounted as a collapsible branch inside the current canvas, letting users experience multiple files as one spatial structure without erasing ownership boundaries.",
        "status": "framed",
        "confidence": "promising",
        "notes": "Portal navigation remains available. Expansion is an additional composition behavior, not a replacement for opening the source graph.",
        "definitionKey": "idea",
