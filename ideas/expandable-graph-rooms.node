      "data": {
        "title": "Mount a Bounded Subgraph",
        "description": "Let a portal offer Expand Here. The host mounts the target graph into a namespaced branch, participates in focus and semantic zoom, and unloads it on collapse while the target file retains ownership.",
        "differentiator": "It preserves the spatial experience of one graph without pretending that separately saved files share one mutation boundary.",
        "definitionKey": "idea-proposed-approach",
        "_classBinding": {
          "key": "idea-proposed-approach",
          "sourceRef": "github://mikemartinez1974/public/templates/idea-template/classes/nodes/idea-proposed-approach.node-class.node"
