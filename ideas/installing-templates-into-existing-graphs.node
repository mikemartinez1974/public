      "data": {
        "title": "Whole-Graph Derivation Blocks Composition",
        "statement": "Current template instructions commonly assume they own the entire destination graph, including its declaration, graph kind, fixed IDs, and root surface.",
        "impact": "Authors cannot safely add a mature capability such as workboard reconciliation to an existing idea, research, or project graph without hand-merging infrastructure.",
        "urgency": "high",
        "definitionKey": "idea-problem",
