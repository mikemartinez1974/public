      ],
      "visible": true,
      "showLabel": false,
      "data": {
        "title": "Two Template Modes: Derive and Install",
        "description": "A whole-graph template may derive a new graph and own its declaration and root. An installable capability instead declares owned nodes, required bridges, dependency merges, configuration, collision policy, update rules, and explicit prohibitions against replacing the host declaration or root.",
        "differentiator": "The same capability package can support a standalone graph and composition into an existing graph without pretending those operations have the same authority.",
        "definitionKey": "idea-proposed-approach",
        "_classBinding": {
          "key": "idea-proposed-approach",
          "sourceRef": "github://mikemartinez1974/public/templates/idea-template/classes/nodes/idea-proposed-approach.node-class.node"
        },
        "_bridge": {
