      ],
      "visible": true,
      "showLabel": false,
      "data": {
        "title": "Capability Collisions and Hidden Ownership",
        "description": "Two installers could claim the same IDs, dependencies, surfaces, scripts, or nodes, while an update could overwrite user-authored changes inside the installed region.",
        "likelihood": "medium",
        "impact": "high",
        "mitigation": "Require namespaces, an ownership ledger, deterministic merge rules, explicit configuration, dry-run planning, and idempotence checks.",
        "definitionKey": "idea-risk",
        "_classBinding": {
          "key": "idea-risk",
          "sourceRef": "github://mikemartinez1974/public/templates/idea-template/classes/nodes/idea-risk.node-class.node"
        },
        "_bridge": {
          "classKey": "idea-risk",
          "classRef": "github://mikemartinez1974/public/templates/idea-template/classes/nodes/idea-risk.node-class.node",
