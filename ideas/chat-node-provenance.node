      "data": {
        "title": "A First-Class Chat Node with Explicit Provenance Semantics",
        "description": "Add a Chat node type with provider, title, source URL, access mode, captured time, summary or excerpt, and produced-artifact references. Render the access state visibly and connect the conversation to what it created.",
        "differentiator": "Unlike a generic URL node, it describes the relationship between conversation and artifact, distinguishes access modes, and can retain useful local context even when the external conversation cannot be opened.",
        "definitionKey": "idea-proposed-approach",
        "_classBinding": {
          "key": "idea-proposed-approach",
          "sourceRef": "github://mikemartinez1974/public/templates/idea-template/classes/nodes/idea-proposed-approach.node-class.node"
