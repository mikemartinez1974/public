          "angle": 180
        }
      ],
      "visible": true,
      "showLabel": true,
      "data": {
        "identity": {
          "graphId": "chat-node-provenance"
        },
        "markdown": "# Reading This Idea\n\nThis graph frames a first-class **Chat node** as provenance, not merely another hyperlink. Follow the semantic edges from the loss of conversational context toward a node contract that records access mode, snapshot scope, durable summary, and the artifacts produced by the conversation.\n\nThe idea deliberately separates a private owner link, a shared snapshot, and a locally archived excerpt so the graph never implies more access or permanence than actually exists.",
        "title": "Reading This Idea"
      }
    },
