          "dataType": "value",
          "angle": 90
        }
      ],
      "data": {
        "title": "Layer Port Detail Over Shared Node Identity",
        "description": "The Declaration identifies the composed node, exposes Ports, and associates the shared Detail, Summary, Icon, and Glyph presentations. Every Port resolves Detail explicitly: it either owns a port-specific Detail View or delegates to the shared Detail View. A Port may optionally own a Summary View; otherwise Summary falls back to the shared Summary View. Icon and Glyph remain shared. Port connection acceptance and behaviors remain independent authored concerns.",
        "differentiator": "This makes Detail resolution total and intentional while allowing meaningful Summary overrides without multiplying every presentation level across every Port.",
        "definitionKey": "idea-proposed-approach",
        "_classBinding": {
          "key": "idea-proposed-approach",
          "sourceRef": "github://mikemartinez1974/public/templates/idea-template/classes/nodes/idea-proposed-approach.node-class.node"
        },
        "_bridge": {
          "classKey": "idea-proposed-approach",
          "classRef": "github://mikemartinez1974/public/templates/idea-template/classes/nodes/idea-proposed-approach.node-class.node",
          "entryPort": "root",
          "kind": "node-class",
          "sourceRef": "github://mikemartinez1974/public/templates/idea-template/classes/nodes/idea-proposed-approach.node-class.node",
          "targetKind": "node-class"
        },
        "identity": {
          "graphId": "node-composition"
        }
      }
    },
