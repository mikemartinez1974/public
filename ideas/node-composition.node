      ],
      "data": {
        "title": "Where Does Shared Presentation Live?",
        "question": "Where do shared presentations live, and which presentation levels may a Port specialize?",
        "status": "answered",
        "importance": "resolved",
        "answer": "The Declaration associates the shared Detail, Summary, Icon, and Glyph. Every Port owns its Detail View or explicitly delegates Detail to the shared Detail View. A Port may own a Summary View; otherwise it uses the shared Summary. Icon and Glyph remain shared. A View is not a Port.",
        "notes": "Resolution: the Declaration associates the shared Detail, Summary, Icon, and Glyph. A Port owns or delegates Detail, may override Summary, and uses the shared Icon and Glyph. View remains distinct from Port.",
        "resolutionPath": "Declaration owns shared presentation associations; Ports explicitly resolve Detail and optionally override Summary.",
        "definitionKey": "idea-question",
        "_classBinding": {
          "key": "idea-question",
          "sourceRef": "github://mikemartinez1974/public/templates/idea-template/classes/nodes/idea-question.node-class.node"
        },
        "_bridge": {
          "classKey": "idea-question",
