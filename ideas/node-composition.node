      "data": {
        "title": "Compose Node Identity and Port Interfaces",
        "statement": "A node graph composes one shared identity presentation with port-selected detail views and optional port behaviors.",
        "status": "framed",
        "confidence": "emerging",
        "notes": "A View is not a Port. A Port accepts connections, selects or delegates a detail view, and may declare behavior. Summary, icon, and glyph describe the node identity shared across ports.",
        "definitionKey": "idea",
        "_classBinding": {
