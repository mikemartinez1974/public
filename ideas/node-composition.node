      "data": {
        "title": "Compose Node Identity and Port Interfaces",
        "statement": "A node graph composes shared presentations with Port-resolved Detail, optional Port-specific Summary, and independently authored Port behaviors.",
        "status": "framed",
        "confidence": "emerging",
        "notes": "A View is not a Port. Every Port owns a Detail View or explicitly delegates to shared Detail. A Port may own a Summary View; otherwise it falls back to shared Summary. Icon and Glyph remain shared node identity presentations.",
        "definitionKey": "idea",
