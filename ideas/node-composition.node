      "data": {
        "title": "Where Does Shared Presentation Live?",
        "question": "Does the Declaration directly associate Summary, Icon, and Glyph, or does it identify a shared presentation node that owns those views?",
        "status": "open",
        "importance": "blocking",
        "notes": "Keep View separate from Port either way; the question is ownership and delegation, not ontology.",
        "definitionKey": "idea-question",
        "_classBinding": {
