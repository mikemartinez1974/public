      "data": {
        "title": "Ports Resolve Detail and May Override Summary",
        "statement": "Every Port must resolve a Detail View by owning one or explicitly delegating to the shared Detail View. A Port may own a Summary View; when it does not, resolution falls back to the shared Summary. Icon and Glyph remain shared node identity presentations.",
        "importance": "critical",
        "status": "supported",
        "confidence": "high",
        "validation": "A two-port smoke graph must prove both Detail paths and both Summary paths: one Port delegates to shared Detail and shared Summary; another owns Detail and optionally overrides Summary; both resolve the shared Icon and Glyph.",
        "definitionKey": "idea-assumption",
        "_classBinding": {
          "key": "idea-assumption",
