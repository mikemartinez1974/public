          "angle": 0
        }
      ],
      "data": {
        "title": "What Is the Resolution and Fallback Order?",
        "question": "What is the deterministic presentation resolution order for an active Port?",
        "status": "answered",
        "importance": "resolved",
        "answer": "Detail resolves through the active Port: use its owned Detail View, or follow its explicit delegation to shared Detail. Summary uses the active Port's owned Summary View when present; otherwise it falls back to shared Summary. Icon and Glyph use the shared node presentations. The active Port identity remains intact at every semantic level.",
        "notes": "Resolution: Detail uses the Port's owned Detail or its explicit delegation to shared Detail. Summary uses the Port's owned Summary when present, otherwise shared Summary. Icon and Glyph use their shared node presentations. Active Port identity is preserved at every level.",
        "resolutionPath": "Detail: port-owned or explicitly shared. Summary: port-owned then shared fallback. Icon and Glyph: shared.",
        "definitionKey": "idea-question",
        "_classBinding": {
          "key": "idea-question",
          "sourceRef": "github://mikemartinez1974/public/templates/idea-template/classes/nodes/idea-question.node-class.node"
        },
        "_bridge": {
