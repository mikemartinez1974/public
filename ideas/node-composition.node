          "angle": 90
        }
      ],
      "data": {
        "title": "Layer Port Detail Over Shared Node Identity",
        "description": "The Declaration identifies the composed node and exposes Ports. Each Port names an accepted contract, selects or delegates its Detail View, and may declare behaviors. The Declaration associates the node-wide Summary, Icon, and Glyph. Semantic zoom first chooses a level, then resolves that level through the active Port and shared-node fallback rules.",
        "differentiator": "This preserves Port as the single interface primitive without multiplying summary and icon artifacts for every port.",
        "definitionKey": "idea-proposed-approach",
        "_classBinding": {
          "key": "idea-proposed-approach",
          "sourceRef": "github://mikemartinez1974/public/templates/idea-template/classes/nodes/idea-proposed-approach.node-class.node"
        },
