      "data": {
        "title": "What Is the Resolution and Fallback Order?",
        "question": "When semantic zoom requests a level, how does the runtime resolve active-port Detail, shared Summary/Icon/Glyph, delegated views, and missing authored views without hiding an authoring error?",
        "status": "open",
        "importance": "blocking",
        "notes": "The answer must preserve which Port was entered even when the rendered presentation is shared.",
        "definitionKey": "idea-question",
