      ],
      "data": {
        "title": "Presentation Authority Is Split and Ambiguous",
        "statement": "Current graphs can expose ports and views, but do not yet state which presentation belongs to a port, which belongs to the node, or how semantic zoom preserves active-port identity.",
        "impact": "Authors duplicate surfaces, runtime fallbacks become accidental, and demanding graphs such as Wikipedia cannot predict what an instantiated node will render.",
        "urgency": "high",
        "definitionKey": "idea-problem",
        "_classBinding": {
          "key": "idea-problem",
          "sourceRef": "github://mikemartinez1974/public/templates/idea-template/classes/nodes/idea-problem.node-class.node"
