      "data": {
        "title": "A raw value loses the contract around it",
        "statement": "Moving an unwrapped value across graph boundaries obscures its schema, origin, destination, run identity, intended lifetime, delivery semantics, and failure state. That makes scripting difficult to inspect and unsafe to extend.",
        "impact": "Authors cannot reliably explain what crossed the boundary, receivers cannot validate it before use, and the runtime may drift toward silent shared-state mutation.",
        "urgency": "high",
        "definitionKey": "idea-problem",
