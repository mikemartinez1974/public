      "data": {
        "title": "Source-Aware Wikipedia Article Node Class",
        "description": "Create a node class with a canonical article reference plus cached source metadata/content. Icon shows identity, summary shows title and extract, detail exposes article content/sections/source state, and editor manages article URL/title, refresh, cache, and presentation options.",
        "differentiator": "Keep the Wikipedia source address and freshness separate from the local graph representation so the node can be refreshed without ceasing to be the same graph object.",
        "definitionKey": "idea-proposed-approach",
        "_classBinding": {
          "key": "idea-proposed-approach",
          "sourceRef": "github://mikemartinez1974/public/templates/idea-template/classes/nodes/idea-proposed-approach.node-class.node"
