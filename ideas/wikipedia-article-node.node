      "data": {
        "title": "Source Drift and Overreach",
        "description": "Wikipedia revisions can make cached content stale, while modeling too much of the article too early could turn a useful node into a large ingestion subsystem.",
        "severity": "medium",
        "mitigation": "Track source revision/fetched-at metadata and begin with a deliberately small source contract that can expand later.",
        "definitionKey": "idea-risk",
        "_classBinding": {
