      "data": {
        "title": "Reference Pages Are Disposable Browser Destinations",
        "statement": "Wikipedia is useful, but an article opened in a browser is not yet a durable graph object that can participate directly in Twilite relationships, views, collections, or agent workflows.",
        "impact": "Users repeatedly re-find, re-read, and manually extract the same source material instead of keeping an inspectable reference object in the graph.",
        "urgency": "medium",
        "definitionKey": "idea-problem",
