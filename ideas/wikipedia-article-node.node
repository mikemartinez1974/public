          "angle": 90
        },
        {
          "id": "left",
          "label": "left",
          "direction": "bidirectional",
          "dataType": "value",
          "angle": 180
        }
      ],
      "visible": true,
      "showLabel": false,
      "data": {
        "title": "How much of the article becomes graph-addressable data?",
        "question": "Should the first version cache only title, extract, image, URL, revision metadata, and selected sections, or should it model links, references, infobox fields, and section structure immediately?",
        "whyItMatters": "The first version should stay centered on article sections. Wikipedia already does an excellent job of organizing links, references, infoboxes, and the broader encyclopedia. Twilite should initially add value by turning the article's section structure into an explorable spatial browsing surface, rather than trying to ingest Wikipedia's entire knowledge model.",
        "status": "answered",
        "definitionKey": "idea-question",
        "_classBinding": {
          "key": "idea-question",
          "sourceRef": "github://mikemartinez1974/public/templates/idea-template/classes/nodes/idea-question.node-class.node"
        },
        "_bridge": {
          "classKey": "idea-question",
          "classRef": "github://mikemartinez1974/public/templates/idea-template/classes/nodes/idea-question.node-class.node",
          "entryPort": "root",
          "kind": "node-class",
          "sourceRef": "github://mikemartinez1974/public/templates/idea-template/classes/nodes/idea-question.node-class.node",
          "targetKind": "node-class"
        },
        "identity": {
          "graphId": "wikipedia-article-node"
        },
        "_placement": {
          "version": 1,
          "state": "manually-shaped",
          "source": "manual",
          "updatedAt": 1787162363648,
          "reason": "node-drag"
        },
        "answer": "Start with sections. The root article node should source the Wikipedia article, present the lead and first useful section, and expose additional article sections as expandable ports. Pulled sections can become transient child nodes. Leave links, references, infobox fields, categories, and deeper semantic ingestion to later iterations unless real use proves they need first-class treatment.",
        "memo": "",
        "link": ""
      }
    },
