          "value": "<div style='container-type:inline-size;width:100%;height:100%'><div style='position:relative;box-sizing:border-box;width:100%;height:100%;overflow:hidden;background-color:#1c1733;background-image:radial-gradient(90cqw 55cqw at 12% -8%,color-mix(in srgb,#6d28d9 42%,transparent),transparent),repeating-linear-gradient(0deg,transparent 0,transparent 5.6cqw,color-mix(in srgb,#e9c46a 7%,transparent) 5.6cqw,color-mix(in srgb,#e9c46a 7%,transparent) 5.72cqw);font-family:Inter,system-ui,Segoe UI,Helvetica Neue,Arial,sans-serif;color:#f4eefc'><div style='position:absolute;left:4cqw;top:3cqw;font:800 1.4cqw/1.2 Inter,system-ui,Segoe UI,Helvetica Neue,Arial,sans-serif;letter-spacing:.22em;text-transform:uppercase;color:#e9c46a'>The Studio · Thinking</div><div style='position:absolute;left:4cqw;top:5cqw;font:500 6.6cqw/1 Georgia,Iowan Old Style,Palatino Linotype,Times New Roman,serif;letter-spacing:-.02em;white-space:nowrap'>Ideas</div><div style='position:absolute;left:4cqw;width:38.23cqw;top:12.6cqw;font:italic 400 2cqw/1.35 Georgia,Iowan Old Style,Palatino Linotype,Times New Roman,serif;color:#d9cdf0'>Possibilities, connected. Each tile is an idea worked out in cards.</div><div style='position:absolute;left:25cqw;top:21.32cqw;width:53.68cqw;height:66.91cqw;box-sizing:border-box;border-radius:2cqw;background:color-mix(in srgb,#e9c46a 6%,#1c1733);border:.28cqw solid color-mix(in srgb,#e9c46a 26%,#1c1733)'></div><div style='position:absolute;left:41.83cqw;top:12.72cqw;height:8.6cqw;display:flex;align-items:flex-end;gap:.35cqw'><i style='display:block;width:1.5cqw;height:7.7cqw;background:#e9c46a;border-radius:.25cqw .25cqw 0 0;box-shadow:inset -.2cqw 0 0 rgba(0,0,0,.28)'></i><i style='display:block;width:1.95cqw;height:9.1cqw;background:#4c1d95;border-radius:.25cqw .25cqw 0 0;box-shadow:inset -.2cqw 0 0 rgba(0,0,0,.28)'></i><i style='display:block;width:2.4cqw;height:6.3cqw;background:#8b5cf6;border-radius:.25cqw .25cqw 0 0;box-shadow:inset -.2cqw 0 0 rgba(0,