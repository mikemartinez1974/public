        "svg": "<svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 700 360\" role=\"img\" aria-label=\"Michael’s Ideas Collection\"><defs><linearGradient id=\"ideas-bg\" x1=\"0\" y1=\"0\" x2=\"1\" y2=\"1\"><stop offset=\"0\" stop-color=\"#0f172a\"/><stop offset=\".55\" stop-color=\"#312e81\"/><stop offset=\"1\" stop-color=\"#581c87\"/></linearGradient></defs><rect x=\"5\" y=\"5\" width=\"690\" height=\"350\" rx=\"34\" fill=\"url(#ideas-bg)\" stroke=\"#a78bfa\" stroke-width=\"2\"/><path d=\"M102 210 C145 110 240 90 292 170 S420 260 492 155 S590 110 620 190\" fill=\"none\" stroke=\"#c4b5fd\" stroke-width=\"3\"/><g fill=\"#ddd6fe\"><circle cx=\"102\" cy=\"210\" r=\"12\"/><circle cx=\"292\" cy=\"170\" r=\"12\"/><circle cx=\"492\" cy=\"155\" r=\"12\"/><circle cx=\"620\" cy=\"190\" r=\"12\"/></g><text x=\"52\" y=\"82\" fill=\"#ddd6fe\" font-family=\"system-ui,sans-serif\" font-size=\"14\" font-weight=\"800\" letter-spacing=\".2em\">POSSIBILITIES, CONNECTED</text><text x=\"52\" y=\"132\" fill=\"#fff\" font-family=\"system-ui,sans-serif\" font-size=\"40\" font-weight=\"850\">Michael’s Ideas</text><text x=\"52\" y=\"316\" fill=\"#e9d5ff\" font-family=\"system-ui,sans-serif\" font-size=\"17\">A durable collection for explorations that may become worlds</text></svg>",
