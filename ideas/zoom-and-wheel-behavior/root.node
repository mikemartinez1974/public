    {
      "id": "zoom-and-wheel-behavior-question-pan",
      "type": "idea-question",
      "label": "Wheel on Empty Canvas: Pan or Zoom?",
      "position": {
        "x": -700,
        "y": 700
      },
      "width": 400,
      "height": 300,
      "ports": [
