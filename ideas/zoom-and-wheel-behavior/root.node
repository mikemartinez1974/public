    {
      "id": "zoom-and-wheel-behavior-evidence-anchor",
      "type": "idea-evidence",
      "label": "Zoom Is Anchored on the Screen Center",
      "position": {
        "x": 1220,
        "y": 260
      },
      "width": 400,
      "height": 300,
      "ports": [
        {
          "id": "root",
          "label": "root",
          "direction": "bidirectional",
          "dataType": "any",
          "angle": 210
        },
        {
          "id": "supports",
          "key": "supports",
          "label": "supports",
          "direction": "bidirectional",
          "dataType": "any",
          "angle": 180,
          "role": "relationship",
          "allowedEdgeTypes": [
            "reference"
          ],
          "metadata": {
            "relationship": true,
            "role": "relationship"
          }
        }
      ],
      "visible": true,
      "showLabel": false,
      "data": {
        "title": "Wheel zoom is anchored on the screen centre, and that is the choice",
        "observation": "In components/NodeGraph/PanZoomLayer.js the wheel handler computes its zoom anchor from the middle of the layer (getZoomCenter). The first reading of this was that it was a gap, because the point under the pointer moves. Michael decided that zooming about the centre is the most humane choice, so it stays, and the zoom keys use the same anchor: zooming in with Ctrl and plus, out with Ctrl and minus, then Ctrl and 0 returns the camera to exactly where it began.",
        "kind": "behavior",
        "strength": "strong",
        "identity": {
          "graphId": "zoom-and-wheel-behavior"
        },
        "presentation": {
          "glyph": {
            "kind": "icon",
            "name": "FactCheck"
          }
        },
        "citationSourceId": "",
        "classRef": "github://mikemartinez1974/public/templates/idea-template/classes/nodes/idea-evidence.node-class.node"
      },
      "handles": [
        {
          "id": "root",
          "label": "root",
          "direction": "bidirectional",
          "dataType": "any",
          "angle": 210
        },
        {
          "id": "supports",
          "key": "supports",
          "label": "supports",
          "direction": "bidirectional",
          "dataType": "any",
          "angle": 180,
          "role": "relationship",
          "allowedEdgeTypes": [
            "reference"
          ],
