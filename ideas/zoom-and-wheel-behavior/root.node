    {
      "id": "zoom-and-wheel-behavior-idea-risk",
      "type": "idea-risk",
      "label": "Breaking Accessibility Zoom",
      "root": false,
      "position": {
        "x": -220,
        "y": -780
      },
      "width": 400,
      "height": 300,
      "ports": [
        {
          "id": "root",
          "label": "root",
          "direction": "bidirectional",
          "dataType": "any",
          "angle": 210
        },
        {
          "id": "threatens",
          "key": "threatens",
