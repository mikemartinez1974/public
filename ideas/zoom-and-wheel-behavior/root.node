    {
      "id": "zoom-and-wheel-behavior-idea-problem",
      "type": "idea-problem",
      "label": "Wheel Means Zoom, and Scrollbars Lie",
      "position": {
        "x": -940,
        "y": -160
      },
      "width": 400,
      "height": 300,
      "ports": [
        {
          "id": "root",
          "label": "root",
          "direction": "bidirectional",
          "dataType": "any",
          "angle": 210
        },
        {
          "id": "motivates",
          "key": "motivates",
          "label": "motivates",
          "direction": "bidirectional",
          "dataType": "any",
          "angle": 0,
          "role": "relationship",
          "allowedEdgeTypes": [
            "reference"
          ],
          "metadata": {
            "relationship": true,
            "role": "relationship"
          }
        },
        {
          "id": "affects",
          "key": "affects",
          "label": "affects",
          "direction": "bidirectional",
          "dataType": "any",
          "angle": 180,
          "role": "relationship",
          "allowedEdgeTypes": [
            "reference"
          ],
          "metadata": {
            "relationship": true,
            "role": "relationship"
          },
          "portId": "affects"
        }
      ],
      "visible": true,
      "showLabel": false,
      "data": {
        "title": "The wheel and browser zoom do not behave like the web",
        "statement": "The wheel and the browser zoom controls did not agree with the camera. Ctrl+wheel, a trackpad pinch and the keyboard zoom keys scaled the whole browser page out from under the camera, and over content nodes Ctrl+wheel was swallowed by the node. Content that showed a scrollbar could fail to scroll, because a layer cancelled the wheel or drew the view where it could not be pointed at. A card with nothing to scroll swallowed the wheel, so the camera could not be zoomed from there. Twilite therefore had two unrelated zoom systems and a wheel with different rules from other web pages.",
        "impact": "People cannot read long content inside a graph, zoom the way they expect, or trust what a scrollbar promises. Accessibility zoom fights the camera, and every new surface (a page view, a document, an embedded frame) has to solve wheel handling again.",
        "urgency": "high",
        "identity": {
          "graphId": "zoom-and-wheel-behavior"
        },
        "presentation": {
          "glyph": {
            "kind": "icon",
            "name": "ReportProblem"
          }
        },
        "classRef": "github://mikemartinez1974/public/templates/idea-template/classes/nodes/idea-problem.node-class.node"
      },
      "handles": [
