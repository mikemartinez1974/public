      "visible": true,
      "showLabel": false,
      "data": {
        "title": "How browsers treat the wheel, scroll chaining and zoom",
        "findings": "Browsers give a wheel event to the innermost scrollable element under the pointer, and pass it outward (scroll chaining) only once that element cannot move further, and they keep a gesture on the element it started on until it pauses (a wheel transaction), which avoids mid-flick handoffs. A trackpad pinch arrives as a wheel event with ctrlKey set, and Ctrl or Cmd with the wheel is the standard zoom gesture. Pages may cancel these events only with a non-passive listener. Zoom changed from the browser menu or the keyboard is not cancelable in every browser, but changes window.devicePixelRatio and the visual viewport, which a page can observe.",
        "sourceUrl": "https://developer.mozilla.org/en-US/docs/Web/API/Element/wheel_event",
        "sourceType": "other",
        "identity": {
          "graphId": "zoom-and-wheel-behavior"
        },
        "presentation": {
          "glyph": {
            "kind": "icon",
            "name": "Search"
          }
        },
        "classRef": "github://mikemartinez1974/public/templates/idea-template/classes/nodes/idea-research.node-class.node"
      },
