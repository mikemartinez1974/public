      "data": {
        "title": "A plain wheel that zooms the camera, and scrolls content, is welcome",
        "statement": "People are content that the plain wheel zooms the camera over the workspace and scrolls content under the pointer, and that it hands over to the camera when the content has nothing more to scroll. Michael judged zooming about the centre of the screen the most humane choice, and Ctrl+wheel needs no special meaning because the plain wheel already zooms.",
        "importance": "high",
        "status": "supported",
        "identity": {
          "graphId": "zoom-and-wheel-behavior"
        },
