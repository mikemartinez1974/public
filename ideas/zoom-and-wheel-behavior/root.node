    {
      "id": "zoom-and-wheel-behavior-idea-proposed-approach",
      "type": "idea-proposed-approach",
      "label": "A Gesture Contract",
      "root": false,
      "position": {
        "x": 560,
        "y": -160
      },
      "width": 400,
      "height": 300,
      "ports": [
        {
          "id": "root",
          "label": "root",
          "direction": "bidirectional",
          "dataType": "any",
          "angle": 210
        },
        {
          "id": "questioned-by",
          "key": "questioned-by",
          "label": "questioned by",
          "direction": "bidirectional",
          "dataType": "any",
          "angle": 0,
          "role": "relationship",
          "allowedEdgeTypes": [
            "reference"
          ],
          "metadata": {
            "relationship": true,
            "role": "relationship"
          }
        },
        {
          "id": "advances",
          "key": "advances",
          "label": "advances",
          "direction": "bidirectional",
          "dataType": "any",
          "angle": 180,
          "role": "relationship",
          "allowedEdgeTypes": [
            "reference"
          ],
          "metadata": {
            "relationship": true,
            "role": "relationship"
          }
        }
      ],
      "visible": true,
      "showLabel": false,
      "data": {
        "title": "One gesture contract, applied by the arbiter that already exists",
        "description": "Write the rules down as a table of input by target, and let the existing interaction arbiter apply it. Zoom gestures (Ctrl or Cmd with the wheel, trackpad pinch, and Ctrl or Cmd with plus, minus and zero) always drive the camera zoom, about the middle of the screen like the plain wheel, and never the browser page zoom. A plain wheel goes to the surface under the pointer: the nearest ancestor that can scroll in that direction scrolls, and when none can, because it is at its end or has nothing to scroll, the wheel zooms the camera, as it does over empty workspace. A gesture that starts on a surface should stay with it until it pauses, so content does not hand off to the camera in the middle of a flick.",
        "differentiator": "It does not add a mode or a new control. It makes Twilite follow the rules people already know from the web, and it puts the whole behavior in one testable table instead of scattered wheel listeners.",
        "definitionKey": "idea-proposed-approach",
        "_classBinding": {
