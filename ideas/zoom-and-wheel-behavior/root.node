      "id": "zoom-and-wheel-behavior-idea-alternative",
      "type": "idea-alternative",
      "label": "Keep Wheel = Zoom, Add a Scroll Modifier",
      "root": false,
      "position": {
        "x": 1160,
        "y": -160
      },
      "width": 400,
      "height": 300,
      "ports": [
        {
