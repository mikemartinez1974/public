    {
      "id": "zoom-and-wheel-behavior-evidence-gestures",
      "type": "idea-evidence",
      "label": "Zoom Gestures Drive the Camera",
      "root": false,
      "position": {
        "x": 2660,
        "y": 260
      },
      "width": 400,
      "height": 300,
      "ports": [
        {
          "id": "root",
          "label": "root",
          "direction": "bidirectional",
          "dataType": "any",
          "angle": 210
        },
        {
          "id": "supports",
          "key": "supports",
          "label": "supports",
          "direction": "bidirectional",
          "dataType": "any",
          "angle": 180,
          "role": "relationship",
          "allowedEdgeTypes": [
            "reference"
          ],
          "metadata": {
            "relationship": true,
            "role": "relationship"
          }
        }
      ],
      "visible": true,
      "showLabel": false,
      "data": {
        "title": "Zoom gestures and idle wheels now go to the camera, checked with real input",
        "observation": "With real (trusted) wheel and key input in the running app on the test bench: Ctrl+wheel over a content node zoomed the camera (1 to 1.24) and scrolled nothing; Ctrl and plus, Ctrl and minus and Ctrl and 0 took the zoom to 1.488, 1.24 and exactly 1 with the pan restored; the plain wheel over a card with nothing to scroll, and over a document at its end, zoomed the camera (1 to 0.76); over a document mid-scroll it scrolled (0 to 120) and the zoom held; over a nested scroller whose inner box was at its end it scrolled the outer page (0 to 120) with the zoom held. The earlier run had those cases dead or handed to browser page zoom.",
        "kind": "experiment",
        "strength": "strong",
        "definitionKey": "idea-evidence",
        "_classBinding": {
          "key": "idea-evidence",
          "sourceRef": "github://mikemartinez1974/public/templates/idea-template/classes/nodes/idea-evidence.node-class.node",
