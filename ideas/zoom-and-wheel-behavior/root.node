      "data": {
        "identity": {
          "graphId": "zoom-and-wheel-behavior",
          "name": "The Camera Behaves Like the Browser",
          "version": "0.1.0",
          "description": "A gesture contract for zoom and the mouse wheel in Twilite: browser zoom drives the camera, and the wheel acts on the surface under the pointer the way it does on the web, panning the camera when that surface has nothing to scroll.",
          "nodeId": "zoom-and-wheel-behavior",
          "updatedAt": "2026-09-20T21:37:51.291Z"
        },
        "intent": {
          "kind": "graph",
          "scope": "shared"
        },
