    {
      "id": "zoom-and-wheel-behavior-detail-view",
      "type": "face",
      "label": "The Camera Behaves Like the Browser Detail",
      "position": {
        "x": -1500,
        "y": -1580
      },
      "width": 420,
      "height": 280,
      "ports": [
        {
          "id": "root",
