          "metadata": {
            "relationship": true,
            "role": "relationship"
          }
        }
      ],
      "visible": true,
      "showLabel": false,
      "data": {
        "title": "A wheel arbiter exists and already knows about scroll regions",
        "observation": "components/NodeGraph/interactionArbiter.js classifies the event target, finds scrollable regions, and returns an owner: content scroll when the region can scroll in the event direction, embedded content, or the canvas. The rule that gives the canvas the wheel is zoom. Two other places decide the wheel on their own: a per-node listener in FixedNode.js that cancels wheel events not aimed at interactive content, and the frame listener in PersistentIframe.js. So the pieces for a single contract exist, but they are not one table and they disagree.",
        "kind": "observation",
        "strength": "moderate",
        "definitionKey": "idea-evidence",
        "_classBinding": {
          "key": "idea-evidence",
