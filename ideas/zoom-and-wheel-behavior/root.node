          ],
          "metadata": {
            "relationship": true,
            "role": "relationship"
          }
        }
      ],
      "visible": true,
      "showLabel": false,
      "data": {
        "title": "Keep the wheel as zoom and make scrolling the special case",
        "description": "Leave the plain wheel as the camera zoom and require a modifier (or a click into the surface) to scroll content, as many canvas tools do.",
        "tradeoffs": "Nothing changes for people used to canvas tools, and it is the smallest change. But it keeps the mismatch with every other web page, it does not fix scrollbars that seem to do nothing, and it leaves browser zoom unaddressed.",
        "definitionKey": "idea-alternative",
        "_classBinding": {
          "key": "idea-alternative",
