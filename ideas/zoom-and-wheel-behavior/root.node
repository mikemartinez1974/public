    {
      "id": "zoom-and-wheel-behavior-next-step-chain",
      "type": "idea-next-step",
      "label": "Scroll, Then Pan: Chaining and Latching",
      "root": false,
      "position": {
        "x": 740,
        "y": 1160
      },
      "width": 400,
      "height": 300,
      "ports": [
        {
          "id": "root",
