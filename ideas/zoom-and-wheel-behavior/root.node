          "direction": "bidirectional",
          "dataType": "any",
          "angle": 90,
          "role": "relationship",
          "allowedEdgeTypes": [
            "reference"
          ],
          "metadata": {
            "relationship": true,
            "role": "relationship"
          }
        }
      ],
      "visible": true,
      "showLabel": false,
      "data": {
        "title": "Taking over zoom can hurt the people who need it",
        "description": "Capturing browser zoom gestures and converting them to camera zoom could stop the page reflowing for people who use zoom to read, and inconsistent handling across browsers, trackpads and touch could make things worse for them, not better.",
        "likelihood": "medium",
        "impact": "high",
        "mitigation": "Keep the controls that are not gestures (a visible zoom control and keyboard access), test the contract with browser zoom and reflow, do not capture what cannot be captured reliably, and keep a preference that restores the browser default.",
        "definitionKey": "idea-risk",
        "_classBinding": {
          "key": "idea-risk",
          "sourceRef": "github://mikemartinez1974/public/templates/idea-template/classes/nodes/idea-risk.node-class.node",
