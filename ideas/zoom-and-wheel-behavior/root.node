    {
      "id": "zoom-and-wheel-behavior-evidence-arbiter",
      "type": "idea-evidence",
      "label": "The Arbiter Already Decides Wheel Ownership",
      "root": false,
      "position": {
        "x": 1700,
        "y": 260
      },
      "width": 400,
      "height": 300,
      "ports": [
        {
          "id": "root",
