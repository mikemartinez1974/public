      "data": {
        "title": "Focus Becomes a Grab Bag",
        "description": "Selection, hover, keyboard target, editor state, branch expansion, and zoom exceptions could all get shoved into one focus object until its meaning becomes unstable.",
        "likelihood": "medium",
        "impact": "high",
        "mitigation": "Define focus narrowly as authoritative semantic attention. Model other interaction states separately and let presentation resolution combine them explicitly.",
        "definitionKey": "idea-risk",
        "_classBinding": {
          "key": "idea-risk",
          "sourceRef": "github://mikemartinez1974/public/templates/idea-template/classes/nodes/idea-risk.node-class.node"
