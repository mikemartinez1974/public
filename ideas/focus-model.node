        "identity": {
          "graphId": "focus-model",
          "portId": "root",
          "name": "Focus as a First-Class Presentation Context"
        },
        "title": "Focus as a First-Class Presentation Context",
        "purpose": "Define the smallest authoritative focus model needed before semantic zoom renderer migration.",
        "renderShape": {
          "kind": "svg"
        },
        "svg": "<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 560 320' role='img' aria-label='Focus Model'><defs><linearGradient id='focus-bg' x1='0' y1='0' x2='1' y2='1'><stop offset='0' stop-color='#111827'/><stop offset='.55' stop-color='#312e81'/><stop offset='1' stop-color='#0f766e'/></linearGradient><radialGradient id='focus-halo'><stop offset='0' stop-color='#fef3c7' stop-opacity='.95'/><stop offset='1' stop-color='#f59e0b' stop-opacity='.08'/></radialGradient></defs><rect x='5' y='5' width='550' height='310' rx='32' fill='url(#focus-bg)' stroke='#a5f3fc' stroke-width='3'/><g stroke='#64748b' stroke-width='3' fill='#1e293b'><path d='M92 165 L205 105 L320 165 L438 105'/><path d='M205 105 L205 230'/><path d='M320 165 L410 230'/><circle cx='92' cy='165' r='18'/><circle cx='205' cy='105' r='20'/><circle cx='205' cy='230' r='18'/><circle cx='320' cy='165' r='18'/><circle cx='438' cy='105' r='18'/><circle cx='410' cy='230' r='18'/></g><circle cx='320' cy='165' r='58' fill='url(#focus-halo)'/><circle cx='320' cy='165' r='25' fill='#fbbf24' stroke='#fff7ed' stroke-width='4'/><path d='M320 165 L410 230' stroke='#fbbf24' stroke-width='6'/><circle cx='410' cy='230' r='24' fill='#14b8a6' stroke='#ccfbf1' stroke-width='4'/><text x='36' y='56' fill='#cffafe' font-family='system-ui,sans-serif' font-size='13' font-weight='800' letter-spacing='.18em'>ATTENTION CHANGES PRESENTATION</text><text x='36' y='286' fill='#ffffff' font-family='system-ui,sans-serif' font-size='34' font-weight='850'>Focus Model</text><text x='356' y='286' fill='#ccfbf1' font-family='system-ui,sans-serif' font-size='14'>zoom sets default · focus promotes meaning</text></svg>",
        "altText": "A network where one focused node and its branch are promoted from the surrounding graph.",
        "view": {
          "intent": "node",
          "payload": "node.web.summary",
          "label": "Focus Model"
        },
        "payload": "node.web.summary",
