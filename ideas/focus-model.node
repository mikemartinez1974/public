      "data": {
        "title": "Minimal Authoritative Focus Primitive",
        "description": "Define one authoritative focus state and a focus-relation resolver. Keep the zoom-band resolver pure and separate. Let a presentation resolver combine base zoom band, focus relationship, and explicit interaction state to choose the requested surface.",
        "differentiator": "Focus does not replace zoom and zoom does not own focus. Distance provides the default; attention provides explicit local promotion.",
        "definitionKey": "idea-proposed-approach",
