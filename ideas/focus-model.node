      "data": {
        "title": "Zoom Alone Cannot Explain Attention",
        "statement": "A graph can be globally zoomed out while the user is actively expanding or working inside one branch. If scale alone controls presentation, newly relevant nodes can collapse into dots or glyphs exactly when the user needs meaningful information.",
        "impact": "Large graphs become hard to work in because the viewport's distance overrides the user's local intent. Branch expansion and semantic zoom can appear to fight each other.",
        "urgency": "high",
        "definitionKey": "idea-problem",
