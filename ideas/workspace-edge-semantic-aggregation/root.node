      "data": {
        "title": "Bundles Can Hide Meaning and Edges Lack Inspectable Depth",
        "statement": "Automatic far-zoom aggregation replaces distinct relationships with one thick stroke, shared-surface labels use separate presentation machinery, and ordinary edges have no direct path to evidence or references.",
        "impact": "Readers may lose relationship count, type, direction, and provenance precisely when a claim needs scrutiny.",
        "urgency": "high",
        "definitionKey": "idea-problem",
