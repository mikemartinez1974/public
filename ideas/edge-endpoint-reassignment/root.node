      "visible": true,
      "showLabel": false,
      "data": {
        "title": "Detach, negotiate, and atomically reconnect",
        "description": "Dragging a connected endpoint detaches that end into a live tether while the opposite endpoint remains anchored. Compatible Ports are revealed. A valid drop updates the endpoint; cancellation restores the original connection.",
        "differentiator": "The interaction preserves edge identity, type, label, style, and metadata unless endpoint compatibility requires an explicit negotiated change.",
        "definitionKey": "idea-proposed-approach",
        "_classBinding": {
          "key": "idea-proposed-approach",
          "sourceRef": "github://mikemartinez1974/public/templates/idea-template/classes/nodes/idea-proposed-approach.node-class.node"
