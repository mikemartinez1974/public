      "data": {
        "title": "Accidental disconnect or semantic mutation",
        "description": "A reconnect gesture could be confused with node dragging or new-edge creation, or could attach an edge to a Port that changes its meaning.",
        "likelihood": "medium",
        "impact": "high",
        "mitigation": "Use an endpoint-specific grab target, preserve the original edge as a reversible draft, reveal only compatible targets, cancel back to the original endpoint, and commit as one undoable transaction.",
        "definitionKey": "idea-risk",
        "_classBinding": {
          "key": "idea-risk",
