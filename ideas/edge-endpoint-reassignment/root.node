      "data": {
        "title": "Reconnect an existing edge by moving either endpoint",
        "statement": "An author can unplug one endpoint of an existing edge and drop it on another compatible Port while preserving the edge as the same relationship.",
        "status": "framed",
        "confidence": "plausible",
        "notes": "Endpoint reassignment is edge editing. It is distinct from creating a new edge, creating a node from a handle, or deleting and recreating a relationship.",
        "definitionKey": "idea",
