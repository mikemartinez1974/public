      "data": {
        "title": "Explanations Collapse Into Undifferentiated Documents",
        "statement": "General explanations often become long markdown blocks or linear articles that hide which question each passage answers, how claims relate, and where sources, examples, or caveats belong.",
        "impact": "Readers, authors, and agents cannot quickly navigate the explanation, identify missing coverage, inspect support, or reuse its structure across subjects.",
        "urgency": "medium",
        "definitionKey": "idea-problem",
