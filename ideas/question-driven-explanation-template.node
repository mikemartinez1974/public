      "data": {
        "title": "Questions Should Organize Explanations",
        "statement": "A reusable graph template should explain any subject through a central topic, repeatable question nodes carrying lenses such as who, what, where, when, why, and how, answer nodes, supporting context, and a synthesized summary.",
        "status": "framed",
        "confidence": "plausible",
        "notes": "The template should behave as an explanation machine: Topic is examined by Questions; Questions are answered by Answers; Answers are supported, illustrated, qualified, and synthesized.",
        "definitionKey": "idea",
