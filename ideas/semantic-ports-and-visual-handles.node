      "data": {
        "title": "Separate Semantic Ports from Visual Handles",
        "statement": "A Port is an addressable connection contract; a Handle is a rendered interaction anchor bound to that Port, and an edge may preserve both identities.",
        "status": "framed",
        "confidence": "plausible",
        "notes": "This extends the authored-interface model without making canvas-side placement part of semantic identity.",
        "definitionKey": "idea",
