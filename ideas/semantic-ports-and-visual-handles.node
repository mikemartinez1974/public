      ],
      "visible": true,
      "showLabel": false,
      "data": {
        "title": "Two-Layer Endpoint Contract",
        "description": "Give every edge-capable node an explicit or implicit semantic Port. Project one or more visual Handles from that Port. Persist sourcePort/targetPort for meaning and optional sourceAnchor/targetAnchor for presentation. Focus determines which handles are shown.",
        "differentiator": "Moving or hiding a Handle no longer changes the connection contract, and legacy side handles can migrate to root plus an anchor without losing edge geometry.",
        "definitionKey": "idea-proposed-approach",
        "_classBinding": {
          "key": "idea-proposed-approach",
          "sourceRef": "github://mikemartinez1974/public/templates/idea-template/classes/nodes/idea-proposed-approach.node-class.node"
        },
        "_bridge": {
          "classKey": "idea-proposed-approach",
          "classRef": "github://mikemartinez1974/public/templates/idea-template/classes/nodes/idea-proposed-approach.node-class.node",
          "entryPort": "root",
          "kind": "node-class",
          "sourceRef": "github://mikemartinez1974/public/templates/idea-template/classes/nodes/idea-proposed-approach.node-class.node",
          "targetKind": "node-class"
        },
        "identity": {
          "graphId": "semantic-ports-and-visual-handles"
        }
      }
    },
