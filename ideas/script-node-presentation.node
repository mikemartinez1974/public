      "showLabel": false,
      "data": {
        "title": "A Full Placeable Script Contract",
        "description": "Give Script nodes dot/icon, summary, detail, and editor views; present configuration, inputs, outputs, effects, permissions, singleton rules, and companion-node requirements; retain source editing as an advanced surface.",
        "differentiator": "The script becomes an inspectable behavior object. Templates can then offer whole-graph derivation, selective placement, or both according to the use case.",
        "definitionKey": "idea-proposed-approach",
        "_classBinding": {
          "key": "idea-proposed-approach",
          "sourceRef": "github://mikemartinez1974/public/templates/idea-template/classes/nodes/idea-proposed-approach.node-class.node"
