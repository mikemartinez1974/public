      "data": {
        "title": "Scripts Are Functionally Reusable but Experientially Opaque",
        "statement": "Script nodes can carry valuable graph-owned behavior, but their current presentation does not explain what they do, require, affect, or install.",
        "impact": "Authors must copy entire templates to obtain behavior safely, which hides the actual reusable unit and makes derivation heavier than necessary.",
        "urgency": "high",
        "definitionKey": "idea-problem",
