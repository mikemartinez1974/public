      "showLabel": false,
      "data": {
        "title": "Scripts Should Be Placeable Behavior Nodes",
        "statement": "Every functional piece of a graph template should ultimately be understandable and placeable, including scripts. Whole-template copying should remain a convenience rather than the only way to acquire scripted behavior.",
        "status": "framed",
        "confidence": "plausible",
        "notes": "A bridge makes a type available; a script supplies behavior; a capability may compose several placeable nodes; a template arranges those pieces into a useful starting graph.",
        "definitionKey": "idea",
        "_classBinding": {
          "key": "idea",
          "sourceRef": "github://mikemartinez1974/public/templates/idea-template/classes/nodes/idea.node-class.node"
