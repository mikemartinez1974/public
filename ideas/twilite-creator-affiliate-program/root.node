{"fileVersion":"1.0","metadata":{"title":"Twilite Creator Affiliate Program","description":"Explore a creator-led recurring affiliate program for Twilite.","graphId":"twilite-creator-affiliate-program","version":"0.1.0","kind":"graph","created":"2026-08-29T17:58:00.000Z","modified":"2026-08-29T17:58:00.000Z","tags":["idea","affiliate","marketing","distribution","creators"],"preferredViewer":"https://dev.twilite.zone"},"nodes":[{"id":"twilite-creator-affiliate-declaration","type":"declaration","label":"Twilite Creator Affiliate Program Declaration","position":{"x":-850,"y":-1050},"width":360,"height":240,"ports":[{"id":"default-view","label":"default view","direction":"output","dataType":"any","angle":165},{"id":"summary-view","label":"summary view","direction":"output","dataType":"any","angle":180},{"id":"icon-view","label":"icon view","direction":"output","dataType":"any","angle":195},{"id":"glyph","label":"glyph","direction":"output","dataType":"any","angle":270},{"id":"landing-surface","label":"landing surface","direction":"output","dataType":"any","angle":0}],"visible":true,"showLabel":true,"data":{"identity":{"graphId":"twilite-creator-affiliate-program","name":"Twilite Creator Affiliate Program","version":"0.1.0","description":"Explore a creator-led recurring affiliate program for Twilite."},"intent":{"kind":"graph","scope":"public"},"dependencies":{"nodeTypes":["declaration","view","content","glyph","idea","idea-problem","idea-audience","idea-proposed-approach","idea-assumption","idea-risk","idea-next-step"],"skills":["idea-template"],"portContracts":["core"]},"authority":{"mutation":{"allowCreate":true,"allowUpdate":true,"allowDelete":true,"appendOnly":false},"actors":{"humans":true,"agents":true,"tools":true}},"settings":{"snapToGrid":false,"gridSize":20,"edgeRouting":"auto","autoSave":false},"declaration":{"kind":"graph","targetMode":"artifact","artifactKind":"graph","interfaceContract":{"version":1,"implicitRootPort":true},"defaultSurfaceId":"default-view","surfaces":[{"id":"default-view","kind":"view","label":"Affiliate Program","viewNodeId":"twilite-creator-affiliate-detail-view"},{"id":"summary-view","kind":"view","label":"Affiliate Summary","viewNodeId":"twilite-creator-affiliate-summary-view"},{"id":"icon-view","kind":"view","label":"Affiliate Icon","viewNodeId":"twilite-creator-affiliate-icon-view"},{"id":"glyph","kind":"view","label":"Affiliate Glyph","viewNodeId":"twilite-creator-affiliate-glyph"},{"id":"landing-surface","kind":"view","label":"Affiliate Landing","viewNodeId":"twilite-creator-affiliate-landing-surface"}]}}},{"id":"twilite-creator-affiliate-detail-view","type":"view","label":"Creator Affiliate Detail","position":{"x":-300,"y":-950},"width":640,"height":260,"ports":[{"id":"root","label":"root","direction":"bidirectional","dataType":"any","angle":210}],"visible":true,"showLabel":true,"data":{"identity":{"graphId":"twilite-creator-affiliate-program"},"content":{"kind":"markdown","value":"# Twilite Creator Affiliate Program\n\nCreators make useful public Twilite content, refer customers, and receive a recurring share of the subscription revenue they originate."}}},{"id":"twilite-creator-affiliate-summary-view","type":"view","label":"Creator Affiliate Summary","position":{"x":420,"y":-950},"width":580,"height":250,"ports":[{"id":"root","label":"root","direction":"bidirectional","dataType":"any","angle":210}],"visible":true,"showLabel":true,"data":{"identity":{"graphId":"twilite-creator-affiliate-program"},"content":{"kind":"markdown","value":"## Working offer\n\n**25% recurring commission** on Twilite subscription revenue from customers the creator originates, for as long as those customers remain subscribed."}}},{"id":"twilite-creator-affiliate-icon-view","type":"view","label":"Creator Affiliate Icon","position":{"x":-300,"y":-620},"width":380,"height":250,"ports":[{"id":"root","label":"root","direction":"bidirectional","dataType":"any","angle":210}],"visible":true,"showLabel":true,"data":{"identity":{"graphId":"twilite-creator-affiliate-program"},"content":{"kind":"svg","value":"<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 320 220'><rect width='320' height='220' rx='28' fill='#0f172a'/><circle cx='92' cy='108' r='42' fill='#7c3aed'/><path d='M82 91 L126 108 L82 125 Z' fill='#fff'/><path d='M145 108 H205' stroke='#c4b5fd' stroke-width='10' stroke-linecap='round'/><circle cx='235' cy='108' r='34' fill='#22c55e'/><text x='235' y='117' text-anchor='middle' fill='#06230f' font-family='system-ui' font-size='25' font-weight='900'>25%</text></svg>"}}},{"id":"twilite-creator-affiliate-glyph","type":"glyph","label":"Affiliate Glyph","position":{"x":160,"y":-620},"width":240,"height":200,"ports":[{"id":"root","label":"root","direction":"bidirectional","dataType":"any","angle":210}],"visible":true,"showLabel":true,"data":{"identity":{"graphId":"twilite-creator-affiliate-program"},"glyph":{"kind":"icon","name":"Share2"}}},{"id":"twilite-creator-affiliate-landing-surface","type":"content","label":"Creator Affiliate Landing","position":{"x":480,"y":-620},"width":620,"height":250,"ports":[{"id":"root","label":"root","direction":"bidirectional","dataType":"any","angle":210}],"visible":true,"showLabel":true,"data":{"identity":{"graphId":"twilite-creator-affiliate-program"},"content":{"kind":"markdown","value":"# Create → Refer → Earn\n\nMake something useful about Twilite. Send people to it. Share in the recurring revenue from the customers you originate."}}},{"id":"twilite-creator-affiliate-idea","type":"idea","label":"Creator Revenue Shares as Distribution","position":{"x":-180,"y":-220},"width":420,"height":280,"ports":[{"id":"root","label":"root","direction":"bidirectional","dataType":"any","angle":210}],"visible":true,"showLabel":false,"data":{"title":"Creator Revenue Shares as Distribution","statement":"Offer creators 25% of recurring Twilite subscription revenue from customers they originate, for as long as those customers remain subscribed.","status":"framed","confidence":"promising","notes":"This is an affiliate model, not a commissioned sales role.","definitionKey":"idea","_classBinding":{"key":"idea","sourceRef":"github://mikemartinez1974/public/templates/idea-template/classes/nodes/idea.node-class.node"},"identity":{"graphId":"twilite-creator-affiliate-program"}}},{"id":"twilite-creator-affiliate-problem","type":"idea-problem","label":"Twilite Needs Scalable Distribution","position":{"x":-700,"y":160},"width":420,"height":280,"ports":[{"id":"root","label":"root","direction":"bidirectional","dataType":"any","angle":210}],"visible":true,"showLabel":false,"data":{"title":"Twilite Needs Scalable Distribution","statement":"Twilite needs awareness, demonstrations, tutorials, and customer acquisition without funding a conventional sales organization or large paid-media budget.","impact":"A strong product still needs repeatable distribution.","urgency":"high","definitionKey":"idea-problem","_classBinding":{"key":"idea-problem","sourceRef":"github://mikemartinez1974/public/templates/idea-template/classes/nodes/idea-problem.node-class.node"},"identity":{"graphId":"twilite-creator-affiliate-program"}}},{"id":"twilite-creator-affiliate-audience","type":"idea-audience","label":"Technical Creators and Educators","position":{"x":-220,"y":160},"width":420,"height":280,"ports":[{"id":"root","label":"root","direction":"bidirectional","dataType":"any","angle":210}],"visible":true,"showLabel":false,"data":{"title":"Technical Creators and Educators","description":"YouTubers, bloggers, developers, educators, productivity creators, and graph/AI enthusiasts with audiences that overlap Twilite's likely users.","needs":"A product worth demonstrating, simple attribution, and enough recurring upside to justify making good content.","definitionKey":"idea-audience","_classBinding":{"key":"idea-audience","sourceRef":"github://mikemartinez1974/public/templates/idea-template/classes/nodes/idea-audience.node-class.node"},"identity":{"graphId":"twilite-creator-affiliate-program"}}},{"id":"twilite-creator-affiliate-approach","type":"idea-proposed-approach","label":"25% Lifetime Recurring Affiliate Share","position":{"x":260,"y":160},"width":420,"height":280,"ports":[{"id":"root","label":"root","direction":"bidirectional","dataType":"any","angle":210}],"visible":true,"showLabel":false,"data":{"title":"25% Lifetime Recurring Affiliate Share","description":"Give each creator a tracked referral link. Attribute paying subscribers to that creator and pay 25% of collected subscription revenue for the lifetime of the subscription.","differentiator":"Twilite pays for distribution only when it produces revenue; the creator accumulates a recurring income stream.","definitionKey":"idea-proposed-approach","_classBinding":{"key":"idea-proposed-approach","sourceRef":"github://mikemartinez1974/public/templates/idea-template/classes/nodes/idea-proposed-approach.node-class.node"},"identity":{"graphId":"twilite-creator-affiliate-program"}}},{"id":"twilite-creator-affiliate-assumption","type":"idea-assumption","label":"Recurring Upside Motivates Repeat Coverage","position":{"x":-460,"y":540},"width":420,"height":280,"ports":[{"id":"root","label":"root","direction":"bidirectional","dataType":"any","angle":210}],"visible":true,"showLabel":false,"data":{"title":"Recurring Upside Motivates Repeat Coverage","assumption":"Creators will be more willing to make and repeat useful Twilite content when referrals compound into recurring income rather than a small one-time bounty.","status":"untested","validation":"Recruit a small first cohort and measure whether creators publish, refer, and publish again.","definitionKey":"idea-assumption","_classBinding":{"key":"idea-assumption","sourceRef":"github://mikemartinez1974/public/templates/idea-template/classes/nodes/idea-assumption.node-class.node"},"identity":{"graphId":"twilite-creator-affiliate-program"}}},{"id":"twilite-creator-affiliate-risk","type":"idea-risk","label":"Attribution and Abuse Can Poison Trust","position":{"x":20,"y":540},"width":420,"height":280,"ports":[{"id":"root","label":"root","direction":"bidirectional","dataType":"any","angle":210}],"visible":true,"showLabel":false,"data":{"title":"Attribution and Abuse Can Poison Trust","description":"Unclear attribution, self-referrals, refund games, coupon leakage, or changing commission rules could create disputes and destroy creator trust.","likelihood":"medium","impact":"high","mitigation":"Define attribution window, eligible collected revenue, refunds, payout timing, self-referral policy, and grandfathering before launch.","definitionKey":"idea-risk","_classBinding":{"key":"idea-risk","sourceRef":"github://mikemartinez1974/public/templates/idea-template/classes/nodes/idea-risk.node-class.node"},"identity":{"graphId":"twilite-creator-affiliate-program"}}},{"id":"twilite-creator-affiliate-next-step","type":"idea-next-step","label":"Write the Offer and Run a Pilot","position":{"x":500,"y":540},"width":420,"height":280,"ports":[{"id":"root","label":"root","direction":"bidirectional","dataType":"any","angle":210}],"visible":true,"showLabel":false,"data":{"title":"Write the Offer and Run a Pilot","action":"Write a one-page affiliate offer and tracking contract, then invite a small number of creators to test the 25% lifetime recurring model.","expectedEvidence":"Whether qualified creators accept, publish useful content, generate attributable signups, and view the economics as worth repeating.","status":"todo","definitionKey":"idea-next-step","_classBinding":{"key":"idea-next-step","sourceRef":"github://mikemartinez1974/public/templates/idea-template/classes/nodes/idea-next-step.node-class.node"},"identity":{"graphId":"twilite-creator-affiliate-program"}}}],"edges":[{"id":"twilite-creator-affiliate-decl-detail","type":"default-view","source":"twilite-creator-affiliate-declaration","target":"twilite-creator-affiliate-detail-view","sourcePort":"default-view","targetPort":"root","label":"","style":{},