      ],
      "visible": true,
      "showLabel": false,
      "data": {
        "title": "Ports Supply Named Relationship Handles",
        "description": "Let a Port author stable handles for relationships it considers important. Each handle binds to the supplying Port, declares its relationship role and allowed edge class, and may add behavior such as creating the expected target. Declaration uses the same contract for `primary-view`, positioned at 0 degrees, to name or create the landing View.",
        "differentiator": "The affordance, edge meaning, placement, and optional behavior become inspectable graph data instead of per-renderer defaults or hard-coded declaration exceptions.",
        "definitionKey": "idea-proposed-approach",
        "_classBinding": {
          "key": "idea-proposed-approach",
          "sourceRef": "github://mikemartinez1974/public/templates/idea-template/classes/nodes/idea-proposed-approach.node-class.node"
        },
