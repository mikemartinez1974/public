      "data": {
        "title": "Does Declaration Need an Ordinary Root Port?",
        "question": "If `primary-view` names the landing surface and supplies the default-view creation affordance, what independent semantic responsibility remains for a Declaration `root` port?",
        "status": "open",
        "answer": "",
        "identity": {
          "graphId": "relationship-handles-as-graph-structure"
        },
        "notes": "Do not answer this from compatibility alone. Separate graph entry/navigation, declaration authority, landing-surface selection, and instantiated-node connectivity, then decide whether root has a distinct job.",
        "resolutionPath": "Compare a Declaration with only primary-view against one with root plus primary-view in toolbar creation, graph loading, navigation, validation, and node instantiation.",
        "classRef": "github://mikemartinez1974/public/templates/idea-template/classes/nodes/idea-question.node-class.node"
