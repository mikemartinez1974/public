          }
        }
      ],
      "visible": true,
      "showLabel": false,
      "data": {
        "title": "The pattern already holds for the Edge Class template",
        "observation": "In the running app, editing any of the seven Edge Class properties, or a stroke's color, width or dash, updated the icon, summary and detail views through one Method. Adding a stroke node to the graph took the views from two strokes to three with nothing connecting it (every stroke node in the graph paints), and recoloring or disabling a stroke added later was covered by the class Handler with no new wiring. The Method's output matched the app's own renderer exactly across 13 variations.",
        "kind": "prototype",
        "strength": "strong",
        "definitionKey": "idea-evidence",
        "_classBinding": {
          "key": "idea-evidence",
          "sourceRef": "github://mikemartinez1974/public/templates/idea-template/classes/nodes/idea-evidence.node-class.node",
