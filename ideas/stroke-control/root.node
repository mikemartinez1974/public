      "showLabel": false,
      "data": {
        "title": "One stroke per control graph, or the whole paint stack?",
        "question": "Is a stroke one instance of the control graph, with the edge class holding a list of instances, or does one control graph hold the whole paint stack?",
        "status": "open",
        "answer": "Lean towards one instance per stroke. It matches how strokes are added and removed today and keeps the control small. The edge class's paint stack is then its own control, built from Stroke Controls.",
        "definitionKey": "idea-question",
