          "label": "advances",
          "direction": "bidirectional",
          "dataType": "any",
          "angle": 180,
          "role": "relationship",
          "allowedEdgeTypes": [
            "reference"
          ],
          "metadata": {
            "relationship": true,
            "role": "relationship"
          }
        }
      ],
      "visible": true,
      "showLabel": false,
      "data": {
        "title": "A Stroke Control graph, consumed through a Bridge",
        "description": "Create a Stroke Control graph template: a Declaration exposing five Properties (color, width, opacity, dash, enabled), a swatch view drawn from them, and one class-scoped Handler calling one Method that re-renders the swatch, the same pattern as the Edge Class template. An export Bridge exposes the Properties' events. The Edge Class template imports the control through a Bridge and reacts to its events, so each stroke is an instance of the control instead of a field node. This needs Bridges to carry class-scoped events, so a Handler can listen to any stroke control without being wired to each one.",
        "differentiator": "It reuses machinery that already exists and has been checked in the app (Property events, class-scoped Handlers, Methods that write stored views) and gives Bridges a real job, instead of adding a stroke-specific editor.",
        "definitionKey": "idea-proposed-approach",
        "_classBinding": {
          "key": "idea-proposed-approach",
          "sourceRef": "github://mikemartinez1974/public/templates/idea-template/classes/nodes/idea-proposed-approach.node-class.node",
          "defaults": {
            "ports": [
              {
                "id": "root",
                "key": "root",
                "label": "root",
                "direction": "bidirectional",
                "dataType": "any",
                "angle": 180
              }
            ],
            "data": {
              "presentation": {
                "glyph": {
                  "kind": "icon",
                  "name": "Route"
                }
              }
            }
          }
        },
        "_bridge": {
          "classKey": "idea-proposed-approach",
          "classRef": "github://mikemartinez1974/public/templates/idea-template/classes/nodes/idea-proposed-approach.node-class.node",
          "entryPort": "root",
          "kind": "node-class",
          "sourceRef": "github://mikemartinez1974/public/templates/idea-template/classes/nodes/idea-proposed-approach.node-class.node",
          "targetKind": "node-class"
        },
        "identity": {
