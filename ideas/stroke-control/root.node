    {
      "id": "stroke-control-idea-proposed-approach",
      "type": "idea-proposed-approach",
      "label": "A Stroke Control Graph, Consumed Through a Bridge",
      "root": false,
      "position": {
        "x": 560,
        "y": -160
      },
      "width": 400,
      "height": 300,
      "ports": [
        {
          "id": "root",
          "label": "root",
          "direction": "bidirectional",
          "dataType": "any",
          "angle": 210
        },
        {
          "id": "questioned-by",
