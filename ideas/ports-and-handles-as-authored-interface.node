      "data": {
        "title": "Automatic Layout Could Accidentally Rewrite the Interface",
        "description": "If boundary primitives and interior presentation content participate in the same unconstrained layout pass, auto-layout, cleanup, or incidental dragging could rotate runtime endpoints and silently redesign the node interface.",
        "severity": "high",
        "likelihood": "medium",
        "impact": "high",
        "mitigation": "Treat Title, Declaration, Ports, and Handles as structural boundary participants. Title remains the center; Declaration fixes root direction and radius; Port and Handle directions are protected. Auto-layout packs portals and other content only inside the circle and may translate or scale the frame as a unit without changing boundary directions. In 3D, apply the same rule to the enclosing sphere.",
        "definitionKey": "idea-risk",
        "_classBinding": {
          "key": "idea-risk",
          "sourceRef": "github://mikemartinez1974/public/templates/idea-template/classes/nodes/idea-risk.node-class.node"
