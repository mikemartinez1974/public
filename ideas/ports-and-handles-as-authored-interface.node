      ],
      "data": {
        "title": "What Is the Geometric and Navigational Anchor?",
        "question": "What structure establishes the geometric frame and the focus target when navigation enters through root?",
        "whyItMatters": "The anchor determines both placement math and the navigation affordance for entering a node's defining graph.",
        "status": "answered",
        "answer": "The Declaration serves as the durable root Port. A Handle on the Declaration creates a typed structural edge to a receptive Port on the Title node. The Title position is the frame center. The vector from Title to Declaration establishes the root direction, and their distance establishes the circular frame radius. Ports and Handles project onto that boundary. Navigation entering through root resolves the Declaration and follows the structural title relationship to focus the Title node. In three dimensions, the circle becomes a sphere and the same vector math applies.",
        "definitionKey": "idea-question",
        "_classBinding": {
          "key": "idea-question",
          "sourceRef": "github://mikemartinez1974/public/templates/idea-template/classes/nodes/idea-question.node-class.node"
        },
        "_bridge": {
