          "angle": 210
        }
      ],
      "data": {
        "title": "Ports and Handles Are Collapsed into Symmetric Consumer Metadata",
        "description": "Twilite currently stores ports as bidirectional endpoint descriptions, treats handles primarily as renderer concerns, synthesizes unnecessary side handles, and clones the source node type when a handle is dropped on empty canvas. Authors cannot see or design the real interaction surface inside the graph that defines the node.",
        "severity": "high",
        "definitionKey": "idea-problem",
        "_classBinding": {
          "key": "idea-problem",
          "sourceRef": "github://mikemartinez1974/public/templates/idea-template/classes/nodes/idea-problem.node-class.node"
        },
        "_bridge": {
