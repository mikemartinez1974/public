      ],
      "data": {
        "title": "Author Receptive Ports and Actionable Handle Ports Around the Node Surface",
        "description": "Treat Port as the base endpoint primitive and Handle as its operative specialization: every Handle is a Port, but not every Port is a Handle. Plain Ports receive compatible connections. Handles retain that receptive Port identity, can initiate a drag, and may declare optional actions such as create, navigate, materialize, invoke, or emit. Relationships and their meanings remain on edges and edge classes. The Declaration owns the root Port and its title Handle connects to the Title node's receptive Port. The Title is the center of a circular interface frame; the Declaration's position establishes the root direction and frame radius. Ports and Handles project to the boundary, while portals and other content may be auto-arranged inside it. In three dimensions the same contract becomes a sphere.",
        "differentiator": "The interface becomes inspectable graph structure. Authors design receptive endpoints, operative endpoints, logical flow, and physical placement in the same space. A Handle requires no separate matching Port because it already carries the Port contract.",
        "definitionKey": "idea-proposed-approach",
        "_classBinding": {
          "key": "idea-proposed-approach",
          "sourceRef": "github://mikemartinez1974/public/templates/idea-template/classes/nodes/idea-proposed-approach.node-class.node"
        },
        "_bridge": {
          "classKey": "idea-proposed-approach",
          "classRef": "github://mikemartinez1974/public/templates/idea-template/classes/nodes/idea-proposed-approach.node-class.node",
          "entryPort": "root",
          "kind": "node-class",
          "sourceRef": "github://mikemartinez1974/public/templates/idea-template/classes/nodes/idea-proposed-approach.node-class.node",
          "targetKind": "node-class"
        },
        "identity": {
          "graphId": "ports-and-handles-as-authored-interface"
        }
      }
    },
