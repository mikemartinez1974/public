      ],
      "data": {
        "title": "Build the Handle Primitive and One Projection Smoke Test",
        "action": "Define Port as the single endpoint primitive with independent acceptance and initiating behaviors. Define the Title-centered edit-mode outline projection, Declaration-derived root orientation, Port drop events, optional actions, and action-target authority. Upgrade the Dynamic Port Expansion smoke graph so three authored section records project three actionable Port affordances onto the boundary, create Wikipedia Section nodes, and connect to their receiving Ports.",
        "expectedEvidence": "The class graph visibly explains what the node accepts, which Ports expose handle affordances, what optional actions they offer, and where those endpoints project on the zoom-1 node outline. Auto-layout arranges portals and other movable content inside the frame without changing endpoint directions. Runtime instances contain no unexplained synthetic side handles, redundant matching Ports, or manually authored angle, side, radius, or offset.",
        "status": "todo",
        "definitionKey": "idea-next-step",
        "_classBinding": {
          "key": "idea-next-step",
