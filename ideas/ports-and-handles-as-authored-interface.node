      ],
      "data": {
        "title": "What Is the Geometric and Navigational Anchor?",
        "question": "What structure establishes the geometric frame and the focus target when navigation enters through root?",
        "whyItMatters": "The anchor determines both placement math and the navigation affordance for entering a node's defining graph.",
        "status": "answered",
        "answer": "The Declaration serves as the durable root Port and has a typed structural relationship to the Title node. Title is the authoring center and root navigation focus. The Title-to-Declaration vector establishes root orientation and what an instantiated root affordance is expected to do, but its length does not have to determine rendered node size. In edit mode, Twilite should project the instantiated node's zoom-1 outline behind the graph; Ports project to that boundary from their authored directions.",
        "definitionKey": "idea-question",
        "_classBinding": {
          "key": "idea-question",
          "sourceRef": "github://mikemartinez1974/public/templates/idea-template/classes/nodes/idea-question.node-class.node"
        },
        "_bridge": {
