      ],
      "data": {
        "title": "Automatic Layout Could Accidentally Rewrite the Interface",
        "description": "If ordinary node movement is treated as functional geometry, auto-layout, cleanup, or incidental dragging could move runtime endpoints and destabilize existing diagrams.",
        "severity": "high",
        "likelihood": "medium",
        "impact": "high",
        "mitigation": "Only project geometry inside an explicit interface-design frame. Preserve semantic role independently, store normalized derived placement, lock or deliberately version functional layout, and warn before auto-layout changes the frame.",
        "definitionKey": "idea-risk",
        "_classBinding": {
          "key": "idea-risk",
