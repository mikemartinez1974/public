      ],
      "data": {
        "title": "Author Receptive Ports and Operative Handles Around the Node Surface",
        "description": "Introduce Handle as a primitive beside Port. Port primitives declare accepted semantic inputs. Handle primitives declare actions such as create, connect, navigate, materialize, invoke, or emit. Relationships bind actions to authorized targets. The compiler projects primitive positions relative to the root or title surface onto the node perimeter.",
        "differentiator": "The interface becomes inspectable graph structure. Authors design logical flow and physical placement in the same space instead of managing unrelated angle, side, radius, and offset fields.",
        "definitionKey": "idea-proposed-approach",
        "_classBinding": {
          "key": "idea-proposed-approach",
          "sourceRef": "github://mikemartinez1974/public/templates/idea-template/classes/nodes/idea-proposed-approach.node-class.node"
        },
        "_bridge": {
