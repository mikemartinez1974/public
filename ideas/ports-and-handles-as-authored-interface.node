        }
      ],
      "data": {
        "title": "Automatic Layout Could Accidentally Rewrite the Interface",
        "description": "If boundary primitives and interior presentation content participate in the same unconstrained layout pass, auto-layout, cleanup, or incidental dragging could rotate runtime endpoints and silently redesign the node interface.",
        "severity": "high",
        "likelihood": "medium",
        "impact": "high",
        "mitigation": "Treat Title, Declaration, and Ports as structural interface participants. Title remains the center; the Declaration-to-Title relationship fixes root orientation; Port directions are protected. In edit mode, project the node's zoom-1 outline as the visible boundary. Auto-layout packs portals and other movable content inside that outline without rewriting endpoint directions or confusing root distance with rendered size.",
        "definitionKey": "idea-risk",
        "_classBinding": {
          "key": "idea-risk",
          "sourceRef": "github://mikemartinez1974/public/templates/idea-template/classes/nodes/idea-risk.node-class.node"
        },
