      ],
      "data": {
        "title": "How Should Port Interaction Behavior Be Represented?",
        "question": "Should Handle be a second primitive, or should a Port project a handle affordance when it declares initiating behavior?",
        "whyItMatters": "The answer determines whether authors maintain competing endpoint primitives or one stable endpoint with independent acceptance and interaction capabilities.",
        "status": "answered",
        "answer": "Port remains the single authored endpoint primitive. A stable Port id makes it addressable and connectable; its label is presentation only. Optional behaviors cause the UI to project a draggable handle affordance. Dropping it emits source node and Port identity plus either target node and Port identity or graph coordinates. Authored behavior may connect, create an authorized node, invoke an action, navigate, open a chooser, or do nothing. Acceptance, initiation, creation, and relationship meaning remain independent declarations; Handle is a presentation state rather than a second primitive.",
        "definitionKey": "idea-question",
        "_classBinding": {
          "key": "idea-question",
          "sourceRef": "github://mikemartinez1974/public/templates/idea-template/classes/nodes/idea-question.node-class.node"
        },
        "_bridge": {
