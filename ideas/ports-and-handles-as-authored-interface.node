      ],
      "data": {
        "title": "Is a Handle a Port with Additional Functionality?",
        "question": "Does bidirectional interaction require a separate matching Port for each Handle, or can Handle formally specialize Port while relationship meaning remains on the edge?",
        "whyItMatters": "The answer determines whether authors maintain paired endpoint primitives or one endpoint with an optional operative capability.",
        "status": "answered",
        "answer": "A Handle is a Port with additional operative functionality. Every Handle retains a receptive Port identity, can initiate a drag, and may declare optional gesture actions. Not every Port is a Handle. No separate matching Port is required. Dropping a Handle on an existing compatible Port creates an edge; dropping it on empty canvas performs its declared empty-drop action or does nothing. The edge or edge class—not the Handle—owns relationship meaning.",
        "definitionKey": "idea-question",
        "_classBinding": {
          "key": "idea-question",
          "sourceRef": "github://mikemartinez1974/public/templates/idea-template/classes/nodes/idea-question.node-class.node"
        },
