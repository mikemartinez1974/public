      ],
      "data": {
        "title": "A Bounded Interface Frame Can Make Graph Geometry Functional Safely",
        "statement": "When edit mode projects the instantiated node's zoom-1 outline behind a Title-centered authoring graph, Port directions can control endpoint projection while ordinary portals and content remain freely arrangeable inside the visible boundary. The Declaration-to-Title relationship supplies root orientation and interaction expectations without dictating literal node size.",
        "importance": "critical",
        "status": "untested",
        "definitionKey": "idea-assumption",
        "_classBinding": {
