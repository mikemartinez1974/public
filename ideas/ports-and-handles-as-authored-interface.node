      "data": {
        "title": "Node Interfaces Should Be Authored as Graph Structure",
        "statement": "A graph that describes a node should use Port primitives to declare addressable endpoints and optional behaviors to declare how users act through them. Port positions in the authoring graph should determine their projected positions on node instances.",
        "status": "framed",
        "confidence": "plausible",
        "notes": "Port = stable endpoint identity. Behavior = optional interaction. Handle = projected affordance. Edge meaning remains independent.",
        "definitionKey": "idea",
        "_classBinding": {
          "key": "idea",
          "sourceRef": "github://mikemartinez1974/public/templates/idea-template/classes/nodes/idea.node-class.node"
