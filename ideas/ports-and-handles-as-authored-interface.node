      "data": {
        "title": "What Is the Geometric and Navigational Anchor?",
        "question": "Should interface primitives project relative to the declared root surface, the title surface, or a dedicated node-body frame? If the title surface is the anchor, should activating it navigate into the node-description graph while root remains the durable address?",
        "whyItMatters": "The anchor determines both placement math and the navigation affordance for entering a node's defining graph.",
        "status": "open",
        "answer": "",
        "definitionKey": "idea-question",
