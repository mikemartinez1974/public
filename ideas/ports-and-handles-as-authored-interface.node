      "data": {
        "title": "Build the Handle Primitive and One Projection Smoke Test",
        "action": "Define the Handle primitive, Handle-to-Port edge contract, action-target authority, and graph-position projection. Upgrade the Dynamic Port Expansion smoke graph so three authored section records project three Handles that create Wikipedia Section nodes and connect to their receptive Ports.",
        "expectedEvidence": "The class graph visibly explains what the node accepts, what actions it offers, and where those affordances appear. Runtime instances contain no unexplained synthetic side handles and require no manually authored angle, side, radius, or offset.",
        "status": "todo",
        "definitionKey": "idea-next-step",
