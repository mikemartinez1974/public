          "targetKind": "node-class"
        },
        "identity": {
          "graphId": "ports-and-handles-as-authored-interface"
        }
      }
    },
    {
      "id": "ports-and-handles-as-authored-interface-approach",
      "type": "idea-proposed-approach",
      "label": "Proposed Approach",
      "root": false,
      "position": {
        "x": 320,
        "y": -260
      },
      "width": 420,
      "height": 310,
      "visible": true,
      "showLabel": false,
      "ports": [
        {
          "id": "root",
          "label": "root",
          "direction": "bidirectional",
          "dataType": "any",
          "angle": 210
        }
      ],
      "data": {
        "title": "Author Receptive Ports and Actionable Handle Ports Around the Node Surface",
        "description": "Treat Port as the single authored endpoint primitive. A Port's stable id makes it connectable; its label is presentation. Independent acceptance and initiating behaviors determine what it receives and whether the UI projects a draggable handle affordance. A completed drag reports the source Port plus either a target node and Port or graph coordinates, and authored behavior decides whether to connect, create, invoke, navigate, choose, or do nothing. Relationships and their meanings remain on edges and edge classes. The Declaration owns the root Port and has a typed structural relationship to Title. Title is the structural center, while the Declaration-to-Title vector establishes root orientation and expected root interaction behavior rather than literal rendered size.",
        "differentiator": "The interface becomes inspectable graph structure without competing endpoint primitives. Authors design stable Ports, independent capabilities, logical flow, and physical placement in one space; Handle is merely the rendered affordance of an actionable Port.",
        "definitionKey": "idea-proposed-approach",
        "_classBinding": {
          "key": "idea-proposed-approach",
          "sourceRef": "github://mikemartinez1974/public/templates/idea-template/classes/nodes/idea-proposed-approach.node-class.node"
        },
        "_bridge": {
          "classKey": "idea-proposed-approach",
          "classRef": "github://mikemartinez1974/public/templates/idea-template/classes/nodes/idea-proposed-approach.node-class.node",
          "entryPort": "root",
          "kind": "node-class",
          "sourceRef": "github://mikemartinez1974/public/templates/idea-template/classes/nodes/idea-proposed-approach.node-class.node",
          "targetKind": "node-class"
        },
        "identity": {
          "graphId": "ports-and-handles-as-authored-interface"
        }
      }
    },
    {
      "id": "ports-and-handles-as-authored-interface-assumption",
