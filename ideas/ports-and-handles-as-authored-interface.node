      ],
      "data": {
        "title": "Node Interfaces Should Be Authored as Graph Structure",
        "statement": "A graph that describes a node should use Port primitives to declare what the node listens for and Handle primitives to declare how users act through it. Their positions in the authoring graph should determine their projected positions on node instances.",
        "status": "framed",
        "confidence": "plausible",
        "notes": "Port = receptive interface. Handle = operative interface. Edge = Handle to Port.",
        "definitionKey": "idea",
        "_classBinding": {
          "key": "idea",
