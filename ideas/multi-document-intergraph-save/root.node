    {
      "id": "multi-document-intergraph-save-idea-proposed-approach",
      "type": "idea-proposed-approach",
      "label": "One Edge · Connected Segments · One Save Set",
      "root": false,
      "position": {
        "x": 260,
        "y": -160
      },
      "width": 400,
      "height": 300,
      "ports": [
