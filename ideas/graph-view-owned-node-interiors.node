      "data": {
        "title": "Graph Views Own Node Rendering",
        "statement": "A node is rendered only through a graph view; that authored view owns its representation, interior, background, and semantic density while the runtime owns chrome, placement, focus, and boundary handles.",
        "status": "testing",
        "confidence": "supported",
        "notes": "This separates semantic representation from runtime interaction without inventing a second node-interior model.",
        "definitionKey": "idea",
