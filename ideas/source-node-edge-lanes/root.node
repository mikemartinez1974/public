      "visible": true,
      "showLabel": false,
      "data": {
        "title": "Edges Enter Shared Space Too Abruptly",
        "statement": "Direct free-space routing makes dense typed relationships fan out immediately, cross nearby content, and lose their visual attachment to the source node.",
        "impact": "Readers struggle to see which node emitted an edge and authors cannot predict how several edges will organize.",
        "urgency": "high",
        "definitionKey": "idea-problem",
        "_classBinding": {
          "key": "idea-problem",
