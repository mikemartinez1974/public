      "data": {
        "title": "Should one handler listen to several triggers?",
        "question": "Should one handler subscribe to several sources or event keys, or should each trigger get its own handler that shares a Method?",
        "status": "open",
        "answer": "Leaning toward several triggers on one handler, because handlers that share a reaction should not have to be duplicated. Unresolved: how the reaction learns which trigger fired, and how several triggers are shown without clutter.",
        "definitionKey": "idea-question",
