    {
      "id": "event-handler-behavior-idea-proposed-approach",
      "type": "idea-proposed-approach",
      "label": "Six Responsibilities on One Node",
      "root": false,
      "position": {
        "x": 560,
        "y": -160
      },
      "width": 400,
      "height": 300,
      "ports": [
        {
          "id": "root",
          "label": "root",
          "direction": "bidirectional",
          "dataType": "any",
          "angle": 210
        },
        {
          "id": "questioned-by",
          "key": "questioned-by",
          "label": "questioned by",
          "direction": "bidirectional",
          "dataType": "any",
          "angle": 0,
          "role": "relationship",
          "allowedEdgeTypes": [
            "reference"
          ],
          "metadata": {
            "relationship": true,
            "role": "relationship"
          }
        },
        {
          "id": "advances",
          "key": "advances",
          "label": "advances",
          "direction": "bidirectional",
          "dataType": "any",
          "angle": 180,
          "role": "relationship",
          "allowedEdgeTypes": [
            "reference"
          ],
          "metadata": {
            "relationship": true,
            "role": "relationship"
          }
        }
      ],
      "visible": true,
      "showLabel": false,
      "data": {
        "title": "Give the handler six explicit responsibilities",
        "description": "Listen: one or more declared triggers (source plus event key) and an enabled switch. Decide: optional declarative conditions on the occurrence, checked before any code runs. Receive: a documented input made of the occurrence's payload, source, fired trigger, and cause chain. React: inline code or a Method call, with the nodes and Properties it may change declared so the effect is inspectable and can be dry-run. Guard: deterministic order among handlers of one event, loop protection, a time limit, and failure isolation. Report: last run outcome, time, duration, and error, kept on the node and available to the graph.",
        "differentiator": "The handler stops being a script that events happen to call and becomes a node whose contract can be read, disabled, tested with a sample occurrence, and reviewed before it is trusted.",
        "definitionKey": "idea-proposed-approach",
        "_classBinding": {
          "key": "idea-proposed-approach",
          "sourceRef": "github://mikemartinez1974/public/templates/idea-template/classes/nodes/idea-proposed-approach.node-class.node",
          "defaults": {
            "ports": [
              {
                "id": "root",
                "key": "root",
                "label": "root",
                "direction": "bidirectional",
                "dataType": "any",
                "angle": 180
              }
            ],
            "data": {
              "presentation": {
                "glyph": {
                  "kind": "icon",
                  "name": "Route"
                }
              }
            }
          }
        },
        "_bridge": {
          "classKey": "idea-proposed-approach",
          "classRef": "github://mikemartinez1974/public/templates/idea-template/classes/nodes/idea-proposed-approach.node-class.node",
