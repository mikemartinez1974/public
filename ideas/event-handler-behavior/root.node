          }
        }
      ],
      "visible": true,
      "showLabel": false,
      "data": {
        "title": "Keep two authored responsibilities and derive the rest",
        "description": "Event: exactly one source and event key plus an enabled state. Method: exactly one referenced reusable action. Every matching occurrence invokes the Method. The Method owns decisions, executable logic, mutation authority, and declared effects. Twilite supplies delivery ordering, loop protection, time limits, bridge authorization, failure isolation, and live diagnostics.",
        "differentiator": "The handler stops being a script or miniature workflow and becomes a readable Event-to-Method binding that can be disabled, tested with a sample occurrence, and reviewed before it is trusted.",
        "definitionKey": "idea-proposed-approach",
        "_classBinding": {
          "key": "idea-proposed-approach",
          "sourceRef": "github://mikemartinez1974/public/templates/idea-template/classes/nodes/idea-proposed-approach.node-class.node",
