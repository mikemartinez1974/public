        }
      ],
      "visible": true,
      "showLabel": false,
      "data": {
        "title": "The Handler Is a Script With a New Badge",
        "statement": "The event handler in the Edge Class Template stores only script fields: a script name, inline source, and the allowMutations, dryRun, autoRun, autoRunOnLoad, and autoRunOnGraphChange flags. It has no trigger of its own; a separate Subscription node names the source event and points at it. Nothing on the handler says what it listens to, when it should not run, what it may change, or how it reports.",
        "impact": "A reader cannot learn a handler's behavior from the handler. Its trigger lives in another node, three auto-run flags describe a node that only events invoke, and the reaction is opaque source text.",
        "urgency": "high",
        "definitionKey": "idea-problem",
        "_classBinding": {
          "key": "idea-problem",
          "sourceRef": "github://mikemartinez1974/public/templates/idea-template/classes/nodes/idea-problem.node-class.node",
