                "label": "root",
                "direction": "bidirectional",
                "dataType": "any",
                "angle": 180
              }
            ],
            "data": {
              "presentation": {
                "glyph": {
                  "kind": "icon",
                  "name": "Search"
                }
              }
            }
          }
        },
