      ],
      "visible": true,
      "showLabel": false,
      "data": {
        "title": "Use one handler for each trigger",
        "question": "Should one handler subscribe to several sources or event keys, or should each trigger get its own handler that shares a Method?",
        "status": "resolved",
        "answer": "Resolved: one Event Handler owns exactly one source and event key. When several events need the same reaction, several handlers reference the same Method. The Method receives the occurrence and can inspect which source and event invoked it.",
        "definitionKey": "idea-question",
