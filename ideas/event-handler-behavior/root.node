    {
      "id": "event-handler-behavior-research-execution",
      "type": "idea-research",
      "label": "Execution and Reporting Today",
      "root": false,
      "position": {
        "x": -1780,
        "y": 700
      },
      "width": 400,
      "height": 300,
      "ports": [
        {
