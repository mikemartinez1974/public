    {
      "id": "event-handler-behavior-idea-research",
      "type": "idea-research",
      "label": "Dispatcher and Handler Node Today",
      "root": false,
      "position": {
        "x": -1780,
        "y": 260
      },
      "width": 400,
      "height": 300,
      "ports": [
        {
          "id": "root",
          "label": "root",
          "direction": "bidirectional",
          "dataType": "any",
          "angle": 210
        },
        {
          "id": "informs",
          "key": "informs",
          "label": "informs",
          "direction": "bidirectional",
          "dataType": "any",
          "angle": 0,
          "role": "relationship",
          "allowedEdgeTypes": [
            "reference"
          ],
          "metadata": {
            "relationship": true,
            "role": "relationship"
          }
        }
      ],
      "visible": true,
      "showLabel": false,
      "data": {
        "title": "How events reach handlers today",
        "findings": "The event dispatcher queues each occurrence and delivers it to handlers one at a time. A handler matches only when its trigger names exactly one source node and one event key, so a handler has a single trigger and no condition. Handlers of one event run in the order they appear in the graph; nothing controls that order. Each delivery has its own error handling, so one failing handler does not stop the others, and a limit of 32 descendants per root occurrence stops runaway event chains. Declared events check payload type only. Newer event-handler nodes store a trigger and an action.methodNodeId and render an EVENT block, an ACTION block, and a last-run line; the Edge Class Template's handler has neither field.",
        "sourceUrl": "github://TwiliteLLC/twilite/components/GraphEditor/utils/eventDelivery.js",
        "sourceType": "runtime-inspection",
        "definitionKey": "idea-research",
        "_classBinding": {
          "key": "idea-research",
          "sourceRef": "github://mikemartinez1974/public/templates/idea-template/classes/nodes/idea-research.node-class.node",
          "defaults": {
            "ports": [
