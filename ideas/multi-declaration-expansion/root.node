    {
      "id": "multi-declaration-expansion-idea-problem",
      "type": "idea-problem",
      "label": "Single-Graph Assumption",
      "root": false,
      "position": {
        "x": -700,
        "y": -160
      },
      "width": 400,
      "height": 300,
      "ports": [
        {
          "id": "root",
          "key": "root",
          "label": "root",
