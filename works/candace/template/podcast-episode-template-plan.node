      "visible": true,
      "showLabel": true,
      "data": {
        "markdown": "## 🌱 Minimum Valid Episode\n\nA small but useful episode artifact needs:\n\n1. declaration\n2. episode work node\n3. parent podcast reference\n4. title\n5. publication date\n6. summary\n7. at least one experience\n\nMedia, segments, milestones, sources, and additional platforms remain optional.",
        "memo": "",
        "link": "",
        "visibilityRole": "browser",
        "_placement": {
          "version": 1,
          "state": "auto-placed",
          "source": "create",
          "updatedAt": 1784513387877,
          "reason": "node-batch-create"
        }
      }
    },
