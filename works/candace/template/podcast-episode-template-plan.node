      "visible": true,
      "showLabel": true,
      "data": {
        "markdown": "# 🎙️ Podcast Episode Template\n\nA reusable publishing shape for one finite episode belonging to a continuing podcast or video series.\n\nThe template should provide stable structure and sensible placeholders while leaving episode-specific facts empty.\n\n**Core principle:** inherit what is predictable, author what is unique.",
        "memo": "",
        "link": "",
        "visibilityRole": "browser",
        "_placement": {
          "version": 1,
          "state": "auto-placed",
          "source": "create",
          "updatedAt": 1784513387877,
          "reason": "node-batch-create"
        }
      }
    },
