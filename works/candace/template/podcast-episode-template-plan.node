      "visible": true,
      "showLabel": true,
      "data": {
        "markdown": "## Questions for Codex\n\n- Should `podcast-episode` be a specialized Work class or only a profile over Work?\n- Which defaults belong to the generic episode template?\n- Which defaults belong to a series profile such as Episode of Candace?\n- Should segments become a reusable node class?\n- Should transcript be media, resource, document, or its own artifact?\n- How should ordered segments be represented?\n- Should parent-series membership use a semantic `episodeOf` relationship?\n- Can experience placeholders exist without target URLs?\n- What is the smallest template that remains genuinely useful?",
        "memo": "",
        "link": "",
        "visibilityRole": "browser",
        "_placement": {
          "version": 1,
          "state": "auto-placed",
          "source": "create",
          "updatedAt": 1784513387877,
