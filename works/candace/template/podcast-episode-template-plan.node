      "visible": true,
      "showLabel": true,
      "data": {
        "markdown": "## 🗓️ Lifecycle Milestones\n\nDefault milestone:\n\n- published\n\nOptional milestones:\n\n- announced\n- livestream started\n- livestream ended\n- transcript added\n- corrected\n- updated\n- removed\n- restored\n\nMilestones preserve the history of a changing published artifact.",
        "memo": "",
        "link": "",
        "visibilityRole": "browser",
