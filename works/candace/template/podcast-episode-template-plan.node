      "visible": true,
      "showLabel": true,
      "data": {
        "markdown": "## 🪪 Episode Identity\n\nFields supplied for each episode:\n\n- episode title\n- episode number or identifier\n- subtitle\n- publication date\n- runtime\n- publication status\n- season, when applicable\n- canonical URI\n- parent podcast reference\n\nThe episode remains a **work**, specialized as `podcast-episode`.",
        "memo": "",
        "link": "",
        "visibilityRole": "browser",
