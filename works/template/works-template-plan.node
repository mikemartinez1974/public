      "showLabel": true,
      "data": {
        "identity": {
          "graphId": "work-template-design"
        },
        "markdown": "## 5. Story and Evolution\n\nOptional history for works whose development matters:\n\n**Idea → Prototype → First useful version → Major revision → Current state**\n\nThis can include decisions, abandoned paths, lessons, and turning points. It should explain evolution without becoming a changelog swamp.",
        "memo": "",
        "link": "",
        "visibilityRole": "browser",
        "_placement": {
          "version": 1,
          "state": "auto-placed",
          "source": "create",
          "updatedAt": 1784508920038,
          "reason": "node-batch-create"
        }
      }
    },
