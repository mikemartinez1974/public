      "data": {
        "identity": {
          "graphId": "work-template-design"
        },
        "markdown": "# Work Template\n\n## A self-contained exhibit for one authored work\n\nA work should feel like a room in the Public Atelier: immediately legible, visually inviting, and deep enough to reward exploration.\n\n**Core principle:** the graph is the medium; the work is the experience.",
        "memo": "",
        "link": "",
        "visibilityRole": "browser",
        "_placement": {
          "version": 1,
          "state": "auto-placed",
          "source": "create",
          "updatedAt": 1784508920038,
          "reason": "node-batch-create"
        }
      }
    },
