        "html": "<article style=\"width:100%;height:100%;box-sizing:border-box;padding:20px;border-radius:20px;background:linear-gradient(135deg,#ccfbf1,white);border:1px solid #0f766e44;color:#172033;font-family:ui-sans-serif,system-ui,sans-serif;overflow:auto\"><div style=\"font-size:11px;font-weight:800;letter-spacing:.12em;text-transform:uppercase;color:#0f766e\">Segment</div><h2 style=\"margin:8px 0 6px;font-size:26px;line-height:1.15\">{{data.title}}</h2><div style=\"margin:0 0 14px;color:#64748b;font-weight:650\">{{data.subtitle}}</div><div style=\"display:grid;grid-template-columns:118px 1fr;gap:10px;padding:7px 0;border-top:1px solid rgba(100,116,139,.14)\"><strong style=\"font-size:11px;letter-spacing:.06em;text-transform:uppercase;color:#64748b\">Sequence</strong><span style=\"font-size:13px;line-height:1.45;overflow-wrap:anywhere\">{{data.sequence}}</span></div><div style=\"display:grid;grid-template-columns:118px 1fr;gap:10px;padding:7px 0;border-top:1px solid rgba(100,116,139,.14)\"><strong style=\"font-size:11px;letter-spacing:.06em;text-transform:uppercase;color:#64748b\">Start</strong><span style=\"font-size:13px;line-height:1.45;overflow-wrap:anywhere\">{{data.startOffset}}</span></div><div style=\"display:grid;grid-template-columns:118px 1fr;gap:10px;padding:7px 0;border-top:1px solid rgba(100,116,139,.14)\"><strong style=\"font-size:11px;letter-spacing:.06em;text-transform:uppercase;color:#64748b\">End</strong><span style=\"font-size:13px;line-height:1.45;overflow-wrap:anywhere\">{{data.endOffset}}</span></div><div style=\"display:grid;grid-template-columns:118px 1fr;gap:10px;padding:7px 0;border-top:1px solid rgba(100,116,139,.14)\"><strong style=\"font-size:11px;letter-spacing:.06em;text-transform:uppercase;color:#64748b\">Topics</strong><span style=\"font-size:13px;line-height:1.45;overflow-wrap:anywhere\">{{data.topics}}</span></div><div style=\"display:grid;grid-template-columns:118px 1fr;gap:10px;padding:7px 0;border-top:1px solid rgba(100,116,139,.14)\"><strong style=\"font-size:11px;letter-spacing:.06em;text-transform:uppercase;color:#64748b\">People</strong><span style=\"font-size:13px;line-height:1.45;overflow-wrap:anywhere\">{{data.peopleRefs}}</span></div><div style=\"display:grid;grid-template-columns:118px 1fr;gap:10px;padding:7px 0;border-top:1px solid rgba(100,116,139,.14)\"><strong style=\"font-size:11px;letter-spacing:.06em;text-transform:uppercase;color:#64748b\">Organizations</strong><span style=\"font-size:13px;line-height:1.45;overflow-wrap:anywhere\">{{data.organizationRefs}}</span></div><div style=\"display:grid;grid-template-columns:118px 1fr;gap:10px;padding:7px 0;border-top:1px solid rgba(100,116,139,.14)\"><strong style=\"font-size:11px;letter-spacing:.06em;text-transform:uppercase;color:#64748b\">Events</strong><span style=\"font-size:13px;line-height:1.45;overflow-wrap:anywhere\">{{data.eventRefs}}</span></div><div style=\"display:grid;grid-template-columns:118px 1fr;gap:10px;padding:7px 0;border-top:1px solid rgba(100,116,139,.14)\"><strong style=\"font-size:11px;letter-spacing:.06em;text-transform:uppercase;color:#64748b\">Claims</strong><span style=\"font-size:13px;line-height:1.45;overflow-wrap:anywhere\">{{data.claimRefs}}</span></div><div style=\"display:grid;grid-template-columns:118px 1fr;gap:10px;padding:7px 0;border-top:1px solid rgba(100,116,139,.14)\"><strong style=\"font-size:11px;letter-spacing:.06em;text-transform:uppercase;color:#64748b\">Resources</strong><span style=\"font-size:13px;line-height:1.45;overflow-wrap:anywhere\">{{data.resourceRefs}}</span></div><div style=\"margin:12px 0;white-space:pre-wrap;line-height:1.6;color:#334155\">{{data.summary}}</div></article>"
