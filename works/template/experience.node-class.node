          ]
        },
        "renderShape": {
          "kind": "html"
        },
        "html": "<article style=\"width:100%;height:100%;box-sizing:border-box;padding:20px;border-radius:20px;background:linear-gradient(135deg,#e0f2fe,white);border:1px solid #0284c744;color:#172033;font-family:ui-sans-serif,system-ui,sans-serif;overflow:auto\"><div style=\"font-size:11px;font-weight:800;letter-spacing:.12em;text-transform:uppercase;color:#0284c7\">Experience</div><h2 style=\"margin:8px 0 14px;font-size:26px;line-height:1.15\">{{data.title}}</h2><div style=\"display:grid;grid-template-columns:110px 1fr;gap:10px;padding:7px 0;border-top:1px solid rgba(100,116,139,.14)\"><strong style=\"font-size:11px;letter-spacing:.06em;text-transform:uppercase;color:#64748b\">Kind</strong><span style=\"font-size:13px;line-height:1.45;overflow-wrap:anywhere\">{{data.experienceKind}}</span></div><div style=\"display:grid;grid-template-columns:110px 1fr;gap:10px;padding:7px 0;border-top:1px solid rgba(100,116,139,.14)\"><strong style=\"font-size:11px;letter-spacing:.06em;text-transform:uppercase;color:#64748b\">Target</strong><span style=\"font-size:13px;line-height:1.45;overflow-wrap:anywhere\"><a href=\"{{data.targetRef}}\" target=\"_blank\" rel=\"noopener noreferrer\" style=\"color:#2563eb;font-weight:700;text-decoration:underline;overflow-wrap:anywhere\">{{data.targetRef}}</a></span></div><div style=\"display:grid;grid-template-columns:110px 1fr;gap:10px;padding:7px 0;border-top:1px solid rgba(100,116,139,.14)\"><strong style=\"font-size:11px;letter-spacing:.06em;text-transform:uppercase;color:#64748b\">Availability</strong><span style=\"font-size:13px;line-height:1.45;overflow-wrap:anywhere\">{{data.availability}}</span></div><div style=\"display:grid;grid-template-columns:110px 1fr;gap:10px;padding:7px 0;border-top:1px solid rgba(100,116,139,.14)\"><strong style=\"font-size:11px;letter-spacing:.06em;text-transform:uppercase;color:#64748b\">Primary</strong><span style=\"font-size:13px;line-height:1.45;overflow-wrap:anywhere\">{{data.isPrimary}}</span></div><div style=\"margin:12px 0;white-space:pre-wrap;line-height:1.6;color:#334155\">{{data.instructions}}</div><span style=\"display:inline-flex;padding:5px 9px;border-radius:999px;background:rgba(100,116,139,.12);font-size:11px;font-weight:800;text-transform:uppercase\">{{data.status}}</span></article>"
      }
