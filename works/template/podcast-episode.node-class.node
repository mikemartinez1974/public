          "kind": "html"
        },
        "html": "<article style=\"width:100%;height:100%;box-sizing:border-box;padding:20px;border-radius:20px;background:linear-gradient(135deg,#ede9fe,white);border:1px solid #7c3aed44;color:#172033;font-family:ui-sans-serif,system-ui,sans-serif;overflow:auto\"><div style=\"font-size:11px;font-weight:800;letter-spacing:.12em;text-transform:uppercase;color:#7c3aed\">Podcast Episode</div><h2 style=\"margin:8px 0 6px;font-size:26px;line-height:1.15\">{{data.title}}</h2><div style=\"margin:0 0 14px;color:#64748b;font-weight:650\">{{data.subtitle}}</div><img src=\"{{data.artworkUri}}\" alt=\"\" style=\"display:block;width:100%;max-height:220px;object-fit:cover;border-radius:14px;margin:0 0 14px\"/><div style=\"display:grid;grid-template-columns:118px 1fr;gap:10px;padding:7px 0;border-top:1px solid rgba(100,116,139,.14)\"><strong style=\"font-size:11px;letter-spacing:.06em;text-transform:uppercase;color:#64748b\">Episode</strong><span style=\"font-size:13px;line-height:1.45;overflow-wrap:anywhere\">{{data.episodeNumber}}</span></div><div style=\"display:grid;grid-template-columns:118px 1fr;gap:10px;padding:7px 0;border-top:1px solid rgba(100,116,139,.14)\"><strong style=\"font-size:11px;letter-spacing:.06em;text-transform:uppercase;color:#64748b\">Season</strong><span style=\"font-size:13px;line-height:1.45;overflow-wrap:anywhere\">{{data.season}}</span></div><div style=\"display:grid;grid-template-columns:118px 1fr;gap:10px;padding:7px 0;border-top:1px solid rgba(100,116,139,.14)\"><strong style=\"font-size:11px;letter-spacing:.06em;text-transform:uppercase;color:#64748b\">Published</strong><span style=\"font-size:13px;line-height:1.45;overflow-wrap:anywhere\">{{data.publishedDate}}</span></div><div style=\"display:grid;grid-template-columns:118px 1fr;gap:10px;padding:7px 0;border-top:1px solid rgba(100,116,139,.14)\"><strong style=\"font-size:11px;letter-spacing:.06em;text-transform:uppercase;color:#64748b\">Runtime</strong><span style=\"font-size:13px;line-height:1.45;overflow-wrap:anywhere\">{{data.runtime}}</span></div><div style=\"display:grid;grid-template-columns:118px 1fr;gap:10px;padding:7px 0;border-top:1px solid rgba(100,116,139,.14)\"><strong style=\"font-size:11px;letter-spacing:.06em;text-transform:uppercase;color:#64748b\">Status</strong><span style=\"font-size:13px;line-height:1.45;overflow-wrap:anywhere\">{{data.publicationStatus}}</span></div><div style=\"display:grid;grid-template-columns:118px 1fr;gap:10px;padding:7px 0;border-top:1px solid rgba(100,116,139,.14)\"><strong style=\"font-size:11px;letter-spacing:.06em;text-transform:uppercase;color:#64748b\">Canonical</strong><span style=\"font-size:13px;line-height:1.45;overflow-wrap:anywhere\"><a href=\"{{data.canonicalUri}}\" target=\"_blank\" rel=\"noopener noreferrer\" style=\"color:#2563eb;font-weight:700;text-decoration:underline;overflow-wrap:anywhere\">{{data.canonicalUri}}</a></span></div><div style=\"display:grid;grid-template-columns:118px 1fr;gap:10px;padding:7px 0;border-top:1px solid rgba(100,116,139,.14)\"><strong style=\"font-size:11px;letter-spacing:.06em;text-transform:uppercase;color:#64748b\">Parent show</strong><span style=\"font-size:13px;line-height:1.45;overflow-wrap:anywhere\"><a href=\"{{data.parentWorkRef}}\" target=\"_blank\" rel=\"noopener noreferrer\" style=\"color:#2563eb;font-weight:700;text-decoration:underline;overflow-wrap:anywhere\">{{data.parentWorkRef}}</a></span></div><div style=\"display:grid;grid-template-columns:118px 1fr;gap:10px;padding:7px 0;border-top:1px solid rgba(100,116,139,.14)\"><strong style=\"font-size:11px;letter-spacing:.06em;text-transform:uppercase;color:#64748b\">Topics</strong><span style=\"font-size:13px;line-height:1.45;overflow-wrap:anywhere\">{{data.topics}}</span></div><div style=\"display:grid;grid-template-columns:118px 1fr;gap:10px;padding:7px 0;border-top:1px solid rgba(100,116,139,.14)\"><strong style=\"font-size:11px;letter-spacing:.06em;text-transform:uppercase;color:#64748b\">People</strong><span style=\"font-size:13px;line-height:1.45;overflow-wrap:anywhere\">{{data.peopleRefs}}</span></div><div style=\"display:grid;grid-template-columns:118px 1fr;gap:10px;padding:7px 0;border-top:1px solid rgba(100,116,139,.14)\"><strong style=\"font-size:11px;letter-spacing:.06em;text-transform:uppercase;color:#64748b\">Organizations</strong><span style=\"font-size:13px;line-height:1.45;overflow-wrap:anywhere\">{{data.organizationRefs}}</span></div><div style=\"display:grid;grid-template-columns:118px 1fr;gap:10px;padding:7px 0;border-top:1px solid rgba(100,116,139,.14)\"><strong style=\"font-size:11px;letter-spacing:.06em;text-transform:uppercase;color:#64748b\">Events</strong><span style=\"font-size:13px;line-height:1.45;overflow-wrap:anywhere\">{{data.eventRefs}}</span></div><div style=\"display:grid;grid-template-columns:118px 1fr;gap:10px;padding:7px 0;border-top:1px solid rgba(100,116,139,.14)\"><strong style=\"font-size:11px;letter-spacing:.06em;text-transform:uppercase;color:#64748b\">Warnings</strong><span style=\"font-size:13px;line-height:1.45;overflow-wrap:anywhere\">{{data.contentWarnings}}</span></div><div style=\"display:grid;grid-template-columns:118px 1fr;gap:10px;padding:7px 0;border-top:1px solid rgba(100,116,139,.14)\"><strong style=\"font-size:11px;letter-spacing:.06em;text-transform:uppercase;color:#64748b\">Language</strong><span style=\"font-size:13px;line-height:1.45;overflow-wrap:anywhere\">{{data.language}}</span></div><div style=\"display:grid;grid-template-columns:118px 1fr;gap:10px;padding:7px 0;border-top:1px solid rgba(100,116,139,.14)\"><strong style=\"font-size:11px;letter-spacing:.06em;text-transform:uppercase;color:#64748b\">Audience</strong><span style=\"font-size:13px;line-height:1.45;overflow-wrap:anywhere\">{{data.audiences}}</span></div><div style=\"margin:12px 0;white-space:pre-wrap;line-height:1.6;color:#334155\">{{data.summary}}</div><div style=\"margin:12px 0;white-space:pre-wrap;line-height:1.6;color:#334155\">{{data.description}}</div></article>"
      }
    },
