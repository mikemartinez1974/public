        "view": {
          "intent": "node",
          "payload": "node.web.detail",
          "controls": [
            {
              "id": "work-open-canonical",
              "type": "button",
              "label": "Open work website",
              "icon": "openInNew",
              "variant": "outlined",
              "priority": "high",
              "action": "navigate",
              "hrefPath": "data.canonicalUri"
            }
          ]
        },
        "renderShape": {
          "kind": "html"
        },
        "html": "<article style=\"width:100%;height:100%;box-sizing:border-box;padding:20px;border-radius:20px;background:linear-gradient(135deg,#ede9fe,white);border:1px solid #7c3aed44;color:#172033;font-family:ui-sans-serif,system-ui,sans-serif;overflow:auto\"><div style=\"font-size:11px;font-weight:800;letter-spacing:.12em;text-transform:uppercase;color:#7c3aed\">Work</div><h2 style=\"margin:8px 0 14px;font-size:26px;line-height:1.15\">{{data.title}}</h2><img src=\"{{data.coverImage}}\" alt=\"Cover for {{data.title}}\" style=\"display:block;width:100%;max-height:220px;object-fit:cover;border-radius:14px;margin:0 0 14px\"/><div style=\"display:grid;grid-template-columns:110px 1fr;gap:10px;padding:7px 0;border-top:1px solid rgba(100,116,139,.14)\"><strong style=\"font-size:11px;letter-spacing:.06em;text-transform:uppercase;color:#64748b\">Type</strong><span style=\"font-size:13px;line-height:1.45;overflow-wrap:anywhere\">{{data.workType}}</span></div><div style=\"display:grid;grid-template-columns:110px 1fr;gap:10px;padding:7px 0;border-top:1px solid rgba(100,116,139,.14)\"><strong style=\"font-size:11px;letter-spacing:.06em;text-transform:uppercase;color:#64748b\">Tagline</strong><span style=\"font-size:13px;line-height:1.45;overflow-wrap:anywhere\">{{data.tagline}}</span></div><div style=\"display:grid;grid-template-columns:110px 1fr;gap:10px;padding:7px 0;border-top:1px solid rgba(100,116,139,.14)\"><strong style=\"font-size:11px;letter-spacing:.06em;text-transform:uppercase;color:#64748b\">Creators</strong><span style=\"font-size:13px;line-height:1.45;overflow-wrap:anywhere\">{{data.creatorRefs}}</span></div><div style=\"display:grid;grid-template-columns:110px 1fr;gap:10px;padding:7px 0;border-top:1px solid rgba(100,116,139,.14)\"><strong style=\"font-size:11px;letter-spacing:.06em;text-transform:uppercase;color:#64748b\">Audience</strong><span style=\"font-size:13px;line-height:1.45;overflow-wrap:anywhere\">{{data.audiences}}</span></div><div style=\"display:grid;grid-template-columns:110px 1fr;gap:10px;padding:7px 0;border-top:1px solid rgba(100,116,139,.14)\"><strong style=\"font-size:11px;letter-spacing:.06em;text-transform:uppercase;color:#64748b\">Published</strong><span style=\"font-size:13px;line-height:1.45;overflow-wrap:anywhere\">{{data.publishedDate}}</span></div><div style=\"display:grid;grid-template-columns:110px 1fr;gap:10px;padding:7px 0;border-top:1px solid rgba(100,116,139,.14)\"><strong style=\"font-size:11px;letter-spacing:.06em;text-transform:uppercase;color:#64748b\">Website</strong><span style=\"font-size:13px;line-height:1.45;overflow-wrap:anywhere\"><a href=\"{{data.canonicalUri}}\" target=\"_blank\" rel=\"noopener noreferrer\" style=\"color:#2563eb;font-weight:700;text-decoration:underline;overflow-wrap:anywhere\">{{data.canonicalUri}}</a></span></div><div style=\"display:grid;grid-template-columns:110px 1fr;gap:10px;padding:7px 0;border-top:1px solid rgba(100,116,139,.14)\"><strong style=\"font-size:11px;letter-spacing:.06em;text-transform:uppercase;color:#64748b\">License</strong><span style=\"font-size:13px;line-height:1.45;overflow-wrap:anywhere\">{{data.license}}</span></div><div style=\"display:grid;grid-template-columns:110px 1fr;gap:10px;padding:7px 0;border-top:1px solid rgba(100,116,139,.14)\"><strong style=\"font-size:11px;letter-spacing:.06em;text-transform:uppercase;color:#64748b\">Platforms</strong><span style=\"font-size:13px;line-height:1.45;overflow-wrap:anywhere\">{{data.platforms}}</span></div><div style=\"display:grid;grid-template-columns:110px 1fr;gap:10px;padding:7px 0;border-top:1px solid rgba(100,116,139,.14)\"><strong style=\"font-size:11px;letter-spacing:.06em;text-transform:uppercase;color:#64748b\">Technologies</strong><span style=\"font-size:13px;line-height:1.45;overflow-wrap:anywhere\">{{data.technologies}}</span></div><div style=\"display:grid;grid-template-columns:110px 1fr;gap:10px;padding:7px 0;border-top:1px solid rgba(100,116,139,.14)\"><strong style=\"font-size:11px;letter-spacing:.06em;text-transform:uppercase;color:#64748b\">Created</strong><span style=\"font-size:13px;line-height:1.45;overflow-wrap:anywhere\">{{data.createdDate}}</span></div><div style=\"display:grid;grid-template-columns:110px 1fr;gap:10px;padding:7px 0;border-top:1px solid rgba(100,116,139,.14)\"><strong style=\"font-size:11px;letter-spacing:.06em;text-transform:uppercase;color:#64748b\">Updated</strong><span style=\"font-size:13px;line-height:1.45;overflow-wrap:anywhere\">{{data.updatedDate}}</span></div><div style=\"display:grid;grid-template-columns:110px 1fr;gap:10px;padding:7px 0;border-top:1px solid rgba(100,116,139,.14)\"><strong style=\"font-size:11px;letter-spacing:.06em;text-transform:uppercase;color:#64748b\">Maturity</strong><span style=\"font-size:13px;line-height:1.45;overflow-wrap:anywhere\">{{data.maturity}}</span></div><div style=\"margin:12px 0;white-space:pre-wrap;line-height:1.6;color:#334155\">{{data.summary}}</div><div style=\"margin:12px 0;white-space:pre-wrap;line-height:1.6;color:#334155\"><strong>Context</strong><br/>{{data.context}}</div><div style=\"margin:12px 0;white-space:pre-wrap;line-height:1.6;color:#334155\"><strong>Known limitations</strong><br/>{{data.limitations}}</div><span style=\"display:inline-flex;padding:5px 9px;border-radius:999px;background:rgba(100,116,139,.12);font-size:11px;font-weight:800;text-transform:uppercase\">{{data.status}}</span></article>"
      }
    },
