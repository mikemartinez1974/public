      ],
      "visible": true,
      "showLabel": false,
      "data": {
        "title": "They have outgrown chat as a workspace",
        "answer": "Their AI work gets trapped in scrolling conversations, copied snippets, disconnected documents, and repeated context. They want model output to become persistent, navigable, editable, and operable instead of another blob of text that disappears upward.",
        "confidence": "high",
        "summary": "The pain is not lack of AI. It is the lack of a durable place for AI-created work.",
        "notes": "",
        "identity": {
          "graphId": "twilite-target-audience-qa"
