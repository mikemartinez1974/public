        },
        "html": "<article style='height:100%;box-sizing:border-box;padding:30px;border-radius:28px;background:linear-gradient(135deg,#07111f,#0f4c5c 55%,#4338ca);color:white;font-family:system-ui'><small style='letter-spacing:.18em;color:#cffafe'>TWILITE · TARGET AUDIENCE</small><h1 style='font:850 38px Georgia;margin:18px 0 10px'>Who Is Twilite For?</h1><p style='font-size:17px;color:#dbeafe;max-width:620px'>For AI power users who want conversations with models to become persistent, interactive, visual workspaces.</p><div style='font-size:24px;margin-top:32px;color:#a5f3fc'>chat → structure → workspace → collaboration</div></article>",
