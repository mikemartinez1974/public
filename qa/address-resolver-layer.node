      "visible": true,
      "showLabel": true,
      "data": {
        "title": "Aliases only work inside Twilite",
        "caveat": "A `gh://` or `web://` link means nothing to a browser, an email client or another tool. Browsers let a site register a custom scheme only with a `web+` prefix, and support varies. So an alias is safe as something a person types and unsafe as something Twilite publishes or copies out.",
        "severity": "important",
        "mitigation": "The resolver should also go the other way: give any address its canonical form and, where one exists, a plain `https://` form for sharing. Export, copy-link and published HTML use those and never an alias.",
        "notes": "",
        "identity": {
          "graphId": "0953fa34-568e-4500-88ed-dc18c9dede85"
        },
        "definitionKey": "qa-caveat",
