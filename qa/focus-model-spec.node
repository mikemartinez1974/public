          "ref": "github://mikemartinez1974/public/templates/question-driven-explanation-template/classes/nodes/qa-caveat.node-class.node"
        },
        "title": "Do Not Turn Focus into Every Kind of Emphasis",
        "caveat": "If selection, hover, search results, pinning, open editors, notifications, and temporary highlights all become focus, focus stops describing a region and becomes a generic importance flag. That makes branch behavior and presentation resolution ambiguous.",
        "severity": "important",
        "mitigation": "Keep focus singular and spatial. Model selection, pinning, hover, search, and other presentation overrides as independent state that can be combined later by the presentation resolver.",
        "notes": "A future multi-pane UI could legitimately give each viewport its own single focus region without changing the invariant within a viewport.",
        "memo": "",
        "link": "",
        "visibilityRole": "browser",
        "_placement": {
          "version": 1,
          "state": "auto-placed",
          "source": "create",
