        "title": "Single-Region Focus",
        "description": "Focus is an authoritative statement about which region of the current graph the user is actively working inside. It is distinct from zoom, selection, hover, pinning, and transient emphasis.",
        "scope": "Twilite graph navigation, branching, semantic zoom, and presentation resolution",
        "notes": "Proposed invariant: a viewport has zero or one authoritative focus region.",
        "memo": "",
        "link": "",
        "visibilityRole": "browser",
        "_placement": {
          "version": 1,
          "state": "auto-placed",
          "source": "create",
          "updatedAt": 1786462966587,
          "reason": "node-batch-create"
        }
      }
