          "ref": "github://mikemartinez1974/public/templates/question-driven-explanation-template/classes/nodes/qa-answer.node-class.node"
        },
        "title": "Focus Defines the Active Working Region",
        "answer": "Focus says which part of the graph currently has the user's attention as a working context. It is not merely the selected node. A focused node may establish a focused branch or neighborhood around itself. That region can receive richer presentation than unrelated parts of the graph because the user has explicitly moved their attention there.",
        "confidence": "high",
        "summary": "Focus means: this is the part of the graph I am currently inside.",
        "notes": "The focused node and focused region may initially be the same thing, but the contract should leave room for branch membership.",
        "memo": "",
        "link": "",
        "visibilityRole": "browser",
        "_placement": {
          "version": 1,
          "state": "auto-placed",
          "source": "create",
          "updatedAt": 1786462966587,
          "reason": "node-batch-create"
        }
      }
    },
