        "title": "How Should Focus Work in Twilite?",
        "purpose": "Describe the proposed focus contract that lets one region of a graph become the user's active working context without confusing focus with zoom, selection, or decoration.",
        "key": "node.web.summary",
        "intent": "node",
        "payload": "node.web.summary",
        "view": {
          "intent": "node",
          "payload": "node.web.summary",
          "label": "Twilite Focus Model"
        },
        "target": {
          "graphId": "qa-focus-model",
          "mode": "navigate"
        },
        "html": "<article style='height:100%;box-sizing:border-box;padding:28px;border-radius:26px;background:linear-gradient(135deg,#07111f,#312e81,#581c87);color:white;font-family:system-ui'><small style='letter-spacing:.18em;color:#ddd6fe'>QUESTION-DRIVEN EXPLANATION</small><h1 style='font:800 32px Georgia;margin:18px 0 10px'>Focus Is Where You Are Working</h1><p style='font-size:16px;color:#e9d5ff'>A viewport has at most one authoritative focus region. Zoom describes distance. Focus describes attention.</p><div style='font-size:32px;margin-top:34px'>graph → branch → focused region → presentation</div></article>",
        "memo": "",
        "link": "",
        "visibilityRole": "browser",
        "_placement": {
