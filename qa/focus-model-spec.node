        "_classBinding": {
          "key": "qa-example",
          "sourceRef": "github://mikemartinez1974/public/templates/question-driven-explanation-template/classes/nodes/qa-example.node-class.node",
          "ref": "github://mikemartinez1974/public/templates/question-driven-explanation-template/classes/nodes/qa-example.node-class.node"
        },
        "title": "Drilling into a Branch",
        "example": "The viewport is zoomed far enough out that the normal band is glyph. The user expands node C. C becomes the focused anchor and its newly exposed children become the focused region. Nodes A, B, D, and E remain glyphs. C may render as summary, while C.1, C.2, and C.3 render as icons. Expanding C.2 can move focus deeper so C.2 becomes the anchor and its children become the new active region. The old region remains graph context, not a second active focus region.",
        "relevance": "This demonstrates why focus must be separate from zoom. The user's working branch needs readable content even when the surrounding graph is intentionally compressed.",
        "notes": "The exact promotion levels are policy, not part of the focus primitive itself.",
        "memo": "",
        "link": "",
        "visibilityRole": "browser",
        "_placement": {
          "version": 1,
          "state": "auto-placed",
          "source": "create",
