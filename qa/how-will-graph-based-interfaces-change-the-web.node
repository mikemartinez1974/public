"showLabel":true,"data":{"authority":"bridge","target":{"mode":"bridge","ref":"/templates/question-driven-explanation-template/classes/nodes/qa-source.node-class.node","kind":"node-class","scope":"focused-graph","grants":["create"],"key":"qa-source"},"_classBinding":{"key":"qa-source","sourceRef":"/templates/question-driven-explanation-template/classes/nodes/qa-source.node-class.node"},"_bridge":{"classKey":"qa-source","classRef":"/templates/question-driven-explanation-template/classes/nodes/qa-source.node-class.node"},"identity":{"graphId":"qa-gbi-web"}}},{"id":"b-qa-example","type":"bridge","label":"qa-example","position":{"x":-400,"y":-1120},"width":180,"height":90,"ports":[{"id":"root","label":"root","direction":"bidirectional","dataType":"any","angle":210}],"visible":false,"showLabel":true,"data":{"authority":"bridge","target":{"mode":"bridge","ref":"/templates/question-driven-explanation-template/classes/nodes/qa-example.node-class.node","kind":"node-class","scope":"focused-graph","grants":["create"],"key":"qa-example"},"_classBinding":{"key":"qa-example","sourceRef":"/templates/question-driven-explanation-template/classes/nodes/qa-example.node-class.node"},"_bridge":{"classKey":"qa-example","classRef":"/templates/question-driven-explanation-template/classes/nodes/qa-example.node-class.node"},"identity":{"graphId":"qa-gbi-web"}}},{"id":"b-qa-caveat","type":"bridge","label":"qa-caveat","position":{"x":-200,"y":-1120},"width":180,"height":90,"ports":[{"id":"root","label":"root","direction":"bidirectional","dataType":"any","angle":210}],"visible":false,"showLabel":true,"data":{"authority":"bridge","target":{"mode":"bridge","ref":"/templates/question-driven-explanation-template/classes/nodes/qa-caveat.node-class.node","kind":"node-class","scope":"focused-graph","grants":["create"],"key":"qa-caveat"},"_classBinding":{"key":"qa-caveat","sourceRef":"/templates/question-driven-explanation-template/classes/nodes/qa-caveat.node-class.node"},"_bridge":{"classKey":"qa-caveat","classRef":"/templates/question-driven-explanation-template/classes/nodes/qa-caveat.node-class.node"},"identity":{"graphId":"qa-gbi-web"}}},{"id":"b-qa-summary","type":"bridge","label":"qa-summary","position":{"x":0,"y":-1120},"width":180,"height":90,"ports":[{"id":"root","label":"root","direction":"bidirectional","dataType":"any","angle":210}],"visible":false,"showLabel":true,"data":{"authority":"bridge","target":{"mode":"bridge","ref":"/templates/question-driven-explanation-template/classes/nodes/qa-summary.node-class.node","kind":"node-class","scope":"focused-graph","grants":["create"],"key":"qa-summary"},"_classBinding":{"key":"qa-summary","sourceRef":"/templates/question-driven-explanation-template/classes/nodes/qa-summary.node-class.node"},"_bridge":{"classKey":"qa-summary","classRef":"/templates/question-driven-explanation-template/classes/nodes/qa-summary.node-class.node"},"identity":{"graphId":"qa-gbi-web"}}},{"id":"topic","type":"qa-topic","label":"Graph-Based Interfaces","position":{"x":-140,"y":-380},"width":500,"height":320,"ports":[{"id":"root","label":"root","direction":"bidirectional","dataType":"any","angle":210},{"id":"top","label":"top","direction":"bidirectional","dataType":"value","angle":270},{"id":"bottom","label":"bottom","direction":"bidirectional","dataType":"value","angle":90}],"visible":true,"showLabel":false,"data":{"title":"Graph-Based Interfaces","description":"Interfaces that expose information, actions, tools, and artifacts as addressable nodes connected by meaningful relationships.","scope":"Browsing, authoring, collaboration, publishing, and agent interaction on the web.","notes":"Pages remain useful, but become views over a deeper structure.","definitionKey":"qa-topic","_classBinding":{"key":"qa-topic","sourceRef":"/templates/question-driven-explanation-template/classes/nodes/qa-topic.node-class.node"},"_bridge":{"classKey":"qa-topic","classRef":"/templates/question-driven-explanation-template/classes/nodes/qa-topic.node-class.node"},"identity":{"graphId":"qa-gbi-web"}}},{"id":"q","type":"qa-question","label":"How will graph-based interfaces change the web?","position":{"x":-700,"y":80},"width":460,"height":320,"ports":[{"id":"root","label":"root","direction":"bidirectional","dataType":"any","angle":210},{"id":"top","label":"top","direction":"bidirectional","dataType":"value","angle":270},{"id":"bottom","label":"bottom","direction":"bidirectional","dataType":"value","angle":90}],"visible":true,"showLabel":false,"data":{"question":"How will graph-based interfaces change the web?","lens":"how","purpose":"Explain the shift from pages and menus to composable graph structures.","status":"answered","order":1,"notes":"The central question.","definitionKey":"qa-question","_classBinding":{"key":"qa-question","sourceRef":"/templates/question-driven-explanation-template/classes/nodes/qa-question.node-class.node"},"_bridge":{"classKey":"qa-question","classRef":"/templates/question-driven-explanation-template/classes/nodes/qa-question.node-class.node"},"identity":{"graphId":"qa-gbi-web"}}},{"id":"a","type":"qa-answer","label":"The Web Becomes a Composable Model","position":{"x":-140,"y":80},"width":540,"height":410,"ports":[{"id":"root","label":"root","direction":"bidirectional","dataType":"any","angle":210},{"id":"top","label":"top","direction":"bidirectional","dataType":"value","angle":270},{"id":"bottom","label":"bottom","direction":"bidirectional","dataType":"value","angle":90}],"visible":true,"showLabel":false,"data":{"title":"The Web Becomes a Composable Model","answer":"Graph-based interfaces move structure from the hidden machinery of applications into the user’s operating surface. Pages become views over addressable objects rather than sealed destinations. Links become typed relationships that explain why things are connected. Navigation becomes traversal with visible context. Authoring expands from filling forms to composing nodes, tools, evidence, conversations, and workflows. Collaboration becomes additive change to shared structures. AI agents gain a legible workspace with explicit identities, permissions, and valid operations. Publishers can distribute reusable capabilities and views instead of only pages.\n\nThe deepest change is that the web begins to present information and software as pieces that can be inspected, connected, and reused.","confidence":"high","summary":"Pages become views, links become meaningful paths, users compose systems, and agents operate through explicit graph contracts.","notes":"A directional design argument, not a fixed adoption forecast.","definitionKey":"qa-answer","_classBinding":{"key":"qa-answer","sourceRef":"/templates/question-driven-explanation-template/classes/nodes/qa-answer.node-class.node"},"_bridge":{"classKey":"qa-answer","classRef":"/templates/question-driven-explanation-template/classes/nodes/qa-answer.node-class.node"},"identity":{"graphId":"qa-gbi-web"}}},{"id":"src","type":"qa-source","label":"Twilite Working Prototype","position":{"x":480,"y":80},"width":440,"height":340,"ports":[{"id":"root","label":"root","direction":"bidirectional","dataType":"any","angle":210},{"id":"top","label":"top","direction":"bidirectional","dataType":"value","angle":270},{"id":"bottom","label":"bottom","direction":"bidirectional","dataType":"value","angle":90}],"visible":true,"showLabel":false,"data":{"title":"Twilite Working Prototype","citation":"Twilite demonstrates graph navigation, semantic edges, reusable node classes, ports, portals, and agent-authored additive transactions in a working browser interface.","url":"https://twilite.zone","sourceType":"primary","reliability":"high","notes":"Evidence that the model is buildable, not proof of every predicted consequence.","definitionKey":"qa-source","_classBinding":{"key":"qa-source","sourceRef":"/templates/question-driven-explanation-template/classes/nodes/qa-source.node-class.node"},"_bridge":{"classKey":"qa-source","classRef":"/templates/question-driven-explanation-template/classes/nodes/qa-source.node-class.node"},"identity":{"graphId":"qa-gbi-web"}}},{"id":"ex","type":"qa-example","label":"Software Becomes a Visible Work Surface","position":{"x":-700,"y":650},"width":460,"height":340,"ports":[{"id":"root","label":"root","direction":"bidirectional","dataType":"any","angle":210},{"id":"top","label":"top","direction":"bidirectional","dataType":"value","angle":270},{"id":"bottom","label":"bottom","direction":"bidirectional","dataType":"value","angle":90}],"visible":true,"showLabel":false,"data":{"title":"Software Becomes a Visible Work Surface","example":"A project graph can connect requirements, code, issues, conversations, tasks, releases, and live tools. Humans and agents work on the same explicit model instead of translating between disconnected dashboards.","relevance":"Shows how graph structure can bridge content, provenance, and action.","notes":"One concrete illustration of a graph-native web.","definitionKey":"qa-example","_classBinding":{"key":"qa-example","sourceRef":"/templates/question-driven-explanation-template/classes/nodes/qa-example.node-class.node"},"_bridge":{"classKey":"qa-example","classRef":"/templates/question-driven-explanation-template/classes/nodes/qa-example.node-class.node"},"identity":{"graphId":"qa-gbi-web"}}},{"id":"c","type":"qa-caveat","label":"Complexity Must Be Curated","position":{"x":-140,"y":650},"width":480,"height":360,"ports":[{"id":"root","label":"root","direction":"bidirectional","dataType":"any","angle":210},{"id":"top","label":"top","direction":"bidirectional","dataType":"value","angle":270},{"id":"bottom","label":"bottom","direction":"bidirectional","dataType":"value","angle":90}],"visible":true,"showLabel":false,"data":{"title":"Complexity Must Be Curated","caveat":"A raw graph is not automatically a good interface. Dense networks can be harder to understand than a well-designed page, and incompatible node contracts can recreate application silos.","severity":"critical","mitigation":"Use focused neighborhoods, progressive disclosure, excellent reading surfaces, typed relationships, portable schemas, and explicit authority.","notes":"The graph is the model; users should not be forced to stare at all of it.","definitionKey":"qa-caveat","_classBinding":{"key":"qa-caveat","sourceRef":"/templates/question-driven-explanation-template/classes/nodes/qa-caveat.node-class.node"},"_bridge":{"classKey":"qa-caveat","classRef":"/templates/question-driven-explanation-template/classes/nodes/qa-caveat.node-class.node"},"identity":{"graphId":"qa-gbi-web"}}},{"id":"sum","type":"qa-summary","label":"The Web After Pages","position":{"x":420,"y":650},"width":500,"height":390,"ports":[{"id":"root","label":"root","direction":"bidirectional","dataType":"any","angle":210},{"id":"top","label":"top","direction":"bidirectional","dataType":"value","angle":270},{"id":"bottom","label":"bottom","direction":"bidirectional","dataType":"value","angle":90}],"visible":true,"showLabel":false,"data":{"title":"The Web After Pages","synthesis":"Graph-based interfaces will not erase the page. They will make the page one presentation of a richer, reusable model. The web becomes more navigable, composable, agent-readable, and capable of carrying provenance and authority across tools.","keyPoints":"• Pages become views over durable objects.\n• Links gain roles and context.\n• Creation becomes structural composition.\n• Agents receive inspectable operating surfaces.\n• Publishing can expose reusable capabilities.\n• Complexity and interoperability remain the decisive design tests.","openQuestions":"Which graph contracts should become portable standards? How much structure should ordinary users see? How will identity, payment, moderation, and access travel across graphs?","notes":"The likely transition is hybrid: familiar pages on top, graph-native capabilities underneath.","definitionKey":"qa-summary","_classBinding":{"key":"qa-summary","sourceRef":"/templates/question-driven-explanation-template/classes/nodes/qa-summary.node-class.node"},"_bridge":{"classKey":"qa-summary","classRef":"/templates/question-driven-explanation-template/classes/nodes/qa-summary.node-class.node"},"identity":{"graphId":"qa-gbi-web"}}}],"edges":[{"id":"e-home","type":"reference","source":"d","target":"home","sourcePort":"root","targetPort":"root","label":"default surface","style":{},"data":{}},{"id":"e-auth-qa-topic","type":"reference","source":"d","target":"b-qa-topic","sourcePort":"root","targetPort":"root","label":"class authority","style":{},"data":{}},{"id":"e-auth-qa-question","type":"reference","source":"d","target":"b-qa-question","sourcePort":"root","targetPort":"root","label":"class authority","style":{},"data":{}},{"id":"e-auth-qa-answer","type":"reference","source":"d","target":"b-qa-answer","sourcePort":"root","targetPort":"root","label":"class authority","style":{},"data":{}},{"id":"e-auth-qa-source","type":"reference","source":"d","target":"b-qa-source","sourcePort":"root","targetPort":"root","label":"class authority","style":{},"data":{}},{"id":"e-auth-qa-example","type":"reference","source":"d","target":"b-qa-example","sourcePort":"root","targetPort":"root","label":"class authority","style":{},"data":{}},{"id":"e-auth-qa-caveat","type":"reference","source":"d","target":"b-qa-caveat","sourcePort":"root","targetPort":"root","label":"class authority","style":{},"data":{}},{"id":"e-auth-qa-summary","type":"reference","source":"d","target":"b-qa-summary","sourcePort":"root","targetPort":"root","label":"class authority","style":{},"data":{}},{"id":"e-new-topic","type":"reference","source":"b-qa-topic","target":"topic","sourcePort":"root","targetPort":"root","label":"instantiates","style":{},"data":{}},{"id":"e-new-q","type":"reference","source":"b-qa-question","target":"q","sourcePort":"root","targetPort":"root","label":"instantiates","style":{},"data":{}},{"id":"e-new-a","type":"reference","source":"b-qa-answer","target":"a","sourcePort":"root","targetPort":"root","label":"instantiates","style":{},"data":{}},{"id":"e-new-src","type":"reference","source":"b-qa-source","target":"src","sourcePort":"root","targetPort":"root","label":"instantiates","style":{},"data":{}},{"id":"e-new-ex","type":"reference","source":"b-qa-example","target":"ex","sourcePort":"root","targetPort":"root","label":"instantiates","style":{},"data":{}},{"id":"e-new-c","type":"reference","source":"b-qa-caveat","target":"c","sourcePort":"root","targetPort":"root","label":"instantiates","style":{},"data":{}},{"id":"e-new-sum","type":"reference","source":"b-qa-summary","target":"sum","sourcePort":"root","targetPort":"root","label":"instantiates","style":{},"data":{}},{"id":"e-frame","type":"reference","source":"home","target":"topic","sourcePort":"bottom","targetPort":"top","label":"frames","style":{},"data":{}},{"id":"e-raise","type":"reference","source":"topic","target":"q","sourcePort":"bottom","targetPort":"top","label":"raises","style":{},"data":{}},{"id":"e-answer","type":"reference","source":"q","target":"a","sourcePort":"bottom","targetPort":"top","label":"answered by","style":{},"data":{}},{"id":"e-source","type":"reference","source":"a","target":"src","sourcePort":"bottom","targetPort":"top","label":"supported by","style":{},"data":{}},{"id":"e-example","type":"reference","source":"a","target":"ex","sourcePort":"bottom","targetPort":"top","label":"illustrated by","style":{},"data":{}},{"id":"e-caveat","type":"reference","source":"a","target":"c","sourcePort":"bottom","targetPort":"top","label":"qualified by","style":{},"data":{}},{"id":"e-summary","type":"reference","source":"a","target":"sum","sourcePort":"bottom","targetPort":"top","label":"synthesized into","style":{},"data":{}},{"id":"e-src-sum","type":"reference","source":"src","target":"sum","sourcePort":"bottom","targetPort":"top","label":"grounds","style":{},"data":{}},{"id":"e-ex-sum","type":"reference","source":"ex","target":"sum","sourcePort":"bottom","targetPort":"top","label":"grounds","style":{},"data":{}},{"id":"e-c-sum","type":"reference","source":"c","target":"sum","sourcePort":"bottom","targetPort":"top","label":"qualifies","style":{},"data":{}}],"clusters":[],"settings":{"defaultNodeColor":"#1976d2","defaultEdgeColor":"#666666","snapToGrid":false,"gridSize":20,"edgeRouting":"auto","layout":{"mode":"manual","defaultLayout":"layered","direction":"DOWN"},"github":{"repo":"mikemartinez1974/public","path":"qa/how-will-graph-based-interfaces-change-the-web.node","branch":"main","repoVisibility":"public"},"autoSave":false},"scripts":[]}