          "dataType": "value",
          "angle": 270
        },
        {
          "id": "bottom",
          "label": "bottom",
          "direction": "bidirectional",
          "dataType": "value",
          "angle": 90
        }
      ],
      "visible": true,
      "showLabel": false,
      "data": {
        "title": "Complexity Must Be Curated",
        "caveat": "A raw graph is not automatically a good interface. Dense networks can be harder to understand than a well-designed page, and incompatible node contracts can recreate application silos.",
        "severity": "critical",
        "mitigation": "Use focused neighborhoods, progressive disclosure, excellent reading surfaces, typed relationships, portable schemas, and explicit authority.",
        "notes": "The graph is the model; users should not be forced to stare at all of it.",
        "identity": {
          "graphId": "qa-gbi-web"
        },
        "memo": "",
        "link": "",
        "classRef": "github://mikemartinez1974/public/templates/question-driven-explanation-template/classes/nodes/qa-caveat.node-class.node"
      }
    },
    {
      "id": "sum",
      "type": "qa-summary",
      "label": "The Web After Pages",
      "position": {
        "x": 420,
        "y": 650
      },
      "width": 500,
      "height": 390,
      "ports": [
        {
          "id": "root",
          "label": "root",
          "direction": "bidirectional",
          "dataType": "any",
          "angle": 210
        },
        {
          "id": "top",
          "label": "top",
          "direction": "bidirectional",
          "dataType": "value",
          "angle": 270
        },
        {
          "id": "bottom",
          "label": "bottom",
          "direction": "bidirectional",
          "dataType": "value",
          "angle": 90
        }
      ],
      "visible": true,
      "showLabel": false,
      "data": {
        "title": "The Web After Pages",
        "synthesis": "Graph-based interfaces will not erase the page. They will make the page one presentation of a richer, reusable model. The web becomes more navigable, composable, agent-readable, and capable of carrying provenance and authority across tools.",
        "keyPoints": "• Pages become views over durable objects.\n• Links gain roles and context.\n• Creation becomes structural composition.\n• Agents receive inspectable operating surfaces.\n• Publishing can expose reusable capabilities.\n• Complexity and interoperability remain the decisive design tests.",
        "openQuestions": "Which graph contracts should become portable standards? How much structure should ordinary users see? How will identity, payment, moderation, and access travel across graphs?",
        "notes": "The likely transition is hybrid: familiar pages on top, graph-native capabilities underneath.",
        "identity": {
          "graphId": "qa-gbi-web"
        },
        "memo": "",
        "link": "",
        "classRef": "github://mikemartinez1974/public/templates/question-driven-explanation-template/classes/nodes/qa-summary.node-class.node"
      }
    },
