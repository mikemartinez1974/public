      "data": {
        "title": "Software Becomes a Visible Work Surface",
        "example": "A project graph can connect requirements, code, issues, conversations, tasks, releases, and live tools. Humans and agents work on the same explicit model instead of translating between disconnected dashboards.",
        "relevance": "Shows how graph structure can bridge content, provenance, and action.",
        "notes": "One concrete illustration of a graph-native web.",
        "definitionKey": "qa-example",
        "_classBinding": {
