          "angle": 90
        }
      ],
      "visible": true,
      "showLabel": false,
      "data": {
        "title": "Complexity Must Be Curated",
        "caveat": "A raw graph is not automatically a good interface. Dense networks can be harder to understand than a well-designed page, and incompatible node contracts can recreate application silos.",
        "severity": "critical",
        "mitigation": "Use focused neighborhoods, progressive disclosure, excellent reading surfaces, typed relationships, portable schemas, and explicit authority.",
        "notes": "The graph is the model; users should not be forced to stare at all of it.",
        "definitionKey": "qa-caveat",
        "_classBinding": {
          "key": "qa-caveat",
          "sourceRef": "github://mikemartinez1974/public/templates/question-driven-explanation-template/classes/nodes/qa-caveat.node-class.node",
          "ref": "github://mikemartinez1974/public/templates/question-driven-explanation-template/classes/nodes/qa-caveat.node-class.node"
