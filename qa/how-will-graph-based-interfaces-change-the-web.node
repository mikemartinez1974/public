{"fileVersion":"1.0","metadata":{"title":"How Will Graph-Based Interfaces Change the Web?","description":"A focused Q&A graph explaining how graph-based interfaces may change the web.","graphId":"qa-gbi-web","version":"0.1.0","kind":"q-and-a","created":"2026-08-06T04:12:00.000Z","modified":"2026-08-06T04:12:00.000Z","author":"Michael Martinez","tags":["q-and-a","graph interfaces","web","agents"],"preferredViewer":"https://twilite.zone"},"nodes":[{"id":"d","type":"declaration","label":"Graph-Based Interfaces Q&A","position":{"x":-650,"y":-860},"width":400,"height":330,"ports":[{"id":"root","label":"root","direction":"bidirectional","dataType":"any","angle":210},{"id":"top","label":"top","direction":"bidirectional","dataType":"value","angle":270},{"id":"bottom","label":"bottom","direction":"bidirectional","dataType":"value","angle":90}],"visible":true,"showLabel":true,"data":{"identity":{"graphId":"qa-gbi-web","name":"How Will Graph-Based Interfaces Change the Web?","version":"0.1.0","description":"A Q&A graph about the shift from page-centric interfaces to composable graph interfaces.","createdAt":"2026-08-06T04:12:00.000Z","updatedAt":"2026-08-06T04:12:00.000Z"},"intent":{"kind":"graph","scope":"public-qa"},"declaration":{"kind":"graph","targetMode":"artifact","defaultSurfaceId":"root","surfaces":[{"id":"root","kind":"port","label":"How Will Graph-Based Interfaces Change the Web?","portNodeId":"home","viewNodeId":"home"}]},"dependencies":{"nodeTypes":["declaration","port","bridge","qa-topic","qa-question","qa-answer","qa-source","qa-example","qa-caveat","qa-summary"],"portContracts":["core"],"skills":["question-driven-explanation-template"],"schemaVersions":{"nodes":">=1.0.0","ports":">=1.0.0"},"optional":[]},"authority":{"mutation":{"allowCreate":true,"allowUpdate":true,"allowDelete":true},"actors":{"humans":true,"agents":true,"tools":true}}}},{"id":"home","type":"port","label":"How Will Graph-Based Interfaces Change the Web?","position":{"x":-160,"y":-860},"width":640,"height":320,"ports":[{"id":"root","label":"root","direction":"bidirectional","dataType":"any","angle":210},{"id":"top","label":"top","direction":"bidirectional","dataType":"value","angle":270},{"id":"bottom","label":"bottom","direction":"bidirectional","dataType":"value","angle":90}],"visible":true,"showLabel":false,"data":{"identity":{"graphId":"qa-gbi-web","portId":"root","name":"How Will Graph-Based Interfaces Change the Web?"},"title":"How Will Graph-Based Interfaces Change the Web?","purpose":"A question-driven map of the web after pages stop being the smallest meaningful interface unit.","key":"node.web.summary","intent":"node","payload":"node.web.summary","view":{"intent":"node","payload":"node.web.summary","label":"Graph-Based Interfaces and the Web"},"html":"<article style='height:100%;box-sizing:border-box;padding:28px;border-radius:26px;background:linear-gradient(135deg,#07111f,#164e63,#4338ca);color:white;font-family:system-ui'><small style='letter-spacing:.18em;color:#cffafe'>QUESTION-DRIVEN EXPLANATION</small><h1 style='font:800 32px Georgia;margin:18px 0 10px'>How Will Graph-Based Interfaces Change the Web?</h1><p style='font-size:16px;color:#dbeafe'>From sealed pages and application screens to inspectable, composable structures.</p><div style='font-size:38px;margin-top:40px'>? → nodes → relationships → reusable web</div></article>","visibilityRole":"browser"}},{"id":"b-qa-topic","type":"bridge","label":"qa-topic","position":{"x":-1200,"y":-1120},"width":180,"height":90,"ports":[{"id":"root","label":"root","direction":"bidirectional","dataType":"any","angle":210}],"visible":false,"showLabel":true,"data":{"authority":"bridge","target":{"mode":"bridge","ref":"/templates/question-driven-explanation-template/classes/nodes/qa-topic.node-class.node","kind":"node-class","scope":"focused-graph","grants":["create"],"key":"qa-topic"},"_classBinding":{"key":"qa-topic","sourceRef":"/templates/question-driven-explanation-template/classes/nodes/qa-topic.node-