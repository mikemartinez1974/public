        "view": {
          "intent": "node",
          "payload": "node.web.summary",
          "label": "Graph-Based Interfaces and the Web"
        },
        "html": "<article style='height:100%;box-sizing:border-box;padding:28px;border-radius:26px;background:linear-gradient(135deg,#07111f,#164e63,#4338ca);color:white;font-family:system-ui'><small style='letter-spacing:.18em;color:#cffafe'>QUESTION-DRIVEN EXPLANATION</small><h1 style='font:800 32px Georgia;margin:18px 0 10px'>How Will Graph-Based Interfaces Change the Web?</h1><p style='font-size:16px;color:#dbeafe'>From sealed pages and application screens to inspectable, composable structures.</p><div style='font-size:38px;margin-top:40px'>? → nodes → relationships → reusable web</div></article>",
