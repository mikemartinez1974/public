        "svg": "<svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 640 360\" width=\"100%\" height=\"100%\" preserveAspectRatio=\"xMidYMid meet\" role=\"img\" aria-label=\"Q and A collection graphic\"><defs><linearGradient id=\"qaCollectionBg\" x1=\"0\" y1=\"0\" x2=\"1\" y2=\"1\"><stop offset=\"0%\" stop-color=\"#07111f\"/><stop offset=\"52%\" stop-color=\"#164e63\"/><stop offset=\"100%\" stop-color=\"#4338ca\"/></linearGradient><linearGradient id=\"qaCollectionAccent\" x1=\"0\" y1=\"0\" x2=\"1\" y2=\"0\"><stop offset=\"0%\" stop-color=\"#67e8f9\"/><stop offset=\"50%\" stop-color=\"#a5b4fc\"/><stop offset=\"100%\" stop-color=\"#c4b5fd\"/></linearGradient><filter id=\"qaCollectionShadow\" x=\"-30%\" y=\"-30%\" width=\"160%\" height=\"180%\"><feDropShadow dx=\"0\" dy=\"10\" stdDeviation=\"12\" flood-color=\"#020617\" flood-opacity=\"0.55\"/></filter></defs><rect x=\"5\" y=\"5\" width=\"630\" height=\"350\" rx=\"34\" fill=\"url(#qaCollectionBg)\" stroke=\"#a5f3fc\" stroke-width=\"3\"/><circle cx=\"535\" cy=\"58\" r=\"110\" fill=\"#8b5cf6\" opacity=\"0.10\"/><rect x=\"52\" y=\"42\" width=\"536\" height=\"5\" rx=\"2.5\" fill=\"url(#qaCollectionAccent)\"/><text x=\"52\" y=\"88\" fill=\"#cffafe\" font-family=\"ui-sans-serif,system-ui,sans-serif\" font-size=\"13\" font-weight=\"800\" letter-spacing=\"0.2em\">QUESTION-DRIVEN EXPLANATIONS</text><text x=\"52\" y=\"138\" fill=\"#f8fafc\" font-family=\"ui-sans-serif,system-ui,sans-serif\" font-size=\"40\" font-weight=\"850\">Q&amp;A Collection</text><text x=\"52\" y=\"174\" fill=\"#dbeafe\" font-family=\"ui-sans-serif,system-ui,sans-serif\" font-size=\"17\">Questions become structure. Answers become navigable.</text><g transform=\"translate(52 218)\" filter=\"url(#qaCollectionShadow)\"><rect width=\"126\" height=\"90\" rx=\"18\" fill=\"#0f172a\" stroke=\"#67e8f9\" stroke-width=\"2\"/><text x=\"63\" y=\"58\" text-anchor=\"middle\" fill=\"#f8fafc\" font-family=\"system-ui,sans-serif\" font-size=\"46\" font-weight=\"900\">?</t