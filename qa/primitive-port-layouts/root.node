        "y": -400
      },
      "width": 420,
      "height": 260,
      "ports": [
        {
          "id": "surfaces",
          "key": "surfaces",
          "label": "surfaces",
          "direction": "output",
          "dataType": "any",
          "angle": 165,
          "role": "surface",
          "allowedEdgeTypes": [
            "surface"
          ],
          "metadata": {
            "structural": true,
            "relationship": true,
            "role": "surface",
            "required": false,
            "repeatable": true,
            "behaviors": [
              {
                "trigger": "drag-create",
                "action": "create-node",
