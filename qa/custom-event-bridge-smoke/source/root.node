      "height": 200,
      "data": {
        "memo": "Smoke-test adjacency: exposes the custom widget.ready Event to the receiver graph.",
        "intent": "external",
        "authority": "bridge",
        "bridge": {
          "ref": "github://mikemartinez1974/public/qa/custom-event-bridge-smoke/receiver/root.node",
          "resourceKind": "graph",
          "scope": "graph",
          "role": "export",
          "grants": [],
          "exposure": {
            "events": {
              "mode": "allowlist",
              "allowKeys": [
                "source-event-source:widget.ready"
              ]
            }
          }
        },
        "target": {
