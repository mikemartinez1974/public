        "y": -220
      },
      "width": 380,
      "height": 230,
      "data": {
        "source": "return { ok: true, note: \"fired by the local widget.ready trigger\" };",
        "scriptName": "Local Trigger Demo",
        "parameters": [],
        "allowMutations": false,
        "dryRun": false,
        "identity": {
          "graphId": "source-declaration",
          "nodeId": "source-local-method"
        }
      }
    },
