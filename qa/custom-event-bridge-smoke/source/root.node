    {
      "id": "source-event-source",
      "type": "method",
      "label": "Widget Ready (Event Source)",
      "position": {
        "x": -140,
        "y": -520
      },
      "width": 380,
      "height": 260,
      "data": {
        "source": "await api.events.emit('widget.ready', { ready: true });\nreturn { ok: true, note: 'raised widget.ready' };",
        "scriptName": "Widget Ready (Event Source)",
        "parameters": [],
        "allowMutations": false,
        "dryRun": false,
        "effects": [
          {
            "kind": "emit-event"
          }
        ],
        "events": [
          {
            "eventKey": "widget.ready",
            "label": "Widget Ready"
          }
        ],
        "identity": {
          "graphId": "source-declaration",
          "nodeId": "source-event-source"
        }
      }
    },
    {
      "id": "source-local-method",
