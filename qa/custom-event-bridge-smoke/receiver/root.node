      },
      "width": 360,
      "height": 200,
      "data": {
        "memo": "Smoke-test adjacency: imports the custom widget.ready Event from the source graph.",
        "intent": "external",
        "authority": "bridge",
        "bridge": {
          "ref": "github://mikemartinez1974/public/qa/custom-event-bridge-smoke/source/root.node",
          "resourceKind": "graph",
          "scope": "graph",
          "role": "import",
          "consumesBridgeNodeId": "source-export-bridge",
          "grants": [],
          "subscriptions": [
            {
              "id": "bridge-subscription--source-export-bridge--receiver-import-bridge--source-event-source--widget.ready",
              "sourceBridgeNodeId": "source-export-bridge",
              "targetBridgeNodeId": "receiver-import-bridge",
              "sourceRef": "github://mikemartinez1974/public/qa/custom-event-bridge-smoke/source/root.node",
              "eventNodeId": "source-event-source",
              "sourceNodeId": "source-event-source",
              "eventKey": "widget.ready",
              "handlerNodeId": "receiver-handler",
              "enabled": true
            }
          ]
        },
        "target": {
          "mode": "bridge",
          "ref": "github://mikemartinez1974/public/qa/custom-event-bridge-smoke/source/root.node",
          "kind": "graph",
          "resourceKind": "graph",
          "scope": "graph",
          "label": "Custom Event + Bridge Smoke — Source",
          "role": "import",
          "grants": []
        },
        "identity": {
