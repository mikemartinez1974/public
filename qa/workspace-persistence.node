    {
      "id": "workspace-persistence-qa-answer",
      "type": "qa-answer",
      "label": "Yes — Scoped to the Tab, Debounced, and Position-Only",
      "position": {
        "x": 880,
        "y": -420
      },
      "width": 420,
      "height": 300,
      "ports": [
        {
          "id": "root",
          "label": "root",
          "direction": "bidirectional",
          "dataType": "any",
          "angle": 210
        },
        {
          "id": "top",
          "label": "top",
          "direction": "bidirectional",
          "dataType": "value",
          "angle": 270
        },
