    {
      "id": "wheel-test-bench-setup",
      "type": "markdown",
      "label": "Setup",
      "position": {
        "x": -700,
        "y": -40
      },
      "width": 420,
      "height": 320,
      "ports": [
        {
          "id": "root",
          "label": "root",
          "direction": "bidirectional",
          "dataType": "any",
