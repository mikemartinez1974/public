        "nodeClass": {
          "contractVersion": "1.0.0",
          "key": "full-page-leaf",
          "label": "Full Page Leaf",
          "meaning": "A single node whose Detail view is a complete page. No Landing Surface -- there is nothing beneath it to navigate into.",
          "requiredDataKeys": [
            "title",
            "body"
          ],
          "nodeDef": {
            "key": "full-page-leaf",
            "ref": "github://mikemartinez1974/public/qa/leaf-page-smoke/classes/full-page-leaf.node-class.node",
            "source": "local",
            "version": ">=0.1.0",
            "defaults": {
              "label": "Full Page Leaf",
              "size": {
                "width": 640,
                "height": 520
              },
              "showLabel": false,
              "data": {
                "title": "Welcome to Leaf Co",
                "subtitle": "A page with nowhere else to go.",
                "sectionHeading": "Why this page is a single node",
                "body": "This node has a Detail, Summary, Icon and Glyph -- the full view chain -- and nothing else. No Landing Surface, no child content, no sub-graph to open.\n\nFocusing it in browse mode has nothing to navigate into, so it just zooms the camera onto this Detail view in place. At full zoom it reads as a page, not a doorway into another graph.",
                "presentation": {
                  "glyph": {
                    "kind": "icon",
                    "name": "FileText"
                  }
                }
              },
              "ports": [
                {
                  "id": "root",
                  "key": "root",
                  "label": "root",
                  "direction": "bidirectional",
                  "dataType": "any",
                  "angle": 270,
                  "position": {
                    "side": "top",
                    "offset": 0.2
                  }
                }
              ],
              "events": []
            }
          }
        }
      }
    },
    {
      "id": "full-page-leaf-detail-view",
