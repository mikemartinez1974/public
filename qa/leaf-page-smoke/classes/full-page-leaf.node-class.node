        "identity": {
          "graphId": "full-page-leaf-class",
          "nodeId": "full-page-leaf-detail-view"
        },
        "content": {
          "kind": "html",
          "value": "<div style='box-sizing:border-box;width:100%;height:100%;background:#ffffff;font-family:system-ui;display:flex;flex-direction:column;overflow:auto'><nav style='display:flex;align-items:center;justify-content:space-between;padding:14px 28px;border-bottom:1px solid #e2e8f0'><div style='font:800 13px system-ui;letter-spacing:.14em;color:#0f172a;text-transform:uppercase'>Leaf Co</div><div style='display:flex;gap:20px;font:600 13px system-ui;color:#475569'><span>Product</span><span>Docs</span><span>Contact</span></div></nav><div style='padding:36px 28px 24px'><div style='font:800 12px system-ui;letter-spacing:.18em;color:#7c3aed;text-transform:uppercase;margin-bottom:14px'>WHOLE PAGE, ONE NODE</div><h1 style='margin:0 0 12px;font:850 34px/1.15 system-ui;color:#0f172a'>{{data.title || label || \"Untitled page\"}}</h1><p style='margin:0;max-width:60ch;font:400 17px/1.5 system-ui;color:#475569'>{{data.subtitle}}</p></div><div style='padding:0 28px 28px'><h2 style='margin:0 0 12px;font:800 20px/1.2 system-ui;color:#0f172a'>{{data.sectionHeading || \"About this page\"}}</h2><p style='margin:0;max-width:60ch;white-space:pre-wrap;font:400 16px/1.6 system-ui;color:#334155'>{{data.body}}</p></div><div style='flex:1 1 auto'></div><footer style='padding:16px 28px;border-top:1px solid #e2e8f0;font:400 12px system-ui;color:#94a3b8'>One node. No Landing Surface. Nothing beneath this.</footer></div>"
        },
        "_placement": {
