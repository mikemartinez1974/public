      "visible": true,
      "showLabel": false,
      "data": {
        "title": "A Question Becomes a Living Graph",
        "example": "A user asks “What is Twilite?” The response becomes a graph of reusable Topic, Question, Answer, Source, Example, Caveat, and Summary nodes. Each part can be inspected, edited, linked, published, or reused.",
        "relevance": "Shows the difference between generating text and constructing a durable web artifact.",
        "notes": "This graph is itself the example.",
        "definitionKey": "qa-example",
        "_classBinding": {
          "key": "qa-example",
          "sourceRef": "github://mikemartinez1974/public/templates/question-driven-explanation-template/classes/nodes/qa-example.node-class.node"
