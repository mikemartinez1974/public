        },
        {
          "id": "bottom",
          "label": "bottom",
          "direction": "bidirectional",
          "dataType": "value",
          "angle": 90
        }
      ],
      "visible": true,
      "showLabel": false,
      "data": {
        "title": "A Browser for Structured Ideas",
        "answer": "Twilite is a browser, editor, and agent workspace built around graphs. A node can be content, a task, a view, a tool, a reusable class, a conversation, or a doorway into another graph. Relationships are explicit instead of being buried inside page layouts, menus, and application code.\n\nDeclarations describe identity and authority. Ports expose views or capabilities. Portals connect graphs. GitHub-backed addresses keep graphs durable and portable. Humans and AI agents make additive changes against the same inspectable structure.\n\nThe result feels less like opening isolated documents and more like entering a living model that can be explored, edited, published, and reused.",
        "confidence": "high",
        "summary": "Twilite turns structured ideas and software into navigable graph objects that humans and AI can operate together.",
        "notes": "It overlaps with browsers, whiteboards, knowledge tools, and development environments without being confined to one category.",
        "definitionKey": "qa-answer",
        "_classBinding": {
          "key": "qa-answer",
          "sourceRef": "github://mikemartinez1974/public/templates/question-driven-explanation-template/classes/nodes/qa-answer.node-class.node"
        },
