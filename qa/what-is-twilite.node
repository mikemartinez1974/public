          "angle": 90
        }
      ],
      "visible": true,
      "showLabel": false,
      "data": {
        "title": "A Graph Is Not Automatic Clarity",
        "caveat": "A raw network can be more confusing than a well-designed page. Graph-native software still needs hierarchy, focused neighborhoods, progressive disclosure, stable contracts, and excellent default views.",
        "severity": "important",
        "mitigation": "Use the graph as the underlying model while showing only the context a person needs.",
        "notes": "Structure should become more useful, not more burdensome.",
        "definitionKey": "qa-caveat",
        "_classBinding": {
          "key": "qa-caveat",
          "sourceRef": "github://mikemartinez1974/public/templates/question-driven-explanation-template/classes/nodes/qa-caveat.node-class.node"
