      ],
      "visible": true,
      "showLabel": false,
      "data": {
        "title": "Twilite in One Sentence",
        "synthesis": "Twilite is a graph-native browser and authoring environment where people and AI build, navigate, and preserve interconnected systems of ideas, software, evidence, tasks, and conversations.",
        "keyPoints": "• Durable typed nodes\n• Explicit semantic edges\n• Ports and portals\n• Reusable node classes\n• GitHub-backed graphs\n• One inspectable surface for humans and agents",
        "openQuestions": "How much structure should users see? Which contracts should become portable standards? Where should public viewing end and paid creation, privacy, collaboration, and automation begin?",
        "notes": "Twilite aims to make graphs into a practical medium for the web.",
        "definitionKey": "qa-summary",
        "_classBinding": {
          "key": "qa-summary",
          "sourceRef": "github://mikemartinez1974/public/templates/question-driven-explanation-template/classes/nodes/qa-summary.node-class.node"
