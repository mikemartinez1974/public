    {
      "id": "a",
      "type": "qa-answer",
      "label": "A Browser for Structured Ideas",
      "root": false,
      "position": {
        "x": -120,
        "y": 40
      },
      "width": 540,
      "height": 410,
      "ports": [
        {
          "id": "root",
          "label": "root",
          "direction": "bidirectional",
          "dataType": "any",
          "angle": 210
        },
        {
          "id": "top",
          "label": "top",
