":"node.web","intent":"node","viewRole":"summary","semanticLevel":"summary","visibilityRole":"browser","presentation":{"detail":{"mode":"own","viewNodeId":"property-node-inline-editor-summary"},"summary":{"mode":"own","viewNodeId":"property-node-inline-editor-summary"},"icon":{"mode":"own","viewNodeId":"property-node-inline-editor-summary"},"glyph":{"mode":"own","viewNodeId":"property-node-inline-editor-summary"}}}},{"id":"property-node-inline-editor-summary-port","type":"port","label":"Property Nodes and Inline Editing Summary","position":{"x":790,"y":-730},"width":460,"height":300,"visible":false,"showLabel":true,"ports":[{"id":"root","label":"root","direction":"bidirectional","dataType":"any","angle":210},{"id":"top","label":"top","direction":"bidirectional","dataType":"value","angle":270},{"id":"right","label":"right","direction":"bidirectional","dataType":"value","angle":0},{"id":"bottom","label":"bottom","direction":"bidirectional","dataType":"value","angle":90},{"id":"left","label":"left","direction":"bidirectional","dataType":"value","angle":180}],"data":{"identity":{"graphId":"property-node-inline-editor-task","portId":"summary","name":"Property Nodes and Inline Editing Summary"},"sourceScope":"graph","authority":"consume-view","sourceRef":"","sourceNodeId":"property-node-inline-editor-summary","sourcePayload":"node.web","targetNodeId":"property-node-inline-editor-summary","dataType":"task","renderedNodeType":"task","view":{"intent":"node","payload":"node.web","nodeType":"task","label":"Property Nodes and Inline Editing Summary","surfaceId":"summary"},"payload":"node.web","intent":"node","viewRole":"summary","semanticLevel":"summary","visibilityRole":"browser","presentation":{"detail":{"mode":"own","viewNodeId":"property-node-inline-editor-summary"},"summary":{"mode":"own","viewNodeId":"property-node-inline-editor-summary"},"icon":{"mode":"own","viewNodeId":"property-node-inline-editor-summary"},"glyph":{"mode":"own","viewNodeId":"property-node-inline-editor-summary"}}}},{"id":"property-node-inline-editor-summary","type":"summary","label":"Property Nodes and Inline Editing","position":{"x":250,"y":-730},"width":520,"height":360,"visible":true,"showLabel":true,"ports":[{"id":"root","label":"root","direction":"bidirectional","dataType":"any","angle":210},{"id":"top","label":"top","direction":"bidirectional","dataType":"value","angle":270},{"id":"right","label":"right","direction":"bidirectional","dataType":"value","angle":0},{"id":"bottom","label":"bottom","direction":"bidirectional","dataType":"value","angle":90},{"id":"left","label":"left","direction":"bidirectional","dataType":"value","angle":180}],"data":{"_classBinding":{"key":"task","ref":"github://twilite-zone/public/library/classes/nodes/task-planning/task.node-class.node","sourceRef":"github://twilite-zone/public/library/classes/nodes/task-planning/task.node-class.node"},"definitionKey":"task","identity":{"graphId":"property-node-inline-editor-task"},"goal":"Make Property nodes inspectable and editable in place","status":"todo","priority":"high","owner":"Michael","health":"on-track","nextAction":"Review the class contract and precedence question, then implement and smoke-test the Property node.","blockedReason":"","taskProgress":{"completed":0,"total":8},"questionProgress":{"answered":0,"total":3},"taskTitles":["Define the Property node class","Bridge and instantiate Property nodes","Resolve effective values with provenance","Build authored on-node editor switching","Implement value draft, Apply, and Cancel","Implement definition and computed-property editing","Preserve mutation and event boundaries","Smoke-test Property editing and field migration"],"questionTitles":["What is the effective-value precedence?","How are computed dependencies evaluated?","Which write outcomes emit events?"],"taskListText":"1. Define the Property node class\n2. Bridge and instantiate Property nodes\n3. Resolve effective values with provenance\n4. Build authored on-node editor switching\n5. Implement value draft, Apply, and Cancel\n6. Implement definition and computed-property editing\n7. Preserve mutation and event boundaries\n8. Smoke-test Property editing and field migration","questionListText":"1. What is the effective-value precedence?\n2. How are computed dependencies evaluated?\n3. Which write outcomes emit events?","summarySource":"node-updater","updatedAt":"2026-09-18T19:33:53.562Z","title":"Make Property nodes inspectable and editable in place","body":"Goal: Make Property nodes inspectable and editable in place\nStatus: todo\n\nTasks in scope:\n1. Define the Property node class\n2. Bridge and instantiate Property nodes\n3. Resolve effective values with provenance\n4. Build authored on-node editor switching\n5. Implement value draft, Apply, and Cancel\n6. Implement definition and computed-property editing\n7. Preserve mutation and event boundaries\n8. Smoke-test Property editing and field migration\n\nOpen questions:\n1. What is the effective-value precedence?\n2. How are computed dependencies evaluated?\n3. Which write outcomes emit events?","acceptanceCriteria":["Review the graph-owned task summary for current scope and progress"],"presentation":{"glyph":{"kind":"icon","name":"Checklist"}}}},{"id":"property-node-inline-editor-goal","type":"goal","label":"Make Property nodes inspectable and editable in place","position":{"x":250,"y":-250},"width":520,"height":280,"visible":true,"showLabel":true,"ports":[{"id":"root","label":"root","direction":"bidirectional","dataType":"any","angle":210},{"id":"top","label":"top","direction":"bidirectional","dataType":"value","angle":270},{"id":"right","label":"right","direction":"bidirectional","dataType":"value","angle":0},{"id":"bottom","label":"bottom","direction":"bidirectional","dataType":"value","angle":90},{"id":"left","label":"left","direction":"bidirectional","dataType":"value","angle":180}],"data":{"_classBinding":{"key":"goal","ref":"github://twilite-zone/public/library/classes/nodes/task-planning/goal.node-class.node","sourceRef":"github://twilite-zone/public/library/classes/nodes/task-planning/goal.node-class.node"},"definitionKey":"goal","identity":{"graphId":"property-node-inline-editor-task"},"body":"Promote graph-authored fields to a first-class Property class. Preserve unset versus null, stored versus computed, effective-value provenance, and write-request versus committed-change semantics. Present value and definition editors directly on the node without losing the stable graph frame.","owner":"Michael","priority":"high","status":"todo","successMetrics":["A Property instance renders its name at icon resolution and value/provenance in detail.","An explicit edit action opens an authored editor in the node frame.","Unset, null, default, stored, computed, rejected writes, and unchanged commits have distinct tested outcomes."]}},{"id":"property-node-inline-editor-decision-explicit-ref","type":"decision","label":"Property is a node; field remains an editor/schema term","position":{"x":-380,"y":-250},"width":500,"height":250,"visible":true,"showLabel":true,"ports":[{"id":"root","label":"root","direction":"bidirectional","dataType":"any","angle":210},{"id":"top","label":"top","direction":"bidirectional","dataType":"value","angle":270},{"id":"right","label":"right","direction":"bidirectional","dataType":"value","angle":0},{"id":"bottom","label":"bottom","direction":"bidirectional","dataType":"value","angle":90},{"id":"left","label":"left","direction":"bidirectional","dataType":"value","angle":180}],"data":{"_classBinding":{"key":"decision","ref":"github://twilite-zone/public/library/classes/nodes/task-planning/decision.node-class.node","sourceRef":"github://twilite-zone/public/library/classes/nodes/task-planning/decision.node-class.node"},"definitionKey":"decision","identity":{"graphId":"property-node-inline-editor-task"},"status":"decided","owner":"Michael","decidedAt":"2026-09-18","rationale":"This avoids a broad rename while making state an inspectable graph entity.","body":"Use Property for the graph-native state node. Preserve field terminology for individual editor inputs and schema fields."}},{"id":"property-node-inline-editor-decision-context-only","type":"decision","label":"Inline editing requires an explicit action","position":{"x":880,"y":-250},"width":500,"height":250,"visible":true,"showLabel":true,"ports":[{"id":"root","label":"root","direction":"bidirectional","dataType":"any","angle":210},{"id":"top","label":"top","direction":"bidirectional","dataType":"value","angle":270},{"id":"right","label":"right","direction":"bidirectional","dataType":"value","angle":0},{"id":"bottom","label":"bottom","direction":"bidirectional","dataType":"value","angle":90},{"id":"left","label":"left","direction":"bidirectional","dataType":"value","angle":180}],"data":{"_classBinding":{"key":"decision","ref":"github://twilite-zone/public/library/classes/nodes/task-planning/decision.node-class.node","sourceRef":"github://twilite-zone/public/library/classes/nodes/task-planning/decision.node-class.node"},"definitionKey":"decision","identity":{"graphId":"property-node-inline-editor-task"},"status":"decided","owner":"Michael","decidedAt":"2026-09-18","rationale":"The existing inline editor path already supports explicit edit-mode activation; zoom should remain presentation.","body":"Do not open a form merely because semantic zoom reveals detail."}},{"id":"property-node-inline-editor-risk-injection","type":"risk","label":"Legacy field coercion erases null","position":{"x":-380,"y":80},"width":500,"height":260,"visible":true,"showLabel":true,"ports":[{"id":"root","label":"root","direction":"bidirectional","dataType":"any","angle":210},{"id":"top","label":"top","direction":"bidirectional","dataType":"value","angle":270},{"id":"right","label":"right","direction":"bidirectional","dataType":"value","angle":0},{"id":"bottom","label":"bottom","direction":"bidirectional","dataType":"value","angle":90},{"id":"left","label":"left","direction":"bidirectional","dataType":"value","angle":180}],"data":{"_classBinding":{"key":"risk","ref":"github://twilite-zone/public/library/classes/nodes/task-planning/risk.node-class.node","sourceRef":"github://twilite-zone/public/library/classes/nodes/task-planning/risk.node-class.node"},"definitionKey":"risk","identity":{"graphId":"property-node-inline-editor-task"},"status":"open","owner":"Michael","severity":"high","likelihood":"likely","body":"Current class-field parsing maps null to an empty value, which would violate Property semantics if reused unchanged.","mitigation":"Use a Property-specific path and tests before migrating leaf field instances."}},{"id":"property-node-inline-editor-acceptance","type":"acceptance-criteria","label":"A Property node edits safely in place","position":{"x":880,"y":80},"width":500,"height":290,"visible":true,"showLabel":true,"ports":[{"id":"root","label":"root","direction":"bidirectional","dataType":"any","angle":210},{"id":"top","label":"top","direction":"bidirectional","dataType":"value","angle":270},{"id":"right","label":"right","direction":"bidirectional","dataType":"value","angle":0},{"id":"bottom","label":"bottom","direction":"bidirectional","dataType":"value","angle":90},{"id":"left","label":"left","direction":"bidirectional","dataType":"value","angle":180}],"data":{"_classBinding":{"key":"acceptance-criteria","ref":"github://twilite-zone/public/library/classes/nodes/task-planning/acceptance-criteria.node-class.node","sourceRef":"github://twilite-zone/public/library/classes/nodes/task-planning/acceptance-criteria.node-class.node"},"definitionKey":"acceptance-criteria","identity":{"graphId":"property-node-inline-editor-task"},"status":"open","owner":"Michael","criteria":["Property name remains visible in its icon view.","Detail view shows declared/default and effective values with source.","Edit mode plus explicit action opens an authored editor within a stable node frame.","Unset and explicit null are different editor choices and persisted states.","Computed properties display resolved state but do not expose a direct value write.","Apply validates and authorizes; Cancel discards; failures remain visible.","A write request does not claim a value change until persistence and re-resolution succeed.","Focused smoke tests cover zoom, edit/browse, field migration, and invalid writes."]}},{"id":"property-node-inline-editor-task-contract","type":"task","label":"Define the Property node class","position":{"x":-380,"y":470},"width":460,"height":250,"visible":true,"showLabel":true,"ports":[{"id":"root","label":"root","direction":"bidirectional","dataType":"any","angle":210},{"id":"top","label":"top","direction":"bidirectional","dataType":"value","angle":270},{"id":"right","label":"right","direction":"bidirectional","dataType":"value","angle":0},{"id":"bottom","label":"bottom","direction":"bidirectional","dataType":"value","angle":90},{"id":"left","label":"left","direction":"bidirectional","dataType":"value","angle":180}],"data":{"_classBinding":{"key":"task","ref":"github://twilite-zone/public/library/classes/nodes/task-planning/task.node-class.node","sourceRef":"github://twilite-zone/public/library/classes/nodes/task-planning/task.node-class.node"},"definitionKey":"task","identity":{"graphId":"property-node-inline-editor-task"},"title":"Define the Property node class","body":"Author the declaration, identity, owner, type, value kind, optional default, access policy, and editor/view surfaces. Keep editor field metadata distinct from Property nodes.","status":"todo","priority":"high","owner":"Michael","acceptanceCriteria":["Class graph validates and a Property instance can be created through its bridge."],"estimateHours":""}},{"id":"property-node-inline-editor-task-discovery","type":"task","label":"Bridge and instantiate Property nodes","position":{"x":130,"y":470},"width":460,"height":250,"visible":true,"showLabel":true,"ports":[{"id":"root","label":"root","direction":"bidirectional","dataType":"any","angle":210},{"id":"top","label":"top","direction":"bidirectional","dataType":"value","angle":270},{"id":"right","label":"right","direction":"bidirectional","dataType":"value","angle":0},{"id":"bottom","label":"bottom","direction":"bidirectional","dataType":"value","angle":90},{"id":"left","label":"left","direction":"bidirectional","dataType":"value","angle":180}],"data":{"_classBinding":{"key":"task","ref":"github://twilite-zone/public/library/classes/nodes/task-planning/task.node-class.node","sourceRef":"github://twilite-zone/public/library/classes/nodes/task-planning/task.node-class.node"},"definitionKey":"task","identity":{"graphId":"property-node-inline-editor-task"},"title":"Bridge and instantiate Property nodes","body":"Connect the class to a focused graph, prove class-backed creation, and provide a small sample graph with stored, unset, null, and computed cases.","status":"todo","priority":"medium","owner":"Michael","acceptanceCriteria":["The class resolves through an import bridge and instances retain graph identity."],"estimateHours":""}},{"id":"property-node-inline-editor-task-trust","type":"task","label":"Resolve effective values with provenance","position":{"x":640,"y":470},"width":460,"height":250,"visible":true,"showLabel":true,"ports":[{"id":"root","label":"root","direction":"bidirectional","dataType":"any","angle":210},{"id":"top","label":"top","direction":"bidirectional","dataType":"value","angle":270},{"id":"right","label":"right","direction":"bidirectional","dataType":"value","angle":0},{"id":"bottom","label":"bottom","direction":"bidirectional","dataType":"value","angle":90},{"id":"left","label":"left","direction":"bidirectional","dataType":"value","angle":180}],"data":{"_classBinding":{"key":"task","ref":"github://twilite-zone/public/library/classes/nodes/task-planning/task.node-class.node","sourceRef":"github://twilite-zone/public/library/classes/nodes/task-planning/task.node-class.node"},"definitionKey":"task","identity":{"graphId":"property-node-inline-editor-task"},"title":"Resolve effective values with provenance","body":"Integrate property resolution into node rendering; preserve absence, explicit null, default, stored/computed kind, and source provenance. Decide precedence before hard-coding it.","status":"todo","priority":"high","owner":"Michael","acceptanceCriteria":["Detail view reports effective value and source; null does not fall through."],"estimateHours":""}},{"id":"property-node-inline-editor-task-context","type":"task","label":"Build authored on-node editor switching","position":{"x":1150,"y":470},"width":460,"height":250,"visible":true,"showLabel":true,"ports":[{"id":"root","label":"root","direction":"bidirectional","dataType":"any","angle":210},{"id":"top","label":"top","direction":"bidirectional","dataType":"value","angle":270},{"id":"right","label":"right","direction":"bidirectional","dataType":"value","angle":0},{"id":"bottom","label":"bottom","direction":"bidirectional","dataType":"value","angle":90},{"id":"left","label":"left","direction":"bidirectional","dataType":"value","angle":180}],"data":{"_classBinding":{"key":"task","ref":"github://twilite-zone/public/library/classes/nodes/task-planning/task.node-class.node","sourceRef":"github://twilite-zone/public/library/classes/nodes/task-planning/task.node-class.node"},"definitionKey":"task","identity":{"graphId":"property-node-inline-editor-task"},"title":"Build authored on-node editor switching","body":"Reuse explicit inline editor selection. Keep the membrane and node footprint stable, focus fields correctly, and prevent zoom or browse mode from opening the editor.","status":"todo","priority":"high","owner":"Michael","acceptanceCriteria":["Edit action swaps to editor.web within the node; browse and zoom alone do not."],"estimateHours":""}},{"id":"property-node-inline-editor-task-ui","type":"task","label":"Implement value draft, Apply, and Cancel","position":{"x":-380,"y":790},"width":460,"height":250,"visible":true,"showLabel":true,"ports":[{"id":"root","label":"root","direction":"bidirectional","dataType":"any","angle":210},{"id":"top","label":"top","direction":"bidirectional","dataType":"value","angle":270},{"id":"right","label":"right","direction":"bidirectional","dataType":"value","angle":0},{"id":"bottom","label":"bottom","direction":"bidirectional","dataType":"value","angle":90},{"id":"left","label":"left","direction":"bidirectional","dataType":"value","angle":180}],"data":{"_classBinding":{"key":"task","ref":"github://twilite-zone/public/library/classes/nodes/task-planning/task.node-class.node","sourceRef":"github://twilite-zone/public/library/classes/nodes/task-planning/task.node-class.node"},"definitionKey":"task","identity":{"graphId":"property-node-inline-editor-task"},"title":"Implement value draft, Apply, and Cancel","body":"Keep a local draft, expose unset and null as separate choices, validate and authorize on Apply, and close only after successful persistence.","status":"todo","priority":"high","owner":"Michael","acceptanceCriteria":["Rejected writes stay visible with an error; Cancel discards draft; no event is emitted for a request alone."],"estimateHours":""}},{"id":"property-node-inline-editor-task-cache","type":"task","label":"Implement definition and computed-property editing","position":{"x":130,"y":790},"width":460,"height":250,"visible":true,"showLabel":true,"ports":[{"id":"root","label":"root","direction":"bidirectional","dataType":"any","angle":210},{"id":"top","label":"top","direction":"bidirectional","dataType":"value","angle":270},{"id":"right","label":"right","direction":"bidirectional","dataType":"value","angle":0},{"id":"bottom","label":"bottom","direction":"bidirectional","dataType":"value","angle":90},{"id":"left","label":"left","direction":"bidirectional","dataType":"value","angle":180}],"data":{"_classBinding":{"key":"task","ref":"github://twilite-zone/public/library/classes/nodes/task-planning/task.node-class.node","sourceRef":"github://twilite-zone/public/library/classes/nodes/task-planning/task.node-class.node"},"definitionKey":"task","identity":{"graphId":"property-node-inline-editor-task"},"title":"Implement definition and computed-property editing","body":"Provide a fuller on-node definition editor for type, default, validation, computed source, and access rules. Direct value editing is disabled for computed properties.","status":"todo","priority":"medium","owner":"Michael","acceptanceCriteria":["Definition changes persist; computed values remain inspectable without a writable value input."],"estimateHours":""}},{"id":"property-node-inline-editor-task-authority-test","type":"task","label":"Preserve mutation and event boundaries","position":{"x":640,"y":790},"width":460,"height":250,"visible":true,"showLabel":true,"ports":[{"id":"root","label":"root","direction":"bidirectional","dataType":"any","angle":210},{"id":"top","label":"top","direction":"bidirectional","dataType":"value","angle":270},{"id":"right","label":"right","direction":"bidirectional","dataType":"value","angle":0},{"id":"bottom","label":"bottom","direction":"bidirectional","dataType":"value","angle":90},{"id":"left","label":"left","direction":"bidirectional","dataType":"value","angle":180}],"data":{"_classBinding":{"key":"task","ref":"github://twilite-zone/public/library/classes/nodes/task-planning/task.node-class.node","sourceRef":"github://twilite-zone/public/library/classes/nodes/task-planning/task.node-class.node"},"definitionKey":"task","identity":{"graphId":"property-node-inline-editor-task"},"title":"Preserve mutation and event boundaries","body":"Report accepted/rejected writes and compare resolved value before/after commit. Add focused tests for unchanged commits, authority denial, invalid values, and computed errors/cycles.","status":"todo","priority":"high","owner":"Michael","acceptanceCriteria":["Only persisted effective changes report changed; errors are visible and do not mutate state."],"estimateHours":""}},{"id":"property-nod