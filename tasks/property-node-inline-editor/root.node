nal","dataType":"value","angle":180}],"data":{"_classBinding":{"key":"open-question","ref":"github://twilite-zone/public/library/classes/nodes/task-planning/open-question.node-class.node","sourceRef":"github://twilite-zone/public/library/classes/nodes/task-planning/open-question.node-class.node"},"definitionKey":"open-question","identity":{"graphId":"property-node-inline-editor-task"},"body":"Choose how instance, class, template, and other graph contributions resolve. The resolver receives an explicit order until this is decided.","status":"open","owner":"Michael","prominence":"high","resolutionPath":""}},{"id":"property-node-inline-editor-question-trust","type":"open-question","label":"How are computed dependencies evaluated?","position":{"x":250,"y":1130},"width":500,"height":260,"visible":true,"showLabel":true,"ports":[{"id":"root","label":"root","direction":"bidirectional","dataType":"any","angle":210},{"id":"top","label":"top","direction":"bidirectional","dataType":"value","angle":270},{"id":"right","label":"right","direction":"bidirectional","dataType":"value","angle":0},{"id":"bottom","label":"bottom","direction":"bidirectional","dataType":"value","angle":90},{"id":"left","label":"left","direction":"bidirectional","dataType":"value","angle":180}],"data":{"_classBinding":{"key":"open-question","ref":"github://twilite-zone/public/library/classes/nodes/task-planning/open-question.node-class.node","sourceRef":"github://twilite-zone/public/library/classes/nodes/task-planning/open-question.node-class.node"},"definitionKey":"open-question","identity":{"graphId":"property-node-inline-editor-task"},"body":"Specify dependency identity, errors, cycles, caching, and whether a computed property may be overridden.","status":"open","owner":"Michael","prominence":"high","resolutionPath":""}},{"id":"property-node-inline-editor-question-cache","type":"open-question","label":"Which write outcomes emit events?","position":{"x":880,"y":1130},"width":500,"height":260,"visible":tru