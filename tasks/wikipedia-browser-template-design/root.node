    {
      "id": "wiki-template-criteria",
      "type": "acceptance-criteria",
      "label": "First-pass acceptance criteria",
      "position": {"x": 560, "y": 560},
      "width": 520,
      "height": 300,
      "visible": true,
      "showLabel": false,
      "ports": [{"id": "root", "label": "root", "direction": "bidirectional", "dataType": "any", "angle": 210}],
      "data": {
        "title": "First-pass acceptance criteria",
        "criteria": [
          "A template can start from one Wikipedia article source.",
          "The root surface shows the lead and first useful section.",
          "Additional sections appear as deliberate expandable ports.",
          "Dragging a section expansion produces a readable transient section node.",
          "Source attribution remains available on article and section surfaces.",
          "The first pass does not require full Wikipedia knowledge ingestion."
        ],
        "definitionKey": "acceptance-criteria",
        "_classBinding": {"key": "acceptance-criteria", "sourceRef": "github://twilite-zone/public/library/classes/nodes/task-planning/acceptance-criteria.node-class.node"},
