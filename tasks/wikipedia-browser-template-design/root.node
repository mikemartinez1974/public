      }
    },
    {
      "id": "wikipedia-browser-template-design-summary",
      "type": "summary",
      "label": "Wikipedia Browser Template Design",
      "position": {"x": -120, "y": 940},
      "width": 700,
      "height": 360,
      "visible": true,
      "showLabel": false,
      "ports": [{"id": "root", "label": "root", "direction": "bidirectional", "dataType": "any", "angle": 210}],
      "data": {
        "title": "Wikipedia Browser Template Design",
        "summary": "Design a reusable Twilite template rather than a single special-purpose node. The first pass centers on two semantic roles: an article-source root and expandable section nodes. The template should prove spatial browsing of one real Wikipedia article before adding references, infoboxes, categories, images, or deeper knowledge ingestion.",
        "status": "active",
        "definitionKey": "summary",
        "_classBinding": {"key": "summary", "sourceRef": "github://twilite-zone/public/library/classes/nodes/task-planning/task-graph-summary.node-class.node"},
        "identity": {"graphId": "wikipedia-browser-template-design"}
      }
    }
