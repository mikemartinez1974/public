      "width": 460,
      "height": 280,
      "visible": true,
      "showLabel": false,
      "ports": [{"id": "root", "label": "root", "direction": "bidirectional", "dataType": "any", "angle": 210}],
      "data": {
        "title": "Keep the first pass section-centric",
        "decision": "Let Wikipedia remain responsible for its broader encyclopedia structure. Twilite initially adds value by turning article sections into spatially expandable browsing objects.",
        "status": "decided",
        "definitionKey": "decision",
        "_classBinding": {"key": "decision", "sourceRef": "github://twilite-zone/public/library/classes/nodes/task-planning/decision.node-class.node"},
