    {
      "id": "wikipedia-browser-template-design-goal",
      "type": "goal",
      "label": "Define the smallest coherent Wikipedia browsing template",
      "root": false,
      "position": {
        "x": -220,
        "y": -260
      },
      "width": 620,
      "height": 320,
      "ports": [
        {
          "id": "root",
          "label": "root",
          "direction": "bidirectional",
          "dataType": "any",
          "angle": 210
        }
      ],
      "visible": true,
      "showLabel": false,
      "data": {
        "title": "Define the smallest coherent Wikipedia browsing template",
        "description": "Produce a reusable template whose root sources one Wikipedia article, renders the lead and first useful section, and exposes additional sections as expandable graph entry points.",
        "status": "active",
        "definitionKey": "goal",
        "_classBinding": {
          "key": "goal",
          "sourceRef": "github://twilite-zone/public/library/classes/nodes/task-planning/goal.node-class.node"
        },
        "identity": {
          "graphId": "wikipedia-browser-template-design"
        }
      }
    },
    {
      "id": "wiki-template-task-grammar",
      "type": "task",
      "label": "Define template grammar",
      "root": false,
      "position": {
        "x": -780,
        "y": 160
      },
      "width": 420,
      "height": 300,
      "ports": [
        {
          "id": "root",
          "label": "root",
          "direction": "bidirectional",
          "dataType": "any",
          "angle": 210
        }
      ],
      "visible": true,
      "showLabel": false,
      "data": {
        "title": "Define the template grammar",
        "description": "Define the minimum first-pass template grammar as three cooperating pieces: an Article Source node class, a Section node class, and a reusable expansion contract that materializes section nodes from article section ports. The Article Source is the template root and owns the remote article identity, lead, section index, source metadata, and attribution. Section nodes represent one article section at a time and may expose subsection expansion points. The expansion behavior connects the two without eagerly creating every section in the graph.",
        "status": "done",
        "definitionKey": "task",
        "_classBinding": {
          "key": "task",
          "sourceRef": "github://twilite-zone/public/library/classes/nodes/task-planning/task.node-class.node"
        },
        "identity": {
          "graphId": "wikipedia-browser-template-design"
        },
        "result": "V1 grammar: Article Source + Section + Section Expansion. Keep references, infoboxes, images, categories, and general Wikipedia link semantics outside the initial template unless the specimen reveals a hard dependency. Article Source is the root semantic object. Section is the recursive transient projection. Expansion is behavior, not a third content ontology.",
        "acceptance": [
          "The template has one root Article Source node.",
          "The Article Source exposes article sections as expandable ports or equivalent expansion points.",
          "Expanding a section creates or reveals a transient Section node.",
          "A Section node can expose nested subsections using the same grammar.",
          "The graph does not eagerly materialize the entire article.",
          "Wikipedia source identity and attribution remain available throughout the expansion chain.",
          "The first version does not model the broader Wikipedia knowledge system."
        ],
        "memo": "",
        "link": "",
        "body": "V1 grammar: Article Source + Section + Section Expansion.\n\nArticle Source is the template root. It owns the remote Wikipedia article identity, lead, section index, source metadata, and attribution. It presents the lead and first useful section while exposing additional sections as expansion points.\n\nSection is the recursive transient projection. A Section node represents one article section and may expose its own subsections using the same grammar.\n\nSection Expansion is behavior, not a third content ontology. It connects article or section expansion points to transient Section nodes without eagerly materializing the whole article.\n\nKeep references, infoboxes, images, categories, and general Wikipedia link semantics outside the first-pass template unless the specimen reveals a hard dependency.",
        "acceptanceCriteria": [
          "The template has one root Article Source node.",
          "The Article Source exposes article sections as expandable ports or equivalent expansion points.",
          "Expanding a section creates or reveals a transient Section node.",
          "A Section node can expose nested subsections using the same grammar.",
          "The graph does not eagerly materialize the entire article.",
          "Wikipedia source identity and attribution remain available throughout the expansion chain.",
          "The first version does not model the broader Wikipedia knowledge system."
        ]
      }
    },
