    {
      "id": "wiki-template-question-expansion",
      "type": "open-question",
      "label": "How should section expansion materialize?",
      "position": {"x": 20, "y": 560},
      "width": 460,
      "height": 280,
      "visible": true,
      "showLabel": false,
      "ports": [{"id": "root", "label": "root", "direction": "bidirectional", "dataType": "any", "angle": 210}],
      "data": {
        "title": "How should section expansion materialize?",
        "question": "When a user drags from a section port, should Twilite create a transient section node, reveal a prepared child node, or invoke a reusable expansion behavior that creates the node on demand?",
        "status": "open",
        "definitionKey": "open-question",
        "_classBinding": {"key": "open-question", "sourceRef": "github://twilite-zone/public/library/classes/nodes/task-planning/open-question.node-class.node"},
