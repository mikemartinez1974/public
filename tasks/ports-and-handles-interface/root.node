      "visible": true,
      "showLabel": true,
      "data": {
        "body": "Should Handle be a distinct primitive or specialization, or should a Port remain the single endpoint primitive and project a handle affordance when it declares initiating behavior?",
        "status": "answered",
        "owner": "",
        "resolutionPath": "Keep Port as the single authored endpoint primitive. A stable Port id makes it addressable and connectable; its label is presentation only. Optional behaviors determine whether the UI projects a draggable handle affordance. A completed drag emits the source node and Port plus either a target node and Port or graph coordinates. Authored behavior interprets that event to connect, create an authorized node, invoke an action, navigate, open a chooser, or do nothing. Acceptance, initiation, node creation, and edge semantics remain independent declarations; Handle is a presentation state, not a second primitive.",
        "prominence": "high",
        "definitionKey": "open-question",
        "_classBinding": {
          "key": "open-question",
          "sourceRef": "github://twilite-zone/public/library/classes/nodes/task-planning/open-question.node-class.node",
          "ref": "github://twilite-zone/public/library/classes/nodes/task-planning/open-question.node-class.node"
        },
