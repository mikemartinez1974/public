      "visible": true,
      "showLabel": true,
      "data": {
        "body": "Define, implement, and validate a Chat node that can point to a private owner link, a shared conversation snapshot, or a locally archived transcript excerpt while clearly communicating access, permanence, and the artifacts produced by the conversation.",
        "priority": "high",
        "status": "in-progress",
        "owner": "Michael",
        "targetDate": "",
        "successMetrics": [
          "The Chat node has a documented minimum data contract and registered node class.",
          "Private, shared, archived, inaccessible, and deleted-link states are visually distinguishable.",
          "A node remains informative when its external conversation cannot be opened.",
          "Produced, revised, or explained artifacts can be connected through explicit provenance relationships.",
          "The prototype stores no authentication secrets or falsely implies access.",
          "Provider-specific API integration remains optional and outside the v0.1 contract.",
          "A graph can contain multiple Chat nodes, each independently representing one conversation and one provenance event.",
          "Chat provenance remains conversation-centric and does not expose commit history or require revision identifiers."
        ],
        "definitionKey": "goal",
        "_classBinding": {
          "key": "goal",
          "sourceRef": "github://twilite-zone/public/library/classes/nodes/task-planning/goal.node-class.node",
