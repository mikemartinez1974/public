          "id": "bottom",
          "label": "bottom",
          "direction": "bidirectional",
          "dataType": "value",
          "angle": 90
        },
        {
          "id": "right",
          "label": "right",
          "direction": "bidirectional",
          "dataType": "value",
          "angle": 360
        }
      ],
      "visible": true,
      "showLabel": true,
      "data": {
        "rationale": "This keeps the conversation anchored to a real graph artifact instead of a floating abstraction.",
        "status": "decided",
        "decidedAt": "2026-08-05T22:57:00.000Z",
        "owner": "Michael",
        "supersededBy": "",
        "body": "A Chat node is a durable provenance record for exactly one conversation. A graph may accumulate any number of Chat nodes as it is created, revised, reviewed, or explained. Each node retains its own source, access state, captured context, timestamp, and provenance role. Conversation history is represented by multiple nodes and graph relationships, not by an array of unrelated conversations inside one node and not by exposing the graph commit history.",
        "definitionKey": "decision",
        "_classBinding": {
          "key": "decision",
          "sourceRef": "github://twilite-zone/public/library/classes/nodes/task-planning/decision.node-class.node",
          "ref": "github://twilite-zone/public/library/classes/nodes/task-planning/decision.node-class.node"
        },
        "_bridge": {
          "sourceNodeId": "create-chat-provenance-node-bridge-decision",
          "sourceBridgeNodeId": "create-chat-provenance-node-bridge-decision",
          "sourceBridgeLabel": "Decision",
          "sourceRef": "github://twilite-zone/public/library/classes/nodes/task-planning/decision.node-class.node",
          "entryPort": "root",
          "kind": "node-class",
          "targetKind": "node-class",
          "classKey": "decision",
          "classRef": "github://twilite-zone/public/library/classes/nodes/task-planning/decision.node-class.node"
        },
        "identity": {
          "graphId": "create-chat-provenance-node-declaration"
        },
        "_placement": {
          "version": 1,
          "state": "auto-placed",
          "source": "layout",
          "updatedAt": 1785977690240,
          "reason": "auto-layout"
        },
        "title": "Use One Chat Node per Conversation"
      }
    },
    {
      "id": "create-chat-provenance-node-decision-no-commit-history",
      "type": "decision",
      "label": "Keep Chat Provenance Separate from Commit History",
      "root": false,
      "position": {
        "x": 781.150074429615,
        "y": 52.50693294111943
      },
      "width": 420,
      "height": 240,
