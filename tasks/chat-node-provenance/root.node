      ],
      "visible": true,
      "showLabel": true,
      "data": {
        "title": "Define the Minimal Chat Node Data Contract",
        "body": "Specify the fields for one conversation source, source kind, provider, conversation reference or URL, access mode, snapshot scope, captured summary, optional excerpt, timestamps, status, and provenance event metadata. A graph may contain many Chat nodes, but each Chat node represents exactly one conversation.",
        "priority": "high",
        "status": "todo",
        "owner": "Michael",
        "estimateHours": "2",
        "acceptanceCriteria": [
          "The contract distinguishes private owner links, shared snapshots, and locally archived transcripts.",
          "Access and permanence are explicit fields rather than inferred promises.",
          "Summary and excerpt fields remain useful when the external source is unavailable.",
          "No credential, token, or private conversation content is required by the base contract.",
          "The base contract permits exactly one conversation reference per Chat node rather than an array of conversations.",
          "Multiple revisions are represented by multiple Chat nodes attached to the graph."
        ],
        "definitionKey": "task",
        "_classBinding": {
          "key": "task",
          "sourceRef": "github://twilite-zone/public/library/classes/nodes/task-planning/task.node-class.node",
          "ref": "github://twilite-zone/public/library/classes/nodes/task-planning/task.node-class.node"
        },
