      "data": {
        "rationale": "This keeps the conversation anchored to a real graph artifact instead of a floating abstraction.",
        "status": "decided",
        "decidedAt": "2026-08-05T22:44:00.000Z",
        "owner": "Michael",
        "supersededBy": "",
        "body": "The first Chat node is a provenance node using manually supplied references and explicit access semantics. It is not an embedded live-chat client, does not require provider authentication, and does not promise transcript retrieval. Provider-specific integrations may enrich the node later without redefining its base identity.",
        "definitionKey": "decision",
