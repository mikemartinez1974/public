        },
        {
          "id": "right",
          "label": "right",
          "direction": "bidirectional",
          "dataType": "value",
          "angle": 360
        }
      ],
      "visible": true,
      "showLabel": true,
      "data": {
        "rationale": "The conversation link already supplies the human context. Exposing commits or reconstructing historical graph states would add complexity and disclose implementation history that the feature does not need.",
        "status": "decided",
        "decidedAt": "2026-08-05T23:08:00.000Z",
        "owner": "Michael",
        "supersededBy": "",
        "body": "Chat provenance links a conversation to the graph or node it influenced. It does not expose repository commit history, require revision identifiers, or attempt to recreate the exact graph state at the time of the discussion. A timestamp and provenance role provide lightweight ordering and meaning.",
        "definitionKey": "decision",
        "_classBinding": {
          "key": "decision",
          "sourceRef": "github://twilite-zone/public/library/classes/nodes/task-planning/decision.node-class.node",
          "ref": "github://twilite-zone/public/library/classes/nodes/task-planning/decision.node-class.node"
