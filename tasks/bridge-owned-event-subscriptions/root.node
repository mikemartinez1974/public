        "status": "open",
        "owner": "Michael",
        "targetDate": "",
        "successMetrics": [
          "No graph-level Event Declaration nodes are required for new events",
          "No graph-level Subscription nodes are required for bridged delivery",
          "Bridge exposure and subscription remain explicit and reviewable",
          "Event Handler to Method wiring remains visible on the graph"
        ],
