      "data": {
        "title": "Make the code do what the contract says",
        "identity": {
          "graphId": "properties-and-authoring-contract",
          "nodeId": "properties-and-authoring-contract-task-contract-enforcement"
        },
        "classRef": "tlz://twilite.zone/library/classes/nodes/task-planning/task.node-class.node",
        "owner": "Michael",
        "status": "done",
        "body": "The contract describes the switches; nothing checks the code against it, and the first half of an audit found switches nothing reads, a range that disagrees with its clamp, and enums passed on unchecked. The audit and its fixes are their own graph: open the portal beside this task. Done so far: the six dead switches are out, and the edge draw loop animates every form the normalizer accepts. Edge effects: glow, gradient and stroke stacks can now be edited in the panel, and a pulse reaches a stack. 2026-10-27: the audit is finished and the fixes made; a test now holds the contract to the code. Two small tasks and the edge effects remain. showLabel is built on every node with a title bar. The node text styles were surveyed; one question is open for Michael. Node text styles: decided that every node honours them; being built. Every node now honours its text styles (the script card its fill and border too). 2026-10-28: done. The audit, its fixes, the contract test and the edge effects are finished; see the graph.",
        "_placement": {
          "version": 1,
          "state": "manually-shaped",
          "source": "manual",
          "updatedAt": 1793157495259,
          "reason": "node-drag"
        }
      }
    },
