      "data": {
        "title": "Is a handle selectable on its own, or a section of the node?",
        "identity": {
          "graphId": "properties-and-authoring-contract",
          "nodeId": "properties-and-authoring-contract-q-handle-select"
        },
        "classRef": "tlz://twilite.zone/library/classes/nodes/task-planning/open-question.node-class.node",
        "owner": "Michael",
        "status": "answered",
        "body": "Today a handle is not selectable; it is a section of the node. Making it selectable means a click on a handle on the canvas opens its panel.\n\nDecision: Make handles independently selectable on the canvas and open handle properties on click. Dragging a handle still starts a connection; distinguish click from drag. A Handle is a visual anchor, not the semantic Port it references. Keep the parent node context visible.",
        "_placement": {
          "version": 1,
          "state": "manually-shaped",
          "source": "manual",
          "updatedAt": 1792950744125,
          "reason": "node-drag"
        }
      }
    },
