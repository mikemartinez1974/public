      "data": {
        "body": "Build a first Q&A explanation template with seven core node classes and the essential edge grammar, derive three explanation graphs from unrelated domains, and evaluate whether the structure remains clear without domain-specific node classes.",
        "priority": "high",
        "status": "todo",
        "owner": "Michael",
        "targetDate": "",
        "successMetrics": [
          "A canonical template graph exists with qa-topic, qa-question, qa-answer, qa-source, qa-example, qa-caveat, and qa-summary classes.",
          "Science, history, and software specimens are derived from the same template.",
          "Irrelevant seeded lenses can be removed cleanly and custom follow-up questions can be added without new node classes.",
          "A written evaluation records whether qa-term and qa-audience belong in v0.1."
        ],
        "definitionKey": "goal",
        "_classBinding": {
          "key": "goal",
