      "data": {
        "title": "Define the v0.1 Node and Edge Contract",
        "body": "Specify the seven core node classes, the qa-question lens vocabulary, and the essential asking, answering, supporting, illustrating, qualifying, following-up, dependency, and synthesis relationships.",
        "priority": "high",
        "status": "todo",
        "owner": "Michael",
        "estimateHours": "2",
        "acceptanceCriteria": [
          "Each core class has a concise purpose and minimum fields.",
          "Who, What, Where, When, Why, and How are seeded qa-question instances rather than separate classes.",
          "The essential edge grammar distinguishes structure from optional enrichment."
        ],
