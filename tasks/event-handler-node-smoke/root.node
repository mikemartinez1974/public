        },
        "scriptName": "Write label into rendered result",
        "parameters": [
          "eventPayload"
        ],
        "allowMutations": true,
        "dryRun": false,
        "source": "const payload=api.invocation?.eventPayload||{};const value=payload.state==='unset'?'(unset)':payload.value===null?'null':String(payload.value??'');await api.updateView('event-handler-smoke-output',{content:{kind:'markdown',value:'# Rendered result\\n\\n## '+value+'\\n\\nUpdated by **Update rendered label** at '+new Date().toLocaleTimeString()+'.'}});return{updated:true,value};",
        "presentation": {
          "glyph": {
            "kind": "icon",
            "name": "Functions"
          }
        },
        "_semanticLevel": "detail"
      }
