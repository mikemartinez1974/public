        "content": {
          "kind": "html",
          "value": "<div style='container-type:inline-size;box-sizing:border-box;width:100%;height:100%;min-height:100%;overflow:hidden;font-family:system-ui,-apple-system,Segoe UI,sans-serif;padding:5cqw 6cqw;border-radius:5cqw;background:#ffffff;border:1px solid #fecaca;display:flex;flex-direction:column;gap:2.6cqw'><div style='display:flex;justify-content:space-between;align-items:center'><span style='display:inline-block;padding:.3cqw 2.4cqw;border-radius:2.4cqw;background:#fef2f2;color:#b91c1c;border:1px solid #fecaca;font-weight:600;font-size:3.6cqw;line-height:1.4'>Blocked</span><span style='font-size:3.6cqw;color:#64748b'>1 of 5</span></div><div style='font-weight:600;font-size:5.6cqw;line-height:1.2;color:#0f172a'>Make the canon follow the view-shape rule</div><div style='height:1.8cqw;border-radius:1cqw;background:#e2e8f0;overflow:hidden'><div style='width:20%;height:100%;background:#b91c1c'></div></div><div style='font-size:3.8cqw;line-height:1.3;color:#b91c1c'>Needs publish-graphs.ps1, which asks for the ssh password</div><div style='margin-top:auto;display:flex;justify-content:space-between;font-size:3.4cqw;color:#b45309'><span>1 open question</span><span>Michael</span></div></div>"
        },
        "memo": "",
        "link": ""
      }
    },
