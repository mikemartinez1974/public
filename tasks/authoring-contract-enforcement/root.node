          "id": "root",
          "key": "root",
          "label": "root",
          "direction": "bidirectional",
          "dataType": "any",
          "angle": 250,
          "portId": "root"
        }
      ],
      "visible": true,
      "showLabel": true,
      "data": {
        "title": "Are edge flow, direction, strength and intent annotations, or do they do something?",
        "identity": {
          "graphId": "authoring-contract-enforcement",
          "nodeId": "authoring-contract-enforcement-q-data"
        },
        "classRef": "tlz://twilite.zone/library/classes/nodes/task-planning/open-question.node-class.node",
        "owner": "Michael",
        "status": "answered",
        "body": "Today they are stored and read by nothing. As annotations they are for a reader (a person, an agent, an edge class) and the contract should say that in each effect. If they should act, say what each does.\n\nDecision (Michael, 2026-10-27): they are not wanted as data keys. Edges should support animation and cool things like it, as style; the old keys were an artifact. Removed from the contract.",
        "_placement": {
          "version": 1,
          "state": "manually-shaped",
          "source": "manual",
          "updatedAt": 1793157495259,
          "reason": "node-drag"
        }
      }
    },
