        },
        "classRef": "tlz://twilite.zone/library/classes/nodes/task-planning/task.node-class.node",
        "owner": "Michael",
        "status": "todo",
        "body": "node.style.fontFamily, fontSize, fontWeight, lineHeight and letterSpacing are applied to the frame as CSS, and reach the text only where a node type does not set its own. Content nodes read colour, line height and size by hand, so they may override the rest. Look at each node type with an authored font and list the ones where it does nothing. Found in the audit; not checked per type.",
        "_placement": {
