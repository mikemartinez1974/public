              "exposes": {
                "views": { "mode": "allow" },
                "declarations": { "mode": "allow" }
              }
            }
          ],
          "notes": [
            "A task remains a task inside its own graph and when projected into another graph.",
            "Project describes scope and point of view; it is not a separate semantic node type.",
            "Local tasks belong to this collection. Promoted tasks retain authority in their own graphs and appear here through portals."
          ]
