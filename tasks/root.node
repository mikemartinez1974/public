        "title": "Make Twilite self-describing for codebase-free agents",
        "body": "Raise codebase-free graph-authoring reliability by publishing canonical machine-readable schemas, enumerating supported field and view types, returning precise validation and repair guidance, maintaining known-good examples, and exposing runtime capabilities without requiring source-code archaeology.",
        "status": "in-progress",
        "priority": "high",
        "owner": "Michael",
        "nextAction": "Inventory the remaining runtime-only assumptions and decide which belong in schemas, validation diagnostics, capability discovery, or canonical examples.",
        "blockedReason": "",
        "health": "on-track",
        "acceptanceCriteria": [
          "An onboarding-only agent can create and repair ordinary Twilite graphs with greater than 90 percent first-pass success.",
          "Unsupported fields and capabilities fail with specific machine-readable repair guidance.",
          "Ordinary graph authoring no longer requires inspecting the Twilite codebase."
        ]
      }
    },
