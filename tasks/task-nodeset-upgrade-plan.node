        "_classBinding": {
          "key": "decision",
          "ref": "github://twilite-zone/public/library/classes/nodes/task-planning/decision.node-class.node",
          "sourceRef": "github://twilite-zone/public/library/classes/nodes/task-planning/decision.node-class.node"
        },
        "decidedAt": "2026-07-29",
        "definitionKey": "decision",
        "identity": {
          "graphId": "task-nodeset-upgrade"
        },
        "owner": "Michael",
        "rationale": "Membership belongs to each workbench and is represented by resolved task instances. A source-backed instance retains an authored portal as its carrier and provenance, but the portal is not its semantic type. Effective type resolves from an explicit exposed-port override, then the source graph declaration, then the selected internal source node, with portal only as the unresolved fallback. data.board stores workbench-local projection state; it is not a type marker or registry. A second registry would duplicate truth and drift.",
        "status": "decided",
        "supersededBy": ""
      }
    },
    {
      "id": "task-nodeset-upgrade-decision-task-invariant",
      "type": "decision",
      "label": "A task remains a task across graph boundaries",
      "root": false,
      "position": {
        "x": 1390,
        "y": 1630
      },
      "width": 450,
