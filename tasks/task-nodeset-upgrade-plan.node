        "_classBinding": {
          "key": "decision",
          "ref": "github://twilite-zone/public/library/classes/nodes/task-planning/decision.node-class.node",
          "sourceRef": "github://twilite-zone/public/library/classes/nodes/task-planning/decision.node-class.node"
        },
        "decidedAt": "2026-07-31",
        "definitionKey": "decision",
        "identity": { "graphId": "task-nodeset-upgrade" },
        "owner": "Michael",
        "rationale": "Task is the semantic invariant. Inside its own graph it is still an ordinary task, possibly supported by subtasks, questions, decisions, risks, and dependencies. Outside that graph it is exposed and projected as a task. Project describes the scope and point of view of a task with its own graph; it is not a separate node type. Promotion changes the location of authority and available detail without changing semantic type.",
        "status": "decided",
        "supersededBy": ""
      }
    }
