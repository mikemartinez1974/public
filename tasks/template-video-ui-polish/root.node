      "data": {
        "scriptName": "Template Video and UI Polish Updater",
        "summaryNodeId": "template-video-ui-polish-summary",
        "autoRun": true,
        "autoRunOnGraphChange": true,
        "autoRunOnLoad": true,
        "allowMutations": true,
        "dryRun": false,
        "source": "const SUMMARY_ID = 'template-video-ui-polish-summary';\nconst done = new Set(['done', 'complete', 'completed', 'closed']);\nconst answered = new Set(['answered', 'done', 'resolved', 'closed']);\nconst norm = (value) => String(value || '').trim().toLowerCase();\nconst nodes = await api.getNodes();\nconst summary = nodes.find((node) => node?.id === SUMMARY_ID);\nconst goal = nodes.find((node) => node?.type === 'goal');\nconst tasks = nodes.filter((node) => node?.type === 'task');\nconst questions = nodes.filter((node) => node?.type === 'open-question');\nif (!summary || !goal) return { success: false, error: 'Goal or summary node missing' };\nconst taskTitles = tasks.map((node) => String(node?.data?.title || node?.label || 'Untitled task'));\nconst questionTitles = questions.map((node) => String(node?.label || 'Untitled question'));\nconst completed = tasks.filter((node) => done.has(norm(node?.data?.status))).length;\nconst answeredCount = questions.filter((node) => answered.has(norm(node?.data?.status))).length;\nconst derived = {\n  goal: goal.label,\n  status: norm(goal?.data?.status) || 'todo',\n  priority: goal?.data?.priority || 'medium',\n  owner: goal?.data?.owner || '',\n  targetDate: goal?.data?.targetDate || '',\n  taskProgress: { completed, total: tasks.length },\n  questionProgress: { answered: answeredCount, total: questions.length },\n  taskTitles,\n  questionTitles,\n  taskListText: taskTitles.length ? taskTitles.map((title, index) => `${index + 1}. ${title}`).join('\\n') : 'No tasks listed.',\n  questionListText: questionTitles.length ? questionTitles.map((title, index) => `${index + 1}. ${title}`).join('\\n') : 'No open questions.',\n  summarySource: 'node-updater'\n};\nconst current = summary.data || {};\nconst unchanged = Object.entries(derived).every(([key, value]) => JSON.stringify(current[key]) === JSON.stringify(value));\nif (unchanged) return { success: true, updated: false, summary: current };\nconst nextData = { ...current, ...derived, updatedAt: new Date().toISOString() };\nawait api.updateNode(SUMMARY_ID, { data: nextData });\nreturn { success: true, updated: true, summary: nextData };",
        "identity": {
          "graphId": "template-video-ui-polish"
        },
