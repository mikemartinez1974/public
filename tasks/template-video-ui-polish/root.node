      "visible": true,
      "showLabel": true,
      "data": {
        "rationale": "Node classes should decide which fields exist, their meaning, and their grouping. Twilite should own the editor shell, typography, spacing, validation placement, and action treatment so generic and hosted editors feel like one product.",
        "status": "decided",
        "decidedAt": "2026-07-26",
        "owner": "Michael",
        "supersededBy": "",
        "body": "Introduce editor-specific visual tokens rather than changing application-wide typography or copying cosmetic rules into every node class. Begin with the shared shell and generic fields, then apply the same scale to Declaration and Port before polishing Markdown, SVG, and Person.",
        "definitionKey": "decision",
        "_classBinding": {
          "key": "decision",
          "sourceRef": "github://twilite-zone/public/library/classes/nodes/task-planning/decision.node-class.node",
