        }
      }
    },
    {
      "id": "zoom-level-floor-ceiling-model-task-compare",
      "type": "task",
      "label": "4 — Verify against small and large content side by side",
      "root": false,
      "position": {
        "x": 460,
        "y": 260
      },
      "width": 430,
      "height": 300,
      "ports": [
        {
          "id": "top",
          "label": "top",
          "direction": "input",
          "dataType": "value",
          "angle": 270
        },
        {
          "id": "bottom",
          "label": "bottom",
          "direction": "output",
          "dataType": "value",
          "angle": 90
        }
      ],
      "visible": true,
      "showLabel": true,
      "data": {
        "body": "The comparison retune-semantic-zoom-thresholds already called for: sweep zoom on a small idea card and a dense graph together, confirm each settles into the right level at a size that actually reads as that level, not just crosses a threshold.",
        "priority": "medium",
        "status": "todo",
        "owner": "Michael",
        "definitionKey": "task",
        "_classBinding": {
