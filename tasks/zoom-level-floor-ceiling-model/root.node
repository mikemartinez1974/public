      }
    },
    {
      "id": "zoom-level-floor-ceiling-model-task-collapsed-consistency",
      "type": "task",
      "label": "5 — Reconcile with collapsed-card sizing and focus-unfocus",
      "root": false,
      "position": {
        "x": 1130,
        "y": 260
      },
      "width": 430,
      "height": 300,
      "ports": [
        {
          "id": "top",
          "label": "top",
          "direction": "input",
          "dataType": "value",
          "angle": 270
        },
        {
          "id": "bottom",
          "label": "bottom",
          "direction": "output",
          "dataType": "value",
          "angle": 90
        }
      ],
      "visible": true,
      "showLabel": true,
      "data": {
        "body": "Make sure LEVEL_BOX_SIZE and the still-open question of whether a focused graph can unfocus (semantic-zoom-architecture) end up reading the same floor/ceiling model instead of a second, separate one.",
        "priority": "medium",
        "status": "todo",
        "owner": "Michael",
        "definitionKey": "task",
        "_classBinding": {
          "key": "task",
          "sourceRef": "github://twilite-zone/public/library/classes/nodes/task-planning/task.node-class.node",
          "ref": "github://twilite-zone/public/library/classes/nodes/task-planning/task.node-class.node"
        },
        "_bridge": {
          "sourceBridgeNodeId": "zoom-level-floor-ceiling-model-bridge-task",
          "sourceRef": "github://twilite-zone/public/library/classes/nodes/task-planning/task.node-class.node",
          "classKey": "task",
          "classRef": "github://twilite-zone/public/library/classes/nodes/task-planning/task.node-class.node"
        },
        "identity": {
