      "data": {
        "title": "Rebuild the Page Template and its demos",
        "identity": {
          "graphId": "canon-templates-in-order",
          "nodeId": "canon-templates-in-order-task-page-template"
        },
        "classRef": "tlz://twilite.zone/library/classes/nodes/task-planning/task.node-class.node",
        "status": "done",
        "owner": "Michael",
        "body": "The Page Template is rebuilt to the standard (no Icon, a 3:2 page that scrolls, a window of its own shape, an environment) and the pages built from it follow: the 14 primitives, the specification, the navigation, glossary and three personal pages. Its four piece classes show one view of a piece and a Glyph. The eight demo templates are rebuilt the same way, each with an environment in its own paper and line; a slide grows with its content now, and the example relations of the poster use a new core edge class, leads-to. Left over: the Declaration Template, which has a hand-built layout and belongs to the personal library list.",
        "_placement": {
          "version": 1,
          "state": "manually-shaped",
          "source": "manual",
          "updatedAt": 1792449096026,
          "reason": "node-drag"
        },
        "notes": " 2026-10-30: the Declaration Template is in canon now and meets the standard; nothing from this task is left over."
      }
    },
