        "title": "Ends that have no port take the side that faces the other graph",
        "identity": {
          "graphId": "workspace-connections-declaration",
          "nodeId": "workspace-connections-d-facing"
        },
        "classRef": "tlz://twilite.zone/library/classes/nodes/task-planning/decision.node-class.node",
        "status": "proposed",
        "owner": "Owner",
        "rationale": "Only the handles that have no port behind them: a link's far end, a link's near end when its holder node is not shown, and a portal's open end. They sit at the middle of the side that faces the other graph, and the edge leaves square to it. Handles that belong to a port node stay where they are, and the kinds keep their own looks.",
        "body": "",
        "sizing": {
          "fit": "content",
          "maxHeight": 360
        }
      }
