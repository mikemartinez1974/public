gle":270},{"id":"right","label":"right","direction":"bidirectional","dataType":"value","angle":0},{"id":"bottom","label":"bottom","direction":"bidirectional","dataType":"value","angle":90},{"id":"left","label":"left","direction":"bidirectional","dataType":"value","angle":180}],"data":{"identity":{"graphId":"methods-invocation-contract-task"},"scriptName":"Methods Invocation Summary Updater","summaryNodeId":"methods-invocation-contract-summary","autoRun":true,"autoRunOnGraphChange":false,"autoRunOnLoad":true,"allowMutations":true,"dryRun":false,"source":"const SUMMARY='methods-invocation-contract-summary';const DONE=new Set(['done','complete','completed','closed']);const ANSWERED=new Set(['answered','resolved','done','closed']);const norm=v=>String(v||'').trim().toLowerCase();const nodes=await api.getNodes();const summary=nodes.find(n=>n.id===SUMMARY);const goal=nodes.find(n=>n.type==='goal');const tasks=nodes.filter(n=>n.type==='task').sort((a,b)=>(a.position?.y??0)-(b.position?.y??0)||(a.position?.x??0)-(b.position?.x??0));const questions=nodes.filter(n=>n.type==='open-question').sort((a,b)=>(a.position?.y??0)-(b.position?.y??0)||(a.position?.x??0)-(b.position?.x??0));if(!summary)return{success:false,error:'Summary node missing'};const completed=tasks.filter(n=>DONE.has(norm(n.data?.status))).length;const answered=questions.filter(n=>ANSWERED.has(norm(n.data?.status))).length;const next={...(summary.data||{}),goal:goal?.label||summary.data?.goal||'Task graph',title:goal?.label||summary.data?.goal||'Task graph',body:'Goal: '+(goal?.label||summary.data?.goal||'Task graph')+'\\nStatus: '+(norm(goal?.data?.status)||'todo')+'\\n\\nTasks in scope:\\n'+tasks.map((n,i)=>(i+1)+'. '+(n.data?.title||n.label)).join('\\n')+'\\n\\nOpen questions:\\n'+questions.map((n,i)=>(i+1)+'. '+n.label).join('\\n'),status:norm(goal?.data?.status)||'todo',priority:goal?.data?.priority||summary.data?.priority||'medium',owner:goal?.data?.owner||summary.data?.owner||'',taskProgress:{completed,to