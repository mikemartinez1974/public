ns and workboards.","exposes":{"views":{"mode":"allow"},"declarations":{"mode":"allow"}}}],"notes":["A Method declaration names a callable capability; each invocation is an attempt, not proof of effects.","Provider and receiver are distinct; declared effects bound authority, observed effects describe outcomes.","A bounded first runtime slice is planned; execution language, persistence, retries, and Events remain open."]},"dependencies":{"nodeTypes":["declaration","port","summary","goal","task","decision","open-question","risk","acceptance-criteria","bridge","script"],"portContracts":["core"],"skills":["twilite-planning-graphs"],"schemaVersions":{"nodes":">=1.0.0","ports":">=1.0.0"},"optional":[]},"authority":{"mutation":{"allowCreate":true,"allowUpdate":true,"allowDelete":true,"appendOnly":false},"actors":{"humans":true,"agents":true,"tools":true},"styleAuthority":"descriptive","history":{"rewriteAllowed":false,"squashAllowed":false}},"settings":{"defaultNodeColor":"#2563eb","defaultEdgeColor":"#64748b","snapToGrid":false,"gridSize":20,"edgeRouting":"auto"},"document":{"url":"github://mikemartinez1974/public/tasks/methods-invocation-contract/root.node"}}},{"id":"methods-invocation-contract-root-port","type":"port","label":"Methods Implementation","position":{"x":250,"y":-920},"width":460,"height":300,"visible":false,"showLabel":true,"ports":[{"id":"root","label":"root","direction":"bidirectional","dataType":"any","angle":210},{"id":"top","label":"top","direction":"bidirectional","dataType":"value","angle":270},{"id":"right","label":"right","direction":"bidirectional","dataType":"value","angle":0},{"id":"bottom","label":"bottom","direction":"bidirectional","dataType":"value","angle":90},{"id":"left","label":"left","direction":"bidirectional","dataType":"value","angle":180}],"data":{"identity":{"graphId":"methods-invocation-contract-task","portId":"root","name":"Methods Implementation"},"sourceNodeId":"methods-invocation-contract-summary","sourcePayload":"node.web","t