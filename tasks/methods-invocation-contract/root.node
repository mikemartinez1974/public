viewNodeId":"methods-invocation-contract-summary"},"summary":{"mode":"own","viewNodeId":"methods-invocation-contract-summary"},"icon":{"mode":"own","viewNodeId":"methods-invocation-contract-summary"},"glyph":{"mode":"own","viewNodeId":"methods-invocation-contract-summary"}}}},{"id":"methods-invocation-contract-summary","type":"summary","label":"Methods: Invocation Contract and First Runtime Slice","position":{"x":250,"y":-730},"width":520,"height":360,"visible":true,"showLabel":true,"ports":[{"id":"root","label":"root","direction":"bidirectional","dataType":"any","angle":210},{"id":"top","label":"top","direction":"bidirectional","dataType":"value","angle":270},{"id":"right","label":"right","direction":"bidirectional","dataType":"value","angle":0},{"id":"bottom","label":"bottom","direction":"bidirectional","dataType":"value","angle":90},{"id":"left","label":"left","direction":"bidirectional","dataType":"value","angle":180}],"data":{"_classBinding":{"key":"task","ref":"github://twilite-zone/public/library/classes/nodes/task-planning/task.node-class.node","sourceRef":"github://twilite-zone/public/library/classes/nodes/task-planning/task.node-class.node"},"definitionKey":"task","identity":{"graphId":"methods-invocation-contract-task"},"goal":"Make Method invocations explicit, authorized, traceable, and outcome-aware","status":"todo","priority":"high","owner":"Michael","health":"on-track","nextAction":"Review the revised Method invocation and effect contract, then implement the bounded Method class and runtime slice.","blockedReason":"","taskProgress":{"completed":0,"total":8},"questionProgress":{"answered":0,"total":3},"taskTitles":["Revise the Methods topic contract","Author the Method node class and template","Define invocation identity and context","Declare effects and check authority","Implement invocation lifecycle and outcomes","Add a bounded execution adapter","Expose invocation inspection and traces","Smoke-test request, outcome, and effect cases"],"questionTitles":["What executes a Method implementation?","When does an invocation become a persisted node?","What are retry, cancellation, and event policies?"],"taskListText":"1. Revise the Methods topic contract\n2. Author the Method node class and template\n3. Define invocation identity and context\n4. Declare effects and check authority\n5. Implement invocation lifecycle and outcomes\n6. Add a bounded execution adapter\n7. Expose invocation inspection and traces\n8. Smoke-test request, outcome, and effect cases","questionListText":"1. What executes a Method implementation?\n2. When does an invocation become a persisted node?\n3. What are retry, cancellation, and event policies?","summarySource":"node-updater","updatedAt":"2026-09-18T21:34:00.492Z","title":"Make Method invocations explicit, authorized, traceable, and outcome-aware","body":"Goal: Make Method invocations explicit, authorized, traceable, and outcome-aware\nStatus: todo\n\nTasks in scope:\n1. Revise the Methods topic contract\n2. Author the Method node class and template\n3. Define invocation identity and context\n4. Declare effects and check authority\n5. Implement invocation lifecycle and outcomes\n6. Add a bounded execution adapter\n7. Expose invocation inspection and traces\n8. Smoke-test request, outcome, and effect cases\n\nOpen questions:\n1. What executes a Method implementation?\n2. When does an invocation become a persisted node?\n3. What are retry, cancellation, and event policies?","acceptanceCriteria":["Review the graph-owned task summary for current scope and progress"],"presentation":{"glyph":{"kind":"icon","name":"Checklist"}}}},{"id":"methods-invocation-contract-goal","type":"goal","label":"Make Method invocations explicit, authorized, traceable, and outcome-aware","position":{"x":250,"y":-250},"width":520,"height":280,"visible":true,"showLabel":true,"ports":[{"id":"root","label":"root","direction":"bidirectional","dataType":"any","angle":210},{"id":"top","label":"top","direction":"bidirectional","dataType":"value","angle":270},{"id":"right","label":"right","direction":"bidirectional","dataType":"value","angle":0},{"id":"bottom","label":"bottom","direction":"bidirectional","dataType":"value","angle":90},{"id":"left","label":"left","direction":"bidirectional","dataType":"value","angle":180}],"data":{"_classBinding":{"key":"goal","ref":"github://twilite-zone/public/library/classes/nodes/task-planning/goal.node-class.node","sourceRef":"github://twilite-zone/public/library/classes/nodes/task-planning/goal.node-class.node"},"definitionKey":"goal","identity":{"graphId":"methods-invocation-contract-task"},"body":"Define and implement a first Method slice in which a caller requests a specific invocation against a receiver, authority is checked against declared effects, and a traceable outcome records result/error and actual effects. Keep the executor mechanism and invocation persistence policy open.","owner":"Michael","priority":"high","status":"todo","successMetrics":["Method, provider, receiver, invocation, and outcome are distinct.","Authority checks declared effects before execution; observed effects are recorded separately.","Immediate and pending outcomes use one lifecycle."]}},{"id":"methods-invocation-contract-decision-explicit-ref","type":"decision","label":"Provider and receiver are distinct","position":{"x":-380,"y":-250},"width":500,"height":250,"visible":true,"showLabel":true,"ports":[{"id":"root","label":"root","direction":"bidirectional","dataType":"any","angle":210},{"id":"top","label":"top","direction":"bidirectional","dataType":"value","angle":270},{"id":"right","label":"right","direction":"bidirectional","dataType":"value","angle":0},{"id":"bottom","label":"bottom","direction":"bidirectional","dataType":"value","angle":90},{"id":"left","label":"left","direction":"bidirectional","dataType":"value","angle":180}],"data":{"_classBinding":{"key":"decision","ref":"github://twilite-zone/public/library/classes/nodes/task-planning/decision.node-class.node","sourceRef":"github://twilite-zone/public/library/classes/nodes/task-planning/decision.node-class.node"},"definitionKey":"decision","identity":{"graphId":"methods-invocation-contract-task"},"status":"decided","owner":"Michael","decidedAt":"2026-09-18","rationale":"Class/template layers may provide a Method while a particular invocation operates on another node or graph.","body":"The provider declares or supplies the Method; the receiver is the target of this invocation. They are separate identities even when equal."}},{"id":"methods-invocation-contract-decision-context-only","type":"decision","label":"Invocation request is distinct from outcome","position":{"x":880,"y":-250},"width":500,"height":250,"visible":true,"showLabel":true,"ports":[{"id":"root","label":"root","direction":"bidirectional","dataType":"any","angle":210},{"id":"top","label":"top","direction":"bidirectional","dataType":"value","angle":270},{"id":"right","label":"right","direction":"bidirectional","dataType":"value","angle":0},{"id":"bottom","label":"bottom","direction":"bidirectional","dataType":"value","angle":90},{"id":"left","label":"left","direction":"bidirectional","dataType":"value","angle":180}],"data":{"_classBinding":{"key":"decision","ref":"github://twilite-zone/public/library/classes/nodes/task-planning/decision.node-class.node","sourceRef":"github://twilite-zone/public/library/classes/nodes/task-planning/decision.node-class.node"},"definitionKey":"decision","identity":{"graphId":"methods-invocation-contract-task"},"status":"decided","owner":"Michael","decidedAt":"2026-09-18","rationale":"A call may be denied, fail, succeed without mutation, or produce multiple effects.","body":"An invocation request is an action. Authorization, actual effects, result, and final outcome are separate facts."}},{"id":"methods-invocation-contract-risk-injection","type":"risk","label":"Declared effects can diverge from actual effects","position":{"x":-380,"y":80},"width":500,"height":260,"visible":true,"showLabel":true,"ports":[{"id":"root","label":"root","direction":"bidirectional","dataType":"any","angle":210},{"id":"top","label":"top","direction":"bidirectional","dataType":"value","angle":270},{"id":"right","label":"right","direction":"bidirectional","dataType":"value","angle":0},{"id":"bottom","label":"bottom","direction":"bidirectional","dataType":"value","angle":90},{"id":"left","label":"left","direction":"bidirectional","dataType":"value","angle":180}],"data":{"_classBinding":{"key":"risk","ref":"github://twilite-zone/public/library/classes/nodes/task-planning/risk.node-class.node","sourceRef":"github://twilite-zone/public/library/classes/nodes/task-planning/risk.node-class.node"},"definitionKey":"risk","identity":{"graphId":"methods-invocation-contract-task"},"status":"open","owner":"Michael","severity":"high","likelihood":"medium","body":"A Method may declare a narrow effect set while its implementation causes broader changes, making authority and traces misleading.","mitigation":"Dispatch through an effect-aware adapter, reject or flag undeclared effects, and record observed effects separately from declarations."}},{"id":"methods-invocation-contract-acceptance","type":"acceptance-criteria","label":"Method calls report outcomes and effects truthfully","position":{"x":880,"y":80},"width":500,"height":290,"visible":true,"showLabel":true,"ports":[{"id":"root","label":"root","direction":"bidirectional","dataType":"any","angle":210},{"id":"top","label":"top","direction":"bidirectional","dataType":"value","angle":270},{"id":"right","label":"right","direction":"bidirectional","dataType":"value","angle":0},{"id":"bottom","label":"bottom","direction":"bidirectional","dataType":"value","angle":90},{"id":"left","label":"left","direction":"bidirectional","dataType":"value","angle":180}],"data":{"_classBinding":{"key":"acceptance-criteria","ref":"github://twilite-zone/public/library/classes/nodes/task-planning/acceptance-criteria.node-class.node","sourceRef":"github://twilite-zone/public/library/classes/nodes/task-planning/acceptance-criteria.node-class.node"},"definitionKey":"acceptance-criteria","identity":{"graphId":"methods-invocation-contract-task"},"status":"open","owner":"Michael","criteria":["Each invocation has an ID, caller, provider, receiver, arguments, authority context, and traceable outcome.","Declared effects are checked before dispatch; observed effects are recorded after execution.","Denied, failed, cancelled, pending, no-mutation success, and multi-effect success are distinguishable.","Implementation language, sandbox, retry policy, and persistence are not accidentally fixed by the first slice."]}},{"id":"methods-invocation-contract-task-contract","type":"task","label":"Revise the Methods topic contract","position":{"x":-380,"y":470},"width":460,"height":250,"visible":true,"showLabel":true,"ports":[{"id":"root","label":"root","direction":"bidirectional","dataType":"any","angle":210},{"id":"top","label":"top","direction":"bidirectional","dataType":"value","angle":270},{"id":"right","label":"right","direction":"bidirectional","dataType":"value","angle":0},{"id":"bottom","label":"bottom","direction":"bidirectional","dataType":"value","angle":90},{"id":"left","label":"left","direction":"bidirectional","dataType":"value","angle":180}],"data":{"_classBinding":{"key":"task","ref":"github://twilite-zone/public/library/classes/nodes/task-planning/task.node-class.node","sourceRef":"github://twilite-zone/public/library/classes/nodes/task-planning/task.node-class.node"},"definitionKey":"task","identity":{"graphId":"methods-invocation-contract-task"},"title":"Revise the Methods topic contract","body":"Update the Methods topic graph with Invocation, Invocation Context, Outcome, Declared Effects, and provider versus receiver. Preserve the request/outcome distinction and list deferred engine choices explicitly.","status":"todo","priority":"high","owner":"Michael","acceptanceCriteria":["Topic graph states the revised contract without pretending an execution engine exists."],"estimateHours":""}},{"id":"methods-invocation-contract-task-discovery","type":"task","label":"Author the Method node class and template","position":{"x":130,"y":470},"width":460,"height":250,"visible":true,"showLabel":true,"ports":[{"id":"root","label":"root","direction":"bidirectional","dataType":"any","angle":210},{"id":"top","label":"top","direction":"bidirectional","dataType":"value","angle":270},{"id":"right","label":"right","direction":"bidirectional","dataType":"value","angle":0},{"id":"bottom","label":"bottom","direction":"bidirectional","dataType":"value","angle":90},{"id":"left","label":"left","direction":"bidirectional","dataType":"value","angle":180}],"data":{"_classBinding":{"key":"task","ref":"github://twilite-zone/public/library/classes/nodes/task-planning/task.node-class.node","sourceRef":"github://twilite-zone/public/library/classes/nodes/task-planning/task.node-class.node"},"definitionKey":"task","identity":{"graphId":"methods-invocation-contract-task"},"title":"Author the Method node class and template","body":"Create a graph-native Method class and reusable template with signature, provider, receiver constraints, declared effects, authority, implementation reference, and inspectable views.","status":"todo","priority":"medium","owner":"Michael","acceptanceCriteria":["Class graph validates; a Method instance can be created through an import bridge."],"estimateHours":""}},{"id":"methods-invocation-contract-task-trust","type":"task","label":"Define invocation identity and context","position":{"x":640,"y":470},"width":460,"height":250,"visible":true,"showLabel":true,"ports":[{"id":"root","label":"root","direction":"bidirectional","dataType":"any","angle":210},{"id":"top","label":"top","direction":"bidirectional","dataType":"value","angle":270},{"id":"right","label":"right","direction":"bidirectional","dataType":"value","angle":0},{"id":"bottom","label":"bottom","direction":"bidirectional","dataType":"value","angle":90},{"id":"left","label":"left","direction":"bidirectional","dataType":"value","angle":180}],"data":{"_classBinding":{"key":"task","ref":"github://twilite-zone/public/library/classes/nodes/task-planning/task.node-class.node","sourceRef":"github://twilite-zone/public/library/classes/nodes/task-planning/task.node-class.node"},"definitionKey":"task","identity":{"graphId":"methods-invocation-contract-task"},"title":"Define invocation identity and context","body":"Create a runtime invocation record with stable ID, Method ref, provider, caller/actor, receiver, arguments, authority context, graph/workspace context, timing, and provenance. Keep persistence optional in this first slice.","status":"todo","priority":"high","owner":"Michael","acceptanceCriteria":["A call is individually identifiable and provider may differ from receiver."],"estimateHours":""}},{"id":"methods-invocation-contract-task-context","type":"task","label":"Declare effects and check authority","position":{"x":1150,"y":470},"width":460,"height":250,"visible":true,"showLabel":true,"ports":[{"id":"root","label":"root","direction":"bidirectional","dataType":"any","angle":210},{"id":"top","label":"top","direction":"bidirectional","dataType":"value","angle":270},{"id":"right","label":"right","direction":"bidirectional","dataType":"value","angle":0},{"id":"bottom","label":"bottom","direction":"bidirectional","dataType":"value","angle":90},{"id":"left","label":"left","direction":"bidirectional","dataType":"value","angle":180}],"data":{"_classBinding":{"key":"task","ref":"github://twilite-zone/public/library/classes/nodes/task-planning/task.node-class.node","sourceRef":"github://twilite-zone/public/library/classes/nodes/task-planning/task.node-class.node"},"definitionKey":"task","identity":{"graphId":"methods-invocation-contract-task"},"title":"Declare effects and check authority","body":"Define a bounded vocabulary of potential effects, such as create node, write Property, and external request. Check authority against declared effects before dispatch; capture actual effects separately.","status":"todo","priority":"high","owner":"Michael","acceptanceCriteria":["Undeclared or unauthorized effects are denied or reported, never silently attributed to the Method declaration."],"estimateHours":""}},{"id":"methods-invocation-contract-task-ui","type":"task","label":"Implement invocation lifecycle and outcomes","position":{"x":1150,"y":820},"width":460,"height":250,"visible":true,"showLabel":true,"ports":[{"id":"root","label":"root","direction":"bidirectional","dataType":"any","angle":210},{"id":"top","label":"top","direction":"bidirectional","dataType":"value","angle":270},{"id":"right","label":"right","direction":"bidirectional","dataType":"value","angle":0},{"id":"bottom","label":"bottom","direction":"bidirectional","dataType":"value","angle":90},{"id":"left","label":"left","direction":"bidirectional","dataType":"value","angle":180}],"data":{"_classBinding":{"key":"task","ref":"github://twilite-zone/public/library/classes/nodes/task-planning/task.node-class.node","sourceRef":"github://twilite-zone/public/library/classes/nodes/task-planning/task.node-class.node"},"definitionKey":"task","identity":{"graphId":"methods-invocation-contract-task"},"title":"Implement invocation lifecycle and outcomes","body":"Model requested, authorized, running, succeeded, failed, denied, and cancelled outcomes; allow immediate or pending completion and progress while running. Keep result/error separate from effect records.","status":"todo","priority":"high","owner":"Michael","acceptanceCriteria":["Denied, failed, cancelled, no-mutation success, and multi-effect success are distinguishable."],"estimateHours":""}},{"id":"methods-invocation-contract-task-cache","type":"task","label":"Add a bounded execution adapter","position":{"x":640,"y":820},"width":460,"height":250,"visible":true,"showLabel":true,"ports":[{"id":"root","label":"root","direction":"bidirectional","dataType":"any","angle":210},{"id":"top","label":"top","direction":"bidirectional","dataType":"value","angle":270},{"id":"right","label":"right","direction":"bidirectional","dataType":"value","angle":0},{"id":"bottom","label":"bottom","direction":"bidirectional","dataType":"value","angle":90},{"id":"left","label":"left","direction":"bidirectional","dataType":"value","angle":180}],"data":{"_classBinding":{"key":"task","ref":"github://twilite-zone/public/library/classes/nodes/task-planning/task.node-class.node","sourceRef":"github://twilite-zone/public/library/classes/nodes/task-planning/task.node-class.node"},"definitionKey":"task","identity":{"graphId":"methods-invocation-contract-task"},"title":"Add a bounded execution adapter","body":"Introduce an executor boundary that accepts the Method definition and invocation context and returns an outcome. Implement only a bounded local smoke adapter; leave general language, sandbox, async scheduling, and retries open.","status":"todo","priority":"medium","owner":"Michael","acceptanceCriteria":["The adapter demonstrates the contract without exposing arbitrary script execution."],"estimateHours":""}},{"id":"methods-invocation-contract-task-authority-test","type":"task","label":"Expose invocation inspection and traces","position":{"x":130,"y":820},"width":460,"height":250,"visible":true,"showLabel":true,"ports":[{"id":"root","label":"root","direction":"bidirectional","dataType":"any","angle":210},{"id":"top","label":"top","direction":"bidirectional","dataType":"value","angle":270},{"id":"right","label":"right","direction":"bidirectional","dataType":"value","angle":0},{"id":"bottom","label":"bottom","direction":"bidirectional","dataType":"value","angle":90},{"id":"left","label":"left","direction":"bidirectional","dataType":"value","angle":180}],"data":{"_classBinding":{"key":"task","ref":"github://twilite-zone/public/library/classes/nodes/task-planning/task.node-class.node","sourceRef":"github://twilite-zone/public/library/classes/nodes/task-planning/