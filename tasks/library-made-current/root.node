    {
      "id": "library-made-current-landing",
      "type": "content",
      "label": "The library, made current",
      "position": {
        "x": 560,
        "y": -420
      },
      "width": 633.5114535153646,
      "height": 270.2697209374306,
      "ports": [
        {
          "id": "root",
          "key": "root",
          "label": "root",
          "direction": "bidirectional",
          "dataType": "any",
          "angle": 270
        }
      ],
      "handles": [
        {
          "id": "root",
          "key": "root",
          "label": "root",
          "direction": "bidirectional",
          "dataType": "any",
