      "data": {
        "body": "Create templates/stroke-control with color, width, opacity, dash and enabled as Properties, a swatch in its exposed views, and one class-scoped Handler calling one Method that re-renders the swatch. Follow the pattern the Edge Class template already proved. Do not connect it to the Edge Class template yet; that is github://mikemartinez1974/public/tasks/edge-class-consumes-stroke-control/root.node.",
        "priority": "high",
        "status": "open",
        "owner": "Michael",
        "targetDate": "",
        "successMetrics": [
          "Editing any of the five Properties updates the swatch in the app",
          "The Method declares exactly the views it writes as its effects",
          "The Method's output matches an independent render of the same values",
          "Nothing in the graph needs the app to derive its views"
        ],
        "definitionKey": "goal",
