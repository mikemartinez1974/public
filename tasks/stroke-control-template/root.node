        "view": {
          "intent": "node",
          "payload": "node.web.detail"
        },
        "semanticLevel": "detail",
        "content": {
          "kind": "markdown",
          "value": "# Build the Stroke Control Graph\n\nCreate templates/stroke-control with color, width, opacity, dash and enabled as Properties, a swatch in its exposed views, and one class-scoped Handler calling one Method that re-renders the swatch. Follow the pattern the Edge Class template already proved. Do not connect it to the Edge Class template yet; that is github://mikemartinez1974/public/tasks/edge-class-consumes-stroke-control/root.node."
        },
        "interfaceContract": {
          "version": 1,
          "ownsContent": true,
          "surfaceDelegation": true
        },
        "identity": {
          "graphId": "stroke-control-template"
        }
      }
