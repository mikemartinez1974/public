      "data": {
        "body": "Turn the workspace bar's graph capture and connection gestures into explicit, reviewable contracts that preserve user work and can be proven in the browser.",
        "priority": "high",
        "status": "todo",
        "owner": "Michael",
        "targetDate": "",
        "successMetrics": [
          "Save selection preserves the original workspace until the destination save succeeds or the user cancels.",
          "Dirty graphs and save failures produce explicit recovery behavior.",
          "Workspace-owned connection edges survive save and reload with their intended ownership.",
          "Pointer drags prove valid, invalid, read-only, and ambiguous connection outcomes."
        ],
