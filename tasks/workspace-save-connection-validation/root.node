      "visible": true,
      "showLabel": true,
      "data": {
        "title": "Draft #1: Define the Save selection transaction contract",
        "body": "Write the first reviewable contract for Save selection as graph: capture selected ready projections and internal workspace edges, leave the current workspace intact by default, handle cancel and save failure without losing the prior arrangement, and make opening the captured graph an explicit Save and open as graph action.",
        "priority": "high",
        "status": "todo",
        "owner": "Michael",
        "estimateHours": "2",
        "acceptanceCriteria": [
          "The draft names the capture boundary and the graph-owned versus workspace-owned edge data.",
          "A successful Save selection as graph leaves the current workspace, selection, focus, camera, and dirty state intact.",
          "Canceling the save dialog leaves the original workspace unchanged.",
          "A failed save leaves the original workspace active and exposes retry or discard explicitly.",
          "Save and open as graph focuses the captured graph only after successful persistence.",
          "Dirty selected and unselected child graphs have explicit, tested behavior.",
          "The browser smoke plan covers success, cancel, failure, explicit open, and reload."
        ],
        "identity": {
          "graphId": "workspace-save-connection-validation"
        },
        "targetDate": "",
        "startedAt": "",
        "completedAt": "",
        "externalRef": "github://mikemartinez1974/public/tasks/workspace-save-connection-validation/draft-1/root.node",
        "presentation": {
          "glyph": {
            "kind": "icon",
            "name": "Checklist"
          }
        },
        "classRef": "github://twilite-zone/public/library/classes/nodes/task-planning/task.node-class.node"
      }
    },
