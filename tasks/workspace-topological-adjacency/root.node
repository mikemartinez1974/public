    {
      "id": "plan-root",
      "type": "content",
      "label": "Workspace Topological Adjacency Plan",
      "root": true,
      "position": {"x": -850, "y": 0},
      "width": 520,
      "height": 320,
      "ports": [
        {"id": "root", "key": "root", "label": "root", "direction": "bidirectional", "dataType": "any", "angle": 180},
        {"id": "next", "key": "next", "label": "goal", "direction": "output", "dataType": "navigation", "angle": 0}
      ],
      "handles": [
        {"id": "root", "portId": "root", "label": "root", "direction": "bidirectional", "dataType": "any", "angle": 180, "position": {"side": "left", "offset": 0.5}},
        {"id": "next", "portId": "next", "label": "goal", "direction": "output", "dataType": "navigation", "angle": 0, "position": {"side": "right", "offset": 0.5}}
      ],
      "visible": true,
      "showLabel": true,
      "data": {"content": {"kind": "markdown", "value": "# Workspace Topological Adjacency\n\n## Core invariant\n\n**Bridges dictate adjacency. Graph position does not.**\n\nA graph can move anywhere in the workspace without breaking its authored bridge relationships. The workspace should recompute graph regions, shared boundaries, and apertures around the new embedding.\n\nThis plan deliberately separates semantic topology from derived workspace geometry."}}
    },
    {
      "id": "goal-topology",
      "type": "goal",
      "label": "Goal: topology survives movement",
      "root": false,
      "position": {"x": -180, "y": 0},
      "width": 470,
      "height": 250,
      "ports": [
        {"id": "root", "key": "root", "label": "root", "direction": "input", "dataType": "navigation", "angle": 180},
        {"id": "next", "key": "next", "label": "architecture", "direction": "output", "dataType": "navigation", "angle": 0}
      ],
      "handles": [
        {"id": "root", "portId": "root", "label": "root", "direction": "input", "dataType": "navigation", "angle": 180, "position": {"side": "left", "offset": 0.5}},
        {"id": "next", "portId": "next", "label": "architecture", "direction": "output", "dataType": "navigation", "angle": 0, "position": {"side": "right", "offset": 0.5}}
      ],
      "visible": true,
      "showLabel": true,
      "data": {"title": "Topology survives movement", "status": "proposed", "description": "Dragging or resizing a graph changes only the workspace embedding. Authored bridge adjacency remains authoritative and graph documents remain clean."}
    },
    {
      "id": "decision-three-layers",
      "type": "decision",
      "label": "Decision: separate three layers",
      "root": false,
      "position": {"x": 430, "y": 0},
      "width": 500,
      "height": 290,
      "ports": [
        {"id": "root", "key": "root", "label": "root", "direction": "input", "dataType": "navigation", "angle": 180},
        {"id": "next", "key": "next", "label": "tasks", "direction": "output", "dataType": "navigation", "angle": 0}
      ],
      "handles": [
        {"id": "root", "portId": "root", "label": "root", "direction": "input", "dataType": "navigation", "angle": 180, "position": {"side": "left", "offset": 0.5}},
        {"id": "next", "portId": "next", "label": "tasks", "direction": "output", "dataType": "navigation", "angle": 0, "position": {"side": "right", "offset": 0.5}}
      ],
      "visible": true,
      "showLabel": true,
      "data": {"title": "Separate semantic topology, derived workspace topology, and geometry", "status": "proposed", "rationale": "Bridge nodes should express adjacency only. Workspace topology derives shared-region relationships. Geometry derives concrete paths, apertures, and minimap shapes from the current embedding."}
    },
    {
      "id": "task-audit-current-geometry",
      "type": "task",
      "label": "Audit current frame geometry",
      "root": false,
      "position": {"x": 1080, "y": -180},
      "width": 430,
      "height": 220,
      "ports": [{"id": "root", "key": "root", "label": "root", "direction": "input", "dataType": "navigation", "angle": 180}],
      "handles": [{"id": "root", "portId": "root", "label": "root", "direction": "input", "dataType": "navigation", "angle": 180, "position": {"side": "left", "offset": 0.5}}],
      "visible": true,
      "showLabel": true,
      "data": {"status": "todo", "description": "Trace where rectangular workspace graph frames, drag state, resize state, hit testing, focus, and minimap bounds are currently calculated. Identify which assumptions require rectangular regions."}
    },
    {
      "id": "task-region-model",
      "type": "task",
      "label": "Define derived region model",
      "root": false,
      "position": {"x": 1080, "y": 90},
      "width": 430,
      "height": 230,
      "ports": [{"id": "root", "key": "root", "label": "root", "direction": "input", "dataType": "navigation", "angle": 180}],
      "handles": [{"id": "root", "portId": "root", "label": "root", "direction": "input", "dataType": "navigation", "angle": 180, "position": {"side": "left", "offset": 0.5}}],
      "visible": true,
      "showLabel": true,
      "data": {"status": "todo", "description": "Define a workspace-only region representation around graph content extents. Regions may be non-rectangular and must expose shared-boundary information without mutating graph documents."}
    },
    {
      "id": "task-adjacency-resolver",
      "type": "task",
      "label": "Resolve bridge adjacency",
      "root": false,
      "position": {"x": 1570, "y": -180},
      "width": 430,
      "height": 230,
      "ports": [{"id": "root", "key": "root", "label": "root", "direction": "input", "dataType": "navigation", "angle": 180}],
      "handles": [{"id": "root", "portId": "root", "label": "root", "direction": "input", "dataType": "navigation", "angle": 180, "position": {"side": "left", "offset": 0.5}}],
      "visible": true,
      "showLabel": true,
      "data": {"status": "todo", "description": "Convert authored bridge relationships into workspace adjacency constraints. A bridge must not encode a permanent left/right/top/bottom side."}
    },
    {
      "id": "task-shared-boundary",
      "type": "task",
      "label": "Derive shared boundaries and apertures",
      "root": false,
      "position": {"x": 1570, "y": 90},
      "width": 430,
      "height": 240,
      "ports": [{"id": "root", "key": "root", "label": "root", "direction": "input", "dataType": "navigation", "angle": 180}],
      "handles": [{"id": "root", "portId": "root", "label": "root", "direction": "input", "dataType": "navigation", "angle": 180, "position": {"side": "left", "offset": 0.5}}],
      "visible": true,
      "showLabel": true,
      "data": {"status": "todo", "description": "When bridged regions are adjacent, derive their common boundary and place the bridge aperture on that boundary. Remove corridor rails once the shared-boundary model is authoritative."}
    },
    {
      "id": "task-drag-reembed",
      "type": "task",
      "label": "Re-embed on graph movement",
      "root": false,
      "position": {"x": 2060, "y": -180},
      "width": 430,
      "height": 230,
      "ports": [{"id": "root", "key": "root", "label": "root", "direction": "input", "dataType": "navigation", "angle": 180}],
      "handles": [{"id": "root", "portId": "root", "label": "root", "direction": "input", "dataType": "navigation", "angle": 180, "position": {"side": "left", "offset": 0.5}}],
      "visible": true,
      "showLabel": true,
      "data": {"status": "todo", "description": "Dragging a graph changes the 2D embedding and causes region geometry to recompute while preserving bridge topology, graph-local node coordinates, and clean document state."}
    },
    {
      "id": "task-minimap",
      "type": "task",
      "label": "Update workspace minimap",
      "root": false,
      "position": {"x": 2060, "y": 90},
      "width": 430,
      "height": 220,
      "ports": [{"id": "root", "key": "root", "label": "root", "direction": "input", "dataType": "navigation", "angle": 180}],
      "handles": [{"id": "root", "portId": "root", "label": "root", "direction": "input", "dataType": "navigation", "angle": 180, "position": {"side": "left", "offset": 0.5}}],
      "visible": true,
      "showLabel": true,
      "data": {"status": "todo", "description": "Render the same derived workspace regions and shared apertures in workspace-scope minimap view. Do not maintain a second independent adjacency geometry model."}
    },
    {
      "id": "question-region-algorithm",
      "type": "open-question",
      "label": "Question: how amorphous should regions be?",
      "root": false,
      "position": {"x": 2550, "y": -210},
      "width": 470,
      "height": 250,
      "ports": [{"id": "root", "key": "root", "label": "root", "direction": "input", "dataType": "navigation", "angle": 180}],
      "handles": [{"id": "root", "portId": "root", "label": "root", "direction": "input", "dataType": "navigation", "angle": 180, "position": {"side": "left", "offset": 0.5}}],
      "visible": true,
      "showLabel": true,
      "data": {"status": "open", "question": "What is the simplest region algorithm that can preserve adjacency and adapt around graph extents without turning the workspace into unstable blob geometry?", "notes": "Candidates may include rectilinear unions, padded hulls, orthogonal polygons, Voronoi-like partitioning, or a staged approach."}
    },
    {
      "id": "question-conflicts",
      "type": "open-question",
      "label": "Question: conflicting adjacency constraints",
      "root": false,
      "position": {"x": 2550, "y": 80},
      "width": 470,
      "height": 250,
      "ports": [{"id": "root", "key": "root", "label": "root", "direction": "input", "dataType": "navigation", "angle": 180}],
      "handles": [{"id": "root", "portId": "root", "label": "root", "direction": "input", "dataType": "navigation", "angle": 180, "position": {"side": "left", "offset": 0.5}}],
      "visible": true,
      "showLabel": true,
      "data": {"status": "open", "question": "How should the workspace resolve several bridges that cannot all be represented as direct pairwise shared boundaries in the current embedding?", "notes": "Keep this policy outside authored bridge semantics. It belongs in the workspace topology/layout resolver."}
    },
    {
      "id": "question-resize",
      "type": "open-question",
      "label": "Question: graph resize semantics",
      "root": false,
      "position": {"x": 3040, "y": -60},
      "width": 470,
      "height": 250,
      "ports": [{"id": "root", "key": "root", "label": "root", "direction": "input", "dataType": "navigation", "angle": 180}],
      "handles": [{"id": "root", "portId": "root", "label": "root", "direction": "input", "dataType": "navigation", "angle": 180, "position": {"side": "left", "offset": 0.5}}],
      "visible": true,
      "showLabel": true,
      "data": {"status": "open", "question": "If graph frames become derived regions, what does user resize mean?", "notes": "Possible distinction: resize changes a preferred workspace envelope while region boundaries still adapt to topology and content extents."}
    }
