    {"id": "edge-resolver-reembed", "source": "task-resolver", "sourcePort": "root", "sourceHandle": "root", "target": "task-reembed", "targetPort": "root", "targetHandle": "root", "type": "reference"},
    {"id": "edge-boundaries-minimap", "source": "task-boundaries", "sourcePort": "root", "sourceHandle": "root", "target": "task-minimap", "targetPort": "root", "targetHandle": "root", "type": "reference"},
    {"id": "edge-reembed-questions", "source": "task-reembed", "sourcePort": "root", "sourceHandle": "root", "target": "questions", "targetPort": "root", "targetHandle": "root", "type": "reference"},
    {"id": "edge-minimap-questions", "source": "task-minimap", "sourcePort": "root", "sourceHandle": "root", "target": "questions", "targetPort": "root", "targetHandle": "root", "type": "reference"}
  ]
