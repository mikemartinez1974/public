      "position": {"x": 160, "y": -620},
      "width": 380,
      "height": 220,
      "ports": [{"id": "root", "key": "root", "label": "root", "direction": "input", "dataType": "any", "angle": 180}],
      "handles": [{"id": "root", "portId": "root", "label": "root", "direction": "input", "dataType": "any", "angle": 180}],
      "visible": true,
      "showLabel": true,
      "data": {"view": {"payload": "node.web.summary"}, "html": "<div style='height:100%;box-sizing:border-box;padding:20px;border-radius:18px;background:#111827;color:#f8fafc;font-family:system-ui'><strong style='font-size:22px'>Topology first.</strong><p style='color:#cbd5e1;line-height:1.5'>Semantic bridges stay fixed while workspace regions, shared boundaries, and apertures are derived from the current 2D embedding.</p></div>"}
    },
