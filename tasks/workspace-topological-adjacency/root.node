    {
      "id": "plan-detail",
      "type": "view",
      "label": "Topological adjacency detail",
      "root": false,
      "position": {"x": -390, "y": -620},
      "width": 500,
      "height": 270,
      "ports": [{"id": "root", "key": "root", "label": "root", "direction": "input", "dataType": "any", "angle": 180}],
      "handles": [{"id": "root", "portId": "root", "label": "root", "direction": "input", "dataType": "any", "angle": 180}],
      "visible": true,
      "showLabel": true,
      "data": {"view": {"payload": "node.web.detail"}, "html": "<article style='height:100%;box-sizing:border-box;padding:24px;border-radius:22px;background:#111827;color:#f8fafc;font-family:system-ui'><div style='font:800 11px/1 system-ui;color:#67e8f9'>WORKSPACE TOPOLOGY</div><h2 style='margin:14px 0 10px;font-size:30px'>Bridges define adjacency, not position.</h2><p style='margin:0;color:#cbd5e1;font-size:16px;line-height:1.55'>Move a graph anywhere. Its authored bridges remain intact. Workspace regions and apertures adapt around the new embedding.</p></article>"}
    },
    {
