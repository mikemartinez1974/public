    {"id": "edge-decision-region", "source": "decision-three-layers", "sourcePort": "next", "sourceHandle": "next", "target": "task-region", "targetPort": "root", "targetHandle": "root", "type": "navigation"},
    {"id": "edge-audit-resolver", "source": "task-audit", "sourcePort": "root", "sourceHandle": "root", "target": "task-resolver", "targetPort": "root", "targetHandle": "root", "type": "reference"},
