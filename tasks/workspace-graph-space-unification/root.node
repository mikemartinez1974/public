      "visible": true,
      "showLabel": true,
      "data": {
        "title": "Define the shared camera and position contract",
        "body": "Implement the first workspace simplification slice: make instance.offset authoritative in ordinary rendering, document the shared camera and position boundary, and retire render-time presentation placement state without changing insertion or explicit Tidy behavior.\\n\\nStarted in twilite commits 6ad7306a, 815ab930, 7fab9876, ee2e7dc1, 49e95dc7, 0185a556, and 59530269: ordinary layout no longer reflows or overlap-corrects, focus and history preserve authored offsets, camera cache state is removed from the active path, and capability-created graphs preserve their explicit click position.",
        "priority": "critical",
        "status": "in-progress",
        "owner": "Michael",
        "estimateHours": "",
        "acceptanceCriteria": [
          "Workspace rendering reads position from instance.offset and authored/compact frame only.",
          "Ordinary layout does not create or consume _workspacePresentationFrame or _reflowShift.",
          "Insertion placement and explicit Tidy remain the only automatic repositioning paths."
        ],
        "identity": {
          "graphId": "workspace-graph-space-unification"
        },
        "targetDate": "",
        "startedAt": "2026-10-18T20:28:38.047Z",
        "completedAt": "",
        "externalRef": "github://TwiliteLLC/twilite/commit/59530269",
        "presentation": {
