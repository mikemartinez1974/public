      "visible": true,
      "showLabel": true,
      "data": {
        "body": "Make a workspace behave like graph space: each graph instance has one authoritative workspace position, the canvas uses one understandable camera model, and focus, zoom, drag, and creation preserve that position.",
        "priority": "critical",
        "status": "in-progress",
        "owner": "Michael",
        "targetDate": "",
        "successMetrics": [
          "Creating a graph places it at the clicked workspace location and it remains there after render, focus, and return.",
          "Dragging a graph changes only its stored workspace position by the pointer delta.",
          "Zooming, focusing, and semantic presentation never silently reposition existing graph instances.",
          "Automatic repositioning is limited to insertion placement and an explicit Tidy workspace action."
        ],
        "identity": {
          "graphId": "workspace-graph-space-unification"
        },
        "presentation": {
          "glyph": {
            "kind": "icon",
            "name": "Flag"
          }
        },
        "classRef": "github://twilite-zone/public/library/classes/nodes/task-planning/goal.node-class.node"
      }
    },
