      "data": {
        "rationale": "Glyph, icon, summary, detail, and editor views change presentation; a centralized interaction policy governs gestures.",
        "body": "View selection and gesture ownership remain separate contracts.",
        "status": "decided",
        "owner": "Michael",
        "definitionKey": "decision",
