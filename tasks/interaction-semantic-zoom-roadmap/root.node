    {
      "id": "interaction-roadmap-decision-primitives",
      "type": "decision",
      "label": "Canvas-first and content-first are explicit states",
      "root": false,
      "position": {
        "x": -980,
        "y": 180
      },
      "width": 430,
      "height": 280,
      "ports": [
        {
          "id": "top",
          "label": "top",
          "direction": "input",
          "dataType": "value",
          "angle": 270
        }
      ],
      "visible": true,
      "showLabel": true,
      "data": {
        "rationale": "Zoom level and target kind should determine who owns a gesture before any renderer handles it.",
        "body": "Canvas-first surfaces pan and zoom the graph. Content-first surfaces preserve declared controls, scrolling, editing, and navigation.",
        "status": "decided",
        "owner": "Michael",
        "definitionKey": "decision",
        "_classBinding": {
          "key": "decision",
          "sourceRef": "github://twilite-zone/public/library/classes/nodes/task-planning/decision.node-class.node",
