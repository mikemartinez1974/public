        "borderRadius": 24
      },
      "visible": true,
      "showLabel": true,
      "data": {
        "identity": {
          "graphId": "idea-graph-template"
        },
        "markdown": "## 🔗 Relationship Vocabulary\n\nUse meaningful edge labels so the graph reads as a set of statements.\n\n- **motivates**\n- **supports**\n- **contradicts**\n- **depends-on**\n- **answers**\n- **blocks**\n- **implements**\n- **extends**\n- **duplicates**\n- **replaces**\n- **proves**\n- **measures**\n- **relates-to**\n\nExample: **Problem → motivates → Solution**",
        "memo": "",
        "link": "",
        "visibilityRole": "browser",
        "_placement": {
          "version": 1,
          "state": "auto-placed",
          "source": "create",
          "updatedAt": 1785542867665,
          "reason": "node-batch-create"
        }
      }
    },
    {
      "id": "c8120aec-6325-485b-8883-38ba728be8ca",
      "type": "markdown",
      "label": "Idea Lifecycle",
      "root": false,
      "position": {
        "x": -260,
