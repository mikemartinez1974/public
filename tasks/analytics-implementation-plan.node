      "data": {
        "body": "After a graph author opts in with data.analytics, does Twilite also require viewer-level consent, regional consent handling, or a user opt-out before dispatch?",
        "status": "resolved",
        "owner": "review",
        "resolutionPath": "Count opted-in graph views with analytics storage denied by default and all advertising-related consent states denied. Measure aggregate traffic without persistent visitor identifiers; richer stored analytics requires a separate future consent decision.",
