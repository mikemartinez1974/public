      "data": {
        "title": "The first newcomer uses an AI chat every day and wants a shared place to keep their work",
        "identity": {
          "graphId": "first-ten-minutes-declaration",
          "nodeId": "first-ten-minutes-d-newcomer"
        },
        "classRef": "tlz://twilite.zone/library/classes/nodes/task-planning/decision.node-class.node",
        "status": "proposed",
        "owner": "Owner",
        "rationale": "It fits the idea that people who use AI will want to see what the AI is doing, and it gives the list one person to be written for. Marking this decided answers \"Who is the first newcomer?\".",
        "body": "",
        "sizing": {
          "fit": "content",
