        "content": {
          "kind": "svg",
          "value": "<svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 720 440\" role=\"img\" aria-label=\"Methods Through the Bridge\"><rect width=\"720\" height=\"440\" rx=\"20\" fill=\"#0f172a\"/><text x=\"42\" y=\"62\" fill=\"#a78bfa\" font-family=\"system-ui,sans-serif\" font-size=\"14\" font-weight=\"800\">PLAN · DRAFT FOR REVIEW</text><text x=\"42\" y=\"112\" fill=\"#f8fafc\" font-family=\"system-ui,sans-serif\" font-size=\"38\" font-weight=\"700\">Methods Through the Bridge</text><text x=\"42\" y=\"148\" fill=\"#cbd5e1\" font-family=\"system-ui,sans-serif\" font-size=\"17\" font-weight=\"400\">A page should run its template's Method through the Bridge it</text><text x=\"42\" y=\"172\" fill=\"#cbd5e1\" font-family=\"system-ui,sans-serif\" font-size=\"17\" font-weight=\"400\">already has, and not carry a copy of it.</text><rect x=\"40\" y=\"230\" width=\"110\" height=\"36\" rx=\"10\" fill=\"#1e293b\" stroke=\"#64748b\" stroke-width=\"2\"/><rect x=\"106\" y=\"241\" width=\"34\" height=\"14\" rx=\"4\" fill=\"#94a3b8\"/><rect x=\"40\" y=\"276\" width=\"110\" height=\"36\" rx=\"10\" fill=\"#1e293b\" stroke=\"#64748b\" stroke-width=\"2\"/><rect x=\"106\" y=\"287\" width=\"34\" height=\"14\" rx=\"4\" fill=\"#94a3b8\"/><rect x=\"40\" y=\"322\" width=\"110\" height=\"36\" rx=\"10\" fill=\"#1e293b\" stroke=\"#64748b\" stroke-width=\"2\"/><rect x=\"106\" y=\"333\" width=\"34\" height=\"14\" rx=\"4\" fill=\"#94a3b8\"/><rect x=\"190\" y=\"256\" width=\"100\" height=\"84\" rx=\"10\" fill=\"#1e293b\" stroke=\"#64748b\" stroke-width=\"2\"/><rect x=\"223\" y=\"291\" width=\"34\" height=\"14\" rx=\"4\" fill=\"#94a3b8\"/><text x=\"204\" y=\"280\" fill=\"#cbd5e1\" font-family=\"system-ui,sans-serif\" font-size=\"13\" font-weight=\"400\">template</text><path d=\"M330 298 H370 M360 288 L372 298 L360 308\" fill=\"none\" stroke=\"#a78bfa\" stroke-width=\"3\"/><rect x=\"410\" y=\"230\" width=\"110\" height=\"36\" rx=\"10\" fill=\"#2e1065\" stroke=\"#a78bfa\" stroke-width=\"2\"/>