        "content": {
          "kind": "svg",
          "value": "<svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 720 440\" role=\"img\" aria-label=\"One Bridge per Template\"><rect width=\"720\" height=\"440\" rx=\"20\" fill=\"#0f172a\"/><text x=\"42\" y=\"62\" fill=\"#a78bfa\" font-family=\"system-ui,sans-serif\" font-size=\"14\" font-weight=\"800\">PLAN · DRAFT FOR REVIEW</text><text x=\"42\" y=\"112\" fill=\"#f8fafc\" font-family=\"system-ui,sans-serif\" font-size=\"38\" font-weight=\"700\">One Bridge per Template</text><text x=\"42\" y=\"148\" fill=\"#cbd5e1\" font-family=\"system-ui,sans-serif\" font-size=\"17\" font-weight=\"400\">A graph that uses a template should need one reference to it,</text><text x=\"42\" y=\"172\" fill=\"#cbd5e1\" font-family=\"system-ui,sans-serif\" font-size=\"17\" font-weight=\"400\">not one for every class the template offers.</text><path d=\"M136 248 H190\" stroke=\"#64748b\" stroke-width=\"2\" stroke-dasharray=\"5 5\"/><rect x=\"40\" y=\"234\" width=\"96\" height=\"26\" rx=\"10\" fill=\"#1e293b\" stroke=\"#64748b\" stroke-width=\"2\"/><path d=\"M136 282 H190\" stroke=\"#64748b\" stroke-width=\"2\" stroke-dasharray=\"5 5\"/><rect x=\"40\" y=\"268\" width=\"96\" height=\"26\" rx=\"10\" fill=\"#1e293b\" stroke=\"#64748b\" stroke-width=\"2\"/><path d=\"M136 316 H190\" stroke=\"#64748b\" stroke-width=\"2\" stroke-dasharray=\"5 5\"/><rect x=\"40\" y=\"302\" width=\"96\" height=\"26\" rx=\"10\" fill=\"#1e293b\" stroke=\"#64748b\" stroke-width=\"2\"/><path d=\"M136 350 H190\" stroke=\"#64748b\" stroke-width=\"2\" stroke-dasharray=\"5 5\"/><rect x=\"40\" y=\"336\" width=\"96\" height=\"26\" rx=\"10\" fill=\"#1e293b\" stroke=\"#64748b\" stroke-width=\"2\"/><rect x=\"190\" y=\"230\" width=\"110\" height=\"136\" rx=\"10\" fill=\"#1e293b\" stroke=\"#64748b\" stroke-width=\"2\"/><text x=\"212\" y=\"304\" fill=\"#cbd5e1\" font-family=\"system-ui,sans-serif\" font-size=\"14\" font-weight=\"400\">template</text><path d=\"M340 298 H380 M370 288 L382 298 L370 308\" fill=\"none\" strok