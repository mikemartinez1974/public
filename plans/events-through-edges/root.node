      "data": {
        "title": "Stop a Method re-triggering itself",
        "description": "The Page Template Method writes its own faces, and a face is a node in the graph, so graph.changed would fire again and loop. Writes made inside a run carry that run's rootOccurrenceId; an occurrence never invokes a Method already in its own chain. The existing too-fast guard stays as a backstop.",
        "status": "planned",
        "notes": "",
        "presentation": {
          "glyph": {
            "kind": "icon",
            "name": "Play"
          }
        },
        "classRef": "github://mikemartinez1974/public/templates/plan-template/classes/nodes/plan-action.node-class.node"
      }
    },
