      "data": {
        "title": "The Page Template rebuilds from one edge",
        "description": "Edit a masthead, add a section or a route in the demo, and its Detail face rebuilds, with a single invokes edge from the root to the Method and no Handler in the graph.",
        "status": "planned",
        "notes": "",
        "presentation": {
          "glyph": {
            "kind": "icon",
            "name": "CheckCircle"
          }
        },
        "classRef": "github://mikemartinez1974/public/templates/plan-template/classes/nodes/plan-milestone.node-class.node"
      }
    }
