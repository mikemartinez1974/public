        "content": {
          "kind": "html",
          "value": "<div style='container-type:inline-size;width:100%;height:100%'><div style='position:relative;box-sizing:border-box;width:100%;height:100%;overflow:hidden;background-color:#1b3a6b;background-image:linear-gradient(color-mix(in srgb,#2a5aa0 26%,transparent) 0.12cqw,transparent 0.12cqw),linear-gradient(90deg,color-mix(in srgb,#2a5aa0 26%,transparent) 0.12cqw,transparent 0.12cqw),linear-gradient(color-mix(in srgb,#2a5aa0 12%,transparent) 0.08cqw,transparent 0.08cqw),linear-gradient(90deg,color-mix(in srgb,#2a5aa0 12%,transparent) 0.08cqw,transparent 0.08cqw);background-size:10cqw 10cqw,10cqw 10cqw,2cqw 2cqw,2cqw 2cqw;font-family:Inter,system-ui,Segoe UI,Helvetica Neue,Arial,sans-serif;color:#ffffff'><div style='position:absolute;left:4cqw;top:3.4cqw;font:800 1.5cqw/1.2 Inter,system-ui,sans-serif;letter-spacing:.2em;text-transform:uppercase;color:#f5c542'>Primitive · draft</div><div style='position:absolute;left:4cqw;right:4cqw;top:6.2cqw;font:800 8.4cqw/.9 Archivo Black,Impact,Haettenschweiler,Arial Black,sans-serif;letter-spacing:-.03em;white-space:nowrap;overflow:hidden;text-overflow:ellipsis'>Environment</div><div style='position:absolute;left:4cqw;right:4cqw;top:15.96cqw;font:400 2.5cqw/1.3 Inter,system-ui,sans-serif;color:#cfe0ff;white-space:nowrap;overflow:hidden;text-overflow:ellipsis'>The backdrop a graph&#39;s interior sits on: the room its work happens in.</div><div style='position:absolute;left:4cqw;top:23.200000000000003cqw;font:400 1.7cqw/1 ui-monospace,SFMono-Regular,Menlo,Consolas,monospace;color:#f5c542'>The room around the work.</div><div style='position:absolute;left:4cqw;top:27.6cqw;width:92cqw;height:30.166666666666657cqw;box-sizing:border-box;border-radius:2cqw;background:color-mix(in srgb,#f5c542 7%,#1b3a6b);border:.3cqw solid color-mix(in srgb,#f5c542 28%,#1b3a6b)'></div><div style='position:absolute;left:42.53cqw;top:44.36cqw;width:2.6cqw;height:2.6cqw;border-radius:50%;background:#f5c542;color:#1b3a6b;font:800 1.5cqw/2.6cqw system-ui,sans-serif;text-align:center;box-shadow:0 0 0 .3cqw #1b3a6b'>1</div><div style='position:absolute;left:42.53cqw;top:32.870000000000005cqw;width:2.6cqw;height:2.6cqw;border-radius:50%;background:#f5c542;color:#1b3a6b;font:800 1.5cqw/2.6cqw system-ui,sans-serif;text-align:center;box-shadow:0 0 0 .3cqw #1b3a6b'>2</div><div style='position:absolute;left:63.81cqw;top:44.36cqw;width:2.6cqw;height:2.6cqw;border-radius:50%;background:#f5c542;color:#1b3a6b;font:800 1.5cqw/2.6cqw system-ui,sans-serif;text-align:center;box-shadow:0 0 0 .3cqw #1b3a6b'>3</div><div style='position:absolute;left:4cqw;right:4cqw;bottom:2.4cqw;display:grid;grid-template-columns:1fr 1fr;gap:.7cqw 2.4cqw;font:700 1.4cqw/1.25 Inter,system-ui,sans-serif;color:#f5c542'><span>1 <em style='font-style:normal;font-weight:500;color:#cfe0ff'>one environment, drawn beneath everything</em></span><span>2 <em style='font-style:normal;font-weight:500;color:#cfe0ff'>never in the chain: the outside never shows it</em></span><span>3 <em style='font-style:normal;font-weight:500;color:#cfe0ff'>the ground stands on it</em></span></div><div style='position:absolute;right:4cqw;top:3cqw;display:flex;gap:2.2cqw;font:700 1.9cqw/1.2 Inter,system-ui,sans-serif;white-space:nowrap'><a href='tlz://twilite.zone/library/primitives/face/root.node' style='color:#f5c542;text-decoration:none'>Face →</a><a href='tlz://twilite.zone/library/primitives/root/root.node' style='color:#f5c542;text-decoration:none'>Root →</a><a href='tlz://twilite.zone/library/primitives/surface/root.node' style='color:#f5c542;text-decoration:none'>Surface →</a></div></div></div>"
