    {
      "id": "environment-known-gaps",
      "type": "page-section",
      "label": "Known gaps",
      "position": {
        "x": -1000,
        "y": -1166
      },
      "width": 520,
      "height": 320,
      "data": {
        "title": "Known gaps",
        "body": "- An environment takes no pointer, so nothing in it can be edited in place and its links work only in browse mode.\n- It is static html unless a Method redraws it, as the Repo template's does. Nothing keeps a stage or a pin in step with the nodes that stand on it; moving them means redrawing.\n- A document graph has no environment, by design, and there is no variant of one for a particular zoom.",
        "presentation": {
          "glyph": {
            "kind": "icon",
            "name": "Rule"
          },
          "baseLevel": "detail"
        },
        "_placement": {
          "version": 1,
          "state": "auto-placed",
          "source": "bridge",
