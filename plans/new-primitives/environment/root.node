            "label": "Node type",
            "value": "face"
          },
          {
            "label": "Shown when browsing",
            "value": "Yes: it is drawn behind everything, and takes no pointer"
          },
          {
            "label": "Encoded as",
            "value": "a face holding html, on an `environment` edge from the root's environment port"
