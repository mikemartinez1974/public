    {
      "id": "environment-boundary",
      "type": "page-section",
      "label": "Explicitly Not Part of This Primitive",
      "position": {
        "x": 120,
        "y": -1166
      },
      "width": 520,
      "height": 320,
      "data": {
        "title": "Explicitly Not Part of This Primitive",
        "body": "- It is not the ground. The ground is the node you land on; the environment is the room around it.\n- It is not a face of the Surface, and it is not a theme: it does not change the application's colours.\n- It is not the graph's outside. How a graph looks closed is its Surface.",
        "presentation": {
          "glyph": {
            "kind": "icon",
            "name": "Article"
          },
          "baseLevel": "detail"
        },
