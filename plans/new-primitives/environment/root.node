      "type": "page-section",
      "label": "Ports and Relationships",
      "position": {
        "x": 2260,
        "y": -1526
      },
      "width": 520,
      "height": 320,
      "data": {
        "title": "Ports and Relationships",
        "body": "The root's `environment` port draws the one `environment` edge to the face. An environment has no Ports of its own, and nothing else connects to it.",
        "presentation": {
          "glyph": {
            "kind": "icon",
            "name": "Article"
          },
          "baseLevel": "detail"
        },
        "_placement": {
