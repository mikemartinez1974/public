    {
      "id": "environment-behavior",
      "type": "page-section",
      "label": "Behavior",
      "position": {
        "x": 2820,
        "y": -1526
      },
      "width": 520,
      "height": 320,
      "data": {
        "title": "Behavior",
        "body": "- In the free version, where the one graph is the whole screen, a `screen` environment fills the screen and stays put. A `window` environment stops at the graph's window and moves with the camera.\n- In the paid workspace every environment stops at the graph's window and moves with the camera.\n- An open graph that has an environment, written or default, is shown on it and never as the page of its Detail: the Detail is how a graph looks closed.\n- A link in an environment is followed when you click it, in browse mode: the click reaches the empty canvas in front of it, which looks for the link. The pointer becomes a hand over it.\n- The Page Template's Method leaves the window of a graph whose environment is `window` alone, since the environment sized it.",
        "presentation": {
          "glyph": {
            "kind": "icon",
            "name": "Article"
          },
          "baseLevel": "detail"
        },
        "_placement": {
          "version": 1,
          "state": "auto-placed",
          "source": "bridge",
          "updatedAt": 1791592070381,
          "reason": "bridge-reference"
        },
        "identity": {
