    {
      "id": "environment-invariants",
      "type": "page-section",
      "label": "Invariants",
      "position": {
        "x": 1140,
        "y": -1526
      },
      "width": 520,
      "height": 320,
      "data": {
        "title": "Invariants",
        "body": "- A graph has at most one environment.\n- It is never part of a Surface chain: never the Detail, the Summary or the Glyph, and the outside of a graph never shows it.\n- It takes no pointer events.\n- A graph with an interior and no environment of its own is drawn on the default one, dark graph paper. A graph that is only a document has none.\n- One environment is drawn at a time: the focused graph's.",
        "presentation": {
          "glyph": {
            "kind": "icon",
            "name": "Article"
          },
          "baseLevel": "detail"
        },
        "_placement": {
          "version": 1,
          "state": "auto-placed",
          "source": "bridge",
          "updatedAt": 1791592070377,
          "reason": "bridge-reference"
        },
