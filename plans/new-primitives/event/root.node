    {
      "id": "event-meaning",
      "type": "page-section",
      "label": "Meaning",
      "position": {
        "x": 110,
        "y": -1526
      },
      "width": 520,
      "height": 320,
      "data": {
        "title": "Meaning",
        "body": "**What is this thing?** An event is an announcement by an emitter that something about it changed. Emitters declare their own events, and an event's identity is its emitter's id and its event key. A Property announces `property.changed` by being a Property. Any node can declare `node.changed`. The graph is an emitter too: its root declares `graph.structure.changed` and `graph.changed`.\n\nEncoding: an event key declared on an emitter, drawn as an output port named `event:<key>`.",
        "presentation": {
          "glyph": {
            "kind": "icon",
            "name": "Article"
          },
          "baseLevel": "detail"
        },
        "_placement": {
          "version": 1,
          "state": "auto-placed",
          "source": "bridge",
          "updatedAt": 1791592070375,
          "reason": "bridge-reference"
        },
        "identity": {
          "graphId": "primitive-event"
        },
        "classRef": "tlz://twilite.zone/library/templates/page-template/classes/page-section.node-class.node"
      },
