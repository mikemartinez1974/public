    {
      "id": "event-boundary",
      "type": "page-section",
      "label": "Explicitly Not Part of This Primitive",
      "position": {
        "x": 210,
        "y": -1166
      },
      "width": 520,
      "height": 320,
      "data": {
        "title": "Explicitly Not Part of This Primitive",
        "body": "- It is not a node, and there is no Event Handler node.\n- It is not the editor's event bus, which carries interface messages and runs nothing in a graph.\n- It is not a message to another graph.",
        "presentation": {
          "glyph": {
            "kind": "icon",
            "name": "Article"
          },
          "baseLevel": "detail"
        },
