    {
      "id": "event-behavior",
      "type": "page-section",
      "label": "Behavior",
      "position": {
        "x": 2910,
        "y": -1526
      },
      "width": 520,
      "height": 320,
      "data": {
        "title": "Behavior",
        "body": "- A change to a Property or to a node's authored data is announced at the moment it is written.\n- `graph.changed` is announced for any change that announces, or a structure change. `graph.structure.changed` is announced when nodes or edges are added, removed or reconnected; the editor finds these by comparing graph states, so undo and every write path are covered.\n- Delivery finds the `invokes` edges from the event's port and runs each Method in edge order.",
        "presentation": {
          "glyph": {
            "kind": "icon",
            "name": "Article"
          },
          "baseLevel": "detail"
        },
        "_placement": {
          "version": 1,
          "state": "auto-placed",
          "source": "bridge",
          "updatedAt": 1791592070381,
          "reason": "bridge-reference"
        },
        "identity": {
