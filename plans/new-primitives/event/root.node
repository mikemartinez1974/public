      "data": {
        "title": "At a glance",
        "rows": [
          {
            "label": "Node type",
            "value": "none: an event is declared on the thing that emits it"
          },
          {
            "label": "Shown when browsing",
            "value": "No: an event output port and an `invokes` edge show only while editing"
          },
          {
            "label": "Encoded as",
            "value": "an event key on an emitter, a port named `event:<key>`, and an `invokes` edge to a Method"
          }
