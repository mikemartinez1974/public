    {
      "id": "event-representations",
      "type": "page-section",
      "label": "Representations",
      "position": {
        "x": -350,
        "y": -1166
      },
      "width": 520,
      "height": 320,
      "data": {
        "title": "Representations",
        "body": "On an emitter, an output port `event:<key>`; between it and a Method, an `invokes` edge. A Method is edit-mode only, so a graph's events show in browse mode only through what they change.",
        "presentation": {
          "glyph": {
            "kind": "icon",
            "name": "Article"
          },
          "baseLevel": "detail"
        },
