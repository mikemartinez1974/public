    {
      "id": "event-invariants",
      "type": "page-section",
      "label": "Invariants",
      "position": {
        "x": 1230,
        "y": -1526
      },
      "width": 520,
      "height": 320,
      "data": {
        "title": "Invariants",
        "body": "- Events are declared by their emitters. There are no event-declaration, subscription or Event Handler nodes.\n- An event runs something only through an `invokes` edge from the event's output port to a Method in the same graph.\n- Nothing is called by class, by wildcard or from another graph, and a Bridge carries no events.\n- Several `invokes` edges from one event run in edge order. `data.enabled: false` on an edge skips it.\n- Loading a graph is a baseline, never an event.",
        "presentation": {
          "glyph": {
            "kind": "icon",
            "name": "Article"
          },
          "baseLevel": "detail"
        },
        "_placement": {
          "version": 1,
          "state": "auto-placed",
          "source": "bridge",
          "updatedAt": 1791592070377,
          "reason": "bridge-reference"
        },
        "identity": {
          "graphId": "primitive-event"
        },
        "classRef": "tlz://twilite.zone/library/templates/page-template/classes/page-section.node-class.node"
      },
      "inputs": [
        {
          "key": "root",
          "label": "root",
          "type": "any"
        }
      ],
      "ports": [
