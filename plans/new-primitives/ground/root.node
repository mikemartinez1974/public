        "title": "At a glance",
        "rows": [
          {
            "label": "Node type",
            "value": "any node; usually content"
          },
          {
            "label": "Shown when browsing",
            "value": "Yes"
          },
          {
            "label": "Encoded as",
            "value": "a `ground` edge from the root's ground port to a node, which is pinned (`positionLocked`) to be drawn as a floor"
