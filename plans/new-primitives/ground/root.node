    {
      "id": "ground-known-gaps",
      "type": "page-section",
      "label": "Known gaps",
      "position": {
        "x": -990,
        "y": -1166
      },
      "width": 520,
      "height": 320,
      "data": {
        "title": "Known gaps",
        "body": "- An unpinned ground has no special drawing: it is only a landing.\n- One comment in `groundNode.js` still calls the page of a document its ground. The settled rule is that a document has no ground and its page is its first face.\n- Nothing prevents a large ordinary node being used as a backdrop; it is lifted over what sits on it when selected, and hides the edges that cross it. That is what a pinned ground is for.",
        "presentation": {
          "glyph": {
            "kind": "icon",
            "name": "Rule"
          },
          "baseLevel": "detail"
        },
        "_placement": {
          "version": 1,
          "state": "auto-placed",
          "source": "bridge",
          "updatedAt": 1791592070381,
          "reason": "bridge-reference"
        },
        "identity": {
          "graphId": "primitive-ground"
        },
        "classRef": "tlz://twilite.zone/library/templates/page-template/classes/page-section.node-class.node"
      },
      "inputs": [
        {
