    {
      "id": "ground-invariants",
      "type": "page-section",
      "label": "Invariants",
      "position": {
        "x": 1150,
        "y": -1526
      },
      "width": 520,
      "height": 320,
      "data": {
        "title": "Invariants",
        "body": "- A graph has at most one ground.\n- The first face and the ground are never the same thing.\n- Only a drawn relationship counts. A node is a ground because a `ground` edge ends at it, not because of where it is or what it holds.\n- A ground that is not pinned is an ordinary node that happens to be where a visitor arrives. A graph with no ground loses nothing.",
        "presentation": {
          "glyph": {
            "kind": "icon",
            "name": "Article"
          },
          "baseLevel": "detail"
        },
        "_placement": {
          "version": 1,
          "state": "auto-placed",
          "source": "bridge",
