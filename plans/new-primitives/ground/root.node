    {
      "id": "ground-behavior",
      "type": "page-section",
      "label": "Behavior",
      "position": {
        "x": 2830,
        "y": -1526
      },
      "width": 520,
      "height": 320,
      "data": {
        "title": "Behavior",
        "body": "- A pinned ground is drawn in a layer of its own beneath the edge canvas and every other node, in the open graph and in a workspace tile.\n- It keeps its one form however far the camera pulls back: it does not step down to a smaller face with zoom.\n- Selecting it does not lift it over what stands on it, and a drag on its body pans the view.\n- It is the node a visitor lands on when the graph is opened.",
        "presentation": {
          "glyph": {
            "kind": "icon",
            "name": "Article"
          },
          "baseLevel": "detail"
        },
        "_placement": {
          "version": 1,
          "state": "auto-placed",
          "source": "bridge",
          "updatedAt": 1791592070381,
          "reason": "bridge-reference"
        },
        "identity": {
