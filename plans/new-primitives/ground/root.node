    {
      "id": "ground-boundary",
      "type": "page-section",
      "label": "Explicitly Not Part of This Primitive",
      "position": {
        "x": 130,
        "y": -1166
      },
      "width": 520,
      "height": 320,
      "data": {
        "title": "Explicitly Not Part of This Primitive",
        "body": "- It is not the first face. How a graph looks from outside is its Surface.\n- It is not the environment. The environment is the room around the work, drawn beneath everything, the ground included.\n- It is not an exposed Port. A Port is a named entrance; the ground is where you arrive when none is asked for.",
        "presentation": {
          "glyph": {
            "kind": "icon",
            "name": "Article"
          },
          "baseLevel": "detail"
        },
        "_placement": {
