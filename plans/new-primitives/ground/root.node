    {
      "id": "ground-contract",
      "type": "page-section",
      "label": "Contract",
      "position": {
        "x": 1710,
        "y": -1526
      },
      "width": 520,
      "height": 320,
      "data": {
        "title": "Contract",
        "body": "- The `ground` edge class: source a root or a Port, any target, at most one outgoing.\n- A ground is pinned with `positionLocked: true` on its node. Only a pinned ground is drawn as a floor.\n- The geometry from the root to its ground is the graph's authored interface frame: its workspace shape and its minimap window.",
        "presentation": {
          "glyph": {
            "kind": "icon",
            "name": "Article"
          },
          "baseLevel": "detail"
        },
