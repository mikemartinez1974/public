{
  "fileVersion": "1.0",
  "metadata": {
    "title": "Twilite’s vocabulary, in layers",
    "description": "Twilite has about thirty words of its own. Every reader meets all of them at once, several pairs collide, and some name the machinery rather than what it is for. This plan sorts them into three layers, settles the collisions, and then changes every file to use the settled words, once.",
    "graphId": "vocabulary-declaration",
