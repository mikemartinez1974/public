      "data": {
        "title": "The files use the settled words",
        "description": "The names stored in .node files and in the app’s code change to the settled words, once, so a reader, a file and the app all say the same thing and the tutorials never explain a past mistake. Twilite has no outside users: current graphs are rewritten directly; the previous generation is kept as reference and no longer rendered. No old names are read alongside the new ones.",
        "status": "done",
        "notes": "",
        "definitionKey": "plan-decision",
        "_classBinding": {
          "key": "plan-decision",
