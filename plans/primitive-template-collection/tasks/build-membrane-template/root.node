          "direction": "bidirectional",
          "dataType": "any",
          "angle": 210
        }
      ],
      "inputs": [
        {
          "key": "root",
          "label": "root",
          "type": "any"
        }
      ],
      "outputs": [
        {
          "key": "root",
          "label": "root",
          "type": "any"
        }
      ],
      "visible": true,
      "showLabel": true,
      "data": {
        "body": "graphRenderBounds() treats any graph containing a Membrane node as authoring its own boundary via resolveAuthoredInterfaceFrame, overriding simple drag-resize -- this was true for the isolated smoke-test node. It's not yet confirmed whether a real, properly-chained Membrane boundary behaves any differently, or whether this is just an inherent property of the primitive that the template needs to document rather than solve.",
        "status": "resolved",
        "owner": "",
        "resolutionPath": "Confirmed by executing the real code against this real, closed 3-node chain -- not by assumption: a real chain is NOT exempt. graphRenderBounds() and, separately, resolveAuthoredInterfaceFrame() each compute hasControls = nodes.some(n => n.type === 'membrane'); whenever true, both skip declaration.data.membrane.bounds entirely and infer the frame from the Declaration-to-landing-surface node distance instead. Simulating resizeGraphMembrane() against this exact template shows the write landing correctly (width 3392 -> 3792) but graphRenderBounds() on the very next call reading back the unchanged pre-resize value (3392). This is an unconditional, inherent property of the primitive as currently implemented, true for every Membrane-containing graph regardless of chain length or completeness -- not something to solve here, but something the template now documents directly (see its Content node).",
        "prominence": "high",
        "definitionKey": "open-question",
        "_classBinding": {
          "key": "open-question",
          "sourceRef": "github://twilite-zone/public/library/classes/nodes/task-planning/open-question.node-class.node",
          "ref": "github://twilite-zone/public/library/classes/nodes/task-planning/open-question.node-class.node"
        },
        "_bridge": {
          "sourceNodeId": "build-membrane-template-task-graph-bridge-open-question",
          "sourceRef": "github://twilite-zone/public/library/classes/nodes/task-planning/open-question.node-class.node",
          "entryPort": "root",
