    {
      "id": "build-membrane-template-task-graph-question",
      "type": "open-question",
      "label": "Will a 'real' wired Membrane chain still trip the hasControls frame-hijack behavior?",
      "root": false,
      "position": {
        "x": 0,
        "y": 420
      },
      "width": 420,
      "height": 240,
      "color": "linear-gradient(135deg, #ead6ff, #8750c7)",
      "handles": [
        {
          "id": "root",
          "label": "root",
          "direction": "bidirectional",
          "dataType": "any",
          "angle": 210,
          "portId": "root"
        },
        {
          "id": "top",
          "label": "top",
