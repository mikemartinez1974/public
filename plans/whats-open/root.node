          "kind": "html",
          "value": "<div style='container-type:inline-size;width:100%;height:100%'><div style='box-sizing:border-box;width:100%;height:100%;padding:8cqw;font-family:system-ui;background:#ffffff;color:#0f172a;border-radius:min(18px,6cqw);border:1px solid #e2e8f0;overflow:hidden'><div style='font:800 3cqw system-ui;letter-spacing:.18em;text-transform:uppercase;color:#6d28d9'>Plan</div><div style='font:500 7cqw/1.05 Georgia,serif;margin-top:2cqw'>What is actually open</div><div style='font:400 3.4cqw/1.4 system-ui;margin-top:3cqw;color:#475569'>What is left after the audits, in the order to take it.</div></div></div>"
