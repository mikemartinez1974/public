        "semanticLevel": "detail",
        "content": {
          "kind": "svg",
          "value": "<svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 720 440\" role=\"img\" aria-label=\"Canon at twilite.zone\"><rect width=\"720\" height=\"440\" rx=\"20\" fill=\"#0f172a\"/><text x=\"42\" y=\"62\" fill=\"#a78bfa\" font-family=\"system-ui,sans-serif\" font-size=\"14\" font-weight=\"800\">PLAN · DRAFT FOR REVIEW</text><text x=\"42\" y=\"112\" fill=\"#f8fafc\" font-family=\"system-ui,sans-serif\" font-size=\"38\" font-weight=\"700\">Canon at twilite.zone</text><text x=\"42\" y=\"148\" fill=\"#cbd5e1\" font-family=\"system-ui,sans-serif\" font-size=\"17\" font-weight=\"400\">Official graphs are known by an address of their own, not by where</text><text x=\"42\" y=\"172\" fill=\"#cbd5e1\" font-family=\"system-ui,sans-serif\" font-size=\"17\" font-weight=\"400\">they happen to be hosted. What answers that address can change.</text><rect x=\"40\" y=\"240\" width=\"150\" height=\"96\" rx=\"10\" fill=\"#1e293b\" stroke=\"#64748b\" stroke-width=\"2\"/><text x=\"56\" y=\"280\" fill=\"#cbd5e1\" font-family=\"system-ui,sans-serif\" font-size=\"13\" font-weight=\"400\">a graph that</text><text x=\"56\" y=\"300\" fill=\"#cbd5e1\" font-family=\"system-ui,sans-serif\" font-size=\"13\" font-weight=\"400\">uses canon</text><path d=\"M190 288 H272\" stroke=\"#a78bfa\" stroke-width=\"3\"/><rect x=\"272\" y=\"264\" width=\"230\" height=\"48\" rx=\"10\" fill=\"#2e1065\" stroke=\"#a78bfa\" stroke-width=\"2\"/><text x=\"286\" y=\"294\" fill=\"#ede9fe\" font-family=\"system-ui,sans-serif\" font-size=\"15\" font-weight=\"700\">tlz://twilite.zone/library/…</text><path d=\"M502 288 H560\" stroke=\"#a78bfa\" stroke-width=\"3\" stroke-dasharray=\"6 5\"/><rect x=\"560\" y=\"220\" width=\"124\" height=\"40\" rx=\"10\" fill=\"#1e293b\" stroke=\"#64748b\" stroke-width=\"2\"/><text x=\"574\" y=\"245\" fill=\"#cbd5e1\" font-family=\"system-ui,sans-serif\" font-size=\"13\" font-weight=\"400\">a static file</text><rect x=\"560\" y=\"268\" width=\"124\" height=\"40\" rx=\"10\" fill=\"#1e293b\" stroke=\"#64748b\" stroke-width=\"2\"/><text x=\"574\" y=\"293\" fill=\"#cbd5e1\" font-family=\"system-ui,sans-serif\" font-size=\"13\" font-weight=\"400\">a server</text><rect x=\"560\" y=\"316\" width=\"124\" height=\"40\" rx=\"10\" fill=\"#1e293b\" stroke=\"#64748b\" stroke-width=\"2\"/><text x=\"574\" y=\"341\" fill=\"#cbd5e1\" font-family=\"system-ui,sans-serif\" font-size=\"13\" font-weight=\"400\">a desktop copy</text><text x=\"42\" y=\"410\" fill=\"#c4b5fd\" font-family=\"system-ui,sans-serif\" font-size=\"14\" font-weight=\"400\">The address is written into graphs. The hosting is not.</text></svg>"
