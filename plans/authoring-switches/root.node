        "content": {
          "kind": "markdown",
          "value": "## view.fit\n\nwindow draws the environment at the graph's window and moves it with the camera, as in a poster; screen fills the screen.\n\n| | |\n|---|---|\n| Scope | face (the environment) |\n| Written at | `node.data.view.fit` |\n| Type | enum |\n| Default | screen |\n| Valid | screen, window |\n| Applies | browse |\n| Properties panel | no |\n| Written down | AGENTS.md |\n| Status | built |"
        },
        "switch": {
          "name": "view.fit",
          "scope": "face (the environment)",
          "writtenAt": "node.data.view.fit",
          "type": "enum",
          "default": "screen",
          "valid": "screen, window",
          "effect": "window draws the environment at the graph's window and moves it with the camera, as in a poster; screen fills the screen.",
          "appliesIn": "browse",
          "panel": "no",
          "writtenDown": "AGENTS.md",
          "status": "built"
        },
        "identity": {
          "graphId": "authoring-switches"
        }
