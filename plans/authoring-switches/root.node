      "width": 600,
      "height": 620,
      "visible": true,
      "showLabel": true,
      "data": {
        "content": {
          "kind": "markdown",
          "value": "## rotation\n\nTurns the node. Its handles and the edges that end on it turn with it.\n\n| | |\n|---|---|\n| Scope | node |\n| Written at | `node.data.rotation` |\n| Type | number (degrees, clockwise) |\n| Default | 0 |\n| Valid | any number |\n| Applies | edit, browse |\n| Properties panel | none found |\n| Written down | docs, in part |\n| Status | built |"
        },
        "switch": {
          "name": "rotation",
          "scope": "node",
          "writtenAt": "node.data.rotation",
          "type": "number (degrees, clockwise)",
          "default": "0",
          "valid": "any number",
          "effect": "Turns the node. Its handles and the edges that end on it turn with it.",
          "appliesIn": "edit, browse",
          "panel": "none found",
          "writtenDown": "docs, in part",
          "status": "built"
        },
        "identity": {
