      ],
      "visible": true,
      "showLabel": false,
      "data": {
        "title": "1. Define durable reciprocal bridge identity",
        "description": "Represent remote graph, remote declaration, remote nodeId, local bridge identity, and reciprocal bridge identity explicitly enough that either side can verify the relationship after remote resolution.",
        "status": "planned",
        "notes": "Do not invent additional identity or authorization machinery.",
        "definitionKey": "plan-phase",
        "_classBinding": {
          "key": "plan-phase",
          "sourceRef": "github://mikemartinez1974/public/templates/plan-template/classes/nodes/plan-phase.node-class.node"
