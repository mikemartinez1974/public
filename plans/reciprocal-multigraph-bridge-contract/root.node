      ],
      "visible": true,
      "showLabel": false,
      "data": {
        "title": "3. Gate expansion on verified reciprocity",
        "description": "Expand only after matching nodeId values and the return bridge have been confirmed. Whichever graph is open remains the current canvas while the reciprocal bridge contributes the other graph's portion of the same semantic node.",
        "status": "planned",
        "notes": "This makes expansion direction-neutral by construction.",
        "definitionKey": "plan-phase",
        "_classBinding": {
          "key": "plan-phase",
          "sourceRef": "github://mikemartinez1974/public/templates/plan-template/classes/nodes/plan-phase.node-class.node"
