      "data": {
        "title": "4. Preserve diagnostic legacy loading",
        "description": "Permit older or one-way structures to load for inspection, but do not treat them as valid multi-graph expansion contracts.",
        "status": "planned",
        "notes": "Legacy tolerance must not silently weaken the new invariant.",
        "definitionKey": "plan-phase",
