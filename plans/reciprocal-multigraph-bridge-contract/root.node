        }
      ],
      "visible": true,
      "showLabel": false,
      "data": {
        "title": "2. Enforce compatibility at authoring boundaries",
        "description": "Reject mismatched nodeId bridges during creation, prevent newly authored invalid reciprocal structures from being saved, and validate missing reciprocity as incomplete.",
        "status": "planned",
        "notes": "Bridge-specific rule only. Ordinary edges retain their existing endpoint semantics.",
        "definitionKey": "plan-phase",
        "_classBinding": {
          "key": "plan-phase",
          "sourceRef": "github://mikemartinez1974/public/templates/plan-template/classes/nodes/plan-phase.node-class.node"
