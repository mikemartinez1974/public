{"fileVersion":"1.0","metadata":{"title":"Reciprocal Multi-Graph Bridge Contract","description":"Implementation plan for making node continuity across graphs explicitly reciprocal, with matching nodeId as the bridge endpoint compatibility rule.","graphId":"reciprocal-multigraph-bridge-plan-declaration","version":"0.1.0","kind":"plan","created":"2026-09-01T16:22:00.000Z","modified":"2026-09-01T16:22:00.000Z","tags":["plan","bridges","multi-graph","node-continuity"],"preferredViewer":"https://dev.twilite.zone"},"nodes":[{"id":"reciprocal-multigraph-bridge-plan-declaration","type":"declaration","label":"Reciprocal Bridge Plan Declaration","root":false,"position":{"x":-900,"y":-850},"width":380,"height":260,"ports":[{"id":"root","key":"root","label":"root","direction":"bidirectional","dataType":"any","angle":180}],"visible":false,"showLabel":true,"data":{"identity":{"graphId":"reciprocal-multigraph-bridge-plan-declaration","name":"Reciprocal Multi-Graph Bridge Contract","version":"0.1.0","description":"Implementation plan for reciprocal bridge validation and direction-neutral multi-graph node expansion.","nodeId":"reciprocal-multigraph-bridge-plan"},"intent":{"kind":"plan","scope":"implementation"},"declaration":{"kind":"graph","targetMode":"artifact","artifactKind":"plan","defaultSurfaceId":"root","interfaceContract":{"version":1,"implicitRootPort":true},"surfaces":[{"id":"root","kind":"port","label":"Reciprocal Multi-Graph Bridge Contract","portNodeId":"reciprocal-bridge-plan","viewNodeId":"reciprocal-bridge-plan","exposes":{"views":{"mode":"allow"},"declarations":{"mode":"allow"}}}]},"authority":{"mutation":{"allowCreate":true,"allowUpdate":true,"allowDelete":true,"appendOnly":false},"actors":{"humans":true,"agents":true,"tools":true}},"settings":{"edgeRouting":"auto","autoSave":false}}},{"id":"reciprocal-bridge-plan","type":"plan","label":"Reciprocal Bridge Plan","root":false,"position":{"x":0,"y":0},"width":420,"height":280,"ports":[{"id":"root","key":"root","label":"root","direction":"bidirectional","dataType":"any","angle":180}],"handles":[{"id":"root","key":"root","portId":"root","label":"root","direction":"bidirectional","dataType":"any","angle":180}],"visible":true,"showLabel":false,"data":{"title":"Make node continuity explicitly reciprocal","description":"Implement a reciprocal-bridge contract so a multi-graph node is valid only when both graph-local declarations share the same semantic nodeId and explicitly bridge to one another.","status":"planned","notes":"The implementation is not merely 'expand from either direction'; reciprocity is the durable structure that makes expansion direction-neutral.","definitionKey":"plan","_classBinding":{"key":"plan","sourceRef":"github://mikemartinez1974/public/templates/plan-template/classes/nodes/plan.node-class.node"},"_bridge":{"classKey":"plan","classRef":"github://mikemartinez1974/public/templates/plan-template/classes/nodes/plan.node-class.node"}}},{"id":"reciprocal-bridge-goal","type":"plan-goal","label":"Goal","root":false,"position":{"x":0,"y":-360},"width":420,"height":260,"ports":[{"id":"root","key":"root","label":"root","direction":"bidirectional","dataType":"any","angle":180}],"handles":[{"id":"root","key":"root","portId":"root","label":"root","direction":"bidirectional","dataType":"any","angle":180}],"visible":true,"showLabel":false,"data":{"title":"A concrete reciprocal-bridge contract","description":"A bridge may connect graph-local declarations only when their nodeId values match, and valid multi-graph continuity requires a durable reciprocal bridge in both directions while each declaration retains its own graphId.","status":"target","notes":"Ordinary edges remain free to connect different semantic nodes through their ports.","definitionKey":"plan-goal","_classBinding":{"key":"plan-goal","sourceRef":"github://mikemartinez1974/public/templates/plan-template/classes/nodes/plan-goal.node-class.node"},"_bridge":{"classKey":"plan-goal","classRef":"github://mikemartinez1974/public/templates/plan-template/classes/nodes/plan-goal.node-class.node"}}},{"id":"phase-contract","type":"plan-phase","label":"Phase: Contract","root":false,"position":{"x":-700,"y":360},"width":400,"height":250,"ports":[{"id":"root","key":"root","label":"root","direction":"bidirectional","dataType":"any","angle":180}],"handles":[{"id":"root","key":"root","portId":"root","label":"root","direction":"bidirectional","dataType":"any","angle":180}],"visible":true,"showLabel":false,"data":{"title":"1. Define durable reciprocal bridge identity","description":"Represent remote graph, remote declaration, remote nodeId, local bridge identity, and reciprocal bridge identity explicitly enough that either side can verify the relationship after remote resolution.","status":"planned","notes":"Do not invent additional identity or authorization machinery.","definitionKey":"plan-phase","_classBinding":{"key":"plan-phase","sourceRef":"github://mikemartinez1974/public/templates/plan-template/classes/nodes/plan-phase.node-class.node"},"_bridge":{"classKey":"plan-phase","classRef":"github://mikemartinez1974/public/templates/plan-template/classes/nodes/plan-phase.node-class.node"}}},{"id":"phase-enforcement","type":"plan-phase","label":"Phase: Enforcement","root":false,"position":{"x":-220,"y":360},"width":400,"height":250,"ports":[{"id":"root","key":"root","label":"root","direction":"bidirectional","dataType":"any","angle":180}],"handles":[{"id":"root","key":"root","portId":"root","label":"root","direction":"bidirectional","dataType":"any","angle":180}],"visible":true,"showLabel":false,"data":{"title":"2. Enforce compatibility at authoring boundaries","description":"Reject mismatched nodeId bridges during creation, prevent newly authored invalid reciprocal structures from being saved, and validate missing reciprocity as incomplete.","status":"planned","notes":"Bridge-specific rule only. Ordinary edges retain their existing endpoint semantics.","definitionKey":"plan-phase","_classBinding":{"key":"plan-phase","sourceRef":"github://mikemartinez1974/public/templates/plan-template/classes/nodes/plan-phase.node-class.node"},"_bridge":{"classKey":"plan-phase","classRef":"github://mikemartinez1974/public/templates/plan-template/classes/nodes/plan-phase.node-class.node"}}},{"id":"phase-expansion","type":"plan-phase","label":"Phase: Expansion","root":false,"position":{"x":260,"y":360},"width":400,"height":250,"ports":[{"id":"root","key":"root","label":"root","direction":"bidirectional","dataType":"any","angle":180}],"handles":[{"id":"root","key":"root","portId":"root","label":"root","direction":"bidirectional","dataType":"any","angle":180}],"visible":true,"showLabel":false,"data":{"title":"3. Gate expansion on verified reciprocity","description":"Expand only after matching nodeId values and the return bridge have been confirmed. Whichever graph is open remains the current canvas while the reciprocal bridge contributes the other graph's portion of the same semantic node.","status":"planned","notes":"This makes expansion direction-neutral by construction.","definitionKey":"plan-phase","_classBinding":{"key":"plan-phase","sourceRef":"github://mikemartinez1974/public/templates/plan-template/classes/nodes/plan-phase.node-class.node"},"_bridge":{"classKey":"plan-phase","classRef":"github://mikemartinez1974/public/templates/plan-template/classes/nodes/plan-phase.node-class.node"}}},{"id":"phase-legacy","type":"plan-phase","label":"Phase: Legacy","root":false,"position":{"x":740,"y":360},"width":400,"height":250,"ports":[{"id":"root","key":"root","label":"root","direction":"bidirectional","dataType":"any","angle":180}],"handles":[{"id":"root","key":"root","portId":"root","label":"root","direction":"bidirectional","dataType":"any","angle":180}],"visible":true,"showLabel":false,"data":{"title":"4. Preserve diagnostic legacy loading","description":"Permit older or one-way structures to load for inspection, but do not treat them as valid multi-graph expansion contracts.","status":"planned","notes":"Legacy tolerance must not silently weaken the new invariant.","definitionKey":"plan-phase","_classBinding":{"key":"plan-phase","sourceRef":"github://mikemartinez1974/public/templates/plan-template/classes/nodes/plan-phase.node-class.node"},"_bridge":{"classKey":"plan-phase","classRef":"github://mikemartinez1974/public/templates/plan-template/classes/nodes/plan-phase.node-class.node"}}},{"id":"action-create","type":"plan-action","label":"Bridge creation check","root":false,"position":{"x":-700,"y":690},"width":380,"height":240,"ports":[{"id":"root","key":"root","label":"root","direction":"bidirectional","dataType":"any","angle":180}],"handles":[{"id":"root","key":"root","portId":"root","label":"root","direction":"bidirectional","dataType":"any","angle":180}],"visible":true,"showLabel":false,"data":{"title":"Reject bridge creation when nodeId differs","description":"Resolve both declarations and fail bridge creation if their semantic nodeId values are different.","status":"planned","notes":"The declaration graphIds are expected to differ.","definitionKey":"plan-action","_classBinding":{"key":"plan-action","sourceRef":"github://mikemartinez1974/public/templates/plan-template/classes/nodes/plan-action.node-class.node"},"_bridge":{"classKey":"plan-action","classRef":"github://mikemartinez1974/public/templates/plan-template/classes/nodes/plan-action.node-class.node"}}},{"id":"action-validation","type":"plan-action","label":"Validation states","root":false,"position":{"x":-220,"y":690},"width":380,"height":240,"ports":[{"id":"root","key":"root","label":"root","direction":"bidirectional","dataType":"any","angle":180}],"handles":[{"id":"root","key":"root","portId":"root","label":"root","direction":"bidirectional","dataType":"any","angle":180}],"visible":true,"showLabel":false,"data":{"title":"Classify bridge state after remote resolution","description":"When only one graph is loaded, mark the bridge unverified. After resolving the remote graph: matching nodeId plus reciprocal bridge is valid; matching nodeId without return bridge is incomplete; different nodeId is invalid.","status":"planned","notes":"Validation should surface these states diagnostically.","definitionKey":"plan-action","_classBinding":{"key":"plan-action","sourceRef":"github://mikemartinez1974/public/templates/plan-template/classes/nodes/plan-action.node-class.node"},"_bridge":{"classKey":"plan-action","classRef":"github://mikemartinez1974/public/templates/plan-template/classes/nodes/plan-action.node-class.node"}}},{"id":"action-expand","type":"plan-action","label":"Expansion gate","root":false,"position":{"x":260,"y":690},"width":380,"height":240,"ports":[{"id":"root","key":"root","label":"root","direction":"bidirectional","dataType":"any","angle":180}],"handles":[{"id":"root","key":"root","portId":"root","label":"root","direction":"bidirectional","dataType":"any","angle":180}],"visible":true,"showLabel":false,"data":{"title":"Require valid reciprocal state before expansion","description":"Do not materialize the other graph's contribution until matching nodeId and the reciprocal bridge are verified.","status":"planned","notes":"Opening either graph should produce the same semantic continuity once verified.","definitionKey":"plan-action","_classBinding":{"key":"plan-action","sourceRef":"github://mikemartinez1974/public/templates/plan-template/classes/nodes/plan-action.node-class.node"},"_bridge":{"classKey":"plan-action","classRef":"github://mikemartinez1974/public/templates/plan-template/classes/nodes/plan-action.node-class.node"}}},{"id":"action-save","type":"plan-action","label":"Save guard","root":false,"position":{"x":740,"y":690},"width":380,"height":240,"ports":[{"id":"root","key":"root","label":"root","direction":"bidirectional","dataType":"any","angle":180}],"handles":[{"id":"root","key":"root","portId":"root","label":"root","direction":"bidirectional","dataType":"any","angle":180}],"visible":true,"showLabel":false,"data":{"title":"Block persistence of newly authored invalid structures","description":"Save should reject a newly authored bridge relationship known to violate nodeId compatibility or required reciprocity.","status":"planned","notes":"Diagnostic loading of legacy graphs remains separate from authoring permission.","definitionKey":"plan-action","_classBinding":{"key":"plan-action","sourceRef":"github://mikemartinez1974/public/templates/plan-template/classes/nodes/plan-action.node-class.node"},"_bridge":{"classKey":"plan-action","classRef":"github://mikemartinez1974/public/templates/plan-template/classes/nodes/plan-action.node-class.node"}}},{"id":"milestone-contract","type":"plan-milestone","label":"Milestone","root":false,"position":{"x":-460,"y":1030},"width":390,"height":230,"ports":[{"id":"root","key":"root","label":"root","direction":"bidirectional","dataType":"any","angle":180}],"handles":[{"id":"root","key":"root","portId":"root","label":"root","direction":"bidirectional","dataType":"any","angle":180}],"visible":true,"showLabel":false,"data":{"title":"Invalid bridges are impossible to author accidentally","description":"Creation and save boundaries enforce matching nodeId and required reciprocal structure for new multi-graph bridges.","status":"acceptance","notes":"Ordinary non-bridge edges still connect different node identities normally.","definitionKey":"plan-milestone","_classBinding":{"key":"plan-milestone","sourceRef":"github://mikemartinez1974/public/templates/plan-template/classes/nodes/plan-milestone.node-class.node"},"_bridge":{"classKey":"plan-milestone","classRef":"github://mikemartinez1974/public/templates/plan-template/classes/nodes/plan-milestone.node-class.node"}}},{"id":"milestone-expansion","type":"plan-milestone","label":"Milestone","root":false,"position":{"x":300,"y":1030},"width":390,"height":230,"ports":[{"id":"root","key":"root","label":"root","direction":"bidirectional","dataType":"any","angle":180}],"handles":[{"id":"root","key":"root","portId":"root","label":"root","direction":"bidirectional","dataType":"any","angle":180}],"visible":true,"showLabel":false,"data":{"title":"Expansion is direction-neutral and reciprocity-gated","description":"Either graph can be opened first; after verification, the reciprocal bridge brings in the other graph's contribution to the same semantic node.","status":"acceptance","notes":"One-way legacy bridges remain diagnostic only.","definitionKey":"plan-milestone","_classBinding":{"key":"plan-milestone","sourceRef":"github://mikemartinez1974/public/templates/plan-template/classes/nodes/plan-milestone.node-class.node"},"_bridge":{"classKey":"plan-milestone","classRef":"github://mikemartinez1974/public/templates/plan-template/classes/nodes/plan-milestone.node-class.node"}}},{"id":"decision-remote-resolved","type":"plan-decision","label":"Decision","root":false,"position":{"x":-220,"y":1320},"width":410,"height":250,"ports":[{"id":"root","key":"root","label":"root","direction":"bidirectional","dataType":"any","angle":180}],"handles":[{"id":"root","key":"root","portId":"root","label":"root","direction":"bidirectional","dataType":"any","angle":180}],"visible":true,"showLabel":false,"data":{"title":"Is the remote graph resolved?","description":"If not, bridge state remains unverified. Once resolved, compare nodeId and reciprocal bridge identity to classify valid, incomplete, or invalid.","status":"runtime-decision","notes":"Unverified is not equivalent to valid.","definitionKey":"plan-decision","_classBinding":{"key":"plan-decision","sourceRef":"github://mikemartinez1974/public/templates/plan-template/classes/nodes/plan-decision.node-class.node"},"_bridge":{"classKey":"plan-decision","classRef":"github://mikemartinez1974/public/templates/plan-template/classes/nodes/plan-decision.node-class.node"}}},{"id":"constraint-no-extra-machinery","type":"plan-constraint","label":"Constraint","root":false,"position":{"x":-700,"y":1320},"width":410,"height":250,"ports":[{"id":"root","key":"root","label":"root","direction":"bidirectional","dataType":"any","angle":180}],"handles":[{"id":"root","key":"root","portId":"root","label":"root","direction":"bidirectional","dataType":"any","angle":180}],"visible":true,"showLabel":false,"data":{"title":"Keep the contract narrow","description":"Use matching semantic nodeId plus explicit reciprocity. Do not add unrelated identity, authorization, or ownership machinery to solve this feature.","status":"active","notes":"Each declaration retains its own graphId.","definitionKey":"plan-constraint","_classBinding":{"key":"plan-constraint","sourceRef":"github://mikemartinez1974/public/templates/plan-template/classes/nodes/plan-constraint.node-class.node"},"_bridge":{"classKey":"plan-constraint","classRef":"github://mikemartinez1974/public/templates/plan-template/classes/nodes/plan-constraint.node-class.node"}}},{"id":"risk-one-way-valid","type":"plan-risk","label":"Risk","root":false,"position":{"x":260,"y":1320},"width":410,"height":250,"ports":[{"id":"root","key":"root","label":"root","direction":"bidirectional","dataType":"any","angle":180}],"handles":[{"id":"root","key":"root","portId":"root","label":"root","direction":"bidirectional","dataType":"any","angle":180}],"visible":true,"showLabel":false,"data":{"title":"One-way bridges masquerade as valid continuity","description":"If loading or expansion treats a single matching-nodeId bridge as sufficient, direction-neutral semantics become accidental and graph state can disagree depending on entry direction.","status":"open","notes":"This is the failure mode reciprocity is meant to eliminate.","definitionKey":"plan-risk","_classBinding":{"key":"plan-risk","sourceRef":"github://mikemartinez1974/public/templates/plan-template/classes/nodes/plan-risk.node-class.node"},"_bridge":{"classKey":"plan-risk","classRef":"github://mikemartinez1974/public/templates/plan-template/classes/nodes/plan-risk.node-class.node"}}},{"id":"contingency-legacy-diagnostic","type":"plan-contingency","label":"Contingency","root":false,"position":{"x":740,"y":1320},"width":410,"height":250,"ports":[{"id":"root","key":"root","label":"root","direction":"bidirectional","dataType":"any","angle":180}],"handles":[{"id":"root","key":"root","portId":"root","label":"root","direction":"bidirectional","dataType":"any","angle":180}],"visible":true,"showLabel":false,"data":{"title":"Load legacy one-way bridges diagnostically","description":"Allow legacy graphs to open and report incomplete reciprocity, but refuse to treat the structure as valid multi-graph expansion until repaired.","status":"fallback","notes":"Compatibility without semantic amnesty.","definitionKey":"plan-contingency","_classBinding":{"key":"plan-contingency","sourceRef":"github://mikemartinez1974/public/templates/plan-template/classes/nodes/plan-contingency.node-class.node"},"_bridge":{"classKey":"plan-contingency","classRef":"github://mikemartinez1974/public/templates/plan-template/classes/nodes/plan-contingency.node-class.node"}}}],"edges":[{"id":"e-achieves","type":"plan.achieves","source":"reciprocal-bridge-plan","target":"reciprocal-bridge-goal","sourcePort":"root","targetPort":"root","label":"achieves"},{"id":"e-phase-1","type":"plan.contains","source":"reciprocal-bridge-plan","target":"phase-contract","sourcePort":"root","targetPort":"root","label":"contains"},{"id":"e-phase-2","type":"plan.precedes","source":"phase-contract","target":"phase-enforcement","sourcePort":"root","targetPort":"root","label":"precedes"},{"id":"e-phase-3","type":"plan.precedes","source":"phase-enforcement","target":"phase-expansion","sourcePort":"root","targetPort":"root","label":"precedes"},{"id":"e-phase-4","type":"plan.precedes","source":"phase-expansion","target":"phase-legacy","sourcePort":"root","targetPort":"root","label":"precedes"},{"id":"e-action-create","type":"plan.contains","source":"phase-enforcement","target":"action-create","sourcePort":"root","targetPort":"root","label":"contains"},{"id":"e-action-validation","type":"plan.contains","source":"phase-enforcement","target":"action-validation","sourcePort":"root","targetPort":"root","label":"contains"},{"id":"e-action-expand","type":"plan.contains","source":"phase-expansion","target":"action-expand","sourcePort":"root","targetPort":"root","label":"contains"},{"id":"e-action-save","type":"plan.contains","source":"phase-legacy","target":"action-save","sourcePort":"root","targetPort":"root","label":"contains"},{"id":"e-contract-milestone","type":"plan.produces","source":"action-validation","target":"milestone-contract","sourcePort":"root","targetPort":"root","label":"produces"},{"id":"e-expand-milestone","type":"plan.produces","source":"action-expand","target":"milestone-expansion","sourcePort":"root","targetPort":"root","label":"produces"},{"id":"e-decision","type":"plan.gates","source":"decision-remote-resolved","target":"action-validation","sourcePort":"root","targetPort":"root","label":"gates"},{"id":"e-constraint","type":"plan.constrained-by","source":"reciprocal-bridge-plan","target":"constraint-no-extra-machinery","sourcePort":"root","targetPort":"root","label":"constrained by"},{"id":"e-risk","type":"plan.threatened-by","source":"phase-expansion","target":"risk-one-way-valid","sourcePort":"root","targetPort":"root","label":"threatened by"},{"id":"e-contingency","type":"plan.mitigated-by","source":"risk-one-way-valid","target":"contingency-legacy-diagnostic","sourcePort":"root","targetPort":"root","label":"mitigated by"},{"id":"e-legacy-contingency","type":"plan.contains","source":"phase-legacy","target":"contingency-legacy-diagnostic","sourcePort":"root","targetPort":"root","label":"contains"}],"clusters":[],"settings":{"edgeRouting":"auto","layout":{"mode":"manual","defaultLayout":"layered","direction":"DOWN"},"autoSave":false},"scripts":[]}