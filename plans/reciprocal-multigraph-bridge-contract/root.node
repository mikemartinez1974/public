      "visible": true,
      "showLabel": false,
      "data": {
        "title": "Make node continuity explicitly reciprocal",
        "description": "Implement a reciprocal-bridge contract so a multi-graph node is valid only when both graph-local declarations share the same semantic nodeId and explicitly bridge to one another.",
        "status": "planned",
        "notes": "The implementation is not merely 'expand from either direction'; reciprocity is the durable structure that makes expansion direction-neutral.",
        "definitionKey": "plan",
        "_classBinding": {
          "key": "plan",
          "sourceRef": "github://mikemartinez1974/public/templates/plan-template/classes/nodes/plan.node-class.node"
        },
        "_bridge": {
          "classKey": "plan",
          "classRef": "github://mikemartinez1974/public/templates/plan-template/classes/nodes/plan.node-class.node"
        }
      }
    },
    {
      "id": "reciprocal-bridge-goal",
      "type": "plan-goal",
      "label": "Goal",
      "root": false,
      "position": {
        "x": 0,
        "y": -360
      },
      "width": 420,
      "height": 260,
      "ports": [
        {
          "id": "root",
          "key": "root",
          "label": "root",
          "direction": "bidirectional",
          "dataType": "any",
          "angle": 180
        }
      ],
      "handles": [
        {
          "id": "root",
          "key": "root",
          "portId": "root",
          "label": "root",
          "direction": "bidirectional",
          "dataType": "any",
          "angle": 180
        }
      ],
      "visible": true,
      "showLabel": false,
      "data": {
        "title": "A concrete reciprocal-bridge contract",
        "description": "A bridge may connect graph-local declarations only when their nodeId values match, and valid multi-graph continuity requires a durable reciprocal bridge in both directions while each declaration retains its own graphId.",
        "status": "target",
        "notes": "Ordinary edges remain free to connect different semantic nodes through their ports.",
        "definitionKey": "plan-goal",
        "_classBinding": {
          "key": "plan-goal",
          "sourceRef": "github://mikemartinez1974/public/templates/plan-template/classes/nodes/plan-goal.node-class.node"
        },
        "_bridge": {
          "classKey": "plan-goal",
          "classRef": "github://mikemartinez1974/public/templates/plan-template/classes/nodes/plan-goal.node-class.node"
        }
      }
    },
    {
