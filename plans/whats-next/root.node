ans-serif\" font-size=\"12\" font-weight=\"400\">Rooms to canon</text><rect x=\"360\" y=\"232\" width=\"96.66666666666667\" height=\"64\" rx=\"10\" fill=\"#1e293b\" stroke=\"#64748b\" stroke-width=\"2\"/><text x=\"372\" y=\"258\" fill=\"#94a3b8\" font-family=\"system-ui,sans-serif\" font-size=\"13\" font-weight=\"800\">4</text><text x=\"372\" y=\"280\" fill=\"#cbd5e1\" font-family=\"system-ui,sans-serif\" font-size=\"12\" font-weight=\"400\">Behind the doors</text><rect x=\"466.6666666666667\" y=\"232\" width=\"96.66666666666667\" height=\"64\" rx=\"10\" fill=\"#1e293b\" stroke=\"#64748b\" stroke-width=\"2\"/><text x=\"478.6666666666667\" y=\"258\" fill=\"#94a3b8\" font-family=\"system-ui,sans-serif\" font-size=\"13\" font-weight=\"800\">5</text><text x=\"478.6666666666667\" y=\"280\" fill=\"#cbd5e1\" font-family=\"system-ui,sans-serif\" font-size=\"12\" font-weight=\"400\">Water cycle</text><rect x=\"573.3333333333334\" y=\"232\" width=\"96.66666666666667\" height=\"64\" rx=\"10\" fill=\"#1e293b\" stroke=\"#64748b\" stroke-width=\"2\"/><text x=\"585.3333333333334\" y=\"258\" fill=\"#94a3b8\" font-family=\"system-ui,sans-serif\" font-size=\"13\" font-weight=\"800\">6</text><text x=\"585.3333333333334\" y=\"280\" fill=\"#cbd5e1\" font-family=\"system-ui,sans-serif\" font-size=\"12\" font-weight=\"400\">Tutorials</text><text x=\"42\" y=\"340\" fill=\"#c4b5fd\" font-family=\"system-ui,sans-serif\" font-size=\"14\" font-weight=\"400\">Navigation is settled before the rooms move, because every scene</text><text x=\"42\" y=\"360\" fill=\"#c4b5fd\" font-family=\"system-ui,sans-serif\" font-size=\"14\" font-weight=\"400\">so far carries a way back that was placed by hand.</text><text x=\"42\" y=\"410\" fill=\"#94a3b8\" font-family=\"system-ui,sans-serif\" font-size=\"14\" font-weight=\"400\">6 phases · 26 actions · 19 done</text></svg>"
