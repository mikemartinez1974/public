    {
      "id": "plans-collection-window-controller",
      "type": "script",
      "label": "Plans Collection Browser",
      "root": false,
      "position": {
        "x": -760,
        "y": 20
      },
      "width": 380,
      "height": 120,
      "visible": true,
      "showLabel": true,
      "ports": [
        {
          "id": "trigger",
          "label": "trigger",
          "direction": "input",
          "dataType": "trigger",
          "angle": 180
        },
        {
          "id": "result",
          "label": "result",
