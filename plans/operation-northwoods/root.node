    {"id":"northwoods-task-claims","type":"task","label":"Audit later claims against the record","root":false,"position":{"x":260,"y":80},"width":420,"height":240,"ports":[{"id":"root","key":"root","label":"root","direction":"bidirectional","dataType":"any","angle":180}],"handles":[{"id":"root","label":"root","direction":"bidirectional","dataType":"any","angle":180,"portId":"root"}],"data":{"body":"Compare later summaries and conspiracy claims with the actual documentary record, preserving uncertainty where the sources do not settle a point.","status":"todo","priority":"medium","definitionKey":"task","_bridge":{"sourceNodeId":"operation-northwoods-bridge-task","sourceRef":"github://twilite-zone/public/library/classes/nodes/task-planning/task.node-class.node","entryPort":"root","kind":"node-class","targetKind":"node-class","classKey":"task","classRef":"github://twilite-zone/public/library/classes/nodes/task-planning/task.node-class.node"},"identity":{"graphId":"operation-northwoods-research-plan-declaration"}}},

    {"id":"northwoods-question-kennedy","type":"open-question","label":"Exactly what did Kennedy know and reject?","root":false,"position":{"x":-700,"y":420},"width":420,"height":240,"ports":[{"id":"root","key":"root","label":"root","direction":"bidirectional","dataType":"any","angle":180}],"handles":[{"id":"root","label":"root","direction":"bidirectional","dataType":"any","angle":180,"portId":"root"}],"data":{"body":"Distinguish direct documentary evidence about Kennedy's response from later summaries that may compress several Cuba-policy decisions together.","status":"open","owner":"","resolutionPath":"","prominence":"high","definitionKey":"open-question","_bridge":{"sourceNodeId":"operation-northwoods-bridge-question","sourceRef":"github://twilite-zone/public/library/classes/nodes/task-planning/open-question.node-class.node","entryPort":"root","kind":"node-class","targetKind":"node-class","classKey":"open-question","classRef":"github://twilite-zone/public/library/classes/nodes/task-planning/open-question.node-class.node"},"identity":{"graphId":"operation-northwoods-research-plan-declaration"}}},
    {"id":"northwoods-question-execution","type":"open-question","label":"Were any Northwoods proposals executed?","root":false,"position":{"x":-220,"y":420},"width":420,"height":240,"ports":[{"id":"root","key":"root","label":"root","direction":"bidirectional","dataType":"any","angle":180}],"handles":[{"id":"root","label":"root","direction":"bidirectional","dataType":"any","angle":180,"portId":"root"}],"data":{"body":"Look for evidence of implementation while keeping proposals, related Mongoose covert activity, and unrelated later events analytically separate.","status":"open","owner":"","resolutionPath":"","prominence":"high","definitionKey":"open-question","_bridge":{"sourceNodeId":"operation-northwoods-bridge-question","sourceRef":"github://twilite-zone/public/library/classes/nodes/task-planning/open-question.node-class.node","entryPort":"root","kind":"node-class","targetKind":"node-class","classKey":"open-question","classRef":"github://twilite-zone/public/library/classes/nodes/task-planning/open-question.node-class.node"},"identity":{"graphId":"operation-northwoods-research-plan-declaration"}}},
    {"id":"northwoods-question-significance","type":"open-question","label":"What does Northwoods demonstrate about policy-making?","root":false,"position":{"x":260,"y":420},"width":420,"height":240,"ports":[{"id":"root","key":"root","label":"root","direction":"bidirectional","dataType":"any","angle":180}],"handles":[{"id":"root","label":"root","direction":"bidirectional","dataType":"any","angle":180,"portId":"root"}],"data":{"body":"Assess what the documented willingness of senior officials to propose manufactured pretexts demonstrates, without treating that fact as proof of unrelated claims.","status":"open","owner":"","resolutionPath":"","prominence":"high","definitionKey":"open-question","_bridge":{"sourceNodeId":"operation-northwoods-bridge-question","sourceRef":"github://twilite-zone/public/library/classes/nodes/task-planning/open-question.node-class.node","entryPort":"root","kind":"node-class","targetKind":"node-class","classKey":"open-question","classRef":"github://twilite-zone/public/library/classes/nodes/task-planning/open-question.node-class.node"},"identity":{"graphId":"operation-northwoods-research-plan-declaration"}}},

    {"id":"northwoods-sources","type":"content","label":"Primary Source Anchors","root":false,"position":{"x":-220,"y":800},"width":760,"height":320,"ports":[{"id":"root","key":"root","label":"root","direction":"bidirectional","dataType":"any","angle":180}],"handles":[{"id":"root","label":"root","direction":"bidirectional","dataType":"any","angle":180,"portId":"root"}],"data":{"markdown":"## Starting evidence\n\n- Joint Chiefs of Staff memorandum, **Justification for US Military Intervention in Cuba**, 13 March 1962.\n- Edward Lansdale, **The Cuba Project**, 20 February 1962, for Operation Mongoose context.\n- Follow-on meeting and policy records for the disposition of the proposals.\n- Declassification and archival-release records.\n\n### Research rule\nKeep **proposed**, **approved for planning**, **operationally authorized**, and **executed** visibly distinct."}},

