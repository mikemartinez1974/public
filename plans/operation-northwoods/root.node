    {"id":"northwoods-task-context","type":"task","label":"Reconstruct the Cuba-policy context","root":false,"position":{"x":-700,"y":-260},"width":420,"height":240,"ports":[{"id":"root","key":"root","label":"root","direction":"bidirectional","dataType":"any","angle":180}],"handles":[{"id":"root","label":"root","direction":"bidirectional","dataType":"any","angle":180,"portId":"root"}],"data":{"body":"Place Northwoods inside the post-Bay of Pigs environment, Operation Mongoose, the Cuba Project, and the request that produced the March 1962 memorandum.","status":"todo","priority":"high","definitionKey":"task","_bridge":{"sourceNodeId":"operation-northwoods-bridge-task","sourceRef":"github://twilite-zone/public/library/classes/nodes/task-planning/task.node-class.node","entryPort":"root","kind":"node-class","targetKind":"node-class","classKey":"task","classRef":"github://twilite-zone/public/library/classes/nodes/task-planning/task.node-class.node"},"identity":{"graphId":"operation-northwoods-research-plan-declaration"}}},
    {"id":"northwoods-task-document","type":"task","label":"Map the 13 March 1962 memorandum","root":false,"position":{"x":-220,"y":-260},"width":420,"height":240,"ports":[{"id":"root","key":"root","label":"root","direction":"bidirectional","dataType":"any","angle":180}],"handles":[{"id":"root","label":"root","direction":"bidirectional","dataType":"any","angle":180,"portId":"root"}],"data":{"body":"Map authorship, recipients, stated objective, recommendations, proposed pretexts, and the memorandum's status as planning material.","status":"todo","priority":"high","definitionKey":"task","_bridge":{"sourceNodeId":"operation-northwoods-bridge-task","sourceRef":"github://twilite-zone/public/library/classes/nodes/task-planning/task.node-class.node","entryPort":"root","kind":"node-class","targetKind":"node-class","classKey":"task","classRef":"github://twilite-zone/public/library/classes/nodes/task-planning/task.node-class.node"},"identity":{"graphId":"operation-northwoods-research-plan-declaration"}}},
    {"id":"northwoods-task-chain","type":"task","label":"Trace the approval and rejection chain","root":false,"position":{"x":260,"y":-260},"width":420,"height":240,"ports":[{"id":"root","key":"root","label":"root","direction":"bidirectional","dataType":"any","angle":180}],"handles":[{"id":"root","label":"root","direction":"bidirectional","dataType":"any","angle":180,"portId":"root"}],"data":{"body":"Determine what the Joint Chiefs approved, what was sent to civilian leadership, what reached Kennedy or his advisers, and what evidence establishes the final disposition.","status":"todo","priority":"high","definitionKey":"task","_bridge":{"sourceNodeId":"operation-northwoods-bridge-task","sourceRef":"github://twilite-zone/public/library/classes/nodes/task-planning/task.node-class.node","entryPort":"root","kind":"node-class","targetKind":"node-class","classKey":"task","classRef":"github://twilite-zone/public/library/classes/nodes/task-planning/task.node-class.node"},"identity":{"graphId":"operation-northwoods-research-plan-declaration"}}},
