      "data": {
        "key": "node.web.detail",
        "intent": "node",
        "payload": "node.web.detail",
        "view": {
          "controls": [
            {
              "id": "open-repo-home",
              "type": "button",
              "label": "Open Repo",
              "action": "navigate",
              "url": "github://{{data.owner}}/{{data.repo}}{{data.homeRef}}",
              "variant": "contained",
              "priority": -30,
              "icon": "navigate"
            }
          ]
        },
        "html": "<div style=\"width:100%;height:100%;display:flex;flex-direction:column;gap:16px;padding:18px;box-sizing:border-box;border-radius:22px;background:linear-gradient(180deg,#ffffff,#f8fafc);border:1px solid rgba(15,23,42,0.12);overflow:hidden;\"><div style=\"display:flex;align-items:center;justify-content:space-between;gap:12px;\"><div style=\"display:flex;align-items:center;gap:12px;\"><div style=\"width:56px;height:56px;border-radius:16px;background:#0f172a;display:flex;align-items:center;justify-content:center;box-shadow:inset 0 0 0 1px rgba(255,255,255,0.08);\"><img src=\"https://github.com/{{data.owner}}.png?size=160\" alt=\"{{data.owner}} avatar\" style=\"width:100%;height:100%;object-fit:cover;display:block;border-radius:inherit;\" /></div><div style=\"display:flex;flex-direction:column;gap:4px;\"><div style=\"font:700 12px/1.2 ui-sans-serif,system-ui,sans-serif;letter-spacing:0.08em;text-transform:uppercase;color:#64748b;\">GitHub Repo</div><div style=\"font:800 24px/1.15 ui-sans-serif,system-ui,sans-serif;color:#0f172a;\">{{data.title}}</div></div></div><div style=\"padding:6px 10px;border-radius:999px;background:rgba(59,130,246,0.1);color:#1d4ed8;font:700 11px/1.2 ui-sans-serif,system-ui,sans-serif;letter-spacing:0.06em;text-transform:uppercase;\">{{data.branch}}</div></div><div style=\"display:flex;flex-direction:column;gap:8px;padding:14px 16px;border-radius:18px;background:#0f172a;color:#f8fafc;\"><div style=\"font:700 11px/1.2 ui-sans-serif,system-ui,sans-serif;letter-spacing:0.08em;text-transform:uppercase;color:rgba(248,250,252,0.7);\">Repository Identity</div><div style=\"font:700 18px/1.25 ui-monospace,SFMono-Regular,monospace;color:#f8fafc;\">{{data.owner}}/{{data.repo}}</div><div style=\"font:500 12px/1.45 ui-monospace,SFMono-Regular,monospace;color:rgba(248,250,252,0.82);\">github://{{data.owner}}/{{data.repo}}</div></div><div style=\"display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:12px;\"><div style=\"padding:14px;bor