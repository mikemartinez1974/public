        "name": "Public Repo Home Declaration",
        "declaresKind": "graph",
        "purpose": "Declare the identity, public-facing intent, structural dependencies, and default surface for the public repository home graph.",
        "summary": "This declaration describes the public repository as a curated front door rather than a general workspace. It exists to expose one clear landing surface, support navigable invitations into selected artifacts, and keep the graph's publishing posture legible to humans, agents, and tools.",
        "audience": "Public",
        "functionalRole": "repo-home",
        "declaration": {
          "kind": "graph",
          "graphViewRole": "publishing",
          "targetMode": "artifact",
          "defaultSurfaceId": "root",
          "surfaces": [],
          "notes": [
            "This graph functions as the public front door for the repository.",
            "Portals in this graph are invitations into selected public artifacts, not a dump of every available file.",
            "The declaration should stay aligned with the actual node vocabulary used by the graph."
          ],
          "interfaceContract": {
            "version": 1,
            "implicitRootPort": true
          },
          "sharedPresentation": {
            "detailViewNodeId": "release-public-atelier-detail-view",
            "summaryViewNodeId": "release-public-atelier-summary-view",
            "iconViewNodeId": "release-public-atelier-icon-view",
            "glyphNodeId": "release-public-atelier-glyph"
          },
          "primaryNodeViewId": "release-public-atelier-detail-view",
          "iconViewNodeId": "release-public-atelier-icon-view"
        },
