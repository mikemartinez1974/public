        "identity": {
          "graphId": "studio"
        },
        "content": {
          "kind": "markdown",
          "value": "# The Studio\n\nThe public room of a studio. What is shown here is graphs, and you can open any of them.\n\n- **Projects**: the things being built, and where each stands.\n- **News**: what is new, newest first.\n- **Release notes**: what changed in each release of Twilite.\n\nThe ideas, plans and tasks behind the work are kept in a private workroom.\n\nNew to Twilite? **Start with your AI** is the quickest way in. To reach the maker: dev@twilite.zone."
        },
        "_placement": {
          "version": 1,
          "state": "manually-shaped",
          "source": "manual",
          "updatedAt": 1791502752029,
          "reason": "node-drag"
        }
      }
    },
    {
      "id": "studio-derive-method",
      "type": "method",
      "label": "Derive the library views",
      "position": {
        "x": -627,
        "y": -625
      },
      "width": 420,
      "height": 260,
      "ports": [
        {
          "id": "call",
          "key": "call",
          "label": "Call",
          "direction": "input",
          "dataType": "event",
          "angle": 180
        },
        {
          "id": "result",
          "key": "result",
          "label": "Result",
          "direction": "output",
          "dataType": "value",
          "angle": 0
        }
      ],
      "handles": [
        {
          "id": "call",
          "key": "call",
          "label": "Call",
          "direction": "input",
          "dataType": "event",
          "angle": 180,
          "portId": "call"
        },
        {
          "id": "result",
          "key": "result",
          "label": "Result",
          "direction": "output",
          "dataType": "value",
          "angle": 0,
          "portId": "result"
        }
      ],
      "visible": true,
      "showLabel": true,
      "data": {
        "scriptName": "Derive the library views",
        "parameters": [],
        "effects": [
          {
            "kind": "update-node",
            "targets": [
              "studio-detail",
              "studio-summary",
              "studio-glyph",
              "studio-declaration",
              "studio-library",
              "studio-environment"
            ]
          }
        ],
        "allowMutations": true,
        "dryRun": false,
        "identity": {
          "graphId": "studio-declaration"
        },
        "source": "// Derives the library's views from what it holds and says about itself: nothing is typed into a summary. A library is a Collection of shelves\n// (each shelf a graph it contains through a portal) plus where it lives, what it is for, who it is for and where to start.\n// A member is a graph the collection holds, and nothing in the collection graph is one unless it was made one. There are two ways:\n//   - a Portal the collection contains (a `contains` edge from its members port);\n//   - a graph in its own folder, when it says so (data.includeFolder), for an address the host can list (github://).\n// The members are the union, without repeats. The member graphs are read through api.readGraph, which returns what the app has already\n// loaded to open them. The Method writes the Detail, the Summary and the Glyph, the size of the Detail and Summary (the Detail stretches\n// with its rows, up to a square), the window that holds them, and a line on the collection saying where its members come from.\nconst clean = (value) => String(value ?? '').trim();\nconst esc = (value) => clean(value)\n  .replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/\"/g, '&quot;').replace(/'/g, '&#39;');\nconst INK = '#6d28d9';\nconst MAX_READ = 100;\n\nconst nodes = await api.getNodes();\nconst edges = await api.getEdges();\nconst byId = new Map(nodes.map((node) => [node.id, node]));\nconst root = nodes.find((node) => clean(node.type) === 'root');\nconst collection = nodes.find((node) => clean(node.type) === 'repo');\nconst title = clean(collection?.data?.title || collection?.label) || 'Collection';\nconst sort = ['name', 'kind'].includes(clean(collection?.data?.sort)) ? clean(collection.data.sort) : 'order';\n\nconst keyOf = (address) => clean(address).replace(/#.*$/, '').replace(/^https?:\\/\\/twilite\\.zone\\//i, 'tlz://twilite.zone/');\n\n// The portals the collection contains, in the order of their edges.\nconst portals = edges\n  .filter((edge) => clean(edge.type) === 'contains' && collection && edge.source === collection.id)\n  .map((edge) => byId.get(edge.target))\n  .filter((node) => node && clean(node.type) === 'portal');\nconst refOf = (portal) => clean(portal.data?.target?.ref || portal.data?.sourceRef || portal.data?.ref);\n\n// The folder: the graphs one level below the folder this collection's own root sits in, for a collection the host can list.\nconst includeFolder = collection?.data?.includeFolder === true;\nlet folderAddresses = [];\nlet folderNote = '';\nif (includeFolder) {\n  const own = clean(root?.data?.document?.url);\n  const where = /^github:\\/\\/([^/]+)\\/([^/]+)\\/(?:(.*)\\/)?[^/]+$/.exec(own);\n  if (!where) {\n    folderNote = /^(tlz|https?):/i.test(own) ? 'a published site cannot list its folders' : 'this graph has no github:// address to list';\n  } else {\n    const [, owner, repository, directory = ''] = where;\n    try {\n      const entries = await api.listRepositoryDirectory({ repo: `${owner}/${repository}`, path: directory, branch: 'main' });\n      folderAddresses = entries.filter((entry) => clean(entry.type) === 'dir' && clean(entry.name))\n        .sort((a, b) => clean(a.name).localeCompare(clean(b.name)))\n        .map((entry) => `github://${owner}/${repository}/${[directory, clean(entry.name)].filter(Boolean).join('/')}/root.node`);\n    } catch (error) { folderNote = `the folder could not be listed (${clean(error?.message) || 'no reason given'})`; }\n  }\n}\n\n// The union, without repeats: the portals in their order, then the folder.\nconst entries = [];\nconst seen = new Set();\nconst add = (address, from, portal = null) => {\n  const key = keyOf(address) || `portal:${portal?.id}`;\n  if (seen.has(key)) return;\n  seen.add(key);\n  entries.push({ address, from, portal });\n};\nportals.forEach((portal) => add(refOf(portal), 'portal', portal));\nfolderAddresses.forEach((address) => add(address, 'folder'));\n\nconst kindWords = (kind) => { const words = clean(kind).replace(/-/g, ' '); return words ? words[0].toUpperCase() + words.slice(1) : 'Graph'; };\nconst slugOf = (address) => { const parts = clean(address).replace(/#.*$/, '').split('/').filter(Boolean); const last = parts[parts.length - 1] || ''; return /\\.node$/.test(last) && parts.length > 1 ? parts[parts.length - 2] : last; };\n\n// What a tile says about a member comes from the member itself: its name, its description (or its kind when it has none) and the\n// colour of its own glyph. Only the first MAX_READ are read, so a large folder does not read every graph in it; the rest show their\n// folder's name. A graph found in the folder that cannot be read is not a graph, and is left out.\n// A member's own Summary view: the face of its Surface chain whose level is summary, when it holds plain html (no template syntax, no scripts).\nconst summaryOf = (graph, rootNode) => {\n  const links = Array.isArray(graph.edges) ? graph.edges : [];\n  const faceById = new Map(graph.nodes.filter((node) => clean(node.type) === 'face').map((node) => [node.id, node]));\n  const chain = [];\n  let at = faceById.get(links.find((edge) => clean(edge.type) === 'surface' && edge.source === rootNode.id)?.target);\n  while (at && chain.length < 8 && !chain.includes(at)) { chain.push(at); at = faceById.get(links.find((edge) => clean(edge.type) === 'next-face' && edge.source === at.id)?.target); }\n  const face = chain.find((node) => clean(node.data?.semanticLevel) === 'summary');\n  const html = face?.data?.content?.kind === 'html' ? String(face.data.content.value || '') : '';\n  return html && !/\\{\\{|<script/i.test(html) ? html : '';\n};\nconst factsOf = async (entry, index) => {\n  let graph = null;\n  if (entry.address && index < MAX_READ) { try { graph = await api.readGraph(entry.address); } catch (error) { graph = null; } }\n  const found = Array.isArray(graph?.nodes);\n  const items = found ? graph.nodes : [];\n  const rootNode = items.find((node) => clean(node.type) === 'root');\n  const glyph = items.find((node) => clean(node.type) === 'glyph')?.data?.glyph;\n  const name = clean(rootNode?.data?.identity?.name) || clean(entry.portal?.label) || slugOf(entry.address) || entry.address;\n  const kind = kindWords(rootNode?.data?.intent?.kind);\n  // How many graphs the shelf holds: the portals its own collection contains.\n  const holder = items.find((node) => ['collection', 'repo'].includes(clean(node.type)));\n  const graphs = holder ? (found ? graph.edges || [] : []).filter((edge) => clean(edge.type) === 'contains' && edge.source === holder.id && items.some((node) => node.id === edge.target && clean(node.type) === 'portal')).length : 0;\n  const lift = found && rootNode ? summaryOf(graph, rootNode) : '';\n  return { lift, ref: entry.address, from: entry.from, dropped: entry.from === 'folder' && index < MAX_READ && !found, name, kind, graphs,\n    description: clean(rootNode?.data?.identity?.description) || kind, tint: /^#[0-9a-f]{6}$/i.test(clean(glyph?.color)) ? clean(glyph.color) : INK };\n};\nlet members = (await Promise.all(entries.map(factsOf))).filter((member) => !member.dropped);\nif (sort === 'name') members = [...members].sort((a, b) => a.name.localeCompare(b.name));\nif (sort === 'kind') members = [...members].sort((a, b) => a.kind.localeCompare(b.kind) || a.name.localeCompare(b.name));\nconst count = members.length;\nconst countText = `${count} ${count === 1 ? 'graph' : 'graphs'}`;\n\n// Where the members come from, for the collection's editor to show.\nconst fromFolder = members.filter((member) => member.from === 'folder').length;\nconst sources = [\n  portals.length ? `${portals.length} portal${portals.length === 1 ? '' : 's'}` : '',\n  includeFolder && !folderNote ? `${fromFolder} in the folder` : '',\n  `${count} member${count === 1 ? '' : 's'}`\n].filter(Boolean).join(' · ');\nconst problems = [folderNote ? `folder: ${folderNote}` : ''].filter(Boolean);\nconst sourcesLine = problems.length ? `${sources} (${problems.join('; ')})` : sources;\nif (collection && clean(collection.data?.sourcesSummary) !== sourcesLine) await api.updateNode(collection.id, { data: { ...collection.data, sourcesSummary: sourcesLine } });\n\n// The facts about the library itself: where it lives, what it is for, who it is for, and where to start.\nconst data = collection?.data || {};\nconst owner = clean(data.owner);\nconst repository = clean(data.repo);\nconst branch = clean(data.branch) || 'main';\nconst readFrom = clean(data.readFrom) === 'site' ? 'site' : 'github';\nconst published = data.published === true;\nconst startPortal = nodes.find((node) => clean(node.type) === 'portal' && clean(node.data?.role) === 'start-here');\nconst startRef = refOf(startPortal) || clean(data.startHere) || clean(members[0]?.ref);\nconst totalGraphs = members.reduce((sum, member) => sum + (member.graphs || 0), 0);\nconst shelfText = `${count} ${count === 1 ? 'shelf' : 'shelves'}`;\nconst graphsText = `${totalGraphs} ${totalGraphs === 1 ? 'graph' : 'graphs'}`;\nconst readText = readFrom === 'site' ? `read from ${clean(data.host) || 'a site'}${published ? '' : ', not published'}` : 'read from GitHub, through the app';\nconst where = [owner, repository].filter(Boolean).join('/') || 'owner/repository';\n\n// The Detail is 100cqw wide. It starts at the regular 3:2 and stretches with its rows up to a square; beyond that the shelves scroll.\nconst TILE = 17; const GAP = 1.4; const MIN_TILE = 26.2; const PAD = 4; const HEAD = 36;\nconst columns = Math.max(2, Math.floor((100 - 2 * PAD + GAP) / (MIN_TILE + GAP)));\nconst rows = Math.ceil(count / columns);\nconst need = 2 * PAD + HEAD + (rows ? rows * (TILE + GAP) : 22);\nconst ratio = Math.min(1, Math.max(2 / 3, need / 100));\nconst DETAIL_WIDTH = 600; const SUMMARY_WIDTH = 480;\nconst MONO = 'ui-monospace,SFMono-Regular,Menlo,Consolas,monospace';\n\nconst frame = (inner, style) => `<div style='container-type:inline-size;width:100%;height:100%'><div style='box-sizing:border-box;width:100%;height:100%;font-family:system-ui,-apple-system,Segoe UI,sans-serif;${style}'>${inner}</div></div>`;\nconst tile = (member) => `<a href='${esc(member.ref)}' style='display:flex;gap:2.2cqw;align-items:flex-start;box-sizing:border-box;height:${TILE}cqw;padding:1.6cqw 2.1cqw;border:1px solid #e2e8f0;border-radius:2.4cqw;background:#f8fafc;text-decoration:none;color:inherit;min-width:0;overflow:hidden'>`\n  + `<span style='flex:none;width:6.2cqw;height:6.2cqw;border-radius:1.6cqw;background:${member.tint}22;color:${member.tint};display:flex;align-items:center;justify-content:center;font-weight:600;font-size:3cqw'>${esc(member.name.slice(0, 1).toUpperCase())}</span>`\n  + `<span style='min-width:0'><span style='display:block;font-weight:600;font-size:2.9cqw;line-height:1.25;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;color:#0f172a'>${esc(member.name)}</span>`\n  + `<span style='display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden;font-size:2.6cqw;line-height:1.3;color:#64748b'>${esc(member.description)}</span>`\n  + `<span style='display:block;margin-top:.6cqw;font-size:2.4cqw;font-weight:600;color:${INK}'>${member.graphs} ${member.graphs === 1 ? 'graph' : 'graphs'}</span></span></a>`;\nconst body = count\n  ? `<div style='display:grid;grid-template-columns:repeat(auto-fill,minmax(${MIN_TILE}cqw,1fr));gap:${GAP}cqw;align-content:start'>${members.map(tile).join('')}</div>`\n  : `<div style='display:flex;flex-direction:column;align-items:center;justify-content:center;gap:1.4cqw;min-height:22cqw;border:1px dashed #cbd5e1;border-radius:2.4cqw;color:#64748b;font-size:2.8cqw;text-align:center;padding:2cqw'><span style='font-weight:600;color:#0f172a'>No shelves yet</span><span>A shelf is a collection this library contains. Add a portal to one and connect it.</span></div>`;\nconst start = startRef ? `<a href='${esc(startRef)}' style='align-self:flex-start;margin-top:.4cqw;padding:1.1cqw 2.8cqw;border-radius:6cqw;background:${INK};color:#ffffff;font-size:2.8cqw;font-weight:600;text-decoration:none'>Start here →</a>` : '';\nconst detail = frame(\n  `<div style='display:flex;flex-direction:column;gap:.9cqw'><div style='font-size:2.2cqw;font-weight:600;letter-spacing:.08em;text-transform:uppercase;color:${INK}'>Library</div>`\n  + `<div style='font-weight:600;font-size:4.6cqw;line-height:1.2;color:#0f172a'>${esc(title)}</div>`\n  + `<div style='font-size:2.6cqw;font-family:${MONO};color:${INK}'>${esc(where)} · ${esc(branch)}</div>`\n  + `<div style='font-size:2.4cqw;color:#64748b'>${esc(readText)}</div>`\n  + (clean(data.body) ? `<div style='font-size:2.9cqw;line-height:1.4;color:#334155'>${esc(data.body)}</div>` : '')\n  + (clean(data.audience) ? `<div style='font-size:2.5cqw;line-height:1.35;color:#64748b'>${esc(data.audience)}</div>` : '')\n  + `${start}</div>`\n  + `<div style='flex:1;min-height:0;overflow:auto'>${body}</div>`,\n  `padding:${PAD}cqw;border-radius:3cqw;background:#ffffff;border:1px solid #e2e8f0;display:flex;flex-direction:column;gap:2cqw`\n);\n// The shelf: the shelves' own Summary views at one fixed size, in a row that scrolls. Its scrollbar is the plank, and it is visible: the app lets the\n// wheel and a press scroll only what has a scrollbar under the pointer, so a shelf with none could not be scrolled at all. Each stands in a box that is its own container, so what it\n// draws in its own units is drawn at the size of its box. A click on a shelf goes to it. A shelf with no Summary of its own is a plain card.\nconst SHELF_MAX = 20; const ITEM_W = 39.6; const ITEM_H = 26.4; const ITEM_GAP = 2.5; const SHELF_PAD = 5;\nconst stand = (member) => {\n  const inner = member.lift || `<div style='box-sizing:border-box;width:100%;height:100%;padding:5cqw;border:1px solid #e2e8f0;border-radius:5cqw;background:#ffffff;font-family:system-ui,sans-serif;overflow:hidden'><div style='font-size:3.4cqw;font-weight:600;letter-spacing:.08em;text-transform:uppercase;color:${member.tint}'>${esc(member.kind)}</div><div style='margin-top:2cqw;font-size:6.4cqw;font-weight:600;line-height:1.2;color:#0f172a'>${esc(member.name)}</div></div>`;\n  return `<div style='position:relative;flex:none;width:${ITEM_W}cqw;height:${ITEM_H}cqw;scroll-snap-align:start'><div style='container-type:inline-size;width:100%;height:100%'>${inner}</div><a href='${esc(member.ref)}' title='${esc(member.name)}' aria-label='${esc(member.name)}' style='position:absolute;inset:0'></a></div>`;\n};\nconst more = count > SHELF_MAX ? `<div style='flex:none;width:${ITEM_W / 2}cqw;height:${ITEM_H}cqw;display:flex;align-items:center;justify-content:center;color:#64748b;font-size:3.6cqw'>and ${count - SHELF_MAX} more</div>` : '';\nconst fits = Math.floor((100 - SHELF_PAD + ITEM_GAP) / (ITEM_W + ITEM_GAP));\nconst shelf = count\n  ? `<div style='position:relative;margin:auto -${SHELF_PAD}cqw'><div style='display:flex;align-items:flex-end;gap:${ITEM_GAP}cqw;overflow-x:auto;overflow-y:hidden;padding:0 ${SHELF_PAD}cqw;scroll-snap-type:x proximity;scroll-padding:0 ${SHELF_PAD}cqw;scrollbar-width:thin;scrollbar-color:#64748b #cbd5e1'>${members.slice(0, SHELF_MAX).map(stand).join('')}${more}</div>${count > fits ? \"<div style='position:absolute;right:0;top:0;bottom:12px;width:6cqw;pointer-events:none;background:linear-gradient(270deg,#ffffff,rgba(255,255,255,0))'></div>\" : ''}</div>`\n  : `<div style='margin-top:auto;display:flex;align-items:center;justify-content:center;height:${ITEM_H}cqw;border:1px dashed #cbd5e1;border-radius:3cqw;color:#64748b;font-size:3.6cqw'>No shelves yet. Add a collection with a portal.</div>`;\nconst summary = frame(\n  `<div style='display:flex;justify-content:space-between;align-items:flex-end;gap:2cqw'><div style='min-width:0'><div style='font-size:2.8cqw;font-weight:600;letter-spacing:.08em;text-transform:uppercase;color:${INK}'>Library</div><div style='font-weight:600;font-size:5.4cqw;line-height:1.2;color:#0f172a;white-space:nowrap;overflow:hidden;text-overflow:ellipsis'>${esc(title)}</div><div style='font-size:3cqw;font-family:${MONO};color:${INK};white-space:nowrap;overflow:hidden;text-overflow:ellipsis'>${esc(where)}</div></div><div style='font-size:3.4cqw;color:#475569;white-space:nowrap;text-align:right'>${shelfText} · ${graphsText}</div></div>` + shelf,\n  `padding:${SHELF_PAD}cqw;border-radius:4cqw;background:#ffffff;border:1px solid #e2e8f0;display:flex;flex-direction:column;gap:2cqw;overflow:hidden`\n);\n\nconst faces = nodes.filter((node) => clean(node.type) === 'face');\nconst faceFor = (level) => faces.find((node) => clean(node.data?.semanticLevel) === level);\nconst glyph = nodes.find((node) => clean(node.type) === 'glyph');\nconst detailFace = faceFor('detail');\nconst summaryFace = faceFor('summary');\nconst size = (face, width) => ({ width, height: Math.round(width * ratio) });\nif (detailFace) {\n  await api.updateView(detailFace.id, { content: { kind: 'html', value: detail }, view: { ...(detailFace.data?.view || {}), scroll: 'page' } });\n  await api.updateNode(detailFace.id, size(detailFace, DETAIL_WIDTH));\n}\nif (summaryFace) {\n  await api.updateView(summaryFace.id, { content: { kind: 'html', value: summary } });\n  await api.updateNode(summaryFace.id, size(summaryFace, SUMMARY_WIDTH));\n}\nif (glyph) await api.updateNode(glyph.id, { data: { ...glyph.data, glyph: { kind: 'icon', name: 'LibraryBooks', color: INK } } });\n\n// The environment is the Poster page: the library's name set large, where it lives, a stage the graph stands on, and the routes along the foot. The window is\n// the page's own shape, sized so that the stage holds the nodes you see when browsing, with those nodes centred on it. The nodes that are only there to edit\n// sit in the band above the stage, under the headline, and are hidden when browsing. The environment takes no pointer, so a click on one of its routes reaches the\n// canvas behind it, which follows the link (followEnvironmentLink in the app); the shelves are also opened through their portals on the stage.\nconst EDITOR_ONLY = new Set(['root', 'face', 'glyph', 'import', 'export', 'method', 'script']);\nconst shown = nodes.filter((node) => node.position && node.visible !== false && !EDITOR_ONLY.has(clean(node.type)));\nconst envFace = faces.find((node) => clean(node.data?.view?.payload) === 'node.web.environment');\nif (root && shown.length) {\n  const left = Math.min(...shown.map((node) => node.position.x)); const top = Math.min(...shown.map((node) => node.position.y));\n  const right = Math.max(...shown.map((node) => node.position.x + node.width)); const bottom = Math.max(...shown.map((node) => node.position.y + node.height));\n  const STAGE_X = 4; const STAGE_W = 92; const STAGE_Y = 27.6; const FOOT = 8.9; const STAGE_H = 100 * ratio - STAGE_Y - FOOT; const PAD = 80;\n  const w = Math.round(Math.max((right - left + 2 * PAD) / (STAGE_W / 100), (bottom - top + 2 * PAD) / (STAGE_H / 100)));\n  const h = Math.round(w * ratio);\n  const x0 = Math.round((left + right) / 2 - w / 2);\n  const y0 = Math.round((top + bottom) / 2 - (STAGE_Y + STAGE_H / 2) / 100 * w);\n  if (envFace) {\n    const GOLD = '#f5c542'; const PAPER = '#1b3a6b'; const LINE = '#2a5aa0';\n    const lineAt = (percent, width) => `color-mix(in srgb,${LINE} ${percent}%,transparent) ${width}cqw,transparent ${width}cqw`;\n    const grid = `linear-gradient(${lineAt(26, 0.12)}),linear-gradient(90deg,${lineAt(26, 0.12)}),linear-gradient(${lineAt(12, 0.08)}),linear-gradient(90deg,${lineAt(12, 0.08)})`;\n    const headSize = title.length <= 9 ? 10.5 : title.length <= 14 ? 8.4 : title.length <= 20 ? 6.6 : 5.2;\n    const subTop = 6.4 + headSize * 0.9 + 2.2;\n    const line = clean(data.body) || 'A library kept in a repository: shelves of graphs, laid out the way a graph should be.';\n    const label = (route) => `<a href='${esc(route.ref)}' style='color:inherit;text-decoration:none'>${esc(route.text)} →</a>`;\n    const routes = [startRef ? { text: 'Start here', ref: startRef } : null, ...members.slice(0, 4).map((member) => ({ text: member.name, ref: member.ref }))].filter((route) => route && clean(route.ref));\n    const page = `<div style='container-type:inline-size;width:100%;height:100%'><div style='position:relative;box-sizing:border-box;width:100%;height:100%;overflow:hidden;background-color:${PAPER};background-image:${grid};background-size:10cqw 10cqw,10cqw 10cqw,2cqw 2cqw,2cqw 2cqw;font-family:Inter,system-ui,Segoe UI,Helvetica Neue,Arial,sans-serif;color:#ffffff'>`\n      + `<div style='position:absolute;left:4cqw;top:3.6cqw;font:800 1.5cqw/1.2 Inter,system-ui,sans-serif;letter-spacing:.2em;text-transform:uppercase;color:${GOLD}'>Library</div>`\n      + `<div style='position:absolute;left:4cqw;right:4cqw;top:6.4cqw;font:800 ${headSize}cqw/.9 Archivo Black,Impact,Haettenschweiler,Arial Black,sans-serif;letter-spacing:-.03em;white-space:nowrap;overflow:hidden;text-overflow:ellipsis'>${esc(title)}</div>`\n      + `<div style='position:absolute;left:4cqw;right:4cqw;top:${subTop}cqw;font:400 2.5cqw/1.3 Inter,system-ui,sans-serif;color:#cfe0ff;white-space:nowrap;overflow:hidden;text-overflow:ellipsis'>${esc(line)}</div>`\n      + `<div style='position:absolute;left:4cqw;top:${STAGE_Y - 4.6}cqw;font:400 1.7cqw/1 ui-monospace,SFMono-Regular,Menlo,Consolas,monospace;color:${GOLD}'>${esc(where)} · ${esc(branch)}</div>`\n      + `<div style='position:absolute;left:${STAGE_X}cqw;top:${STAGE_Y}cqw;width:${STAGE_W}cqw;height:${STAGE_H}cqw;box-sizing:border-box;border-radius:2cqw;background:color-mix(in srgb,${GOLD} 7%,${PAPER});border:.3cqw solid color-mix(in srgb,${GOLD} 28%,${PAPER})'></div>`\n      + `<div style='position:absolute;left:4cqw;right:4cqw;bottom:3.4cqw;display:flex;gap:3cqw;font:700 1.9cqw/1.2 Inter,system-ui,sans-serif;color:${GOLD};white-space:nowrap;overflow:hidden'>${routes.map(label).join('')}</div>`\n      + `</div></div>`;\n    await api.updateView(envFace.id, { content: { kind: 'html', value: page }, view: { ...(envFace.data?.view || {}), fit: 'window' } });\n  }\n  await api.updateNode(root.id, { data: { ...root.data, membrane: { ...(root.data?.membrane || {}), bounds: { x: x0, y: y0, width: w, height: h } } } });\n}\nreturn { shelves: count, graphs: totalGraphs, columns, rows, ratio: Math.round(ratio * 1000) / 1000 };\n"
      }
    },
