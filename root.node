    },
    {
      "id": "public-civic-face",
      "type": "section",
      "label": "Civic Face",
      "root": false,
      "position": {
        "x": -980,
        "y": 260
      },
      "width": 420,
      "height": 280,
      "visible": true,
      "showLabel": true,
      "data": {
        "title": "Publish only what is ready to be read",
        "summary": "This repository should hold work that can stand in daylight: clear documents, reliable examples, reusable node classes, and artifacts that represent the taste of the system well. Public does not mean exhaustive. It means chosen.",
        "level": "h2",
        "anchor": "publish-only",
        "status": "active"
      }
    },
    {
      "id": "public-signals",
      "type": "section",
      "label": "Signals",
      "root": false,
      "position": {
        "x": -500,
        "y": 260
      },
      "width": 420,
      "height": 280,
      "visible": true,
      "showLabel": true,
      "data": {
        "title": "Signal taste through structure",
        "summary": "Treat the public repo as a front door. It should communicate discipline through naming, hierarchy, visual polish, and explanatory strength. Let the public surface tell people what Twilite values before they read a line of implementation detail.",
        "level": "h2",
        "anchor": "signals",
        "status": "active"
      }
    },
    {
      "id": "public-invitation",
      "type": "section",
      "label": "Invitation",
      "root": false,
      "position": {
        "x": -20,
        "y": 260
      },
      "width": 420,
      "height": 280,
      "visible": true,
      "showLabel": true,
      "data": {
        "title": "Use public to invite, not to dump",
        "summary": "Publish patterns, examples, notes, and interfaces that invite collaborators into the world. The public layer should be hospitable and persuasive. It should never feel like a storage bucket for everything that happened to compile.",
        "level": "h2",
        "anchor": "invitation",
        "status": "active"
      }
    },
