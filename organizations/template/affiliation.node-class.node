        "renderShape": {
          "kind": "html"
        },
        "html": "<article style=\"width:100%;height:100%;box-sizing:border-box;padding:20px;border-radius:20px;background:linear-gradient(135deg,#ede9fe,white);border:1px solid #7c3aed44;color:#172033;font-family:ui-sans-serif,system-ui,sans-serif;overflow:auto\"><div style=\"font-size:11px;font-weight:800;letter-spacing:.12em;text-transform:uppercase;color:#7c3aed\">{{data.affiliationType}}</div><h2 style=\"margin:8px 0 12px;font-size:24px\">{{data.title}}</h2><div style=\"white-space:pre-wrap;line-height:1.55;color:#334155;margin-bottom:12px\">{{data.description}}</div><div style=\"display:grid;grid-template-columns:132px 1fr;gap:10px;padding:7px 0;border-top:1px solid rgba(100,116,139,.14)\"><strong style=\"font-size:11px;letter-spacing:.06em;text-transform:uppercase;color:#64748b\">Subject</strong><span style=\"font-size:13px;line-height:1.45;overflow-wrap:anywhere\">{{data.subjectRef}}</span></div><div style=\"display:grid;grid-template-columns:132px 1fr;gap:10px;padding:7px 0;border-top:1px solid rgba(100,116,139,.14)\"><strong style=\"font-size:11px;letter-spacing:.06em;text-transform:uppercase;color:#64748b\">Organization</strong><span style=\"font-size:13px;line-height:1.45;overflow-wrap:anywhere\">{{data.organizationRef}}</span></div><div style=\"display:grid;grid-template-columns:132px 1fr;gap:10px;padding:7px 0;border-top:1px solid rgba(100,116,139,.14)\"><strong style=\"font-size:11px;letter-spacing:.06em;text-transform:uppercase;color:#64748b\">Role</strong><span style=\"font-size:13px;line-height:1.45;overflow-wrap:anywhere\">{{data.roleRef}}</span></div><div style=\"display:grid;grid-template-columns:132px 1fr;gap:10px;padding:7px 0;border-top:1px solid rgba(100,116,139,.14)\"><strong style=\"font-size:11px;letter-spacing:.06em;text-transform:uppercase;color:#64748b\">Start</strong><span style=\"font-size:13px;line-height:1.45;overflow-wrap:anywhere\">{{data.startDate}}</span></div><div style=\"display:grid;grid-template-columns:132px 1fr;gap:10px;padding:7px 0;border-top:1px solid rgba(100,116,139,.14)\"><strong style=\"font-size:11px;letter-spacing:.06em;text-transform:uppercase;color:#64748b\">End</strong><span style=\"font-size:13px;line-height:1.45;overflow-wrap:anywhere\">{{data.endDate}}</span></div><div style=\"display:grid;grid-template-columns:132px 1fr;gap:10px;padding:7px 0;border-top:1px solid rgba(100,116,139,.14)\"><strong style=\"font-size:11px;letter-spacing:.06em;text-transform:uppercase;color:#64748b\">Status</strong><span style=\"font-size:13px;line-height:1.45;overflow-wrap:anywhere\">{{data.status}}</span></div></article>"
