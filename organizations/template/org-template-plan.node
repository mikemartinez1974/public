          }
        }
      ],
      "visible": true,
      "showLabel": true,
      "data": {
        "markdown": "# Relationship-Centered Model\n\nAn organization's meaning comes largely from its connections.\n\n## Common outgoing relationships\n\n- Led by → Person\n- Founded by → Person\n- Employs → Person\n- Owns → Organization or Offering\n- Subsidiary of → Organization\n- Partnered with → Organization\n- Member of → Organization\n- Operates → Program or Offering\n- Produces → Work or Offering\n- Headquartered in → Place\n- Participated in → Event\n- Published → Work\n\nThese should not become embedded arrays on the organization node.\n\nThe template should encourage explicit graph relationships, with `affiliation` used where dates, titles, status, or evidence are important.",
        "memo": "",
        "link": "",
        "visibilityRole": "browser",
        "_placement": {
          "version": 1,
          "state": "auto-placed",
          "source": "create",
          "updatedAt": 1784473618170,
          "reason": "node-batch-create"
        }
      }
    },
