            "offset": 0.5
          }
        }
      ],
      "visible": true,
      "showLabel": true,
      "data": {
        "markdown": "# Design Principles\n\n## Reuse before invention\n\nThe Organization Template should reuse the Person Template's existing semantic vocabulary rather than creating a parallel universe of nearly identical node classes.\n\n## Keep the canonical node restrained\n\nThe organization node identifies the entity. It should not become a giant record containing every executive, subsidiary, product, event, and relationship.\n\n## Put meaning in the graph\n\nLeadership, ownership, affiliation, activity, and structure should be represented through nodes and relationships.\n\n## Start broad, specialize later\n\nIntroduce specialized classes only when real organization graphs demonstrate that the broader vocabulary is insufficient.",
        "memo": "",
        "link": "",
        "visibilityRole": "browser",
        "_placement": {
          "version": 1,
          "state": "auto-placed",
          "source": "create",
          "updatedAt": 1784473618170,
          "reason": "node-batch-create"
        }
      }
    },
