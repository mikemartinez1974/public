      ],
      "visible": true,
      "showLabel": true,
      "data": {
        "markdown": "# 🏛️ Organization Template\n\nA declaration-first starter graph for representing persistent collective entities such as companies, governments, nonprofits, universities, political organizations, agencies, foundations, and open-source projects.\n\nThe template should remain a close sibling of the Person Template. It should reuse the existing research vocabulary wherever possible and introduce only the organization-specific concepts that are genuinely necessary.\n\n> An organization is a persistent collective entity with identity, structure, participants, activities, outputs, history, and relationships.",
        "memo": "",
        "link": "",
        "visibilityRole": "browser",
        "_placement": {
          "version": 1,
          "state": "auto-placed",
          "source": "create",
          "updatedAt": 1784473618170,
          "reason": "node-batch-create"
        }
      }
    },
