        "html": "<article style=\"width:100%;height:100%;box-sizing:border-box;padding:20px;border-radius:20px;background:linear-gradient(135deg,#ccfbf1,white);border:1px solid #0f766e44;color:#172033;font-family:ui-sans-serif,system-ui,sans-serif;overflow:auto\"><div style=\"display:flex;gap:18px;align-items:flex-start\"><img src=\"{{data.logo}}\" alt=\"Logo of {{data.commonName}}\" style=\"width:112px;height:112px;object-fit:contain;border-radius:16px;background:white;border:1px solid #0f766e33\"/><div><div style=\"font-size:11px;font-weight:800;letter-spacing:.12em;text-transform:uppercase;color:#0f766e\">{{data.organizationType}}</div><h2 style=\"margin:7px 0 6px;font-size:26px;line-height:1.15\">{{data.commonName}}</h2><div style=\"font-size:13px;color:#64748b\">{{data.officialName}}</div><div style=\"margin-top:8px;font-weight:800;color:#0f766e\">{{data.acronym}}</div></div></div><div style=\"margin:14px 0;white-space:pre-wrap;line-height:1.55;color:#334155\">{{data.description}}</div><div style=\"display:grid;grid-template-columns:132px 1fr;gap:10px;padding:7px 0;border-top:1px solid rgba(100,116,139,.14)\"><strong style=\"font-size:11px;letter-spacing:.06em;text-transform:uppercase;color:#64748b\">Founded</strong><span style=\"font-size:13px;line-height:1.45;overflow-wrap:anywhere\">{{data.foundedDate}}</span></div><div style=\"display:grid;grid-template-columns:132px 1fr;gap:10px;padding:7px 0;border-top:1px solid rgba(100,116,139,.14)\"><strong style=\"font-size:11px;letter-spacing:.06em;text-transform:uppercase;color:#64748b\">Dissolved</strong><span style=\"font-size:13px;line-height:1.45;overflow-wrap:anywhere\">{{data.dissolvedDate}}</span></div><div style=\"display:grid;grid-template-columns:132px 1fr;gap:10px;padding:7px 0;border-top:1px solid rgba(100,116,139,.14)\"><strong style=\"font-size:11px;letter-spacing:.06em;text-transform:uppercase;color:#64748b\">Legal status</strong><span style=\"font-size:13px;line-height:1.45;overflow-wrap:anywhere\">{{data.legalStatus}}</span></div><div style=\"display:grid;grid-template-columns:132px 1fr;gap:10px;padding:7px 0;border-top:1px solid rgba(100,116,139,.14)\"><strong style=\"font-size:11px;letter-spacing:.06em;text-transform:uppercase;color:#64748b\">Headquarters</strong><span style=\"font-size:13px;line-height:1.45;overflow-wrap:anywhere\">{{data.headquartersRef}}</span></div><div style=\"display:grid;grid-template-columns:132px 1fr;gap:10px;padding:7px 0;border-top:1px solid rgba(100,116,139,.14)\"><strong style=\"font-size:11px;letter-spacing:.06em;text-transform:uppercase;color:#64748b\">Geographic scope</strong><span style=\"font-size:13px;line-height:1.45;overflow-wrap:anywhere\">{{data.geographicScope}}</span></div><div style=\"display:grid;grid-template-columns:132px 1fr;gap:10px;padding:7px 0;border-top:1px solid rgba(100,116,139,.14)\"><strong style=\"font-size:11px;letter-spacing:.06em;text-transform:uppercase;color:#64748b\">Website</strong><span style=\"font-size:13px;line-height:1.45;overflow-wrap:anywhere\"><a href=\"{{data.website}}\" target=\"_blank\" rel=\"noopener noreferrer\" style=\"color:#2563eb;font-weight:700;text-decoration:underline\">Open link ↗</a><div style=\"font-size:11px;color:#64748b;margin-top:3px\">{{data.website}}</div></span></div><div style=\"display:grid;grid-template-columns:132px 1fr;gap:10px;padding:7px 0;border-top:1px solid rgba(100,116,139,.14)\"><strong style=\"font-size:11px;letter-spacing:.06em;text-transform:uppercase;color:#64748b\">Logo URL</strong><span style=\"font-size:13px;line-height:1.45;overflow-wrap:anywhere\"><a href=\"{{data.logo}}\" target=\"_blank\" rel=\"noopener noreferrer\" style=\"color:#2563eb;font-weight:700;text-decoration:underline\">Open link ↗</a><div style=\"font-size:11px;color:#64748b;margin-top:3px\">{{data.logo}}</div></span></div><div style=\"display:grid;grid-template-columns:132px 1fr;gap:10px;padding:7px 0;border-top:1px solid rgba(100,116,139,.14)\"><strong style=\"font-size:11px;letter-spacing:.06em;text-transform:uppercase;color:#64748b\">Status</strong><span style=\"font-size:13px;line-height:1.45;overflow-wrap:anywhere\">{{data.status}}</span></div></article>"
