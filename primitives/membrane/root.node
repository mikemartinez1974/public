          },
          "portId": "root"
        }
      ],
      "inputs": [
        {
          "key": "root",
          "label": "root",
          "type": "any"
        }
      ],
      "data": {
        "content": {
          "kind": "markdown",
          "value": "# Ports and Relationships\n\nBoundary control nodes have root/next sockets; membrane edges connect them. The complete path determines a closed geometric outline. Ports and bridge controls may be placed on that outline without becoming the control chain itself."
        },
        "interfaceContract": {
          "version": 1,
          "receivesViewContent": true
        },
        "identity": {
          "graphId": "primitive-membrane",
          "nodeId": "membrane-ports"
        }
      }
    },
    {
      "id": "membrane-behavior",
      "label": "Behavior",
      "type": "content",
      "position": {
        "x": -1000,
