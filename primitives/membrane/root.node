    {
      "id": "membrane-invariants",
      "type": "page-section",
      "label": "Invariants",
      "position": {
        "x": 380,
        "y": -640
      },
      "width": 520,
      "height": 320,
      "data": {
        "title": "Invariants",
        "body": "A boundary encloses a graph instance; it does not transfer ownership of nodes outside its outline. A custom control chain must be complete and unbranched. A selected representation uses the existing workspace frame. Surface, resolution and focus changes do not implicitly resize it, reflow neighbors or change camera zoom. Manual resizing is explicit. Internal nodes, edges, handles and pointer targets are clipped; exposed boundary controls remain accessible. Workspace title bars belong to View representations (including glyph-shaped artwork), not a terminal Glyph.",
        "presentation": {
          "glyph": {
            "kind": "icon",
            "name": "Article"
          },
          "baseLevel": "detail"
        },
