          "angle": 270,
          "metadata": {
            "interface": true,
            "structural": true,
            "role": "view.content"
          },
          "portId": "root"
        }
      ],
      "inputs": [
        {
          "key": "root",
          "label": "root",
          "type": "any"
        }
      ],
      "data": {
        "content": {
          "kind": "markdown",
          "value": "# Ports and Relationships\n\nOne authoritative spec per concept, referenced by the index. Examples are separate graphs opened by Portal. Edge and Edge Class have separate contracts. Surface remains in the language library even though it is represented by relationships rather than a node."
        },
        "interfaceContract": {
          "version": 1,
          "receivesViewContent": true
        },
        "identity": {
          "graphId": "primitive-specification",
          "nodeId": "specification-ports"
        }
      }
    },
    {
      "id": "specification-behavior",
      "label": "Behavior",
      "type": "content",
      "position": {
        "x": -1000,
