          "type": "any"
        }
      ],
      "data": {
        "content": {
          "kind": "markdown",
          "value": "# Representations\n\nDeclaration in the top-left region, section cards in the interior, examples in a right-side lane, any presentation Views along the bottom. Preserve existing stable IDs; new specs use an authored View chain ending in a Glyph. A View may render glyph-shaped artwork without being an icon View. It is still a View representation. Every authored Surface starts with at least one View and ends in its ordinary Glyph; the terminal Glyph does not replace the View."
        },
        "interfaceContract": {
          "version": 1,
          "receivesViewContent": true
        },
        "identity": {
          "graphId": "primitive-specification",
          "nodeId": "specification-representations"
        }
      }
    },
