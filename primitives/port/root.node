      "data": {
        "content": {
          "kind": "markdown",
          "value": "# Invariants\n\nA Port identifies an endpoint and direction/type contract. A handle is its interactive drawing, not a separate semantic endpoint. Presentation points to Views rather than requiring inline copies of their contents."
        },
        "interfaceContract": {
          "version": 1,
          "receivesViewContent": true
        },
