      "data": {
        "content": {
          "kind": "markdown",
          "value": "# Ports and Relationships\n\nCurrent Port relationships: default-view, summary-view, icon-view, glyph, handle and landing-surface. They remain supported for Ports even though new Declarations use surface chains. Root is the interface socket."
        },
        "interfaceContract": {
          "version": 1,
          "receivesViewContent": true
        },
