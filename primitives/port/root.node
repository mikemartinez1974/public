        }
      ],
      "data": {
        "content": {
          "kind": "markdown",
          "value": "# Contract\n\nPort data includes interface identity, direction, dataType and exposure metadata. The current reader supports sourceNodeId/sourcePayload and legacy presentation mappings. Node-level ports/handles declare socket IDs; edge endpoints use those stable IDs. Port direction and connection legality are separate checks."
        },
        "interfaceContract": {
          "version": 1,
          "receivesViewContent": true
        },
        "identity": {
          "graphId": "primitive-port",
          "nodeId": "port-contract"
        }
      }
    },
