    {
      "id": "port-meaning",
      "type": "page-section",
      "label": "Meaning",
      "position": {
        "x": -180,
        "y": -640
      },
      "width": 520,
      "height": 320,
      "data": {
        "title": "Meaning",
        "body": "A named public connection endpoint. Encoding: a `port` node for an exposed interface, or a declared socket on another node. The Declaration is the graph’s implicit root Port.",
        "presentation": {
          "glyph": {
            "kind": "icon",
            "name": "Article"
          },
          "baseLevel": "detail"
        },
        "definitionKey": "page-section",
        "_classBinding": {
