      "inputs": [
        {
          "key": "root",
          "label": "root",
          "type": "any"
        }
      ],
      "data": {
        "content": {
          "kind": "markdown",
          "value": "# Ports and Relationships\n\nThe class constrains relationship endpoints by semantic kinds and cardinality. A Surface relationship connects a Declaration to a View; view-sequence connects a View to another View or terminal Glyph. Legacy role classes remain for old graphs."
        },
        "interfaceContract": {
          "version": 1,
          "receivesViewContent": true
        },
        "identity": {
          "graphId": "primitive-edge-class",
          "nodeId": "edge-class-ports"
        }
      }
    },
