        }
      ],
      "data": {
        "content": {
          "kind": "markdown",
          "value": "# Invariants\n\nConnection rules have one shared reader. Styling does not grant connection legality. A class graph is not itself one of the relationship instances it describes."
        },
        "interfaceContract": {
          "version": 1,
          "receivesViewContent": true
        },
        "identity": {
          "graphId": "primitive-edge-class",
          "nodeId": "edge-class-invariants"
        }
      }
    },
    {
      "id": "edge-class-contract",
      "label": "Contract",
      "type": "content",
      "position": {
        "x": -1000,
        "y": 300
      },
      "width": 1000,
      "height": 660,
      "ports": [
        {
          "id": "root",
          "key": "root",
          "label": "root",
          "direction": "input",
          "dataType": "any",
          "angle": 270,
          "metadata": {
            "interface": true,
            "structural": true,
            "role": "view.content"
          }
        }
      ],
      "handles": [
        {
          "id": "root",
          "key": "root",
          "label": "root",
          "direction": "input",
          "dataType": "any",
          "angle": 270,
          "metadata": {
            "interface": true,
            "structural": true,
            "role": "view.content"
          },
          "portId": "root"
        }
      ],
      "inputs": [
        {
          "key": "root",
          "label": "root",
          "type": "any"
        }
      ],
      "data": {
        "content": {
          "kind": "markdown",
          "value": "# Contract\n\nedgeClassRule reads key, sourceKinds, targetKinds, maxOutgoing and maxIncoming. Empty kind lists or any permit all kinds; absent limits are unbounded. Numeric limits are nonnegative integer bounds. Classes also carry presentation/stroke information read by edgeClass."
        },
        "interfaceContract": {
          "version": 1,
          "receivesViewContent": true
        },
        "identity": {
          "graphId": "primitive-edge-class",
          "nodeId": "edge-class-contract"
        }
      }
    },
    {
      "id": "edge-class-ports",
      "label": "Ports and Relationships",
      "type": "content",
      "position": {
        "x": 120,
        "y": 300
      },
      "width": 1000,
      "height": 660,
      "ports": [
        {
