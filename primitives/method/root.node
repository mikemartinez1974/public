      "data": {
        "content": {
          "kind": "markdown",
          "value": "# Meaning\n\nInvocable behavior with declared effects. Encoding: a method node executed by the script runtime. Sharing a runtime with Script does not erase its invocation and effect contract."
        },
        "interfaceContract": {
          "version": 1,
          "receivesViewContent": true
        },
