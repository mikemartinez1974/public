        }
      ],
      "inputs": [
        {
          "key": "root",
          "label": "root",
          "type": "any"
        }
      ],
      "data": {
        "content": {
          "kind": "markdown",
          "value": "# Invariants\n\nInvocation is distinct from source storage. Declared effects describe intended permitted operations; the spec must identify exactly which host calls enforce them. An empty declared effects list is read-only under that contract."
        },
        "interfaceContract": {
          "version": 1,
          "receivesViewContent": true
        },
        "identity": {
          "graphId": "primitive-method",
          "nodeId": "method-invariants"
        }
      }
    },
    {
      "id": "method-contract",
      "label": "Contract",
      "type": "content",
      "position": {
        "x": -1000,
        "y": 300
      },
      "width": 1000,
      "height": 660,
      "ports": [
        {
          "id": "root",
          "key": "root",
          "label": "root",
          "direction": "input",
          "dataType": "any",
          "angle": 270,
          "metadata": {
            "interface": true,
            "structural": true,
            "role": "view.content"
          }
        }
      ],
      "handles": [
        {
          "id": "root",
          "key": "root",
          "label": "root",
          "direction": "input",
          "dataType": "any",
          "angle": 270,
          "metadata": {
            "interface": true,
            "structural": true,
            "role": "view.content"
          },
          "portId": "root"
        }
      ],
      "inputs": [
        {
          "key": "root",
          "label": "root",
          "type": "any"
        }
      ],
      "data": {
        "content": {
          "kind": "markdown",
          "value": "# Contract\n\ndata.source/source transport supplies executable source; data.effects contains kinds update-node, create-node, delete-node, edges, emit-event and hand-off. update-node/delete-node may list targets; absent targets mean any in scope. Legacy allowMutations is read with warnings instead of pretending it was a precise declaration."
        },
        "interfaceContract": {
          "version": 1,
          "receivesViewContent": true
        },
        "identity": {
          "graphId": "primitive-method",
          "nodeId": "method-contract"
        }
      }
    },
    {
      "id": "method-ports",
      "label": "Ports and Relationships",
      "type": "content",
      "position": {
        "x": 120,
        "y": 300
      },
      "width": 1000,
      "height": 660,
      "ports": [
        {
          "id": "root",
