      ],
      "inputs": [
        {
          "key": "root",
          "label": "root",
          "type": "any"
        }
      ],
      "data": {
        "content": {
          "kind": "markdown",
          "value": "# Ports and Relationships\n\nA Handler action-method edge targets invoke. Methods may run in edge order for one event. Runtime APIs include getNodes/getNode/getEdges/getGroups and mutation calls such as updateNode/updateView; individual host checks still apply."
        },
        "interfaceContract": {
          "version": 1,
          "receivesViewContent": true
        },
        "identity": {
          "graphId": "primitive-method",
          "nodeId": "method-ports"
        }
      }
    },
