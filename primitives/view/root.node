          }
        }
      ],
      "handles": [
        {
          "id": "root",
          "key": "root",
          "label": "root",
          "direction": "input",
          "dataType": "any",
          "angle": 270,
          "metadata": {
            "interface": true,
            "structural": true,
            "role": "view.content"
          },
          "portId": "root"
        }
      ],
      "inputs": [
        {
          "key": "root",
          "label": "root",
          "type": "any"
        }
      ],
      "data": {
        "content": {
          "kind": "markdown",
          "value": "# Ports and Relationships\n\nRoot receives an exposure; surface-delegate selects material; sequence-in and sequence-out participate in view-sequence. A Declaration surface edge selects the chain head. Ports retain their own default/summary/icon/glyph relationship vocabulary in the current implementation."
        },
        "interfaceContract": {
          "version": 1,
          "receivesViewContent": true
        },
        "identity": {
          "graphId": "primitive-view",
          "nodeId": "view-ports"
        }
      }
    },
    {
      "id": "view-behavior",
      "label": "Behavior",
      "type": "content",
      "position": {
        "x": -1000,
        "y": 1040
      },
      "width": 1000,
      "height": 660,
      "ports": [
        {
          "id": "root",
          "key": "root",
          "label": "root",
          "direction": "input",
          "dataType": "any",
          "angle": 270,
          "metadata": {
            "interface": true,
            "structural": true,
            "role": "view.content"
          }
        }
      ],
      "handles": [
        {
          "id": "root",
          "key": "root",
          "label": "root",
          "direction": "input",
          "dataType": "any",
          "angle": 270,
          "metadata": {
            "interface": true,
            "structural": true,
            "role": "view.content"
          },
