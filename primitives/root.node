      "data": {
        "identity": {
          "graphId": "2432f22c-5e03-4b80-a757-7233ff346477",
          "name": "Twilite Primitive Library",
          "version": "0.1.0",
          "description": "The base vocabulary Twilite graphs are composed from — one graph per primitive, each an executable specification, not a template and not a bundle of examples.",
          "nodeId": "primitive-library",
          "updatedAt": "2026-09-25T01:30:47.311765Z"
        },
        "intent": {
          "kind": "collection",
          "scope": "primitive-library"
