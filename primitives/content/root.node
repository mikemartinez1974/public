        "content": {
          "kind": "markdown",
          "value": "# Meaning\n\nDurable material that a View or another reader can consume. Encoding: a `content` node with a typed payload, independent of how many presentations use it."
        },
        "interfaceContract": {
          "version": 1,
          "receivesViewContent": true
        },
        "identity": {
          "graphId": "primitive-content",
          "nodeId": "content-meaning"
