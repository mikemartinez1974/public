    },
    {
      "id": "content-invariants",
      "label": "Invariants",
      "type": "content",
      "position": {
        "x": 120,
        "y": -440
      },
      "width": 1000,
      "height": 660,
      "ports": [
        {
          "id": "root",
          "key": "root",
          "label": "root",
          "direction": "input",
          "dataType": "any",
          "angle": 270,
          "metadata": {
            "interface": true,
            "structural": true,
            "role": "view.content"
          }
        }
      ],
      "handles": [
        {
          "id": "root",
          "key": "root",
          "label": "root",
          "direction": "input",
          "dataType": "any",
          "angle": 270,
          "metadata": {
            "interface": true,
            "structural": true,
