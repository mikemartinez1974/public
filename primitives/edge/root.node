      ],
      "data": {
        "content": {
          "kind": "markdown",
          "value": "# Ports and Relationships\n\nConnects declared sockets of nodes, including graph Ports. Surface exposure and view-sequence are concrete relationship types; a relationship’s allowed source/target kinds and cardinality come from its class."
        },
        "interfaceContract": {
          "version": 1,
          "receivesViewContent": true
        },
        "identity": {
          "graphId": "primitive-edge",
          "nodeId": "edge-ports"
        }
      }
    },
