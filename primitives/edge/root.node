      "inputs": [
        {
          "key": "root",
          "label": "root",
          "type": "any"
        }
      ],
      "data": {
        "content": {
          "kind": "markdown",
          "value": "# Contract\n\nAn edge records id, source, target, sourcePort/targetPort (legacy sourceHandle/targetHandle also read), type and data. data.edgeClassKey can explicitly select a class; generic edges may use semanticRole/role. Edge label and style are not substitutes for connection rules."
        },
        "interfaceContract": {
          "version": 1,
          "receivesViewContent": true
        },
        "identity": {
          "graphId": "primitive-edge",
          "nodeId": "edge-contract"
        }
      }
    },
