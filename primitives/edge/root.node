      ],
      "data": {
        "content": {
          "kind": "markdown",
          "value": "# Invariants\n\nEndpoint identities survive layout changes. Routing pins and lane geometry do not change semantic endpoints. Cross-graph ownership must be persisted with the owning graphs, not only in a workspace drawing."
        },
        "interfaceContract": {
          "version": 1,
          "receivesViewContent": true
        },
        "identity": {
          "graphId": "primitive-edge",
          "nodeId": "edge-invariants"
        }
