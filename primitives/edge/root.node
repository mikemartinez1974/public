        "content": {
          "kind": "markdown",
          "value": "# Meaning\n\nA relationship instance joining graph endpoints. Encoding: an entry in the graph’s edges array, not a node. Its meaning comes from the relationship/Edge Class, not its drawn curve."
        },
        "interfaceContract": {
          "version": 1,
          "receivesViewContent": true
        },
