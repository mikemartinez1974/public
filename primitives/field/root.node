      "data": {
        "content": {
          "kind": "markdown",
          "value": "# Ports and Relationships\n\nThe built-in Field uses set input and value output. Its value changes are written through the node update pathway; class-specific connections must follow their own contract."
        },
        "interfaceContract": {
          "version": 1,
          "receivesViewContent": true
        },
        "identity": {
          "graphId": "primitive-field",
          "nodeId": "field-ports"
        }
      }
    },
