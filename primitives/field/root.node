      "inputs": [
        {
          "key": "root",
          "label": "root",
          "type": "any"
        }
      ],
      "data": {
        "content": {
          "kind": "markdown",
          "value": "# Contract\n\nFieldNode reads data.key, data.value, data.fieldType and data.required. It accepts a title/label fallback for display, normalizes fieldType to a string and retains the value’s actual data. A class binding supplies additional meaning rather than turning every dictionary entry into a primitive."
        },
        "interfaceContract": {
          "version": 1,
          "receivesViewContent": true
        },
        "identity": {
          "graphId": "primitive-field",
          "nodeId": "field-contract"
        }
      }
    },
