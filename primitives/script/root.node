      "data": {
        "content": {
          "kind": "markdown",
          "value": "# Contract\n\nScript data carries source or scriptRef plus scriptName, autoRun/autoRunOnLoad/autoRunOnGraphChange, allowMutations and dryRun settings where the caller reads them. scriptRefLoader loads referenced source; scriptSourceTransport preserves escapes already decoded by graph JSON parsing."
        },
        "interfaceContract": {
          "version": 1,
          "receivesViewContent": true
        },
        "identity": {
          "graphId": "primitive-script",
          "nodeId": "script-contract"
        }
      }
    },
