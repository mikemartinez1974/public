      "data": {
        "content": {
          "kind": "markdown",
          "value": "# Invariants\n\nParsed source must not be decoded twice. Source location, permissions and invocation are separate concerns. A raw Script is not automatically an Event Handler or a Method with declared effects."
        },
        "interfaceContract": {
          "version": 1,
          "receivesViewContent": true
        },
