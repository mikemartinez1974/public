      "data": {
        "content": {
          "kind": "markdown",
          "value": "# Ports and Relationships\n\nThe Handler’s action-method output connects to Method invoke inputs; authored edges commonly use invokes. resolveEventHandlerMethods follows all matching edges in stored order. A missing Method is diagnosed rather than silently replaced."
        },
        "interfaceContract": {
          "version": 1,
          "receivesViewContent": true
        },
        "identity": {
          "graphId": "primitive-event-handler",
          "nodeId": "event-handler-ports"
        }
      }
    },
