      ],
      "data": {
        "content": {
          "kind": "markdown",
          "value": "# Invariants\n\nAn event is identified by emitter ID plus event key. A Handler listens to one event contract; class-scoped handlers select matching emitters rather than inventing a second event type. Cross-graph subscriptions are owned by the importing Bridge."
        },
        "interfaceContract": {
          "version": 1,
          "receivesViewContent": true
        },
        "identity": {
          "graphId": "primitive-event-handler",
          "nodeId": "event-handler-invariants"
        }
      }
    },
