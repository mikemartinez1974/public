      ],
      "inputs": [
        {
          "key": "root",
          "label": "root",
          "type": "any"
        }
      ],
      "data": {
        "content": {
          "kind": "markdown",
          "value": "# Ports and Relationships\n\nNew Surface chains reach the Glyph through sequence-in. The runtime can synthesize that input even where the stored default node only has legacy root. Glyph has no sequence-out. Legacy shared-glyph relationships remain readable."
        },
        "interfaceContract": {
          "version": 1,
          "receivesViewContent": true
        },
        "identity": {
          "graphId": "primitive-glyph",
          "nodeId": "glyph-ports"
        }
      }
    },
    {
      "id": "glyph-behavior",
      "label": "Behavior",
      "type": "content",
      "position": {
        "x": -1000,
        "y": 1040
      },
      "width": 1000,
      "height": 660,
      "ports": [
        {
          "id": "root",
          "key": "root",
          "label": "root",
