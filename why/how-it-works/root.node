        "content": {
          "kind": "html",
          "value": "<div style=\"container-type:inline-size;box-sizing:border-box;width:100%;height:100%;overflow:hidden;display:flex;flex-direction:column;justify-content:center;background:linear-gradient(135deg,#4c3269,#29274c 90%);color:#fff;border:3px solid #c398e9;border-left:12px solid #b784eb;border-radius:3cqw;padding:4.2cqw 4.7cqw;font-family:system-ui;box-shadow:inset 0 0 0 1px #ffffff17\">\n<div style=\"display:flex;gap:1.7cqw;align-items:center;color:#e3b6ff;font:850 2.7cqw/1.15 system-ui;letter-spacing:.14em\"><span style=\"font-size:3.4cqw\">⬡</span> BORROW / REUSE</div>\n<h2 style=\"font:650 6.35cqw/1.08 Georgia,serif;margin:2cqw 0 1.4cqw;letter-spacing:-.015em\">Build once. Borrow.</h2>\n<p style=\"font:470 3.45cqw/1.38 system-ui;margin:0;color:#eee3fa\">These are reusable classes, not one-off cards. Explore the Idea and Point definitions that shape them.</p></div>"
