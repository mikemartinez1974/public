        "content": {
          "kind": "html",
          "value": "<div style=\"container-type:size;box-sizing:border-box;width:100%;height:100%;min-height:0;position:relative;padding:4cqw;background:radial-gradient(ellipse at 20% -10%,#365879 0%,#1a3554 44%,#10213b 77%,#11162e 100%);color:#fff;font-family:system-ui,-apple-system,Segoe UI,sans-serif;display:flex;flex-direction:column;overflow:hidden\">\n<div style=\"position:absolute;inset:0;pointer-events:none;background:radial-gradient(ellipse at 108% 92%,#78376f25,transparent 46%),linear-gradient(135deg,#ffffff08 0%,transparent 30%);\"></div>\n<header style=\"position:relative;z-index:1;flex:0 0 auto;border-top:.32cqw solid #f5c542;padding-top:2.1cqw;display:flex;flex-direction:column;gap:1.45cqw\">\n<div style=\"font:900 1.95cqw/1.2 system-ui;letter-spacing:.17em;color:#f5c542\">TWILITE / HOW IT WORKS</div>\n<div style=\"font:650 6.2cqw/1.06 Georgia,serif;letter-spacing:-.018em;text-wrap:balance;text-shadow:0 .25cqw 1cqw #070f2433\">Start with a node. Build a world.</div>\n<div style=\"font:500 2.65cqw/1.38 system-ui;color:#d6e6fc;max-width:90%\">An idea becomes a connected project, then a place you can visit.</div>\n</header>\n<main style=\"position:relative;z-index:1;flex:1 1 auto;min-height:0;overflow:hidden;pointer-events:none\">\n<div style=\"position:absolute;inset:2% -8% 0;pointer-events:none;background:radial-gradient(ellipse at 25% 40%,#83b0ee0a,transparent 52%);\"></div>\n</main>\n<footer style=\"position:relative;z-index:1;flex:0 0 auto;border-top:.2cqw solid #8da5c6;padding-top:2.05cqw;display:flex;align-items:center;gap:2.6cqw;flex-wrap:wrap;font:850 2.05cqw/1.3 system-ui;letter-spacing:.015em\">\n<span style=\"color:#f5c542\">MAKE</span><span>CONNECT</span><span>REUSE</span><span>VISIT</span><span style=\"margin-left:auto;color:#dceafd;font-size:1.9cqw;letter-spacing:.04em\">REAL GRAPH · REAL DESTINATIONS</span>\n</footer></div>"
        }
