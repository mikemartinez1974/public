        "content": {
          "kind": "html",
          "value": "<div style=\"container-type:size;box-sizing:border-box;width:100%;height:100%;min-height:0;padding:4cqw;background:radial-gradient(ellipse at 27% 0%,#34567b,#182e4e 54%,#101b30);color:white;font-family:system-ui;display:flex;flex-direction:column;overflow:hidden\"><header style=\"flex:none;border-top:.38cqw solid #f5c542;padding-top:2cqw;display:flex;flex-direction:column;gap:1.5cqw\"><div style=\"font:900 2cqw system-ui;letter-spacing:.15em;color:#f5c542\">TWILITE / HOW IT WORKS</div><div style=\"font:600 6.6cqw/1.07 Georgia,serif\">Start with a node. Build a world.</div><div style=\"font:500 2.6cqw/1.35 system-ui;color:#d6e6fc\">An idea becomes a connected project, then a place you can visit.</div></header><main style=\"flex:1 1 auto;min-height:0;position:relative;background:linear-gradient(180deg,#7493bf0a,transparent 22%);overflow:hidden\"></main><footer style=\"flex:none;border-top:.25cqw solid #8da5c6;padding-top:2.5cqw;display:flex;gap:3cqw;flex-wrap:wrap;font:800 2.1cqw system-ui\"><span style=\"color:#f5c542\">MAKE</span><span>CONNECT</span><span>REUSE</span><span>VISIT</span><span style=\"margin-left:auto;color:#dceafd\">REAL GRAPH · REAL DESTINATIONS</span></footer></div>"
        }
