        },
        "view": {
          "intent": "node",
          "payload": "node.web.summary"
        },
        "content": {
          "kind": "html",
          "value": "<div style=\"container-type:inline-size;box-sizing:border-box;width:100%;height:100%;background:linear-gradient(145deg,#3a2c5c,#173d5e);padding:6cqw;color:#fff;font-family:system-ui\"><div style=\"font:900 4cqw system-ui;color:#f5c542;letter-spacing:.12em\">HOW TWILITE WORKS</div><div style=\"font:650 11cqw/1.08 Georgia,serif;margin-top:6cqw\">Build a<br>world.</div><div style=\"font:600 4.3cqw/1.35 system-ui;color:#dfeafe;margin-top:4cqw\">One graph. Real relationships. More places.</div></div>"
        }
      }
    },
