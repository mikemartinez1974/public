        "content": {
          "kind": "html",
          "value": "<div style=\"container-type:inline-size;box-sizing:border-box;width:100%;height:100%;overflow:hidden;display:flex;flex-direction:column;justify-content:center;background:linear-gradient(140deg,#1c5074,#1b3457 90%);color:#fff;border:3px solid #63b8db;border-left:12px solid #45c9d8;border-radius:3cqw;padding:4.2cqw 4.7cqw;font-family:system-ui;box-shadow:inset 0 0 0 1px #ffffff17\">\n<div style=\"display:flex;gap:1.7cqw;align-items:center;color:#7ee0eb;font:850 2.7cqw/1.15 system-ui;letter-spacing:.14em\"><span style=\"font-size:3.4cqw\">◇</span> FACT / CONNECT</div>\n<h2 style=\"font:650 6.35cqw/1.08 Georgia,serif;margin:2cqw 0 1.4cqw;letter-spacing:-.015em\">An edge is a fact.</h2>\n<p style=\"font:470 3.45cqw/1.38 system-ui;margin:0;color:#e0f1ff\">A relationship belongs to the graph. Follow it to discover how the idea becomes something real.</p></div>"
        }
      }
