          "value": "<div style=\"container-type:inline-size;box-sizing:border-box;width:100%;height:100%;overflow:hidden;display:flex;align-items:center;gap:2.2cqw;background:linear-gradient(115deg,#1c3455,#1d395c 70%,#234469);color:#fff;border:3px solid #74a3d4;border-radius:1.6cqw;padding:1.2cqw 2.5cqw;font-family:system-ui,-apple-system,Segoe UI,sans-serif;box-shadow:inset 0 0 0 1px #ffffff15\"><div style=\"flex:none;width:6cqw;height:6cqw;border-radius:1.2cqw;border:2px solid #8eb9ed;display:grid;place-items:center;color:#c9b6ff;font:800 3.8cqw/1 Georgia,serif\">◇</div><div style=\"min-width:0;display:flex;flex-direction:column;justify-content:center;gap:.35cqw\"><div style=\"font:850 1.15cqw/1.1 system-ui;letter-spacing:.13em;color:#f5c542\">THE IMPORTANT PART</div><div style=\"font:650 3.1cqw/1.06 Georgia,serif;letter-spacing:-.02em\">This is already a Twilite graph.</div><div style=\"font:470 1.42cqw/1.25 system-ui;color:#e6effc;max-width:96%\">Real nodes. Real relationships. Reusable classes. Actual destinations. Explore the working structure.</div></div></div>"
