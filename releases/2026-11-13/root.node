          "value": "<div style='container-type:inline-size;width:100%;height:100%'><div style='position:relative;box-sizing:border-box;width:100%;height:100%;overflow:hidden;background-color:#1b3a6b;background-image:linear-gradient(color-mix(in srgb,#2a5aa0 26%,transparent) 0.12cqw,transparent 0.12cqw),linear-gradient(90deg,color-mix(in srgb,#2a5aa0 26%,transparent) 0.12cqw,transparent 0.12cqw),linear-gradient(color-mix(in srgb,#2a5aa0 12%,transparent) 0.08cqw,transparent 0.08cqw),linear-gradient(90deg,color-mix(in srgb,#2a5aa0 12%,transparent) 0.08cqw,transparent 0.08cqw);background-size:10cqw 10cqw,10cqw 10cqw,2cqw 2cqw,2cqw 2cqw;font-family:Inter,system-ui,Segoe UI,Helvetica Neue,Arial,sans-serif;color:#ffffff'><div style='position:absolute;left:4cqw;top:3.4cqw;font:800 1.5cqw/1.2 Inter,system-ui,sans-serif;letter-spacing:.2em;text-transform:uppercase;color:#f5c542'><a href='github://mikemartinez1974/public/releases/root.node' style='color:inherit;text-decoration:none'>← Release notes</a></div><div style='position:absolute;left:4cqw;right:4cqw;top:6.2cqw;font:800 5.2cqw/.9 Archivo Black,Impact,Haettenschweiler,Arial Black,sans-serif;letter-spacing:-.03em;white-space:nowrap;overflow:hidden;text-overflow:ellipsis'>Release notes: 13 November 2026</div><div style='position:absolute;left:4cqw;right:4cqw;top:13.080000000000002cqw;font:400 2.5cqw/1.3 Inter,system-ui,sans-serif;color:#cfe0ff;white-space:nowrap;overflow:hidden;text-overflow:ellipsis'>Web pages in nodes, a feedback form, one way to sign in, and projects.</div><div style='position:absolute;left:4cqw;top:23.200000000000003cqw;font:400 1.7cqw/1 ui-monospace,SFMono-Regular,Menlo,Consolas,monospace;color:#f5c542'>Open a web page in a node, or tell us what broke.</div><div style='position:absolute;left:4cqw;top:27.6cqw;width:92cqw;height:30.166666666666657cqw;box-sizing:border-box;border-radius:2cqw;background:color-mix(in srgb,#f5c542 7%,#1b3a6b);border:.3cqw solid color-mix(in srgb,#f5c542 28%,#1b3a6b)'></div><div style='position:absolute;right:4cqw;top:3cqw;display:flex;gap:2.2cqw;font:700 1.9cqw/1.2 Inter,system-ui,sans-serif;white-space:nowrap'><a href='github://mikemartinez1974/public/root.node' style='color:#f5c542;text-decoration:none'>The Studio →</a><a href='github://mikemartinez1974/public/news/root.node' style='color:#f5c542;text-decoration:none'>News →</a><a href='tlz://twilite.zone/library/starters/start-with-your-ai/root.node' style='color:#f5c542;text-decoration:none'>Start with your AI →</a></div></div></div>"
        }
