    {
      "id": "release-2026-11-13-new",
      "type": "page-section",
      "label": "New",
      "position": {
        "x": -270,
        "y": 130
      },
      "width": 1100,
      "height": 560,
      "data": {
        "title": "New",
        "body": "- A Web Page node. Paste a web address and the page appears in the node when the site allows it. When it does not, the node says so and offers to open the page in a new tab.\n- Send feedback, in the File menu. It goes to the people who build Twilite, with the graph you were on.\n- A Project template in the Library: a project, with shelves for its ideas, plans, tasks and decisions.\n- A news board and release notes, in the Studio.",
        "presentation": {
          "glyph": {
            "kind": "icon",
            "name": "Article"
          },
          "baseLevel": "detail"
        },
        "identity": {
          "graphId": "release-2026-11-13"
