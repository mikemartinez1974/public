          "value": "<div style='container-type:inline-size;width:100%;height:100%;box-sizing:border-box;overflow:hidden;border:1px solid #786799;border-radius:12px;background:radial-gradient(ellipse at 100% 0%,#32264b 0%,#151b35 55%,#10162d 100%);color:#f3f1ff;padding:3.5cqw;display:flex;flex-direction:column;justify-content:space-between;font-family:system-ui'><div style='font:800 4.8cqw/1.15 system-ui;letter-spacing:.12em;color:#e2c884'>LOUISIANA · EST. 2026</div><div style='flex:1;display:flex;flex-direction:column;justify-content:center'><div style='font:700 20.5cqw/.95 Georgia,serif;letter-spacing:-.055em'>Twilite<br>LLC</div><div style='height:1.3cqw;width:26cqw;background:#e2c884;margin-top:2.2cqw'></div></div><div style='font:500 7.6cqw/1.17 system-ui;letter-spacing:-.025em;color:#e0e4f6'>We build places<br>for ideas to grow.</div></div>"
