          "value": "<div style='container-type:inline-size;width:100%;height:100%;box-sizing:border-box;border:1px solid #786799;border-radius:10px;background:#10162d;color:#f3f1ff;padding:8cqw;font-family:system-ui'><div style='font:700 3cqw system-ui;color:#d9bd77;letter-spacing:.15em'>LOUISIANA · EST. 2026</div><h1 style='font:700 12cqw/1.05 Georgia,serif;margin:5cqw 0'>Twilite LLC</h1><p style='font:400 5cqw/1.4 system-ui;color:#c9cce0'>The company behind the graph-native workspace.</p></div>"
        }
      }
    },
    {
