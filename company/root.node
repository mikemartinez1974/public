    {
      "id": "59fc6610-939f-4f98-a8c0-9cfb261ca41e",
      "type": "face",
      "label": "Company page",
      "position": {
        "x": -47.24204999550807,
        "y": -524.9220860223088
      },
      "width": 450,
      "height": 330,
      "visible": true,
      "showLabel": true,
      "data": {
        "view": {
          "intent": "node",
          "payload": "node.web.detail",
          "scroll": "page"
        },
        "semanticLevel": "detail",
        "content": {
          "kind": "html",
          "value": "<div style='container-type:inline-size;background:#10162d;color:#f3f1ff;width:100%;height:100%;overflow:auto;font-family:system-ui'><main style='max-width:900px;margin:auto;padding:clamp(24px,6cqw,70px)'><header style='border-top:3px solid #d9bd77;padding-top:18px'><div style='color:#d9bd77;font:700 12px system-ui;letter-spacing:.2em'>TWILITE LLC · EST. 2026 · LOUISIANA</div><h1 style='font:700 clamp(42px,9cqw,86px)/1.04 Georgia,serif;letter-spacing:-.04em;margin:45px 0 18px'>A place for ideas<br><span style='color:#bb9bf3'>to become things.</span></h1><p style='font:400 clamp(18px,2.7cqw,26px)/1.5 system-ui;color:#d0d2e5'>We build Twilite, a graph-native workspace where people and the AI agents they choose can create, connect and keep their work.</p></header><section style='display:grid;grid-template-columns:repeat(auto-fit,minmax(190px,1fr));gap:30px;margin-top:56px;padding-top:30px;border-top:1px solid #59617e'><article><strong style='color:#d9bd77;font-size:12px'>THE PRODUCT</strong><h2 style='font:600 28px Georgia,serif'>Twilite</h2><p style='line-height:1.6;color:#ccd2e6'>Graphs as documents, interfaces and durable workspaces, not merely diagrams.</p></article><article><strong style='color:#d9bd77;font-size:12px'>THE APPROACH</strong><h2 style='font:600 28px Georgia,serif'>Your agent. Your work.</h2><p style='line-height:1.6;color:#ccd2e6'>An open-ended workspace that is not tied to one AI provider.</p></article><article><strong style='color:#d9bd77;font-size:12px'>THE PLACE</strong><h2 style='font:600 28px Georgia,serif'>The Twilite Zone</h2><p style='line-height:1.6;color:#ccd2e6'>A place to explore graphs, understand the medium and create something of your own.</p></article></section><section style='background:#22203d;border:1px solid #6e6188;border-radius:16px;padding:25px;margin-top:38px'><strong style='font-size:12px;letter-spacing:.16em;color:#d9bd77'>NOW BUILDING</strong><p style='line-height:1.6'>Preparing the product for public launch. Product details and availability are evolving.</p></section><nav style='display:flex;flex-wrap:wrap;gap:16px;margin:38px 0'><a style='padding:14px 20px;background:#d9bd77;color:#10162d;text-decoration:none;border-radius:8px;font-weight:700' href='https://twilite.zone'>Explore Twilite</a><a style='padding:14px 20px;border:1px solid #9b91b6;color:#f3f1ff;text-decoration:none;border-radius:8px' href='tlz://twilite.zone/boulevard/root.node'>The Boulevard</a></nav><footer style='border-top:1px solid #59617e;padding-top:20px;color:#aeb7d1'>Twilite LLC · Louisiana, United States</footer></main></div>"
        },
        "_placement": {
          "version": 1,
          "state": "manually-shaped",
          "source": "manual",
          "updatedAt": 1794682057701,
          "reason": "node-drag"
        }
      }
    },
