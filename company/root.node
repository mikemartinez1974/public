        },
        "content": {
          "kind": "html",
          "value": "<div style='container-type:inline-size;width:100%;height:100%;box-sizing:border-box;overflow:auto;background:linear-gradient(145deg,#252c4a,#171e37 75%);color:#eef1ff;padding:6cqw;border:1px solid #8b7aac;border-radius:2cqw;font-family:system-ui,Arial,sans-serif'><div style='font:800 2.9cqw/1.3 system-ui;letter-spacing:.15em;color:#e0c77e;text-transform:uppercase;margin-bottom:4cqw'>03 / WORKFLOW</div><h2 style='font:700 7.1cqw/1.1 Georgia,serif;letter-spacing:-.025em;margin:0 0 5cqw'>Bring your own agent</h2><div style='font:400 4.35cqw/1.55 system-ui;color:#d4d9ed;display:grid;gap:3.3cqw'><p style='margin:0'>Twilite is not tied to one AI model. Users can work directly with their graphs or bring an agent to help them build and modify them.</p><p style='margin:0'>The graph remains when the conversation ends.</p></div></div>"
