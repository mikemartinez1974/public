          "graphId": "twilite-zone-arrival",
          "nodeId": "twilite-zone",
          "name": "Twilite Zone",
          "version": "0.4.0",
          "description": "The first five minutes of Twilite: a new way to create and experience web content."
        },
        "intent": {
          "kind": "public arrival",
          "scope": "first-five-minutes"
        },
        "dependencies": {
          "nodeTypes": [
            "declaration",
            "view",
            "glyph",
            "arrival",
            "arrival-route"
          ],
          "portContracts": [
            "core"
          ],
          "schemaVersions": {
            "nodes": ">=1.0.0",
            "ports": ">=1.0.0"
          },
          "optional": []
        },
        "authority": {
          "mutation": {
            "allowCreate": true,
            "allowUpdate": true,
            "allowDelete": true,
            "appendOnly": false
          },
          "actors": {
            "humans": true,
            "agents": true,
            "tools": true
          },
          "styleAuthority": "descriptive",
          "history": {
            "rewriteAllowed": false,
            "squashAllowed": false
          }
        },
        "settings": {
          "autoSave": false,
          "layout": {
            "mode": "manual",
            "direction": "DOWN",
            "defaultLayout": "layered",
            "edgeLaneGapPx": 18
          }
