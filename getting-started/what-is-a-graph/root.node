{
  "fileVersion":"1.0",
  "metadata":{"title":"Learn about the graph","description":"A tiny Twilite graph that teaches the medium by being the lesson.","graphId":"learn-about-the-graph","version":"0.2.1","kind":"getting-started-lesson","author":"Michael Martinez","tags":["twilite","onboarding","graph","learning"],"preferredViewer":"https://dev.twilite.zone"},
  "nodes":[
    {"id":"learn-declaration","type":"declaration","label":"Learn about the graph","root":false,"position":{"x":-1050,"y":-500},"width":520,"height":390,"ports":[{"id":"default-view","key":"default-view","label":"default-view","direction":"output","dataType":"any","angle":55,"role":"default-view"},{"id":"summary-view","key":"summary-view","label":"summary-view","direction":"output","dataType":"any","angle":70,"role":"shared-summary"},{"id":"icon-view","key":"icon-view","label":"icon-view","direction":"output","dataType":"any","angle":85,"role":"shared-icon"},{"id":"glyph","key":"glyph","label":"glyph","direction":"output","dataType":"any","angle":100,"role":"shared-glyph"},{"id":"landing-surface","key":"landing-surface","label":"landing-surface","direction":"output","dataType":"any","angle":115,"role":"landing-surface"}],"visible":true,"showLabel":true,"data":{"identity":{"graphId":"learn-about-the-graph","nodeId":"learn-about-the-graph","name":"Learn about the graph","version":"0.2.1"},"intent":{"kind":"getting-started-lesson","scope":"learning"},"declaration":{"kind":"graph","targetMode":"artifact","artifactKind":"getting-started-lesson","interfaceContract":{"version":1,"implicitRootPort":true},"defaultSurfaceId":"detail","landingSurfaceId":"landing","surfaces":[{"id":"detail","kind":"view","payload":"node.web.detail","viewNodeId":"learn-detail"},{"id":"summary","kind":"view","payload":"node.web.summary","viewNodeId":"learn-summary"},{"id":"icon","kind":"view","payload":"node.web.icon","viewNodeId":"learn-icon"},{"id":"glyph","kind":"glyph","payload":"node.web.glyph","viewNodeId":"learn-glyph"},{"id":"landing","kind":"node","payload":"node.web.detail","viewNodeId":"learn-root"}]},"document":{"url":"github://mikemartinez1974/public/getting-started/what-is-a-graph/root.node"},"visibilityRole":"editor"}},
    {"id":"learn-detail","type":"view","label":"Learn about the graph detail","root":false,"position":{"x":-450,"y":-500},"width":520,"height":300,"ports":[{"id":"root","key":"root","label":"root","direction":"input","dataType":"any","angle":270}],"visible":true,"showLabel":true,"data":{"identity":{"graphId":"learn-about-the-graph"},"view":{"intent":"node","payload":"node.web.detail"},"html":"<div style='width:100%;height:100%;box-sizing:border-box;padding:26px;border-radius:20px;background:#111827;border:1px solid #475569;font-family:system-ui;color:#f8fafc'><div style='font:800 11px/1 system-ui;color:#67e8f9'>LEARN THE MEDIUM</div><div style='font:850 31px/1.05 system-ui;margin:15px 0'>The graph is the content.</div><div style='font:500 16px/1.6 system-ui;color:#cbd5e1'>Start with two things and one relationship. Then look closer.</div></div>"}},
    {"id":"learn-summary","type":"view","label":"Learn summary","root":false,"position":{"x":130,"y":-500},"width":420,"height":240,"ports":[{"id":"root","key":"root","label":"root","direction":"input","dataType":"any","angle":270}],"visible":true,"showLabel":true,"data":{"identity":{"graphId":"learn-about-the-graph"},"view":{"intent":"node","payload":"node.web.summary"},"html":"<div style='width:100%;height:100%;box-sizing:border-box;padding:20px;border-radius:18px;background:#111827;border:1px solid #475569;font-family:system-ui;color:#f8fafc'><div style='font:800 10px/1 system-ui;color:#67e8f9'>LEARN</div><div style='font:850 24px/1.08 system-ui;margin:14px 0'>The graph is the content.</div><div style='font:500 14px/1.55 system-ui;color:#cbd5e1'>Two things. One relationship. Look closer.</div></div>"}},
    {"id":"learn-icon","type":"view","label":"Learn icon","root":false,"position":{"x":610,"y":-500},"width":240,"height":170,"ports":[{"id":"root","key":"root","label":"root","direction":"input","dataType":"any","angle":270}],"visible":true,"showLabel":true,"data":{"identity":{"graphId":"learn-about-the-graph"},"view":{"intent":"node","payload":"node.web.icon"},"html":"<div style='width:100%;height:100%;box-sizing:border-box;padding:16px;border-radius:16px;background:#111827;border:1px solid #475569;font-family:system-ui;color:#f8fafc;display:flex;flex-direction:column;justify-content:space-between'><div style='font-size:30px'>◎</div><div style='font:800 17px/1.15 system-ui'>Learn the graph</div></div>"}},
    {"id":"learn-glyph","type":"glyph","label":"Learn","root":false,"position":{"x":910,"y":-500},"width":90,"height":90,"ports":[{"id":"root","key":"root","label":"root","direction":"input","dataType":"any","angle":270}],"visible":true,"showLabel":true,"data":{"identity":{"graphId":"learn-about-the-graph"},"view":{"payload":"node.web.glyph"},"glyph":"◎"}},

    {"id":"learn-root","type":"arrival","label":"Learn about the graph","root":true,"position":{"x":0,"y":0},"width":640,"height":340,"ports":[{"id":"root","key":"root","label":"root","direction":"bidirectional","dataType":"any","angle":270,"position":{"side":"top","offset":0.5}},{"id":"route-1","key":"route-1","label":"puppies","direction":"output","dataType":"navigation","angle":90,"position":{"side":"bottom","offset":0.25}},{"id":"route-2","key":"route-2","label":"treats","direction":"output","dataType":"navigation","angle":90,"position":{"side":"bottom","offset":0.75}}],"handles":[{"id":"root","key":"root","label":"root","direction":"bidirectional","dataType":"any","angle":270,"portId":"root","position":{"side":"top","offset":0.5}},{"id":"route-1","key":"route-1","label":"puppies","direction":"output","dataType":"navigation","angle":90,"portId":"route-1","position":{"side":"bottom","offset":0.25}},{"id":"route-2","key":"route-2","label":"treats","direction":"output","dataType":"navigation","angle":90,"portId":"route-2","position":{"side":"bottom","offset":0.75}}],"visible":true,"showLabel":false,"data":{"eyebrow":"START HERE","title":"Two things. One relationship.","body":"This is enough to make a graph. The boxes are nodes. The connection between them says how they are related. Now inspect the things themselves.","definitionKey":"arrival","_classBinding":{"key":"arrival","sourceRef":"github://mikemartinez1974/public/templates/public-arrival-template/classes/arrival.node-class.node","ref":"github://mikemartinez1974/public/templates/public-arrival-template/classes/arrival.node-class.node"}}},

    {"id":"puppies","type":"markdown","label":"Puppies","root":false,"position":{"x":-470,"y":520},"width":440,"height":300,"ports":[{"id":"root","key":"root","label":"root","direction":"bidirectional","dataType":"any","angle":270,"position":{"side":"top","offset":0.35}},{"id":"likes","key":"likes","label":"likes","direction":"output","dataType":"relationship","angle":0,"position":{"side":"right","offset":0.5}},{"id":"deeper","key":"deeper","label":"look closer","direction":"output","dataType":"navigation","angle":90,"position":{"side":"bottom","offset":0.35}}],"handles":[{"id":"root","key":"root","label":"root","direction":"bidirectional","dataType":"any","angle":270,"portId":"root","position":{"side":"top","offset":0.35}},{"id":"likes","key":"likes","label":"likes","direction":"output","dataType":"relationship","angle":0,"portId":"likes","position":{"side":"right","offset":0.5}},{"id":"deeper","key":"deeper","label":"look closer","direction":"output","dataType":"navigation","angle":90,"portId":"deeper","position":{"side":"bottom","offset":0.35}}],"visible":true,"showLabel":true,"data":{"markdown":"# 🐶 Puppies\n\nA node is not merely a box *about* some content. **The node is web content.**\n\nIt can hold text, images, video, controls, data, applications, or another experience entirely.\n\nYou focused this node and found more than its label. That's the first important difference.","semanticRole":"example-content"}},

    {"id":"treats","type":"markdown","label":"Treats","root":false,"position":{"x":470,"y":520},"width":440,"height":300,"ports":[{"id":"root","key":"root","label":"root","direction":"bidirectional","dataType":"any","angle":270,"position":{"side":"top","offset":0.65}},{"id":"liked-by","key":"liked-by","label":"liked by","direction":"input","dataType":"relationship","angle":180,"position":{"side":"left","offset":0.5}}],"handles":[{"id":"root","key":"root","label":"root","direction":"bidirectional","dataType":"any","angle":270,"portId":"root","position":{"side":"top","offset":0.65}},{"id":"liked-by","key":"liked-by","label":"liked by","direction":"input","dataType":"relationship","angle":180,"portId":"liked-by","position":{"side":"left","offset":0.5}}],"visible":true,"showLabel":true,"data":{"markdown":"# 🦴 Treats\n\nThis is another piece of content.\n\nThe edge connecting **Puppies** to **Treats** is not decoration. It says something: puppies **like** treats.\n\nIn Twilite, relationships are part of the content too.","semanticRole":"example-content"}},

    {"id":"look-closer","type":"markdown","label":"Look closer","root":false,"position":{"x":-470,"y":980},"width":460,"height":330,"ports":[{"id":"root","key":"root","label":"root","direction":"bidirectional","dataType":"any","angle":270,"position":{"side":"top","offset":0.35}},{"id":"next","key":"next","label":"next","direction":"output","dataType":"navigation","angle":90,"position":{"side":"bottom","offset":0.65}}],"handles":[{"id":"root","key":"root","label":"root","direction":"bidirectional","dataType":"any","angle":270,"portId":"root","position":{"side":"top","offset":0.35}},{"id":"next","key":"next","label":"next","direction":"output","dataType":"navigation","angle":90,"portId":"next","position":{"side":"bottom","offset":0.65}}],"visible":true,"showLabel":true,"data":{"markdown":"# Look closer\n\nMove through zoom levels and notice what happens to the nodes around you.\n\nFrom far away, a node only needs to tell you **that it exists**. Closer, it can identify itself. Closer still, it can summarize. At useful range, it can become full web content.\n\nThe graph does not have to show everything at once.","semanticRole":"semantic-zoom-lesson"}},

    {"id":"graph-beyond","type":"markdown","label":"The graph keeps going","root":false,"position":{"x":-470,"y":1460},"width":500,"height":340,"ports":[{"id":"root","key":"root","label":"root","direction":"bidirectional","dataType":"any","angle":270,"position":{"side":"top","offset":0.65}},{"id":"destination","key":"destination","label":"destination","direction":"output","dataType":"graph","angle":0,"position":{"side":"right","offset":0.5}},{"id":"lesson","key":"lesson","label":"what you learned","direction":"output","dataType":"navigation","angle":0,"position":{"side":"right","offset":0.78}}],"handles":[{"id":"root","key":"root","label":"root","direction":"bidirectional","dataType":"any","angle":270,"portId":"root","position":{"side":"top","offset":0.65}},{"id":"destination","key":"destination","label":"destination","direction":"output","dataType":"graph","angle":0,"portId":"destination","position":{"side":"right","offset":0.5}},{"id":"lesson","key":"lesson","label":"what you learned","direction":"output","dataType":"navigation","angle":0,"portId":"lesson","position":{"side":"right","offset":0.78}}],"visible":true,"showLabel":true,"data":{"markdown":"# The graph keeps going\n\nA Twilite graph does not have to end at the edge of this screen. A node can lead to another graph, and that graph can lead somewhere else.\n\nThat means the structure can expand without turning this view into an unreadable wall of boxes.\n\n**Follow this node into another graph.**","semanticRole":"graph-navigation","target":{"mode":"navigate","kind":"graph","ref":"github://mikemartinez1974/public/getting-started/parts/root.node","entryPort":"root"}}},

    {"id":"lesson-end","type":"markdown","label":"That's a Twilite graph","root":false,"position":{"x":430,"y":1460},"width":520,"height":360,"ports":[{"id":"root","key":"root","label":"root","direction":"input","dataType":"navigation","angle":180,"position":{"side":"left","offset":0.78}},{"id":"create","key":"create","label":"create something","direction":"output","dataType":"graph","angle":90,"position":{"side":"bottom","offset":0.3}},{"id":"explore","key":"explore","label":"keep exploring","direction":"output","dataType":"graph","angle":90,"position":{"side":"bottom","offset":0.7}}],"handles":[{"id":"root","key":"root","label":"root","direction":"input","dataType":"navigation","angle":180,"portId":"root","position":{"side":"left","offset":0.78}},{"id":"create","key":"create","label":"create something","direction":"output","dataType":"graph","angle":90,"portId":"create","position":{"side":"bottom","offset":0.3}},{"id":"explore","key":"explore","label":"keep exploring","direction":"output","dataType":"graph","angle":90,"portId":"explore","position":{"side":"bottom","offset":0.7}}],"visible":true,"showLabel":true,"data":{"markdown":"# That's a Twilite graph.\n\nYou just explored web content by moving through its structure instead of navigating a stack of pages.\n\nNodes held the content. Edges gave relationships meaning. Zoom changed how much you needed to see. And the graph can lead into other graphs.\n\n**The graph isn't a picture of the content. The graph is the content.**","semanticRole":"lesson-conclusion","destinations":{"create":{"mode":"navigate","kind":"graph","ref":"github://mikemartinez1974/public/getting-started/create/root.node","entryPort":"root"},"explore":{"mode":"navigate","kind":"graph","ref":"github://mikemartinez1974/public/getting-started/explore/root.node","entryPort":"root"}}}}
  ],
  "edges":[
    {"id":"edge-declaration-detail","source":"learn-declaration","sourcePort":"default-view","target":"learn-detail","targetPort":"root","type":"default-view"},
