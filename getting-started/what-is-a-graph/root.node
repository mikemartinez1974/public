    {"id":"edge-root-treats","source":"learn-root","sourcePort":"route-2","target":"treats","targetPort":"root","type":"navigation","label":"another thing"},
    {"id":"edge-puppies-treats","source":"puppies","sourcePort":"likes","target":"treats","targetPort":"liked-by","type":"reference","label":"likes","data":{"semanticRole":"example-relationship"}},
    {"id":"edge-puppies-closer","source":"puppies","sourcePort":"deeper","target":"look-closer","targetPort":"root","type":"navigation","label":"look closer"},
    {"id":"edge-closer-beyond","source":"look-closer","sourcePort":"next","target":"graph-beyond","targetPort":"root","type":"navigation","label":"the graph keeps going"},
    {"id":"edge-beyond-end","source":"graph-beyond","sourcePort":"lesson","target":"lesson-end","targetPort":"root","type":"navigation","label":"what you just learned"}
