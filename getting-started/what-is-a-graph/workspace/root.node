        "html": "<div style='height:100%;box-sizing:border-box;padding:20px;border-radius:20px;background:#111827;color:#f8fafc;font-family:system-ui'><strong style='font-size:24px'>Keep the context.</strong><p style='color:#cbd5e1'>Open related graphs alongside one another instead of replacing the current one.</p></div>"
      }
    },
