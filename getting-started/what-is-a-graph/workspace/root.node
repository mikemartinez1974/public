{
  "fileVersion": "1.0",
  "metadata": {
    "title": "A graph can stay with you",
    "description": "A getting-started lesson that uses the multi-graph workspace to teach that graphs are content, not pages you must leave behind.",
    "graphId": "getting-started-workspace",
    "version": "0.1.0",
    "kind": "getting-started-lesson",
    "author": "Michael Martinez",
    "tags": [
      "getting-started",
      "multi-graph",
      "workspace"
    ],
    "preferredViewer": "https://dev.twilite.zone"
  },
  "nodes": [
