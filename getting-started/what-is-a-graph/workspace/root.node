          ]
        },
        "settings": {"autoSave": false, "expansion": {"allowGraphEntry": true}, "layout": {"mode": "manual", "direction": "RIGHT"}},
        "document": {"url": "github://mikemartinez1974/public/getting-started/what-is-a-graph/workspace/root.node"}
      }
    },
    {
      "id": "workspace-detail",
      "type": "view",
      "label": "Workspace detail",
      "root": false,
      "position": {"x": -220, "y": -420},
      "width": 440,
      "height": 250,
      "ports": [{"id": "root", "key": "root", "label": "root", "direction": "input", "dataType": "any", "angle": 180}],
      "handles": [{"id": "root", "portId": "root", "label": "root", "direction": "input", "dataType": "any", "angle": 180}],
      "visible": true,
      "showLabel": true,
      "data": {"identity": {"graphId": "getting-started-workspace"}, "view": {"payload": "node.web.detail"}, "html": "<article style='height:100%;box-sizing:border-box;padding:24px;border-radius:24px;background:#111827;color:#f8fafc;font-family:system-ui'><div style='font:800 11px/1 system-ui;color:#c4b5fd'>MULTI-GRAPH WORKSPACE</div><h2 style='margin:14px 0 10px;font-size:31px'>A graph can stay with you.</h2><p style='margin:0;color:#cbd5e1;font-size:16px;line-height:1.55'>Opening another graph does not have to erase the one you came from. Keep context visible while the structure expands.</p></article>"}
    },
    {
      "id": "workspace-summary",
      "type": "view",
      "label": "Workspace summary",
      "root": false,
      "position": {"x": 300, "y": -420},
      "width": 340,
      "height": 190,
      "ports": [{"id": "root", "key": "root", "label": "root", "direction": "input", "dataType": "any", "angle": 180}],
      "handles": [{"id": "root", "portId": "root", "label": "root", "direction": "input", "dataType": "any", "angle": 180}],
      "visible": true,
      "showLabel": true,
      "data": {"identity": {"graphId": "getting-started-workspace"}, "view": {"payload": "node.web.summary"}, "html": "<div style='height:100%;box-sizing:border-box;padding:20px;border-radius:20px;background:#111827;color:#f8fafc;font-family:system-ui'><strong style='font-size:24px'>Keep the context.</strong><p style='color:#cbd5e1'>Open related graphs alongside one another instead of replacing the current one.</p></div>"}
    },
    {
      "id": "workspace-icon",
      "type": "view",
      "label": "Workspace icon",
      "root": false,
      "position": {"x": 300, "y": -170},
      "width": 180,
      "height": 130,
      "ports": [{"id": "root", "key": "root", "label": "root", "direction": "input", "dataType": "any", "angle": 180}],
      "handles": [{"id": "root", "portId": "root", "label": "root", "direction": "input", "dataType": "any", "angle": 180}],
      "visible": true,
      "showLabel": true,
      "data": {"identity": {"graphId": "getting-started-workspace"}, "view": {"payload": "node.web.icon"}, "html": "<div style='height:100%;box-sizing:border-box;padding:18px;border-radius:18px;background:#111827;color:#f8fafc;font-family:system-ui'><div style='font-size:30px'>▦</div><div style='margin-top:14px;font-weight:800'>Graphs together</div></div>"}
    },
    {
      "id": "workspace-glyph",
      "type": "glyph",
      "label": "Workspace",
      "root": false,
      "position": {"x": 530, "y": -150},
      "width": 90,
      "height": 90,
      "ports": [{"id": "root", "key": "root", "label": "root", "direction": "input", "dataType": "any", "angle": 180}],
      "handles": [{"id": "root", "portId": "root", "label": "root", "direction": "input", "dataType": "any", "angle": 180}],
      "visible": true,
      "showLabel": true,
      "data": {"identity": {"graphId": "getting-started-workspace"}, "glyph": "▦", "view": {"payload": "node.web.glyph"}}
    },
    {
      "id": "workspace-landing",
      "type": "content",
      "label": "Keep both graphs",
      "root": true,
      "position": {"x": 0, "y": 120},
      "width": 500,
      "height": 300,
      "ports": [
        {"id": "root", "key": "root", "label": "root", "direction": "bidirectional", "dataType": "any", "angle": 180},
        {"id": "next", "key": "next", "label": "why this matters", "direction": "output", "dataType": "navigation", "angle": 0}
      ],
      "handles": [
        {"id": "root", "portId": "root", "label": "root", "direction": "bidirectional", "dataType": "any", "angle": 180, "position": {"side": "left", "offset": 0.5}},
        {"id": "next", "portId": "next", "label": "why this matters", "direction": "output", "dataType": "navigation", "angle": 0, "position": {"side": "right", "offset": 0.5}}
      ],
      "visible": true,
      "showLabel": true,
      "data": {"identity": {"graphId": "getting-started-workspace"}, "content": {"kind": "markdown", "value": "# Keep both graphs open\n\nYou arrived here from another graph. **Do not throw that context away.**\n\nTwilite can keep related graphs in the same workspace. One graph can explain an idea while another graph contains the thing being explained.\n\nThat means following structure no longer has to mean losing your place."}}
    },
    {
      "id": "workspace-why",
      "type": "content",
      "label": "Why this matters",
      "root": false,
      "position": {"x": 650, "y": 120},
      "width": 500,
      "height": 300,
      "ports": [
        {"id": "root", "key": "root", "label": "root", "direction": "input", "dataType": "navigation", "angle": 180},
        {"id": "next", "key": "next", "label": "the larger idea", "direction": "output", "dataType": "navigation", "angle": 0}
      ],
      "handles": [
        {"id": "root", "portId": "root", "label": "root", "direction": "input", "dataType": "navigation", "angle": 180, "position": {"side": "left", "offset": 0.5}},
        {"id": "next", "portId": "next", "label": "the larger idea", "direction": "output", "dataType": "navigation", "angle": 0, "position": {"side": "right", "offset": 0.5}}
      ],
      "visible": true,
      "showLabel": true,
      "data": {"identity": {"graphId": "getting-started-workspace"}, "content": {"kind": "markdown", "value": "# Context becomes spatial\n\nOn an ordinary site, following a link usually replaces one page with another. The browser remembers where you were, but it does not keep the structure visible.\n\nA multi-graph workspace can. The relationship between graphs becomes something you can **see and work inside**."}}
    },
    {
      "id": "workspace-larger-idea",
      "type": "content",
      "label": "The larger idea",
      "root": false,
      "position": {"x": 1300, "y": 120},
      "width": 500,
      "height": 300,
      "ports": [{"id": "root", "key": "root", "label": "root", "direction": "input", "dataType": "navigation", "angle": 180}],
      "handles": [{"id": "root", "portId": "root", "label": "root", "direction": "input", "dataType": "navigation", "angle": 180, "position": {"side": "left", "offset": 0.5}}],
      "visible": true,
      "showLabel": true,
      "data": {"identity": {"graphId": "getting-started-workspace"}, "content": {"kind": "markdown", "value": "# The graph does not end at the file boundary\n\nA graph can point into another graph without pretending the second graph is merely a page.\n\nOnce several graphs can remain present together, the workspace itself becomes part of the structure. That is the beginning of a much larger medium."}}
    }
  ],
  "edges": [
    {"id": "workspace-detail-edge", "source": "workspace-declaration", "sourcePort": "default-view", "sourceHandle": "default-view", "target": "workspace-detail", "targetPort": "root", "targetHandle": "root", "type": "default-view", "data": {"semanticRole": "default-view"}},
