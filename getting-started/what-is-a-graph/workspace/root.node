      "data": {
        "identity": {
          "graphId": "getting-started-workspace"
        },
        "view": {
          "payload": "node.web.detail",
          "intent": "node"
        },
        "html": "<article style='height:100%;box-sizing:border-box;padding:24px;border-radius:24px;background:#111827;color:#f8fafc;font-family:system-ui'><div style='font:800 11px/1 system-ui;color:#c4b5fd'>MULTI-GRAPH WORKSPACE</div><h2 style='margin:14px 0 10px;font-size:31px'>A graph can stay with you.</h2><p style='margin:0;color:#cbd5e1;font-size:16px;line-height:1.55'>Opening another graph does not have to erase the one you came from. Keep context visible while the structure expands.</p></article>"
      }
    },
    {
      "id": "workspace-summary",
      "type": "view",
      "label": "Workspace summary",
      "root": false,
      "position": {
