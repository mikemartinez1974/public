      "data": {
        "identity": {"graphId": "getting-started-workspace", "nodeId": "workspace", "name": "A graph can stay with you", "version": "0.1.0"},
        "intent": {"kind": "getting-started-lesson", "scope": "learning"},
        "declaration": {
