    {"id": "workspace-icon-edge", "source": "workspace-declaration", "sourcePort": "icon-view", "sourceHandle": "icon-view", "target": "workspace-icon", "targetPort": "root", "targetHandle": "root", "type": "reference", "data": {"semanticRole": "shared-icon"}},
    {"id": "workspace-glyph-edge", "source": "workspace-declaration", "sourcePort": "glyph", "sourceHandle": "glyph", "target": "workspace-glyph", "targetPort": "root", "targetHandle": "root", "type": "reference", "data": {"semanticRole": "shared-glyph"}},
    {"id": "workspace-landing-edge", "source": "workspace-declaration", "sourcePort": "landing-surface", "sourceHandle": "landing-surface", "target": "workspace-landing", "targetPort": "root", "targetHandle": "root", "type": "reference", "data": {"semanticRole": "landing-surface"}},
