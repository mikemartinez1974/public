{"fileVersion":"1.0","metadata":{"title":"Question-Driven Explanation Template","description":"A reusable Q&A explanation class kit organized around seven core node classes.","graphId":"question-driven-explanation-template-kit","version":"0.1.0","kind":"template","created":"2026-08-06T03:35:00.000Z","modified":"2026-08-06T03:35:00.000Z","author":"Michael Martinez","tags":["template","q-and-a","explanation","node-class-kit"],"preferredViewer":"https://twilite.zone"},"nodes":[{"id":"qa-template-declaration","type":"declaration","label":"Question-Driven Explanation Template Declaration","position":{"x":-920,"y":-460},"width":460,"height":340,"ports":[{"id":"root","label":"root","direction":"bidirectional","dataType":"any","angle":210}],"visible":true,"showLabel":true,"data":{"identity":{"graphId":"question-driven-explanation-template-kit","name":"Question-Driven Explanation Template","version":"0.1.0","description":"A reusable Q&A explanation grammar built from seven core node classes.","createdAt":"2026-08-06T03:35:00.000Z","updatedAt":"2026-08-06T03:35:00.000Z"},"intent":{"kind":"template","scope":"shared","artifactKind":"template"},"declaration":{"kind":"template","targetMode":"artifact","artifactKind":"template","defaultSurfaceId":"root","surfaces":[{"id":"root","kind":"port","label":"Question-Driven Explanation Template","portNodeId":"qa-template-root-port","viewNodeId":"qa-template-root-port","exposes":{"views":{"mode":"allow"},"declarations":{"mode":"allow"}}}]},"dependencies":{"nodeTypes":["declaration","port","portal","qa-topic","qa-question","qa-answer","qa-source","qa-example","qa-caveat","qa-summary"],"portContracts":["core"],"skills":["question-driven-explanation-template"],"schemaVersions":{"nodes":">=1.0.0","ports":">=1.0.0"},"optional":[]},"authority":{"mutation":{"allowCreate":true,"allowUpdate":true,"allowDelete":true,"appendOnly":false},"actors":{"humans":true,"agents":true,"tools":true},"styleAuthority":"descriptive","history":{"rewriteAllowed":false,"squashAllowed":false}},"kit":{"coreNodeClasses":[{"key":"qa-topic","ref":"github://mikemartinez1974/public/templates/question-driven-explanation-template/classes/nodes/qa-topic.node-class.node"},{"key":"qa-question","ref":"github://mikemartinez1974/public/templates/question-driven-explanation-template/classes/nodes/qa-question.node-class.node"},{"key":"qa-answer","ref":"github://mikemartinez1974/public/templates/question-driven-explanation-template/classes/nodes/qa-answer.node-class.node"},{"key":"qa-source","ref":"github://mikemartinez1974/public/templates/question-driven-explanation-template/classes/nodes/qa-source.node-class.node"},{"key":"qa-example","ref":"github://mikemartinez1974/public/templates/question-driven-explanation-template/classes/nodes/qa-example.node-class.node"},{"key":"qa-caveat","ref":"github://mikemartinez1974/public/templates/question-driven-explanation-template/classes/nodes/qa-caveat.node-class.node"},{"key":"qa-summary","ref":"github://mikemartinez1974/public/templates/question-driven-explanation-template/classes/nodes/qa-summary.node-class.node"}],"optionalNodeClasses":["qa-term","qa-audience"],"optionalStatus":"deferred-pending-specimen-evaluation"}}},{"id":"qa-template-root-port","type":"port","label":"Question-Driven Explanation Template","position":{"x":-360,"y":-460},"width":640,"height":340,"ports":[{"id":"root","label":"root","direction":"bidirectional","dataType":"any","angle":210}],"visible":true,"showLabel":true,"data":{"identity":{"graphId":"question-driven-explanation-template-kit","portId":"root","name":"Question-Driven Explanation Template"},"title":"Question-Driven Explanation Template","purpose":"Explain any subject through questions, answers, support, examples, caveats, and synthesis.","key":"node.web.summary","intent":"node","payload":"node.web.summary","view":{"intent":"node","payload":"node.web.summary","label":"Question-Driven Explanation Template"},"html":"<div style='height:100%;box-sizing:border-box;border-radius:24px;background:linear-gradient(135deg,#0f172a,#164e63,#4338ca);color:white;padding:28px;font-family:system-ui'><div style='font:800 11px system-ui;letter-spacing:.18em;color:#cffafe'>QUESTION-DRIVEN EXPLANATION</div><h1 style='font:850 32px Georgia;margin:16px 0 8px'>Q&amp;A Template</h1><p style='font-size:15px;color:#dbeafe'>Ask · Answer · Support · Illustrate · Qualify · Synthesize</p><div style='font-size:44px;margin-top:34px'>? → ✓ → ↗ → ✦ → △ → Σ</div><small>Seven reusable node classes, one explanation grammar.</small></div>"}},{"id":"qa-template-notes","type":"markdown","label":"Core Class Set","position":{"x":-920,"y":-20},"width":460,"height":350,"ports":[{"id":"root","label":"root","direction":"bidirectional","dataType":"any","angle":210}],"visible":true,"showLabel":true,"data":{"identity":{"graphId":"question-driven-explanation-template-kit"},"markdown":"# Core Q&A Class Set\n\n- `qa-topic` identifies the subject.\n- `qa-question` carries who, what, where, when, why, how, or custom lenses.\n- `qa-answer` responds directly.\n- `qa-source` supports or contextualizes an answer.\n- `qa-example` illustrates it.\n- `qa-caveat` qualifies it.\n- `qa-summary` synthesizes the explanation.\n\n`qa-term` and `qa-audience` remain deliberately deferred until cross-domain specimens justify them."}},{"id":"qa-template-qa-topic-portal","type":"portal","label":"Topic Class","position":{"x":-360,"y":-20},"width":420,"height":280,"ports":[{"id":"top","label":"top","direction":"input","dataType":"value","angle":270},{"id":"bottom","label":"bottom","direction":"output","dataType":"value","angle":90}],"visible":true,"showLabel":false,"data":{"memo":"Open the reusable Topic node class.","authority":"navigate","intent":"external","sourceRef":"github://mikemartinez1974/public/templates/question-driven-explanation-template/classes/nodes/qa-topic.node-class.node","sourceNodeId":"qa-topic-overview","sourcePayload":"node.web.summary","surfaceId":"root","target":{"endpoint":"github:/