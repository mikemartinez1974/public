    {
      "id": "node-class-template-on-port",
      "type": "event-handler",
      "label": "Any port changed",
      "position": {
        "x": 1860,
        "y": 1560
      },
      "width": 400,
      "height": 280,
      "ports": [
        {
          "id": "trigger",
          "key": "trigger",
          "label": "Event",
          "direction": "input",
          "dataType": "event",
          "angle": 180
        },
        {
          "id": "result",
          "key": "result",
          "label": "Invocation",
          "direction": "output",
          "dataType": "value",
          "angle": 0
        }
      ],
      "handles": [
        {
          "id": "trigger",
          "key": "trigger",
          "label": "Event",
          "direction": "input",
          "dataType": "event",
          "angle": 180,
          "portId": "trigger"
        },
        {
          "id": "result",
