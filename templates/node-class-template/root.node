          "contractVersion": "1.0.0",
          "key": "example-note",
          "label": "Example Note",
          "meaning": "A short note with a title, a body and a status. This is a specimen: change it, or start a new class from this template.",
          "requiredDataKeys": [
            "title"
          ],
          "nodeDef": {
            "key": "example-note",
            "ref": "github://mikemartinez1974/public/templates/node-class-template/root.node",
