                  "label": "Page Section changed",
                  "payloadContract": {
                    "type": "object"
                  }
                }
              ]
            }
          }
        }
      }
    },
    {
      "id": "node-class-template-derive-method",
      "type": "method",
      "label": "Derive the class",
      "position": {
        "x": 2440,
        "y": 1700
      },
      "width": 420,
      "height": 300,
      "visible": true,
      "showLabel": true,
      "ports": [
        {
          "id": "call",
          "key": "call",
          "label": "Call",
          "direction": "input",
          "dataType": "event",
          "angle": 180
        },
        {
          "id": "result",
          "key": "result",
          "label": "Result",
          "direction": "output",
          "dataType": "value",
          "angle": 0
        }
      ],
      "handles": [
        {
          "id": "call",
          "key": "call",
          "portId": "call",
          "label": "Call",
          "direction": "input",
          "dataType": "event",
          "angle": 180
        },
        {
          "id": "result",
          "key": "result",
          "portId": "result",
          "label": "Result",
          "direction": "output",
          "dataType": "value",
          "angle": 0
        }
      ],
      "data": {
        "scriptName": "Refresh exposed views",
        "source": "// Derives the node class this graph describes, from its Properties and its rows, and keeps everything the class shows current:\n//   - the class itself, on the Declaration (key, label, meaning, required keys, and the defaults every new node starts with),\n//   - the views every node of the class shows: detail, summary and icon, as templates over the node's data, and its editor,\n//   - the page this graph opens on, which lists the class and draws a specimen of it.\n// Every Handler in the graph calls this one Method, so what the class says is always what its rows say. It writes only the\n// nodes its declared effects name.\n\nconst clean = (value) => String(value ?? '').trim();\nconst isObject = (value) => Boolean(value && typeof value === 'object' && !Array.isArray(value));\nconst escapeXml = (value) => String(value ?? '').replace(/[&<>\"']/g, (character) => ({\n  '&': '&amp;', '<': '&lt;', '>': '&gt;', '\"': '&quot;', \"'\": '&apos;'\n})[character]);\n\nconst nodes = await api.getNodes();\nconst byId = (id) => nodes.find((node) => node?.id === id);\nconst bindingKey = (node) => clean(node?.data?._classBinding?.key || node?.data?.definitionKey).toLowerCase();\nconst rowsOf = (key) => nodes.filter((node) => bindingKey(node) === key || clean(node?.type).toLowerCase() === key);\n\n// --- Properties ----------------------------------------------------------------------------------------------------------\nconst properties = {};\nfor (const node of nodes) {\n  if (bindingKey(node) !== 'property' && clean(node?.type).toLowerCase() !== 'property') continue;\n  const data = node.data || {};\n  const name = clean(data.name);\n  if (!name) continue;\n  if (Object.hasOwn(data, 'value') && data.value !== undefined) properties[name] = data.value;\n  else if (Object.hasOwn(data, 'defaultValue') && data.defaultValue !== undefined) properties[name] = data.defaultValue;\n}\nconst key = clean(properties.key);\nif (!key) return { updated: [], skipped: 'The class has no key yet' };\nconst label = clean(properties.label) || key;\nconst meaning = clean(properties.meaning);\nconst number = (value, fallback) => { const parsed = Number(value); return Number.isFinite(parsed) && parsed > 0 ? Math.round(parsed) : fallback; };\nconst size = { width: number(properties.width, 420), height: number(properties.height, 260) };\nconst glyphName = clean(properties.glyph) || 'Article';\nconst declaration = nodes.find((node) => node?.type === 'declaration');\nconst classRef = clean(declaration?.data?.document?.url);\n\n// --- Rows ------------------------------------------------------------------------------------------------------------------\nconst toBoolean = (value) => ['true', 'yes', '1', 'on'].includes(clean(value).toLowerCase()) || value === true;\nconst FIELD_TYPES = ['text', 'multiline', 'number', 'boolean', 'select'];\nconst humanize = (name) => clean(name).replace(/([a-z0-9])([A-Z])/g, '$1 $2').replace(/[-_.]+/g, ' ').replace(/^./, (c) => c.toUpperCase());\nconst optionList = (value) => clean(value).split(',').map(clean).filter(Boolean);\nconst fields = rowsOf('class-field-row').map((node) => {\n  const data = node.data || {};\n  const name = clean(data.name);\n  const type = FIELD_TYPES.includes(clean(data.fieldType)) ? clean(data.fieldType) : 'text';\n  return { name, label: clean(data.label) || humanize(name), type, required: toBoolean(data.required), defaultValue: data.defaultValue, options: optionList(data.options), description: clean(data.description) };\n}).filter((field) => field.name);\nconst coerce = (field) => {\n  const raw = field.defaultValue;\n  if (field.type === 'number') { const parsed = Number(raw); return Number.isFinite(parsed) ? parsed : 0; }\n  if (field.type === 'boolean') return toBoolean(raw);\n  return clean(raw);\n};\nconst SIDE_ANGLE = { top: 270, right: 0, bottom: 90, left: 180 };\nconst ports = rowsOf('class-port-row').map((node) => {\n  const data = node.data || {};\n  const id = clean(data.portId);\n  const side = SIDE_ANGLE[clean(data.side)] !== undefined ? clean(data.side) : 'top';\n  const offset = Number.isFinite(Number(data.offset)) ? Math.max(0, Math.min(1, Number(data.offset))) : 0.5;\n  const accepts = clean(data.acceptsEdgeClasses).split(',').map(clean).filter(Boolean);\n  return {\n    id, key: id, label: clean(data.label) || id,\n    direction: ['input', 'output', 'bidirectional'].includes(clean(data.direction)) ? clean(data.direction) : 'bidirectional',\n    dataType: clean(data.dataType) || 'any', angle: SIDE_ANGLE[side], position: { side, offset },\n    ...(accepts.length ? { allowedEdgeTypes: accepts } : {})\n  };\n}).filter((port) => port.id);\nconst events = rowsOf('class-event-row').map((node) => {\n  const data = node.data || {};\n  return { eventKey: clean(data.eventKey), label: clean(data.label) || clean(data.eventKey), payloadContract: { type: 'object' } };\n}).filter((event) => event.eventKey);\n\n// --- The class -------------------------------------------------------------------------------------------------------------\nconst defaultData = Object.fromEntries(fields.map((field) => [field.name, coerce(field)]));\nconst defaults = {\n  label, size, showLabel: false,\n  data: { ...defaultData, presentation: { glyph: { kind: 'icon', name: glyphName } } },\n  ports, events\n};\nconst nodeClass = {\n  contractVersion: '1.0.0', key, label, meaning,\n  requiredDataKeys: fields.filter((field) => field.required).map((field) => field.name),\n  nodeDef: { key, ref: classRef, source: 'github', version: '>=0.1.0', defaults }\n};\n\n// --- What a node of the class shows ------------------------------------------------------------------------------------------\nconst heading = fields.find((field) => field.required) || fields[0] || null;\nconst rest = fields.filter((field) => field !== heading);\nconst slot = (field) => `{{data.${field.name}}}`;\nconst card = (padding, radius, background, inner) => `<div style='width:100%;height:100%;box-sizing:border-box;padding:${padding}px;border-radius:${radius}px;background:${background};border:1px solid #e2e8f0;font-family:system-ui;color:#0f172a;overflow:hidden'>${inner}</div>`;\nconst titleHtml = heading ? `<div style='font:800 24px/1.2 system-ui;margin-bottom:12px'>${slot(heading)}</div>` : `<div style='font:800 24px/1.2 system-ui;margin-bottom:12px'>${escapeXml(label)}</div>`;\nconst rowHtml = (field) => `<div style='margin-bottom:10px'><div style='font:700 11px/1.4 system-ui;letter-spacing:.06em;text-transform:uppercase;color:#64748b'>${escapeXml(field.label)}</div><div style='font:400 15px/1.5 system-ui;color:#334155'>${slot(field)}</div></div>`;\nconst detailHtml = card(24, 22, '#ffffff', titleHtml + rest.map(rowHtml).join(''));\nconst summaryHtml = card(20, 20, '#ffffff', titleHtml + rest.slice(0, 2).map(rowHtml).join(''));\nconst iconHtml = card(16, 18, '#ede9fe', `<div style='color:#7c3aed;font-size:22px;font-weight:800'>${escapeXml(label.charAt(0) || '?')}</div><div style='font:800 15px/1.2 system-ui;margin-top:8px'>${heading ? slot(heading) : escapeXml(label)}</div>`);\nconst EDITOR_TYPES = { text: 'text', multiline: 'textarea', number: 'number', boolean: 'checkbox', select: 'select' };\nconst editor = { web: { fields: [\n  { key: 'label', label: 'Label', type: 'text', path: 'label' },\n  ...fields.map((field) => ({\n    key: field.name, label: field.label, type: field.type === 'select' && !field.options.length ? 'text' : EDITOR_TYPES[field.type], path: `data.${field.name}`,\n    ...(field.type === 'select' && field.options.length ? { options: field.options.map((value) => ({ label: humanize(value), value })) } : {}),\n    ...(field.description ? { placeholder: field.description } : {})\n  }))\n] } };\n\n// --- The page this graph opens on --------------------------------------------------------------------------------------------\n// The page reads as an article: a nameplate, the label as the headline and the meaning as the standfirst, then a specimen\n// of the class at its three sizes. The authored page sections are the body, in graph order. The technical details sit\n// around them: Settings beside the first section, the required fields set large, the fields as a ruled table, and the\n// ports and events beside the second section. Sizes follow the view's own width.\nconst fill = (html) => html.replace(/\\{\\{data\\.([^}]+)\\}\\}/g, (_, name) => escapeXml(defaultData[name] ?? ''));\nconst SERIF = 'Newsreader,Iowan Old Style,Palatino Linotype,Book Antiqua,Georgia,serif';\nconst MONO = 'ui-monospace,Cascadia Code,Consolas,monospace';\nconst ACCENT = '#0f766e';\nconst KICKER = 'font:800 12px/16px system-ui;letter-spacing:.18em;text-transform:uppercase';\nconst heading2 = (text, color = ACCENT) => `<h2 style='margin:0 0 14px;${KICKER};color:${color}'>${escapeXml(text)}</h2>`;\nconst paragraphs = (value, dropCap) => clean(value).split(/\\n{2,}/).map((part) => part.trim()).filter(Boolean)\n  .map((part, index) => {\n    const cap = dropCap && index === 0 && /^[A-Za-z]/.test(part);\n    return `<p style='margin:0 0 14px;max-width:60ch;font:400 19px/1.6 ${SERIF};color:#1e293b'>`\n      + (cap ? `<span style='float:left;padding:6px 10px 0 0;font:500 68px/54px ${SERIF};color:#0f172a'>${part[0]}</span>` : '')\n      + `${escapeXml(cap ? part.slice(1) : part).replace(/\\n/g, '<br>')}</p>`;\n  }).join('');\nconst caption = (number, text) => `<figcaption style='margin-top:10px;font:400 13px/1.5 system-ui;color:#475569'><b style='color:#0f172a'>Fig. ${number}</b> &nbsp;${escapeXml(text)}</figcaption>`;\nconst note = (text) => `<p style='margin:0;font:400 14px/1.5 system-ui;color:#475569'>${escapeXml(text)}</p>`;\nconst settings = [['Key', key], ['Label', label], ['Size', `${size.width} by ${size.height}`], ['Glyph', glyphName], ['Required fields', nodeClass.requiredDataKeys.join(', ') || 'none']]\n  .filter(([, value]) => clean(value));\n// A short value sits beside its name; a long one runs underneath it at the full width of the list.\nconst settingsList = settings.map(([name, value]) => {\n  const wide = clean(value).length > 24;\n  const span = wide ? 'grid-column:1/-1;' : '';\n  return `<dt style='${span}padding:9px 0 ${wide ? 0 : 9}px;border-top:1px solid #cbd5e1;font:400 13px/20px system-ui;color:#475569'>${escapeXml(name)}</dt>`\n    + `<dd style='${span}margin:0;padding:${wide ? '2px 0 9px' : '9px 0;border-top:1px solid #cbd5e1;text-align:right'};font:600 14px/20px system-ui;color:#0f172a;overflow-wrap:anywhere'>${escapeXml(value)}</dd>`;\n}).join('');\nconst SIDE = 'flex:1 1 220px;min-width:0;padding-top:10px;border-top:3px solid #0f172a';\nconst settingsSide = `<aside style='${SIDE}'>${heading2('Settings', '#0f172a')}`\n  + `<dl style='margin:0;display:grid;grid-template-columns:max-content 1fr;column-gap:12px;border-bottom:1px solid #cbd5e1'>${settingsList}</dl></aside>`;\nconst sideEntry = (name, detail) => `<div style='margin:0 0 12px'><div style='font:600 14px/20px ${MONO};color:#0f172a'>${escapeXml(name)}</div><div style='font:400 13px/20px system-ui;color:#475569'>${escapeXml(detail)}</div></div>`;\nconst connectionsSide = `<aside style='${SIDE}'>${heading2('Ports', '#0f172a')}`\n  + (ports.length ? ports.map((port) => sideEntry(port.id, `${port.direction} · ${port.position.side} at ${port.position.offset} · ${(port.allowedEdgeTypes || ['any edge']).join(', ')}`)).join('') : note('No ports yet. Add a port row.'))\n  + `<div style='margin-top:6px;padding-top:14px;border-top:1px solid #cbd5e1'>${heading2('Events', '#0f172a')}`\n  + (events.length ? events.map((event) => sideEntry(event.eventKey, event.label)).join('') : note('No events.')) + `</div></aside>`;\n// The class at its three sizes, each view filled with the values a new node starts with.\nconst specimenLabel = (text) => `<div style='margin-top:10px;font:700 11px/16px system-ui;letter-spacing:.14em;text-transform:uppercase;color:#475569'>${escapeXml(text)}</div>`;\nconst specimen = `<figure style='margin:0'>${heading2('Specimen')}`\n  + `<div style='display:flex;flex-wrap:wrap;justify-content:center;align-items:flex-start;gap:24px;padding:28px 12px;border-radius:6px;background:#eef2f6'>`\n  + `<div style='max-width:100%'><div style='width:${Math.min(size.width, 460)}px;max-width:100%;height:${Math.min(size.height, 340)}px'>${fill(detailHtml)}</div>${specimenLabel(`Detail · ${size.width} by ${size.height}`)}</div>`\n  + `<div><div style='width:${Math.min(size.width, 300) / 1.4}px;height:${Math.min(size.height, 200) / 1.4}px'>${fill(summaryHtml)}</div>${specimenLabel('Summary')}`\n  + `<div style='margin-top:24px;width:120px;height:110px'>${fill(iconHtml)}</div>${specimenLabel('Icon')}</div></div>`\n  + `${caption(1, `A new ${label} at each of its three sizes, holding its starting values.`)}</figure>`;\n// The required fields, set large; the count and names of all the fields underneath.\nconst COUNT_WORDS = ['No', 'One', 'Two', 'Three', 'Four', 'Five', 'Six', 'Seven', 'Eight', 'Nine', 'Ten'];\nconst listOf = (items) => items.length > 1 ? `${items.slice(0, -1).join(', ')} and ${items[items.length - 1]}` : (items[0] || '');\nconst withArticle = (word) => `${/^[aeiou]/i.test(word) ? 'an' : 'a'} ${word}`;\nconst fieldWord = (field) => field.label.toLowerCase();\nconst requiredFields = fields.filter((field) => field.required);\nconst quoteLead = requiredFields.length\n  ? `Every ${label} needs ${listOf(requiredFields.map((field) => withArticle(fieldWord(field))))}.`\n  : `No field of ${withArticle(label)} is required.`;\nconst quoteRest = fields.length\n  ? `${COUNT_WORDS[fields.length] || fields.length} in all: ${listOf(fields.map(fieldWord))}.`\n  : 'None yet. Add a field row.';\nconst quote = `<blockquote style='margin:48px 0 0;padding:32px 0;border-top:1px solid #0f172a;border-bottom:1px solid #0f172a'>`\n  + `<p style='margin:0 0 12px;font:italic 500 clamp(30px,6.4cqw,46px)/1.1 ${SERIF};letter-spacing:-.015em;color:${ACCENT};text-wrap:balance'>${escapeXml(quoteLead)}</p>`\n  + `<p style='margin:0;font:400 14px/1.5 system-ui;color:#475569'><b style='color:#0f172a'>The fields.</b> ${escapeXml(quoteRest)}</p></blockquote>`;\nconst TH = 'text-align:left;padding:10px 16px 10px 0;border-top:3px solid #0f172a;border-bottom:1px solid #0f172a;font:800 12px/16px system-ui;letter-spacing:.14em;text-transform:uppercase;color:#0f172a';\nconst TD = 'padding:11px 16px 11px 0;border-bottom:1px solid #cbd5e1;font:400 14px/20px system-ui;color:#334155';\nconst fieldRow = (field) => `<tr><td style='${TD};font:600 14px/20px ${MONO};color:#0f172a'>${escapeXml(field.name)}</td>`\n  + `<td style='${TD}'>${escapeXml(field.type + (field.options.length ? ` (${field.options.join(', ')})` : ''))}</td>`\n  + `<td style='${TD}${field.required ? ';font-weight:600;color:#0f172a' : ''}'>${field.required ? 'yes' : 'no'}</td>`\n  + `<td style='${TD}'>${escapeXml(clean(defaultData[field.name]) || '—')}</td></tr>`;\nconst fieldsFigure = `<figure style='margin:40px 0 0'>${heading2('Fields')}`\n  + (fields.length\n    ? `<div style='overflow-x:auto'><table style='border-collapse:collapse;width:100%;min-width:460px'><thead><tr>${['Field', 'Type', 'Required', 'Starts as'].map((cell) => `<th style='${TH}'>${cell}</th>`).join('')}</tr></thead><tbody>${fields.map(fieldRow).join('')}</tbody></table></div>`\n      + caption(2, 'What every node of the class holds, in the order its field rows sit in the graph.')\n    : note('No fields yet. Add a field row.')) + `</figure>`;\n// A sidebar and the text it sits beside. The sidebar comes first, so in a narrow view it stacks above the text.\nconst pageRow = (side, main) => `<div style='display:flex;flex-wrap:wrap;flex-direction:row-reverse;align-items:flex-start;gap:32px 40px;padding-top:44px'>${side}<div style='flex:999 1 380px;min-width:0'>${main}</div></div>`;\nconst sides = [settingsSide, connectionsSide];\nconst blocks = nodes.filter((node) => bindingKey(node) === 'page-section').map((node, index) => {\n  const body = `<section>${heading2(node.data?.title)}${paragraphs(node.data?.body, index === 0)}</section>`;\n  return index < sides.length ? pageRow(sides[index], body) : `<div style='padding-top:44px'>${body}</div>`;\n});\nfor (let index = blocks.length; index < sides.length; index += 1) blocks.push(pageRow(sides[index], ''));\nblocks.splice(1, 0, quote, fieldsFigure);\nconst page = `<div style='min-height:100%;box-sizing:border-box;container-type:inline-size;background:#ffffff;font-family:${SERIF};color:#0f172a'>`\n  + `<div style='box-sizing:border-box;max-width:900px;margin:0 auto;padding:32px clamp(20px,5cqw,40px) 64px'>`\n  + `<div style='padding:10px 0;border-top:3px solid #0f172a;border-bottom:1px solid #0f172a;font:800 12px/16px system-ui;letter-spacing:.18em;color:${ACCENT}'>NODE CLASS · ${escapeXml(key)}</div>`\n  + `<header style='padding:40px 0 32px'>`\n  + `<h1 style='margin:0;font:500 clamp(40px,9.5cqw,72px)/.98 ${SERIF};letter-spacing:-.025em;text-wrap:balance;color:#0f172a'>${escapeXml(label)}</h1>`\n  + (meaning ? `<p style='margin:18px 0 0;max-width:38ch;font:italic 400 clamp(20px,3.6cqw,26px)/1.35 ${SERIF};color:#475569'>${escapeXml(meaning)}</p>` : '') + `</header>`\n  + specimen + blocks.join('') + `</div></div>`;\n\n// --- Write only what changed the effects name -------------------------------------------------------------------------------\nconst edges = await api.getEdges();\nconst targetOf = (handle) => edges.find((edge) => edge.source === declaration?.id && (edge.sourceHandle === handle || edge.data?.semanticRole === handle))?.target;\nconst portNode = (id) => byId(id);\nconst updated = [];\nconst write = async (id, data) => { if (!id || !byId(id)) return; await api.updateNode(id, { data: { ...(byId(id).data || {}), ...data } }); updated.push(id); };\nawait write(declaration?.id, { nodeClass });\nawait write(targetOf('default-view'), { html: detailHtml });\nawait write(targetOf('summary-view'), { html: summaryHtml });\nawait write(targetOf('icon-view'), { html: iconHtml });\nawait write(targetOf('editor-view'), { editor });\nawait write(targetOf('landing-surface'), { content: { kind: 'html', value: page }, renderShape: { kind: 'html' } });\nreturn { updated, key, fields: fields.length, ports: ports.length, events: events.length };\n",
        "parameters": [],
        "effects": [
          {
            "kind": "update-node",
            "targets": [
              "node-class-template-declaration",
              "node-class-template-detail",
              "node-class-template-summary",
              "node-class-template-icon",
              "node-class-template-editor",
              "node-class-template-landing"
            ]
          }
        ],
        "allowMutations": true,
        "dryRun": false
      }
    },
    {
      "id": "node-class-template-on-property",
