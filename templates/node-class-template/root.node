    {
      "id": "node-class-template-derive-method",
      "type": "method",
      "label": "Derive the class",
      "position": {
        "x": 1500,
        "y": 2100
      },
      "width": 420,
      "height": 300,
      "visible": true,
      "showLabel": true,
      "ports": [
        {
          "id": "call",
          "key": "call",
          "label": "Call",
          "direction": "input",
          "dataType": "event",
          "angle": 180
        },
        {
          "id": "result",
          "key": "result",
          "label": "Result",
          "direction": "output",
          "dataType": "value",
          "angle": 0
        }
      ],
      "handles": [
        {
          "id": "call",
          "key": "call",
          "portId": "call",
          "label": "Call",
          "direction": "input",
          "dataType": "event",
          "angle": 180
        },
        {
          "id": "result",
          "key": "result",
          "portId": "result",
          "label": "Result",
          "direction": "output",
          "dataType": "value",
          "angle": 0
        }
      ],
      "data": {
        "scriptName": "Refresh exposed views",
        "source": "// Derives the node class this graph describes, from its Properties and its rows, and keeps everything the class shows current:\n//   - the class itself, on the Declaration (key, label, meaning, required keys, and the defaults every new node starts with),\n//   - the views every node of the class shows: detail, summary and icon, as templates over the node's data, and its editor,\n//   - the page this graph opens on, which lists the class and draws a specimen of it.\n// Every Handler in the graph calls this one Method, so what the class says is always what its rows say. It writes only the\n// nodes its declared effects name.\n\nconst clean = (value) => String(value ?? '').trim();\nconst isObject = (value) => Boolean(value && typeof value === 'object' && !Array.isArray(value));\nconst escapeXml = (value) => String(value ?? '').replace(/[&<>\"']/g, (character) => ({\n  '&': '&amp;', '<': '&lt;', '>': '&gt;', '\"': '&quot;', \"'\": '&apos;'\n})[character]);\n\nconst nodes = await api.getNodes();\nconst byId = (id) => nodes.find((node) => node?.id === id);\nconst bindingKey = (node) => clean(node?.data?._classBinding?.key || node?.data?.definitionKey).toLowerCase();\nconst rowsOf = (key) => nodes.filter((node) => bindingKey(node) === key || clean(node?.type).toLowerCase() === key);\n\n// --- Properties ----------------------------------------------------------------------------------------------------------\nconst properties = {};\nfor (const node of nodes) {\n  if (bindingKey(node) !== 'property' && clean(node?.type).toLowerCase() !== 'property') continue;\n  const data = node.data || {};\n  const name = clean(data.name);\n  if (!name) continue;\n  if (Object.hasOwn(data, 'value') && data.value !== undefined) properties[name] = data.value;\n  else if (Object.hasOwn(data, 'defaultValue') && data.defaultValue !== undefined) properties[name] = data.defaultValue;\n}\nconst key = clean(properties.key);\nif (!key) return { updated: [], skipped: 'The class has no key yet' };\nconst label = clean(properties.label) || key;\nconst meaning = clean(properties.meaning);\nconst number = (value, fallback) => { const parsed = Number(value); return Number.isFinite(parsed) && parsed > 0 ? Math.round(parsed) : fallback; };\nconst size = { width: number(properties.width, 420), height: number(properties.height, 260) };\nconst glyphName = clean(properties.glyph) || 'Article';\nconst declaration = nodes.find((node) => node?.type === 'declaration');\nconst classRef = clean(declaration?.data?.document?.url);\n\n// --- Rows ------------------------------------------------------------------------------------------------------------------\nconst toBoolean = (value) => ['true', 'yes', '1', 'on'].includes(clean(value).toLowerCase()) || value === true;\nconst FIELD_TYPES = ['text', 'multiline', 'number', 'boolean', 'select'];\nconst humanize = (name) => clean(name).replace(/([a-z0-9])([A-Z])/g, '$1 $2').replace(/[-_.]+/g, ' ').replace(/^./, (c) => c.toUpperCase());\nconst optionList = (value) => clean(value).split(',').map(clean).filter(Boolean);\nconst fields = rowsOf('class-field-row').map((node) => {\n  const data = node.data || {};\n  const name = clean(data.name);\n  const type = FIELD_TYPES.includes(clean(data.fieldType)) ? clean(data.fieldType) : 'text';\n  return { name, label: clean(data.label) || humanize(name), type, required: toBoolean(data.required), defaultValue: data.defaultValue, options: optionList(data.options), description: clean(data.description) };\n}).filter((field) => field.name);\nconst coerce = (field) => {\n  const raw = field.defaultValue;\n  if (field.type === 'number') { const parsed = Number(raw); return Number.isFinite(parsed) ? parsed : 0; }\n  if (field.type === 'boolean') return toBoolean(raw);\n  return clean(raw);\n};\nconst SIDE_ANGLE = { top: 270, right: 0, bottom: 90, left: 180 };\nconst ports = rowsOf('class-port-row').map((node) => {\n  const data = node.data || {};\n  const id = clean(data.portId);\n  const side = SIDE_ANGLE[clean(data.side)] !== undefined ? clean(data.side) : 'top';\n  const offset = Number.isFinite(Number(data.offset)) ? Math.max(0, Math.min(1, Number(data.offset))) : 0.5;\n  const accepts = clean(data.acceptsEdgeClasses).split(',').map(clean).filter(Boolean);\n  return {\n    id, key: id, label: clean(data.label) || id,\n    direction: ['input', 'output', 'bidirectional'].includes(clean(data.direction)) ? clean(data.direction) : 'bidirectional',\n    dataType: clean(data.dataType) || 'any', angle: SIDE_ANGLE[side], position: { side, offset },\n    ...(accepts.length ? { allowedEdgeTypes: accepts } : {})\n  };\n}).filter((port) => port.id);\nconst events = rowsOf('class-event-row').map((node) => {\n  const data = node.data || {};\n  return { eventKey: clean(data.eventKey), label: clean(data.label) || clean(data.eventKey), payloadContract: { type: 'object' } };\n}).filter((event) => event.eventKey);\n\n// --- The class -------------------------------------------------------------------------------------------------------------\nconst defaultData = Object.fromEntries(fields.map((field) => [field.name, coerce(field)]));\nconst defaults = {\n  label, size, showLabel: false,\n  data: { ...defaultData, presentation: { glyph: { kind: 'icon', name: glyphName } } },\n  ports, events\n};\nconst nodeClass = {\n  contractVersion: '1.0.0', key, label, meaning,\n  requiredDataKeys: fields.filter((field) => field.required).map((field) => field.name),\n  nodeDef: { key, ref: classRef, source: 'github', version: '>=0.1.0', defaults }\n};\n\n// --- What a node of the class shows ------------------------------------------------------------------------------------------\nconst heading = fields.find((field) => field.required) || fields[0] || null;\nconst rest = fields.filter((field) => field !== heading);\nconst slot = (field) => `{{data.${field.name}}}`;\nconst card = (padding, radius, background, inner) => `<div style='width:100%;height:100%;box-sizing:border-box;padding:${padding}px;border-radius:${radius}px;background:${background};border:1px solid #e2e8f0;font-family:system-ui;color:#0f172a;overflow:hidden'>${inner}</div>`;\nconst titleHtml = heading ? `<div style='font:800 24px/1.2 system-ui;margin-bottom:12px'>${slot(heading)}</div>` : `<div style='font:800 24px/1.2 system-ui;margin-bottom:12px'>${escapeXml(label)}</div>`;\nconst rowHtml = (field) => `<div style='margin-bottom:10px'><div style='font:700 11px/1.4 system-ui;letter-spacing:.06em;text-transform:uppercase;color:#64748b'>${escapeXml(field.label)}</div><div style='font:400 15px/1.5 system-ui;color:#334155'>${slot(field)}</div></div>`;\nconst detailHtml = card(24, 22, '#ffffff', titleHtml + rest.map(rowHtml).join(''));\nconst summaryHtml = card(20, 20, '#ffffff', titleHtml + rest.slice(0, 2).map(rowHtml).join(''));\nconst iconHtml = card(16, 18, '#ede9fe', `<div style='color:#7c3aed;font-size:22px;font-weight:800'>${escapeXml(label.charAt(0) || '?')}</div><div style='font:800 15px/1.2 system-ui;margin-top:8px'>${heading ? slot(heading) : escapeXml(label)}</div>`);\nconst EDITOR_TYPES = { text: 'text', multiline: 'textarea', number: 'number', boolean: 'checkbox', select: 'select' };\nconst editor = { web: { fields: [\n  { key: 'label', label: 'Label', type: 'text', path: 'label' },\n  ...fields.map((field) => ({\n    key: field.name, label: field.label, type: field.type === 'select' && !field.options.length ? 'text' : EDITOR_TYPES[field.type], path: `data.${field.name}`,\n    ...(field.type === 'select' && field.options.length ? { options: field.options.map((value) => ({ label: humanize(value), value })) } : {}),\n    ...(field.description ? { placeholder: field.description } : {})\n  }))\n] } };\n\n// --- The page this graph opens on --------------------------------------------------------------------------------------------\nconst fill = (html) => html.replace(/\\{\\{data\\.([^}]+)\\}\\}/g, (_, name) => escapeXml(defaultData[name] ?? ''));\nconst table = (head, body) => `<table style='border-collapse:collapse;width:100%;font:400 14px/1.5 system-ui'><thead><tr>${head.map((cell) => `<th style='text-align:left;padding:6px 12px 6px 0;font:700 12px/1.4 system-ui;color:#64748b;border-bottom:1px solid #e2e8f0'>${escapeXml(cell)}</th>`).join('')}</tr></thead><tbody>${body.map((row) => `<tr>${row.map((cell) => `<td style='padding:6px 12px 6px 0;border-bottom:1px solid #f1f5f9;color:#0f172a'>${escapeXml(cell)}</td>`).join('')}</tr>`).join('')}</tbody></table>`;\nconst heading2 = (text) => `<h2 style='margin:0 0 12px;font:800 24px/1.2 system-ui;color:#0f172a'>${escapeXml(text)}</h2>`;\nconst paragraphs = (value) => clean(value).split(/\\n{2,}/).map((part) => part.trim()).filter(Boolean)\n  .map((part) => `<p style='margin:0 0 12px;max-width:60ch;font:400 16px/1.6 system-ui;color:#334155'>${escapeXml(part).replace(/\\n/g, '<br>')}</p>`).join('');\nconst section = (title, inner) => `<section style='padding:24px 40px'>${heading2(title)}${inner}</section>`;\nconst sections = nodes.filter((node) => bindingKey(node) === 'page-section').map((node) => section(node.data?.title, paragraphs(node.data?.body))).join('');\nconst settings = [['Key', key], ['Label', label], ['Meaning', meaning], ['Size', `${size.width} by ${size.height}`], ['Glyph', glyphName], ['Required fields', nodeClass.requiredDataKeys.join(', ') || 'none']]\n  .filter(([, value]) => clean(value));\nconst page = `<div style='min-height:100%;box-sizing:border-box;background:#ffffff;font-family:system-ui'>`\n  + `<header style='padding:48px 40px 20px'><div style='font:800 12px/1 system-ui;letter-spacing:.18em;color:#0f766e;margin-bottom:14px'>NODE CLASS · ${escapeXml(key)}</div>`\n  + `<h1 style='margin:0 0 12px;font:850 40px/1.05 system-ui;color:#0f172a'>${escapeXml(label)}</h1>`\n  + (meaning ? `<p style='margin:0;max-width:44ch;font:400 19px/1.5 system-ui;color:#475569'>${escapeXml(meaning)}</p>` : '') + `</header>`\n  + section('Specimen', `<div style='display:flex;gap:24px;align-items:flex-start;flex-wrap:wrap'><div style='width:${Math.min(size.width, 460)}px;height:${Math.min(size.height, 340)}px'>${fill(detailHtml)}</div><div style='width:${Math.min(size.width, 300) / 1.4}px;height:${Math.min(size.height, 200) / 1.4}px'>${fill(summaryHtml)}</div><div style='width:120px;height:110px'>${fill(iconHtml)}</div></div>`)\n  + section('Settings', `<dl style='margin:0;max-width:560px;display:grid;grid-template-columns:max-content 1fr;gap:8px 24px;padding:18px 22px;border-radius:14px;background:#f8fafc;border:1px solid #e2e8f0'>${settings.map(([name, value]) => `<dt style='font:700 13px/1.5 system-ui;color:#64748b'>${escapeXml(name)}</dt><dd style='margin:0;font:500 15px/1.5 system-ui;color:#0f172a'>${escapeXml(value)}</dd>`).join('')}</dl>`)\n  + section('Fields', fields.length ? table(['Name', 'Type', 'Required', 'Default'], fields.map((field) => [field.name, field.type + (field.options.length ? ` (${field.options.join(', ')})` : ''), field.required ? 'yes' : 'no', clean(defaultData[field.name]) || '—'])) : `<p style='margin:0;color:#64748b'>No fields yet. Add a field row.</p>`)\n  + section('Ports', ports.length ? table(['Id', 'Direction', 'Side', 'Accepts'], ports.map((port) => [port.id, port.direction, `${port.position.side} at ${port.position.offset}`, (port.allowedEdgeTypes || ['any edge']).join(', ')])) : `<p style='margin:0;color:#64748b'>No ports yet. Add a port row.</p>`)\n  + section('Events', events.length ? table(['Event', 'Label'], events.map((event) => [event.eventKey, event.label])) : `<p style='margin:0;color:#64748b'>No events.</p>`)\n  + sections + `</div>`;\n\n// --- Write only what changed the effects name -------------------------------------------------------------------------------\nconst edges = await api.getEdges();\nconst targetOf = (handle) => edges.find((edge) => edge.source === declaration?.id && (edge.sourceHandle === handle || edge.data?.semanticRole === handle))?.target;\nconst portNode = (id) => byId(id);\nconst updated = [];\nconst write = async (id, data) => { if (!id || !byId(id)) return; await api.updateNode(id, { data: { ...(byId(id).data || {}), ...data } }); updated.push(id); };\nawait write(declaration?.id, { nodeClass });\nawait write(targetOf('default-view'), { html: detailHtml });\nawait write(targetOf('summary-view'), { html: summaryHtml });\nawait write(targetOf('icon-view'), { html: iconHtml });\nawait write(targetOf('editor-view'), { editor });\nawait write(targetOf('landing-surface'), { content: { kind: 'html', value: page }, renderShape: { kind: 'html' } });\nreturn { updated, key, fields: fields.length, ports: ports.length, events: events.length };\n",
        "parameters": [],
        "effects": [
          {
            "kind": "update-node",
            "targets": [
              "node-class-template-declaration",
              "node-class-template-detail",
              "node-class-template-summary",
              "node-class-template-icon",
              "node-class-template-editor",
              "node-class-template-landing"
            ]
          }
        ],
        "allowMutations": true,
        "dryRun": false
      }
    },
