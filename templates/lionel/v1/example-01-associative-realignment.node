bel":"bottom","direction":"bidirectional","dataType":"value","angle":90},{"id":"left","label":"left","direction":"bidirectional","dataType":"value","angle":180}],"visible":true,"showLabel":false,"data":{"title":"Associative Realignment Live Episode","sourceUrl":"","publishedAt":"","durationSeconds":4980,"containerMode":"live-lionel-owned","sequenceController":"live-thematic-thread","navigationMode":"branch-and-return","summary":"A live monologue organized around perceived political realignment. Chat, remembered examples, personal tangents, named actors, and historical analogies repeatedly open branches, but Lionel returns to the larger question of what political alignment is replacing the old one.","notes":"Structural observation from the supplied transcript. Political and factual claims inside the episode remain attributed to Lionel.","definitionKey":"lionel-episode","_classBinding":{"key":"lionel-episode","sourceRef":"github://mikemartinez1974/public/templates/lionel/v1/classes/nodes/lionel-episode.node-class.node"},"_bridge":{"classKey":"lionel-episode","classRef":"github://mikemartinez1974/public/templates/lionel/v1/classes/nodes/lionel-episode.node-class.node","entryPort":"root","kind":"node-class","sourceRef":"github://mikemartinez1974/public/templates/lionel/v1/classes/nodes/lionel-episode.node-class.node","targetKind":"node-class"},"identity":{"graphId":"lionel-v1-example-01-associative-realignment"}}},{"id":"issue","type":"issue-scope","label":"Political Realignment","position":{"x":-760,"y":-130},"width":440,"height":320,"ports":[{"id":"root","label":"root","direction":"bidirectional","dataType":"any","angle":210},{"id":"top","label":"top","direction":"bidirectional","dataType":"value","angle":270},{"id":"right","label":"right","direction":"bidirectional","dataType":"value","angle":0},{"id":"bottom","label":"bottom","direction":"bidirectional","dataType":"value","angle":90},{"id":"left","label":"left","direction":"bidirectional","dataType":"value","angle":180}],"visible":true,"showLabel":false,"data":{"title":"Political Realignment","question":"How does Lionel explain the breakdown of the old political alignment and the emergence of a new issue-based coalition?","scope":"Track movement change, actor defections, cross-ideological alignment, and coalition formation. Do not treat Lionel's allegations about motives or events as established facts.","standard":"Connect turning points, actor positions, research networks, and historical coalition analogies without confusing side threads with the primary issue.","burden":"Preserve attribution and distinguish structural observation from speaker claims.","summary":"The persistent analytical question beneath the episode's many conversational branches.","notes":"Issue Scope is intentionally narrower than the full topic list.","definitionKey":"issue-scope","_classBinding":{"key":"issue-scope","sourceRef":"github://mikemartinez1974/public/templates/lionel/v1/classes/nodes/issue-scope.node-class.node"},"_bridge":{"classKey":"issue-scope","classRef":"github://mikemartinez1974/public/templates/lionel/v1/classes/nodes/issue-scope.node-class.node","entryPort":"root","kind":"node-class","sourceRef":"github://mikemartinez1974/public/templates/lionel/v1/classes/nodes/issue-scope.node-class.node","targetKind":"node-class"},"identity":{"graphId":"lionel-v1-example-01-associative-realignment"}}},{"id":"thread-main","type":"topic-thread","label":"Main Thread","position":{"x":-220,"y":-130},"width":420,"height":300,"ports":[{"id":"root","label":"root","direction":"bidirectional","dataType":"any","angle":210},{"id":"top","label":"top","direction":"bidirectional","dataType":"value","angle":270},{"id":"right","label":"right","direction":"bidirectional","dataType":"value","angle":0},{"id":"bottom","label":"bottom","direction":"bidirectional","dataType":"value","angle":90},{"id":"left","label":"left","direction":"bidirectional","dataType":"value","angle":180}],"visible":true,"showLabel":false,"data":{"title":"What replaces the old alignment?","status":"active","parentThreadId":"","returnPoint":"","branchTrigger":"persistent live theme","summary":"Main conversation thread: political realignment, changing loyalties, and the search for a new coalition.","notes":"Branches can leave this thread for several minutes and later return.","definitionKey":"topic-thread","_classBinding":{"key":"topic-thread","sourceRef":"github://mikemartinez1974/public/templates/lionel/v1/classes/nodes/topic-thread.node-class.node"},"_bridge":{"classKey":"topic-thread","classRef":"github://mikemartinez1974/public/templates/lionel/v1/classes/nodes/topic-thread.node-class.node","entryPort":"root","kind":"node-class","sourceRef":"github://mikemartinez1974/public/templates/lionel/v1/classes/nodes/topic-thread.node-class.node","targetKind":"node-class"},"identity":{"graphId":"lionel-v1-example-01-associative-realignment"}}},{"id":"thread-branch","type":"topic-thread","label":"Probiotic / Food Branch","position":{"x":300,"y":-130},"width":420,"height":300,"ports":[{"id":"root","label":"root","direction":"bidirectional","dataType":"any","angle":210},{"id":"top","label":"top","direction":"bidirectional","dataType":"value","angle":270},{"id":"right","label":"right","direction":"bidirectional","dataType":"value","angle":0},{"id":"bottom","label":"bottom","direction":"bidirectional","dataType":"value","angle":90},{"id":"left","label":"left","direction":"bidirectional","dataType":"value","angle":180}],"visible":true,"showLabel":false,"data":{"title":"Probiotics, sauerkraut, kimchi, and food","status":"resumed","parentThreadId":"thread-main","returnPoint":"thread-main","branchTrigger":"live-chat clarification around 13:02","summary":"A playful audience-triggered branch that Lionel explicitly uses to describe his own back-and-forth navigation before returning to the political thread around 14:30.","notes":"Navigation example, not a new analytical issue.","definitionKey":"topic-thread","_classBinding":{"key":"topic-thread","sourceRef":"github://mikemartinez1974/public/templates/lionel/v1/classes/nodes/topic-thread.node-class.node"},"_bridge":{"classKey":"topic-thread","classRef":"github://mikemartinez1974/public/templates/lionel/v1/classes/nodes/topic-thread.node-class.node","entryPort":"root","kind":"node-class","sourceRef":"github://mikemartinez1974/public/templates/lionel/v1/classes/nodes/topic-thread.node-class.node","targetKind":"node-class"},"identity":{"graphId":"lionel-v1-example-01-associative-realignment"}}},{"id":"actor-field","type":"actor-field","label":"Emerging Actor Field","position":{"x":-760,"y":330},"width":440,"height":320,"ports":[{"id":"root","label":"root","direction":"bidirectional","dataType":"any","angle":210},{"id":"top","label":"top","direction":"bidirectional","dataType":"value","angle":270},{"id":"right","label":"right","direction":"bidirectional","dataType":"value","angle":0},{"id":"bottom","label":"bottom","direction":"bidirectional","dataType":"value","angle":90},{"id":"left","label":"left","direction":"bidirectional","dataType":"value","angle":180}],"visible":true,"showLabel":false,"data":{"title":"Emerging Actor Field","issue":"Political Realignment","actors":"Donald Trump; Candace Owens; Tucker Carlson; Laura Loomer; Robert Barnes; Baron Coleman; Alex Jones; Roger Stone; audience/chat contributors","pattern":"Lionel repeatedly evaluates who still belongs to an old movement, who has crossed a line, who can still change, who supplies useful information, and who might participate in a new issue-based alignment.","summary":"Actors are mapped by role in Lionel's evolving alignment story rather than by fixed party identity.","notes":"These are rhetorical roles in the episode, not independent judgments about the people named.","definitionKey":"actor-field","_classBinding":{"key":"actor-field","sourceRef":"github://mikemartinez1974/public/templates/lionel/v1/classes/nodes/actor-field.node-class.node"},"_bridge":{"classKey":"actor-field","classRef":"github://mikemartinez1974/public/templates/lionel/v1/classes/nodes/actor-field.node-class.node","entryPort":"root","kind":"node-class","sourceRef":"github://mikemartinez1974/public/templates/lionel/v1/classes/nodes/actor-field.node-class.node","targetKind":"node-class"},"identity":{"graphId":"lionel-v1-example-01-associative-realignment"}}},{"id":"research-funnel","type":"research-funnel","label":"Research Funnel","position":{"x":-220,"y":330},"width":440,"height":320,"ports":[{"id":"root","label":"root","direction":"bidirectional","dataType":"any","angle":210},{"id":"top","label":"top","direction":"bidirectional","dataType":"value","angle":270},{"id":"right","label":"right","direction":"bidirectional","dataType":"value","angle":0},{"id":"bottom","label":"bottom","direction":"bidirectional","dataType":"value","angle":90},{"id":"left","label":"left","direction":"bidirectional","dataType":"value","angle":180}],"visible":true,"showLabel":false,"data":{"title":"Candace / Crowd Research Funnel","intake":"Tips and public submissions described by Lionel as flowing toward Candace Owens and related commentators.","contributors":"Independent viewers/researchers, Baron Coleman, and other contributors Lionel references.","verification":"Discard noise, inspect promising items, enlarge or compare media, and circulate surviving leads for more scrutiny.","output":"Material Lionel describes as worth discussing, promoting, or passing to others.","summary":"The episode models research as information flow through filtering and promotion rather than as a flat source list.","notes":"This captures Lionel's description of the network and does not validate the underlying claims.","definitionKey":"research-funnel","_classBinding":{"key":"research-funnel","sourceRef":"github://mikemartinez1974/public/templates/lionel/v1/classes/nodes/research-funnel.node-class.node"},"_bridge":{"classKey":"research-funnel","classRef":"github://mikemartinez1974/public/templates/lionel/v1/classes/nodes/research-funnel.node-class.node","entryPort":"root","kind":"node-class","sourceRef":"github://mikemartinez1974/public/templates/lionel/v1/classes/nodes/research-funnel.node-class.node","targetKind":"node-class"},"identity":{"graphId":"lionel-v1-example-01-associative-realignment"}}},{"id":"coalition","type":"coalition","label":"Issue-Based Coalition","position":{"x":320,"y":330},"width":440,"height":320,"ports":[{"id":"root","label":"root","direction":"bidirectional","dataType":"any","angle":210},{"id":"top","label":"top","direction":"bidirectional","dataType":"value","angle":270},{"id":"right","label":"right","direction":"bidirectional","dataType":"value","angle":0},{"id":"bottom","label":"bottom","direction":"bidirectional","dataType":"value","angle":90},{"id":"left","label":"left","direction":"bidirectional","dataType":"value","angle":180}],"visible":true,"showLabel":false,"data":{"title":"Issue-Based Coalition","basis":"Shared priorities around what Lionel calls the stuff that matters, rather than total ideological agreement.","members":"Historical examples include Southern defectors, the religious right, constitutionalists, Tea Party, Second Amendment groups, and libertarians; contemporary figures are discussed more loosely.","tensions":"Old party identity, foreign-policy disagreements, and changing trust in movement leaders.","summary":"Lionel uses historical Republican coalition-building as an analogy for how a new cross-boundary political coalition might form.","notes":"Captures Lionel's analogy and proposal, not a claim that such a coalition objectively exists.","definitionKey":"coalition","_classBinding":{"key":"coalition","sourceRef":"github://mikemartinez1974/public/templates/lionel/v1/classes/nodes/coalition.node-class.node"},"_bridge":{"classKey":"coalition","classRef":"github://mikemartinez1974/public/templates/lionel/v1/classes/nodes/coalition.node-class.node","entryPort":"root","kind":"node-class","sourceRef":"github://mikemartinez1974/public/templates/lionel/v1/classes/nodes/coalition.node-class.node","targetKind":"node-class"},"identity":{"graphId":"lionel-v1-example-01-associative-realignment"}}},{"id":"op-frame","type":"lionel-operation","label":"Frame and Catch Up","position":{"x":-760,"y":1320},"width":420,"height":300,"ports":[{"id":"root","label":"root","direction":"bidirectional","dataType":"any","angle":210},{"id":"top","label":"top","direction":"bidirectional","dataType":"value","angle":270},{"id":"right","label":"right","direction":"bidirectional","dataType":"value","angle":0},{"id":"bottom","label":"bottom","direction":"bidirectional","dataType":"value","angle":90},{"id":"left","label":"left","direction":"bidirectional","dataType":"value","angle":180}],"visible":true,"showLabel":false,"data":{"title":"Frame and Catch Up","operationRole":"adds-context","startTime":"0:00","endTime":"14:41","target":"Political Realignment","roleDetail":"alarm hook, sponsor, historical catch-up, live side branch","certainty":"structural-observation","summary":"Frames a chaotic political moment, moves through a sponsor, then gives a catch-up story about Trump-era politics while chat opens the probiotic branch.","notes":"Production and argument are kept conceptually separate even though they are interleaved in time.","definitionKey":"lionel-operation","_classBinding":{"key":"lionel-operation","sourceRef":"github://mikemartinez1974/public/templates/lionel/v1/classes/nodes/lionel-operation.node-class.node"},"_bridge":{"classKey":"lionel-operation","classRef":"github://mikemartinez1974/public/templates/lionel/v1/classes/nodes/lionel-operation.node-class.node","entryPort":"root","kind":"node-class","sourceRef":"github://mikemartinez1974/public/templates/lionel/v1/classes/nodes/lionel-operation.node-class.node","targetKind":"node-class"},"identity":{"graphId":"lionel-v1-example-01-associative-realignment"}}},{"id":"op-turning","type":"lionel-operation","label":"Locate the Turning Point","position":{"x":-300,"y":1320},"w