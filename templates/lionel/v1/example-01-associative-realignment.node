:06:10","endTime":"1:15:22","target":"Political Realignment","roleDetail":"historical coalition model","certainty":"structural-observation","summary":"Uses historical Republican coalition-building to explain how groups with different identities can join around overlapping priorities.","notes":"The analogy supports the episode's emerging-coalition model.","definitionKey":"lionel-operation","_classBinding":{"key":"lionel-operation","sourceRef":"github://mikemartinez1974/public/templates/lionel/v1/classes/nodes/lionel-operation.node-class.node"},"_bridge":{"classKey":"lionel-operation","classRef":"github://mikemartinez1974/public/templates/lionel/v1/classes/nodes/lionel-operation.node-class.node","entryPort":"root","kind":"node-class","sourceRef":"github://mikemartinez1974/public/templates/lionel/v1/classes/nodes/lionel-operation.node-class.node","targetKind":"node-class"},"identity":{"graphId":"lionel-v1-example-01-associative-realignment"}}},{"id":"op-community","type":"lionel-operation","label":"Community Synthesis","position":{"x":1080,"y":1320},"width":420,"height":300,"ports":[{"id":"root","label":"root","direction":"bidirectional","dataType":"any","angle":210},{"id":"top","label":"top","direction":"bidirectional","dataType":"value","angle":270},{"id":"right","label":"right","direction":"bidirectional","dataType":"value","angle":0},{"id":"bottom","label":"bottom","direction":"bidirectional","dataType":"value","angle":90},{"id":"left","label":"left","direction":"bidirectional","dataType":"value","angle":180}],"visible":true,"showLabel":false,"data":{"title":"Community Synthesis","operationRole":"incorporates-audience","startTime":"1:16:08","endTime":"1:23:00","target":"Political Realignment","roleDetail":"community close","certainty":"structural-observation","summary":"Turns the analysis outward, tells viewers they are on the same team despite differences, thanks moderators and participants, and closes with a Sunday-family ritual.","notes":"Audience becomes part o