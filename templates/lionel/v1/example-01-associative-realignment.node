{"fileVersion":"1.0","metadata":{"title":"Lionel v1 Example 01: Associative Realignment","description":"A worked class-backed Lionel Template v1 episode graph derived from the supplied live transcript.","graphId":"lionel-v1-example-01-associative-realignment","version":"0.2.0","kind":"graph","created":"2026-08-07T15:54:00.000Z","modified":"2026-08-07T17:45:00.000Z","author":"","tags":["lionel","template-v1","class-backed","episode-example","branch-and-return","people-portals"],"preferredViewer":"https://twilite.zone"},"nodes":[{"id":"example-declaration","type":"declaration","label":"Lionel v1 Example 01 Declaration","position":{"x":-1420,"y":-1040},"width":460,"height":360,"ports":[{"id":"root","label":"root","direction":"bidirectional","dataType":"any","angle":210}],"visible":true,"showLabel":true,"data":{"identity":{"graphId":"lionel-v1-example-01-associative-realignment","name":"Lionel v1 Example 01: Associative Realignment","version":"0.2.0","description":"A worked class-backed episode graph derived with Lionel Template v1."},"intent":{"kind":"graph","scope":"example","artifactKind":"episode-analysis"},"declaration":{"kind":"graph","targetMode":"artifact","artifactKind":"graph","defaultSurfaceId":"root","surfaces":[{"id":"root","kind":"port","label":"Associative Realignment","portNodeId":"home","viewNodeId":"home","exposes":{"views":{"mode":"allow"},"declarations":{"mode":"allow"}}}]},"dependencies":{"nodeTypes":["declaration","port","portal","bridge","markdown","lionel-episode","issue-scope","topic-thread","actor-field","research-funnel","coalition","lionel-operation"],"portContracts":["core"],"skills":["lionel-v1"],"schemaVersions":{"nodes":">=1.0.0","ports":">=1.0.0"},"optional":[]},"authority":{"mutation":{"allowCreate":true,"allowUpdate":true,"allowDelete":true,"appendOnly":false},"actors":{"humans":true,"agents":true,"tools":true},"styleAuthority":"descriptive","history":{"rewriteAllowed":false,"squashAllowed":false}},"template":{"sourceRef":"github://mikemartinez1974/public/templates/lionel/v1/root.node","version":"0.2.0","classBacked":true}}},{"id":"home","type":"port","label":"Lionel Episode Example","position":{"x":-880,"y":-1040},"width":720,"height":340,"ports":[{"id":"root","label":"root","direction":"bidirectional","dataType":"any","angle":210}],"visible":true,"showLabel":false,"data":{"identity":{"graphId":"lionel-v1-example-01-associative-realignment","portId":"root","name":"Lionel v1 Example 01"},"title":"Lionel v1 Example 01","purpose":"Worked class-backed example of a live episode whose persistent political-realignment thread survives repeated side branches.","renderShape":{"kind":"markdown"},"markdown":"# 🎙️ Lionel v1 Example 01\n\n## Associative Realignment\n\n**Container:** live Lionel-owned  \n**Sequence controller:** live-thematic-thread  \n**Navigation:** branch-and-return  \n**Runtime:** ~1:23:00\n\n`FRAME → CATCH UP → FIND TURNING POINT → MAP ACTORS → MAP RESEARCH → MODEL COALITION → COMMUNITY CLOSE`\n\n**The thread survives by return operations.**","view":{"intent":"node","payload":"node.web.summary","label":"Lionel v1 Example 01"},"payload":"node.web.summary","intent":"node","key":"node.web.summary","viewRole":"summary","viewKind":"display","semanticLevel":"summary","visibilityRole":"browser"}},{"id":"b-lionel-episode","type":"bridge","label":"Lionel Episode","position":{"x":-1780,"y":-650},"width":280,"height":90,"ports":[{"id":"root","label":"root","direction":"bidirectional","dataType":"any","angle":210}],"visible":false,"showLabel":true,"data":{"authority":"bridge","target":{"mode":"bridge","ref":"github://mikemartinez1974/public/templates/lionel/v1/classes/nodes/lionel-episode.node-class.node","kind":"node-class","scope":"focused-graph","grants":["create"],"key":"lionel-episode"},"_classBinding":{"key":"lionel-episode","sourceRef":"github://mikemartinez1974/public/templates/lionel/v1/classes/nodes/lionel-episode.node-class.node"},"_bridge":{"classKey":"lionel-episode","classRef":"github:/