root","label":"root","direction":"bidirectional","dataType":"any","angle":210},{"id":"bottom","label":"bottom","direction":"bidirectional","dataType":"value","angle":90}],"visible":true,"showLabel":false,"data":{"identity":{"graphId":"lionel-v1-example-02-debate-surrogate-collapse","portId":"root","name":"Lionel v1 Example 02"},"target":{"graphId":"lionel-v1-example-02-debate-surrogate-collapse","mode":"navigate"},"renderShape":{"kind":"markdown"},"markdown":"# 🎙️ Lionel v1 Example 02\n\n## Debate Surrogate Collapse\n\n**Container:** live Lionel-owned  \n**Sequence controller:** media-reaction-thread  \n**Navigation:** branch-and-return  \n**Runtime:** ~1:07:40\n\n`MOCK CLAIM → COUNTEROFFER → TEST CHARACTER → TRACE SPONSORSHIP → CROSS-CHECK → WIDEN FRAME → CLOSE`\n\n**Public performance can discredit a surrogate before the formal debate happens.**","visibilityRole":"browser"}},{"id":"b-lionel-episode","type":"bridge","label":"Lionel Episode","position":{"x":-1640,"y":-600},"width":260,"height":80,"ports":[{"id":"root","label":"root","direction":"bidirectional","dataType":"any","angle":210}],"visible":false,"showLabel":true,"data":{"authority":"bridge","target":{"mode":"bridge","ref":"github://mikemartinez1974/public/templates/lionel/v1/classes/nodes/lionel-episode.node-class.node","kind":"node-class","scope":"focused-graph","grants":["create"],"key":"lionel-episode"},"_classBinding":{"key":"lionel-episode","sourceRef":"github://mikemartinez1974/public/templates/lionel/v1/classes/nodes/lionel-episode.node-class.node"}}},{"id":"b-issue-scope","type":"bridge","label":"Issue Scope","position":{"x":-1640,"y":-500},"width":260,"height":80,"ports":[{"id":"root","label":"root","direction":"bidirectional","dataType":"any","angle":210}],"visible":false,"showLabel":true,"data":{"authority":"bridge","target":{"mode":"bridge","ref":"github://mikemartinez1974/public/templates/lionel/v1/classes/nodes/issue-scope.node-class.node","kind":"node-class","scope":"focused-graph","grants":["create"],"key":"issue-scope"},"_classBinding":{"key":"issue-scope","sourceRef":"github://mikemartinez1974/public/templates/lionel/v1/classes/nodes/issue-scope.node-class.node"}}},{"id":"b-topic-thread","type":"bridge","label":"Topic Thread","position":{"x":-1640,"y":-400},"width":260,"height":80,"ports":[{"id":"root","label":"root","direction":"bidirectional","dataType":"any","angle":210}],"visible":false,"showLabel":true,"data":{"authority":"bridge","target":{"mode":"bridge","ref":"github://mikemartinez1974/public/templates/lionel/v1/classes/nodes/topic-thread.node-class.node","kind":"node-class","scope":"focused-graph","grants":["create"],"key":"topic-thread"},"_classBinding":{"key":"topic-thread","sourceRef":"github://mikemartinez1974/public/templates/lionel/v1/classes/nodes/topic-thread.node-class.node"}}},{"id":"b-lionel-operation","type":"bridge","label":"Lionel Operation","position":{"x":-1640,"y":-300},"width":260,"height":80,"ports":[{"id":"root","label":"root","direction":"bidirectional","dataType":"any","angle":210}],"visible":false,"showLabel":true,"data":{"authority":"bridge","target":{"mode":"bridge","ref":"github://mikemartinez1974/public/templates/lionel/v1/classes/nodes/lionel-operation.node-class.node","kind":"node-class","scope":"focused-graph","grants":["create"],"key":"lionel-operation"},"_classBinding":{"key":"lionel-operation","sourceRef":"github://mikemartinez1974/public/templates/lionel/v1/classes/nodes/lionel-operation.node-class.node"}}},{"id":"episode","type":"lionel-episode","label":"Lionel Episode","position":{"x":-300,"y":-620},"width":430,"height":300,"ports":[{"id":"root","label":"root","direction":"bidirectional","dataType":"any","angle":210},{"id":"top","label":"top","direction":"bidirectional","dataType":"value","angle":270},{"id":"right","label":"right","direction":"bidirectional","dataType":"value","angle":0},{"id":"bottom","label":"bottom","direction":"bidirectional","dataType":"value","angle":90}],"visible":true,"showLabel":false,"data":{"title":"Andrew Wilson, Candace Owens, and the Debate Challenge","durationSeconds":4060,"containerMode":"live-lionel-owned","sequenceController":"media-reaction-thread","navigationMode":"branch-and-return","summary":"Lionel mocks Andrew Wilson’s master-debater persona, examines Candace Owens’s counteroffer and demand for TPUSA ownership, tests Wilson through clips and outside reactions, then closes by arguing that political agreement is increasingly issue-specific.","notes":"Claims remain attributed to Lionel or quoted speakers.","definitionKey":"lionel-episode","_classBinding":{"key":"lionel-episode","sourceRef":"github://mikemartinez1974/public/templates/lionel/v1/classes/nodes/lionel-episode.node-class.node"},"identity":{"graphId":"lionel-v1-example-02-debate-surrogate-collapse"}}},{"id":"issue","type":"issue-scope","label":"Surrogate Credibility","position":{"x":-820,"y":-200},"width":430,"height":300,"ports":[{"id":"root","label":"root","direction":"bidirectional","dataType":"any","angle":210},{"id":"right","label":"right","direction":"bidirectional","dataType":"value","angle":0},{"id":"left","label":"left","direction":"bidirectional","dataType":"value","angle":180}],"visible":true,"showLabel":false,"data":{"title":"Surrogate Credibility","question":"Does Andrew Wilson’s public conduct support or undermine his credibility as a debate surrogate in the Candace Owens / TPUSA dispute?","scope":"Debate challenge, public clips, TPUSA association, and Wilson’s claimed debating authority.","standard":"Separate observable conduct and quoted statements from Lionel’s interpretations of motive and sponsorship.","summary":"The issue is whether the public record strengthens the surrogate role Wilson is being asked to play.","definitionKey":"issue-scope","_classBinding":{"key":"issue-scope","sourceRef":"github://mikemartinez1974/public/templates/lionel/v1/classes/nodes/issue-scope.node-class.node"},"identity":{"graphId":"lionel-v1-example-02-debate-surrogate-collapse"}}},{"id":"thread","type":"topic-thread","label":"Wilson as Debate Surrogate","position":{"x":-300,"y":-200},"width":430,"height":300,"ports":[{"id":"root","label":"root","direction":"bidirectional","dataType":"any","angle":210},{"id":"top","label":"top","direction":"bidirectional","dataType":"value","angle":270},{"id":"bottom","label":"bottom","direction":"bidirectional","dataType":"value","angle":90}],"visible":true,"showLabel":false,"data":{"title":"Wilson as Debate Surrogate","status":"active","branchTrigger":"clips, audience prompts, sponsor reads, linguistic riffs","returnPoint":"thread","summary":"Persistent thread: Wilson claims debate authority; Lionel repeatedly returns to whether his conduct and sponsorship survive scrutiny.","definitionKey":"topic-thread","_classBinding":{"key":"topic-thread","sourceRef":"github://mikemartinez1974/public/templates/lionel/v1/classes/nodes/topic-thread.node-class.node"},"identity":{"graphId":"lionel-v1-example-02-debate-surrogate-collapse"}}},{"id":"op-counteroffer","type":"lionel-operation","label":"Counteroffer as Ownership Test","position":{"x":-820,"y":250},"width":430,"height":300,"ports":[{"id":"root","label":"root","direction":"bidirectional","dataType":"any","angle":210},{"id":"top","label":"top","direction":"bidirectional","dataType":"value","angle":270},{"id":"right","label":"right","direction":"bidirectional","dataType":"value","angle":0}],"visible":true,"showLabel":false,"data":{"title":"Counteroffer as Ownership Test","operationRole":"issue-analysis","startTime":"05:00","endTime":"10:30","target":"Surrogate Credibility","roleDetail":"Plays Candace Owens’s counteroffer and her demand that TPUSA principals publicly claim Wilson as their representative.","certainty":"attributed-analysis","summary":"Turns a debate challenge into institutional accountability.","definitionKey":"lionel-operation","_classBinding":{"key":"lionel-operation","sourceRef":"github://mikemartinez1974/public/templates/lionel/v1/classes/nodes/lionel-operation.node-class.node"},"identity":{"graphId":"lionel-v1-example-02-debate-surrogate-collapse"}}},{"id":"op-character","type":"lionel-operation","label":"Character Through Clips","position":{"x":-300,"y":250},"width":430,"height":300,"ports":[{"id":"root","label":"root","direction":"bidirectional","dataType":"any","angle":210},{"id":"top","label":"top","direction":"bidirectional","dataType":"value","angle":270},{"id":"right","label":"right","direction":"bidirectional","dataType":"value","angle":0}],"visible":true,"showLabel":false,"data":{"title":"Character Through Clips","operationRole":"media-commentary","startTime":"20:00","endTime":"55:30","target":"Surrogate Credibility","roleDetail":"Uses Wilson exchanges, insults, status claims, and defensiveness as evidence against the disciplined-debater persona.","certainty":"attributed-analysis","summary":"Lionel argues that the performance undermines the brand.","definitionKey":"lionel-operation","_classBinding":{"key":"lionel-operation","sourceRef":"github://mikemartinez1974/public/templates/lionel/v1/classes/nodes/lionel-operation.node-class.node"},"identity":{"graphId":"lionel-v1-example-02-debate-surrogate-collapse"}}},{"id":"op-close","type":"lionel-operation","label":"Cross-Check and Widen","position":{"x":220,"y":250},"width":430,"height":300,"ports":[{"id":"root","label":"root","direction":"bidirectional","dataType":"any","angle":210},{"id":"top","label":"top","direction":"bidirectional","dataType":"value","angle":270},{"id":"right","label":"right","direction":"bidirectional","dataType":"value","angle":0}],"visible":true,"showLabel":false,"data":{"title":"Cross-Check and Widen","operationRole":"synthesis","startTime":"56:00","endTime":"66:10","target":"Political identity","roleDetail":"Uses Joe Rogan and a left-wing TPUSA critic as cross-checks, then asks the audience to drop fixed left/right labels.","certainty":"attributed-analysis","summary":"The episode generalizes toward issue-specific political alignment.","definitionKey":"lionel-operation","_classBinding":{"key":"lionel-operation","sourceRef":"github://mikemartinez1974/public/templates/lionel/v1/classes/nodes/lionel-operation.node-class.node"},"identity":{"graphId":"lionel-v1-example-02-debate-surrogate-collapse"}}},{"id":"actors","type":"markdown","label":"Argument Actors","position":{"x":740,"y":-200},"width":520,"height":340,"ports":[{"id":"root","label":"root","direction":"bidirectional","dataType":"any","angle":210},{"id":"left","label":"left","direction":"bidirectional","dataType":"value","angle":180},{"id":"bottom","label":"bottom","direction":"bidirectional","dataType":"value","angle":90}],"visible":true,"showLabel":false,"data":{"identity":{"graphId":"lionel-v1-example-02-debate-surrogate-collapse"},"markdown":"# 👥 Argument Actors\n\n**Andrew Wilson** — focal surrogate whose claimed debate authority is tested.  \n**Candace Owens** — counterparty who reframes the challenge around evidence and institutional ownership.  \n**Turning Point USA** — institution whose relationship to Wilson becomes an accountability question.  \n**Erika Kirk** — central subject of the underlying dispute and Wilson’s defense.  \n**Charlie Kirk** — comparison point for Lionel’s preferred calm debate style.  \n**Joe Rogan / Enemy Charlie / Z Cohen Sanchez** — outside comparisons used to widen the evidentiary and ideological frame.\n\n*Roles describe how each actor functions in this episode’s argument.*","visibilityRole":"browser"}},{"id":"thesis","type":"markdown","label":"Central Thesis","position":{"x":740,"y":260},"width":560,"height":380,"ports":[{"id":"root","label":"root","direction":"bidirectional","dataType":"any","angle":210},{"id":"left","label":"left","direction":"bidirectional","dataType":"value","angle":180},{"id":"top","label":"top","direction":"bidirectional","dataType":"value","angle":270}],"visible":true,"showLabel":false,"data":{"identity":{"graphId":"lionel-v1-example-02-debate-surrogate-collapse"},"markdown":"# 🧠 Central Thesis\n\n**Attributed to Lionel in this episode:** Andrew Wilson’s cultivated identity as a formidable debater is weakened by the clips and public performances used to establish him, while Candace Owens’s demand that Turning Point USA publicly claim him turns a personal debate challenge into a question of institutional ownership and accountability.\n\nNear the close, Lionel widens the lesson: people from different ideological camps can converge on specific judgments, so useful political alignment may increasingly be **issue-by-issue rather than left-versus-right**.\n\n*This summarizes the episode’s argument; it does not independently establish the underlying allegations or political claims.*","visibilityRole":"browser"}}],"edges":[{"id":"home-episode","type":"reference","source":"home","target":"episode","sourcePort":"bottom","targetPort":"top","label":"opens","data":{"semanticRole":"entry"},"style":{"curved":true,"width":1.8}},{"id":"episode-issue","type":"reference","source":"episode","target":"issue","sourcePort":"right","targetPort":"left","label":"asks","data":{"semanticRole":"primary issue"},"style":{"curved":true,"width":1.8}},{"id":"episode-thread","type":"reference","source":"episode","target":"thread","sourcePort":"bottom","targetPort":"top","label":"follows","data":{"semanticRole":"persistent thread"},"style":{"curved":true,"width":1.8}},{"id":"episode-actors","type":"reference","source":"episode","target":"actors","sourcePort":"right","targetPort":"left","label":"maps","data":{"semanticRole":"argument actors"},"style":{"curved":true,"width":1.8}},{"id":"thread-counteroffer","type":"reference","source":"thread","target":"op-counteroffer","sourcePort":"bottom","targetPort":"top","label":"returns through","data":{"semanticRole":"operation"},"style":{"curved":true,"width":1.6}},{"id":"thread-character","type":"reference","source":"thread","target":"op-character","sourcePort":"bottom","targetPort":"top","label":"returns through","data":{"semanticRole":"operation"},"style":{"curved":true,"width":1.6}},{"id":"thread-close","type":"reference","source":"thread","target":"op-close","sourcePort":"bottom","targetPort":"top","label":"returns through","data":{"semanticRole":"operation"},"style":{"curved":true,"width":1.6}},{"id":"issue-thesis","type":"reference","source":"issue","target":"thesis","sourcePort":"right","targetPort":"left","label":"supports","data":{"semanticRole":"thesis"},"style":{"curved":true,"width":2.0}},{"id":"actors-thesis","type":"reference","source":"actors","target":"thesis","sourcePort":"bottom","targetPort":"top","label":"situates","data":{"semanticRole":"actor context"},"style":{"curved":true,"width":1.6}}]}