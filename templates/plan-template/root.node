"id":"root","key":"root","label":"root","direction":"bidirectional","dataType":"any","angle":180,"portId":"root"}],"visible":true,"showLabel":false,"data":{"title":"Constraint","description":"A condition that limits available paths.","status":"draft","notes":"","definitionKey":"plan-constraint","_classBinding":{"key":"plan-constraint","sourceRef":"github://mikemartinez1974/public/templates/plan-template/classes/nodes/plan-constraint.node-class.node"},"_bridge":{"classKey":"plan-constraint","classRef":"github://mikemartinez1974/public/templates/plan-template/classes/nodes/plan-constraint.node-class.node"},"presentation":{"glyph":{"kind":"icon","name":"Fence"}}}},{"id":"plan-template-plan-risk","type":"plan-risk","label":"Risk","root":false,"position":{"x":250,"y":650},"width":380,"height":260,"color":"#e11d48","ports":[{"id":"root","key":"root","label":"root","direction":"bidirectional","dataType":"any","angle":180}],"handles":[{"id":"root","key":"root","label":"root","direction":"bidirectional","dataType":"any","angle":180,"portId":"root"}],"visible":true,"showLabel":false,"data":{"title":"Risk","description":"Something that may derail or degrade the plan.","status":"draft","notes":"","definitionKey":"plan-risk","_classBinding":{"key":"plan-risk","sourceRef":"github://mikemartinez1974/public/templates/plan-template/classes/nodes/plan-risk.node-class.node"},"_bridge":{"classKey":"plan-risk","classRef":"github://mikemartinez1974/public/templates/plan-template/classes/nodes/plan-risk.node-class.node"},"presentation":{"glyph":{"kind":"icon","name":"TriangleAlert"}}}},{"id":"plan-template-plan-contingency","type":"plan-contingency","label":"Contingency","root":false,"position":{"x":250,"y":950},"width":380,"height":260,"color":"#7c3aed","ports":[{"id":"root","key":"root","label":"root","direction":"bidirectional","dataType":"any","angle":180}],"handles":[{"id":"root","key":"root","label":"root","direction":"bidirectional","dataType":"any","angle":180,"portId":"root"}],"visible":true,"showLabel":false,"data":{"title":"Contingency","description":"A prepared response to an adverse condition or outcome.","status":"draft","notes":"","definitionKey":"plan-contingency","_classBinding":{"key":"plan-contingency","sourceRef":"github://mikemartinez1974/public/templates/plan-template/classes/nodes/plan-contingency.node-class.node"},"_bridge":{"classKey":"plan-contingency","classRef":"github://mikemartinez1974/public/templates/plan-template/classes/nodes/plan-contingency.node-class.node"},"presentation":{"glyph":{"kind":"icon","name":"ShieldCheck"}}}},{"id":"plan-template-instructions","type":"markdown","label":"Using This Template","root":false,"position":{"x":-700,"y":1050},"width":760,"height":300,"ports":[{"id":"root","key":"root","label":"root","direction":"bidirectional","dataType":"any","angle":180}],"visible":true,"showLabel":true,"data":{"identity":{"graphId":"plan-template"},"markdown":"## Use the graph as a path\n\nKeep **Plan** and the primary **Goal** as anchors. Duplicate **Phase**, **Action**, **Milestone**, **Decision**, **Constraint**, **Risk**, and **Contingency** as the plan grows.\n\nPlans coordinate work; tasks decompose work. Promote an Action into a dedicated Task graph when execution detail deserves its own artifact.\n\nColor is semantic: blue-family nodes describe the path, green marks outcomes, amber marks forks, rose marks threats, slate marks limits, and violet marks fallback responses.\n\nSee the adjacent `SKILL.md` before deriving a new graph."}}],"edges":[{"id":"plan-edge-achieves","type":"plan.achieves","source":"plan-template-plan","target":"plan-template-plan-goal","sourcePort":"root","targetPort":"root","label":"achieves","style":{"stroke":"#059669","strokeWidth":3},"data":{"semanticRole":"plan.achieves"}},{"id":"plan-edge-contains-phase","type":"plan.contains","source":"plan-template-plan","target":"plan-template-plan-phase","sourcePort":"root","targetPort":"root","label":"contains","style":{"stroke":"#4f46e5","strokeWidth":2},"data":{"semanticRole":"plan.contains"}},{"id":"plan-edge-phase-action","type":"plan.contains","source":"plan-template-plan-phase","target":"plan-template-plan-action","sourcePort":"root","targetPort":"root","label":"contains","style":{"stroke":"#2563eb","strokeWidth":2},"data":{"semanticRole":"plan.contains"}},{"id":"plan-edge-action-milestone","type":"plan.produces","source":"plan-template-plan-action","target":"plan-template-plan-milestone","sourcePort":"root","targetPort":"root","label":"produces","style":{"stroke":"#16a34a","strokeWidth":3},"data":{"semanticRole":"plan.produces"}},{"id":"plan-edge-milestone-decision","type":"plan.gates","source":"plan-template-plan-milestone","target":"plan-template-plan-decision","sourcePort":"root","targetPort":"root","label":"gates","style":{"stroke":"#d97706","strokeWidth":3},"data":{"semanticRole":"plan.gates"}},{"id":"plan-edge-action-constraint","type":"plan.constrained-by","source":"plan-template-plan-action","target":"plan-template-plan-constraint","sourcePort":"root","targetPort":"root","label":"constrained by","style":{"stroke":"#64748b","strokeWidth":2,"dash":[8,6]},"data":{"semanticRole":"plan.constrained-by"}},{"id":"plan-edge-action-risk","type":"plan.threatened-by","source":"plan-template-plan-action","target":"plan-template-plan-risk","sourcePort":"root","targetPort":"root","label":"threatened by","style":{"stroke":"#e11d48","strokeWidth":2,"dash":[8,6]},"data":{"semanticRole":"plan.threatened-by"}},{"id":"plan-edge-risk-contingency","type":"plan.mitigated-by","source":"plan-template-plan-risk","target":"plan-template-plan-contingency","sourcePort":"root","targetPort":"root","label":"mitigated by","style":{"stroke":"#7c3aed","strokeWidth":3},"data":{"semanticRole":"plan.mitigated-by"}},{"id":"plan-edge-decision-contingency","type":"plan.branches-to","source":"plan-template-plan-decision","target":"plan-template-plan-contingency","sourcePort":"root","targetPort":"root","label":"branches to","style":{"stroke":"#d97706","strokeWidth":2,"dash":[5,5]},"data":{"semanticRole":"plan.branches-to"}}]}