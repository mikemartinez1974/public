    {
      "id": "node-template-landing-content",
      "type": "content",
      "label": "Landing Content",
      "root": false,
      "position": {
        "x": 662.9976978236416,
        "y": -620
      },
      "width": 420,
      "height": 260,
      "visible": true,
      "showLabel": true,
      "data": {
        "identity": {
          "graphId": "node-template",
          "nodeId": "node-template-landing-content"
        },
        "content": {
          "kind": "html",
          "value": "<div style='container-type:inline-size;box-sizing:border-box;width:100%;height:100%;padding:clamp(18px,6.67cqw,41px);background:#ffffff;font-family:system-ui;color:#0f172a'><h1 style='margin:0 0 12px;font-weight:800;font-size:clamp(17px,6.19cqw,38px);line-height:1.2;font-family:system-ui'>Landing Content</h1><p style='margin:0 0 12px;max-width:60ch;font-weight:400;font-size:clamp(10px,3.81cqw,23px);line-height:1.6;font-family:system-ui;color:#334155'>Content nodes hold the interesting material. This one is the Declaration's own landing surface -- the graph's default content, reached directly, before any particular View is chosen.</p><p style='margin:0;max-width:60ch;font-weight:400;font-size:clamp(10px,3.81cqw,23px);line-height:1.6;font-family:system-ui;color:#334155'>It's deliberately a separate node from the Detail view's own foreground content below -- landing content and a View's delegated content answer different questions (what does this graph show by default, versus what does this particular View show), so they're free to hold different answers.</p></div>"
        },
        "_placement": {
          "version": 1,
          "state": "manually-shaped",
          "source": "manual",
          "updatedAt": 1791241099512,
          "reason": "node-drag"
        }
      }
