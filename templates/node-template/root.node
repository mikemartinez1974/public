          "nodeId": "node-template-detail"
        },
        "content": {
          "kind": "html",
          "value": "<div style='box-sizing:border-box;width:100%;height:100%;padding:28px;background:#ffffff;font-family:system-ui;color:#0f172a'><h1 style='margin:0 0 12px;font:800 26px/1.2 system-ui'>Node Template</h1><p style='margin:0 0 12px;max-width:60ch;font:400 16px/1.6 system-ui;color:#334155'>This is the background: the surface this node presents when it is seen from outside itself -- referenced in a workspace, shown collapsed, browsed past.</p><p style='margin:0;max-width:60ch;font:400 16px/1.6 system-ui;color:#334155'>Its role is the minimal reference for how any node wires its own presentation: one Surface off the Declaration, leading detail, then summary, then icon, ending in a Glyph.</p></div>"
        },
        "_placement": {
          "version": 1,
          "state": "manually-shaped",
          "source": "manual",
          "updatedAt": 1790696162208,
          "reason": "node-drag"
        }
      }
