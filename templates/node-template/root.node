        "content": {
          "kind": "html",
          "value": "<div style='box-sizing:border-box;width:100%;height:100%;padding:28px;background:#ffffff;font-family:system-ui;color:#0f172a'><h1 style='margin:0 0 12px;font:800 26px/1.2 system-ui'>Foreground Content</h1><p style='margin:0 0 12px;max-width:60ch;font:400 16px/1.6 system-ui;color:#334155'>This node holds the actual material -- the thing worth reading or editing. The Detail view is the background: the passive surface this node shows when seen from the outside, and it renders this node rather than holding its own content.</p><p style='margin:0;max-width:60ch;font:400 16px/1.6 system-ui;color:#334155'>The split matters because the two change for different reasons. This content changes when what the node has to say changes. The view changes when how it should be framed changes -- neither edit should require the other.</p></div>"
        },
        "_placement": {
          "version": 1,
          "state": "manually-shaped",
          "source": "manual",
          "updatedAt": 1790696198619,
