      "data": {
        "view": {
          "intent": "node",
          "payload": "node.web.detail"
        },
        "interfaceContract": {
          "version": 1,
          "surfaceDelegation": false
        },
        "identity": {
          "graphId": "node-template",
          "nodeId": "node-template-detail"
        },
        "content": {
          "kind": "html",
          "value": "<div style='container-type:inline-size;box-sizing:border-box;width:100%;height:100%;padding:clamp(18px,5.83cqw,41px);background:#ffffff;font-family:system-ui;color:#0f172a'><h1 style='margin:0 0 12px;font-weight:800;font-size:clamp(17px,5.42cqw,38px);line-height:1.2;font-family:system-ui'>Detail</h1><p style='margin:0 0 12px;max-width:60ch;font-weight:400;font-size:clamp(10px,3.33cqw,23px);line-height:1.6;font-family:system-ui;color:#334155'>This is where the graph background goes -- the passive surface this node presents when it's seen from outside itself: referenced in a workspace, shown collapsed, browsed past rather than opened.</p><p style='margin:0;max-width:60ch;font-weight:400;font-size:clamp(10px,3.33cqw,23px);line-height:1.6;font-family:system-ui;color:#334155'>It owns this content directly now, rather than delegating it to a separate Content node -- one Surface off the Declaration, leading detail, then icon, ending in a Glyph.</p></div>"
        },
        "_placement": {
          "version": 1,
          "state": "manually-shaped",
          "source": "manual",
          "updatedAt": 1790696162208,
          "reason": "node-drag"
        }
      }
