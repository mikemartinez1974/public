        "identity": {
          "graphId": "node-template",
          "nodeId": "node-template",
          "name": "Node Template",
          "version": "0.1.0",
          "description": "The minimal reference for how any node wires its own presentation: one Surface, leading detail -> summary -> icon -> glyph, and a Content node the detail View delegates to rather than owning its content directly."
        },
        "intent": {
          "kind": "primitive",
          "scope": "graph-language"
        },
        "declaration": {
          "kind": "graph",
          "interfaceContract": {
            "version": 1,
            "implicitRootPort": false
          },
          "defaultSurfaceId": "web"
        },
        "document": {
