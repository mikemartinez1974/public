        "svg": "<svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 640 420\" width=\"100%\" height=\"100%\" preserveAspectRatio=\"xMidYMid meet\" role=\"img\" aria-label=\"Workboard Template graphic\">\n  <defs>\n    <linearGradient id=\"wb-bg\" x1=\"0\" y1=\"0\" x2=\"1\" y2=\"1\">\n      <stop offset=\"0%\" stop-color=\"#07111f\"/>\n      <stop offset=\"55%\" stop-color=\"#111827\"/>\n      <stop offset=\"100%\" stop-color=\"#172554\"/>\n    </linearGradient>\n    <linearGradient id=\"wb-glow\" x1=\"0\" y1=\"0\" x2=\"1\" y2=\"0\">\n      <stop offset=\"0%\" stop-color=\"#8b5cf6\"/>\n      <stop offset=\"25%\" stop-color=\"#ef4444\"/>\n      <stop offset=\"50%\" stop-color=\"#f59e0b\"/>\n      <stop offset=\"75%\" stop-color=\"#3b82f6\"/>\n      <stop offset=\"100%\" stop-color=\"#10b981\"/>\n    </linearGradient>\n    <filter id=\"wb-shadow\" x=\"-30%\" y=\"-30%\" width=\"160%\" height=\"180%\">\n      <feDropShadow dx=\"0\" dy=\"10\" stdDeviation=\"12\" flood-color=\"#020617\" flood-opacity=\"0.55\"/>\n    </filter>\n    <filter id=\"wb-soft\" x=\"-30%\" y=\"-30%\" width=\"160%\" height=\"160%\">\n      <feGaussianBlur stdDeviation=\"18\"/>\n    </filter>\n  </defs>\n  <rect x=\"5\" y=\"5\" width=\"630\" height=\"410\" rx=\"34\" fill=\"url(#wb-bg)\" stroke=\"#334155\" stroke-width=\"2\"/>\n  <circle cx=\"540\" cy=\"72\" r=\"116\" fill=\"#2563eb\" opacity=\"0.11\" filter=\"url(#wb-soft)\"/>\n  <circle cx=\"96\" cy=\"352\" r=\"96\" fill=\"#8b5cf6\" opacity=\"0.1\" filter=\"url(#wb-soft)\"/>\n  <rect x=\"54\" y=\"42\" width=\"532\" height=\"5\" rx=\"2.5\" fill=\"url(#wb-glow)\"/>\n  <text x=\"54\" y=\"86\" fill=\"#94a3b8\" font-family=\"ui-sans-serif,system-ui,sans-serif\" font-size=\"13\" font-weight=\"800\" letter-spacing=\"0.22em\">OPERATIONAL FOCUS</text>\n  <text x=\"54\" y=\"125\" fill=\"#f8fafc\" font-family=\"ui-sans-serif,system-ui,sans-serif\" font-size=\"34\" font-weight=\"850\">Workboard Template</text>\n  <text x=\"54\" y=\"150\" fill=\"#cbd5e1\" font-family=\"ui-sans-serif,system-ui,sans-serif\" font-size=\"14\" font-weight=\"550\">A focused queue backed by real task graphs</text>\n  <g transform=\"translate(54 186)\" filter=\"url(#wb-shadow)\">\n    <g>\n      <rect width=\"92\" height=\"132\" rx=\"16\" fill=\"#24133f\" stroke=\"#8b5cf6\" stroke-width=\"2\"/>\n      <rect x=\"12\" y=\"14\" width=\"68\" height=\"8\" rx=\"4\" fill=\"#a78bfa\"/>\n      <rect x=\"12\" y=\"38\" width=\"68\" height=\"30\" rx=\"9\" fill=\"#8b5cf6\" opacity=\"0.35\"/>\n      <rect x=\"12\" y=\"78\" width=\"52\" height=\"8\" rx=\"4\" fill=\"#c4b5fd\" opacity=\"0.7\"/>\n      <rect x=\"12\" y=\"94\" width=\"61\" height=\"8\" rx=\"4\" fill=\"#c4b5fd\" opacity=\"0.42\"/>\n    </g>\n    <g transform=\"translate(108 0)\">\n      <rect width=\"92\" height=\"132\" rx=\"16\" fill=\"#3b1118\" stroke=\"#ef4444\" stroke-width=\"2\"/>\n      <rect x=\"12\" y=\"14\" width=\"68\" height=\"8\" rx=\"4\" fill=\"#f87171\"/>\n      <rect x=\"12\" y=\"38\" width=\"68\" height=\"30\" rx=\"9\" fill=\"#ef4444\" opacity=\"0.35\"/>\n      <circle cx=\"22\" cy=\"92\" r=\"7\" fill=\"none\" stroke=\"#fecaca\" stroke-width=\"2\"/>\n      <rect x=\"35\" y=\"88\" width=\"45\" height=\"8\" rx=\"4\" fill=\"#fecaca\" opacity=\"0.7\"/>\n    </g>\n    <g transform=\"translate(216 0)\">\n      <rect width=\"92\" height=\"132\" rx=\"16\" fill=\"#3a2507\" stroke=\"#f59e0b\" stroke-width=\"2\"/>\n      <rect x=\"12\" y=\"14\" width=\"68\" height=\"8\" rx=\"4\" fill=\"#fbbf24\"/>\n      <rect x=\"12\" y=\"38\" width=\"68\" height=\"30\" rx=\"9\" fill=\"#f59e0b\" opacity=\"0.32\"/>\n      <rect x=\"12\" y=\"84\" width=\"68\" height=\"8\" rx=\"4\" fill=\"#fde68a\" opacity=\"0.7\"/>\n      <rect x=\"12\" y=\"100\" width=\"45\" height=\"8\" rx=\"4\" fill=\"#fde68a\" opacity=\"0.42\"/>\n    </g>\n    <g transform=\"translate(324 0)\">\n      <rect width=\"92\" height=\"132\" rx=\"16\" fill=\"#102449\" stroke=\"#3b82f6\" stroke-width=\"2\"/>\n      <rect x=\"12\" y=\"14\" width=\"68\" height=\"8\" rx=\"4\" fill=\"#60a5fa\"/>\n      <path d=\"M18 54 H74\" stroke=\"#93c5fd\" stroke-width=\"4\" stroke-linecap=\"round\" stroke-dasharray=\"7 7\" opacity=\"0.72\"/>\n      <circle cx=\"46\" cy=\"91\" r=\"14\" fill=\"none\" stroke=\"#93c5fd\" stroke-width=\"3\" opacity=\"0.65\"/>\n    </g>\n    <g transform=\"translate(432 0)\">\n      <rect width=\"92\" height=\"132\" rx=\"16\" fill=\"#092f28\" stroke=\"#10b981\" stroke-width=\"2\"/>\n      <rect x=\"12\" y=\"14\" width=\"68\" height=\"8\" rx=\"4\" fill=\"#34d399\"/>\n      <circle cx=\"46\" cy=\"64\" r=\"20\" fill=\"#10b981\" opacity=\"0.3\"/>\n      <path d=\"M36 64 L43 71 L57 54\" fill=\"none\" stroke=\"#a7f3d0\" stroke-width=\"5\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/>\n      <rect x=\"20\" y=\"100\" width=\"52\" height=\"8\" rx=\"4\" fill=\"#a7f3d0\" opacity=\"0.5\"/>\n    </g>\n  </g>\n  <g fill=\"#94a3b8\" font-family=\"ui-sans-serif,system-ui,sans-serif\" font-size=\"10\" font-weight=\"800\" letter-spacing=\"0.12em\" text-anchor=\"middle\">\n    <text x=\"100\" y=\"340\">INBOX</text>\n    <text x=\"208\" y=\"340\">NOW</text>\n    <text x=\"316\" y=\"340\">NEXT</text>\n    <text x=\"424\" y=\"340\">WAITING</text>\n    <text x=\"532\" y=\"340\">DONE</text>\n  </g>\n  <rect x=\"205\" y=\"366\" width=\"230\" height=\"34\" rx=\"17\" fill=\"#ffffff\" opacity=\"0.08\" stroke=\"#ffffff\" stroke-opacity=\"0.18\"/>\n  <text x=\"320\" y=\"388\" text-anchor=\"middle\" fill=\"#f8fafc\" font-family=\"ui-sans-serif,system-ui,sans-serif\" font-size=\"12\" font-weight=\"800\" letter-spacing=\"0.12em\">OPEN WORKBOARD</text>\n</svg>",
