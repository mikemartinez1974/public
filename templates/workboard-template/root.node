    {
      "id": "workboard-overview",
      "type": "workboard",
      "label": "Workboard Template",
      "root": true,
      "position": {
        "x": -400,
        "y": -720
      },
      "width": 1040,
      "height": 260,
      "color": "linear-gradient(135deg, #0f172a, #334155)",
      "ports": [
        {
          "id": "root",
          "label": "root",
          "direction": "bidirectional",
          "dataType": "any",
          "angle": 210
        },
        {
          "id": "top",
          "label": "top",
          "direction": "bidirectional",
          "dataType": "value",
          "angle": 270
        },
        {
          "id": "left",
          "label": "left",
          "direction": "bidirectional",
          "dataType": "value",
          "angle": 180
        },
        {
          "id": "bottom",
          "label": "bottom",
          "direction": "bidirectional",
          "dataType": "value",
          "angle": 90
        },
        {
          "id": "right",
          "label": "right",
          "direction": "bidirectional",
          "dataType": "value",
          "angle": 360
        }
      ],
      "visible": true,
      "showLabel": true,
      "data": {
        "name": "Workboard Template",
        "description": "A reusable operational projection. Source task graphs own project truth; this board owns lane placement, ordering, pinning, review policy, and refresh health.",
        "editorContributions": [
          {
            "id": "workboard-task-placement",
            "match": {
              "nodeType": "portal",
              "pathExists": "data.board"
            },
            "section": {
              "key": "placement",
              "title": "Placement",
              "summary": "Local workboard lane, ordering, and review state."
            },
            "fields": [
              {
                "key": "boardLaneMode",
                "label": "Placement",
                "type": "select",
                "path": "data.board.laneMode",
                "options": [
                  {
                    "label": "Automatic from task status",
                    "value": "auto"
                  },
                  {
                    "label": "Manual lane",
                    "value": "manual"
                  }
                ],
                "helperText": "Manual placement and pinning are synchronized for now. A pinned task keeps its selected lane; an unpinned task follows workboard policy."
              },
              {
                "key": "boardLane",
                "label": "Lane",
                "type": "select",
                "path": "data.board.lane",
                "options": [
                  {
                    "label": "Inbox",
                    "value": "inbox"
                  },
                  {
                    "label": "Now",
                    "value": "now"
                  },
                  {
                    "label": "Next",
                    "value": "next"
                  },
                  {
                    "label": "Waiting",
                    "value": "waiting"
                  },
                  {
                    "label": "Recently Completed",
                    "value": "recently-completed"
                  }
                ],
                "visibleWhen": {
                  "path": "data.board.laneMode",
                  "equals": "manual"
                }
              },
              {
                "key": "boardPinned",
                "label": "Pinned",
                "type": "boolean",
                "path": "data.board.pinned",
                "helperText": "Pinned currently means manually placed: the task keeps its selected lane and is excluded from automatic placement."
              },
              {
                "key": "boardRank",
                "label": "Rank",
                "type": "number",
                "path": "data.board.rank",
                "helperText": "Lower ranks appear first after pinning and priority rules."
              },
              {
                "key": "boardReviewedAt",
                "label": "Reviewed At",
                "type": "text",
                "path": "data.board.reviewedAt",
                "placeholder": "YYYY-MM-DDTHH:mm:ss.sssZ"
              }
            ]
          }
        ],
        "policy": {
          "defaultLaneMode": "auto",
          "unknownLane": "inbox",
          "statusLanes": {
            "todo": "next",
            "in-progress": "now",
            "blocked": "waiting",
            "waiting": "waiting",
            "done": "recently-completed",
            "cancelled": "recently-completed"
          },
          "ordering": {
            "pinnedFirst": true,
            "priorityOrder": [
              "critical",
              "high",
              "medium",
              "low"
            ],
            "tieBreaker": "rank"
          },
          "automation": {
            "freshReads": true,
            "retainFailures": true
          }
        },
        "_classBinding": {
          "key": "workboard",
          "sourceRef": "github://twilite-zone/public/library/classes/nodes/task-planning/workboard.node-class.node"
        },
        "_bridge": {
          "classKey": "workboard",
          "classRef": "github://twilite-zone/public/library/classes/nodes/task-planning/workboard.node-class.node",
          "entryPort": "root",
          "kind": "node-class",
          "sourceRef": "github://twilite-zone/public/library/classes/nodes/task-planning/workboard.node-class.node",
          "targetKind": "node-class"
        },
        "definitionKey": "workboard",
        "identity": {
          "graphId": "workboard-template"
        }
      }
    },
