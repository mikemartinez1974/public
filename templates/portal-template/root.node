        "content": {
          "kind": "html",
          "value": "<div style='box-sizing:border-box;width:100%;height:100%;padding:28px;background:#ffffff;font-family:system-ui;color:#0f172a;overflow:auto'><h1 style='margin:0 0 12px;font:800 24px/1.2 system-ui'>Portal</h1><p style='margin:0 0 12px;max-width:62ch;font:400 15px/1.6 system-ui;color:#334155'>A Portal is a real, resolvable pointer to a specific node and port in another graph -- not a placeholder link, but a live jump. This template's own Portal targets templates/port-template/root.node's Port node directly: open this graph and follow the Portal, and you land somewhere real.</p><p style='margin:0;max-width:62ch;font:400 15px/1.6 system-ui;color:#334155'>A Portal holds no content of its own to show. What you see when you follow it belongs entirely to the graph on the other end -- the Portal is just the address.</p></div>"
        },
        "_placement": {
          "version": 1,
          "state": "manually-shaped",
          "source": "manual",
          "updatedAt": 1791306057416,
          "reason": "node-drag"
