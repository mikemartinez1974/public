      "data": {
        "identity": {
          "graphId": "content-template",
          "nodeId": "content-template-content"
        },
        "content": {
          "kind": "html",
          "value": "<div style='box-sizing:border-box;width:100%;height:100%;padding:28px;background:#ffffff;font-family:system-ui;color:#0f172a'><h1 style='margin:0 0 12px;font:800 26px/1.2 system-ui'>Content</h1><p style='margin:0 0 12px;max-width:60ch;font:400 16px/1.6 system-ui;color:#334155'>This node holds the actual material. root (top) is the structural connection -- where a View's surface-delegate or a Declaration's landing-surface edge lands, often both at once.</p><p style='margin:0;max-width:60ch;font:400 16px/1.6 system-ui;color:#334155'>input/prev/out-right/next/out-bottom are courtesy ports -- offered for flexibility, not wired to anything specific here.</p></div>"
        }
      }
    },
