        "editor": {
          "web": {
            "fields": [
              {
                "key": "title",
                "label": "Title",
                "type": "text",
                "path": "data.title",
                "placeholder": "Action name"
              },
              {
                "key": "action",
                "label": "Action",
                "type": "markdown",
                "path": "data.action",
                "placeholder": "What will be done next?",
                "multiline": true,
                "rows": 5
              },
              {
                "key": "expectedEvidence",
                "label": "Expected Evidence",
                "type": "markdown",
                "path": "data.expectedEvidence",
                "placeholder": "What observation or result should this action produce?",
                "multiline": true,
                "rows": 5
              },
              {
                "key": "status",
                "label": "Status",
                "type": "select",
                "path": "data.status",
                "options": [
                  {
                    "label": "Todo",
                    "value": "todo"
                  },
                  {
                    "label": "In Progress",
                    "value": "in-progress"
                  },
                  {
                    "label": "Blocked",
                    "value": "blocked"
                  },
                  {
                    "label": "Done",
                    "value": "done"
                  },
                  {
