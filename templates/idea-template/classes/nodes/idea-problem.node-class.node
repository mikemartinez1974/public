        "view": {
          "intent": "editor",
          "payload": "editor.web"
        },
        "editor": {
          "web": {
            "fields": [
              {
                "key": "title",
                "label": "Title",
                "type": "text",
                "path": "data.title",
                "placeholder": "Short problem name"
              },
              {
                "key": "statement",
                "label": "Problem Statement",
                "type": "markdown",
                "path": "data.statement",
                "placeholder": "State the problem without prescribing a solution.",
                "multiline": true,
                "rows": 5
              },
              {
                "key": "impact",
                "label": "Impact",
                "type": "markdown",
                "path": "data.impact",
                "placeholder": "Who or what is affected, and how?",
                "multiline": true,
                "rows": 5
              },
              {
                "key": "urgency",
                "label": "Urgency",
                "type": "select",
                "path": "data.urgency",
                "options": [
                  {
                    "label": "Unknown",
                    "value": "unknown"
                  },
                  {
                    "label": "Low",
                    "value": "low"
                  },
                  {
                    "label": "Medium",
                    "value": "medium"
                  },
                  {
                    "label": "High",
                    "value": "high"
                  }
                ]
              }
            ]
          }
        }
