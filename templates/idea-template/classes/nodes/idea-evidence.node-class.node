{
  "fileVersion": "1.0",
  "metadata": {
    "title": "Evidence Node Class",
    "description": "A direct observation, measurement, experiment, or demonstrated outcome.",
    "created": "2026-08-01T00:00:00.000Z",
    "modified": "2026-08-01T00:00:00.000Z",
    "author": "",
    "tags": [
      "node-class",
      "idea-template"
    ],
    "preferredViewer": "https://twilite.zone"
  },
  "nodes": [
    {
      "id": "idea-evidence-class-manifest",
      "type": "manifest",
      "label": "Manifest",
      "position": {
        "x": -640,
        "y": -220
      },
      "width": 360,
      "height": 260,
      "ports": [
        {
          "id": "root",
          "label": "root",
          "direction": "bidirectional",
          "dataType": "any",
          "angle": 210
        }
      ],
      "visible": true,
      "showLabel": true,
      "data": {
        "identity": {
          "graphId": "idea-evidence-class",
          "name": "Evidence Node Class",
          "version": "0.1.0",
          "description": "A direct observation, measurement, experiment, or demonstrated outcome.",
          "createdAt": "2026-08-01T00:00:00.000Z",
          "updatedAt": "2026-08-01T00:00:00.000Z"
        },
        "intent": {
          "kind": "node-class",
          "scope": "local"
        },
        "dependencies": {
          "nodeTypes": [
            "manifest",
            "view"
          ],
          "portContracts": [
            "core"
          ],
          "skills": [
            "idea-template"
          ],
          "schemaVersions": {
            "nodes": ">=1.0.0",
            "ports": ">=1.0.0"
          },
          "optional": []
        },
        "authority": {
          "mutation": {
            "allowCreate": true,
            "allowUpdate": true,
            "allowDelete": true,
            "appendOnly": false
          },
          "actors": {
            "humans": true,
            "agents": true,
            "tools": true
          },
          "styleAuthority": "descriptive",
          "history": {
            "rewriteAllowed": false,
            "squashAllowed": false
          }
        },
        "nodeClass": {
          "contractVersion": "1.0.0",
          "key": "idea-evidence",
          "nodeDef": {
            "key": "idea-evidence",
            "ref": "github://mikemartinez1974/public/templates/idea-template/classes/nodes/idea-evidence.node-class.node",
            "source": "local",
            "version": ">=0.1.0",
            "defaults": {
              "label": "Evidence",
              "size": {
                "width": 400,
                "height": 300
              },
              "color": "#059669",
              "showLabel": false,
              "data": {
                "title": "",
                "observation": "",
                "kind": "observation",
                "strength": "weak",
                "sourceRef": ""
              }
            }
          }
        }
      }
    },
    {
      "id": "idea-evidence-editor-view",
      "type": "view",
      "label": "Evidence Editor",
      "position": {
        "x": -180,
        "y": -220
      },
      "width": 420,
      "height": 320,
      "ports": [
        {
          "id": "root",
          "label": "root",
          "direction": "bidirectional",
          "dataType": "any",
          "angle": 210
        }
      ],
      "visible": true,
      "showLabel": true,
      "data": {
        "view": {
          "intent": "editor",
          "payload": "editor.web"
        },
        "editor": {
          "web": {
            "fields": [
              {
                "key": "title",
                "label": "Title",
                "type": "text",
                "path": "data.title",
                "placeholder": "Short evidence title"
              },
              {
                "key": "observation",
                "label": "Observation",
                "type": "markdown",
                "path": "data.observation",
                "placeholder": "What observable thing happened?",
                "multiline": true,
                "rows": 5
              },
              {
                "key": "kind",
                "label": "Kind",
                "type": "select",
                "path": "data.kind",
                "options": [
                  {
                    "label": "Observation",
                    "value": "observation"
                  },
                  {
                    "label": "Measurement",
                    "value": "measurement"
                  },
                  {
                    "label": "Experiment",
                    "value": "experiment"
                  },
                  {
                    "label": "Behavior",
                    "value": "behavior"
                  },
                  {
                    "label": "Prototype",
                    "value": "prototype"
                  }
                ]
              },
              {
                "key": "strength",
                "label": "Strength",
                "type": "select",
                "path": "data.strength",
                "options": [
                  {
                    "label": "Weak",
                    "value": "weak"
                  },
                  {
                    "label": "Moderate",
                    "value": "moderate"
                  },
                  {
                    "label": "Strong",
                    "value": "strong"
                  }
                ]
              },
              {
                "key": "sourceRef",
                "label": "Source Reference",
                "type": "text",
                "path": "data.sourceRef",
                "placeholder": "Link, graph ref, experiment, or locator"
              }
            ]
          }
        }
      }
    },
    {
      "id": "idea-evidence-detail-view",
      "type": "view",
      "label": "Evidence Detail",
      "position": {
        "x": 320,
        "y": -220
      },
      "width": 440,
      "height": 320,
      "ports": [
        {
          "id": "root",
          "label": "root",
          "direction": "bidirectional",
          "dataType": "any",
          "angle": 210
        }
      ],
      "visible": true,
      "showLabel": true,
      "data": {
        "view": {
          "intent": "node",
          "payload": "node.web.detail",
          "html": {
            "chrome": true
          }
        },
        "node": {
          "web": {
            "detail": {
              "html": "<div style='width:100%;height:100%;display:flex;flex-direction:column;border-radius:18px;overflow:hidden;background:#ffffff;color:#0f172a;border:1px solid rgba(15,23,42,.14);'><div style='padding:12px 16px;background:#059669;color:white;'><div style='display:flex;justify-content:space-between;gap:8px;font:800 10px system-ui,sans-serif;letter-spacing:.12em;text-transform:uppercase;'><span>Evidence</span><span>{{data.kind}} · {{data.strength}}</span></div><div style='font:800 20px/1.2 system-ui,sans-serif;'>{{data.title}}</div></div><div style='padding:16px;overflow:auto;font:500 14px/1.5 system-ui,sans-serif;'><div style='white-space:pre-wrap;'>{{data.observation}}</div><div style='margin-top:14px;padding-top:12px;border-top:1px solid #e2e8f0;'><div style='font:800 10px system-ui,sans-serif;letter-spacing:.12em;text-transform:uppercase;color:#047857;'>Source Reference</div><div style='margin-top:5px;overflow-wrap:anywhere;'>{{data.sourceRef}}</div></div></div></div>"
            }
          }
        }
      }
    },
    {
      "id": "idea-evidence-summary-view",
      "type": "view",
      "label": "Evidence Summary",
      "position": {
        "x": 840,
        "y": -220
      },
      "width": 380,
      "height": 240,
      "ports": [
        {
          "id": "root",
          "label": "root",
          "direction": "bidirectional",
          "dataType": "any",
          "angle": 210
        }
      ],
      "visible": true,
      "showLabel": true,
      "data": {
        "view": {
          "intent": "node",
          "payload": "node.web.summary",
          "html": {
            "chrome": true
          }
        },
        "node": {
          "web": {
            "summary": {
              "html": "<div style='width:100%;height:100%;padding:14px;box-sizing:border-box;border-radius:16px;background:white;border:2px solid #059669;color:#0f172a;overflow:hidden;'><div style='display:flex;justify-content:space-between;gap:8px;font:800 10px system-ui,sans-serif;letter-spacing:.12em;text-transform:uppercase;color:#059669;'><span>Evidence</span><span>{{data.kind}} · {{data.strength}}</span></div><div style='margin-top:6px;font:800 17px/1.25 system-ui,sans-serif;'>{{data.title}}</div><div style='margin-top:8px;font:500 12px/1.4 system-ui,sans-serif;white-space:pre-wrap;'>{{data.observation}}</div></div>"
            }
          }
        }
      }
    }
  ],
  "edges": [
    {
      "id": "idea-evidence-class-editor-detail",
      "type": "reference",
      "source": "idea-evidence-editor-view",
      "target": "idea-evidence-detail-view",
      "sourcePort": "root",
      "targetPort": "root",
      "label": "view",
      "style": {},
      "data": {}
    },
    {
      "id": "idea-evidence-class-detail-summary",
      "type": "reference",
      "source": "idea-evidence-detail-view",
      "target": "idea-evidence-summary-view",
      "sourcePort": "root",
      "targetPort": "root",
      "label": "summary",
      "style": {},
      "data": {}
    }
  ],
  "clusters": [],
  "settings": {
    "theme": null,
    "backgroundImage": null,
    "defaultNodeColor": "#1976d2",
    "defaultEdgeColor": "#666666",
    "snapToGrid": false,
    "gridSize": 20,
