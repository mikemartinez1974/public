        "editor": {
          "web": {
            "fields": [
              {
                "key": "title",
                "label": "Title",
                "type": "text",
                "path": "data.title",
                "placeholder": "Short evidence title"
              },
              {
                "key": "observation",
                "label": "Observation",
                "type": "markdown",
                "path": "data.observation",
                "placeholder": "What observable thing happened?",
                "multiline": true,
                "rows": 5
              },
              {
                "key": "kind",
                "label": "Kind",
                "type": "select",
                "path": "data.kind",
                "options": [
                  {
                    "label": "Observation",
                    "value": "observation"
                  },
                  {
                    "label": "Measurement",
                    "value": "measurement"
                  },
                  {
                    "label": "Experiment",
                    "value": "experiment"
                  },
                  {
                    "label": "Behavior",
                    "value": "behavior"
                  },
                  {
                    "label": "Prototype",
                    "value": "prototype"
                  }
                ]
              },
              {
                "key": "strength",
                "label": "Strength",
                "type": "select",
                "path": "data.strength",
                "options": [
                  {
                    "label": "Weak",
                    "value": "weak"
                  },
                  {
                    "label": "Moderate",
                    "value": "moderate"
                  },
                  {
                    "label": "Strong",
                    "value": "strong"
                  }
                ]
              },
              {
                "key": "sourceRef",
                "label": "Source Reference",
                "type": "text",
                "path": "data.sourceRef",
                "placeholder": "Link, graph ref, experiment, or locator"
              }
            ]
          }
        }
      }
