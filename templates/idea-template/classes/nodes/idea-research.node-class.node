      ],
      "visible": true,
      "showLabel": true,
      "data": {
        "identity": {
          "graphId": "idea-research-class",
          "name": "Research Node Class",
          "version": "0.1.0",
          "description": "Prior art, sources, findings, and context relevant to an idea.",
          "createdAt": "2026-08-01T00:00:00.000Z",
          "updatedAt": "2026-08-01T00:00:00.000Z"
        },
        "intent": {
          "kind": "node-class",
          "scope": "local"
        },
        "dependencies": {
          "nodeTypes": [
            "manifest",
            "view"
          ],
          "portContracts": [
            "core"
          ],
          "skills": [
            "idea-template"
          ],
          "schemaVersions": {
            "nodes": ">=1.0.0",
            "ports": ">=1.0.0"
          },
          "optional": []
        },
        "authority": {
          "mutation": {
            "allowCreate": true,
            "allowUpdate": true,
            "allowDelete": true,
            "appendOnly": false
          },
          "actors": {
            "humans": true,
            "agents": true,
            "tools": true
          },
          "styleAuthority": "descriptive",
          "history": {
            "rewriteAllowed": false,
            "squashAllowed": false
          }
        },
        "nodeClass": {
          "contractVersion": "1.0.0",
          "key": "idea-research",
          "nodeDef": {
            "key": "idea-research",
            "ref": "github://mikemartinez1974/public/templates/idea-template/classes/nodes/idea-research.node-class.node",
            "source": "local",
            "version": ">=0.1.0",
            "defaults": {
              "label": "Research",
              "size": {
                "width": 400,
                "height": 300
              },
              "color": "#4f46e5",
              "showLabel": false,
              "data": {
                "title": "",
                "findings": "",
                "sourceUrl": "",
                "sourceType": "article"
              }
            }
          }
        }
      }
    },
    {
      "id": "idea-research-editor-view",
      "type": "view",
      "label": "Research Editor",
      "position": {
        "x": -180,
        "y": -220
      },
      "width": 420,
      "height": 320,
      "ports": [
        {
          "id": "root",
          "label": "root",
          "direction": "bidirectional",
          "dataType": "any",
          "angle": 210
        }
      ],
      "visible": true,
      "showLabel": true,
      "data": {
        "view": {
          "intent": "editor",
          "payload": "editor.web"
        },
        "editor": {
          "web": {
            "fields": [
              {
                "key": "title",
                "label": "Title",
                "type": "text",
                "path": "data.title",
                "placeholder": "Research topic or source"
              },
              {
                "key": "findings",
                "label": "Findings",
                "type": "markdown",
                "path": "data.findings",
                "placeholder": "Summarize what was learned.",
                "multiline": true,
                "rows": 5
              },
              {
                "key": "sourceUrl",
                "label": "Source URL",
                "type": "text",
                "path": "data.sourceUrl",
                "placeholder": "https://..."
              },
              {
                "key": "sourceType",
                "label": "Source Type",
                "type": "select",
                "path": "data.sourceType",
                "options": [
                  {
                    "label": "Article",
                    "value": "article"
                  },
                  {
                    "label": "Paper",
                    "value": "paper"
                  },
                  {
                    "label": "Market",
                    "value": "market"
                  },
                  {
                    "label": "Interview",
                    "value": "interview"
                  },
                  {
                    "label": "Prototype",
                    "value": "prototype"
                  },
                  {
                    "label": "Other",
                    "value": "other"
                  }
                ]
              }
            ]
          }
        }
      }
    },
    {
      "id": "idea-research-detail-view",
      "type": "view",
      "label": "Research Detail",
      "position": {
        "x": 320,
        "y": -220
      },
      "width": 440,
      "height": 320,
      "ports": [
        {
          "id": "root",
          "label": "root",
          "direction": "bidirectional",
          "dataType": "any",
          "angle": 210
        }
      ],
      "visible": true,
      "showLabel": true,
      "data": {
        "view": {
          "intent": "node",
          "payload": "node.web.detail",
          "html": {
            "chrome": true
          }
        },
        "node": {
          "web": {
            "detail": {
              "html": "<div style='width:100%;height:100%;display:flex;flex-direction:column;border-radius:18px;overflow:hidden;background:#ffffff;color:#0f172a;border:1px solid rgba(15,23,42,.14);'><div style='padding:12px 16px;background:#4f46e5;color:white;'><div style='display:flex;justify-content:space-between;gap:8px;font:800 10px system-ui,sans-serif;letter-spacing:.12em;text-transform:uppercase;'><span>Research</span><span>{{data.sourceType}}</span></div><div style='font:800 20px/1.2 system-ui,sans-serif;'>{{data.title}}</div></div><div style='padding:16px;overflow:auto;font:500 14px/1.5 system-ui,sans-serif;'><div style='white-space:pre-wrap;'>{{data.findings}}</div><div style='margin-top:14px;padding-top:12px;border-top:1px solid #e2e8f0;'><div style='font:800 10px system-ui,sans-serif;letter-spacing:.12em;text-transform:uppercase;color:#4f46e5;'>Source URL</div><div style='margin-top:5px;overflow-wrap:anywhere;'>{{data.sourceUrl}}</div></div></div></div>"
            }
          }
        }
      }
    },
    {
      "id": "idea-research-summary-view",
      "type": "view",
      "label": "Research Summary",
      "position": {
        "x": 840,
        "y": -220
      },
      "width": 380,
      "height": 240,
      "ports": [
        {
          "id": "root",
          "label": "root",
          "direction": "bidirectional",
          "dataType": "any",
          "angle": 210
        }
      ],
      "visible": true,
      "showLabel": true,
      "data": {
        "view": {
          "intent": "node",
          "payload": "node.web.summary",
          "html": {
            "chrome": true
          }
        },
        "node": {
          "web": {
            "summary": {
              "html": "<div style='width:100%;height:100%;padding:14px;box-sizing:border-box;border-radius:16px;background:white;border:2px solid #4f46e5;color:#0f172a;overflow:hidden;'><div style='display:flex;justify-content:space-between;gap:8px;font:800 10px system-ui,sans-serif;letter-spacing:.12em;text-transform:uppercase;color:#4f46e5;'><span>Research</span><span>{{data.sourceType}}</span></div><div style='margin-top:6px;font:800 17px/1.25 system-ui,sans-serif;'>{{data.title}}</div><div style='margin-top:8px;font:500 12px/1.4 system-ui,sans-serif;white-space:pre-wrap;'>{{data.findings}}</div></div>"
            }
          }
        }
      }
    }
  ],
