      "data": {
        "identity": {
          "graphId": "idea-question-class",
          "name": "Question Node Class",
          "version": "0.1.0",
          "description": "An uncertainty that must be answered to advance or reject an idea.",
          "createdAt": "2026-08-01T00:00:00.000Z",
          "updatedAt": "2026-08-01T00:00:00.000Z"
        },
        "intent": {
          "kind": "node-class",
          "scope": "local"
        },
        "dependencies": {
          "nodeTypes": [
            "manifest",
            "view"
          ],
          "portContracts": [
            "core"
          ],
          "skills": [
            "idea-template"
          ],
          "schemaVersions": {
            "nodes": ">=1.0.0",
            "ports": ">=1.0.0"
          },
          "optional": []
        },
        "authority": {
          "mutation": {
            "allowCreate": true,
            "allowUpdate": true,
            "allowDelete": true,
            "appendOnly": false
          },
          "actors": {
            "humans": true,
