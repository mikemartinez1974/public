        "nodeClass": {
          "contractVersion": "1.0.0",
          "key": "idea-question",
          "nodeDef": {
            "key": "idea-question",
            "ref": "github://mikemartinez1974/public/templates/idea-template/classes/nodes/idea-question.node-class.node",
            "source": "local",
            "version": ">=0.1.0",
            "defaults": {
              "label": "Question",
              "size": {
                "width": 400,
                "height": 300
              },
              "color": "#ca8a04",
              "showLabel": false,
              "data": {
                "title": "",
                "question": "",
                "status": "open",
                "answer": ""
              }
            }
          }
        }
      }
    },
    {
      "id": "idea-question-editor-view",
      "type": "view",
      "label": "Question Editor",
      "position": {
        "x": -180,
        "y": -220
      },
      "width": 420,
      "height": 320,
      "ports": [
        {
          "id": "root",
          "label": "root",
          "direction": "bidirectional",
          "dataType": "any",
          "angle": 210
        }
      ],
      "visible": true,
      "showLabel": true,
      "data": {
        "view": {
          "intent": "editor",
          "payload": "editor.web"
        },
        "editor": {
          "web": {
            "fields": [
              {
                "key": "title",
                "label": "Title",
                "type": "text",
                "path": "data.title",
                "placeholder": "Short question label"
              },
              {
                "key": "question",
                "label": "Question",
                "type": "markdown",
                "path": "data.question",
                "placeholder": "What must be answered?",
                "multiline": true,
                "rows": 5
              },
              {
                "key": "status",
                "label": "Status",
                "type": "select",
                "path": "data.status",
                "options": [
                  {
                    "label": "Open",
                    "value": "open"
                  },
                  {
                    "label": "Answered",
                    "value": "answered"
                  },
                  {
                    "label": "Deferred",
                    "value": "deferred"
                  }
                ]
              },
              {
                "key": "answer",
                "label": "Answer or Resolution",
                "type": "markdown",
                "path": "data.answer",
                "placeholder": "Record the answer when known.",
                "multiline": true,
                "rows": 5
              }
            ]
          }
        }
      }
    },
    {
      "id": "idea-question-detail-view",
      "type": "view",
      "label": "Question Detail",
      "position": {
        "x": 320,
        "y": -220
      },
      "width": 440,
      "height": 320,
      "ports": [
        {
          "id": "root",
          "label": "root",
          "direction": "bidirectional",
          "dataType": "any",
          "angle": 210
        }
      ],
      "visible": true,
      "showLabel": true,
      "data": {
        "view": {
          "intent": "node",
          "payload": "node.web.detail",
          "html": {
            "chrome": true
          }
        },
        "node": {
          "web": {
            "detail": {
              "html": "<div style='width:100%;height:100%;display:flex;flex-direction:column;border-radius:18px;overflow:hidden;background:#ffffff;color:#0f172a;border:1px solid rgba(15,23,42,.14);'><div style='padding:12px 16px;background:#ca8a04;color:white;'><div style='font:800 10px system-ui,sans-serif;letter-spacing:.16em;text-transform:uppercase;opacity:.82;'>Question</div><div style='font:800 20px/1.2 system-ui,sans-serif;'>{{data.title}}</div></div><div style='padding:16px;font:500 14px/1.5 system-ui,sans-serif;white-space:pre-wrap;overflow:auto;'>{{data.question}}</div></div>"
            }
          }
        }
      }
    },
    {
      "id": "idea-question-summary-view",
      "type": "view",
      "label": "Question Summary",
      "position": {
        "x": 840,
        "y": -220
      },
      "width": 380,
      "height": 240,
      "ports": [
        {
          "id": "root",
          "label": "root",
          "direction": "bidirectional",
          "dataType": "any",
          "angle": 210
        }
      ],
      "visible": true,
      "showLabel": true,
      "data": {
        "view": {
          "intent": "node",
          "payload": "node.web.summary",
          "html": {
            "chrome": true
          }
        },
        "node": {
          "web": {
            "summary": {
              "html": "<div style='width:100%;height:100%;padding:14px;box-sizing:border-box;border-radius:16px;background:white;border:2px solid #ca8a04;color:#0f172a;overflow:hidden;'><div style='font:800 10px system-ui,sans-serif;letter-spacing:.14em;text-transform:uppercase;color:#ca8a04;'>Question</div><div style='margin-top:6px;font:800 17px/1.25 system-ui,sans-serif;'>{{data.title}}</div><div style='margin-top:8px;font:500 12px/1.4 system-ui,sans-serif;white-space:pre-wrap;'>{{data.question}}</div></div>"
            }
          }
        }
      }
    }
  ],
  "edges": [
