        "nodeClass": {
          "contractVersion": "1.0.0",
          "key": "idea-assumption",
          "nodeDef": {
            "key": "idea-assumption",
            "ref": "github://mikemartinez1974/public/templates/idea-template/classes/nodes/idea-assumption.node-class.node",
            "source": "local",
            "version": ">=0.1.0",
            "defaults": {
              "label": "Assumption",
              "size": {
                "width": 400,
                "height": 300
              },
              "color": "#d97706",
              "showLabel": false,
              "data": {
                "title": "",
                "statement": "",
                "importance": "critical",
                "status": "untested"
              }
            }
          }
        }
      }
    },
    {
      "id": "idea-assumption-editor-view",
      "type": "view",
      "label": "Assumption Editor",
      "position": {
        "x": -180,
        "y": -220
      },
      "width": 420,
      "height": 320,
      "ports": [
        {
          "id": "root",
          "label": "root",
          "direction": "bidirectional",
          "dataType": "any",
          "angle": 210
        }
      ],
      "visible": true,
      "showLabel": true,
      "data": {
        "view": {
          "intent": "editor",
          "payload": "editor.web"
        },
        "editor": {
          "web": {
            "fields": [
              {
                "key": "title",
                "label": "Title",
                "type": "text",
                "path": "data.title",
                "placeholder": "Short assumption label"
              },
              {
                "key": "statement",
                "label": "Assumption",
                "type": "markdown",
                "path": "data.statement",
                "placeholder": "What must be true?",
                "multiline": true,
                "rows": 5
              },
              {
                "key": "importance",
                "label": "Importance",
                "type": "select",
                "path": "data.importance",
                "options": [
                  {
                    "label": "Critical",
                    "value": "critical"
                  },
                  {
                    "label": "High",
                    "value": "high"
                  },
                  {
                    "label": "Medium",
                    "value": "medium"
                  },
                  {
                    "label": "Low",
                    "value": "low"
                  }
                ]
              },
              {
                "key": "status",
                "label": "Status",
                "type": "select",
                "path": "data.status",
                "options": [
                  {
                    "label": "Untested",
                    "value": "untested"
                  },
                  {
                    "label": "Testing",
                    "value": "testing"
                  },
                  {
                    "label": "Supported",
                    "value": "supported"
                  },
                  {
                    "label": "Contradicted",
                    "value": "contradicted"
                  }
                ]
              }
            ]
          }
        }
      }
    },
    {
      "id": "idea-assumption-detail-view",
      "type": "view",
      "label": "Assumption Detail",
      "position": {
        "x": 320,
        "y": -220
      },
      "width": 440,
      "height": 320,
      "ports": [
        {
          "id": "root",
          "label": "root",
          "direction": "bidirectional",
          "dataType": "any",
          "angle": 210
        }
      ],
      "visible": true,
      "showLabel": true,
      "data": {
        "view": {
          "intent": "node",
          "payload": "node.web.detail",
          "html": {
            "chrome": true
          }
        },
        "node": {
          "web": {
            "detail": {
              "html": "<div style='width:100%;height:100%;display:flex;flex-direction:column;border-radius:18px;overflow:hidden;background:#ffffff;color:#0f172a;border:1px solid rgba(15,23,42,.14);'><div style='padding:12px 16px;background:#d97706;color:white;'><div style='display:flex;justify-content:space-between;gap:8px;font:800 10px system-ui,sans-serif;letter-spacing:.12em;text-transform:uppercase;'><span>Assumption</span><span>{{data.status}}</span></div><div style='font:800 20px/1.2 system-ui,sans-serif;'>{{data.title}}</div></div><div style='padding:16px;overflow:auto;font:500 14px/1.5 system-ui,sans-serif;'><div style='white-space:pre-wrap;'>{{data.statement}}</div><div style='margin-top:14px;padding-top:12px;border-top:1px solid #e2e8f0;'><span style='font:800 10px system-ui,sans-serif;letter-spacing:.12em;text-transform:uppercase;color:#92400e;'>Importance</span><div style='margin-top:4px;text-transform:capitalize;'>{{data.importance}}</div></div></div></div>"
            }
          }
        }
      }
    },
    {
      "id": "idea-assumption-summary-view",
      "type": "view",
      "label": "Assumption Summary",
      "position": {
        "x": 840,
        "y": -220
      },
      "width": 380,
      "height": 240,
      "ports": [
        {
          "id": "root",
          "label": "root",
          "direction": "bidirectional",
          "dataType": "any",
          "angle": 210
        }
      ],
      "visible": true,
      "showLabel": true,
      "data": {
        "view": {
          "intent": "node",
          "payload": "node.web.summary",
          "html": {
            "chrome": true
          }
        },
        "node": {
          "web": {
            "summary": {
              "html": "<div style='width:100%;height:100%;padding:14px;box-sizing:border-box;border-radius:16px;background:white;border:2px solid #d97706;color:#0f172a;overflow:hidden;'><div style='display:flex;justify-content:space-between;gap:8px;font:800 10px system-ui,sans-serif;letter-spacing:.12em;text-transform:uppercase;color:#d97706;'><span>Assumption</span><span>{{data.status}} · {{data.importance}}</span></div><div style='margin-top:6px;font:800 17px/1.25 system-ui,sans-serif;'>{{data.title}}</div><div style='margin-top:8px;font:500 12px/1.4 system-ui,sans-serif;white-space:pre-wrap;'>{{data.statement}}</div></div>"
            }
          }
        }
      }
    }
  ],
