        "html": "<div style='width:100%;height:100%;box-sizing:border-box;padding:26px;border-radius:28px;background:linear-gradient(155deg,#160b2d,#211044 54%,#312e81);border:1px solid rgba(196,181,253,.28);box-shadow:0 20px 44px rgba(196,181,253,.22);font-family:system-ui;color:#f8fafc'><div style='font:800 11px/1 system-ui;letter-spacing:.18em;color:#c4b5fd'>TWILITE TEMPLATE</div><div style='font:850 32px/1.05 system-ui;margin:15px 0'>Public Arrival</div><div style='font:500 16px/1.6 system-ui;color:#ddd6fe'>Parent edges leave the bottom. Child edges arrive at the top. Multiple bottom handles are spread using distinct angles.</div></div>"
