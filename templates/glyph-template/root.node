  "metadata": {
    "title": "Glyph Template",
    "description": "The single port a Surface's chain ends on -- not a separate stop a chain passes through, but what it resolves to. A Glyph has no ports of its own beyond this one root, and no glyph relationship either: it IS the glyph. It is normally reached by a View's sequence-out, shown here via a portal back to view-template rather than duplicating a View in this graph.",
    "graphId": "glyph-template-declaration",
    "version": "0.3.1",
    "kind": "template",
