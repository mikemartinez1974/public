        "content": {
          "kind": "html",
          "value": "<div style='box-sizing:border-box;width:100%;height:100%;padding:16px;background:linear-gradient(135deg,#7c3aed,#5b21b6);border-radius:16px;display:flex;flex-direction:column;align-items:center;justify-content:center;text-align:center;font-family:system-ui;color:#ffffff'><div style='font:800 20px/1.2 system-ui'>Glyph Template</div><div style='margin-top:6px;font:500 12px/1.4 system-ui;opacity:0.85;max-width:90%'>Where a Surface's chain ends</div></div>"
        },
