{
  "fileVersion": "1.0",
  "metadata": {
    "title": "Port Template",
    "description": "The interface socket a Declaration exposes (relationship: port) so another graph can be wired to a specific named entry point instead of just its default surface. root (bottom, Login glyph) is that socket. surfaces (top, repeatable) is the single way in to any number of Views, same mechanism as a Declaration's own surfaces relationship -- its icon is View's own, a coincidental create-node match, not an authored glyph. landing-surface (right) rounds it out, same as a Declaration.",
    "graphId": "port-template-declaration",
    "version": "0.2.3",
    "kind": "template",
    "created": "2026-10-04T19:38:05.558Z",
    "modified": "2026-10-06T20:35:37.813Z",
    "author": "",
    "tags": [
      "template",
      "port"
    ],
    "preferredViewer": "https://dev.twilite.zone"
  },
