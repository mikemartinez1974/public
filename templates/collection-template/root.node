    {
      "id": "collection-template-guidance",
      "type": "markdown",
      "label": "Collection Membership",
      "root": false,
      "position": { "x": -180, "y": 80 },
      "width": 620,
      "height": 260,
      "visible": true,
      "showLabel": true,
      "ports": [
        { "id": "root", "label": "root", "direction": "bidirectional", "dataType": "any", "angle": 210 },
        { "id": "top", "label": "top", "direction": "bidirectional", "dataType": "value", "angle": 270 }
      ],
      "data": {
        "markdown": "## Collection Membership\n\nAdd direct `.node` files or direct-child `root.node` graphs to this directory. The collection discovers them automatically and presents their ordinary root `node.web` cards in a bounded window. Intentional navigation portals remain authored separately.",
        "visibilityRole": "browser"
      }
    }
