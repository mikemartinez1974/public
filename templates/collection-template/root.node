      "data": {
        "title": "My Collection",
        "purpose": "A directory-defined collection whose members appear automatically.",
        "renderShape": { "kind": "svg" },
        "svg": "<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 700 360' role='img' aria-label='Collection template'><defs><linearGradient id='bg' x1='0' y1='0' x2='1' y2='1'><stop offset='0' stop-color='#0f172a'/><stop offset='.55' stop-color='#164e63'/><stop offset='1' stop-color='#0f766e'/></linearGradient></defs><rect x='5' y='5' width='690' height='350' rx='34' fill='url(#bg)' stroke='#5eead4' stroke-width='2'/><text x='52' y='82' fill='#99f6e4' font-family='system-ui,sans-serif' font-size='14' font-weight='800' letter-spacing='.2em'>DIRECTORY-DISCOVERED</text><text x='52' y='138' fill='#fff' font-family='system-ui,sans-serif' font-size='42' font-weight='850'>My Collection</text><g transform='translate(52 205)' fill='none' stroke='#5eead4' stroke-width='3'><rect width='120' height='80' rx='16'/><rect x='145' width='120' height='80' rx='16'/><rect x='290' width='120' height='80' rx='16'/></g><text x='52' y='322' fill='#ccfbf1' font-family='system-ui,sans-serif' font-size='17'>Members arrive from the folder; ten cards appear at a time</text></svg>",
        "altText": "A teal collection card with a row of member cards.",
