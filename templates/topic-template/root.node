        "content": {
          "kind": "markdown",
          "value": "# Topic Template\n\nModel a complex subject as a navigable structure of concepts, claims, mechanisms, perspectives, sources, and synthesis. Use this when the goal is to understand the subject itself rather than merely answer one question."
        },
        "_placement": {
          "version": 1,
          "state": "manually-shaped",
