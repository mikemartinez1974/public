{"fileVersion":"1.0","metadata":{"title":"Topic Node Class","description":"The bounded subject represented by a Topic graph.","graphId":"topic-class","version":"0.1.0","kind":"node-class","tags":["node-class","topic-template","topic"]},"nodes":[{"id":"topic-class-declaration","type":"declaration","label":"Topic Declaration","position":{"x":0,"y":-360},"width":300,"height":160,"ports":[{"id":"root","label":"root","direction":"bidirectional","dataType":"any","angle":210}],"visible":true,"showLabel":true,"data":{"identity":{"graphId":"topic-class","name":"Topic Node Class","version":"0.1.0","description":"The bounded subject represented by a Topic graph."},"intent":{"kind":"node-class","scope":"shared"},"dependencies":{"nodeTypes":["declaration","markdown","port"],"portContracts":["core"],"skills":["topic-template"]},"authority":{"mutation":{"allowCreate":true,"allowUpdate":true,"allowDelete":true,"appendOnly":false},"actors":{"humans":true,"agents":true,"tools":true}},"declaration":{"kind":"node-class","targetMode":"artifact","artifactKind":"node-class","defaultSurfaceId":"detail","surfaces":[{"id":"detail","kind":"view","viewNodeId":"topic-class-detail"},{"id":"summary","kind":"view","viewNodeId":"topic-class-summary"},{"id":"icon","kind":"view","viewNodeId":"topic-class-icon"},{"id":"editor","kind":"view","viewNodeId":"topic-class-editor"}]},"nodeClass":{"contractVersion":"1.0.0","key":"topic","label":"Topic","meaning":"The bounded subject represented by a Topic graph.","requiredDataKeys":["title"],"nodeDef":{"key":"topic","ref":"github://mikemartinez1974/public/templates/topic-template/classes/nodes/topic.node-class.node","source":"local","version":">=0.1.0","defaults":{"label":"Topic","size":{"width":440,"height":300},"showLabel":false,"data":{"title":"","description":"","scope":""},"ports":[{"id":"root","label":"root","direction":"bidirectional","dataType":"any","angle":210}]}}}}}},{"id":"topic-class-contract","type":"markdown","label":"Topic Contract","position"