{"fileVersion":"1.0","metadata":{"title":"Topic Source Node Class","description":"A provenance source that informs a Topic graph without becoming the claim itself.","graphId":"topic-source-class","version":"0.1.0","kind":"node-class"},"nodes":[{"id":"topic-source-declaration","type":"declaration","label":"Source Declaration","position":{"x":0,"y":-360},"width":300,"height":160,"ports":[{"id":"root","label":"root","direction":"bidirectional","dataType":"any","angle":210}],"visible":true,"showLabel":true,"data":{"identity":{"graphId":"topic-source-class","name":"Topic Source Node Class","version":"0.1.0","description":"A provenance source that informs a Topic graph without becoming the claim itself."},"intent":{"kind":"node-class","scope":"shared"},"dependencies":{"nodeTypes":["declaration","markdown","port"],"skills":["topic-template"]},"authority":{"mutation":{"allowCreate":true,"allowUpdate":true,"allowDelete":true,"appendOnly":false},"actors":{"humans":true,"agents":true,"tools":true}},"declaration":{"kind":"node-class","targetMode":"artifact","artifactKind":"node-class","defaultSurfaceId":"detail","surfaces":[{"id":"detail","kind":"view","viewNodeId":"topic-source-detail"},{"id":"summary","kind":"view","viewNodeId":"topic-source-summary"},{"id":"icon","kind":"view","viewNodeId":"topic-source-icon"},{"id":"editor","kind":"view","viewNodeId":"topic-source-editor"}]},"nodeClass":{"contractVersion":"1.0.0","key":"topic-source","label":"Source","meaning":"A provenance source that informs a Topic graph without becoming the claim itself.","requiredDataKeys":["title"],"nodeDef":{"key":"topic-source","ref":"github://mikemartinez1974/public/templates/topic-template/classes/nodes/topic-source.node-class.node","defaults":{"label":"Source","size":{"width":420,"height":260},"showLabel":false,"data":{"title":"","citation":"","notes":""},"ports":[{"id":"root","label":"root","direction":"bidirectional","dataType":"any","angle":210}]}}}}}},{"id":"topic-source-contract","type":"mar