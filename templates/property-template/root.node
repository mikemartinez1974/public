    {
      "id": "property-template-icon-view",
      "type": "view",
      "label": "Property Template Icon",
      "root": false,
      "position": {
        "x": 304.46104343237835,
        "y": 333.5987738667818
      },
      "width": 208.54482521508191,
      "height": 194.4581891117896,
      "visible": true,
