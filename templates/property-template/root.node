        },
        "content": {
          "kind": "markdown",
          "value": "## Property\n\nNamed state, effective-value provenance, and an authored inline editor. Unset, null, inherited, default, and computed values remain distinct."
        },
        "_placement": {
          "version": 1,
          "state": "manually-shaped",
          "source": "manual",
