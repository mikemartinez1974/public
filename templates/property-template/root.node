        "content": {
          "kind": "svg",
          "value": "<svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 320 220\"><rect width=\"320\" height=\"220\" rx=\"28\" fill=\"#155e75\"/><text x=\"30\" y=\"75\" fill=\"#a5f3fc\" font-family=\"system-ui\" font-size=\"16\" font-weight=\"800\">PROPERTY</text><text x=\"30\" y=\"135\" fill=\"white\" font-family=\"system-ui\" font-size=\"30\" font-weight=\"800\">name = value</text></svg>"
        },
        "_placement": {
