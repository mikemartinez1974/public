                "icon": "refresh",
                "action": "emit",
                "event": "collection:refresh",
                "priority": 30
              },
              {
                "id": "next",
                "type": "button",
                "label": "Next",
                "icon": "forward",
                "action": "emit",
                "event": "collection:next",
                "priority": 40
              }
            ],
            "events": [
              {
                "id": "window-state",
                "event": "collection:window-state",
                "patch": {
                  "rangeLabel": "{{event.start}}–{{event.end}} of {{event.count}}",
                  "activePageSize": "{{event.pageSize}}"
                }
              }
            ]
          }
        },
        "html": "<div style='width:100%;height:100%;box-sizing:border-box;padding:16px;border-radius:18px;background:#f8fafc;border:2px solid #14b8a6;color:#134e4a;font-family:system-ui;overflow:auto;display:flex;flex-direction:column;gap:12px'><div style='display:flex;gap:7px;align-items:center;flex-wrap:wrap'><button type='button' data-twilite-control='previous' style='border:1px solid #5eead4;border-radius:9px;padding:7px 10px;background:#fff;color:#115e59;font:800 12px system-ui;cursor:pointer'>← Previous</button><button type='button' data-twilite-control='next' style='border:1px solid #0f766e;border-radius:9px;padding:7px 11px;background:#0f766e;color:#fff;font:800 12px system-ui;cursor:pointer'>Next →</button><label style='display:flex;align-items:center;gap:5px;font:700 11px system-ui'>Size <input type='number' min='1' max='50' step='1' value='{{data.pageSize || 10}}' data-twilite-control-value='apply-page-size' data-twilite-value-type='number' style='width:44px;border:1px solid #99f6e4;background:white;color:#134e4a;font:800 12px system-ui;padding:6px;border-radius:7px'></label><button type='button' data-twilite-control='apply-page-size' style='border:1px solid #5eead4;border-radius:9px;padding:7px 10px;background:#ccfbf1;color:#115e59;font:800 12px system-ui;cursor:pointer'>Apply</button><button type='button' data-twilite-control='run-controller' style='border:1px solid #5eead4;border-radius:9px;padding:7px 10px;background:#fff;color:#115e59;font:900 13px system-ui;cursor:pointer'>↻</button></div><div><div style='font-size:10px;font-weight:900;letter-spacing:.12em;color:#0f766e'>COLLECTION CONTROLLER</div><h2 style='font-size:18px;margin:4px 0 2px'>{{data.scriptName || label}}</h2><span style='font-size:11px;color:#64748b'>{{data.rangeLabel || 'Ready'}}</span></div><div style='display:grid;grid-template-columns:1fr 1fr;gap:10px;font-size:12px'><div><b>Multiplicity</b><br>{{data.multiplicity || 'singleton'}}</div><div><b>Mutations</b><br>{{data.allowMutations}}</div><div><b>Dry run</b><br>{{data.dryRun}}</div></div><hr style='border:0;border-top:1px solid #cbd5e1;margin:0'><b>Source</b><div style='padding:9px;border:1px solid #99f6e4;border-radius:9px;background:white;overflow-wrap:anywhere;font:11px ui-monospace'>{{data.scriptRef}}</div><p style='margin:0;font-size:12px'><b>Effects:</b> {{data.effects}}</p><p style='margin:0;font-size:12px'><b>Requires:</b> {{data.requirements}}</p><p style='margin:0;font-size:12px'><b>Grants:</b> {{data.grants}}</p></div>"
      },
