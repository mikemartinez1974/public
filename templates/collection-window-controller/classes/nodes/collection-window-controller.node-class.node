    {
      "id": "collection-window-controller-summary",
      "type": "view",
      "label": "Controller Firing Surface",
      "position": {
        "x": 320,
        "y": -340
      },
      "width": 380,
      "height": 120,
      "visible": true,
      "ports": [
        {
          "id": "root",
          "label": "root",
          "direction": "bidirectional",
          "dataType": "any",
          "angle": 210
        }
      ],
      "data": {
        "key": "node.web.summary",
        "intent": "node",
        "payload": "node.web.summary",
        "semanticLevel": "summary",
        "view": {
          "controlsPlacement": "content"
        },
        "node": {
          "web": {
            "controls": [
              {
                "id": "previous",
                "type": "button",
                "label": "Previous",
                "icon": "back",
                "action": "emit",
                "event": "collection:previous",
                "priority": 10
              },
              {
                "id": "apply-page-size",
                "type": "button",
                "label": "Apply Size",
                "icon": "refresh",
                "action": "emit",
                "event": "collection:page-size",
                "payloadPath": "data.pageSize",
                "priority": 20
              },
              {
                "id": "run-controller",
                "type": "button",
                "label": "Refresh",
                "icon": "refresh",
                "action": "emit",
                "event": "collection:refresh",
                "priority": 30
              },
              {
                "id": "next",
                "type": "button",
                "label": "Next",
                "icon": "forward",
                "action": "emit",
                "event": "collection:next",
                "priority": 40
              }
            ],
            "events": [
              {
                "id": "window-state",
                "event": "collection:window-state",
                "patch": {
                  "rangeLabel": "{{event.start}}–{{event.end}} of {{event.count}}",
                  "activePageSize": "{{event.pageSize}}"
                }
              }
            ]
          }
        },
        "html": "<div style='width:100%;height:100%;box-sizing:border-box;padding:10px 12px;border-radius:14px;background:linear-gradient(145deg,#ecfeff,#f8fafc);border:2px solid #14b8a6;color:#134e4a;font-family:system-ui;display:flex;flex-direction:column;justify-content:center;gap:8px'><div style='display:flex;align-items:center;gap:6px;flex-wrap:nowrap'><button type='button' aria-label='Previous collection window' title='Previous' data-twilite-control='previous' style='width:32px;height:30px;border:1px solid #5eead4;border-radius:8px;background:#fff;color:#115e59;font:900 16px system-ui;cursor:pointer'>←</button><button type='button' aria-label='Next collection window' title='Next' data-twilite-control='next' style='width:32px;height:30px;border:1px solid #0f766e;border-radius:8px;background:#0f766e;color:#fff;font:900 16px system-ui;cursor:pointer'>→</button><label title='Page size' style='height:30px;display:flex;align-items:center;gap:4px;padding:0 6px;border:1px solid #99f6e4;border-radius:8px;background:white;color:#64748b;font:700 10px system-ui'>Size <input type='number' min='1' max='50' step='1' value='{{data.pageSize || 10}}' data-twilite-control-value='apply-page-size' data-twilite-value-type='number' style='width:32px;border:0;background:#f0fdfa;color:#134e4a;font:800 11px system-ui;padding:2px;border-radius:5px'></label><button type='button' aria-label='Apply page size' title='Apply page size' data-twilite-control='apply-page-size' style='height:30px;border:1px solid #5eead4;border-radius:8px;padding:0 8px;background:#ccfbf1;color:#115e59;font:800 10px system-ui;cursor:pointer'>Apply</button><button type='button' aria-label='Refresh collection' title='Refresh' data-twilite-control='run-controller' style='width:32px;height:30px;border:1px solid #5eead4;border-radius:8px;background:#fff;color:#115e59;font:900 14px system-ui;cursor:pointer'>↻</button></div><div style='display:flex;align-items:center;justify-content:space-between;gap:10px;min-width:0'><strong style='min-width:0;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;font-size:12px'>{{data.scriptName || label || 'Collection'}}</strong><span style='flex:none;color:#64748b;font:700 10px system-ui'>{{data.rangeLabel || 'Ready'}}</span></div></div>"
      },
