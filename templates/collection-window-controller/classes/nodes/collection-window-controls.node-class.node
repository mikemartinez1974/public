      },
      "handles": []
    },
    {
      "id": "collection-window-controls-editor",
      "type": "view",
      "label": "Controls Editor",
      "position": {
        "x": 340,
        "y": 300
      },
      "width": 520,
      "height": 300,
      "visible": true,
      "data": {
        "key": "editor.web",
        "intent": "editor",
        "payload": "editor.web",
        "semanticLevel": "detail",
        "editor": {
          "web": {
            "fields": [
              {
                "key": "title",
                "label": "Panel Title",
                "path": "data.title",
                "type": "text",
                "placeholder": "Collection Window"
              },
              {
                "key": "pageSize",
                "label": "Page Size",
                "path": "data.pageSize",
                "type": "number",
                "min": 1,
                "max": 50,
                "step": 1
              }
            ]
          }
        }
      },
      "handles": []
    },
