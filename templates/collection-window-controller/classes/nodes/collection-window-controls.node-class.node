    {
      "id": "collection-window-controls-detail",
      "type": "view",
      "label": "Controls Detail",
      "position": {
        "x": 340,
        "y": -300
      },
      "width": 520,
      "height": 250,
      "visible": true,
      "ports": [
        {
          "id": "root",
          "label": "root",
          "direction": "bidirectional",
          "dataType": "any",
          "angle": 210
        }
      ],
      "data": {
        "key": "node.web.detail",
        "intent": "node",
        "payload": "node.web.detail",
        "semanticLevel": "detail",
        "node": {
          "web": {
            "controls": [
              {
                "id": "previous",
                "type": "button",
                "label": "Previous",
                "icon": "back",
                "action": "emit",
                "event": "collection:previous",
                "priority": 10
              },
              {
                "id": "apply-page-size",
                "type": "button",
                "label": "Apply Size",
                "icon": "refresh",
                "action": "emit",
                "event": "collection:page-size",
                "payloadPath": "data.pageSize",
                "priority": 20
              },
              {
                "id": "next",
                "type": "button",
                "label": "Next",
                "icon": "forward",
                "action": "emit",
                "event": "collection:next",
                "priority": 30
              }
            ],
            "events": [
              {
                "id": "window-state",
                "event": "collection:window-state",
                "patch": {
                  "rangeLabel": "{{event.start}}–{{event.end}} of {{event.count}}",
                  "activePageSize": "{{event.pageSize}}"
                }
              }
            ]
          }
        },
        "html": "<div style='width:100%;height:100%;box-sizing:border-box;padding:22px;border-radius:20px;background:linear-gradient(145deg,#ecfeff,#f8fafc);border:2px solid #14b8a6;color:#134e4a;font-family:system-ui;display:flex;flex-direction:column;gap:14px'><div style='font-size:13px;font-weight:850;letter-spacing:.15em;color:#0f766e'>COLLECTION CONTROLS</div><div style='font-size:27px;font-weight:850'>{{data.title || label || 'Collection Window'}}</div><div style='display:flex;gap:10px;align-items:center'><span style='padding:8px 12px;border-radius:10px;background:white;border:1px solid #99f6e4;font-weight:800'>Page size: {{data.pageSize || 2}}</span><span style='color:#64748b'>{{data.rangeLabel || 'Ready'}}</span></div><div style='margin-top:auto;color:#64748b;font-size:12px'>Edit page size, apply it, then move through the collection with Previous and Next.</div></div>"
      },
      "handles": [
        {
          "id": "root",
          "label": "root",
          "direction": "bidirectional",
          "dataType": "any",
          "angle": 210
        }
      ]
    },
