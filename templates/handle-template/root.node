      "width": 200,
      "height": 160,
      "visible": true,
      "showLabel": true,
      "data": {
        "view": {
          "intent": "node",
          "payload": "handle.web"
        },
        "identity": {
          "graphId": "handle-template",
          "nodeId": "handle-template-orb-handle"
        },
        "svg": "<svg viewBox='0 0 100 100' xmlns='http://www.w3.org/2000/svg'><defs><radialGradient id='orb' cx='35%' cy='30%' r='75%'><stop offset='0%' stop-color='#4b5563'/><stop offset='55%' stop-color='#1f2937'/><stop offset='100%' stop-color='#0b0f14'/></radialGradient></defs><circle cx='50' cy='50' r='46' fill='url(#orb)' stroke='#000000' stroke-opacity='0.35' stroke-width='1'/><ellipse cx='35' cy='28' rx='16' ry='10' fill='#ffffff' opacity='0.18'/><circle cx='50' cy='50' r='22' fill='#f8fafc'/><g stroke='#0f172a' stroke-width='2.4' stroke-linecap='round' fill='#0f172a'><circle cx='50' cy='38' r='4'/><circle cx='40' cy='60' r='4'/><circle cx='60' cy='60' r='4'/><line x1='50' y1='38' x2='40' y2='60'/><line x1='50' y1='38' x2='60' y2='60'/><line x1='40' y1='60' x2='60' y2='60'/></g></svg>"
      }
