        "content": {
          "kind": "html",
          "value": "<div style='box-sizing:border-box;width:100%;height:100%;padding:24px;background:#ffffff;font-family:system-ui;color:#0f172a'><div style='font:700 16px/1.3 system-ui'>Landing surface</div><div style='margin-top:8px;font:400 13px/1.5 system-ui;color:#475569'>Reached by the Declaration's landing-surface port -- also carrying the orb.</div></div>"
        }
      }
    },
    {
      "id": "handle-template-orb-handle",
      "type": "view",
      "label": "Orb Handle",
      "position": {
        "x": -480,
        "y": -240
