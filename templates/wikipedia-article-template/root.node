      "type": "wikipedia-article-source",
      "label": "Wikipedia Article",
      "root": false,
      "position": {"x": -380, "y": -220},
      "width": 680,
      "height": 500,
      "visible": true,
      "showLabel": false,
      "ports": [{"id": "root", "label": "root", "direction": "bidirectional", "dataType": "any", "angle": 210}],
      "data": {
        "canonicalUrl": "https://en.wikipedia.org/wiki/Wikipedia",
        "title": "Wikipedia",
        "revisionId": "runtime",
        "lead": "Runtime-resolved article lead appears here.",
        "firstSection": {"id": "runtime-first", "title": "First section", "content": "The first useful article section is resolved into the detail surface."},
        "sections": [],
        "attribution": {"source": "Wikipedia", "license": "CC BY-SA", "licenseUrl": "https://creativecommons.org/licenses/by-sa/4.0/"},
        "dynamicPortContract": {
          "sourcePath": "sections",
          "idPath": "id",
          "labelPath": "title",
          "hoverLabel": true,
          "onDrag": "instantiate wikipedia-section with articleUrl + section identity"
        },
        "definitionKey": "wikipedia-article-source",
        "_classBinding": {"key": "wikipedia-article-source", "sourceRef": "github://mikemartinez1974/public/templates/wikipedia-article-template/classes/nodes/wikipedia-article-source.node-class.node"},
        "_bridge": {"classKey": "wikipedia-article-source", "classRef": "github://mikemartinez1974/public/templates/wikipedia-article-template/classes/nodes/wikipedia-article-source.node-class.node", "entryPort": "root", "kind": "node-class", "sourceRef": "github://mikemartinez1974/public/templates/wikipedia-article-template/classes/nodes/wikipedia-article-source.node-class.node", "targetKind": "node-class"},
