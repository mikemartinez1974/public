    {
      "id": "wiki-article-v1-design-notes",
      "type": "markdown",
      "label": "Codex: Wikipedia Article V1",
      "root": false,
      "position": {
        "x": 2117.3695686787687,
        "y": -1280.3474623036793
      },
      "width": 560,
      "height": 620,
      "ports": [
        {
          "id": "root",
          "label": "root",
          "direction": "bidirectional",
          "dataType": "value",
          "side": "left",
          "offset": 0.2,
          "position": {
            "side": "left",
            "offset": 0.2
          }
        },
        {
          "id": "top",
          "label": "top",
          "direction": "bidirectional",
          "dataType": "value",
          "side": "top",
          "offset": 0.5,
          "position": {
            "side": "top",
