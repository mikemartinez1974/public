    {
      "id": "sync-demo-label-handler",
      "type": "script",
      "label": "Sync label to demo view",
      "position": {
        "x": -850,
        "y": 1810
      },
      "width": 420,
      "height": 260,
      "ports": [
        {
          "id": "root",
          "label": "root",
          "direction": "input",
          "dataType": "any",
          "angle": 180
        }
      ],
      "handles": [
        {
          "id": "root",
          "label": "root",
          "direction": "input",
          "dataType": "any",
          "angle": 180,
          "portId": "root"
        }
      ],
      "visible": true,
      "showLabel": true,
      "data": {
        "scriptName": "Sync edge demo label",
        "allowMutations": true,
        "autoRun": false,
        "autoRunOnLoad": false,
        "autoRunOnGraphChange": false,
        "dryRun": false,
        "source": "const payload=api.invocation?.eventPayload||{};const value=payload.state==='unset'?'unset':payload.value===null?'null':String(payload.value??'');const escapeXml=input=>String(input).replace(/[&<>\"']/g,ch=>({'&':'&amp;','<':'&lt;','>':'&gt;','\"':'&quot;',\"'\":'&apos;'}[ch]));const view=await api.getNode('detail-view');if(!view)throw new Error('Detail demo view is missing');const svg=String(view.data?.content?.value||'');const marker=/(<text[^>]*id=['\"]edge-demo-label['\"][^>]*>)[\\s\\S]*?(<\\/text>)/;if(!marker.test(svg))throw new Error('Demo label marker is missing');const next=svg.replace(marker,(_,open,close)=>open+escapeXml(value)+close);await api.updateNode('detail-view',{data:{...(view.data||{}),content:{...(view.data?.content||{}),value:next}}});return{updated:true,label:value};",
        "identity": {
          "graphId": "edge-class-template-declaration"
        }
      }
    }
