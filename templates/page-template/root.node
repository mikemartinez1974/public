    {
      "id": "page-template-detail",
      "type": "view",
      "label": "Page",
      "root": false,
      "position": {
        "x": -900,
        "y": -520
      },
      "width": 760,
      "height": 900,
      "ports": [
        {
          "id": "root",
          "key": "root",
          "label": "root",
          "direction": "input",
          "dataType": "any",
          "angle": 270
        }
      ],
      "handles": [
        {
          "id": "root",
          "key": "root",
          "label": "root",
          "direction": "input",
          "dataType": "any",
          "angle": 270,
          "portId": "root"
        }
      ],
      "visible": true,
      "showLabel": true,
      "data": {
        "identity": {
          "graphId": "page-template"
        },
        "view": {
          "intent": "node",
          "payload": "node.web.detail"
        },
        "semanticLevel": "detail",
        "content": {
          "kind": "html",
          "value": "<div style='min-height:100%;box-sizing:border-box;background:#ffffff;font-family:system-ui'><header data-role='masthead' style='padding:56px 40px 32px'><div style='font:800 12px/1 system-ui;letter-spacing:.18em;color:#7c3aed;margin-bottom:16px'>TWILITE</div><h1 style='margin:0 0 14px;font:850 44px/1.05 system-ui;color:#0f172a'>Welcome to Twilite</h1><p style='margin:0;font:400 20px/1.5 system-ui;color:#475569'>Turn information, work, and ideas into things you can navigate.</p></header><section data-role='route' data-prominence='primary' style='margin:0 40px 16px;padding:22px 26px;border-radius:18px;background:#ede9fe;border:1px solid #c4b5fd'><h2 style='margin:0 0 8px;font:800 24px/1.2 system-ui;color:#0f172a'>Get Started</h2><p style='margin:0 0 12px;font:400 15px/1.55 system-ui;color:#475569'>A short first journey: your first useful graph, the interface, and a real next action.</p><span style='font:700 13px/1 system-ui;color:#6d28d9'>Start learning →</span></section><section data-role='route' data-prominence='primary' style='margin:0 40px 16px;padding:22px 26px;border-radius:18px;background:#ede9fe;border:1px solid #c4b5fd'><h2 style='margin:0 0 8px;font:800 24px/1.2 system-ui;color:#0f172a'>See What It Does</h2><p style='margin:0 0 12px;font:400 15px/1.55 system-ui;color:#475569'>A compact demonstration that uses the product itself.</p><span style='font:700 13px/1 system-ui;color:#6d28d9'>Watch it work →</span></section><section data-role='route' data-prominence='secondary' style='margin:0 40px 16px;padding:22px 26px;border-radius:18px;background:#f8fafc;border:1px solid #e2e8f0'><h2 style='margin:0 0 8px;font:800 18px/1.2 system-ui;color:#0f172a'>Explore</h2><p style='margin:0 0 12px;font:400 15px/1.55 system-ui;color:#475569'>Enter the preserved public world and follow whatever interests you.</p><span style='font:700 13px/1 system-ui;color:#6d28d9'>Enter the world →</span></section><section data-role='section' style='padding:24px 40px'><h2 style='margin:0 0 12px;font:800 26px/1.2 system-ui;color:#0f172a'>Lobby, journeys, world</h2><p style='margin:0 0 12px;font:400 16px/1.6 system-ui;color:#334155'>This page stays calm on purpose. Get Started and See What It Does are short journeys, and Explore is the whole public world.</p><p style='margin:0 0 12px;font:400 16px/1.6 system-ui;color:#334155'>Everything you see here is a separate piece you can change on its own.</p></section><section data-role='settings' style='padding:24px 40px'><h2 style='margin:0 0 12px;font:800 26px/1.2 system-ui;color:#0f172a'>About this page</h2><dl style='margin:0;display:grid;grid-template-columns:max-content 1fr;gap:8px 24px;padding:18px 22px;border-radius:14px;background:#f8fafc;border:1px solid #e2e8f0'><dt style='font:700 13px/1.5 system-ui;color:#64748b'>Order</dt><dd style='margin:0;font:500 15px/1.5 system-ui;color:#0f172a'>Graph order</dd><dt style='font:700 13px/1.5 system-ui;color:#64748b'>Roles in use</dt><dd style='margin:0;font:500 15px/1.5 system-ui;color:#0f172a'>Masthead, route, section, settings</dd><dt style='font:700 13px/1.5 system-ui;color:#64748b'>Kept current by</dt><dd style='margin:0;font:500 15px/1.5 system-ui;color:#0f172a'>One Method, called by a Handler for each role and one for the graph structure</dd></dl></section></div>"
        }
      }
    },
