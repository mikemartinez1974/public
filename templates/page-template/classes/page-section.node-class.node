          "value": "<div style='box-sizing:border-box;width:100%;height:100%;padding:28px;background:#1c1006;border-radius:16px;border:1px solid rgba(253,230,138,0.35);font-family:system-ui;color:#fff;overflow:auto'><div style='font:800 12px system-ui;letter-spacing:2px;color:#fbbf24;text-transform:uppercase;margin-bottom:10px'>Page Section</div><div style='font:800 28px/1.3 system-ui;margin-bottom:14px'>{{data.title || label || \"Section\"}}</div><div style='font:400 15px/1.7 system-ui;color:#fde68a;white-space:pre-wrap'>{{data.body}}</div></div>"
