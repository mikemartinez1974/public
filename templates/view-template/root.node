  "metadata": {
    "title": "View Template",
    "description": "Where a View authors its own interface: root (left) is where a Declaration's surfaces edge lands, or where a previous View's sequence-out lands on a later one. surface-delegate (top) branches sideways to a Content node instead of owning content directly. sequence-in/sequence-out (left/right) continue the chain to the next View or a terminal Glyph. Content and Glyph each have their own dedicated template -- linked below, not merged in here.",
    "graphId": "view-template-declaration",
    "version": "0.1.0",
    "kind": "template",
