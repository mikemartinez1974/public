          "nodeId": "view-template-view"
        },
        "content": {
          "kind": "html",
          "value": "<div style='box-sizing:border-box;width:100%;height:100%;padding:28px;background:#ffffff;font-family:system-ui;color:#0f172a'><h1 style='margin:0 0 12px;font:800 26px/1.2 system-ui'>View</h1><p style='margin:0 0 12px;max-width:60ch;font:400 16px/1.6 system-ui;color:#334155'>A View is the background: the passive surface a node presents from the outside. It delegates its real content sideways, to a Content node, rather than holding it directly.</p><p style='margin:0;max-width:60ch;font:400 16px/1.6 system-ui;color:#334155'>It also chains: sequence-out hands off to the next View in a Surface, or, at the end, to a Glyph.</p></div>"
        }
      }
    },
