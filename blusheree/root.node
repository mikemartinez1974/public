    {
      "id": "4bd8faff-fbc4-47a4-bf7f-a666966c7912",
      "type": "face",
      "label": "Blusheree · Storefront page",
      "position": {
        "x": -340,
        "y": -500
      },
      "width": 510,
      "height": 330,
      "visible": true,
      "showLabel": true,
      "data": {
        "identity": {
          "graphId": "blusheree-showroom",
          "nodeId": "4bd8faff-fbc4-47a4-bf7f-a666966c7912"
        },
        "view": {
          "intent": "node",
          "payload": "node.web.detail",
          "scroll": "page"
        },
        "semanticLevel": "detail",
        "content": {
          "kind": "html",
          "value": "<div style=\"container-type:inline-size;width:100%;height:100%;box-sizing:border-box;overflow:auto;background:#fff8f4;color:#4a2a3d;font-family:system-ui\"><div style=\"max-width:900px;margin:auto;padding:clamp(25px,6cqw,70px)\"><div style=\"display:flex;align-items:center;justify-content:space-between;padding:0 0 18px;border-bottom:2px solid #b77992\"><span style=\"color:#a26580;font:800 12px system-ui;letter-spacing:.2em\">BLUSHEREE / THE STUDIO</span><span style=\"font-size:22px;color:#cb9b6a\">✦</span></div><h1 style=\"font:600 clamp(48px,12cqw,100px)/.95 Georgia,serif;letter-spacing:-.06em;margin:50px 0 24px\">Made to<br><span style=\"color:#bc688b\">leave a mark.</span></h1><p style=\"font:400 clamp(19px,3cqw,27px)/1.5 system-ui;color:#705164;max-width:680px\">Vinyl decals, creative stencils, and the little details that make something feel yours.</p><div style=\"border-radius:24px;background:#642e49;color:#fff6ef;padding:35px;margin:36px 0 42px\"><div style=\"color:#ebc1ce;font:800 13px system-ui;letter-spacing:.16em\">WELCOME TO BLUSHEREE</div><p style=\"font:500 clamp(27px,5cqw,43px)/1.18 Georgia,serif;margin:18px 0 0\">Something sweet.<br>Something personal.<br>Something unmistakably you.</p></div><div style=\"display:grid;grid-template-columns:repeat(auto-fit,minmax(210px,1fr));gap:16px\"><div style=\"border:1px solid #e7b9c9;padding:24px;border-radius:16px\"><div style=\"font:800 12px system-ui;letter-spacing:.14em;color:#a26580\">01 / VINYL DECALS</div><h2 style=\"font:600 31px Georgia,serif;margin:15px 0 10px\">Peel. Place. Smile.</h2><p style=\"line-height:1.6;color:#705164\">Decorative lettering, shapes, and designs for a personal touch.</p></div><div style=\"border:1px solid #e7b9c9;padding:24px;border-radius:16px\"><div style=\"font:800 12px system-ui;letter-spacing:.14em;color:#a26580\">02 / STENCILS</div><h2 style=\"font:600 31px Georgia,serif;margin:15px 0 10px\">Make your mark.</h2><p style=\"line-height:1.6;color:#705164\">Reusable design ideas for lettering, patterns and creative projects.</p></div></div><p style=\"font:italic 22px Georgia,serif;color:#9f647f;margin:40px 0 0\">A little creativity goes a long way. ♡</p><p style=\"border-top:1px solid #e6c3cf;padding-top:19px;color:#836a78;font:400 13px system-ui\">Showroom concept · Add the studio's real photographs, ordering details and contact information when ready.</p></div></div>"
        }
      }
    },
