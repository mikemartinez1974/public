          "dataType": "any",
          "angle": 0
        }
      ],
      "style": {
        "background": "#fff9f5",
        "color": "#4c2e3f",
        "borderColor": "#d9aabd",
        "borderRadius": 18
      },
      "visible": true,
      "showLabel": true,
      "data": {
        "identity": {
          "graphId": "blusheree-showroom",
          "nodeId": "blusheree-origin-result"
        },
        "content": {
          "kind": "html",
          "value": "<div style=\"box-sizing:border-box;container-type:inline-size;width:100%;height:100%;overflow:auto;background:linear-gradient(145deg,#fff9f5,#f8e7ec);color:#4c2e3f;border:2px solid #d9aabd;border-radius:18px;padding:clamp(24px,5cqw,44px);font-family:system-ui,-apple-system,Segoe UI,sans-serif\"><div style=\"font:900 13px/1.3 system-ui;letter-spacing:.16em;color:#985571\">03 / THE RESULT</div><h2 style=\"font:500 clamp(28px,5cqw,42px)/1.15 Georgia,serif;letter-spacing:-.025em;margin:22px 0;color:#542d44\">And now you can walk in.</h2><p style=\"font:400 clamp(16px,2.9cqw,23px)/1.6 system-ui;color:#63475a;margin:0\">The agent created the Blusheree showroom as an authored Twilite graph. The cards, sample wall, storefront face and boutique environment are the actual result waiting below.</p><p style=\"font:600 14px/1.5 system-ui;color:#8d5272;border-top:1px solid #d7adbe;padding-top:18px;margin-top:24px\">Concept examples only. Real products, pricing and contact details still need the owner's input.</p></div>"
        }
      }
    }
