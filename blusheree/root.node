          "direction": "bidirectional",
          "dataType": "any",
          "angle": 0
        }
      ],
      "style": {
        "background": "#fff9f5",
        "color": "#4c2e3f",
        "borderColor": "#d9aabd",
        "borderRadius": 18
      },
      "visible": true,
      "showLabel": true,
      "data": {
        "identity": {
          "graphId": "blusheree-showroom",
          "nodeId": "blusheree-origin-brief"
        },
        "content": {
          "kind": "html",
          "value": "<div style=\"box-sizing:border-box;container-type:inline-size;width:100%;height:100%;overflow:auto;background:linear-gradient(145deg,#fff9f5,#f8e7ec);color:#4c2e3f;border:2px solid #d9aabd;border-radius:18px;padding:clamp(24px,5cqw,44px);font-family:system-ui,-apple-system,Segoe UI,sans-serif\"><div style=\"font:900 13px/1.3 system-ui;letter-spacing:.16em;color:#985571\">01 / THE BRIEF</div><h2 style=\"font:500 clamp(28px,5cqw,42px)/1.15 Georgia,serif;letter-spacing:-.025em;margin:22px 0;color:#542d44\">Could you make something pretty?</h2><p style=\"font:400 clamp(16px,2.9cqw,23px)/1.6 system-ui;color:#63475a;margin:0\">Blusheree makes vinyl decals and stencils. With the owner watching, the request was to create a pretty Twilite graph for the business.</p><p style=\"font:600 14px/1.5 system-ui;color:#8d5272;border-top:1px solid #d7adbe;padding-top:18px;margin-top:24px\">A real brief, summarized from the originating conversation.</p></div>"
        }
      }
    },
    {
      "id": "blusheree-origin-direction",
      "type": "content",
      "label": "THE RESPONSE · A design direction",
      "position": {
        "x": 600,
        "y": 47
      },
      "width": 600,
      "height": 490,
      "ports": [
        {
          "id": "root",
          "label": "root",
          "direction": "bidirectional",
          "dataType": "any",
          "angle": 0
        }
      ],
      "style": {
        "background": "#fff9f5",
        "color": "#4c2e3f",
        "borderColor": "#d9aabd",
        "borderRadius": 18
      },
      "visible": true,
      "showLabel": true,
      "data": {
        "identity": {
          "graphId": "blusheree-showroom",
          "nodeId": "blusheree-origin-direction"
        },
        "content": {
          "kind": "html",
          "value": "<div style=\"box-sizing:border-box;container-type:inline-size;width:100%;height:100%;overflow:auto;background:linear-gradient(145deg,#fff9f5,#f8e7ec);color:#4c2e3f;border:2px solid #d9aabd;border-radius:18px;padding:clamp(24px,5cqw,44px);font-family:system-ui,-apple-system,Segoe UI,sans-serif\"><div style=\"font:900 13px/1.3 system-ui;letter-spacing:.16em;color:#985571\">02 / THE RESPONSE</div><h2 style=\"font:500 clamp(28px,5cqw,42px)/1.15 Georgia,serif;letter-spacing:-.025em;margin:22px 0;color:#542d44\">Make it a little boutique.</h2><p style=\"font:400 clamp(16px,2.9cqw,23px)/1.6 system-ui;color:#63475a;margin:0\">The proposed direction was a welcoming, blush-and-plum creative studio: a storefront, two collections, a sample wall, and an invitation to personalize something.</p><p style=\"font:600 14px/1.5 system-ui;color:#8d5272;border-top:1px solid #d7adbe;padding-top:18px;margin-top:24px\">A design interpretation, not a recorded client approval.</p></div>"
        }
      }
    },
