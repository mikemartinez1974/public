          "value": "<div style=\"container-type:inline-size;width:100%;height:100%;box-sizing:border-box;overflow:auto;background:linear-gradient(145deg,#fff8f3,#f8e1e7);border:1px solid #d8aabb;border-radius:3cqw;color:#4d2b40;padding:6cqw;font-family:system-ui\"><div style=\"font:800 2.9cqw system-ui;letter-spacing:.16em;color:#9c5878\">02 / THE COLLECTION</div><h2 style=\"font:600 8.3cqw/1.1 Georgia,serif;letter-spacing:-.035em;margin:3.5cqw 0 3cqw\">Stencils</h2><p style=\"font:400 4.15cqw/1.48 system-ui;margin:0;color:#67485a\">A pattern waiting to happen. Think clean lettering, repeating motifs and creative designs ready for your next project.</p><div style=\"margin-top:5cqw;padding-top:4cqw;border-top:1px solid #dfb6c4;font:600 3.3cqw/1.5 system-ui;color:#ae6b8b\">Ask about materials, sizes and available designs.</div></div>"
