        "content": {
          "kind": "svg",
          "value": "<svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 1280 520\" width=\"100%\" height=\"100%\" preserveAspectRatio=\"xMidYMid meet\" role=\"img\" aria-label=\"Illustrative Blusheree decal and stencil sample board\"><defs><pattern id=\"dot\" width=\"18\" height=\"18\" patternUnits=\"userSpaceOnUse\"><circle cx=\"4\" cy=\"4\" r=\"2\" fill=\"#e6b5c7\"/></pattern></defs><rect width=\"1280\" height=\"520\" fill=\"#f8e9e7\"/><rect width=\"1280\" height=\"520\" fill=\"url(#dot)\" opacity=\".5\"/><g transform=\"translate(65 55)\"><rect width=\"340\" height=\"410\" rx=\"25\" fill=\"#fffaf5\" stroke=\"#dfb4c4\" stroke-width=\"5\"/><text x=\"35\" y=\"46\" font-size=\"20\" fill=\"#955d79\" font-family=\"sans-serif\" letter-spacing=\"3\">VINYL LETTERING</text><text x=\"170\" y=\"204\" fill=\"#b36b8b\" font-family=\"Georgia,serif\" font-size=\"96\" font-style=\"italic\" text-anchor=\"middle\" transform=\"rotate(-8 170 204)\">hello</text><path d=\"M110 255q60 35 120 0\" fill=\"none\" stroke=\"#dba2b5\" stroke-width=\"7\" stroke-linecap=\"round\"/><text x=\"170\" y=\"363\" fill=\"#765264\" font-family=\"sans-serif\" font-size=\"18\" text-anchor=\"middle\">A LITTLE WORD, BIG FEELING</text></g><g transform=\"translate(470 55)\"><rect width=\"340\" height=\"410\" rx=\"25\" fill=\"#6d3653\" stroke=\"#dca7bd\" stroke-width=\"5\"/><text x=\"35\" y=\"46\" font-size=\"20\" fill=\"#f5d3d9\" font-family=\"sans-serif\" letter-spacing=\"3\">DECAL MOTIFS</text><g transform=\"translate(170 215)\" fill=\"#f9dde3\"><path d=\"M0-125c25 58 70 70 125 70-55 25-70 70-70 125-25-55-70-70-125-70 55-25 70-70 70-125z\"/><circle cx=\"-90\" cy=\"-80\" r=\"14\"/><circle cx=\"108\" cy=\"62\" r=\"10\"/><path d=\"M-100 70q-35-30-56 8q18 31 56 53q39-24 56-53q-22-38-56-8z\"/></g><text x=\"170\" y=\"363\" fill=\"#f2d7e0\" font-family=\"sans-serif\" font-size=\"18\" text-anchor=\"middle\">THE SMALL DETAILS</text></g><g transform=\"translate(875 55)\"><rect width=\"340\" height=\"410\" rx=\"25\"