    {
      "id": "blusheree-origin-brief",
      "type": "content",
      "label": "THE BRIEF · A conversation starts",
      "position": {
        "x": -96,
        "y": 47
      },
      "width": 600,
      "height": 490,
      "ports": [
        {
          "id": "root",
