      "data": {
        "name": "Death of Jeffrey Epstein",
        "eventKind": "death in federal custody",
        "summary": "Jeffrey Epstein was found unresponsive in his cell at the Metropolitan Correctional Center in New York and was pronounced dead on August 10, 2019. New York City’s medical examiner determined suicide by hanging. The DOJ Inspector General later documented numerous and serious failures by Bureau of Prisons personnel, while reporting that the FBI found no criminality pertaining to how he died.",
        "startDateTime": "2019-08-10",
        "endDateTime": "2019-08-10",
        "timeZone": "America/New_York",
        "allDay": true,
        "datePrecision": "day",
        "temporalStatus": "historically documented",
        "status": "completed",
        "locationSummary": "Metropolitan Correctional Center, New York, New York",
        "geographicScope": "Federal detention facility",
        "visibility": "public",
        "officialWebsite": "https://oig.justice.gov/reports/investigation-and-review-federal-bureau-prisons-custody-care-and-supervision-jeffrey",
