      "visible": true,
      "showLabel": true,
      "data": {
        "markdown": "# Initial Dependency Vocabulary\n\nRecommended first implementation:\n\n`text\ndeclaration\nport\nevent\nparticipation\nevent-phase\noutcome\nrole\nrelationship\nwork\nmedia\nclaim\nevidence\nsource\nquote\n`\n\nDeferred extension points:\n\n`text\nplace\nevent-series\nschedule-entry\ncondition\n`\n\nEvery included class should either already exist or have a corresponding node-class graph and bridge declaration.",
        "memo": "",
        "link": "",
        "visibilityRole": "browser",
        "_placement": {
          "version": 1,
          "state": "auto-placed",
