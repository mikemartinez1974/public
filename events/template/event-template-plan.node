      "visible": true,
      "showLabel": true,
      "data": {
        "markdown": "# ⚡ Event Template\n\nA declaration-first starter graph for representing things that happen.\n\nEvents connect persistent entities to change:\n\n- People participate in events.\n- Organizations host, cause, fund, oppose, or are changed by events.\n- Events occur at places and times.\n- Events produce decisions, works, media, claims, and consequences.\n\n> An event is a bounded occurrence or process involving participants, time, context, and change.",
        "memo": "",
        "link": "",
        "visibilityRole": "browser",
        "_placement": {
          "version": 1,
          "state": "auto-placed",
          "source": "create",
          "updatedAt": 1784479326280,
