        "html": "<article style=\"width:100%;height:100%;box-sizing:border-box;padding:20px;border-radius:20px;background:linear-gradient(135deg,#fef3c7,white);border:1px solid #b4530944;color:#172033;font-family:ui-sans-serif,system-ui,sans-serif;overflow:auto\"><img src=\"{{data.primaryImage}}\" alt=\"Image for {{data.name}}\" style=\"width:100%;height:150px;object-fit:cover;border-radius:14px;background:#fde68a\"/><div style=\"margin-top:14px;font-size:11px;font-weight:800;letter-spacing:.12em;text-transform:uppercase;color:#b45309\">{{data.eventKind}} · {{data.status}}</div><h2 style=\"margin:7px 0 8px;font-size:25px\">{{data.name}}</h2><div style=\"white-space:pre-wrap;line-height:1.55;color:#334155\">{{data.summary}}</div><div style=\"display:grid;grid-template-columns:132px 1fr;gap:10px;padding:7px 0;border-top:1px solid rgba(100,116,139,.14)\"><strong style=\"font-size:11px;letter-spacing:.06em;text-transform:uppercase;color:#64748b\">Start</strong><span style=\"font-size:13px;line-height:1.45;overflow-wrap:anywhere\">{{data.startDateTime}}</span></div><div style=\"display:grid;grid-template-columns:132px 1fr;gap:10px;padding:7px 0;border-top:1px solid rgba(100,116,139,.14)\"><strong style=\"font-size:11px;letter-spacing:.06em;text-transform:uppercase;color:#64748b\">End</strong><span style=\"font-size:13px;line-height:1.45;overflow-wrap:anywhere\">{{data.endDateTime}}</span></div><div style=\"display:grid;grid-template-columns:132px 1fr;gap:10px;padding:7px 0;border-top:1px solid rgba(100,116,139,.14)\"><strong style=\"font-size:11px;letter-spacing:.06em;text-transform:uppercase;color:#64748b\">Time zone</strong><span style=\"font-size:13px;line-height:1.45;overflow-wrap:anywhere\">{{data.timeZone}}</span></div><div style=\"display:grid;grid-template-columns:132px 1fr;gap:10px;padding:7px 0;border-top:1px solid rgba(100,116,139,.14)\"><strong style=\"font-size:11px;letter-spacing:.06em;text-transform:uppercase;color:#64748b\">All day</strong><span style=\"font-size:13px;line-height:1.45;overflow-wrap:anywhere\">{{data.allDay}}</span></div><div style=\"display:grid;grid-template-columns:132px 1fr;gap:10px;padding:7px 0;border-top:1px solid rgba(100,116,139,.14)\"><strong style=\"font-size:11px;letter-spacing:.06em;text-transform:uppercase;color:#64748b\">Precision</strong><span style=\"font-size:13px;line-height:1.45;overflow-wrap:anywhere\">{{data.datePrecision}}</span></div><div style=\"display:grid;grid-template-columns:132px 1fr;gap:10px;padding:7px 0;border-top:1px solid rgba(100,116,139,.14)\"><strong style=\"font-size:11px;letter-spacing:.06em;text-transform:uppercase;color:#64748b\">Temporal status</strong><span style=\"font-size:13px;line-height:1.45;overflow-wrap:anywhere\">{{data.temporalStatus}}</span></div><div style=\"display:grid;grid-template-columns:132px 1fr;gap:10px;padding:7px 0;border-top:1px solid rgba(100,116,139,.14)\"><strong style=\"font-size:11px;letter-spacing:.06em;text-transform:uppercase;color:#64748b\">Location</strong><span style=\"font-size:13px;line-height:1.45;overflow-wrap:anywhere\">{{data.locationSummary}}</span></div><div style=\"display:grid;grid-template-columns:132px 1fr;gap:10px;padding:7px 0;border-top:1px solid rgba(100,116,139,.14)\"><strong style=\"font-size:11px;letter-spacing:.06em;text-transform:uppercase;color:#64748b\">Geographic scope</strong><span style=\"font-size:13px;line-height:1.45;overflow-wrap:anywhere\">{{data.geographicScope}}</span></div><div style=\"display:grid;grid-template-columns:132px 1fr;gap:10px;padding:7px 0;border-top:1px solid rgba(100,116,139,.14)\"><strong style=\"font-size:11px;letter-spacing:.06em;text-transform:uppercase;color:#64748b\">Visibility</strong><span style=\"font-size:13px;line-height:1.45;overflow-wrap:anywhere\">{{data.visibility}}</span></div><div style=\"display:grid;grid-template-columns:132px 1fr;gap:10px;padding:7px 0;border-top:1px solid rgba(100,116,139,.14)\"><strong style=\"font-size:11px;letter-spacing:.06em;text-transform:uppercase;color:#64748b\">Official website</strong><span style=\"font-size:13px;line-height:1.45;overflow-wrap:anywhere\"><a href=\"{{data.officialWebsite}}\" target=\"_blank\" rel=\"noopener noreferrer\" style=\"color:#2563eb;font-weight:700;text-decoration:underline\">Open link ↗</a><div style=\"font-size:11px;color:#64748b;margin-top:3px\">{{data.officialWebsite}}</div></span></div><div style=\"display:grid;grid-template-columns:132px 1fr;gap:10px;padding:7px 0;border-top:1px solid rgba(100,116,139,.14)\"><strong style=\"font-size:11px;letter-spacing:.06em;text-transform:uppercase;color:#64748b\">Primary image</strong><span style=\"font-size:13px;line-height:1.45;overflow-wrap:anywhere\"><a href=\"{{data.primaryImage}}\" target=\"_blank\" rel=\"noopener noreferrer\" style=\"color:#2563eb;font-weight:700;text-decoration:underline\">Open link ↗</a><div style=\"font-size:11px;color:#64748b;margin-top:3px\">{{data.primaryImage}}</div></span></div></article>"
