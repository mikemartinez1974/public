        "html": "<article style=\"width:100%;height:100%;box-sizing:border-box;padding:20px;border-radius:20px;background:linear-gradient(135deg,#e0f2fe,white);border:1px solid #0369a144;color:#172033;font-family:ui-sans-serif,system-ui,sans-serif;overflow:auto\"><div style=\"font-size:11px;font-weight:800;letter-spacing:.12em;text-transform:uppercase;color:#0369a1\">{{data.phaseKind}}</div><h2 style=\"margin:8px 0 12px;font-size:24px\">{{data.name}}</h2><div style=\"display:grid;grid-template-columns:132px 1fr;gap:10px;padding:7px 0;border-top:1px solid rgba(100,116,139,.14)\"><strong style=\"font-size:11px;letter-spacing:.06em;text-transform:uppercase;color:#64748b\">Sequence</strong><span style=\"font-size:13px;line-height:1.45;overflow-wrap:anywhere\">{{data.sequence}}</span></div><div style=\"display:grid;grid-template-columns:132px 1fr;gap:10px;padding:7px 0;border-top:1px solid rgba(100,116,139,.14)\"><strong style=\"font-size:11px;letter-spacing:.06em;text-transform:uppercase;color:#64748b\">Start Date Time</strong><span style=\"font-size:13px;line-height:1.45;overflow-wrap:anywhere\">{{data.startDateTime}}</span></div><div style=\"display:grid;grid-template-columns:132px 1fr;gap:10px;padding:7px 0;border-top:1px solid rgba(100,116,139,.14)\"><strong style=\"font-size:11px;letter-spacing:.06em;text-transform:uppercase;color:#64748b\">End Date Time</strong><span style=\"font-size:13px;line-height:1.45;overflow-wrap:anywhere\">{{data.endDateTime}}</span></div><div style=\"display:grid;grid-template-columns:132px 1fr;gap:10px;padding:7px 0;border-top:1px solid rgba(100,116,139,.14)\"><strong style=\"font-size:11px;letter-spacing:.06em;text-transform:uppercase;color:#64748b\">Summary</strong><span style=\"font-size:13px;line-height:1.45;overflow-wrap:anywhere\">{{data.summary}}</span></div><div style=\"display:grid;grid-template-columns:132px 1fr;gap:10px;padding:7px 0;border-top:1px solid rgba(100,116,139,.14)\"><strong style=\"font-size:11px;letter-spacing:.06em;text-transform:uppercase;color:#64748b\">Status</strong><span style=\"font-size:13px;line-height:1.45;overflow-wrap:anywhere\">{{data.status}}</span></div><div style=\"display:grid;grid-template-columns:132px 1fr;gap:10px;padding:7px 0;border-top:1px solid rgba(100,116,139,.14)\"><strong style=\"font-size:11px;letter-spacing:.06em;text-transform:uppercase;color:#64748b\">Parent Event Ref</strong><span style=\"font-size:13px;line-height:1.45;overflow-wrap:anywhere\">{{data.parentEventRef}}</span></div></article>"
