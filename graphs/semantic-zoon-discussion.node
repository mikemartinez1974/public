        "_classBinding": {
          "key": "qa-caveat",
          "sourceRef": "github://mikemartinez1974/public/templates/question-driven-explanation-template/classes/nodes/qa-caveat.node-class.node",
          "ref": "github://mikemartinez1974/public/templates/question-driven-explanation-template/classes/nodes/qa-caveat.node-class.node"
        },
        "title": "Do Not Hide Policy in Renderers",
        "caveat": "A centralized resolver only helps if node renderers stop making independent semantic zoom decisions. Local renderers can decide how their overview, summary, or detail presentation looks, but they should not quietly redefine when those modes activate.",
        "severity": "important",
        "mitigation": "Keep thresholds and transition rules in one resolver or shared configuration. Pass a resolved semantic band into renderers and test the resolver independently from visual components.",
        "notes": "Node-specific exceptions may eventually be legitimate, but they should be explicit overrides rather than accidental threshold drift.",
        "memo": "",
        "link": "",
        "visibilityRole": "browser",
        "_placement": {
          "version": 1,
          "state": "auto-placed",
          "source": "create",
