        "_classBinding": {
          "key": "qa-answer",
          "sourceRef": "github://mikemartinez1974/public/templates/question-driven-explanation-template/classes/nodes/qa-answer.node-class.node",
          "ref": "github://mikemartinez1974/public/templates/question-driven-explanation-template/classes/nodes/qa-answer.node-class.node"
        },
        "title": "Stable Boundaries",
        "answer": "Without hysteresis, a scale hovering around one threshold can make the UI flap between two render states. Hysteresis gives entering and leaving a band different thresholds. That creates a small dead zone where the current band is retained, so tiny wheel, trackpad, animation, or floating-point changes do not cause visual flicker.",
        "confidence": "high",
        "summary": "Hysteresis makes semantic zoom sticky at the boundary.",
        "notes": "",
        "memo": "",
        "link": "",
        "visibilityRole": "browser",
        "_placement": {
          "version": 1,
          "state": "auto-placed",
          "source": "create",
          "updatedAt": 1786409715166,
          "reason": "node-batch-create"
        }
      }
