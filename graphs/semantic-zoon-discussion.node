          "key": "qa-answer",
          "sourceRef": "github://mikemartinez1974/public/templates/question-driven-explanation-template/classes/nodes/qa-answer.node-class.node",
          "ref": "github://mikemartinez1974/public/templates/question-driven-explanation-template/classes/nodes/qa-answer.node-class.node"
        },
        "title": "One Authority for Zoom Semantics",
        "answer": "One place becomes authoritative for interpreting scale. Instead of each node type deciding independently when to show icons, summaries, controls, labels, or full detail, the resolver maps viewport scale plus prior state to a named semantic band. That prevents threshold drift and gives the renderer tree one stable semantic input.",
        "confidence": "high",
        "summary": "Centralize the decision; decentralize the drawing.",
        "notes": "",
        "memo": "",
        "link": "",
        "visibilityRole": "browser",
        "_placement": {
          "version": 1,
          "state": "auto-placed",
          "source": "create",
          "updatedAt": 1786409715166,
          "reason": "node-batch-create"
        }
      }
    },
