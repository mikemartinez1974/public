          "key": "qa-example",
          "sourceRef": "github://mikemartinez1974/public/templates/question-driven-explanation-template/classes/nodes/qa-example.node-class.node",
          "ref": "github://mikemartinez1974/public/templates/question-driven-explanation-template/classes/nodes/qa-example.node-class.node"
        },
        "title": "Illustrative Three-Band Policy",
        "example": "Bands: overview, summary, detail. Starting in overview, remain there until scale ≥ 0.75. In summary, return to overview only when scale ≤ 0.50 and enter detail only when scale ≥ 1.30. In detail, return to summary only when scale ≤ 1.20. A scale wobbling between 0.54 and 0.58 therefore remains in whichever neighboring band it already occupied instead of flickering.",
        "relevance": "The overlapping enter and exit thresholds show hysteresis directly. The resolver needs previousBand because the same scale can legitimately resolve differently depending on which side of the boundary the user came from.",
        "notes": "Thresholds are illustrative, not proposed final Twilite values.",
        "memo": "",
        "link": "",
        "visibilityRole": "browser",
        "_placement": {
          "version": 1,
          "state": "auto-placed",
          "source": "create",
          "updatedAt": 1786409715166,
          "reason": "node-batch-create"
        }
      }
    },
