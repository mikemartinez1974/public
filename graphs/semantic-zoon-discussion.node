        "_classBinding": {
          "key": "qa-summary",
          "sourceRef": "github://mikemartinez1974/public/templates/question-driven-explanation-template/classes/nodes/qa-summary.node-class.node",
          "ref": "github://mikemartinez1974/public/templates/question-driven-explanation-template/classes/nodes/qa-summary.node-class.node"
        },
        "title": "Implementation Shape",
        "synthesis": "Codex's ordering makes sense: first create one authoritative function that converts scale plus previous semantic state into a stable zoom band. Add hysteresis there so band transitions resist boundary noise. Then make the graph or editor compute that band once and let individual node renderers consume it. The result is a semantic zoom system with one brain and many eyes.",
        "keyPoints": "1. Raw scale is continuous; semantic bands are discrete.\n2. Hysteresis uses different enter and exit thresholds.\n3. Previous band is part of the resolver input.\n4. Resolve once, then pass the band downward.\n5. Migrate renderers after the contract exists.\n6. Renderer-specific visuals can vary without renderer-specific thresholds.",
        "openQuestions": "How many semantic bands does Twilite actually need?\nWhere should resolvedBand live: editor state, render context, or viewport state?\nShould thresholds be global, graph-configurable, or configuration driven?\nDo edges, labels, controls, and node bodies share exactly the same bands?",
        "notes": "A small resolver creates a clean seam for later semantic-zoom tuning and tests.",
        "memo": "",
        "link": "",
        "visibilityRole": "browser",
        "_placement": {
          "version": 1,
          "state": "auto-placed",
          "source": "create",
          "updatedAt": 1786409715166,
          "reason": "node-batch-create"
        }
      }
    }
