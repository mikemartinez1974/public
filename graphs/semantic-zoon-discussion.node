        "_classBinding": {
          "key": "qa-answer",
          "sourceRef": "github://mikemartinez1974/public/templates/question-driven-explanation-template/classes/nodes/qa-answer.node-class.node",
          "ref": "github://mikemartinez1974/public/templates/question-driven-explanation-template/classes/nodes/qa-answer.node-class.node"
        },
        "title": "Scale + Previous Band → Next Band",
        "answer": "Give the resolver the current scale and the previous band. It returns the next band. An illustrative policy might let overview enter summary at 0.60 while summary does not fall back to overview until 0.50. Summary might enter detail at 1.30 while detail does not fall back until 1.20. The exact values are tunable. The important contract is resolveZoomBand(scale, previousBand) → band.",
        "confidence": "high",
        "summary": "Use previous state plus asymmetric thresholds.",
        "notes": "",
        "memo": "",
        "link": "",
        "visibilityRole": "browser",
        "_placement": {
          "version": 1,
          "state": "auto-placed",
          "source": "create",
          "updatedAt": 1786409715166,
          "reason": "node-batch-create"
        }
      }
