        }
      ],
      "data": {
        "content": {
          "kind": "markdown",
          "value": "# Content\n\nA Content node holds one piece of material: some writing, a drawing, a picture, a block of data. It does not decide how that material looks. A face shows it, and several faces can show the same Content in different ways, so you change it in one place.\n\nEach Content node has a **kind** that says what sort of material it is: markdown, html, svg, text, json or image."
        },
        "interfaceContract": {
          "version": 1,
          "receivesViewContent": true
        },
        "identity": {
          "graphId": "content-tutorial-draft",
          "nodeId": "content-tutorial-draft-landing"
        }
      }
    },
