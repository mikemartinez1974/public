      "data": {
        "identity": { "nodeId": "interface-frame-smoke", "graphId": "interface-frame-smoke" },
        "intent": { "kind": "smoke-test", "scope": "graph-lab" },
        "declaration": {
          "kind": "graph",
          "targetMode": "artifact",
          "artifactKind": "smoke-test",
          "interfaceFrame": { "shape": "rounded-rectangle", "aspectRatio": 1.6153846153846154 },
          "surfaces": [
