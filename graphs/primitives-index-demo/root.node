          "payload": "node.web.detail"
        },
        "semanticLevel": "detail",
        "content": {
          "kind": "html",
          "value": "<div style='width:100%;min-height:100%;box-sizing:border-box;container-type:inline-size;background:#ffffff;font-family:Newsreader,Iowan Old Style,Palatino Linotype,Book Antiqua,Georgia,serif;color:#0f172a'><div style='box-sizing:border-box;max-width:900px;margin:0 auto;padding:0 clamp(20px,5cqw,40px) 64px'><div style='padding-top:32px'><header data-role='masthead'><div style='padding:10px 0;border-top:3px solid #0f172a;border-bottom:1px solid #0f172a;font:800 12px/16px system-ui;letter-spacing:.18em;text-transform:uppercase;color:#6d28d9'>TWILITE ZONE · LIBRARY</div><h1 style='margin:40px 0 0;font:500 clamp(40px,9.5cqw,72px)/.98 Newsreader,Iowan Old Style,Palatino Linotype,Book Antiqua,Georgia,serif;letter-spacing:-.025em;text-wrap:balance;color:#0f172a'>Primitives</h1><p style='margin:18px 0 0;max-width:36ch;font:italic 400 clamp(20px,3.6cqw,26px)/1.35 Newsreader,Iowan Old Style,Palatino Linotype,Book Antiqua,Georgia,serif;color:#475569'>The sixteen parts every graph is made of. Each has a page that says what it means, what it must do, and where it lives.</p></header></div><div style='padding-top:44px'><section data-role='district' style='padding:18px 0 8px;border-top:1px solid #0f172a;display:flex;flex-wrap:wrap;gap:12px 24px'><h2 style='flex:0 0 120px;margin:4px 0 0;font:800 12px/16px system-ui;letter-spacing:.18em;text-transform:uppercase;color:#0f172a'>Identity</h2><div style='flex:1 1 380px;min-width:0'><a data-role='route' href='tlz://twilite.zone/library/primitives/declaration/root.node' style='display:block;padding:0 0 14px;text-decoration:none;color:#0f172a'><span style='display:block;font:500 22px/1.15 Newsreader,Iowan Old Style,Palatino Linotype,Book Antiqua,Georgia,serif;letter-spacing:-.01em;color:#0f172a'>Declaration →</span><span style='display:block;margin-top:4px;font:400 14px/1.55 system-ui;color:#475569'>The contract that gives a graph its identity and says what it exposes.</span></a><a data-role='route' href='tlz://twilite.zone/library/primitives/specification/root.node' style='display:block;padding:14px 0 14px;border-top:1px solid #cbd5e1;text-decoration:none;color:#0f172a'><span style='display:block;font:500 22px/1.15 Newsreader,Iowan Old Style,Palatino Linotype,Book Antiqua,Georgia,serif;letter-spacing:-.01em;color:#0f172a'>Specification Form →</span><span style='display:block;margin-top:4px;font:400 14px/1.55 system-ui;color:#475569'>The form every primitive’s specification follows.</span></a></div></section></div><div style='padding-top:0px'><section data-role='district' style='padding:18px 0 8px;border-top:1px solid #0f172a;display:flex;flex-wrap:wrap;gap:12px 24px'><h2 style='flex:0 0 120px;margin:4px 0 0;font:800 12px/16px system-ui;letter-spacing:.18em;text-transform:uppercase;color:#0f172a'>Showing</h2><div style='flex:1 1 380px;min-width:0'><a data-role='route' href='tlz://twilite.zone/library/primitives/surface/root.node' style='display:block;padding:0 0 14px;text-decoration:none;color:#0f172a'><span style='display:block;font:500 22px/1.15 Newsreader,Iowan Old Style,Palatino Linotype,Book Antiqua,Georgia,serif;letter-spacing:-.01em;color:#0f172a'>Surface →</span><span style='display:block;margin-top:4px;font:400 14px/1.55 system-ui;color:#475569'>A named track of Views for showing a node or graph in one setting.</span></a><a data-role='route' href='tlz://twilite.zone/library/primitives/view/root.node' style='display:block;padding:14px 0 14px;border-top:1px solid #cbd5e1;text-decoration:none;color:#0f172a'><span style='display:block;font:500 22px/1.15 Newsreader,Iowan Old Style,Palatino Linotype,Book Antiqua,Georgia,serif;letter-spacing:-.01em;color:#0f172a'>View →</span><span style='display:block;margin-top:4px;font:400 14px/1.55 system-ui;color:#475569'>One way of drawing a node or graph.</span></a><a data-role='route' href='tlz://twilite.zone/library/primitives/glyph/root.node' style='display:block;padding:14px 0 14px;border-top:1px solid #cbd5e1;text-decoration:none;color:#0f172a'><span style='display:block;font:500 22px/1.15 Newsreader,Iowan Old Style,Palatino Linotype,Book Antiqua,Georgia,serif;letter-spacing:-.01em;color:#0f172a'>Glyph →</span><span style='display:block;margin-top:4px;font:400 14px/1.55 system-ui;color:#475569'>The small mark that stands for a node or graph, and the last step of a Surface.</span></a><a data-role='route' href='tlz://twilite.zone/library/primitives/content/root.node' style='display:block;padding:14px 0 14px;border-top:1px solid #cbd5e1;text-decoration:none;color:#0f172a'><span style='display:block;font:500 22px/1.15 Newsreader,Iowan Old Style,Palatino Linotype,Book Antiqua,Georgia,serif;letter-spacing:-.01em;color:#0f172a'>Content →</span><span style='display:block;margin-top:4px;font:400 14px/1.55 system-ui;color:#475569'>Durable material that a View, or any other reader, can show.</span></a></div></section></div><div style='padding-top:0px'><section data-role='district' style='padding:18px 0 8px;border-top:1px solid #0f172a;display:flex;flex-wrap:wrap;gap:12px 24px'><h2 style='flex:0 0 120px;margin:4px 0 0;font:800 12px/16px system-ui;letter-spacing:.18em;text-transform:uppercase;color:#0f172a'>Boundaries</h2><div style='flex:1 1 380px;min-width:0'><a data-role='route' href='tlz://twilite.zone/library/primitives/membrane/root.node' style='display:block;padding:0 0 14px;text-decoration:none;color:#0f172a'><span style='display:block;font:500 22px/1.15 Newsreader,Iowan Old Style,Palatino Linotype,Book Antiqua,Georgia,serif;letter-spacing:-.01em;color:#0f172a'>Membrane →</span><span style='display:block;margin-top:4px;font:400 14px/1.55 system-ui;color:#475569'>The boundary of a graph: what it contains and where its ports sit.</span></a><a data-role='route' href='tlz://twilite.zone/library/primitives/port/root.node' style='display:block;padding:14px 0 14px;border-top:1px solid #cbd5e1;text-decoration:none;color:#0f172a'><span style='display:block;font:500 22px/1.15 Newsreader,Iowan Old Style,Palatino Linotype,Book Antiqua,Georgia,serif;letter-spacing:-.01em;color:#0f172a'>Port →</span><span style='display:block;margin-top:4px;font:400 14px/1.55 system-ui;color:#475569'>A named, public connection point on a node or graph.</span></a><a data-role='route' href='tlz://twilite.zone/library/primitives/portal/root.node' style='display:block;padding:14px 0 14px;border-top:1px solid #cbd5e1;text-decoration:none;color:#0f172a'><span style='display:block;font:500 22px/1.15 Newsreader,Iowan Old Style,Palatino Linotype,Book Antiqua,Georgia,serif;letter-spacing:-.01em;color:#0f172a'>Portal →</span><span style='display:block;margin-top:4px;font:400 14px/1.55 system-ui;color:#475569'>An opening from one graph into another graph’s interface.</span></a><a data-role='route' href='tlz://twilite.zone/library/primitives/bridge/root.node' style='display:block;padding:14px 0 14px;border-top:1px solid #cbd5e1;text-decoration:none;color:#0f172a'><span style='display:block;font:500 22px/1.15 Newsreader,Iowan Old Style,Palatino Linotype,Book Antiqua,Georgia,serif;letter-spacing:-.01em;color:#0f172a'>Bridge →</span><span style='display:block;margin-top:4px;font:400 14px/1.55 system-ui;color:#475569'>The stated boundary where one graph draws on another.</span></a></div></section></div><div style='padding-top:0px'><section data-role='district' style='padding:18px 0 8px;border-top:1px solid #0f172a;display:flex;flex-wrap:wrap;gap:12px 24px'><h2 style='flex:0 0 120px;margin:4px 0 0;font:800 12px/16px system-ui;letter-spacing:.18em;text-transform:uppercase;color:#0f172a'>Relationships</h2><div style='flex:1 1 380px;min-width:0'><a data-role='route' href='tlz://twilite.zone/library/primitives/edge/root.node' style='display:block;padding:0 0 14px;text-decoration:none;color:#0f172a'><span style='display:block;font:500 22px/1.15 Newsreader,Iowan Old Style,Palatino Linotype,Book Antiqua,Georgia,serif;letter-spacing:-.01em;color:#0f172a'>Edge →</span><span style='display:block;margin-top:4px;font:400 14px/1.55 system-ui;color:#475569'>One relationship between two endpoints in a graph.</span></a><a data-role='route' href='tlz://twilite.zone/library/primitives/edge-class/root.node' style='display:block;padding:14px 0 14px;border-top:1px solid #cbd5e1;text-decoration:none;color:#0f172a'><span style='display:block;font:500 22px/1.15 Newsreader,Iowan Old Style,Palatino Linotype,Book Antiqua,Georgia,serif;letter-spacing:-.01em;color:#0f172a'>Edge Class →</span><span style='display:block;margin-top:4px;font:400 14px/1.55 system-ui;color:#475569'>The definition of a kind of relationship: what it means and where it may connect.</span></a><a data-role='route' href='tlz://twilite.zone/library/primitives/field/root.node' style='display:block;padding:14px 0 14px;border-top:1px solid #cbd5e1;text-decoration:none;color:#0f172a'><span style='display:block;font:500 22px/1.15 Newsreader,Iowan Old Style,Palatino Linotype,Book Antiqua,Georgia,serif;letter-spacing:-.01em;color:#0f172a'>Field →</span><span style='display:block;margin-top:4px;font:400 14px/1.55 system-ui;color:#475569'>A named value stored in a graph.</span></a></div></section></div><div style='padding-top:0px'><section data-role='district' style='padding:18px 0 8px;border-top:1px solid #0f172a;border-bottom:1px solid #0f172a;display:flex;flex-wrap:wrap;gap:12px 24px'><h2 style='flex:0 0 120px;margin:4px 0 0;font:800 12px/16px system-ui;letter-spacing:.18em;text-transform:uppercase;color:#0f172a'>Behavior</h2><div style='flex:1 1 380px;min-width:0'><a data-role='route' href='tlz://twilite.zone/library/primitives/method/root.node' style='display:block;padding:0 0 14px;text-decoration:none;color:#0f172a'><span style='display:block;font:500 22px/1.15 Newsreader,Iowan Old Style,Palatino Linotype,Book Antiqua,Georgia,serif;letter-spacing:-.01em;color:#0f172a'>Method →</span><span style='display:block;margin-top:4px;font:400 14px/1.55 system-ui;color:#475569'>Behavior a graph can invoke, with its effects declared.</span></a><a data-role='route' href='tlz://twilite.zone/library/primitives/script/root.node' style='display:block;padding:14px 0 14px;border-top:1px solid #cbd5e1;text-decoration:none;color:#0f172a'><span style='display:block;font:500 22px/1.15 Newsreader,Iowan Old Style,Palatino Linotype,Book Antiqua,Georgia,serif;letter-spacing:-.01em;color:#0f172a'>Script →</span><span style='display:block;margin-top:4px;font:400 14px/1.55 system-ui;color:#475569'>Executable source, and how it is loaded and run.</span></a><a data-role='route' href='tlz://twilite.zone/library/primitives/event-handler/root.node' style='display:block;padding:14px 0 14px;border-top:1px solid #cbd5e1;text-decoration:none;color:#0f172a'><span style='display:block;font:500 22px/1.15 Newsreader,Iowan Old Style,Palatino Linotype,Book Antiqua,Georgia,serif;letter-spacing:-.01em;color:#0f172a'>Event Handler →</span><span style='display:block;margin-top:4px;font:400 14px/1.55 system-ui;color:#475569'>A subscription that runs Methods when a named event fires.</span></a></div></section></div><div style='padding-top:48px'><section data-role='settings' style='padding-top:10px;border-top:3px solid #0f172a'><h2 style='margin:0 0 14px;font:800 12px/16px system-ui;letter-spacing:.18em;text-transform:uppercase;color:#0f172a'>About this page</h2><dl style='margin:0;display:grid;grid-template-columns:max-content 1fr;column-gap:12px;border-bottom:1px solid #cbd5e1'><dt style='grid-column:1/-1;padding:9px 0 0px;border-top:1px solid #cbd5e1;font:400 13px/20px system-ui;color:#475569'>Address</dt><dd style='grid-column:1/-1;margin:0;padding:2px 0 9px;font:600 14px/20px system-ui;color:#0f172a;overflow-wrap:anywhere'>tlz://twilite.zone/library/primitives/root.node</dd><dt style='padding:9px 0 9px;border-top:1px solid #cbd5e1;font:400 13px/20px system-ui;color:#475569'>Primitives</dt><dd style='margin:0;padding:9px 0;border-top:1px solid #cbd5e1;text-align:right;font:600 14px/20px system-ui;color:#0f172a;overflow-wrap:anywhere'>16</dd><dt style='grid-column:1/-1;padding:9px 0 0px;border-top:1px solid #cbd5e1;font:400 13px/20px system-ui;color:#475569'>Made from</dt><dd style='grid-column:1/-1;margin:0;padding:2px 0 9px;font:600 14px/20px system-ui;color:#0f172a;overflow-wrap:anywhere'>The Page Template, through one Bridge</dd></dl></section></div></div></div>"
        },
