    {
      "id": "assemble-page-method",
      "type": "method",
      "label": "Assemble the page",
      "root": false,
      "position": {
        "x": 2680,
        "y": 1380
      },
      "width": 420,
      "height": 260,
      "ports": [
        {
          "id": "call",
          "key": "call",
          "label": "Call",
          "direction": "input",
          "dataType": "event",
          "angle": 180
        },
        {
          "id": "result",
          "key": "result",
          "label": "Result",
          "direction": "output",
          "dataType": "value",
          "angle": 0
        }
      ],
      "handles": [
        {
          "id": "call",
          "key": "call",
          "label": "Call",
          "direction": "input",
          "dataType": "event",
          "angle": 180,
          "portId": "call"
        },
        {
          "id": "result",
          "key": "result",
          "label": "Result",
          "direction": "output",
          "dataType": "value",
          "angle": 0,
          "portId": "result"
        }
      ],
      "visible": true,
      "showLabel": true,
      "data": {
        "scriptName": "Assemble the page",
        "parameters": [],
        "source": "// Assembles the page from its pieces and writes it into the views the Declaration exposes.\n// Every piece class has a change Handler, and the graph structure has one, and all of them call this Method,\n// so the stored page is always current. It reads the pieces in graph order and writes only the three\n// exposed views, which its declared effects say.\nconst ROLES = ['page-masthead', 'page-route', 'page-section', 'page-settings'];\n\nconst clean = (value) => String(value ?? '').trim();\nconst escapeHtml = (value) => clean(value)\n  .replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/\"/g, '&quot;').replace(/'/g, '&#39;');\n// Rows are { label, value } pairs, or \"label: value\" lines.\nconst settingRows = (rows) => (Array.isArray(rows) ? rows : []).map((row) => {\n  if (row && typeof row === 'object') return [clean(row.label), clean(row.value)];\n  const text = clean(row);\n  const cut = text.indexOf(':');\n  return cut < 0 ? [text, ''] : [clean(text.slice(0, cut)), clean(text.slice(cut + 1))];\n}).filter(([name, value]) => name || value);\nconst roleOf = (node) => clean(node?.data?.definitionKey || node?.type);\n\n// --- How the page looks ------------------------------------------------------------------------\n// The page reads as an article. Inline styles only, attributes in single quotes, font names unquoted, and\n// every fluid size taken from the view's own width (cqw), because a View may be drawn at any size.\nconst SERIF = 'Newsreader,Iowan Old Style,Palatino Linotype,Book Antiqua,Georgia,serif';\nconst ACCENT = '#6d28d9';\nconst KICKER = 'font:800 12px/16px system-ui;letter-spacing:.18em;text-transform:uppercase';\n// Escapes without trimming, for the rest of a paragraph after its first letter has been lifted out.\nconst escapeText = (value) => String(value ?? '')\n  .replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/\"/g, '&quot;').replace(/'/g, '&#39;');\nconst kicker = (text, color = ACCENT) => `<h2 style='margin:0 0 14px;${KICKER};color:${color}'>${escapeHtml(text)}</h2>`;\n// Body text. Paragraphs, bullet lists (one level of nesting), fenced code blocks and sub-headings, with `code` and\n// **bold** inside a line. Everything authored is escaped first; only these few marks become markup. The first\n// paragraph of the page's first section opens with a drop cap, when the section starts with a letter.\nconst MONO = 'ui-monospace,SFMono-Regular,Menlo,Consolas,monospace';\nconst inlineText = (value) => escapeText(value)\n  .replace(/`([^`]+)`/g, (_, code) => `<code style='padding:1px 4px;border-radius:3px;background:#f1f5f9;font:400 .84em ${MONO};overflow-wrap:anywhere'>${code}</code>`)\n  .replace(/\\*\\*([^*]+)\\*\\*/g, '<strong>$1</strong>')\n  .replace(/\\[([^\\]]+)\\]\\(((?:tlz|https|github):\\/\\/[^\\s)]+)\\)/g, (_, words, address) => `<a href='${address}' style='color:${ACCENT};text-decoration:underline'>${words}</a>`);\nconst bodyBlocks = (value) => {\n  const lines = String(value ?? '').replace(/\\r\\n/g, '\\n').split('\\n');\n  const blocks = [];\n  let paragraph = [];\n  let afterBlank = true;\n  const flush = () => { if (paragraph.length) blocks.push({ kind: 'p', text: paragraph.join('\\n') }); paragraph = []; };\n  for (let index = 0; index < lines.length; index += 1) {\n    const line = lines[index];\n    if (/^```/.test(line.trim())) {\n      flush();\n      const code = [];\n      index += 1;\n      while (index < lines.length && !/^```/.test(lines[index].trim())) { code.push(lines[index]); index += 1; }\n      blocks.push({ kind: 'code', text: code.join('\\n') });\n      afterBlank = true;\n      continue;\n    }\n    if (!line.trim()) { flush(); afterBlank = true; continue; }\n    const heading = /^#{2,4} +(.+)$/.exec(line.trim());\n    if (heading) { flush(); blocks.push({ kind: 'h', text: heading[1] }); afterBlank = true; continue; }\n    const item = /^(\\s*)[-*] +(.*)$/.exec(line);\n    const last = blocks[blocks.length - 1];\n    if (item) {\n      flush();\n      const list = last?.kind === 'list' && !afterBlank ? last : null;\n      const entry = { text: item[2], children: [] };\n      if (list && item[1].length >= 2 && list.items.length) list.items[list.items.length - 1].children.push(entry);\n      else if (list) list.items.push(entry);\n      else blocks.push({ kind: 'list', items: [entry] });\n      afterBlank = false;\n      continue;\n    }\n    // A line that follows a list item without a blank line between continues that item.\n    if (last?.kind === 'list' && !afterBlank && !paragraph.length) {\n      const owner = last.items[last.items.length - 1];\n      const target = owner.children.length ? owner.children[owner.children.length - 1] : owner;\n      target.text += ` ${line.trim()}`;\n      continue;\n    }\n    paragraph.push(line.trim());\n    afterBlank = false;\n  }\n  flush();\n  return blocks;\n};\nconst listMarkup = (items, nested) => `<ul style='margin:${nested ? '6px 0 0' : '0 0 14px'};padding-left:22px;${nested ? '' : `max-width:60ch;font:400 18px/1.55 ${SERIF};color:#1e293b`}'>`\n  + items.map((item) => `<li style='margin:0 0 6px'>${inlineText(item.text)}${item.children.length ? listMarkup(item.children, true) : ''}</li>`).join('')\n  + `</ul>`;\nconst bodyText = (value, dropCap) => bodyBlocks(value).map((block, index) => {\n  if (block.kind === 'code') return `<pre style='margin:0 0 16px;padding:14px 16px;overflow-x:auto;white-space:pre;background:#f1f5f9;border-left:3px solid ${ACCENT};font:400 13px/1.55 ${MONO};color:#0f172a'>${escapeText(block.text)}</pre>`;\n  if (block.kind === 'h') return `<h3 style='margin:22px 0 8px;font:700 15px/20px system-ui;color:#0f172a'>${inlineText(block.text)}</h3>`;\n  if (block.kind === 'list') return listMarkup(block.items, false);\n  const cap = dropCap && index === 0 && /^[A-Za-z]/.test(block.text);\n  return `<p style='margin:0 0 14px;max-width:60ch;font:400 19px/1.6 ${SERIF};color:#1e293b'>`\n    + (cap ? `<span style='float:left;padding:6px 10px 0 0;font:500 68px/54px ${SERIF};color:#0f172a'>${block.text[0]}</span>` : '')\n    + `${inlineText(cap ? block.text.slice(1) : block.text).replace(/\\n/g, '<br>')}</p>`;\n}).join('');\n\n// --- One renderer per role: what that piece contributes ------------------------------------------\nconst RENDER = {\n  // The eyebrow is the nameplate, the title the headline, the subtitle the standfirst.\n  'page-masthead': (data) => `<header data-role='masthead'>`\n    + `<div style='padding:${clean(data.eyebrow) ? '10px 0' : '0'};border-top:3px solid #0f172a;${clean(data.eyebrow) ? 'border-bottom:1px solid #0f172a;' : ''}${KICKER};color:${ACCENT}'>${escapeHtml(data.eyebrow)}</div>`\n    + `<h1 style='margin:40px 0 0;font:500 clamp(40px,9.5cqw,72px)/.98 ${SERIF};letter-spacing:-.025em;text-wrap:balance;color:#0f172a'>${escapeHtml(data.title)}</h1>`\n    + (clean(data.subtitle) ? `<p style='margin:18px 0 0;max-width:36ch;font:italic 400 clamp(20px,3.6cqw,26px)/1.35 ${SERIF};color:#475569'>${escapeHtml(data.subtitle)}</p>` : '')\n    + `</header>`,\n  // A teaser: a rule, a title, a line or two, and where it leads. A primary route is drawn heavier.\n  'page-route': (data) => {\n    const primary = clean(data.prominence).toLowerCase() !== 'secondary';\n    return `<section data-role='route' data-prominence='${primary ? 'primary' : 'secondary'}' style='height:100%;box-sizing:border-box;display:flex;flex-direction:column;`\n      + `${primary ? `padding-top:12px;border-top:3px solid ${ACCENT}` : 'padding-top:14px;border-top:1px solid #0f172a'}'>`\n      + `<h2 style='margin:0 0 8px;font:500 ${primary ? 26 : 22}px/1.1 ${SERIF};letter-spacing:-.01em;color:#0f172a'>${escapeHtml(data.title)}</h2>`\n      + (clean(data.body) ? `<p style='margin:0 0 10px;font:400 14px/1.55 system-ui;color:#475569'>${escapeHtml(data.body)}</p>` : '')\n      + `<div style='margin-top:auto;font:700 13px/20px system-ui;color:${primary ? ACCENT : '#475569'}'>${escapeHtml(data.destinationLabel || 'Open')} →</div></section>`;\n  },\n  // A ruled list. A short value sits beside its name; a long one runs underneath at the full width of the list.\n  'page-settings': (data) => `<section data-role='settings' style='padding-top:10px;border-top:3px solid #0f172a'>`\n    + kicker(data.title || 'Settings', '#0f172a')\n    + `<dl style='margin:0;display:grid;grid-template-columns:max-content 1fr;column-gap:12px;border-bottom:1px solid #cbd5e1'>`\n    + settingRows(data.rows).map(([name, value]) => {\n      const wide = value.length > 24;\n      const span = wide ? 'grid-column:1/-1;' : '';\n      return `<dt style='${span}padding:9px 0 ${wide ? 0 : 9}px;border-top:1px solid #cbd5e1;font:400 13px/20px system-ui;color:#475569'>${escapeHtml(name)}</dt>`\n        + `<dd style='${span}margin:0;padding:${wide ? '2px 0 9px' : '9px 0;border-top:1px solid #cbd5e1;text-align:right'};font:600 14px/20px system-ui;color:#0f172a;overflow-wrap:anywhere'>${escapeHtml(value)}</dd>`;\n    }).join('')\n    + `</dl></section>`,\n  'page-section': (data, { dropCap }) => `<section data-role='section'>${kicker(data.title)}${bodyText(data.body, dropCap)}</section>`\n};\n\nconst districtEntry = (route, first) => {\n  const data = route.data;\n  const primary = clean(data.prominence).toLowerCase() !== 'secondary';\n  const ref = clean(data.destinationRef);\n  const tag = ref ? 'a' : 'div';\n  return `<${tag} data-role='route'${ref ? ` href='${escapeHtml(ref)}'` : ''} style='display:block;padding:${first ? '0' : '14px'} 0 14px;${first ? '' : 'border-top:1px solid #cbd5e1;'}text-decoration:none;color:#0f172a'>`\n    + `<span style='display:block;font:500 ${primary ? 26 : 22}px/1.15 ${SERIF};letter-spacing:-.01em;color:#0f172a'>${escapeHtml(data.title)}${ref ? ' →' : ''}</span>`\n    + (clean(data.body) ? `<span style='display:block;margin-top:4px;font:400 14px/1.55 system-ui;color:#475569'>${escapeHtml(data.body)}</span>` : '')\n    + `</${tag}>`;\n};\nconst district = (section, routes, last) => {\n  const primary = routes.some((route) => clean(route.data.prominence).toLowerCase() !== 'secondary');\n  return `<section data-role='district' style='padding:18px 0 8px;border-top:${primary ? `3px solid ${ACCENT}` : '1px solid #0f172a'};${last ? 'border-bottom:1px solid #0f172a;' : ''}display:flex;flex-wrap:wrap;gap:12px 24px'>`\n    + `<h2 style='flex:0 0 120px;margin:4px 0 0;${KICKER};color:${primary ? ACCENT : '#0f172a'}'>${escapeHtml(section.data.title)}</h2>`\n    + `<div style='flex:1 1 380px;min-width:0'>`\n    + (clean(section.data.body) ? `<p style='margin:0 0 14px;font:400 15px/1.55 system-ui;color:#475569'>${inlineText(clean(section.data.body))}</p>` : '')\n    + routes.map((route, index) => districtEntry(route, index === 0)).join('')\n    + `</div></section>`;\n};\nconst isDistrict = (piece) => piece?.role === 'page-section' && clean(piece.data.layout).toLowerCase() === 'directory';\n\n// --- The three views --------------------------------------------------------------------------\n// The pieces stay in graph order. Three things sit side by side when the view is wide enough and stack when it\n// is not: routes that follow one another, and a settings list next to the section it comes before or after,\n// which is set as that section's sidebar. Everything else takes the full width. A role with no pieces\n// contributes nothing.\nconst stackPage = (pieces) => {\n  const firstSection = pieces.find((piece) => piece.role === 'page-section' && !isDistrict(piece));\n  const render = (piece) => RENDER[piece.role](piece.data, { dropCap: piece === firstSection });\n  const text = (piece) => `<div style='flex:999 1 380px;min-width:0'>${render(piece)}</div>`;\n  const side = (piece) => `<div style='flex:1 1 220px;min-width:0'>${render(piece)}</div>`;\n  const row = (inner, gap, reverse) => `<div style='display:flex;flex-wrap:wrap;${reverse ? 'flex-direction:row-reverse;' : ''}align-items:${reverse === undefined ? 'stretch' : 'flex-start'};gap:${gap}'>${inner}</div>`;\n  const blocks = [];\n  for (let index = 0; index < pieces.length; index += 1) {\n    const piece = pieces[index];\n    const next = pieces[index + 1];\n    if (isDistrict(piece)) {\n      // Districts that follow one another are one directory, set close together.\n      const follows = blocks.length && blocks[blocks.length - 1][2] === 'district';\n      const routes = [];\n      while (pieces[index + 1]?.role === 'page-route') { index += 1; routes.push(pieces[index]); }\n      blocks.push([follows ? 0 : 44, district(piece, routes, !isDistrict(pieces[index + 1])), 'district']);\n    } else if (piece.role === 'page-route') {\n      const routes = [piece];\n      while (pieces[index + 1]?.role === 'page-route') { index += 1; routes.push(pieces[index]); }\n      blocks.push([40, row(routes.map((route) => `<div style='flex:1 1 190px;min-width:0'>${render(route)}</div>`).join(''), '28px 32px')]);\n    } else if (piece.role === 'page-section' && next?.role === 'page-settings') {\n      index += 1;\n      blocks.push([48, row(text(piece) + side(next), '32px 40px', false)]);\n    } else if (piece.role === 'page-settings' && next?.role === 'page-section') {\n      index += 1;\n      blocks.push([48, row(side(piece) + text(next), '32px 40px', true)]);\n    } else blocks.push([piece.role === 'page-masthead' ? 32 : 48, render(piece)]);\n  }\n  return `<div style='width:100%;min-height:100%;box-sizing:border-box;container-type:inline-size;background:#ffffff;font-family:${SERIF};color:#0f172a'>`\n    + `<div style='box-sizing:border-box;max-width:900px;margin:0 auto;padding:0 clamp(20px,5cqw,40px) 64px'>`\n    + blocks.map(([gap, inner]) => `<div style='padding-top:${gap}px'>${inner}</div>`).join('')\n    + `</div></div>`;\n};\n// A size drawn for one width that follows the width the view is actually shown at.\nconst fluid = (px, base) => `clamp(${Math.round(px * 0.65)}px,${(px / base * 100).toFixed(2)}cqw,${Math.round(px * 1.5)}px)`;\nconst stackSummary = (pieces) => {\n  const masthead = pieces.find((piece) => piece.role === 'page-masthead')?.data || {};\n  const routes = pieces.filter((piece) => piece.role === 'page-route').map((piece) => clean(piece.data.title)).filter(Boolean);\n  const s = (px) => fluid(px, 300);\n  return `<div style='container-type:inline-size;box-sizing:border-box;width:100%;height:100%;min-height:100%;padding:${s(22)} ${s(24)};border-radius:18px;background:#ffffff;border:1px solid #e2e8f0;color:#0f172a;overflow:hidden;display:flex;flex-direction:column'>`\n    + (clean(masthead.eyebrow) ? `<div style='margin-bottom:${s(10)};font-weight:800;font-size:${s(11)};line-height:1.3;font-family:system-ui;letter-spacing:.18em;text-transform:uppercase;color:${ACCENT}'>${escapeHtml(masthead.eyebrow)}</div>` : '')\n    + `<div style='font-weight:500;font-size:${s(32)};line-height:1;font-family:${SERIF};letter-spacing:-.02em'>${escapeHtml(masthead.title || 'Untitled page')}</div>`\n    + (routes.length ? `<div style='margin-top:${s(10)};font-weight:600;font-size:${s(13)};line-height:1.4;font-family:system-ui;color:${ACCENT}'>${routes.map(escapeHtml).join(' · ')}</div>` : '')\n    + `<div style='margin-top:auto;padding-top:${s(8)};font-weight:400;font-size:${s(12)};line-height:1.3;font-family:system-ui;color:#475569'>${pieces.length} piece${pieces.length === 1 ? '' : 's'}</div></div>`;\n};\nconst stackIcon = (pieces) => {\n  const title = clean(pieces.find((piece) => piece.role === 'page-masthead')?.data.title) || 'Page';\n  const s = (px) => fluid(px, 120);\n  return `<div style='container-type:inline-size;box-sizing:border-box;width:100%;height:100%;min-height:100%;padding:${s(14)};border-radius:18px;background:#ede9fe;border:1px solid #ddd6fe;color:#0f172a;overflow:hidden;display:flex;flex-direction:column;justify-content:center'>`\n    + `<div style='font-weight:800;font-size:${s(30)};line-height:1;font-family:system-ui;color:${ACCENT}'>${escapeHtml(title.charAt(0))}</div>`\n    + `<div style='margin-top:${s(8)};font-weight:800;font-size:${s(13)};line-height:1.2;font-family:system-ui'>${escapeHtml(title)}</div></div>`;\n};\n\n// --- Run --------------------------------------------------------------------------------------\nconst nodes = await api.getNodes();\nconst edges = await api.getEdges();\nconst pieces = nodes.filter((node) => ROLES.includes(roleOf(node)))\n  .map((node) => ({ role: roleOf(node), data: node.data || {} }));\n\nconst declaration = nodes.find((node) => node?.type === 'declaration');\n// The exposed views are reached by walking the Declaration's own Surface chain -- surfaces to the\n// first View, then view-sequence links down to the next -- the same path every graph in the\n// library uses, not a shortcut relationship of its own.\nconst chainNext = (fromId) => edges.find((edge) => edge.source === fromId\n  && clean(edge.data?.role || edge.type) === 'view-sequence')?.target;\nconst surfaceEdge = edges.find((edge) => edge.source === declaration?.id\n  && clean(edge.data?.role || edge.type) === 'surface');\nconst detailId = surfaceEdge?.target || '';\nconst summaryId = detailId ? chainNext(detailId) || '' : '';\nconst iconId = summaryId ? chainNext(summaryId) || '' : '';\nconst exposed = [[detailId, () => stackPage(pieces)], [summaryId, () => stackSummary(pieces)], [iconId, () => stackIcon(pieces)]];\nconst updated = [];\nfor (const [viewId, build] of exposed) {\n  if (!viewId) continue;\n  await api.updateView(viewId, { content: { kind: 'html', value: build() } });\n  updated.push(viewId);\n}\n// A graph whose landing node holds a page shows this page there too, so that browsing the graph reads as the\n// article. A landing node that holds anything else (markdown an author wrote, say) is left alone.\nconst landingId = edges.find((edge) => edge.source === declaration?.id\n  && clean(edge.sourceHandle || edge.data?.semanticRole) === 'landing-surface')?.target;\nconst landingNode = nodes.find((node) => node.id === landingId);\nif (landingNode && clean(landingNode.data?.content?.kind) === 'html') {\n  await api.updateNode(landingId, { data: { ...(landingNode.data || {}), content: { kind: 'html', value: stackPage(pieces) } } });\n  updated.push(landingId);\n}\nreturn { updated, pieces: pieces.length };\n",
        "effects": [
          {
            "kind": "update-node",
            "targets": [
              "root-icon",
              "root-summary",
              "root-detail",
              "root-landing"
            ]
          }
        ],
        "allowMutations": true,
        "dryRun": false,
        "identity": {
          "graphId": "primitives-index-demo"
        },
        "bridgedMethod": {
          "bridgeNodeId": "root-page-template",
          "key": "assemble-page-method"
        }
      }
    },
    {
      "id": "walk-identity",
      "type": "content",
      "label": "Identity",
      "root": false,
      "position": {
        "x": -460,
        "y": -1000
      },
      "width": 420,
      "height": 220,
      "ports": [
        {
          "id": "root",
          "key": "root",
          "label": "root",
          "direction": "bidirectional",
          "dataType": "any",
          "angle": 270
        },
        {
          "id": "next",
          "key": "next",
          "label": "next",
          "direction": "output",
          "dataType": "any",
          "angle": 0,
          "position": {
            "side": "right",
            "offset": 0.5
          }
        }
      ],
      "handles": [
        {
          "id": "root",
          "key": "root",
          "label": "root",
          "direction": "bidirectional",
          "dataType": "any",
          "angle": 270,
          "portId": "root"
        },
        {
          "id": "next",
          "key": "next",
          "label": "next",
          "direction": "output",
          "dataType": "any",
          "angle": 0,
          "position": {
            "side": "right",
            "offset": 0.5
          },
          "portId": "next"
        }
      ],
      "visible": true,
      "showLabel": true,
      "data": {
        "identity": {
          "graphId": "primitives-index-demo"
        },
        "content": {
          "kind": "markdown",
          "value": "## Identity\n\nWhat a graph is, and the form its specification takes."
        }
      }
    },
    {
      "id": "portal-declaration",
      "type": "portal",
      "label": "Declaration",
      "root": false,
      "position": {
        "x": -430,
        "y": -700
      },
      "width": 360,
      "height": 240,
      "ports": [
        {
          "id": "root",
          "label": "root",
          "direction": "bidirectional",
          "dataType": "any",
          "angle": 210
        },
        {
          "id": "left",
          "label": "left",
          "direction": "bidirectional",
          "dataType": "value",
          "angle": 180
        }
      ],
      "visible": true,
      "showLabel": true,
      "data": {
        "identity": {
