      "root": false,
      "position": {
        "x": 2200,
        "y": 2060
      },
      "width": 400,
      "height": 280,
      "ports": [
        {
          "id": "trigger",
          "key": "trigger",
          "label": "Event",
          "direction": "input",
          "dataType": "event",
          "angle": 180
        },
        {
          "id": "result",
          "key": "result",
          "label": "Invocation",
          "direction": "output",
          "dataType": "value",
          "angle": 0
        }
      ],
      "handles": [
        {
          "id": "trigger",
          "key": "trigger",
          "label": "Event",
          "direction": "input",
          "dataType": "event",
          "angle": 180,
          "portId": "trigger"
        },
        {
          "id": "result",
          "key": "result",
          "label": "Invocation",
          "direction": "output",
          "dataType": "value",
          "angle": 0,
          "portId": "result"
        }
      ],
      "visible": true,
      "showLabel": true,
      "data": {
        "identity": {
          "graphId": "primitives-index-demo"
        },
        "enabled": true,
        "trigger": {
          "sourceNodeId": "primitives-index-demo",
