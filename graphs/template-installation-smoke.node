          "dataType": "value",
          "angle": 180
        },
        {
          "id": "bottom",
          "label": "bottom",
          "direction": "bidirectional",
          "dataType": "value",
          "angle": 90
        },
        {
          "id": "right",
          "label": "right",
          "direction": "bidirectional",
          "dataType": "value",
          "angle": 360
        }
      ],
      "visible": true,
      "showLabel": true,
      "data": {
        "name": "Installed Workboard",
        "description": "Workboard capability installed into an existing idea graph.",
        "editorContributions": [
          {
            "id": "smoke-board-task-placement",
            "match": {
              "nodeType": "portal",
              "pathExists": "data.board"
            },
            "section": {
              "key": "placement",
              "title": "Placement",
              "summary": "Local workboard lane, ordering, and review state."
            },
            "fields": [
              {
                "key": "boardLaneMode",
                "label": "Placement",
                "type": "select",
                "path": "data.board.laneMode",
                "options": [
                  {
                    "label": "Automatic from task status",
                    "value": "auto"
                  },
                  {
                    "label": "Manual lane",
                    "value": "manual"
                  }
                ],
                "helperText": "Manual placement and pinning are synchronized for now. A pinned task keeps its selected lane; an unpinned task follows workboard policy."
              },
              {
                "key": "boardLane",
                "label": "Lane",
                "type": "select",
                "path": "data.board.lane",
                "options": [
                  {
                    "label": "Inbox",
                    "value": "inbox"
                  },
                  {
                    "label": "Now",
                    "value": "now"
                  },
                  {
                    "label": "Next",
                    "value": "next"
                  },
                  {
                    "label": "Waiting",
                    "value": "waiting"
                  },
                  {
                    "label": "Recently Completed",
                    "value": "recently-completed"
                  }
                ],
                "visibleWhen": {
                  "path": "data.board.laneMode",
                  "equals": "manual"
                }
              },
              {
                "key": "boardPinned",
                "label": "Pinned",
                "type": "boolean",
                "path": "data.board.pinned",
                "helperText": "Pinned currently means manually placed: the task keeps its selected lane and is excluded from automatic placement."
              },
              {
                "key": "boardRank",
                "label": "Rank",
                "type": "number",
                "path": "data.board.rank",
                "helperText": "Lower ranks appear first after pinning and priority rules."
              },
              {
                "key": "boardReviewedAt",
                "label": "Reviewed At",
                "type": "text",
                "path": "data.board.reviewedAt",
                "placeholder": "YYYY-MM-DDTHH:mm:ss.sssZ"
              }
            ]
          }
        ],
        "policy": {
          "defaultLaneMode": "auto",
          "unknownLane": "inbox",
          "statusLanes": {
            "todo": "next",
            "in-progress": "now",
            "blocked": "waiting",
            "waiting": "waiting",
            "done": "recently-completed",
            "cancelled": "recently-completed"
          },
          "ordering": {
            "pinnedFirst": true,
            "priorityOrder": [
              "critical",
              "high",
              "medium",
              "low"
            ],
            "tieBreaker": "rank"
          },
          "automation": {
            "freshReads": true,
            "retainFailures": true
          }
        },
        "_classBinding": {
          "key": "workboard",
          "sourceRef": "github://twilite-zone/public/library/classes/nodes/task-planning/workboard.node-class.node"
        },
        "_bridge": {
