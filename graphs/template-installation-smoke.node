    {
      "id": "smoke-board-reconciler",
      "type": "script",
      "label": "Reconcile Workboard",
      "position": {
        "x": 1360,
        "y": 1060
      },
      "width": 466.250592379616,
      "height": 306.84505726425624,
      "ports": [
        {
          "angle": 210,
          "dataType": "any",
          "direction": "bidirectional",
          "id": "root",
          "label": "root"
        },
        {
          "angle": 180,
          "dataType": "value",
          "direction": "bidirectional",
          "id": "left",
          "label": "left"
        }
      ],
      "visible": false,
      "showLabel": true,
      "data": {
        "scriptName": "Workboard Reconciler",
        "allowMutations": true,
        "autoRun": false,
        "autoRunOnGraphChange": false,
        "dryRun": false,
        "source": "const norm=v=>String(v||'').trim().toLowerCase().replace(/[\\s_]+/g,'-');\nconst normalizeStatus=v=>{const s=norm(v);if(['open','todo','backlog'].includes(s))return'todo';if(s==='active'||s==='inprogress')return'in-progress';if(['complete','completed','achieved'].includes(s))return'done';if(s==='canceled')return'cancelled';return s;};\nconst normalizeType=v=>{const s=norm(v);return s.endsWith('-graph')?s.slice(0,-6):s;};\nconst samePosition=(a,b)=>Number(a?.x)===Number(b?.x)&&Number(a?.y)===Number(b?.y);\nconst overlaps=(a,b,gap=18)=>a.x<b.x+b.width+gap&&a.x+a.width+gap>b.x&&a.y<b.y+b.height+gap&&a.y+a.height+gap>b.y;\nconst CONTROLLER_NODE_ID='smoke-board-overview';\nconst nodes=await api.getNodes();\nconst controllers=nodes.filter(n=>normalizeType(n?.type)==='workboard'||normalizeType(n?.data?._classBinding?.key)==='workboard');\nconst controller=nodes.find(n=>String(n?.id||'')===CONTROLLER_NODE_ID);\nif(!controller)return{success:false,error:'Workboard controller missing: '+CONTROLLER_NODE_ID};\nconst multiController=controllers.length>1;\nconst belongsToController=carrier=>{const assigned=String(carrier?.data?.board?.controllerId||'').trim();return assigned?assigned===controller.id:!multiController;};\nconst policy=controller.data?.policy||{};\nconst statusLanes={todo:'next','in-progress':'now',blocked:'waiting',waiting:'waiting',done:'recently-completed',cancelled:'recently-completed',...(policy.statusLanes||{})};\nconst fallbackLane=norm(policy.unknownLane)||'inbox';\nconst defaultMode=norm(policy.defaultLaneMode)||'auto';\nconst priorityOrder=policy.ordering?.priorityOrder||['critical','high','medium','low'];\nconst priorityRank=new Map(priorityOrder.map((value,index)=>[norm(value),index]));\nconst fresh=policy.automation?.freshReads!==false;\nconst portals=nodes.filter(n=>normalizeType(n?.type)==='portal'&&belongsToController(n));\nconst localTasks=nodes.filter(n=>normalizeType(n?.type)==='task'&&belongsToController(n));\nconst laneIds=['inbox','now','next','waiting','recently-completed'];\nconst laneAnchors=new Map(laneIds.map(id=>[id,nodes.find(n=>n.id==='smoke-board-lane-'+id)]));\nconst seen=new Map();\nconst candidates=[];\nconst changes=[];\nconst failures=[];\nconst duplicates=[];\nlet checked=0,manual=0,skipped=0,unchanged=0;const unverified=[];\nconst graphCache=new Map();\nconst loadGraph=async ref=>{if(!graphCache.has(ref))graphCache.set(ref,api.readGraph(ref,{fresh}));return graphCache.get(ref);};\nconst getPortalRef=carrier=>String(carrier?.data?.sourceRef||carrier?.data?.ref||carrier?.data?.src||carrier?.data?.target?.ref||'').trim();\nconst isVerifiedManualProjection=carrier=>{const board=carrier?.data?.board||{};const mode=board.pinned===true?'manual':norm(board.laneMode);return mode==='manual'&&norm(board?.sourceState?.status)==='fresh';};\nconst prefetchRefs=[...new Set(portals.filter(carrier=>!isVerifiedManualProjection(carrier)).map(getPortalRef).filter(Boolean))];\nawait Promise.allSettled(prefetchRefs.map(ref=>loadGraph(ref)));\nconst getDeclaration=graph=>(graph?.nodes||[]).find(n=>normalizeType(n?.type)==='declaration')||(graph?.nodes||[]).find(n=>normalizeType(n?.type)==='manifest');\nconst resolvePort=(graph,carrier)=>{const declaration=getDeclaration(graph);const contract=declaration?.data?.declaration||{};const selector=String(carrier?.data?.surfaceId||carrier?.data?.target?.surfaceId||carrier?.data?.target?.portId||contract.defaultSurfaceId||'root').trim();const surface=(contract.surfaces||[]).find(s=>String(s?.id||'')===selector||String(s?.portNodeId||'')===selector);const portId=String(surface?.portNodeId||selector);return(graph?.nodes||[]).find(n=>String(n?.id||'')===portId&&normalizeType(n?.type)==='port');};\nconst resolveType=(graph,carrier)=>{const port=resolvePort(graph,carrier);const explicit=normalizeType(port?.data?.view?.nodeType||port?.data?.renderedNodeType||port?.data?.nodeType);if(explicit)return explicit;const declaration=getDeclaration(graph);const declared=normalizeType(declaration?.data?.declaration?.kind||declaration?.data?.intent?.kind||graph?.metadata?.kind);if(declared)return declared;const sourceId=String(carrier?.data?.sourceNodeId||carrier?.data?.target?.nodeId||'');const source=(graph?.nodes||[]).find(n=>String(n?.id||'')===sourceId);return normalizeType(source?.type)||'portal';};\nfor(const carrier of portals){\n const ref=getPortalRef(carrier);\n if(!ref){skipped++;continue;}\n if(isVerifiedManualProjection(carrier)){checked++;manual++;continue;}\n const surfaceId=String(carrier?.data?.surfaceId||carrier?.data?.target?.surfaceId||carrier?.data?.target?.portId||'root').trim()||'root';\n const identity=ref+'::'+surfaceId;\n if(seen.has(identity)){duplicates.push({nodeId:carrier.id,duplicateOf:seen.get(identity),identity});continue;}\n let graph;\n try{graph=await loadGraph(ref);}catch(error){const message=String(error?.message||error);const board=carrier.data?.board||{};const sourceState={status:'unavailable',message};if(JSON.stringify(board.sourceState||{})!==JSON.stringify(sourceState)){await api.updateNode(carrier.id,{data:{...(carrier.data||{}),board:{...board,sourceState}}});changes.push({nodeId:carrier.id,sourceRef:ref,sourceState:'unavailable'});}failures.push({nodeId:carrier.id,sourceRef:ref,state:'unavailable',error:message});continue;}\n if(resolveType(graph,carrier)!=='task'){skipped++;continue;}\n seen.set(identity,carrier.id);checked++;\n const originalBoard=carrier.data?.board||{};\n const sourceId=String(carrier?.data?.sourceNodeId||carrier?.data?.target?.nodeId||'');\n const selectedSource=(graph?.nodes||[]).find(n=>String(n?.id||'')===sourceId);\n if(!selectedSource){const message='Exposed source node is missing';const sourceState={status:'unavailable',message};await api.updateNode(carrier.id,{data:{...(carrier.data||{}),board:{...originalBoard,sourceState}}});changes.push({nodeId:carrier.id,sourceRef:ref,sourceState:'unavailable'});failures.push({nodeId:carrier.id,sourceRef:ref,state:'unavailable',error:message});continue;}\n const status=normalizeStatus(selectedSource?.data?.status||selectedSource?.data?.summary?.status);\n const selectedIsSummary=normalizeType(selectedSource?.type)==='summary';\n const updater=selectedIsSummary?(graph?.nodes||[]).find(n=>normalizeType(n?.type)==='script'&&String(n?.data?.summaryNodeId||'').trim()===String(selectedSource.id||'').trim()):null;\n const freshnessGuaranteed=!selectedIsSummary||updater?.data?.autoRunOnGraphChange===true;\n if(!freshnessGuaranteed){\n  const sourceState={status:'unverified',message:updater?'Summary updater is not change-driven':'No summary updater declares materialization authority'};\n  if(JSON.stringify(originalBoard.sourceState||{})!==JSON.stringify(sourceState)){await api.updateNode(carrier.id,{data:{...(carrier.data||{}),board:{...originalBoard,sourceState}}});changes.push({nodeId:carrier.id,sourceRef:ref,sourceState:'unverified'});}\n  unverified.push({nodeId:carrier.id,sourceRef:ref,state:'unverified',reason:sourceState.message});\n  continue;\n }\n const sourceState={status:'fresh'};\n const board={...originalBoard,sourceState};\n const mode=board.pinned===true?'manual':(norm(board.laneMode)||defaultMode);\n if(mode==='manual'){\n  manual++;\n  if(board.pinned!==true||norm(board.laneMode)!=='manual'||String(board.controllerId||'')!==controller.id||JSON.stringify(originalBoard.sourceState||{})!==JSON.stringify(sourceState)){\n   const nextBoard={...board,controllerId:controller.id,pinned:true,laneMode:'manual'};\n   await api.updateNode(carrier.id,{data:{...(carrier.data||{}),board:nextBoard}});\n   changes.push({nodeId:carrier.id,sourceRef:ref,placement:'manual',pinned:true,sourceState:'fresh'});\n  }\n  continue;\n }\n const lane=norm(statusLanes[status])||fallbackLane;\n candidates.push({carrier,ref,board,status,lane});\n}\nfor(const task of localTasks){\n checked++;\n const originalBoard=task.data?.board||{};\n const hasBoard=Boolean(task.data?.board);\n const status=normalizeStatus(task.data?.status);\n const mappedLane=status?(norm(statusLanes[status])||fallbackLane):'inbox';\n const boardKeys=Object.keys(originalBoard).sort();\n const legacyInboxStamp=hasBoard&&originalBoard.pinned===true&&norm(originalBoard.laneMode)==='manual'&&norm(originalBoard.lane)==='inbox'&&mappedLane!=='inbox'&&boardKeys.every(key=>['lane','laneMode','pinned'].includes(key));\n const mode=legacyInboxStamp?'auto':(originalBoard.pinned===true?'manual':(norm(originalBoard.laneMode)||defaultMode));\n if(hasBoard&&mode==='manual'){\n  manual++;\n  if(originalBoard.pinned!==true||norm(originalBoard.laneMode)!=='manual'||String(originalBoard.controllerId||'')!==controller.id){\n   const nextBoard={...originalBoard,controllerId:controller.id,pinned:true,laneMode:'manual'};\n   await api.updateNode(task.id,{data:{...(task.data||{}),board:nextBoard}});\n   changes.push({nodeId:task.id,local:true,placement:'manual',pinned:true});\n  }\n  continue;\n }\n const lane=mappedLane;\n candidates.push({carrier:task,ref:'',board:originalBoard,status,lane,local:true,initial:!hasBoard,repairLegacy:legacyInboxStamp});\n}\nconst managedNodes=[...portals,...localTasks];\nconst automaticIds=new Set(candidates.map(item=>item.carrier.id));\nconst manuallyPlacedNodes=managedNodes.filter(n=>!automaticIds.has(n.id)&&n?.data?.board&&(n.data.board.pinned===true||norm(n.data.board.laneMode)==='manual'));\nconst manualRects=manuallyPlacedNodes.map(n=>({x:Number(n.position?.x)||0,y:Number(n.position?.y)||0,width:Number(n.width)||440,height:Number(n.height)||340}));\nfor(const lane of laneIds){\n const empty=nodes.find(n=>n.id==='smoke-board-'+lane+'-empty');\n if(!empty)continue;\n const hasTask=candidates.some(item=>item.lane===lane)||manuallyPlacedNodes.some(n=>norm(n?.data?.board?.lane)===lane);\n const nextVisible=!hasTask;\n if(empty.visible!==nextVisible){await api.updateNode(empty.id,{visible:nextVisible});changes.push({nodeId:empty.id,lane,emptyState:nextVisible?'shown':'hidden'});}\n}\nfor(const lane of laneIds){\n const anchor=laneAnchors.get(lane);\n const laneCandidates=candidates.filter(item=>item.lane===lane).sort((a,b)=>{\n  const ap=priorityRank.get(norm(a.carrier?.data?.priority??a.carrier?.data?.summary?.priority))??priorityOrder.length;\n  const bp=priorityRank.get(norm(b.carrier?.data?.priority??b.carrier?.data?.summary?.priority))??priorityOrder.length;\n  return ap-bp||(Number(a.board.rank)||Number.MAX_SAFE_INTEGER)-(Number(b.board.rank)||Number.MAX_SAFE_INTEGER)||String(a.carrier.label||'').localeCompare(String(b.carrier.label||''));\n });\n if(!laneCandidates.length)continue;\n if(!anchor){for(const item of laneCandidates)failures.push({nodeId:item.carrier.id,lane,error:'Lane anchor missing'});continue;}\n const x=Number(anchor.position?.x)||0;\n let y=(Number(anchor.position?.y)||0)+(Number(anchor.height)||150)+30;\n for(const item of laneCandidates){\n  const width=Number(item.carrier.width)||440;\n  const height=Number(item.carrier.height)||340;\n  let proposed={x,y,width,height};\n  while(manualRects.some(rect=>overlaps(proposed,rect))){y=Math.max(...manualRects.filter(rect=>overlaps(proposed,rect)).map(rect=>rect.y+rect.height+30));proposed={x,y,width,height};}\n  const nextPosition={x,y};\n  const nextBoard={...item.board,controllerId:controller.id,pinned:false,laneMode:'auto',lane:item.lane,...(item.local?{registrationSource:'local-task'}:{})};\n  const metadataChanged=norm(item.board.lane)!==item.lane||norm(item.board.laneMode)!==norm(nextBoard.laneMode)||item.board.pinned!==nextBoard.pinned||(item.local&&item.board.registrationSource!=='local-task');\n  const positionChanged=!samePosition(item.carrier.position,nextPosition);\n  if(!metadataChanged&&!positionChanged){unchanged++;}else{\n   await api.updateNode(item.carrier.id,{position:nextPosition,data:{...(item.carrier.data||{}),board:nextBoard}});\n   changes.push({nodeId:item.carrier.id,...(item.local?{local:true,...(item.repairLegacy?{repairedLegacyInboxStamp:true}:{})}:{sourceRef:item.ref}),status:item.status,previousLane:norm(item.board.lane),nextLane:item.lane,previousPosition:item.carrier.position,nextPosition});\n  }\n  y+=height+30;\n }\n}\nconst health=failures.length||unverified.length?'partial':'fresh';return{success:health==='fresh',health,checked,updated:changes.length,manual,unchanged,skipped,unverified,failures,duplicates,changes};",
        "memo": "Graph-owned reconciliation. Local tasks are processed without network access. Verified manual projections retain their placement without refetching; remaining external sources are prefetched concurrently before automatic reconciliation.",
