        "content": {
          "kind": "html",
          "value": "<div style='--paper:#f0f7ff;--ink:#0b2540;--muted:#4a6580;--accent:#0a6cff;--line:#cfe0f5;--body:color-mix(in srgb,#0b2540 88%,#f0f7ff);--tint:color-mix(in srgb,#0a6cff 7%,#f0f7ff);--tint-strong:color-mix(in srgb,#0a6cff 14%,#f0f7ff);--tint-line:color-mix(in srgb,#0a6cff 28%,#f0f7ff);--soft:color-mix(in srgb,#cfe0f5 60%,#f0f7ff);--code-bg:color-mix(in srgb,#0b2540 6%,#f0f7ff);--serif:Inter,system-ui,Segoe UI,Helvetica Neue,Arial,sans-serif;--body-font:Inter,system-ui,Segoe UI,Helvetica Neue,Arial,sans-serif;--sans:Inter,system-ui,Segoe UI,Helvetica Neue,Arial,sans-serif;--mono:ui-monospace,SFMono-Regular,Menlo,Consolas,monospace;width:100%;min-height:100%;box-sizing:border-box;container-type:inline-size;background:var(--paper);color:var(--ink);font-family:var(--body-font);padding:clamp(20px,4cqw,48px)'><div style='max-width:1100px;margin:0 auto'><header><div style='font:800 clamp(10px,1.5cqw,13px)/1.3 var(--sans);letter-spacing:.18em;text-transform:uppercase;color:var(--accent)'>THE LIBRARY</div><h1 style='margin:10px 0 0;font:700 clamp(32px,6.5cqw,64px)/1 var(--serif);letter-spacing:-.02em'>The primitives</h1><p style='margin:12px 0 0;max-width:50ch;font:400 clamp(16px,2.2cqw,21px)/1.4 var(--body-font);color:var(--muted)'>Each card opens one primitive. Start anywhere.</p></header><div data-role='grid' style='display:grid;grid-template-columns:repeat(auto-fill,minmax(min(100%,230px),1fr));gap:clamp(12px,1.8cqw,22px);margin-top:clamp(24px,4cqw,44px)'><a data-role='route' href='tlz://twilite.zone/library/primitives/root/root.node' style='box-sizing:border-box;display:flex;flex-direction:column;gap:8px;min-height:clamp(120px,16cqw,190px);padding:clamp(14px,2cqw,22px);background:var(--tint);border:1px solid var(--tint-line);border-top:4px solid var(--accent);border-radius:10px;text-decoration:none;color:var(--ink)'><span style='font:800 11px/14px var(--sans);letter-spacing:.14em;color:var(--accent)'>OPEN</span><h2 style='margin:0;font:700 clamp(18px,2.4cqw,24px)/1.15 var(--serif);color:var(--ink)'>Root</h2><span style='margin-top:auto;font:400 14px/1.45 var(--sans);color:var(--muted)'>Where a graph begins, and what it is called.</span></a><a data-role='route' href='tlz://twilite.zone/library/primitives/face/root.node' style='box-sizing:border-box;display:flex;flex-direction:column;gap:8px;min-height:clamp(120px,16cqw,190px);padding:clamp(14px,2cqw,22px);background:var(--tint);border:1px solid var(--tint-line);border-top:4px solid var(--accent);border-radius:10px;text-decoration:none;color:var(--ink)'><span style='font:800 11px/14px var(--sans);letter-spacing:.14em;color:var(--accent)'>OPEN</span><h2 style='margin:0;font:700 clamp(18px,2.4cqw,24px)/1.15 var(--serif);color:var(--ink)'>Face</h2><span style='margin-top:auto;font:400 14px/1.45 var(--sans);color:var(--muted)'>One way a graph or a node looks.</span></a><a data-role='route' href='tlz://twilite.zone/library/primitives/glyph/root.node' style='box-sizing:border-box;display:flex;flex-direction:column;gap:8px;min-height:clamp(120px,16cqw,190px);padding:clamp(14px,2cqw,22px);background:var(--tint);border:1px solid var(--tint-line);border-top:4px solid var(--accent);border-radius:10px;text-decoration:none;color:var(--ink)'><span style='font:800 11px/14px var(--sans);letter-spacing:.14em;color:var(--accent)'>OPEN</span><h2 style='margin:0;font:700 clamp(18px,2.4cqw,24px)/1.15 var(--serif);color:var(--ink)'>Glyph</h2><span style='margin-top:auto;font:400 14px/1.45 var(--sans);color:var(--muted)'>A node&#39;s mark: how it is recognised.</span></a><a data-role='route' href='tlz://twilite.zone/library/primitives/content/root.node' style='box-sizing:border-box;display:flex;flex-direction:column;gap:8px;min-height:clamp(120px,16cqw,190px);padding:clamp(14px,2cqw,22px);background:var(--tint);border:1px solid var(--tint-line);border-top:4px solid var(--accent);border-radius:10px;text-decoration:none;color:var(--ink)'><span style='font:800 11px/14px var(--sans);letter-spacing:.14em;color:var(--accent)'>OPEN</span><h2 style='margin:0;font:700 clamp(18px,2.4cqw,24px)/1.15 var(--serif);color:var(--ink)'>Content</h2><span style='margin-top:auto;font:400 14px/1.45 var(--sans);color:var(--muted)'>Durable material: text, markup, pictures.</span></a><a data-role='route' href='tlz://twilite.zone/library/primitives/property/root.node' style='box-sizing:border-box;display:flex;flex-direction:column;gap:8px;min-height:clamp(120px,16cqw,190px);padding:clamp(14px,2cqw,22px);background:var(--tint);border:1px solid var(--tint-line);border-top:4px solid var(--accent);border-radius:10px;text-decoration:none;color:var(--ink)'><span style='font:800 11px/14px var(--sans);letter-spacing:.14em;color:var(--accent)'>OPEN</span><h2 style='margin:0;font:700 clamp(18px,2.4cqw,24px)/1.15 var(--serif);color:var(--ink)'>Property</h2><span style='margin-top:auto;font:400 14px/1.45 var(--sans);color:var(--muted)'>A named value on a node.</span></a><a data-role='route' href='tlz://twilite.zone/library/primitives/method/root.node' style='box-sizing:border-box;display:flex;flex-direction:column;gap:8px;min-height:clamp(120px,16cqw,190px);padding:clamp(14px,2cqw,22px);background:var(--tint);border:1px solid var(--tint-line);border-top:4px solid var(--accent);border-radius:10px;text-decoration:none;color:var(--ink)'><span style='font:800 11px/14px var(--sans);letter-spacing:.14em;color:var(--accent)'>OPEN</span><h2 style='margin:0;font:700 clamp(18px,2.4cqw,24px)/1.15 var(--serif);color:var(--ink)'>Method</h2><span style='margin-top:auto;font:400 14px/1.45 var(--sans);color:var(--muted)'>The one thing that runs, through an edge.</span></a></div><div style='display:flex;flex-wrap:wrap;gap:30px 48px;margin-top:clamp(28px,4.4cqw,56px);padding-top:22px;border-top:1px solid var(--line)'><div style='flex:2 1 320px;min-width:0'><section data-role='section'><h2 style='margin:0 0 14px;font:800 12px/16px var(--sans);letter-spacing:.18em;text-transform:uppercase;color:var(--accent)'>How to read these</h2><p style='margin:0 0 14px;max-width:60ch;font:400 19px/1.6 var(--body-font);color:var(--body)'>Every primitive has a page that says what it means, what it holds, and where it lives in the code. They are all built from the same template.</p></section></div><div style='flex:1 1 220px;min-width:0'><section data-role='settings' style='padding-top:10px;border-top:3px solid var(--ink)'><h2 style='margin:0 0 14px;font:800 12px/16px var(--sans);letter-spacing:.18em;text-transform:uppercase;color:var(--ink)'>About this catalog</h2><dl style='margin:0;display:grid;grid-template-columns:max-content 1fr;column-gap:12px;border-bottom:1px solid var(--line)'><dt style='padding:9px 0 9px;border-top:1px solid var(--line);font:400 13px/20px var(--sans);color:var(--muted)'>Cards</dt><dd style='margin:0;padding:9px 0;border-top:1px solid var(--line);text-align:right;font:600 14px/20px var(--sans);color:var(--ink);overflow-wrap:anywhere'>Routes, in graph order</dd><dt style='padding:9px 0 9px;border-top:1px solid var(--line);font:400 13px/20px var(--sans);color:var(--muted)'>Opens</dt><dd style='margin:0;padding:9px 0;border-top:1px solid var(--line);text-align:right;font:600 14px/20px var(--sans);color:var(--ink);overflow-wrap:anywhere'>In the same workspace</dd></dl></section></div></div></div></div>"
