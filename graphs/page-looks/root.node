          "graphId": "page-looks-graph"
        },
        "content": {
          "kind": "html",
          "value": "<div style='--paper:#f6efe2;--ink:#3b2a1a;--muted:#6b5640;--accent:#b4532a;--line:#d9c9a8;--body:color-mix(in srgb,#3b2a1a 88%,#f6efe2);--tint:color-mix(in srgb,#b4532a 7%,#f6efe2);--tint-strong:color-mix(in srgb,#b4532a 14%,#f6efe2);--tint-line:color-mix(in srgb,#b4532a 28%,#f6efe2);--soft:color-mix(in srgb,#d9c9a8 60%,#f6efe2);--code-bg:color-mix(in srgb,#3b2a1a 6%,#f6efe2);--serif:Rockwell,Roboto Slab,Zilla Slab,Georgia,serif;--body-font:Newsreader,Iowan Old Style,Palatino Linotype,Book Antiqua,Georgia,serif;--sans:Inter,system-ui,Segoe UI,Helvetica Neue,Arial,sans-serif;--mono:ui-monospace,SFMono-Regular,Menlo,Consolas,monospace;width:100%;min-height:100%;box-sizing:border-box;container-type:inline-size;background:var(--paper);color:var(--ink);font-family:var(--body-font);padding:clamp(20px,4cqw,48px)'><div style='max-width:820px;margin:0 auto'><header><div style='font:800 clamp(10px,1.5cqw,13px)/1.3 var(--sans);letter-spacing:.18em;text-transform:uppercase;color:var(--accent)'>PROJECT HISTORY</div><h1 style='margin:10px 0 0;font:700 clamp(32px,6cqw,60px)/1 var(--serif);letter-spacing:-.02em'>From first sketch to first release</h1><p style='margin:12px 0 0;max-width:46ch;font:italic 400 clamp(17px,2.4cqw,22px)/1.4 var(--body-font);color:var(--muted)'>Each entry is a section; its kicker is the date.</p></header><div style='margin-top:28px;max-width:420px'><section data-role='settings' style='padding-top:10px;border-top:3px solid var(--ink)'><h2 style='margin:0 0 14px;font:800 12px/16px var(--sans);letter-spacing:.18em;text-transform:uppercase;color:var(--ink)'>About this history</h2><dl style='margin:0;display:grid;grid-template-columns:max-content 1fr;column-gap:12px;border-bottom:1px solid var(--line)'><dt style='padding:9px 0 9px;border-top:1px solid var(--line);font:400 13px/20px var(--sans);color:var(--muted)'>Kept by</dt><dd style='margin:0;padding:9px 0;border-top:1px solid var(--line);text-align:right;font:600 14px/20px var(--sans);color:var(--ink);overflow-wrap:anywhere'>The project lead</dd><dt style='padding:9px 0 9px;border-top:1px solid var(--line);font:400 13px/20px var(--sans);color:var(--muted)'>Order</dt><dd style='margin:0;padding:9px 0;border-top:1px solid var(--line);text-align:right;font:600 14px/20px var(--sans);color:var(--ink);overflow-wrap:anywhere'>Oldest first</dd></dl></section></div><div style='margin:clamp(28px,4cqw,48px) 0 0 7px;border-left:2px solid var(--line)'><section data-role='entry' style='position:relative;padding:0 0 clamp(22px,3.4cqw,40px) clamp(22px,3.6cqw,44px)'><span style='position:absolute;left:-7px;top:6px;width:12px;height:12px;border-radius:50%;background:var(--accent);box-shadow:0 0 0 4px var(--paper)'></span><div style='font:800 12px/16px var(--mono);letter-spacing:.08em;color:var(--accent)'>2026-03</div><h2 style='margin:4px 0 8px;font:700 clamp(20px,2.8cqw,28px)/1.2 var(--serif);color:var(--ink)'>A graph is a place</h2><p style='margin:0 0 14px;max-width:60ch;font:400 19px/1.6 var(--body-font);color:var(--body)'>The first sketch: a graph you can stand in, with nodes on a ground.</p></section><section data-role='entry' style='position:relative;padding:0 0 clamp(22px,3.4cqw,40px) clamp(22px,3.6cqw,44px)'><span style='position:absolute;left:-7px;top:6px;width:12px;height:12px;border-radius:50%;background:var(--accent);box-shadow:0 0 0 4px var(--paper)'></span><div style='font:800 12px/16px var(--mono);letter-spacing:.08em;color:var(--accent)'>2026-06</div><h2 style='margin:4px 0 8px;font:700 clamp(20px,2.8cqw,28px)/1.2 var(--serif);color:var(--ink)'>Faces and a root</h2><p style='margin:0 0 14px;max-width:60ch;font:400 19px/1.6 var(--body-font);color:var(--body)'>Every graph got a root and a chain of faces, so it could look like a page or a poster.</p></section><section data-role='entry' style='position:relative;padding:0 0 clamp(22px,3.4cqw,40px) clamp(22px,3.6cqw,44px)'><span style='position:absolute;left:-7px;top:6px;width:12px;height:12px;border-radius:50%;background:var(--accent);box-shadow:0 0 0 4px var(--paper)'></span><div style='font:800 12px/16px var(--mono);letter-spacing:.08em;color:var(--accent)'>2026-10-14</div><h2 style='margin:4px 0 8px;font:700 clamp(20px,2.8cqw,28px)/1.2 var(--serif);color:var(--ink)'>One vocabulary</h2><p style='margin:0 0 14px;max-width:60ch;font:400 19px/1.6 var(--body-font);color:var(--body)'>Root, face, glyph, ground, content, property: the words were settled and the files converted.</p></section><section data-role='entry' style='position:relative;padding:0 0 clamp(22px,3.4cqw,40px) clamp(22px,3.6cqw,44px)'><span style='position:absolute;left:-7px;top:6px;width:12px;height:12px;border-radius:50%;background:var(--accent);box-shadow:0 0 0 4px var(--paper)'></span><div style='font:800 12px/16px var(--mono);letter-spacing:.08em;color:var(--accent)'>2026-10-16</div><h2 style='margin:4px 0 8px;font:700 clamp(20px,2.8cqw,28px)/1.2 var(--serif);color:var(--ink)'>Events through edges</h2><p style='margin:0 0 14px;max-width:60ch;font:400 19px/1.6 var(--body-font);color:var(--body)'>The Event Handler retired. A Method runs only through an invokes edge.</p></section><section data-role='entry' style='position:relative;padding:0 0 clamp(22px,3.4cqw,40px) clamp(22px,3.6cqw,44px)'><span style='position:absolute;left:-7px;top:6px;width:12px;height:12px;border-radius:50%;background:var(--accent);box-shadow:0 0 0 4px var(--paper)'></span><div style='font:800 12px/16px var(--mono);letter-spacing:.08em;color:var(--accent)'>2026-10-17</div><h2 style='margin:4px 0 8px;font:700 clamp(20px,2.8cqw,28px)/1.2 var(--serif);color:var(--ink)'>Pages with their own look</h2><p style='margin:0 0 14px;max-width:60ch;font:400 19px/1.6 var(--body-font);color:var(--body)'>A Page Style, and layouts that are not all an article.</p></section></div><nav data-role='routes' style='display:flex;flex-wrap:wrap;gap:12px 28px;padding-top:14px;border-top:1px solid var(--line)'><span style='font:800 11px/20px var(--sans);letter-spacing:.16em;text-transform:uppercase;color:var(--muted)'>Continue</span><a data-role='route-link' href='tlz://twilite.zone/library/primitives/root/root.node' style='font:700 14px/20px var(--sans);color:var(--accent);text-decoration:none'>The plan →</a></nav></div></div>"
        },
        "presentation": {
