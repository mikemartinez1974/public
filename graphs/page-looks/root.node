      "visible": true,
      "showLabel": true,
      "data": {
        "identity": {
          "graphId": "page-looks-graph"
        },
        "content": {
          "kind": "html",
          "value": "<div style='--paper:#fff8e6;--ink:#1c1917;--muted:#57534e;--accent:#e11d48;--line:#f5d9a6;--body:color-mix(in srgb,#1c1917 88%,#fff8e6);--tint:color-mix(in srgb,#e11d48 7%,#fff8e6);--tint-strong:color-mix(in srgb,#e11d48 14%,#fff8e6);--tint-line:color-mix(in srgb,#e11d48 28%,#fff8e6);--soft:color-mix(in srgb,#f5d9a6 60%,#fff8e6);--code-bg:color-mix(in srgb,#1c1917 6%,#fff8e6);--serif:Inter,system-ui,Segoe UI,Helvetica Neue,Arial,sans-serif;--body-font:Inter,system-ui,Segoe UI,Helvetica Neue,Arial,sans-serif;--sans:Inter,system-ui,Segoe UI,Helvetica Neue,Arial,sans-serif;--mono:ui-monospace,SFMono-Regular,Menlo,Consolas,monospace;width:100%;min-height:100%;box-sizing:border-box;container-type:inline-size;background:var(--paper);color:var(--ink);font-family:var(--body-font);padding:clamp(20px,4cqw,48px)'><div style='display:flex;flex-direction:column;gap:clamp(14px,2.4cqw,28px);max-width:1100px;margin:0 auto'><section data-role='slide' style='box-sizing:border-box;width:100%;aspect-ratio:16/9;min-height:clamp(220px,40cqw,520px);padding:clamp(18px,4cqw,52px);border-radius:clamp(12px,1.8cqw,22px);overflow:auto;display:flex;flex-direction:column;justify-content:center;background:var(--accent);color:var(--paper)'><div style='font:800 clamp(10px,1.6cqw,14px)/1.3 var(--sans);letter-spacing:.2em;text-transform:uppercase;opacity:.85'>Q3 REVIEW</div><h1 style='margin:12px 0 0;font:800 clamp(34px,7.5cqw,92px)/.98 var(--serif);letter-spacing:-.025em;text-wrap:balance'>What we shipped, what we learned</h1><p style='margin:16px 0 0;max-width:34ch;font:400 clamp(16px,2.6cqw,32px)/1.3 var(--body-font);opacity:.9'>Five slides. One idea each.</p></section><section data-role='slide' style='box-sizing:border-box;width:100%;aspect-ratio:16/9;min-height:clamp(220px,40cqw,520px);padding:clamp(18px,4cqw,52px);border-radius:clamp(12px,1.8cqw,22px);overflow:auto;display:flex;flex-direction:column;justify-content:center;background:var(--tint);border:1px solid var(--tint-line)'><div style='font:800 clamp(10px,1.5cqw,13px)/1.3 var(--sans);letter-spacing:.18em;color:var(--accent)'>1 / 5 · SHIPPED</div><h2 style='margin:8px 0 12px;font:700 clamp(24px,4.6cqw,56px)/1.05 var(--serif);letter-spacing:-.02em;color:var(--ink)'>We shipped the editor rewrite</h2><p style='margin:0 0 14px;max-width:60ch;font:400 19px/1.6 var(--body-font);color:var(--body)'>Every graph now opens from one model, and the old formats are gone.</p></section><section data-role='slide' style='box-sizing:border-box;width:100%;aspect-ratio:16/9;min-height:clamp(220px,40cqw,520px);padding:clamp(18px,4cqw,52px);border-radius:clamp(12px,1.8cqw,22px);overflow:auto;display:flex;flex-direction:column;justify-content:center;background:var(--tint);border:1px solid var(--tint-line)'><div style='font:800 clamp(10px,1.5cqw,13px)/1.3 var(--sans);letter-spacing:.18em;color:var(--accent)'>2 / 5 · SHIPPED</div><h2 style='margin:8px 0 12px;font:700 clamp(24px,4.6cqw,56px)/1.05 var(--serif);letter-spacing:-.02em;color:var(--ink)'>Pages got three new looks</h2><p style='margin:0 0 14px;max-width:60ch;font:400 19px/1.6 var(--body-font);color:var(--body)'>A page can be an article, a poster, a handbook or a timeline, from one template.</p></section><section data-role='slide' style='box-sizing:border-box;width:100%;aspect-ratio:16/9;min-height:clamp(220px,40cqw,520px);padding:clamp(18px,4cqw,52px);border-radius:clamp(12px,1.8cqw,22px);overflow:auto;display:flex;flex-direction:column;justify-content:center;background:var(--tint);border:1px solid var(--tint-line)'><div style='font:800 clamp(10px,1.5cqw,13px)/1.3 var(--sans);letter-spacing:.18em;color:var(--accent)'>3 / 5 · FIXED</div><h2 style='margin:8px 0 12px;font:700 clamp(24px,4.6cqw,56px)/1.05 var(--serif);letter-spacing:-.02em;color:var(--ink)'>Loading is calmer</h2><p style='margin:0 0 14px;max-width:60ch;font:400 19px/1.6 var(--body-font);color:var(--body)'>Graphs settle once, and nothing moves while you zoom.</p></section><section data-role='slide' style='box-sizing:border-box;width:100%;aspect-ratio:16/9;min-height:clamp(220px,40cqw,520px);padding:clamp(18px,4cqw,52px);border-radius:clamp(12px,1.8cqw,22px);overflow:auto;display:flex;flex-direction:column;justify-content:center;background:var(--tint);border:1px solid var(--tint-line)'><div style='font:800 clamp(10px,1.5cqw,13px)/1.3 var(--sans);letter-spacing:.18em;color:var(--accent)'>4 / 5 · OPEN</div><h2 style='margin:8px 0 12px;font:700 clamp(24px,4.6cqw,56px)/1.05 var(--serif);letter-spacing:-.02em;color:var(--ink)'>Publishing still needs a password</h2><p style='margin:0 0 14px;max-width:60ch;font:400 19px/1.6 var(--body-font);color:var(--body)'>Key-based login is the one blocker left on the release.</p></section><section data-role='slide' style='box-sizing:border-box;width:100%;aspect-ratio:16/9;min-height:clamp(220px,40cqw,520px);padding:clamp(18px,4cqw,52px);border-radius:clamp(12px,1.8cqw,22px);overflow:auto;display:flex;flex-direction:column;justify-content:center;background:var(--tint);border:1px solid var(--tint-line)'><div style='font:800 clamp(10px,1.5cqw,13px)/1.3 var(--sans);letter-spacing:.18em;color:var(--accent)'>5 / 5 · PLAN</div><h2 style='margin:8px 0 12px;font:700 clamp(24px,4.6cqw,56px)/1.05 var(--serif);letter-spacing:-.02em;color:var(--ink)'>Next quarter</h2><p style='margin:0 0 14px;max-width:60ch;font:400 19px/1.6 var(--body-font);color:var(--body)'>Templates for reports, then the topic poster on real data.</p></section><section data-role='slide' style='box-sizing:border-box;width:100%;aspect-ratio:16/9;min-height:clamp(220px,40cqw,520px);padding:clamp(18px,4cqw,52px);border-radius:clamp(12px,1.8cqw,22px);overflow:auto;display:flex;flex-direction:column;justify-content:center;background:var(--tint);border:1px solid var(--tint-line)'><div style='font:800 clamp(10px,1.5cqw,13px)/1.3 var(--sans);letter-spacing:.18em;color:var(--accent)'>NEXT</div><div style='margin-top:14px;font:700 clamp(18px,3cqw,34px)/1.2 var(--serif)'><a href='tlz://twilite.zone/library/primitives/root/root.node' style='color:var(--ink);text-decoration:none'>Appendix →</a></div></section></div></div>"
