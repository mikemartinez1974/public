          "label": "root",
          "direction": "bidirectional",
          "dataType": "any",
          "angle": 270,
          "position": {
            "side": "top",
            "offset": 0.2
          }
        }
      ],
      "handles": [
        {
          "id": "root",
          "key": "root",
          "label": "root",
          "direction": "bidirectional",
          "dataType": "any",
          "angle": 270,
          "position": {
            "side": "top",
            "offset": 0.2
