        "content": {
          "kind": "html",
          "value": "<div style='--paper:#1b3a6b;--ink:#ffffff;--muted:#cfe0ff;--accent:#f5c542;--line:#2a5aa0;--body:color-mix(in srgb,#ffffff 88%,#1b3a6b);--tint:color-mix(in srgb,#f5c542 7%,#1b3a6b);--tint-strong:color-mix(in srgb,#f5c542 14%,#1b3a6b);--tint-line:color-mix(in srgb,#f5c542 28%,#1b3a6b);--soft:color-mix(in srgb,#2a5aa0 60%,#1b3a6b);--code-bg:color-mix(in srgb,#ffffff 6%,#1b3a6b);--serif:Archivo Black,Impact,Haettenschweiler,Arial Black,sans-serif;--body-font:Inter,system-ui,Segoe UI,Helvetica Neue,Arial,sans-serif;--sans:Inter,system-ui,Segoe UI,Helvetica Neue,Arial,sans-serif;--mono:ui-monospace,SFMono-Regular,Menlo,Consolas,monospace;width:100%;height:100%;min-height:100%;box-sizing:border-box;container-type:inline-size;background:var(--paper);color:var(--ink);font-family:var(--sans);display:flex;flex-direction:column;gap:clamp(14px,2.4cqw,32px);padding:clamp(20px,4cqw,56px)'><header data-role='masthead'><div style='font:800 clamp(10px,1.3cqw,15px)/1.2 var(--sans);letter-spacing:.2em;text-transform:uppercase;color:var(--accent)'>TOPIC</div><h1 style='margin:clamp(8px,1.4cqw,18px) 0 0;font:800 clamp(44px,10.5cqw,150px)/.9 var(--serif);letter-spacing:-.03em;text-wrap:balance;color:var(--ink)'>Big idea</h1><p style='margin:clamp(10px,1.6cqw,22px) 0 0;max-width:38ch;font:400 clamp(16px,2.6cqw,34px)/1.3 var(--body-font);color:var(--muted)'>One line, large, under it. The graph sits on the stage below.</p></header><div data-role='stage' style='flex:1 1 auto;min-height:46%;box-sizing:border-box;border-radius:clamp(12px,1.8cqw,28px);background:var(--tint);border:2px solid var(--tint-line)'></div><footer style='display:flex;flex-wrap:wrap;gap:clamp(12px,2cqw,28px) clamp(20px,3cqw,44px);align-items:flex-start'><div data-role='route' style='flex:0 1 auto;font:700 clamp(13px,1.8cqw,22px)/1.2 var(--sans)'><a href='tlz://twilite.zone/gallery/root.node' style='color:var(--accent);text-decoration:none'>A way on →</a></div><div data-role='route' style='flex:0 1 auto;font:700 clamp(13px,1.8cqw,22px)/1.2 var(--sans)'><a href='tlz://twilite.zone/tutorial/root.node' style='color:var(--accent);text-decoration:none'>Another way on →</a></div><div data-role='route' style='flex:0 1 auto;font:700 clamp(13px,1.8cqw,22px)/1.2 var(--sans)'><a href='tlz://twilite.zone/root.node' style='color:var(--accent);text-decoration:none'>A plain route →</a></div><div data-role='section' style='flex:1 1 200px;max-width:42ch'><div style='font:800 clamp(10px,1.3cqw,15px)/1.2 var(--sans);letter-spacing:.2em;text-transform:uppercase;color:var(--muted)'>Section heading</div><p style='margin:6px 0 0;font:400 clamp(13px,1.6cqw,19px)/1.5 var(--body-font);color:var(--body)'>Write the section here. A section is a heading and a body; the body takes paragraphs, bullet lists, sub-headings, bold, inline code and links.</p></div></footer></div>"
