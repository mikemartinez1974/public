    {
      "id": "bernadine-bluntly-detail",
      "type": "face",
      "label": "Profile",
      "position": {
        "x": -1100,
        "y": 1233
      },
      "width": 450,
      "height": 300,
      "ports": [
        {
          "id": "root",
          "key": "root",
          "label": "root",
          "direction": "input",
          "dataType": "any",
