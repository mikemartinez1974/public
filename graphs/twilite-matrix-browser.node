      "data": {
        "title": "The Browser Has Lost the Web",
        "statement": "Tabs, pages, feeds, chats, and isolated applications flatten connected work into disconnected surfaces. People repeatedly reconstruct relationships, provenance, context, and intent in their heads.",
        "impact": "Builders, researchers, learners, and teams lose continuity; agents receive thin context; durable knowledge becomes difficult to revisit, compose, or act upon.",
        "urgency": "high",
        "identity": {
          "graphId": "twilite-matrix-browser"
        },
        "classRef": "github://mikemartinez1974/public/templates/idea-template/classes/nodes/idea-problem.node-class.node"
      }
    },
