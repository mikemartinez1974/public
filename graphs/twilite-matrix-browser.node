      "visible": true,
      "showLabel": false,
      "data": {
        "title": "The Matrix Browser",
        "description": "Make the graph—not the page or chat—the primary browsing environment. Durable graph addresses identify artifacts; typed nodes express meaning; ports expose intentional surfaces; portals compose graphs; semantic zoom changes resolution; humans and agents act inside the same bounded context.",
        "differentiator": "Twilite would not merely summarize or visualize the web. It would preserve the web's relationships as an executable, navigable environment where knowledge and action share one substrate.",
        "identity": {
          "graphId": "twilite-matrix-browser"
        },
        "classRef": "github://mikemartinez1974/public/templates/idea-template/classes/nodes/idea-proposed-approach.node-class.node"
      }
    },
