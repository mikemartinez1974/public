      "data": {
        "title": "Twilite Is the Matrix",
        "statement": "Twilite will become the sci-fi browser of the future: a living spatial matrix of graphs, portals, views, people, agents, and executable knowledge that users can enter, navigate, and reshape.",
        "status": "framed",
        "confidence": "low",
        "notes": "The matrix is not a decorative metaphor. It names a browser model in which relationships, authority, identity, and action remain visible instead of being flattened into pages and tabs.",
        "definitionKey": "idea",
        "_classBinding": {
          "key": "idea",
