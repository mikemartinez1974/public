    {
      "id": "launch-plan-derive-method",
      "type": "method",
      "label": "Derive the plan views",
      "position": {
        "x": -50,
        "y": 1233
      },
      "width": 420,
      "height": 260,
      "ports": [
        {
          "id": "call",
          "key": "call",
          "label": "Call",
          "direction": "input",
          "dataType": "event",
          "angle": 180
        },
        {
          "id": "result",
          "key": "result",
          "label": "Result",
          "direction": "output",
          "dataType": "value",
          "angle": 0
        }
      ],
      "handles": [
        {
          "id": "call",
          "key": "call",
          "label": "Call",
          "direction": "input",
          "dataType": "event",
          "angle": 180,
          "portId": "call"
        },
        {
          "id": "result",
          "key": "result",
          "label": "Result",
          "direction": "output",
          "dataType": "value",
          "angle": 0,
          "portId": "result"
        }
      ],
      "visible": true,
      "showLabel": true,
      "data": {
        "scriptName": "Derive the plan views",
        "parameters": [],
        "source": "// Derives a plan's views from its cards: nothing is typed into a view.\n// It reads the Aim (the card of that type), its Phases, their Steps, the Milestones that gate a phase, the Risks that threaten a phase or step, the Constraints that limit the plan, and the edges between\n// them: `contains` (an aim contains phases, a phase contains steps), `precedes` (the order of phases and of steps), `gates` (a milestone to the phase it holds back), `threatens` (a risk to a phase or\n// step, the label says how) and `limits` (a constraint to what it bounds). It writes the Detail (the plan as a document, phase by phase), the Summary (a card) and the Glyph, and only those, which its\n// declared effects say. It counts what is done and what is reached and shows the counts; it never adds them into a score, and it never decides a plan is on track. Anything a card marks `check` (\"I am not\n// sure this is right\") is gathered in a notice at the top of the page and on the card.\nconst clean = (value) => String(value ?? '').trim();\nconst esc = (value) => clean(value).replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/\"/g, '&quot;').replace(/'/g, '&#39;');\nconst SERIF = 'Georgia,Iowan Old Style,Palatino Linotype,serif'; const SANS = 'Inter,system-ui,Segoe UI,Helvetica Neue,Arial,sans-serif'; const MONO = 'ui-monospace,SFMono-Regular,Menlo,Consolas,monospace';\nconst TEAL = '#0f766e'; const INK = '#1f2937'; const PAPER = '#f6faf9'; const MUTED = '#64748b'; const AMBER = '#92400e'; const GOLD = '#b45309'; const RED = '#b91c1c'; const INDIGO = '#4338ca'; const BLUE = '#0369a1'; const SLATE = '#475569';\n\nconst nodes = await api.getNodes();\nconst edges = await api.getEdges();\nconst ofType = (type) => nodes.filter((node) => clean(node.type) === type);\nconst byId = (id) => nodes.find((node) => node.id === id);\nconst nameOf = (node) => clean(node?.data?.title || node?.label) || 'Untitled';\nconst edgesOf = (type) => edges.filter((e) => clean(e.type) === type);\n\n// a list in the order its `precedes` edges give; whatever they do not reach follows, in the order it came\nconst inOrder = (items) => {\n  const ids = new Set(items.map((item) => item.id));\n  const next = new Map(); const hasPrevious = new Set();\n  for (const e of edgesOf('precedes')) if (ids.has(e.source) && ids.has(e.target) && !next.has(e.source)) { next.set(e.source, e.target); hasPrevious.add(e.target); }\n  const out = []; const seen = new Set();\n  for (const head of items.filter((item) => !hasPrevious.has(item.id))) {\n    let current = head;\n    while (current && !seen.has(current.id)) { out.push(current); seen.add(current.id); current = byId(next.get(current.id)); }\n  }\n  for (const item of items) if (!seen.has(item.id)) out.push(item);\n  return out;\n};\nconst targetsOf = (from, type, kind) => edgesOf(type).filter((e) => e.source === from.id).map((e) => byId(e.target)).filter((node) => node && (!kind || clean(node.type) === kind));\nconst sourcesOf = (to, type, kind) => edgesOf(type).filter((e) => e.target === to.id).map((e) => ({ node: byId(e.source), label: clean(e.label) })).filter((r) => r.node && (!kind || clean(r.node.type) === kind));\n\nconst aim = ofType('aim')[0] || null;\nconst allPhases = ofType('phase');\nconst containedPhases = aim ? targetsOf(aim, 'contains', 'phase') : [];\nconst phases = inOrder([...new Set([...containedPhases, ...allPhases])]);\nconst allSteps = ofType('step');\nconst stepsOf = (phase) => inOrder(targetsOf(phase, 'contains', 'step'));\nconst placed = new Set(phases.flatMap((phase) => stepsOf(phase).map((step) => step.id)));\nconst loose = allSteps.filter((step) => !placed.has(step.id));\nconst milestones = ofType('milestone');\nconst hazards = ofType('hazard');\nconst limits = ofType('limit');\n\nconst stepsDone = allSteps.filter((step) => clean(step.data?.status) === 'done').length;\nconst reached = milestones.filter((m) => m.data?.reached === true).length;\nconst flagged = [aim, ...phases, ...allSteps, ...milestones, ...hazards, ...limits].filter((node) => node && node.data?.check === true);\nconst aimStatus = clean(aim?.data?.status) || 'draft';\nconst name = aim ? nameOf(aim) : 'Name the aim';\nconst lead = clean(aim?.data?.body);\nconst plural = (n, one, many) => `${n} ${n === 1 ? one : many}`;\nconst standing = aimStatus === 'done' ? 'Done' : (allSteps.length ? `${stepsDone} of ${plural(allSteps.length, 'step', 'steps')} done` : (aimStatus === 'underway' ? 'Underway' : 'Still a draft'));\n\nconst flag = (node) => (node?.data?.check === true ? `<span style='display:inline-block;margin-left:1cqw;padding:.2cqw 1cqw;border-radius:9cqw;background:#fffbeb;border:1px solid #fde68a;color:${AMBER};font:700 1.2cqw/1.4 ${SANS};letter-spacing:.06em;text-transform:uppercase;vertical-align:middle'>to check</span>` : '');\nconst heading = (text) => `<div style='font:700 1.3cqw/1 ${MONO};letter-spacing:.24em;text-transform:uppercase;color:${TEAL};margin:4cqw 0 1.6cqw;padding-top:2cqw;border-top:.15cqw solid rgba(15,118,110,.35)'>${text}</div>`;\nconst para = (text, size = 1.7) => (clean(text) ? `<div style='font:400 ${size}cqw/1.55 ${SERIF};color:#334155;margin-top:.4cqw'>${esc(text)}</div>` : '');\nconst chip = (text, colour, solid = false) => `<span style='display:inline-block;padding:.3cqw 1.3cqw;border-radius:9cqw;font:700 1.2cqw/1.4 ${SANS};letter-spacing:.06em;text-transform:uppercase;vertical-align:middle;${solid ? `background:${colour};color:#fff` : `background:#fff;color:${colour};border:1px solid ${colour}`}'>${text}</span>`;\nconst phaseState = (phase) => (clean(phase.data?.status) === 'done' ? chip('Done', INDIGO, true) : (clean(phase.data?.status) === 'underway' ? chip('Underway', INDIGO) : chip('Not started', MUTED)));\nconst likely = (hazard) => ({ high: 'Likely', low: 'Unlikely' }[clean(hazard.data?.likelihood)] || 'Possible');\n\nconst mark = (step) => ({ done: '☑', doing: '◐' }[clean(step.data?.status)] || '☐');\nconst stepLine = (step) => `<div style='display:flex;gap:1.4cqw;align-items:baseline;margin-top:1cqw'><span style='color:${BLUE};font:700 1.9cqw/1.3 ${SANS}'>${mark(step)}</span><span style='font:400 1.65cqw/1.5 ${SERIF};color:#334155'><b style='font-weight:700;color:${INK}'>${esc(nameOf(step))}</b>${clean(step.data?.owner) ? ` · ${esc(step.data.owner)}` : ''}${flag(step)}${clean(step.data?.body) ? `<br>${esc(step.data.body)}` : ''}</span></div>`;\nconst limitLine = (r) => `<div style='margin-top:.8cqw;font:italic 1.5cqw/1.5 ${SERIF};color:${SLATE}'>Limited by <b style='font-style:normal'>${esc(nameOf(r.node))}</b>${r.label ? ` · ${esc(r.label)}` : ''}${flag(r.node)}</div>`;\nconst gateLine = (m) => `<div style='margin-top:.8cqw;font:600 1.5cqw/1.5 ${SANS};color:${GOLD}'>Begins when: ${esc(nameOf(m.node))} — ${m.node.data?.reached === true ? 'reached' : 'not yet reached'}${m.label ? ` · ${esc(m.label)}` : ''}${flag(m.node)}</div>`;\n\nconst phaseBlock = (phase, index) => {\n  const steps = stepsOf(phase);\n  const done = steps.filter((step) => clean(step.data?.status) === 'done').length;\n  return `<div style='margin-bottom:3cqw;padding:2.2cqw 2.6cqw;border-radius:1.2cqw;background:#fff;border:1px solid #e2e8f0'>`\n    + `<div style='display:flex;justify-content:space-between;gap:2cqw;align-items:baseline'><div style='font:700 2.2cqw/1.3 ${SERIF};color:${INK}'><span style='color:${INDIGO};font:700 1.4cqw/1 ${MONO};letter-spacing:.14em;margin-right:1.4cqw'>PHASE ${index + 1}</span>${esc(nameOf(phase))}${flag(phase)}</div>`\n    + `<div style='flex:0 0 auto'>${phaseState(phase)}${steps.length ? `<span style='margin-left:1.2cqw;font:600 1.4cqw/1.3 ${SANS};color:${MUTED}'>${done}/${steps.length}</span>` : ''}</div></div>`\n    + para(phase.data?.body)\n    + sourcesOf(phase, 'gates', 'milestone').map(gateLine).join('')\n    + steps.map(stepLine).join('')\n    + (!steps.length ? `<div style='font:italic 1.5cqw/1.5 ${SERIF};color:${MUTED};margin-top:.8cqw'>No steps yet.</div>` : '')\n    + sourcesOf(phase, 'limits', 'limit').map(limitLine).join('')\n    + `</div>`;\n};\n\nconst threatened = (hazard) => targetsOf(hazard, 'threatens').map((node) => nameOf(node));\nconst hazardBlock = (hazard) => `<div style='margin-bottom:2.2cqw;padding:2cqw 2.4cqw;border-radius:1.2cqw;background:#fff;border:1px solid #fecaca'>`\n  + `<div style='display:flex;justify-content:space-between;gap:2cqw;align-items:baseline'><div style='font:700 2cqw/1.3 ${SERIF};color:${INK}'>${esc(nameOf(hazard))}${flag(hazard)}</div><div style='flex:0 0 auto'>${chip(likely(hazard), RED)}</div></div>`\n  + (threatened(hazard).length ? `<div style='font:600 1.4cqw/1.5 ${SANS};color:${MUTED};margin-top:.6cqw'>Threatens: ${threatened(hazard).map(esc).join(', ')}</div>` : '')\n  + para(hazard.data?.body)\n  + (clean(hazard.data?.mitigation) ? `<div style='margin-top:1cqw;font:400 1.6cqw/1.5 ${SERIF};color:#334155'><b style='color:${RED}'>Reduces it:</b> ${esc(hazard.data.mitigation)}</div>` : '')\n  + (clean(hazard.data?.fallback) ? `<div style='margin-top:.6cqw;font:400 1.6cqw/1.5 ${SERIF};color:#334155'><b style='color:${RED}'>If it happens:</b> ${esc(hazard.data.fallback)}</div>` : '')\n  + `</div>`;\n\nconst notice = flagged.length\n  ? `<div style='margin-top:2.6cqw;padding:1.4cqw 2cqw;border-radius:1.2cqw;background:#fffbeb;border:1px solid #fde68a;color:${AMBER};font:600 1.5cqw/1.5 ${SANS}'>${plural(flagged.length, 'thing', 'things')} to check: ${flagged.map((node) => esc(nameOf(node))).join(', ')}</div>`\n  : '';\nconst aimLimits = aim ? sourcesOf(aim, 'limits', 'limit') : [];\n\nconst detail = `<div style='container-type:inline-size;width:100%;height:100%;overflow:auto;background:${PAPER};font-family:${SERIF};color:${INK}'>`\n  + `<div style='box-sizing:border-box;min-height:100%;padding:4.4cqw 7cqw 5cqw'>`\n  + `<div style='font:700 1.3cqw/1 ${MONO};letter-spacing:.3em;text-transform:uppercase;color:${TEAL}'>Plan ${aimStatus === 'done' ? chip('Done', TEAL, true) : (aimStatus === 'underway' ? chip('Underway', TEAL) : chip('Draft', MUTED))}</div>`\n  + `<div style='font:700 5.2cqw/1.12 ${SERIF};margin:1.4cqw 0 .8cqw;color:${INK}'>${esc(name)}</div>`\n  + (lead ? `<div style='font:400 2.1cqw/1.5 ${SERIF};color:#334155;margin-top:2cqw;max-width:62cqw'>${esc(lead)}</div>` : '')\n  + `<div style='margin-top:1.6cqw;font:600 1.6cqw/1.4 ${SANS};color:${MUTED}'>${plural(phases.length, 'phase', 'phases')} · ${stepsDone} of ${plural(allSteps.length, 'step', 'steps')} done · ${reached} of ${plural(milestones.length, 'milestone', 'milestones')} reached · ${plural(hazards.length, 'risk', 'risks')}</div>`\n  + notice\n  + (aimLimits.length || limits.length ? heading('Within these limits') + (limits.length ? limits.map((limit) => `<div style='margin-bottom:1.4cqw'><div style='font:700 1.8cqw/1.3 ${SERIF};color:${INK}'>${esc(nameOf(limit))}${flag(limit)}</div>${para(limit.data?.body)}</div>`).join('') : '') : '')\n  + (phases.length ? heading('The plan') + phases.map(phaseBlock).join('') : '')\n  + (loose.length ? heading('Steps not in a phase') + loose.map(stepLine).join('') : '')\n  + (hazards.length ? heading('What could go wrong') + hazards.map(hazardBlock).join('') : '')\n  + `</div></div>`;\n\nconst flagSvg = (size, colour) => `<svg viewBox='0 0 64 64' style='width:${size};height:${size};display:block' aria-hidden='true'><g fill='none' stroke='${colour}' stroke-width='5' stroke-linecap='round' stroke-linejoin='round'><path d='M16 58V8'/><path d='M16 10H48L40 22L48 34H16'/></g></svg>`;\nconst counts = `${plural(phases.length, 'phase', 'phases')} · ${plural(allSteps.length, 'step', 'steps')}`;\nconst summary = `<div style='container-type:inline-size;width:100%;height:100%'><div style='box-sizing:border-box;width:100%;height:100%;padding:7cqw 8cqw;border-radius:6cqw;background:${PAPER};border:.9cqw solid ${TEAL};display:flex;align-items:center;gap:6cqw;color:${INK};overflow:hidden'>`\n  + `<div style='flex:0 0 24cqw'>${flagSvg('100%', TEAL)}</div><div style='min-width:0;flex:1'>`\n  + `<div style='font:700 3.2cqw/1 ${MONO};letter-spacing:.24em;text-transform:uppercase;color:${TEAL}'>Plan</div>`\n  + `<div style='font:700 8.2cqw/1.12 ${SERIF};margin:2cqw 0 1.2cqw;display:-webkit-box;-webkit-line-clamp:3;-webkit-box-orient:vertical;overflow:hidden'>${esc(name)}</div>`\n  + `<div style='font:600 3.6cqw/1.3 ${SANS};color:#334155'>${counts}</div>`\n  + `<div style='margin-top:2cqw;font:700 3.8cqw/1.3 ${SANS};color:${aimStatus === 'done' ? TEAL : MUTED}'>${esc(standing)}</div>`\n  + `<div style='margin-top:1.4cqw;font:600 3.2cqw/1.3 ${SANS};color:${MUTED}'>${plural(milestones.length, 'milestone', 'milestones')} · ${plural(hazards.length, 'risk', 'risks')}</div>`\n  + (flagged.length ? `<div style='margin-top:2cqw;display:inline-block;padding:.8cqw 2.4cqw;border-radius:9cqw;background:#fffbeb;border:1px solid #fde68a;color:${AMBER};font:700 3cqw/1.3 ${SANS};letter-spacing:.06em;text-transform:uppercase'>${flagged.length} to check</div>` : '')\n  + `</div></div></div>`;\n\nconst faces = nodes.filter((node) => clean(node.type) === 'face');\nconst faceFor = (level) => faces.find((node) => clean(node.data?.semanticLevel) === level);\nconst glyph = nodes.find((node) => clean(node.type) === 'glyph');\nfor (const [level, html] of [['detail', detail], ['summary', summary]]) {\n  const target = faceFor(level);\n  if (target) await api.updateView(target.id, { content: { kind: 'html', value: html } });\n}\nif (glyph) await api.updateNode(glyph.id, { data: { ...glyph.data, glyph: { kind: 'icon', name: 'Flag', color: TEAL } } });\nreturn { name, phases: phases.length, steps: allSteps.length, stepsDone, milestones: milestones.length, reached, risks: hazards.length, toCheck: flagged.length };\n",
        "effects": [
          {
