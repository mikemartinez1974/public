    {
      "id": "method-demo-probe",
      "type": "property",
      "label": "Probe",
      "position": {
        "x": 0,
        "y": 2140
      },
      "width": 420,
      "height": 180,
      "visible": true,
      "data": {
        "name": "Probe",
        "valueType": "number",
        "value": 0,
        "required": false,
        "description": "Change it to run both.",
        "identity": {
          "graphId": "method-demo",
          "nodeId": "method-demo-probe"
        }
      }
    },
    {
      "id": "method-demo-overreach",
      "label": "Overreach",
      "type": "method",
      "position": {
        "x": 520,
        "y": 2140
      },
      "width": 420,
      "height": 230,
      "data": {
        "source": "// Declares an update of Log only. Changing Quorum is not declared, so the host refuses it.\nconst nodes = await api.getNodes();\nconst log = nodes.find((n) => n.id === 'method-demo-log');\nconst quorum = nodes.find((n) => n.id === 'method-demo-quorum');\nlet note;\ntry {\n  await api.updateNode(quorum.id, { data: { ...quorum.data, value: false } });\n  note = 'NOT refused: it changed Quorum.';\n} catch (error) {\n  note = 'Refused: ' + error.message;\n}\nawait api.updateNode(log.id, { data: { ...log.data, value: note } });",
        "scriptName": "Overreach",
        "parameters": [],
        "allowMutations": true,
        "dryRun": false,
        "effects": [
          {
            "kind": "update-node",
            "targets": [
              "method-demo-log"
            ]
          }
        ],
        "identity": {
          "graphId": "method-demo",
          "nodeId": "method-demo-overreach"
        }
      },
      "visible": true
    },
    {
      "id": "method-demo-nosy",
      "label": "Nosy (declares nothing)",
      "type": "method",
      "position": {
        "x": 520,
        "y": 2400
      },
      "width": 420,
      "height": 230,
      "data": {
        "source": "// Declares no effects, so it can only read. Any write is refused.\nconst nodes = await api.getNodes();\nconst log = nodes.find((n) => n.id === 'method-demo-log');\ntry {\n  await api.updateNode(log.id, { data: { ...log.data, value: 'NOT refused' } });\n  return 'NOT refused';\n} catch (error) {\n  return 'Refused: ' + error.message;\n}",
        "scriptName": "Nosy (declares nothing)",
        "parameters": [],
        "allowMutations": false,
        "dryRun": false,
        "effects": [],
        "identity": {
          "graphId": "method-demo",
          "nodeId": "method-demo-nosy"
        }
      },
      "visible": true
    },
    {
      "id": "method-demo-log",
      "type": "property",
      "label": "Log",
      "position": {
        "x": 1040,
        "y": 2140
      },
      "width": 420,
      "height": 180,
      "visible": true,
      "data": {
        "name": "Log",
        "valueType": "text",
        "value": "",
        "required": false,
        "description": "Overreach writes here what happened when it tried to change Quorum.",
        "identity": {
          "graphId": "method-demo",
          "nodeId": "method-demo-log"
        }
      }
    }
