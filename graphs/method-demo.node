    {
      "id": "method-demo-quorum-check",
      "label": "Is there a quorum?",
      "type": "method",
      "position": {
        "x": 520,
        "y": 150
      },
      "width": 420,
      "height": 230,
      "data": {
        "source": "// Runs when Members changes. A quorum is five or more.\nconst nodes = await api.getNodes();\nconst members = nodes.find((n) => n.id === 'method-demo-members');\nconst quorum = nodes.find((n) => n.id === 'method-demo-quorum');\nconst count = Number(members?.data?.value) || 0;\nawait api.updateNode(quorum.id, { data: { ...quorum.data, value: count >= 5 } });",
        "scriptName": "Is there a quorum?",
        "parameters": [],
        "allowMutations": true,
        "dryRun": false,
        "effects": [
          {
            "kind": "update-node",
            "targets": [
              "method-demo-quorum"
            ]
          }
        ],
        "identity": {
          "graphId": "method-demo",
          "nodeId": "method-demo-quorum-check"
        }
      },
      "visible": true
    },
