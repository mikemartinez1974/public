    {
      "id": "navigation-goal",
      "type": "goal",
      "label": "Navigate to declared graph ports without exposing internal nodes",
      "root": true,
      "position": {
        "x": -30.801563001568343,
        "y": -336.6536416535971
      },
      "width": 650.6614566614388,
      "height": 416.5135353134676,
      "ports": [
        {
          "id": "top",
          "label": "top",
          "direction": "input",
          "dataType": "value",
          "angle": 270
        },
        {
          "id": "bottom",
          "label": "bottom",
          "direction": "output",
          "dataType": "value",
          "angle": 90
        }
      ],
      "visible": true,
      "showLabel": true,
      "data": {
        "body": "Twilite graph URLs resolve only declaration-exposed ports. Bare graph addresses and :root reach the declared default; named suffixes reach named exposures; node handles remain internal.",
        "priority": "high",
        "status": "in-progress",
        "owner": "Michael",
        "successMetrics": [
          "Bare and explicit root navigation resolve identically",
          "Named exposed ports navigate to their declared port nodes",
          "Unexposed nodes and handles cannot be reached through graph URLs",
          "Navigation remains valid for HTTPS, GitHub, TLZ, and local graph references"
        ],
        "definitionKey": "goal",
        "_classBinding": {
          "key": "goal",
          "sourceRef": "github://twilite-zone/public/library/classes/nodes/task-planning/goal.node-class.node",
          "ref": "github://twilite-zone/public/library/classes/nodes/task-planning/goal.node-class.node"
        },
        "_bridge": {
          "sourceBridgeNodeId": "bridge-goal",
          "sourceRef": "github://twilite-zone/public/library/classes/nodes/task-planning/goal.node-class.node",
          "classKey": "goal",
          "classRef": "github://twilite-zone/public/library/classes/nodes/task-planning/goal.node-class.node"
        },
        "identity": {
          "graphId": "exposed-port-navigation-declaration"
        },
        "_placement": {
          "version": 1,
          "state": "manually-shaped",
          "source": "manual",
          "updatedAt": 1785266657719,
          "reason": "node-drag"
        }
      }
    },
    {
      "id": "decision-public-address",
      "type": "decision",
      "label": "Public URLs address graph exposures",
      "root": false,
      "position": {
        "x": -980,
        "y": 180
      },
      "width": 430,
      "height": 260,
      "ports": [
        {
          "id": "top",
          "label": "top",
          "direction": "input",
          "dataType": "value",
          "angle": 270
        }
      ],
      "visible": true,
      "showLabel": true,
      "data": {
        "rationale": "The declaration is the graph's public authority boundary. An internal node ID or handle name does not become navigable merely because it is known.",
        "body": "Supported public forms are graph.node, graph.node:root, and graph.node:port-name. Hash node IDs and handle IDs are not part of the public graph-navigation contract.",
        "status": "decided",
        "decidedAt": "2026-07-28",
        "owner": "Michael",
        "definitionKey": "decision",
        "_classBinding": {
          "key": "decision",
          "sourceRef": "github://twilite-zone/public/library/classes/nodes/task-planning/decision.node-class.node",
          "ref": "github://twilite-zone/public/library/classes/nodes/task-planning/decision.node-class.node"
        },
        "_bridge": {
          "sourceBridgeNodeId": "bridge-decision",
          "sourceRef": "github://twilite-zone/public/library/classes/nodes/task-planning/decision.node-class.node",
          "classKey": "decision",
          "classRef": "github://twilite-zone/public/library/classes/nodes/task-planning/decision.node-class.node"
        },
        "identity": {
          "graphId": "exposed-port-navigation-declaration"
        }
      }
    },
    {
      "id": "decision-root-alias",
      "type": "decision",
      "label": "Root is a virtual alias for the default exposed port",
      "position": { "x": -500, "y": 180 },
      "width": 430,
      "height": 260,
      "ports": [
        {
          "id": "top",
          "label": "top",
          "direction": "input",
          "dataType": "value",
          "angle": 270
        }
      ],
      "visible": true,
      "showLabel": true,
      "data": {
        "rationale": "Root names a public entry role. It is not a literal port name, node ID, handle, or internal address.",
        "body": "A graph with no exposed ports opens normally. A graph with one exposed port automatically uses it as root and the editor should persist that choice. A graph with multiple exposed ports requires a valid defaultSurfaceId. Leaving the suffix off and explicitly adding :root are equivalent.",
        "status": "decided",
        "decidedAt": "2026-07-28",
        "owner": "Michael",
        "definitionKey": "decision",
        "_classBinding": {
          "key": "decision",
          "sourceRef": "github://twilite-zone/public/library/classes/nodes/task-planning/decision.node-class.node",
          "ref": "github://twilite-zone/public/library/classes/nodes/task-planning/decision.node-class.node"
        },
        "_bridge": {
