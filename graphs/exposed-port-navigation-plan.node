        },
        "identity": {
          "graphId": "exposed-port-navigation-declaration"
        }
      }
    },
    {
      "id": "decision-directed-default",
      "type": "decision",
      "label": "Navigation is one-way by default",
      "root": false,
      "position": {
        "x": -20,
        "y": 180
      },
      "width": 430,
      "height": 260,
      "ports": [
        {
          "id": "top",
          "label": "top",
          "direction": "input",
          "dataType": "value",
          "angle": 270
        }
      ],
      "visible": true,
      "showLabel": true,
      "data": {
        "rationale": "A return path requires another authored portal and exposed port. Reciprocity is an explicit agreement rather than an accidental capability.",
        "body": "Portal navigation originates outward and an exposed graph port receives it. Bidirectional capability must be deliberately declared.",
        "status": "decided",
        "decidedAt": "2026-07-28",
        "owner": "Michael",
        "definitionKey": "decision",
        "_classBinding": {
          "key": "decision",
          "sourceRef": "github://twilite-zone/public/library/classes/nodes/task-planning/decision.node-class.node",
