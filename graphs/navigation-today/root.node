        "_bridge": {
          "sourceNodeId": "today-page-template",
          "sourceBridgeNodeId": "today-page-template",
          "sourceBridgeLabel": "Page Template",
          "sourceRef": "tlz://twilite.zone/library/templates/page-template/classes/page-section.node-class.node",
