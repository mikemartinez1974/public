      "position": {
        "x": -180,
        "y": 80
      },
      "width": 520,
      "height": 320,
      "data": {
        "presentation": {
          "glyph": {
            "kind": "icon",
            "name": "Article"
          },
          "baseLevel": "detail"
        },
        "definitionKey": "page-section",
        "_classBinding": {
          "key": "page-section",
          "sourceRef": "tlz://twilite.zone/library/templates/page-template/classes/page-section.node-class.node",
