      ],
      "visible": true,
      "showLabel": true,
      "data": {
        "title": "Primitive Without Authored Views",
        "markdown": "# Primitive Node\n\nThis ordinary markdown node proves that semantic zoom does not require every author to create four custom surfaces. Native glyph and dot fallbacks must always remain available."
      }
    },
