        "title": "Semantic Zoom Fallback Smoke Test",
        "purpose": "Prove all five semantic bands, authored view changes, stable focus, and downward-only fallback.",
        "view": { "intent": "node", "payload": "node.web", "surfaceId": "root" },
        "renderShape": { "kind": "svg" },
        "svg": "<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 700 330' role='img' aria-label='Semantic Zoom Fallback Smoke Test'><defs><linearGradient id='z' x1='0' y1='0' x2='1' y2='1'><stop stop-color='#111827'/><stop offset='.55' stop-color='#4c1d95'/><stop offset='1' stop-color='#0f766e'/></linearGradient></defs><rect x='5' y='5' width='690' height='320' rx='34' fill='url(#z)' stroke='#a78bfa' stroke-width='3'/><text x='48' y='70' fill='#ddd6fe' font-family='system-ui,sans-serif' font-size='15' font-weight='800' letter-spacing='.18em'>GRAPH LAB · SEMANTIC ZOOM</text><text x='48' y='132' fill='white' font-family='system-ui,sans-serif' font-size='34' font-weight='850'>Dot · Glyph · Icon · Summary · Detail</text><circle cx='65' cy='218' r='8' fill='#67e8f9'/><rect x='100' y='200' width='82' height='36' rx='18' fill='#312e81' stroke='#a78bfa' stroke-width='3'/><rect x='220' y='184' width='92' height='68' rx='18' fill='#0f766e' stroke='#5eead4' stroke-width='3'/><rect x='350' y='166' width='125' height='104' rx='20' fill='#172554' stroke='#93c5fd' stroke-width='3'/><rect x='515' y='145' width='135' height='145' rx='22' fill='#172554' stroke='#f0abfc' stroke-width='3'/><path d='M75 218h21m90 0h30m100 0h30m133 0h32' stroke='#c4b5fd' stroke-width='4'/><text x='48' y='306' fill='#ccfbf1' font-family='system-ui,sans-serif' font-size='16'>Focus stays readable; missing views only simplify.</text></svg>",
        "altText": "Five increasingly detailed semantic representations connected from dot through detail."
