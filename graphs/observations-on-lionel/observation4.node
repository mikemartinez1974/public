        "title": "Lionel Argument Audit Study 04",
        "purpose": "Preserve a fourth specimen and distinguish an adversarial media audit from a source-led annotated reaction.",
        "view": {
          "intent": "node",
          "payload": "node.web.summary",
          "label": "Lionel Argument Audit Study 04"
        },
        "payload": "node.web.summary",
        "intent": "node",
        "key": "node.web.summary",
