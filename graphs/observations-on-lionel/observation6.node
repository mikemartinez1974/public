          "direction": "bidirectional",
          "dataType": "value",
          "angle": 180
        }
      ],
      "visible": true,
      "showLabel": false,
      "data": {
        "identity": {
          "graphId": "lionel-live-synthesis-study-06"
        },
        "markdown": "# 📏 Confidence and Next Test\n\n## High confidence\n- branch-and-return navigation is a real Lionel live-stream behavior\n- live chat can trigger structural branches rather than merely provide rapport\n- Study 06 is distinct from the queue-led Study 05\n- actor-field and coalition mapping are genuine analytical operations\n- distributed research is better modeled as information flow than as a flat source list\n- `sequenceController` and `navigationMode` should be separate concepts\n\n## Medium confidence\n- `Associative Realignment Monologue` is the best final template name\n- Topic Thread should be visible in production graphs rather than hidden metadata\n- Actor Field and Coalition deserve explicit nodes\n- Lionel Maps Coalition Realignment deserves a show-specific class\n\n## Next useful test\nAnother long live stream should tell us whether branch-and-return is a recurring template or simply Lionel's default live navigation style across several otherwise different formats.",
        "memo": "",
        "link": "",
        "visibilityRole": "browser",
        "_placement": {
          "version": 1,
          "state": "auto-placed",
          "source": "create",
          "updatedAt": 1786058390624,
          "reason": "node-batch-create"
        }
      }
    }
