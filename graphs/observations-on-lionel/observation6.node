    {
      "id": "lionel-study06-confidence",
      "type": "markdown",
      "label": "Confidence and Next Test",
      "root": false,
      "position": {
        "x": 1700,
        "y": 1200
      },
      "width": 720,
      "height": 590,
      "ports": [
        {
          "id": "root",
