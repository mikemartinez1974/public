        "title": "Lionel Validation Study 07",
        "purpose": "Test whether the existing Lionel grammar can explain a new specimen without proliferating new classes.",
        "view": {
          "intent": "node",
          "payload": "node.web.summary",
          "label": "Lionel Validation Study 07"
        },
        "payload": "node.web.summary",
        "intent": "node",
