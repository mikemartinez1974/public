    {
      "id": "lionel-study02-compare",
      "type": "markdown",
      "label": "Comparison with Study 01",
      "root": false,
      "position": {
        "x": -760,
        "y": 1040
      },
      "width": 700,
      "height": 540,
      "ports": [
        {
