    {
      "id": "lionel-study02-moves",
      "type": "markdown",
      "label": "Editorial Moves",
      "root": false,
      "position": {
        "x": 200,
        "y": 430
      },
      "width": 590,
      "height": 520,
      "ports": [
        {
          "id": "root",
