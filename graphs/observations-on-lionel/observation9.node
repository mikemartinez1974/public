    {
      "id": "lionel-study09-bundle",
      "type": "markdown",
      "label": "New Refinement · Evidence Bundle",
      "root": false,
      "position": {
        "x": -310,
        "y": 540
      },
      "width": 680,
      "height": 580,
      "ports": [
