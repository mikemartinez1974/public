    {
      "id": "lionel-study05-compare",
      "type": "markdown",
      "label": "Comparison Across Five Studies",
      "root": false,
      "position": {
        "x": 3200,
        "y": 500
      },
      "width": 740,
      "height": 650,
      "ports": [
        {
