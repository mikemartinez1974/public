        "title": "Lionel Multi-Clip Roundup Study 05",
        "purpose": "Preserve the first clear specimen of a Lionel episode driven by a queue of loosely connected media clips rather than one source or one linear proof.",
        "view": {
          "intent": "node",
          "payload": "node.web.summary",
          "label": "Lionel Multi-Clip Roundup Study 05"
        },
        "payload": "node.web.summary",
