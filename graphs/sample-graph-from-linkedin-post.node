          "angle": 0
        },
        {
          "id": "bottom",
          "label": "bottom",
          "direction": "bidirectional",
          "dataType": "value",
          "angle": 90
        },
        {
          "id": "left",
          "label": "left",
          "direction": "bidirectional",
          "dataType": "value",
          "angle": 180
        }
      ],
      "visible": true,
      "showLabel": false,
      "data": {
        "markdown": "# ⚡ The Real Shift: Convergence\n\nThe most capable AI products increasingly combine multiple abilities:\n\n- language models to interpret and generate\n- vision models to see\n- routing systems to select expertise\n- action systems to plan and use tools\n- segmentation models to isolate visual objects\n\n**The breakthrough is not merely one model becoming smarter. It is specialized architectures being orchestrated into systems that can read, see, reason, and act together.**",
        "identity": {
          "graphId": "eight-ai-model-architectures"
        },
        "memo": "",
        "link": "",
        "visibilityRole": "browser",
        "_placement": {
          "version": 1,
          "state": "auto-placed",
          "source": "create",
          "updatedAt": 1786024515001,
          "reason": "node-batch-create"
        }
      }
    },
    {
      "id": "taxonomy",
      "type": "markdown",
      "label": "Taxonomy Note",
      "root": false,
      "position": {
        "x": 660,
        "y": 820
      },
      "width": 470,
      "height": 300,
      "color": "linear-gradient(135deg,#0f172a,#334155)",
      "ports": [
        {
          "id": "root",
          "label": "root",
          "direction": "bidirectional",
          "dataType": "any",
          "angle": 210
        },
        {
          "id": "top",
