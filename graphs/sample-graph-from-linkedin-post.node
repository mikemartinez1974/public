          "angle": 270
        },
        {
          "id": "right",
          "label": "right",
          "direction": "bidirectional",
          "dataType": "value",
          "angle": 0
        },
        {
          "id": "bottom",
          "label": "bottom",
          "direction": "bidirectional",
          "dataType": "value",
          "angle": 90
        },
        {
          "id": "left",
          "label": "left",
          "direction": "bidirectional",
          "dataType": "value",
          "angle": 180
        }
      ],
      "visible": true,
      "showLabel": false,
      "data": {
        "markdown": "# 🧾 Taxonomy Note\n\nThis is a useful explainer, not a perfectly uniform scientific taxonomy.\n\nThe labels describe different dimensions:\n\n- **scale:** LLM, SLM\n- **training objective:** MLM\n- **modality:** VLM\n- **routing architecture:** MoE\n- **task or system role:** LAM, SAM\n- **emerging abstraction:** LCM\n\nA single modern system may fit several labels at once.",
        "identity": {
          "graphId": "eight-ai-model-architectures"
        },
        "memo": "",
        "link": "",
        "visibilityRole": "browser",
        "_placement": {
          "version": 1,
          "state": "auto-placed",
          "source": "create",
          "updatedAt": 1786024515001,
          "reason": "node-batch-create"
        }
      }
    },
