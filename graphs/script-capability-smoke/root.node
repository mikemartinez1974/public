      ],
      "data": {
        "memo": "Imports the capability graph's exposed Script entry for deliberate placement.",
        "bridge": {
          "ref": "github://mikemartinez1974/public/templates/collection-window-controller/root.node",
          "role": "import",
          "resourceKind": "capability-kit",
          "scope": "focused-graph",
