        "title": "Script Capability Placement Smoke",
        "purpose": "Prove that reusable behavior arrives through a capability graph instead of copied script-node configuration.",
        "renderShape": { "kind": "svg" },
        "svg": "<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 700 330'><defs><linearGradient id='g' x1='0' y1='0' x2='1' y2='1'><stop stop-color='#172554'/><stop offset='1' stop-color='#0f766e'/></linearGradient></defs><rect x='5' y='5' width='690' height='320' rx='34' fill='url(#g)' stroke='#5eead4' stroke-width='3'/><text x='50' y='72' fill='#99f6e4' font-family='system-ui' font-size='14' font-weight='800' letter-spacing='.18em'>PLACEABLE BEHAVIOR PROOF</text><text x='50' y='132' fill='white' font-family='system-ui' font-size='39' font-weight='850'>Script Capability Smoke</text><path d='M90 220h130m55 0h130m55 0h130' stroke='#5eead4' stroke-width='5'/><circle cx='245' cy='220' r='28' fill='#14b8a6'/><circle cx='435' cy='220' r='28' fill='#14b8a6'/><text x='50' y='290' fill='#ccfbf1' font-family='system-ui' font-size='17'>Bridge → place → configure → fire → observe</text></svg>",
