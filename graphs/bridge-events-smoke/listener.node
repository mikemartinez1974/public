          "direction": "bidirectional",
          "dataType": "any",
          "angle": 180,
          "portId": "root"
        }
      ],
      "visible": true,
      "showLabel": true,
      "data": {
        "identity": {
          "graphId": "bridge-events-listener",
          "nodeId": "bridge-events-listener-use-emitter"
        },
        "memo": "The one Bridge to the emitter. Its event shows as a port.",
        "bridge": {
          "ref": "github://mikemartinez1974/public/graphs/bridge-events-smoke/emitter.node",
          "resourceKind": "graph",
          "scope": "focused-graph",
          "grants": [
            "read"
          ],
          "exposure": {
