        "content": {
          "kind": "html",
          "value": "<article style='container-type:inline-size;box-sizing:border-box;width:100%;height:100%;padding:6cqw;background:#0b3a66;color:#e6f2ff;font-family:system-ui,sans-serif'><div style='font-size:3.4cqw;letter-spacing:.2em;color:#7cc4ff'>LISTENER</div><div style='font-size:16cqw;font-weight:800;line-height:1.05;margin:3cqw 0'>Nothing yet</div><p style='font-size:3.6cqw;line-height:1.5;max-width:60ch;color:#cfe6ff'>Waiting for the emitter</p><p style='font-size:3cqw;line-height:1.5;max-width:60ch;color:#9fc4e8'>This graph imports the emitter. When the emitter's Temperature changes, the Method here runs and writes what it heard into this tile.</p></article>"
