          }
        }
      }
    },
    {
      "id": "bridge-events-listener-hear",
      "type": "method",
      "label": "Note the change",
      "position": {
        "x": 900,
        "y": 380
      },
      "width": 460,
      "height": 260,
      "ports": [
        {
          "id": "call",
          "key": "call",
          "label": "Call",
          "direction": "input",
          "dataType": "event",
          "angle": 180
        },
        {
          "id": "result",
          "key": "result",
          "label": "Result",
          "direction": "output",
          "dataType": "value",
          "angle": 0
        }
      ],
      "handles": [
        {
          "id": "call",
          "key": "call",
          "label": "Call",
          "direction": "input",
          "dataType": "event",
          "angle": 180,
          "portId": "call"
        },
        {
          "id": "result",
          "key": "result",
          "label": "Result",
          "direction": "output",
          "dataType": "value",
          "angle": 0,
          "portId": "result"
        }
      ],
      "visible": true,
      "showLabel": true,
      "data": {
        "scriptName": "Note the change",
        "parameters": [],
        "source": "// Runs when the emitter's Temperature changes. It writes what it heard into this graph's own Property and faces.\nconst faces = (title, big, small, note) => ({\n  summary: \"<div style='container-type:inline-size;box-sizing:border-box;width:100%;height:100%;padding:6cqw;background:#0b3a66;color:#e6f2ff;font-family:system-ui,sans-serif'><div style='font-size:5cqw;letter-spacing:.2em;color:#7cc4ff'>\" + title.toUpperCase() + \"</div><div style='font-size:22cqw;font-weight:800;line-height:1.05;margin:3cqw 0'>\" + big + \"</div><div style='font-size:6cqw;color:#cfe6ff'>\" + small + \"</div></div>\",\n  detail: \"<article style='container-type:inline-size;box-sizing:border-box;width:100%;height:100%;padding:6cqw;background:#0b3a66;color:#e6f2ff;font-family:system-ui,sans-serif'><div style='font-size:3.4cqw;letter-spacing:.2em;color:#7cc4ff'>\" + title.toUpperCase() + \"</div><div style='font-size:16cqw;font-weight:800;line-height:1.05;margin:3cqw 0'>\" + big + \"</div><p style='font-size:3.6cqw;line-height:1.5;max-width:60ch;color:#cfe6ff'>\" + small + \"</p><p style='font-size:3cqw;line-height:1.5;max-width:60ch;color:#9fc4e8'>\" + note + \"</p></article>\"\n});\nconst heard = api.invocation || {};\nconst change = heard.eventPayload || {};\nconst node = await api.getNode('bridge-events-listener-last-heard');\nconst when = new Date().toISOString().slice(11, 19);\nconst text = `${when}: temperature ${change.previousValue ?? '?'} -> ${change.value ?? '?'}`;\nawait api.updateNode(node.id, { data: { ...node.data, value: text } });\nconst big = `${change.value ?? '?'}°`;\nconst page = faces('Listener', big, 'Heard at ' + when + ', was ' + (change.previousValue ?? '?') + '°', \"This graph imports the emitter. When the emitter's Temperature changes, the Method here runs and writes what it heard into this tile.\");\nfor (const name of ['summary', 'detail']) {\n  const face = await api.getNode('bridge-events-listener-' + name);\n  await api.updateNode(face.id, { data: { ...face.data, content: { kind: 'html', value: page[name] } } });\n}\nreturn { heard: text };",
        "effects": [
          {
            "kind": "update-node",
            "targets": [
              "bridge-events-listener-last-heard",
              "bridge-events-listener-summary",
              "bridge-events-listener-detail"
            ]
          }
        ],
        "allowMutations": true,
        "dryRun": false,
        "identity": {
          "graphId": "bridge-events-listener",
          "nodeId": "bridge-events-listener-hear"
        }
      }
    }
  ],
