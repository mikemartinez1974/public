      "data": {
        "content": {
          "kind": "markdown",
          "value": "# Bridge events: the listener\n\nThis graph **imports** the emitter. The import shows the emitter's offered event as a port, and an edge from that port leads to this graph's own **Method**.\n\nWhen the Temperature changes in the emitter, the Method runs here and writes what it heard into **Last heard**.\n\nOpen the emitter beside this graph and change the Temperature."
        },
        "interfaceContract": {
          "version": 1,
          "receivesViewContent": true
        },
        "identity": {
          "graphId": "bridge-events-listener",
          "nodeId": "bridge-events-listener-landing"
        }
      }
    },
