          "value": "<div style='container-type:inline-size;width:100%;height:100%'><div style='box-sizing:border-box;width:100%;height:100%;padding:7cqw 8cqw;border-radius:6cqw;background:#f7f9fc;border:.9cqw solid #1e40af;display:flex;align-items:center;gap:6cqw;color:#1f2937;overflow:hidden'><div style='flex:0 0 24cqw'><svg viewBox='0 0 64 64' style='width:100%;height:100%;display:block' aria-hidden='true'><g fill='none' stroke='#1e40af' stroke-width='5' stroke-linecap='round' stroke-linejoin='round'><path d='M32 56V36'/><path d='M32 36L14 16'/><path d='M32 36L50 16'/><path d='M14 28V16H26'/><path d='M38 16H50V28'/></g></svg></div><div style='min-width:0;flex:1'><div style='font:700 3.2cqw/1 ui-monospace,SFMono-Regular,Menlo,Consolas,monospace;letter-spacing:.24em;text-transform:uppercase;color:#1e40af'>Decision</div><div style='font:700 8.2cqw/1.12 Georgia,Iowan Old Style,Palatino Linotype,serif;margin:2cqw 0 1.2cqw;display:-webkit-box;-webkit-line-clamp:3;-webkit-box-orient:vertical;overflow:hidden'>Which template should we build next?</div><div style='font:600 3.6cqw/1.3 Inter,system-ui,Segoe UI,Helvetica Neue,Arial,sans-serif;color:#334155'>3 options · 3 criteria</div><div style='margin-top:2cqw;font:700 3.8cqw/1.3 Inter,system-ui,Segoe UI,Helvetica Neue,Arial,sans-serif;color:#b45309'>Chose Decision</div></div></div></div>"
