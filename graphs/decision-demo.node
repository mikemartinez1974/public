    {
      "id": "next-template-derive-method",
      "type": "method",
      "label": "Derive the decision views",
      "position": {
        "x": 190,
        "y": 1233
      },
      "width": 420,
      "height": 260,
      "ports": [
        {
          "id": "call",
          "key": "call",
          "label": "Call",
          "direction": "input",
          "dataType": "event",
          "angle": 180
        },
        {
          "id": "result",
          "key": "result",
          "label": "Result",
          "direction": "output",
          "dataType": "value",
          "angle": 0
        }
      ],
      "handles": [
        {
          "id": "call",
          "key": "call",
          "label": "Call",
          "direction": "input",
          "dataType": "event",
          "angle": 180,
          "portId": "call"
        },
        {
          "id": "result",
          "key": "result",
          "label": "Result",
          "direction": "output",
          "dataType": "value",
          "angle": 0,
          "portId": "result"
        }
      ],
      "visible": true,
      "showLabel": true,
      "data": {
        "scriptName": "Derive the decision views",
        "parameters": [],
        "source": "// Derives a decision's views from its cards: nothing is typed into a view.\n// It reads the Decision (the card of that type), its Options, the Criteria that matter, the Notes, and the edges between them: `favors` and `counts-against` from a criterion to an option (the label says\n// why), and `chose` from the decision to the option a person picked (the label says why). It writes the Detail (a short memo), the Summary (a card), the Icon (a fork in the road) and the Glyph, and only\n// those, which its declared effects say. It counts what favors and what counts against each option and shows the counts and the weights; it never adds them into a score, and it never picks: a choice is\n// the `chose` edge, drawn by a person. Anything a card marks `check` (\"I am not sure this is right\") is gathered in a notice at the top of the page and on the card.\nconst clean = (value) => String(value ?? '').trim();\nconst esc = (value) => clean(value).replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/\"/g, '&quot;').replace(/'/g, '&#39;');\nconst SERIF = 'Georgia,Iowan Old Style,Palatino Linotype,serif'; const SANS = 'Inter,system-ui,Segoe UI,Helvetica Neue,Arial,sans-serif'; const MONO = 'ui-monospace,SFMono-Regular,Menlo,Consolas,monospace';\nconst NAVY = '#1e40af'; const INK = '#1f2937'; const PAPER = '#f7f9fc'; const MUTED = '#64748b'; const AMBER = '#92400e'; const GREEN = '#15803d'; const RED = '#b91c1c'; const GOLD = '#b45309'; const PURPLE = '#7e22ce';\n\nconst nodes = await api.getNodes();\nconst edges = await api.getEdges();\nconst ofType = (type) => nodes.filter((node) => clean(node.type) === type);\nconst decision = ofType('choice')[0] || null;\nconst nameOf = (node) => clean(node?.data?.title || node?.label) || 'Untitled';\nconst joined = (type, from) => edges.filter((e) => clean(e.type) === type && (!from || e.source === from.id));\nconst byId = (id) => nodes.find((node) => node.id === id);\n\n// the options the decision is between, in the order its edges give; any option no edge reaches follows\nconst allOptions = ofType('option');\nconst listed = joined('has-option', decision).map((e) => byId(e.target)).filter((node) => node && clean(node.type) === 'option');\nconst options = [...new Set([...listed, ...allOptions])];\nconst criteria = ofType('criterion');\nconst notes = ofType('note');\nconst WEIGHTS = { low: 1, medium: 2, high: 3 };\nconst weightOf = (criterion) => WEIGHTS[clean(criterion?.data?.weight).toLowerCase()] || 2;\nconst weightName = (criterion) => ['', 'low', 'medium', 'high'][weightOf(criterion)];\nconst dots = (criterion, colour) => `<span style='letter-spacing:.12em;color:${colour};font-size:1.5cqw' title='${weightName(criterion)}'>${'●'.repeat(weightOf(criterion))}<span style='opacity:.25'>${'●'.repeat(3 - weightOf(criterion))}</span></span>`;\n\n// what counts for and against each option\nconst reasons = (option, type) => joined(type, null).filter((e) => e.target === option.id).map((e) => ({ criterion: byId(e.source), why: clean(e.label) })).filter((r) => r.criterion && clean(r.criterion.type) === 'criterion');\nconst tally = options.map((option) => ({ option, favors: reasons(option, 'favors'), against: reasons(option, 'counts-against') }));\nconst chosenEdge = joined('chose', decision)[0] || null;\nconst chosen = chosenEdge ? byId(chosenEdge.target) : null;\nconst flagged = [decision, ...options, ...criteria, ...notes].filter((node) => node && node.data?.check === true);\nconst marked = clean(decision?.data?.status) === 'decided';\nconst name = decision ? nameOf(decision) : 'Name the decision';\nconst lead = clean(decision?.data?.body);\nconst standing = chosen ? `Chose ${nameOf(chosen)}` : (marked ? 'Marked decided, no option chosen' : 'Still open');\n\nconst flag = (node) => (node?.data?.check === true ? `<span style='display:inline-block;margin-left:1cqw;padding:.2cqw 1cqw;border-radius:9cqw;background:#fffbeb;border:1px solid #fde68a;color:${AMBER};font:700 1.2cqw/1.4 ${SANS};letter-spacing:.06em;text-transform:uppercase;vertical-align:middle'>to check</span>` : '');\nconst heading = (text) => `<div style='font:700 1.3cqw/1 ${MONO};letter-spacing:.24em;text-transform:uppercase;color:${NAVY};margin:4cqw 0 1.6cqw;padding-top:2cqw;border-top:.15cqw solid rgba(30,64,175,.35)'>${text}</div>`;\nconst para = (text) => (clean(text) ? `<div style='font:400 1.7cqw/1.55 ${SERIF};color:#334155;margin-top:.4cqw'>${esc(text)}</div>` : '');\nconst status = `<span style='display:inline-block;padding:.3cqw 1.4cqw;border-radius:9cqw;font:700 1.3cqw/1.4 ${SANS};letter-spacing:.06em;text-transform:uppercase;vertical-align:middle;${chosen ? `background:${NAVY};color:#fff` : `background:#fff;color:${NAVY};border:1px solid ${NAVY}`}'>${chosen ? 'Decided' : 'Open'}</span>`;\n\nconst reasonLine = (r, colour, mark) => `<div style='display:flex;gap:1.2cqw;align-items:baseline;margin-top:.7cqw'><span style='color:${colour};font:800 1.7cqw/1.3 ${SANS}'>${mark}</span><span style='font:400 1.6cqw/1.5 ${SERIF};color:#334155'><b style='font-weight:700;color:${INK}'>${esc(nameOf(r.criterion))}</b> ${dots(r.criterion, colour)}${r.why ? ` · ${esc(r.why)}` : ''}${flag(r.criterion)}</span></div>`;\nconst optionBlock = ({ option, favors, against }) => `<div style='margin-bottom:2.6cqw;padding:2cqw 2.4cqw;border-radius:1.2cqw;background:#fff;border:${option === chosen ? `.3cqw solid ${GOLD}` : '1px solid #e2e8f0'}'>`\n  + `<div style='display:flex;justify-content:space-between;gap:2cqw;align-items:baseline'><div style='font:700 2.1cqw/1.3 ${SERIF};color:${INK}'>${esc(nameOf(option))}${option === chosen ? `<span style='margin-left:1.4cqw;color:${GOLD};font:800 1.3cqw/1 ${SANS};letter-spacing:.1em;text-transform:uppercase'>chosen</span>` : ''}${flag(option)}</div>`\n  + `<div style='flex:0 0 auto;font:600 1.4cqw/1.3 ${SANS};color:${MUTED};white-space:nowrap'><span style='color:${GREEN}'>${favors.length} for</span> · <span style='color:${RED}'>${against.length} against</span></div></div>`\n  + para(option.data?.body)\n  + favors.map((r) => reasonLine(r, GREEN, '+')).join('') + against.map((r) => reasonLine(r, RED, '−')).join('')\n  + (!favors.length && !against.length ? `<div style='font:italic 1.5cqw/1.5 ${SERIF};color:${MUTED};margin-top:.8cqw'>Nothing yet counts for or against this one.</div>` : '')\n  + `</div>`;\n\nconst notice = flagged.length\n  ? `<div style='margin-top:2.6cqw;padding:1.4cqw 2cqw;border-radius:1.2cqw;background:#fffbeb;border:1px solid #fde68a;color:${AMBER};font:600 1.5cqw/1.5 ${SANS}'>${flagged.length} ${flagged.length === 1 ? 'thing' : 'things'} to check: ${flagged.map((node) => esc(nameOf(node))).join(', ')}</div>`\n  : '';\nconst landed = chosen\n  ? `<div style='padding:2.2cqw 2.6cqw;border-radius:1.2cqw;background:#fff;border:.3cqw solid ${GOLD}'><div style='font:700 2.4cqw/1.3 ${SERIF};color:${INK}'>${esc(nameOf(chosen))}</div>${chosenEdge.label ? `<div style='font:italic 1.8cqw/1.5 ${SERIF};color:#334155;margin-top:.8cqw'>${esc(chosenEdge.label)}</div>` : ''}</div>`\n  : `<div style='font:italic 1.9cqw/1.5 ${SERIF};color:${MUTED}'>${marked ? 'Marked decided, but no option has been chosen.' : 'Still open: no option has been chosen.'}</div>`;\n\nconst detail = `<div style='container-type:inline-size;width:100%;height:100%;overflow:auto;background:${PAPER};font-family:${SERIF};color:${INK}'>`\n  + `<div style='box-sizing:border-box;min-height:100%;padding:4.4cqw 7cqw 5cqw'>`\n  + `<div style='font:700 1.3cqw/1 ${MONO};letter-spacing:.3em;text-transform:uppercase;color:${NAVY}'>Decision ${status}</div>`\n  + `<div style='font:700 5.2cqw/1.12 ${SERIF};margin:1.4cqw 0 .8cqw;color:${INK}'>${esc(name)}</div>`\n  + (lead ? `<div style='font:400 2.1cqw/1.5 ${SERIF};color:#334155;margin-top:2cqw;max-width:62cqw'>${esc(lead)}</div>` : '')\n  + notice\n  + (notes.length ? heading('Worth knowing') + notes.map((note) => `<div style='margin-bottom:1.6cqw'><div style='font:700 1.8cqw/1.3 ${SERIF};color:${INK}'>${esc(nameOf(note))}${flag(note)}</div>${para(note.data?.body)}</div>`).join('') : '')\n  + (criteria.length ? heading('What matters') + criteria.map((c) => `<div style='margin-bottom:1.8cqw'><div style='font:700 1.8cqw/1.3 ${SERIF};color:${INK}'>${esc(nameOf(c))} ${dots(c, PURPLE)}${flag(c)}</div>${para(c.data?.body)}</div>`).join('') : '')\n  + (options.length ? heading('The options') + tally.map(optionBlock).join('') : '')\n  + heading('Where this landed') + landed\n  + `</div></div>`;\n\nconst fork = (size, colour) => `<svg viewBox='0 0 64 64' style='width:${size};height:${size};display:block' aria-hidden='true'><g fill='none' stroke='${colour}' stroke-width='5' stroke-linecap='round' stroke-linejoin='round'><path d='M32 56V36'/><path d='M32 36L14 16'/><path d='M32 36L50 16'/><path d='M14 28V16H26'/><path d='M38 16H50V28'/></g></svg>`;\nconst counts = `${options.length} ${options.length === 1 ? 'option' : 'options'} · ${criteria.length} ${criteria.length === 1 ? 'criterion' : 'criteria'}`;\nconst summary = `<div style='container-type:inline-size;width:100%;height:100%'><div style='box-sizing:border-box;width:100%;height:100%;padding:7cqw 8cqw;border-radius:6cqw;background:${PAPER};border:.9cqw solid ${NAVY};display:flex;align-items:center;gap:6cqw;color:${INK};overflow:hidden'>`\n  + `<div style='flex:0 0 24cqw'>${fork('100%', NAVY)}</div><div style='min-width:0;flex:1'>`\n  + `<div style='font:700 3.2cqw/1 ${MONO};letter-spacing:.24em;text-transform:uppercase;color:${NAVY}'>Decision</div>`\n  + `<div style='font:700 8.2cqw/1.12 ${SERIF};margin:2cqw 0 1.2cqw;display:-webkit-box;-webkit-line-clamp:3;-webkit-box-orient:vertical;overflow:hidden'>${esc(name)}</div>`\n  + `<div style='font:600 3.6cqw/1.3 ${SANS};color:#334155'>${counts}</div>`\n  + `<div style='margin-top:2cqw;font:700 3.8cqw/1.3 ${SANS};color:${chosen ? GOLD : MUTED}'>${esc(standing)}</div>`\n  + (flagged.length ? `<div style='margin-top:2cqw;display:inline-block;padding:.8cqw 2.4cqw;border-radius:9cqw;background:#fffbeb;border:1px solid #fde68a;color:${AMBER};font:700 3cqw/1.3 ${SANS};letter-spacing:.06em;text-transform:uppercase'>${flagged.length} to check</div>` : '')\n  + `</div></div></div>`;\n\nconst icon = `<div style='container-type:inline-size;width:100%;height:100%;display:flex;align-items:center;justify-content:center'><div style='box-sizing:border-box;height:100%;max-width:100%;aspect-ratio:1/1;border-radius:50%;background:#eff6ff;border:4cqmin solid ${NAVY};display:flex;align-items:center;justify-content:center'>${fork('62%', NAVY)}</div></div>`;\n\nconst faces = nodes.filter((node) => clean(node.type) === 'face');\nconst faceFor = (level) => faces.find((node) => clean(node.data?.semanticLevel) === level);\nconst glyph = nodes.find((node) => clean(node.type) === 'glyph');\nfor (const [level, html] of [['detail', detail], ['summary', summary], ['icon', icon]]) {\n  const target = faceFor(level);\n  if (target) await api.updateView(target.id, { content: { kind: 'html', value: html } });\n}\nif (glyph) await api.updateNode(glyph.id, { data: { ...glyph.data, glyph: { kind: 'icon', name: 'AltRoute', color: NAVY } } });\nreturn { name, options: options.length, criteria: criteria.length, notes: notes.length, chosen: chosen ? nameOf(chosen) : null, toCheck: flagged.length };\n",
        "effects": [
          {
            "kind": "update-node",
            "targets": [
              "next-template-detail",
              "next-template-summary",
              "next-template-glyph",
              "next-template-environment",
              "next-template-icon"
            ]
          }
        ],
        "allowMutations": true,
        "dryRun": false,
        "identity": {
          "graphId": "next-template-declaration"
        }
      }
    },
