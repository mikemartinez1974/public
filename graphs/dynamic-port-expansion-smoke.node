        "html": "<div style='width:100%;height:100%;box-sizing:border-box;border-radius:28px;background:linear-gradient(145deg,#111827,#1e3a5f);border:3px solid #60a5fa;color:#f8fafc;padding:32px;font-family:system-ui,sans-serif;display:flex;flex-direction:column;justify-content:center'><div style='font-size:13px;font-weight:900;letter-spacing:.16em;color:#93c5fd'>GRAPH LAB · RUNTIME CONTRACT</div><div style='font-size:38px;font-weight:950;line-height:1.08;margin-top:12px'>Dynamic Port Expansion</div><div style='font-size:17px;line-height:1.5;color:#dbeafe;margin-top:18px'>Three static section records must become three labeled output handles. Dragging one must create a seeded Wikipedia Section instance.</div><div style='font-size:13px;color:#bfdbfe;margin-top:22px'>No network resolution is involved in this fixture.</div></div>"
