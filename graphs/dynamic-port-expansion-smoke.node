    {
      "id": "dynamic-port-expansion-article",
      "type": "wikipedia-article-source",
      "label": "Static Article Manifest",
      "root": true,
      "position": {"x": -300, "y": -80},
      "width": 680,
      "height": 500,
      "visible": true,
      "showLabel": false,
      "ports": [{"id": "root", "label": "root", "direction": "bidirectional", "dataType": "any", "angle": 210}],
      "data": {
        "canonicalUrl": "https://en.wikipedia.org/wiki/Graph_(discrete_mathematics)",
        "title": "Graph (discrete mathematics)",
        "revisionId": "static-smoke-fixture",
        "lead": "This fixture supplies static derived data so dynamic handle behavior can be tested independently of source resolution.",
        "firstSection": {
          "id": "definitions",
          "title": "Definitions",
          "content": "A graph consists of vertices and edges. This content is intentionally authored into the smoke fixture."
        },
        "sections": [
          {"id": "definitions", "title": "Definitions", "level": 1, "order": 1, "sourceLocator": "section:definitions"},
          {"id": "applications", "title": "Applications", "level": 1, "order": 2, "sourceLocator": "section:applications"},
          {"id": "history", "title": "History", "level": 1, "order": 3, "sourceLocator": "section:history"}
        ],
        "attribution": {"source": "Wikipedia", "license": "CC BY-SA", "licenseUrl": "https://creativecommons.org/licenses/by-sa/4.0/"},
        "dynamicPortContract": {
          "sourcePath": "sections",
          "idPath": "id",
          "labelPath": "title",
          "orderPath": "order",
          "direction": "output",
          "dataType": "wikipedia-section",
          "hoverLabel": true,
          "expansion": {
            "mode": "instantiate-node-class",
            "classKey": "wikipedia-section",
            "classRef": "github://mikemartinez1974/public/templates/wikipedia-article-template/classes/nodes/wikipedia-section.node-class.node",
            "seed": {
              "articleUrl": "$source.data.canonicalUrl",
              "articleTitle": "$source.data.title",
              "revisionId": "$source.data.revisionId",
              "sectionId": "$item.id",
              "sectionTitle": "$item.title",
              "sectionLevel": "$item.level",
              "sectionOrder": "$item.order",
              "sourceLocator": "$item.sourceLocator"
            }
          }
        },
        "definitionKey": "wikipedia-article-source",
        "_classBinding": {
          "key": "wikipedia-article-source",
          "sourceRef": "github://mikemartinez1974/public/templates/wikipedia-article-template/classes/nodes/wikipedia-article-source.node-class.node"
        },
        "_bridge": {
          "classKey": "wikipedia-article-source",
          "classRef": "github://mikemartinez1974/public/templates/wikipedia-article-template/classes/nodes/wikipedia-article-source.node-class.node",
          "entryPort": "root",
          "kind": "node-class",
