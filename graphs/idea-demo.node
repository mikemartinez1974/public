    {
      "id": "tectonics-derive-method",
      "type": "method",
      "label": "Derive the idea views",
      "position": {
        "x": -50,
        "y": 1233
      },
      "width": 420,
      "height": 260,
      "ports": [
        {
          "id": "call",
          "key": "call",
          "label": "Call",
          "direction": "input",
          "dataType": "event",
          "angle": 180
        },
        {
          "id": "result",
          "key": "result",
          "label": "Result",
          "direction": "output",
          "dataType": "value",
          "angle": 0
        }
      ],
      "handles": [
        {
          "id": "call",
          "key": "call",
          "label": "Call",
          "direction": "input",
          "dataType": "event",
          "angle": 180,
          "portId": "call"
        },
        {
          "id": "result",
          "key": "result",
          "label": "Result",
          "direction": "output",
          "dataType": "value",
          "angle": 0,
          "portId": "result"
        }
      ],
      "visible": true,
      "showLabel": true,
      "data": {
        "scriptName": "Derive the idea views",
        "parameters": [],
        "source": "// Derives an idea map's views from its cards: nothing is typed into a view.\n// It reads the Idea (the card of that type: the subject), its Points (a part, a reason, an example or an objection), its Questions, and the edges between them: `leads-to` from one card to the next (its label is\n// the connecting word: because, so, but, for example) and `asks` from an idea or point to a question it leaves open. It writes the Detail (the idea explained, walked outward from the centre with the labels as\n// the connecting words, then what is still open), the Summary (a card) and the Glyph, and only those, which its declared effects say. It counts what there is and what is still open and shows the counts; it never\n// scores an idea, and it never decides an idea is right. Anything a card marks `check` (\"I am not sure this is right\") is gathered in a notice at the top and on the card.\nconst clean = (value) => String(value ?? '').trim();\nconst esc = (value) => clean(value).replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/\"/g, '&quot;').replace(/'/g, '&#39;');\nconst SERIF = 'Georgia,Iowan Old Style,Palatino Linotype,serif'; const SANS = 'Inter,system-ui,Segoe UI,Helvetica Neue,Arial,sans-serif'; const MONO = 'ui-monospace,SFMono-Regular,Menlo,Consolas,monospace';\nconst CORAL = '#c2410c'; const INK = '#1f2937'; const PAPER = '#fffaf5'; const MUTED = '#64748b'; const AMBER = '#92400e'; const BLUE = '#0369a1'; const PURPLE = '#7e22ce'; const GREEN = '#15803d'; const RED = '#b91c1c';\n\nconst nodes = await api.getNodes();\nconst edges = await api.getEdges();\nconst ofType = (type) => nodes.filter((node) => clean(node.type) === type);\nconst byId = (id) => nodes.find((node) => node.id === id);\nconst nameOf = (node) => clean(node?.data?.title || node?.label) || 'Untitled';\nconst edgesOf = (type) => edges.filter((e) => clean(e.type) === type);\n\nconst notion = ofType('notion')[0] || null;\nconst points = ofType('point');\nconst queries = ofType('query');\nconst flagged = [notion, ...points, ...queries].filter((node) => node && node.data?.check === true);\nconst openQueries = queries.filter((q) => clean(q.data?.status) !== 'answered');\nconst name = notion ? nameOf(notion) : 'Name the idea';\nconst lead = clean(notion?.data?.body);\nconst plural = (n, one, many) => `${n} ${n === 1 ? one : many}`;\nconst ROLES = { part: ['Part', BLUE], reason: ['Reason', GREEN], example: ['Example', CORAL], objection: ['Objection', RED] };\nconst roleOf = (point) => ROLES[clean(point.data?.role)] || ROLES.part;\nconst askedBy = (node) => edgesOf('asks').filter((e) => e.source === node.id).map((e) => byId(e.target)).filter((q) => q && clean(q.type) === 'query');\n\n// walk outward from the idea along leads-to, each card once, in the order the edges give\nconst outline = []; const seen = new Set(notion ? [notion.id] : []);\nconst walk = (from, depth) => {\n  for (const e of edgesOf('leads-to').filter((edge) => edge.source === from.id)) {\n    const next = byId(e.target);\n    if (!next || seen.has(next.id) || clean(next.type) !== 'point') continue;\n    seen.add(next.id); outline.push({ node: next, label: clean(e.label), depth }); walk(next, depth + 1);\n  }\n};\nif (notion) walk(notion, 0);\nconst apart = points.filter((point) => !seen.has(point.id));\n\nconst flag = (node) => (node?.data?.check === true ? `<span style='display:inline-block;margin-left:1cqw;padding:.2cqw 1cqw;border-radius:9cqw;background:#fffbeb;border:1px solid #fde68a;color:${AMBER};font:700 1.2cqw/1.4 ${SANS};letter-spacing:.06em;text-transform:uppercase;vertical-align:middle'>to check</span>` : '');\nconst heading = (text) => `<div style='font:700 1.3cqw/1 ${MONO};letter-spacing:.24em;text-transform:uppercase;color:${CORAL};margin:4cqw 0 1.6cqw;padding-top:2cqw;border-top:.15cqw solid rgba(194,65,12,.35)'>${text}</div>`;\nconst para = (text, size = 1.7) => (clean(text) ? `<div style='font:400 ${size}cqw/1.55 ${SERIF};color:#334155;margin-top:.4cqw'>${esc(text)}</div>` : '');\nconst chip = (text, colour) => `<span style='display:inline-block;padding:.3cqw 1.3cqw;border-radius:9cqw;font:700 1.2cqw/1.4 ${SANS};letter-spacing:.06em;text-transform:uppercase;vertical-align:middle;background:#fff;color:${colour};border:1px solid ${colour}'>${text}</span>`;\nconst questionLine = (q) => `<div style='margin-top:.9cqw;padding:1cqw 1.6cqw;border-radius:1cqw;background:#faf5ff;border:1px solid #e9d5ff;font:italic 1.6cqw/1.5 ${SERIF};color:${PURPLE}'>${clean(q.data?.status) === 'answered' ? 'Settled' : 'Still unsure'}: <b style='font-style:normal'>${esc(nameOf(q))}</b>${flag(q)}${clean(q.data?.body) ? ` <span style='color:#334155'>${esc(q.data.body)}</span>` : ''}</div>`;\n\nconst pointBlock = ({ node, label, depth }) => {\n  const [roleName, colour] = roleOf(node);\n  return `<div style='margin:0 0 2cqw ${Math.min(depth, 4) * 3.2}cqw;padding:1.8cqw 2.2cqw;border-radius:1.2cqw;background:#fff;border:1px solid #e2e8f0;border-left:.6cqw solid ${colour}'>`\n    + (label ? `<div style='font:italic 1.5cqw/1.4 ${SERIF};color:${MUTED};margin-bottom:.5cqw'>${esc(label)}</div>` : '')\n    + `<div style='display:flex;justify-content:space-between;gap:2cqw;align-items:baseline'><div style='font:700 2cqw/1.3 ${SERIF};color:${INK}'>${esc(nameOf(node))}${flag(node)}</div><div style='flex:0 0 auto'>${chip(roleName, colour)}</div></div>`\n    + para(node.data?.body) + askedBy(node).map(questionLine).join('') + `</div>`;\n};\nconst notice = flagged.length\n  ? `<div style='margin-top:2.6cqw;padding:1.4cqw 2cqw;border-radius:1.2cqw;background:#fffbeb;border:1px solid #fde68a;color:${AMBER};font:600 1.5cqw/1.5 ${SANS}'>${plural(flagged.length, 'thing', 'things')} to check: ${flagged.map((node) => esc(nameOf(node))).join(', ')}</div>`\n  : '';\nconst asker = (q) => edgesOf('asks').filter((e) => e.target === q.id).map((e) => byId(e.source)).filter(Boolean)[0] || null;\n\nconst detail = `<div style='container-type:inline-size;width:100%;height:100%;overflow:auto;background:${PAPER};font-family:${SERIF};color:${INK}'>`\n  + `<div style='box-sizing:border-box;min-height:100%;padding:4.4cqw 7cqw 5cqw'>`\n  + `<div style='font:700 1.3cqw/1 ${MONO};letter-spacing:.3em;text-transform:uppercase;color:${CORAL}'>Idea map</div>`\n  + `<div style='font:700 5.2cqw/1.12 ${SERIF};margin:1.4cqw 0 .8cqw;color:${INK}'>${esc(name)}</div>`\n  + (lead ? `<div style='font:400 2.1cqw/1.5 ${SERIF};color:#334155;margin-top:2cqw;max-width:62cqw'>${esc(lead)}</div>` : '')\n  + `<div style='margin-top:1.6cqw;font:600 1.6cqw/1.4 ${SANS};color:${MUTED}'>${plural(points.length, 'point', 'points')} · ${queries.length ? `${openQueries.length} of ${plural(queries.length, 'question', 'questions')} open` : 'no open questions'}</div>`\n  + notice\n  + (notion && askedBy(notion).length ? askedBy(notion).map(questionLine).join('') : '')\n  + (outline.length ? heading('The idea, explained') + outline.map(pointBlock).join('') : '')\n  + (apart.length ? heading('Also in the map') + apart.map((p) => pointBlock({ node: p, label: '', depth: 0 })).join('') : '')\n  + (openQueries.length ? heading('Still open') + openQueries.map((q) => `<div style='margin-bottom:1.4cqw'><div style='font:700 1.8cqw/1.3 ${SERIF};color:${PURPLE}'>${esc(nameOf(q))}${flag(q)}</div>${asker(q) ? `<div style='font:600 1.3cqw/1.5 ${SANS};color:${MUTED}'>Raised by ${esc(nameOf(asker(q)))}</div>` : ''}${para(q.data?.body)}</div>`).join('') : '')\n  + `</div></div>`;\n\nconst bulb = (size, colour) => `<svg viewBox='0 0 64 64' style='width:${size};height:${size};display:block' aria-hidden='true'><g fill='none' stroke='${colour}' stroke-width='5' stroke-linecap='round' stroke-linejoin='round'><path d='M24 44C24 38 14 34 14 24A18 18 0 0 1 50 24C50 34 40 38 40 44'/><path d='M24 44H40'/><path d='M26 52H38'/><path d='M29 58H35'/></g></svg>`;\nconst objections = points.filter((p) => clean(p.data?.role) === 'objection').length;\nconst summary = `<div style='container-type:inline-size;width:100%;height:100%'><div style='box-sizing:border-box;width:100%;height:100%;padding:7cqw 8cqw;border-radius:6cqw;background:${PAPER};border:.9cqw solid ${CORAL};display:flex;align-items:center;gap:6cqw;color:${INK};overflow:hidden'>`\n  + `<div style='flex:0 0 24cqw'>${bulb('100%', CORAL)}</div><div style='min-width:0;flex:1'>`\n  + `<div style='font:700 3.2cqw/1 ${MONO};letter-spacing:.24em;text-transform:uppercase;color:${CORAL}'>Idea</div>`\n  + `<div style='font:700 8.2cqw/1.12 ${SERIF};margin:2cqw 0 1.2cqw;display:-webkit-box;-webkit-line-clamp:3;-webkit-box-orient:vertical;overflow:hidden'>${esc(name)}</div>`\n  + `<div style='font:600 3.6cqw/1.3 ${SANS};color:#334155'>${plural(points.length, 'point', 'points')}${objections ? ` · ${plural(objections, 'objection', 'objections')}` : ''}</div>`\n  + `<div style='margin-top:2cqw;font:700 3.8cqw/1.3 ${SANS};color:${openQueries.length ? PURPLE : MUTED}'>${queries.length ? `${openQueries.length} of ${plural(queries.length, 'question', 'questions')} open` : 'No open questions'}</div>`\n  + (flagged.length ? `<div style='margin-top:2cqw;display:inline-block;padding:.8cqw 2.4cqw;border-radius:9cqw;background:#fffbeb;border:1px solid #fde68a;color:${AMBER};font:700 3cqw/1.3 ${SANS};letter-spacing:.06em;text-transform:uppercase'>${flagged.length} to check</div>` : '')\n  + `</div></div></div>`;\n\nconst faces = nodes.filter((node) => clean(node.type) === 'face');\nconst faceFor = (level) => faces.find((node) => clean(node.data?.semanticLevel) === level);\nconst glyph = nodes.find((node) => clean(node.type) === 'glyph');\nfor (const [level, html] of [['detail', detail], ['summary', summary]]) {\n  const target = faceFor(level);\n  if (target) await api.updateView(target.id, { content: { kind: 'html', value: html } });\n}\nif (glyph) await api.updateNode(glyph.id, { data: { ...glyph.data, glyph: { kind: 'icon', name: 'Lightbulb', color: CORAL } } });\nreturn { name, points: points.length, questions: queries.length, openQuestions: openQueries.length, toCheck: flagged.length, reached: outline.length, apart: apart.length };\n",
        "effects": [
          {
            "kind": "update-node",
            "targets": [
              "tectonics-detail",
              "tectonics-summary",
              "tectonics-glyph",
              "tectonics-environment"
            ]
          }
        ],
        "allowMutations": true,
        "dryRun": false,
        "identity": {
          "graphId": "tectonics-declaration"
        }
      }
    },
    {
      "id": "tectonics-environment",
      "type": "face",
      "label": "Task environment",
      "position": {
        "x": -500,
        "y": -1387
      },
      "width": 400,
      "height": 240,
      "ports": [
        {
          "id": "root",
          "key": "root",
          "label": "root",
          "direction": "input",
          "dataType": "any",
          "angle": 270
        }
      ],
      "handles": [
        {
          "id": "root",
          "key": "root",
          "label": "root",
          "direction": "input",
          "dataType": "any",
          "angle": 270,
          "portId": "root"
        }
      ],
      "visible": true,
      "showLabel": true,
      "data": {
        "identity": {
          "graphId": "tectonics-declaration"
        },
        "view": {
          "intent": "node",
          "payload": "node.web.environment",
          "fit": "window",
          "stage": {
            "left": 13.5,
            "right": 3.5,
            "top": 22,
            "bottom": 8
          }
        },
        "content": {
          "kind": "html",
