          "label": "root",
          "type": "any"
        }
      ],
      "outputs": [
        {
          "key": "root",
          "label": "root",
          "type": "any"
        }
      ],
      "visible": true,
      "showLabel": true,
      "data": {
        "markdown": "## Pass procedure\n\n1. Run **Compose Action Port** once.\n2. Confirm ordinary `port`, `view`, and `content` nodes appear.\n3. Confirm the Declaration exposes `scripted-action-port`.\n4. Confirm the Port owns its Detail View and the View points to Content.\n5. Run the script again.\n6. Confirm no node, edge, or surface duplicates appear.\n7. Change the Content text in the script and run again; the existing Content node should update.\n8. An input Port with `drag-create` must be rejected before the graph changes."
      }
    }
