        "semanticLevel": "detail",
        "renderShape": {
          "kind": "markdown",
          "profile": "markdown.default"
        },
        "markdown": "# Scripted Port Composition\n\nRun the script twice. The first run authors an Action Port, Detail View, and Content node. The second run must update the same stable records without duplicates."
      }
    },
    {
      "id": "scripted-port-smoke-script",
      "type": "script",
      "label": "Compose Action Port",
      "position": {
        "x": -620,
        "y": 80
      },
      "width": 520,
      "height": 360,
      "ports": [
        {
          "id": "root",
          "label": "root",
          "direction": "bidirectional",
          "dataType": "any",
          "angle": 210
        }
      ],
      "inputs": [
        {
          "key": "root",
          "label": "root",
          "type": "any"
        }
      ],
      "outputs": [
        {
          "key": "root",
          "label": "root",
          "type": "any"
        }
      ],
      "visible": true,
      "showLabel": true,
      "data": {
        "name": "Compose Action Port",
        "source": "const result = await api.composePort({\n  id: 'scripted-action-port',\n  label: 'Action',\n  direction: 'output',\n  accepts: 'section',\n  position: { x: 620, y: 80 },\n  detail: {\n    mode: 'own',\n    content: {\n      id: 'scripted-action-content',\n      label: 'Action Content',\n      kind: 'markdown',\n      value: '# Action\\n\\nThis durable Content node was authored through `api.composePort()`.'\n    }\n  },\n  summary: { mode: 'fallback' },\n  behavior: {\n    trigger: 'drag-create',\n    action: 'create-node',\n    nodeType: 'section',\n    targetPort: 'root'\n  }\n});\nreturn result;",
        "autoRun": false
      }
    },
    {
      "id": "scripted-port-smoke-procedure",
      "type": "markdown",
      "label": "Pass Procedure",
      "position": {
        "x": 0,
        "y": 80
      },
      "width": 520,
      "height": 400,
      "ports": [
        {
          "id": "root",
          "label": "root",
          "direction": "bidirectional",
          "dataType": "any",
