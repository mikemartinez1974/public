        "svg": "<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 700 360' role='img' aria-label='Interaction Arbiter Smoke Test'><defs><linearGradient id='g' x1='0' y1='0' x2='1' y2='1'><stop stop-color='#111827'/><stop offset='.55' stop-color='#1e3a8a'/><stop offset='1' stop-color='#0f766e'/></linearGradient></defs><rect x='5' y='5' width='690' height='350' rx='34' fill='url(#g)' stroke='#67e8f9' stroke-width='3'/><text x='48' y='78' fill='#a5f3fc' font-family='system-ui,sans-serif' font-size='15' font-weight='800' letter-spacing='.18em'>GRAPH LAB · PHASE 2</text><text x='48' y='140' fill='white' font-family='system-ui,sans-serif' font-size='42' font-weight='850'>Interaction Arbiter</text><text x='48' y='184' fill='#cffafe' font-family='system-ui,sans-serif' font-size='25' font-weight='700'>Smoke Test</text><g transform='translate(50 228)' fill='none' stroke='#67e8f9' stroke-width='4'><rect width='120' height='70' rx='16'/><path d='M145 35h92m-18-18 18 18-18 18'/><circle cx='292' cy='35' r='31'/><path d='M347 35h92m-18-18 18 18-18 18'/><rect x='465' width='120' height='70' rx='16'/></g><text x='50' y='327' fill='#ccfbf1' font-family='system-ui,sans-serif' font-size='16'>Handles · controls · scroll · nodes · edges · canvas</text></svg>",
