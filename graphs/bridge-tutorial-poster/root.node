    {
      "id": "bridge-tutorial-poster-try",
      "type": "page-section",
      "label": "Try it",
      "position": {
        "x": 930,
        "y": -200
      },
      "width": 1100,
      "height": 560,
      "data": {
        "title": "Try it",
        "body": "1. Switch to edit mode (the pencil). Imports and exports are shown only while you edit.\n2. Press Add node and choose Import. A card appears.\n3. Select it and press Edit. Give it the address of the graph it uses, say what it is (a whole graph, or one node class) and what it may do with it: read, create, update or execute.\n4. In the graph that offers something, add an Export. List what it offers: classes, Methods, or events. Nothing is offered until it is listed.\n5. Open both graphs in the workspace. The import is drawn joined to the export it uses. That line is the Bridge.\n6. To hear an event across it, list the event on the export. The import shows it as a port, and the importing graph draws an invokes edge from that port to a Method of its own.",
        "presentation": {
          "glyph": {
            "kind": "icon",
            "name": "Article"
          },
          "baseLevel": "detail"
        },
        "identity": {
          "graphId": "bridge-tutorial-poster"
