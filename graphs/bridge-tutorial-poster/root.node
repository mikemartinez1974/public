    {
      "id": "bridge-tutorial-poster-what",
      "type": "page-section",
      "label": "What they are",
      "position": {
        "x": -270,
        "y": -200
      },
      "width": 1100,
      "height": 560,
      "data": {
        "title": "What they are",
        "body": "An import is where a graph uses something from another graph. An export is where a graph offers something to whoever imports it. They are the two ends of a Bridge. Nothing crosses unless the importing graph asks and the exporting graph offers, so one graph never reaches into another by accident.",
        "presentation": {
          "glyph": {
            "kind": "icon",
            "name": "Article"
          },
          "baseLevel": "detail"
        },
        "identity": {
          "graphId": "bridge-tutorial-poster"
        },
        "classRef": "tlz://twilite.zone/library/templates/page-template/classes/page-section.node-class.node"
      },
