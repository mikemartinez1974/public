      "data": {
        "title": "At a glance",
        "rows": [
          {
            "label": "Node types",
            "value": "import, export"
          },
          {
            "label": "Shown when browsing",
            "value": "No, only when editing"
          },
          {
            "label": "Points at",
            "value": "a class, a set of classes, or a whole graph"
          },
          {
            "label": "On the border",
            "value": "imports left, exports right"
          },
          {
            "label": "Joined by",
            "value": "a Bridge, drawn from an export to the import that uses it"
          }
        ],
