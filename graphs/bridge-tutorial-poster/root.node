    {
      "id": "bridge-tutorial-poster-crosses",
      "type": "page-section",
      "label": "What crosses a Bridge",
      "position": {
        "x": 2130,
        "y": -200
      },
      "width": 1100,
      "height": 560,
      "data": {
        "title": "What crosses a Bridge",
        "body": "What an export lists: the classes it hands on, the Methods a graph that imports it may run, and the events it announces. An import says what it takes and what it may do with it. The Bridge itself is drawn from the two ends while both graphs are open; it is not stored, and it is not a grant.",
        "presentation": {
          "glyph": {
            "kind": "icon",
            "name": "Article"
          },
          "baseLevel": "detail"
        },
        "identity": {
          "graphId": "bridge-tutorial-poster"
        },
