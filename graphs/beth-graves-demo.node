    {
      "id": "beth-graves-subject",
      "type": "person",
      "label": "Beth Graves",
      "position": {
        "x": 1065,
        "y": -377
      },
      "width": 520,
      "height": 260,
      "ports": [
        {
          "id": "knew-out",
          "key": "knew-out",
          "label": "knew",
