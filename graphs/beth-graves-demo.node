    {
      "id": "beth-graves-derive-method",
      "type": "method",
      "label": "Derive the profile views",
      "position": {
        "x": 190,
        "y": 1233
      },
      "width": 420,
      "height": 260,
      "ports": [
        {
          "id": "call",
          "key": "call",
          "label": "Call",
          "direction": "input",
          "dataType": "event",
          "angle": 180
        },
        {
          "id": "result",
          "key": "result",
          "label": "Result",
          "direction": "output",
          "dataType": "value",
          "angle": 0
        }
      ],
      "handles": [
        {
          "id": "call",
          "key": "call",
          "label": "Call",
          "direction": "input",
          "dataType": "event",
          "angle": 180,
          "portId": "call"
        },
        {
          "id": "result",
          "key": "result",
          "label": "Result",
          "direction": "output",
          "dataType": "value",
          "angle": 0,
          "portId": "result"
        }
      ],
      "visible": true,
      "showLabel": true,
      "data": {
        "scriptName": "Derive the profile views",
        "parameters": [],
        "source": "// Derives a person's profile views from the cards: nothing is typed into a view.\n// It reads the person the profile is about (the Person card marked `subject`), the Events (in the order of their `when`), the other People (with how the subject knew them, from the label of the `knew` edge) and the Works (in\n// the order of their `year`), and writes the Detail (a page that reads like an article), the Summary (a card), the Icon (just the face) and the Glyph (a person). It writes only those four, which its declared effects say.\n// Anything a card marks `check` (\"I am not sure this fact is right\") is gathered in a notice at the top of the page and on the card, so the profile shows what still needs checking.\nconst clean = (value) => String(value ?? '').trim();\nconst esc = (value) => clean(value).replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/\"/g, '&quot;').replace(/'/g, '&#39;');\nconst SERIF = 'Georgia,Iowan Old Style,Palatino Linotype,serif'; const SANS = 'Inter,system-ui,Segoe UI,Helvetica Neue,Arial,sans-serif'; const MONO = 'ui-monospace,SFMono-Regular,Menlo,Consolas,monospace';\nconst TEAL = '#0f766e'; const INK = '#1f2937'; const PAPER = '#faf7f0'; const MUTED = '#64748b'; const AMBER = '#92400e';\n\nconst nodes = await api.getNodes();\nconst edges = await api.getEdges();\nconst ofType = (type) => nodes.filter((node) => clean(node.type) === type);\nconst people = ofType('person');\nconst subject = people.find((p) => p.data?.subject === true)\n  || people.find((p) => edges.some((e) => e.source === p.id && ['took-part-in', 'made'].includes(clean(e.type))))\n  || people[0] || null;\nconst others = people.filter((p) => p !== subject);\nconst yearOf = (value) => { const m = /-?\\d{3,4}/.exec(clean(value)); return m ? Number(m[0]) : null; };\nconst byTime = (key) => (a, b) => { const x = yearOf(a.data?.[key]); const y = yearOf(b.data?.[key]); if (x === null && y === null) return 0; if (x === null) return 1; if (y === null) return -1; return x - y; };\nconst events = ofType('event').sort(byTime('when'));\nconst works = ofType('work').sort(byTime('year'));\nconst nameOf = (node) => clean(node.data?.title || node.label) || 'Untitled';\nconst relation = (person) => clean(edges.find((e) => clean(e.type) === 'knew' && e.source === subject?.id && e.target === person.id)?.label);\nconst flagged = [...people, ...events, ...works].filter((node) => node.data?.check === true);\nconst name = subject ? nameOf(subject) : 'Name the person';\nconst years = subject ? [clean(subject.data?.born), clean(subject.data?.died)].filter(Boolean).join(' to ') : '';\nconst lead = clean(subject?.data?.body);\n\nconst flag = (node) => (node.data?.check === true ? `<span style='display:inline-block;margin-left:1cqw;padding:.2cqw 1cqw;border-radius:9cqw;background:#fffbeb;border:1px solid #fde68a;color:${AMBER};font:700 1.2cqw/1.4 ${SANS};letter-spacing:.06em;text-transform:uppercase;vertical-align:middle'>to check</span>` : '');\nconst heading = (text) => `<div style='font:700 1.3cqw/1 ${MONO};letter-spacing:.24em;text-transform:uppercase;color:${TEAL};margin:4cqw 0 1.6cqw;padding-top:2cqw;border-top:.15cqw solid rgba(15,118,110,.35)'>${text}</div>`;\nconst para = (text) => (clean(text) ? `<div style='font:400 1.7cqw/1.55 ${SERIF};color:#334155;margin-top:.4cqw'>${esc(text)}</div>` : '');\n\nconst life = events.map((event) => `<div style='display:flex;gap:2.4cqw;margin-bottom:2cqw'><div style='flex:0 0 11cqw;font:800 2.2cqw/1.2 ${SERIF};color:${TEAL}'>${esc(event.data?.when)}</div><div style='min-width:0;flex:1'><div style='font:700 1.9cqw/1.3 ${SERIF};color:${INK}'>${esc(nameOf(event))}${flag(event)}</div>${para(event.data?.body)}</div></div>`).join('');\nconst people_ = others.map((person) => `<div style='margin-bottom:2cqw'><div style='font:700 1.9cqw/1.3 ${SERIF};color:${INK}'>${esc(nameOf(person))}${relation(person) ? `<span style='font:italic 1.6cqw/1.3 ${SERIF};color:${MUTED}'> · ${esc(relation(person))}</span>` : ''}${flag(person)}</div>${para(person.data?.body)}</div>`).join('');\nconst works_ = works.map((work) => `<div style='margin-bottom:2cqw'><div style='font:700 1.9cqw/1.3 ${SERIF};color:${INK}'>${esc(nameOf(work))}${clean(work.data?.year) ? `<span style='font:italic 1.6cqw/1.3 ${SERIF};color:${MUTED}'> · ${esc(work.data.year)}</span>` : ''}${flag(work)}</div>${para(work.data?.body)}</div>`).join('');\nconst notice = flagged.length\n  ? `<div style='margin-top:2.6cqw;padding:1.4cqw 2cqw;border-radius:1.2cqw;background:#fffbeb;border:1px solid #fde68a;color:${AMBER};font:600 1.5cqw/1.5 ${SANS}'>${flagged.length} ${flagged.length === 1 ? 'fact' : 'facts'} to check: ${flagged.map((node) => esc(nameOf(node))).join(', ')}</div>`\n  : '';\n\n// Pictures of the person (`pictures` on the Person card: a list of { src, caption }) are set into the page as figures under the introduction: the first large and the second smaller. Two at most: the page should reach the cards soon.\nconst pictures = (Array.isArray(subject?.data?.pictures) ? subject.data.pictures : []).filter((p) => clean(p?.src)).slice(0, 2);\nconst figures = pictures.length ? `<div style='display:flex;flex-wrap:wrap;gap:2.4cqw;align-items:flex-end;margin-top:3cqw'>${pictures.map((p, i) => `<figure style='margin:0;width:${i === 0 ? 24 : 15}cqw'><img src='${esc(p.src)}' alt='${esc(p.caption)}' style='display:block;width:100%;aspect-ratio:1/1;object-fit:cover;object-position:center 30%;border-radius:1cqw;border:.2cqw solid rgba(15,118,110,.45)'/><figcaption style='margin-top:.8cqw;font:italic 1.3cqw/1.35 ${SERIF};color:${MUTED}'>${esc(p.caption)}</figcaption></figure>`).join('')}</div>` : '';\n\nconst detail = `<div style='container-type:inline-size;width:100%;height:100%;overflow:auto;background:${PAPER};font-family:${SERIF};color:${INK}'>`\n  + `<div style='box-sizing:border-box;min-height:100%;padding:4.4cqw 7cqw 5cqw'>`\n  + `<div style='font:700 1.3cqw/1 ${MONO};letter-spacing:.3em;text-transform:uppercase;color:${TEAL}'>Profile</div>`\n  + `<div style='font:700 5.8cqw/1.1 ${SERIF};margin:1.4cqw 0 .8cqw;color:${INK}'>${esc(name)}</div>`\n  + (years ? `<div style='font:italic 2cqw/1.3 ${SERIF};color:${MUTED}'>${esc(years)}</div>` : '')\n  + (lead ? `<div style='font:400 2.1cqw/1.5 ${SERIF};color:#334155;margin-top:2cqw;max-width:60cqw'>${esc(lead)}</div>` : '')\n  + figures\n  + notice\n  + (events.length ? heading('Life') + life : '')\n  + (others.length ? heading('People') + people_ : '')\n  + (works.length ? heading('Works') + works_ : '')\n  + `</div></div>`;\n\n// A picture of the person, when the Person card carries one (`avatar`: an image address): it is the face in the Summary and the Icon. Without one the face is a drawn figure.\nconst photo = clean(subject?.data?.avatar);\nconst portrait = (size) => `<img src='${esc(photo)}' alt='' style='width:${size};height:${size};display:block;border-radius:50%;object-fit:cover;object-position:center 30%'/>`;\nconst face = (size, colour) => photo ? portrait(size) : `<svg viewBox='0 0 64 64' style='width:${size};height:${size};display:block' aria-hidden='true'><circle cx='32' cy='32' r='31' fill='${colour}' opacity='.14'/><circle cx='32' cy='25' r='11' fill='${colour}'/><path d='M11 56Q13 38 32 38Q51 38 53 56Z' fill='${colour}'/></svg>`;\nconst counts = [`${events.length} ${events.length === 1 ? 'event' : 'events'}`, `${others.length} ${others.length === 1 ? 'person' : 'people'}`, `${works.length} ${works.length === 1 ? 'work' : 'works'}`].join(' · ');\nconst summary = `<div style='container-type:inline-size;width:100%;height:100%'><div style='box-sizing:border-box;width:100%;height:100%;padding:7cqw 8cqw;border-radius:6cqw;background:${PAPER};border:.9cqw solid ${TEAL};display:flex;align-items:center;gap:6cqw;color:${INK};overflow:hidden'>`\n  + `<div style='flex:0 0 28cqw'>${face('100%', TEAL)}</div><div style='min-width:0;flex:1'>`\n  + `<div style='font:700 3.2cqw/1 ${MONO};letter-spacing:.24em;text-transform:uppercase;color:${TEAL}'>Profile</div>`\n  + `<div style='font:700 9cqw/1.08 ${SERIF};margin:2cqw 0 1.2cqw'>${esc(name)}</div>`\n  + (years ? `<div style='font:italic 4.2cqw/1.3 ${SERIF};color:${MUTED}'>${esc(years)}</div>` : '')\n  + `<div style='margin-top:2.4cqw;font:600 3.6cqw/1.3 ${SANS};color:#334155'>${counts}</div>`\n  + (flagged.length ? `<div style='margin-top:2cqw;display:inline-block;padding:.8cqw 2.4cqw;border-radius:9cqw;background:#fffbeb;border:1px solid #fde68a;color:${AMBER};font:700 3cqw/1.3 ${SANS};letter-spacing:.06em;text-transform:uppercase'>${flagged.length} to check</div>` : '')\n  + `</div></div></div>`;\n\nconst icon = `<div style='container-type:inline-size;width:100%;height:100%'><div style='box-sizing:border-box;width:100%;height:100%;border-radius:6cqw;background:#f0fdfa;border:.9cqw solid ${TEAL};display:flex;align-items:center;justify-content:center;overflow:hidden'>${face('50cqw', TEAL)}</div></div>`;\n\nconst faces = nodes.filter((node) => clean(node.type) === 'face');\nconst faceFor = (level) => faces.find((node) => clean(node.data?.semanticLevel) === level);\nconst glyph = nodes.find((node) => clean(node.type) === 'glyph');\nfor (const [level, html] of [['detail', detail], ['summary', summary], ['icon', icon]]) {\n  const target = faceFor(level);\n  if (target) await api.updateView(target.id, { content: { kind: 'html', value: html } });\n}\nif (glyph) await api.updateNode(glyph.id, { data: { ...glyph.data, glyph: { kind: 'icon', name: 'Person', color: TEAL } } });\nreturn { name, events: events.length, people: others.length, works: works.length, toCheck: flagged.length };\n",
        "effects": [
          {
            "kind": "update-node",
            "targets": [
              "beth-graves-detail",
              "beth-graves-summary",
              "beth-graves-glyph",
              "beth-graves-environment",
              "beth-graves-icon"
            ]
          }
        ],
        "allowMutations": true,
        "dryRun": false,
        "identity": {
          "graphId": "beth-graves-declaration"
        }
      }
    },
