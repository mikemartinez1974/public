    {
      "id": "content-tutorial-poster-what",
      "type": "page-section",
      "label": "What it is",
      "position": {
        "x": -520,
        "y": -200
      },
      "width": 720,
      "height": 560,
      "data": {
        "title": "What it is",
        "body": "A Content node holds one piece of material: some writing, a drawing, a picture, a block of data. It does not decide how that material looks. A face shows it, and several faces can show the same Content in different ways, so you change it in one place. Each Content node has a kind that says what sort of material it is: markdown, html, svg, text, json or image.",
        "presentation": {
          "glyph": {
            "kind": "icon",
            "name": "Article"
          },
          "baseLevel": "detail"
        },
        "identity": {
          "graphId": "content-tutorial-poster"
        },
        "classRef": "tlz://twilite.zone/library/templates/page-template/classes/page-section.node-class.node"
