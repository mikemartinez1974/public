    {
      "id": "content-tutorial-poster-try",
      "type": "page-section",
      "label": "Try it",
      "position": {
        "x": 300,
        "y": -200
      },
      "width": 720,
      "height": 560,
      "data": {
        "title": "Try it",
        "body": "1. Switch to edit mode (the pencil).\n2. Press Add node and choose Content. A card appears.\n3. Select the card and press Edit, or double-click it. The card turns into an editor, with a toolbar when the kind is markdown.\n4. Type something. The card follows as you type.\n5. Change the kind from the menu, say to svg or json, and watch the same text show up differently.\n6. Press Done or Esc to put the card back. Clicking elsewhere does the same.\n7. Add a second face, point it at the same Content, and edit once. Both faces change.",
        "presentation": {
          "glyph": {
            "kind": "icon",
            "name": "Article"
          },
          "baseLevel": "detail"
        },
        "identity": {
          "graphId": "content-tutorial-poster"
        },
