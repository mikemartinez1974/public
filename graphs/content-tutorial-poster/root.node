    {
      "id": "content-tutorial-poster-ports",
      "type": "page-section",
      "label": "Ports",
      "position": {
        "x": 1120,
        "y": -200
      },
      "width": 720,
      "height": 560,
      "data": {
        "title": "Ports",
        "body": "A Content node has four ports: in on top, out below, and prev and next at the sides, which chain Content nodes into a sequence. A face reaches its Content through a surface-delegate relationship. Content does not own the face chain.",
        "presentation": {
          "glyph": {
            "kind": "icon",
            "name": "Article"
          },
          "baseLevel": "detail"
