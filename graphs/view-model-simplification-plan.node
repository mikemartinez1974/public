      }
    },
    {
      "id": "view-model-decision-primitives",
      "type": "decision",
      "label": "The public primitives are View, Editor View, and Port",
      "position": { "x": -980, "y": 180 },
      "width": 430,
      "height": 280,
      "visible": true,
      "showLabel": true,
      "ports": [{ "id": "top", "label": "top", "direction": "input", "dataType": "value", "angle": 270 }],
      "data": {
        "rationale": "These three concepts have distinct ownership: presentation, editing, and exposure.",
        "body": "View is always node-facing. Editor View is always editor-facing. Port presents or exposes a View and does not redefine its intent.",
        "status": "decided",
        "owner": "Michael",
        "definitionKey": "decision",
        "_classBinding": { "key": "decision", "sourceRef": "github://twilite-zone/public/library/classes/nodes/task-planning/decision.node-class.node", "ref": "github://twilite-zone/public/library/classes/nodes/task-planning/decision.node-class.node" },
        "_bridge": { "sourceBridgeNodeId": "view-model-bridge-decision", "sourceRef": "github://twilite-zone/public/library/classes/nodes/task-planning/decision.node-class.node", "classKey": "decision", "classRef": "github://twilite-zone/public/library/classes/nodes/task-planning/decision.node-class.node" }
      }
    },
    {
      "id": "view-model-decision-defaults",
      "type": "decision",
      "label": "Ordinary nodes keep automatic views",
      "position": { "x": -500, "y": 180 },
      "width": 430,
      "height": 280,
      "visible": true,
      "showLabel": true,
      "ports": [{ "id": "top", "label": "top", "direction": "input", "dataType": "value", "angle": 270 }],
      "data": {
        "rationale": "Explicit View nodes are optional overrides, not mandatory companions.",
        "body": "Resolution remains explicit or class-provided view, then built-in primitive view, then safe generic fallback.",
        "status": "decided",
        "owner": "Michael",
        "definitionKey": "decision",
        "_classBinding": { "key": "decision", "sourceRef": "github://twilite-zone/public/library/classes/nodes/task-planning/decision.node-class.node", "ref": "github://twilite-zone/public/library/classes/nodes/task-planning/decision.node-class.node" },
