    {
      "id": "view-model-goal",
      "type": "goal",
      "label": "Make views explicit without burdening ordinary nodes",
      "position": { "x": -40, "y": -300 },
      "width": 660,
      "height": 400,
      "visible": true,
      "showLabel": true,
