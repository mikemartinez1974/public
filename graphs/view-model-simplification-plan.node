      ],
      "data": {
        "outcome": "Twilite presents View, Editor View, and Port as a coherent public model while existing nodes keep using built-in or class-provided views.",
        "priority": "high",
        "status": "in-progress",
        "owner": "Michael",
        "definitionKey": "goal",
        "_classBinding": { "key": "goal", "sourceRef": "github://twilite-zone/public/library/classes/nodes/task-planning/goal.node-class.node", "ref": "github://twilite-zone/public/library/classes/nodes/task-planning/goal.node-class.node" },
