      "data": {
        "surfaceId": "web"
      },
      "sourcePort": "surfaces",
      "targetPort": "root"
    },
    {
      "id": "port-detail-summary",
      "type": "next-face",
      "source": "pennywise-detail",
      "target": "pennywise-summary",
      "label": "",
      "style": {},
      "data": {},
      "sourcePort": "sequence-out",
      "targetPort": "sequence-in"
    },
    {
      "id": "port-summary-icon",
