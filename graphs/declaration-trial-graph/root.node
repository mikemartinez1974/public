    "changelog": [
      {
        "version": "0.2.0",
        "date": "2026-10-04T16:58:22.603Z",
        "note": "Removed a stale, hand-authored port snapshot (default-view/summary-view/icon-view/glyph -- the pre-surfaces trio) that was never pruned when the app moved to the single repeatable surfaces relationship. It had silently merged with the live relationship set, giving this Declaration 10 ports instead of 6. Now lets the dynamic relationship system supply the current set (surfaces, default-handle, boundary-begin, boundary-end, port, landing-surface) like every other Declaration."
      }
    ]
  },
