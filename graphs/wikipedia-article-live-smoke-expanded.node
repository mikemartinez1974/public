          }
        }
      ],
      "handles": [
        {
          "id": "root",
          "key": "root",
          "portId": "root",
          "label": "root",
          "direction": "input",
          "dataType": "any",
          "angle": 180
        }
      ],
      "visible": true,
      "showLabel": false,
      "data": {
        "articleRef": "https://en.wikipedia.org/wiki/Graph_(discrete_mathematics)",
        "canonicalUrl": "https://en.wikipedia.org/wiki/Graph_(discrete_mathematics)",
        "title": "Graph (discrete mathematics)",
        "description": "Vertices connected in pairs by edges",
        "pageId": "325806",
        "revisionId": "1362731879",
        "revisionTimestamp": "2026-07-05T21:32:56Z",
        "lead": "In discrete mathematics, particularly in graph theory, a graph is a structure consisting of a set of objects where some pairs of the objects are in some sense \"related\". The objects are represented by abstractions called vertices (also called nodes or points) and each of the related pairs of vertices is called an edge (also called link or line). Typically, a graph is depicted in diagrammatic form as a set of dots or circles for the vertices, joined by lines or curves for the edges.\nThe edges may be directed or undirected. For example, if the vertices represent people at a party, and there is an edge between two people if they shake hands, then this graph is undirected because any person A can shake hands with a person B only if B also shakes hands with A. In contrast, if an edge from a person A to a person B means that A owes money to B, then this graph is directed, because owing money is not necessarily reciprocated.\nGraphs are the basic subject studied by graph theory. The word \"graph\" was first used in this sense by J. J. Sylvester in 1878 due to a direct relation between mathematics and chemical structure (what he called a chemico-graphical image).",
        "thumbnailUrl": "https://upload.wikimedia.org/wikipedia/commons/thumb/5/5b/6n-graf.svg/960px-6n-graf.svg.png?utm_source=en.wikipedia.org&utm_campaign=api&utm_content=thumbnail",
        "thumbnail": {
          "url": "https://upload.wikimedia.org/wikipedia/commons/thumb/5/5b/6n-graf.svg/960px-6n-graf.svg.png?utm_source=en.wikipedia.org&utm_campaign=api&utm_content=thumbnail",
          "width": 960,
          "height": 634
        },
        "originalImageUrl": "https://upload.wikimedia.org/wikipedia/commons/5/5b/6n-graf.svg?utm_source=en.wikipedia.org&utm_campaign=api&utm_content=original",
        "sections": [
          {
            "id": "Definitions",
            "title": "Definitions",
            "level": 2,
            "order": 1,
            "sourceLocator": "1"
          },
          {
            "id": "Types_of_graphs",
            "title": "Types of graphs",
            "level": 2,
            "order": 2,
            "sourceLocator": "6"
          },
          {
            "id": "Properties_of_graphs",
            "title": "Properties of graphs",
            "level": 2,
            "order": 3,
            "sourceLocator": "19"
          },
          {
            "id": "Examples",
            "title": "Examples",
            "level": 2,
            "order": 4,
            "sourceLocator": "20"
          },
          {
            "id": "Graph_operations",
