    {
      "id": "wikipedia-article-live-smoke-article",
      "type": "wikipedia-article-source",
      "label": "Graph (discrete mathematics)",
      "position": {
        "x": 949.9312033666206,
        "y": -320.0385645046365
      },
      "width": 680,
      "height": 500,
      "ports": [
        {
          "id": "root",
