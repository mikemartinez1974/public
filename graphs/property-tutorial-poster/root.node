    {
      "id": "property-tutorial-poster-try",
      "type": "page-section",
      "label": "Try it",
      "position": {
        "x": 930,
        "y": -200
      },
      "width": 1100,
      "height": 560,
      "data": {
        "title": "Try it",
        "body": "1. Switch to edit mode (the pencil).\n2. Press Add node and choose Property. A card appears with a field for its value.\n3. Type a value on the card. That is changing the value: it needs no editor, and it works wherever the card is shown.\n4. To change what the Property is, select it and press Edit. Give it a name, choose its type (text, number, boolean, JSON or reference) and say whether it is required, with a description for whoever fills it in.\n5. Choose a type and the card’s control follows: a field, a number field, a switch, or a box for JSON.\n6. To react when the value changes, draw from the Property’s property.changed handle to a Method. The Method runs every time the value is written.",
        "presentation": {
          "glyph": {
            "kind": "icon",
            "name": "Article"
          },
          "baseLevel": "detail"
        },
        "identity": {
          "graphId": "property-tutorial-poster"
