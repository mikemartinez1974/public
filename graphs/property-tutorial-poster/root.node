    {
      "id": "property-tutorial-poster-what",
      "type": "page-section",
      "label": "What it is",
      "position": {
        "x": -270,
        "y": -200
      },
      "width": 1100,
      "height": 560,
      "data": {
        "title": "What it is",
        "body": "A Property is a named slot on a node that holds a value. It has a name, the kind of value it expects, whether it must be filled in, and a description; what is in it is its value. You change the value on the card, and you change the Property itself, its name and kind, in its editor. Changing the value announces that it changed, so a Method can act on it. A Property is for the facts about a thing, such as a count, a day or a yes or no. It is not for a graph’s own name, kind or identity, which belong on its root.",
        "presentation": {
          "glyph": {
            "kind": "icon",
            "name": "Article"
          },
          "baseLevel": "detail"
        },
        "identity": {
          "graphId": "property-tutorial-poster"
        },
        "classRef": "tlz://twilite.zone/library/templates/page-template/classes/page-section.node-class.node"
