    {
      "id": "workflow-demo-collection",
      "type": "collection",
      "label": "My work",
      "position": {
        "x": 680,
        "y": 200
      },
      "width": 420,
      "height": 240,
      "visible": true,
      "showLabel": true,
      "data": {
        "title": "My work",
        "body": "Every task graph I have, in the lane its work puts it in.",
        "sort": "order",
        "includeFolder": false,
        "sourcesSummary": "",
        "identity": {
          "graphId": "workflow-demo-declaration",
          "nodeId": "workflow-demo-collection"
        },
        "classRef": "tlz://twilite.zone/library/classes/nodes/collection/collection.node-class.node"
      },
      "ports": [
        {
          "id": "members",
          "key": "members",
          "label": "members",
          "direction": "output",
          "dataType": "any",
          "angle": 90,
          "allowedEdgeTypes": [
            "contains"
          ],
          "metadata": {
            "semantic": true,
            "roles": [
              "contains"
            ],
