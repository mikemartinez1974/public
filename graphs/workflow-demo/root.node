    {
      "id": "workflow-demo-landing",
      "type": "content",
      "label": "Workflow landing",
      "position": {
        "x": 560,
        "y": -420
      },
      "width": 633.5114535153646,
      "height": 270.2697209374306,
      "ports": [
        {
          "id": "root",
          "key": "root",
          "label": "root",
          "direction": "bidirectional",
          "dataType": "any",
          "angle": 270
        }
      ],
      "handles": [
        {
          "id": "root",
          "key": "root",
          "label": "root",
          "direction": "bidirectional",
          "dataType": "any",
          "angle": 270,
          "portId": "root"
        }
      ],
      "visible": true,
      "showLabel": true,
      "data": {
        "identity": {
          "graphId": "workflow-demo"
        },
        "content": {
          "kind": "markdown",
          "value": "# Workflow\n\nA board of five lanes that fills itself from the work in the graphs it holds. Nothing is set up: a graph moves lane when its work does.\n\n- **Inbox** — not started.\n- **Now** — under way. Keep it small.\n- **Needs you** — all the work is done and the goal is not confirmed, or a question is open. The lane to look at first.\n- **Waiting** — blocked on something, with nothing in progress.\n- **Done** — the work and the goal are done.\n\nA member is a graph the workflow contains through a Portal. Each is read when the workflow is opened, so nothing is copied into it."
        },
        "_placement": {
          "version": 1,
          "state": "manually-shaped",
          "source": "manual",
          "updatedAt": 1791502752029,
          "reason": "node-drag"
        }
      }
    },
    {
      "id": "workflow-demo-derive-method",
      "type": "method",
      "label": "Derive the collection views",
      "position": {
        "x": 200,
        "y": 1300
      },
      "width": 420,
      "height": 260,
      "ports": [
        {
          "id": "call",
          "key": "call",
          "label": "Call",
          "direction": "input",
          "dataType": "event",
          "angle": 180
        },
        {
          "id": "result",
          "key": "result",
          "label": "Result",
          "direction": "output",
          "dataType": "value",
          "angle": 0
        }
      ],
      "handles": [
        {
          "id": "call",
          "key": "call",
          "label": "Call",
          "direction": "input",
          "dataType": "event",
          "angle": 180,
          "portId": "call"
        },
        {
          "id": "result",
          "key": "result",
          "label": "Result",
          "direction": "output",
          "dataType": "value",
          "angle": 0,
          "portId": "result"
        }
      ],
      "visible": true,
      "showLabel": true,
      "data": {
        "scriptName": "Derive the workflow board",
        "parameters": [],
        "effects": [
          {
            "kind": "update-node",
            "targets": [
              "workflow-demo-detail",
              "workflow-demo-summary",
              "workflow-demo-glyph",
              "workflow-demo-declaration",
              "workflow-demo-collection"
            ]
          }
        ],
        "allowMutations": true,
        "dryRun": false,
        "identity": {
          "graphId": "workflow-demo-declaration"
        },
        "source": "// Derives the workflow's views from the graphs it holds: nothing is typed into a board.\n// A member is a graph the workflow contains through a Portal (a `contains` edge from its members port). Each member is read when the workflow is opened (api.readGraph),\n// and placed in one of five lanes by what its own work says. There is nothing to set up: a graph moves lane when its work does.\n//\n//   Inbox      not started: nothing under way, no work done, and the goal not begun\n//   Now        under way: some work is in progress, or some is done and the rest is still to do\n//   Needs you  waiting for you: all the work is done and the goal is not confirmed, or a question is open\n//   Waiting    blocked on something else, with nothing in progress\n//   Done       all the work is done and the goal is\n//\n// A graph whose goal is finished (done, achieved) or cancelled is in Done, whatever its tasks say. A member's work is its tasks (a cancelled one is not counted), its questions are its open-question nodes that are still open, and its goal is its goal node. The Method writes the\n// Detail (a board, which stretches with its tallest lane up to a square), the Summary (the five counts), the Glyph, and the window that holds them.\nconst clean = (value) => String(value ?? '').trim();\nconst esc = (value) => clean(value)\n  .replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/\"/g, '&quot;').replace(/'/g, '&#39;');\nconst lower = (value) => clean(value).toLowerCase();\nconst INK = '#6d28d9';\nconst LANES = [\n  { id: 'inbox', name: 'Inbox', hint: 'Not started', color: '#64748b' },\n  { id: 'now', name: 'Now', hint: 'Under way', color: '#2563eb' },\n  { id: 'needs', name: 'Needs you', hint: 'Your yes or an answer', color: INK },\n  { id: 'waiting', name: 'Waiting', hint: 'Blocked on something', color: '#b45309' },\n  { id: 'done', name: 'Done', hint: 'Finished', color: '#15803d' }\n];\n\nconst nodes = await api.getNodes();\nconst edges = await api.getEdges();\nconst byId = new Map(nodes.map((node) => [node.id, node]));\nconst root = nodes.find((node) => clean(node.type) === 'root');\nconst collection = nodes.find((node) => clean(node.type) === 'collection');\nconst title = clean(collection?.data?.title || collection?.label) || 'Workflow';\nconst portals = edges\n  .filter((edge) => clean(edge.type) === 'contains' && collection && edge.source === collection.id)\n  .map((edge) => byId.get(edge.target))\n  .filter((node) => node && clean(node.type) === 'portal');\nconst refOf = (portal) => clean(portal.data?.target?.ref || portal.data?.sourceRef || portal.data?.ref);\nconst slugOf = (address) => { const parts = clean(address).replace(/#.*$/, '').split('/').filter(Boolean); const last = parts[parts.length - 1] || ''; return /\\.node$/.test(last) && parts.length > 1 ? parts[parts.length - 2] : last; };\n\n// A goal says it is finished in more than one word, and a goal that was cancelled is closed.\nconst GOAL_FINISHED = ['done', 'achieved', 'complete', 'completed'];\n// Which lane a member belongs in, from its own work.\nconst laneOf = ({ total, done, going, blocked, openQuestions, goalStatus, hasGoal }) => {\n  if (goalStatus === 'cancelled' || GOAL_FINISHED.includes(goalStatus)) return 'done';\n  if (!total && !hasGoal) return 'inbox';\n  if (total && done === total) return !hasGoal ? 'done' : 'needs';\n  // Questions ask for the person once work has begun; a graph nothing has started on is still in the inbox.\n  if (openQuestions > 0 && (done > 0 || going > 0 || goalStatus === 'in-progress')) return 'needs';\n  if (going > 0) return 'now';\n  if (blocked > 0) return 'waiting';\n  if (done > 0 || goalStatus === 'in-progress') return 'now';\n  return 'inbox';\n};\n\nconst read = async (portal) => {\n  const ref = refOf(portal);\n  let graph = null;\n  try { graph = await api.readGraph(ref); } catch (error) { graph = null; }\n  if (!Array.isArray(graph?.nodes)) return { ref, name: clean(portal.label) || slugOf(ref), unread: true };\n  const items = graph.nodes;\n  const rootNode = items.find((node) => clean(node.type) === 'root');\n  const goal = items.find((node) => clean(node.type) === 'goal');\n  const tasks = items.filter((node) => clean(node.type) === 'task' && lower(node.data?.status) !== 'cancelled');\n  const count = (status) => tasks.filter((task) => lower(task.data?.status) === status).length;\n  const done = count('done');\n  const going = count('in-progress');\n  const blocked = count('blocked') + count('waiting');\n  // A question counts once it has been written: one with no title is the blank the template starts with.\n  const openQuestions = items.filter((node) => clean(node.type) === 'open-question' && lower(node.data?.status) === 'open' && clean(node.data?.title || node.label)).length;\n  const facts = { total: tasks.length, done, going, blocked, openQuestions, goalStatus: lower(goal?.data?.status), hasGoal: Boolean(goal) };\n  const next = tasks.find((task) => lower(task.data?.status) === 'in-progress') || tasks.find((task) => !['done', 'blocked', 'waiting'].includes(lower(task.data?.status)));\n  return { ref, name: clean(rootNode?.data?.identity?.name) || clean(portal.label) || slugOf(ref), lane: laneOf(facts), ...facts, next: clean(next?.data?.title || next?.label) };\n};\nconst members = await Promise.all(portals.map(read));\nconst readable = members.filter((member) => !member.unread);\nconst byLane = Object.fromEntries(LANES.map((lane) => [lane.id, []]));\nreadable.forEach((member) => byLane[member.lane].push(member));\nbyLane.needs.sort((a, b) => b.openQuestions - a.openQuestions || a.name.localeCompare(b.name));\nbyLane.now.sort((a, b) => (b.done / Math.max(1, b.total)) - (a.done / Math.max(1, a.total)) || a.name.localeCompare(b.name));\n['inbox', 'waiting', 'done'].forEach((id) => byLane[id].sort((a, b) => a.name.localeCompare(b.name)));\nconst count = readable.length;\nconst needsCount = byLane.needs.length;\n\n// The Detail is 100cqw wide. It starts at 3:2 and stretches with its tallest lane up to a square.\nconst PAD = 3; const HEAD = 11; const LANE_HEAD = 6.2; const TILE = 9.4; const GAP = 1.1; const GUTTER = 1.6;\nconst tallest = Math.max(1, ...LANES.map((lane) => byLane[lane.id].length));\nconst MAX_SHOWN = 6;\nconst shownRows = Math.min(tallest, MAX_SHOWN);\nconst need = 2 * PAD + HEAD + LANE_HEAD + shownRows * (TILE + GAP) + (tallest > MAX_SHOWN ? 4 : 0);\nconst ratio = Math.min(1, Math.max(2 / 3, need / 100));\nconst DETAIL_WIDTH = 900; const SUMMARY_WIDTH = 480;\n\nconst frame = (inner, style) => `<div style='container-type:inline-size;width:100%;height:100%'><div style='box-sizing:border-box;width:100%;height:100%;font-family:system-ui,-apple-system,Segoe UI,sans-serif;${style}'>${inner}</div></div>`;\nconst tile = (member, lane) => {\n  const share = member.total ? Math.round((member.done / member.total) * 100) : 0;\n  const line = lane.id === 'done' ? (member.goalStatus === 'cancelled' ? 'Cancelled' : 'Finished')\n    : member.openQuestions ? `${member.openQuestions} open question${member.openQuestions === 1 ? '' : 's'}`\n    : member.next || (member.total ? '' : 'No work yet');\n  return `<a href='${esc(member.ref)}' title='${esc(member.name)}' style='display:flex;flex-direction:column;justify-content:space-between;box-sizing:border-box;height:${TILE}cqw;padding:.9cqw 1.1cqw;border:1px solid #e2e8f0;border-left:.5cqw solid ${lane.color};border-radius:1cqw;background:#ffffff;text-decoration:none;color:inherit;min-width:0;overflow:hidden'>`\n    + `<span style='display:block;font-weight:600;font-size:1.32cqw;line-height:1.2;color:#0f172a;overflow:hidden;display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical'>${esc(member.name)}</span>`\n    + `<span style='display:block;min-width:0'><span style='display:block;height:.45cqw;border-radius:.3cqw;background:#e2e8f0;overflow:hidden'><span style='display:block;height:100%;width:${share}%;background:${lane.color}'></span></span>`\n    + `<span style='display:flex;justify-content:space-between;gap:.8cqw;margin-top:.45cqw;font-size:1.05cqw;line-height:1.25;color:#475569'><span style='min-width:0;overflow:hidden;text-overflow:ellipsis;white-space:nowrap'>${esc(line)}</span><span style='flex:none;font-variant-numeric:tabular-nums'>${member.done}/${member.total}</span></span></span></a>`;\n};\nconst column = (lane) => {\n  const list = byLane[lane.id];\n  const shown = list.length > MAX_SHOWN ? list.slice(0, MAX_SHOWN - 1) : list;\n  const more = list.length - shown.length;\n  const body = shown.map((member) => tile(member, lane)).join('')\n    + (more > 0 ? `<div style='font-size:1.15cqw;color:#64748b;padding:.2cqw 1cqw'>and ${more} more</div>` : '')\n    + (!list.length ? `<div style='font-size:1.15cqw;color:#94a3b8;padding:.6cqw 1cqw;border:1px dashed #cbd5e1;border-radius:1cqw'>Nothing here</div>` : '');\n  const emphasis = lane.id === 'needs' && list.length ? `background:${INK}12;border-radius:1.2cqw;` : '';\n  return `<div style='min-width:0;display:flex;flex-direction:column;gap:${GAP}cqw;padding:.6cqw;${emphasis}'>`\n    + `<div style='display:flex;align-items:baseline;justify-content:space-between;gap:1cqw;height:${LANE_HEAD - 1}cqw;border-bottom:.25cqw solid ${lane.color}'><span style='font-weight:700;font-size:1.45cqw;color:${lane.color}'>${esc(lane.name)}</span><span style='font-size:1.3cqw;font-variant-numeric:tabular-nums;color:#475569'>${list.length}</span></div>`\n    + body + `</div>`;\n};\nconst detail = frame(\n  `<div style='display:flex;justify-content:space-between;align-items:flex-end;gap:2cqw;height:${HEAD - PAD}cqw'><div style='min-width:0'><div style='font-size:1.15cqw;font-weight:700;letter-spacing:.14em;text-transform:uppercase;color:${INK}'>Workflow</div><div style='font-weight:650;font-size:3cqw;line-height:1.15;color:#0f172a;white-space:nowrap;overflow:hidden;text-overflow:ellipsis'>${esc(title)}</div></div>`\n  + `<div style='font-size:1.4cqw;color:#475569;white-space:nowrap'>${count} ${count === 1 ? 'graph' : 'graphs'}${needsCount ? ` · <b style='color:${INK}'>${needsCount} need${needsCount === 1 ? 's' : ''} you</b>` : ''}</div></div>`\n  + `<div style='display:grid;grid-template-columns:repeat(5,minmax(0,1fr));gap:${GUTTER}cqw;margin-top:1.2cqw'>${LANES.map(column).join('')}</div>`,\n  `padding:${PAD}cqw;border-radius:2.4cqw;background:#f8fafc;border:1px solid #e2e8f0;overflow:hidden`\n);\n\nconst summaryCell = (lane) => `<div style='min-width:0;display:flex;flex-direction:column;align-items:center;gap:1.2cqw'><div style='font-size:9cqw;line-height:1;font-weight:700;font-variant-numeric:tabular-nums;color:${byLane[lane.id].length ? lane.color : '#cbd5e1'}'>${byLane[lane.id].length}</div><div style='font-size:2.6cqw;font-weight:600;color:#475569;white-space:nowrap'>${esc(lane.name)}</div></div>`;\nconst summary = frame(\n  `<div style='display:flex;justify-content:space-between;align-items:flex-end;gap:2cqw'><div style='min-width:0'><div style='font-size:2.8cqw;font-weight:700;letter-spacing:.1em;text-transform:uppercase;color:${INK}'>Workflow</div><div style='font-weight:650;font-size:5.6cqw;line-height:1.15;color:#0f172a;white-space:nowrap;overflow:hidden;text-overflow:ellipsis'>${esc(title)}</div></div><div style='font-size:3.2cqw;color:#475569;white-space:nowrap'>${count} ${count === 1 ? 'graph' : 'graphs'}</div></div>`\n  + `<div style='display:grid;grid-template-columns:repeat(5,minmax(0,1fr));gap:2cqw;margin-top:auto;margin-bottom:auto'>${LANES.map(summaryCell).join('')}</div>`,\n  `padding:5cqw;border-radius:4cqw;background:#ffffff;border:1px solid #e2e8f0;display:flex;flex-direction:column;gap:3cqw;overflow:hidden`\n);\n\nconst faces = nodes.filter((node) => clean(node.type) === 'face');\nconst faceFor = (level) => faces.find((node) => clean(node.data?.semanticLevel) === level);\nconst glyph = nodes.find((node) => clean(node.type) === 'glyph');\nconst detailFace = faceFor('detail');\nconst summaryFace = faceFor('summary');\nconst size = (width) => ({ width, height: Math.round(width * ratio) });\nif (detailFace) {\n  await api.updateView(detailFace.id, { content: { kind: 'html', value: detail }, view: { ...(detailFace.data?.view || {}), scroll: 'page' } });\n  await api.updateNode(detailFace.id, size(DETAIL_WIDTH));\n}\nif (summaryFace) {\n  await api.updateView(summaryFace.id, { content: { kind: 'html', value: summary } });\n  await api.updateNode(summaryFace.id, size(SUMMARY_WIDTH));\n}\n// The glyph says whether something is waiting for you.\nif (glyph) await api.updateNode(glyph.id, { data: { ...glyph.data, glyph: { kind: 'icon', name: 'ViewColumn', color: needsCount ? INK : '#15803d' } } });\n\n// The window is the Detail's shape and holds everything the graph has.\nif (root) {\n  const placed = nodes.filter((node) => node.position).map((node) => (node === detailFace ? { ...node, ...size(DETAIL_WIDTH) } : node === summaryFace ? { ...node, ...size(SUMMARY_WIDTH) } : node));\n  const pad = 80;\n  let x0 = Math.min(...placed.map((node) => node.position.x)) - pad;\n  let y0 = Math.min(...placed.map((node) => node.position.y)) - pad;\n  let w = Math.max(...placed.map((node) => node.position.x + node.width)) + pad - x0;\n  let h = Math.max(...placed.map((node) => node.position.y + node.height)) + pad - y0;\n  if (w / h < 1 / ratio) { const next = Math.round(h / ratio); x0 -= Math.round((next - w) / 2); w = next; } else { const next = Math.round(w * ratio); y0 -= Math.round((next - h) / 2); h = next; }\n  await api.updateNode(root.id, { data: { ...root.data, membrane: { ...(root.data?.membrane || {}), bounds: { x: Math.round(x0), y: Math.round(y0), width: w, height: h } } } });\n}\nreturn { members: count, unread: members.length - count, lanes: Object.fromEntries(LANES.map((lane) => [lane.id, byLane[lane.id].map((member) => member.name)])), ratio: Math.round(ratio * 1000) / 1000 };\n"
      }
    },
    {
      "id": "workflow-demo-bridge-collection",
