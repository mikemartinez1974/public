          "value": "<div style='container-type:inline-size;width:100%;height:100%'><div style='box-sizing:border-box;width:100%;height:100%;font-family:system-ui,-apple-system,Segoe UI,sans-serif;padding:5cqw;border-radius:4cqw;background:#ffffff;border:1px solid #e2e8f0;display:flex;flex-direction:column;gap:3cqw;overflow:hidden'><div style='display:flex;justify-content:space-between;align-items:flex-end;gap:2cqw'><div style='min-width:0'><div style='font-size:2.8cqw;font-weight:700;letter-spacing:.1em;text-transform:uppercase;color:#6d28d9'>Workflow</div><div style='font-weight:650;font-size:5.6cqw;line-height:1.15;color:#0f172a;white-space:nowrap;overflow:hidden;text-overflow:ellipsis'>My work</div></div><div style='font-size:3.2cqw;color:#475569;white-space:nowrap'>17 graphs</div></div><div style='display:grid;grid-template-columns:repeat(5,minmax(0,1fr));gap:2cqw;margin-top:auto;margin-bottom:auto'><div style='min-width:0;display:flex;flex-direction:column;align-items:center;gap:1.2cqw'><div style='font-size:9cqw;line-height:1;font-weight:700;font-variant-numeric:tabular-nums;color:#64748b'>2</div><div style='font-size:2.6cqw;font-weight:600;color:#475569;white-space:nowrap'>Inbox</div></div><div style='min-width:0;display:flex;flex-direction:column;align-items:center;gap:1.2cqw'><div style='font-size:9cqw;line-height:1;font-weight:700;font-variant-numeric:tabular-nums;color:#2563eb'>2</div><div style='font-size:2.6cqw;font-weight:600;color:#475569;white-space:nowrap'>Now</div></div><div style='min-width:0;display:flex;flex-direction:column;align-items:center;gap:1.2cqw'><div style='font-size:9cqw;line-height:1;font-weight:700;font-variant-numeric:tabular-nums;color:#6d28d9'>4</div><div style='font-size:2.6cqw;font-weight:600;color:#475569;white-space:nowrap'>Needs you</div></div><div style='min-width:0;display:flex;flex-direction:column;align-items:center;gap:1.2cqw'><div style='font-size:9cqw;line-height:1;font-weight:700;font-variant-numeric:tabular-nums;color:#b45309'>2</div><div style='font-size:2.6cqw;font-weight:600;color:#475569;white-space:nowrap'>Waiting</div></div><div style='min-width:0;display:flex;flex-direction:column;align-items:center;gap:1.2cqw'><div style='font-size:9cqw;line-height:1;font-weight:700;font-variant-numeric:tabular-nums;color:#15803d'>7</div><div style='font-size:2.6cqw;font-weight:600;color:#475569;white-space:nowrap'>Done</div></div></div></div></div>"
        },
