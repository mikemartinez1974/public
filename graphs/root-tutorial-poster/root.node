    {
      "id": "root-tutorial-poster-not",
      "type": "page-section",
      "label": "What it is not",
      "position": {
        "x": -270,
        "y": 460
      },
      "width": 1100,
      "height": 560,
      "data": {
        "title": "What it is not",
        "body": "It does not draw the graph’s content: faces and Content do. It does not place nodes or choose layout. It does not grant anything: its authority is mostly descriptive, and only two of its switches are enforced. It is not a template: it describes one graph, not a pattern for making others.",
        "presentation": {
          "glyph": {
            "kind": "icon",
            "name": "Article"
          },
          "baseLevel": "detail"
