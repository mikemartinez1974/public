    {
      "id": "root-tutorial-poster-what",
      "type": "page-section",
      "label": "What it is",
      "position": {
        "x": 930,
        "y": -200
      },
      "width": 1100,
      "height": 560,
      "data": {
        "title": "What it is",
        "body": "A root is the node a graph begins from. It carries the graph’s name, description and version, what kind of graph it is, and the Surfaces it shows. It is the graph’s implicit root Port: the entry point everyone reaches first. A file holds exactly one, and the card on the stage is this graph’s own.",
        "presentation": {
          "glyph": {
            "kind": "icon",
            "name": "Article"
          },
          "baseLevel": "detail"
        },
        "identity": {
          "graphId": "root-tutorial-poster"
        },
        "classRef": "tlz://twilite.zone/library/templates/page-template/classes/page-section.node-class.node"
      },
