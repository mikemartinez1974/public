        }
      ],
      "data": {
        "content": {
          "kind": "markdown",
          "value": "# Edge label smoke test\n\n1. Switch to **edit mode**.\n2. Click an edge's label once: its editor opens (close it). The edge stays selected.\n3. Press on the label and drag along the edge: the label slides, and stays where you let go.\n4. Reload: it is still there.\n5. A click that does not move still opens the edge."
        },
        "interfaceContract": {
          "version": 1,
          "receivesViewContent": true
        },
        "identity": {
          "graphId": "edge-label-smoke",
          "nodeId": "edge-label-smoke-landing"
        }
      }
    },
