      ],
      "visible": true,
      "showLabel": true,
      "data": {
        "markdown": "# Twilite: A Graph-Native World\n\nTwilite is a browser for a graph-addressed world where humans, software, and agents can author the same durable medium.\n\nIt is not merely a node editor. The graph becomes the document, navigation structure, application state, publishing artifact, agent workspace, extension surface, and reusable type system.",
        "memo": "",
        "link": "",
        "html": "",
        "svg": "",
        "visibilityRole": "browser",
        "_placement": {
          "version": 1,
          "state": "auto-placed",
          "source": "create",
          "updatedAt": 1783724486058,
          "reason": "node-batch-create"
        },
        "identity": {
          "graphId": "a3f7c6d4-84b9-4a6c-9d2d-2e7c4d91b8f2"
        }
      }
    },
    {
