          }
        }
      ],
      "visible": true,
      "showLabel": true,
      "data": {
        "markdown": "# A Graph-Shaped Web\n\nEach branch can declare its own purpose, surfaces, imports, capabilities, and return paths.\n\nThe same graph can expose different faces depending on how it is entered:\n\n- full reader\n- compact icon\n- document surface\n- host-facing port\n\nPages, components, routes, imports, and APIs begin to converge into one graph-native medium.",
        "memo": "",
        "link": "",
        "html": "",
        "svg": "",
        "visibilityRole": "browser",
        "_placement": {
          "version": 1,
          "state": "auto-placed",
          "source": "create",
