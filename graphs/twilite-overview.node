          }
        }
      ],
      "visible": true,
      "showLabel": true,
      "data": {
        "markdown": "# The Graph Is The Medium\n\nMost graph products represent information *inside* an application.\n\nTwilite uses graphs to represent the application itself.\n\nThe graph can simultaneously be:\n\n- document\n- interface\n- navigation\n- durable state\n- publishing artifact\n- agent workspace\n- extension surface",
        "memo": "",
        "link": "",
        "html": "",
        "svg": "",
        "visibilityRole": "browser",
        "_placement": {
          "version": 1,
          "state": "auto-placed",
          "source": "create",
          "updatedAt": 1783724486058,
          "reason": "node-batch-create"
        },
        "identity": {
          "graphId": "a3f7c6d4-84b9-4a6c-9d2d-2e7c4d91b8f2"
        }
      }
    },
