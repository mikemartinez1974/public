            "offset": 0.5
          }
        }
      ],
      "visible": true,
      "showLabel": true,
      "data": {
        "markdown": "# The Handshake Is A Protocol\n\nThe handshake teaches an LLM to:\n\n- treat the graph as durable state\n- inspect before inventing\n- mutate incrementally\n- preserve existing structure\n- return machine-applicable operations\n- distinguish nodes, edges, ports, handles, and updates\n\nThe model becomes a bounded graph author rather than a prose generator.",
        "memo": "",
        "link": "",
        "html": "",
        "svg": "",
        "visibilityRole": "browser",
        "_placement": {
          "version": 1,
          "state": "auto-placed",
          "source": "create",
          "updatedAt": 1783724486058,
          "reason": "node-batch-create"
        },
        "identity": {
          "graphId": "a3f7c6d4-84b9-4a6c-9d2d-2e7c4d91b8f2"
        }
      }
    },
