      ],
      "visible": true,
      "showLabel": true,
      "data": {
        "markdown": "# Agent Operating Surface\n\nThe Agent branch already has the vocabulary for:\n\n- task\n- prompt\n- tool\n- observation\n- result\n- contract\n- handoff\n\nThat makes agent work potentially visible, editable, auditable, replayable, forkable, and connected to ordinary human-authored content.\n\nThe orchestration stops hiding in logs and becomes inspectable graph state.",
        "memo": "",
        "link": "",
        "html": "",
        "svg": "",
        "visibilityRole": "browser",
        "_placement": {
          "version": 1,
