          "version": 1,
          "state": "manually-shaped",
          "source": "manual",
          "updatedAt": 1793837095586,
          "reason": "node-drag"
        }
      }
    },
    {
      "id": "c59b860d-296c-4fd7-8890-1ffbacac2817",
      "type": "content",
      "label": "Character Psychology",
      "position": {
