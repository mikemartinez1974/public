      ],
      "style": {
        "background": "#39291b",
        "color": "#fff1d2",
        "borderColor": "#daa65a",
        "borderWidth": 3,
        "borderStyle": "solid",
        "borderRadius": 18
      },
      "visible": true,
      "showLabel": true,
      "data": {
        "content": {
          "kind": "markdown",
          "value": "# INDIANA JONES\n\n### The Scholar Who Refuses to Stay in the Library\n\n**Archetype:** Adventurer / Explorer / Reluctant Hero\n\n**Motivation:** Discovery, preservation and the pursuit of historical truth.\n\n**Greatest strength:** Resourcefulness under impossible pressure.\n\n**Greatest weakness:** Obsession, pride and a spectacular fear of snakes.\n\n**Internal conflict:** Scientific skepticism versus extraordinary experience.\n\n**Character arc:** Learning that the people beside him matter more than the treasures ahead.\n\n---\n\n*He isn't the strongest man in the room. He isn't the most dangerous. He's simply the man who keeps getting back up.*"
        },
        "memo": "",
        "link": "",
        "identity": {
          "graphId": "cfef98fa-2f89-4b39-b69f-b2bbcfc3ba74"
        },
        "_placement": {
          "version": 1,
          "state": "manually-shaped",
          "source": "manual",
          "updatedAt": 1793841936597,
          "reason": "node-drag"
        },
        "documentOrder": 8
      }
    },
    {
      "id": "indy-assemble-method",
      "type": "method",
      "label": "Assemble the dossier",
      "position": {
        "x": -220,
        "y": -955
      },
      "width": 420,
      "height": 200,
      "ports": [
        {
          "id": "call",
          "key": "call",
          "label": "Call",
          "direction": "input",
          "dataType": "event",
          "angle": 180
        },
        {
          "id": "result",
          "key": "result",
          "label": "Result",
          "direction": "output",
          "dataType": "value",
          "angle": 0
        }
      ],
      "handles": [
        {
          "id": "call",
          "key": "call",
          "label": "Call",
          "direction": "input",
          "dataType": "event",
          "angle": 180,
          "portId": "call"
        },
        {
          "id": "result",
          "key": "result",
          "label": "Result",
          "direction": "output",
          "dataType": "value",
          "angle": 0,
          "portId": "result"
        }
      ],
      "visible": true,
      "showLabel": true,
      "data": {
        "scriptName": "Assemble the dossier",
        "parameters": [],
        "source": "// Assembles the Indiana Jones dossier from its section cards: nothing is typed into the Detail, the Summary or the Glyph.\n// It reads every content card that has a `documentOrder` number, in that order (not by where a card sits on the canvas, so the cards can be rearranged without reordering the document), turns each into\n// a section of one parchment page, and writes the Detail (the whole dossier as a document), the Summary (a character card) and the Glyph (the fedora's mark). It writes only those three, which its declared effects say.\nconst clean = (value) => String(value ?? '').trim();\nconst esc = (value) => clean(value).replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/\"/g, '&quot;').replace(/'/g, '&#39;');\nconst INK = '#2a2118'; const GOLD = '#b99152'; const SERIF = 'Georgia,Iowan Old Style,Palatino Linotype,serif'; const MONO = 'ui-monospace,SFMono-Regular,Menlo,Consolas,monospace';\n\nconst nodes = await api.getNodes();\nconst root = nodes.find((node) => clean(node.type) === 'root');\nconst name = clean(root?.data?.identity?.name) || 'Dossier';\nconst sections = nodes\n  .filter((node) => clean(node.type) === 'content' && Number.isFinite(Number(node.data?.documentOrder)) && node.data?.content)\n  .sort((a, b) => Number(a.data.documentOrder) - Number(b.data.documentOrder));\n\n// A small markdown: headings, bold, italic, rules, lists and paragraphs, which is all the dossier uses.\nconst inline = (text) => esc(text).replace(/\\*\\*(.+?)\\*\\*/g, `<b style='color:${INK}'>$1</b>`).replace(/\\*(.+?)\\*/g, '<i>$1</i>');\nconst markdown = (source) => {\n  const out = []; let paragraph = []; let list = [];\n  const flush = () => {\n    if (paragraph.length) out.push(`<p style='margin:0 0 1.1cqw;font-size:1.5cqw;line-height:1.55'>${inline(paragraph.join(' '))}</p>`);\n    if (list.length) out.push(`<ul style='margin:0 0 1.1cqw;padding-left:2.4cqw;font-size:1.5cqw;line-height:1.55'>${list.map((item) => `<li>${inline(item)}</li>`).join('')}</ul>`);\n    paragraph = []; list = [];\n  };\n  for (const raw of clean(source).split('\\n')) {\n    const line = raw.trim();\n    if (!line) { flush(); continue; }\n    if (/^---+$/.test(line)) { flush(); out.push(`<hr style='border:0;border-top:.15cqw solid ${GOLD};margin:1.6cqw 0;opacity:.7'>`); continue; }\n    const heading = /^(#{1,3}) +(.*)$/.exec(line);\n    if (heading) {\n      flush();\n      const level = heading[1].length;\n      const style = level === 1 ? `font:700 2.9cqw/1.15 ${SERIF};margin:0 0 1.4cqw;color:${INK}` : level === 2 ? `font:700 2cqw/1.2 ${SERIF};margin:1.4cqw 0 .8cqw;color:#6b4a22` : `font:700 1.6cqw/1.25 ${SERIF};margin:1.3cqw 0 .4cqw;color:#6b4a22;letter-spacing:.02em`;\n      out.push(`<div style='${style}'>${inline(heading[2])}</div>`);\n      continue;\n    }\n    if (/^[-*] +/.test(line)) { if (paragraph.length) flush(); list.push(line.replace(/^[-*] +/, '')); continue; }\n    paragraph.push(line);\n  }\n  flush();\n  return out.join('');\n};\n\n// An SVG section is drawn as the picture it is, at the page's width, in the shape its own viewBox gives it.\nconst picture = (svg) => {\n  const box = /viewBox=['\"][-\\d.]+ [-\\d.]+ ([\\d.]+) ([\\d.]+)['\"]/.exec(svg);\n  const ratio = box ? `${box[1]} / ${box[2]}` : '4 / 3';\n  return `<div style='width:100%;aspect-ratio:${ratio};border-radius:1.2cqw;overflow:hidden;box-shadow:0 .4cqw 1.2cqw rgba(42,33,24,.35)'>${svg}</div>`;\n};\n\nconst body = sections.map((node, index) => {\n  const content = node.data.content;\n  const inner = clean(content.kind).toLowerCase() === 'svg' ? picture(String(content.value || '')) : markdown(content.value);\n  const label = clean(node.label).split('|').pop().trim();\n  const number = String(index).padStart(2, '0');\n  return `<section style='margin-top:${index === 0 ? '2.4' : '3.2'}cqw;padding-top:${index === 0 ? '0' : '2.2'}cqw;${index === 0 ? '' : `border-top:.2cqw solid ${GOLD}`}'>`\n    + (index === 0 ? '' : `<div style='font:700 1.1cqw/1 ${MONO};letter-spacing:.2em;text-transform:uppercase;color:#8a6a3a;margin-bottom:1cqw'>${number} · ${esc(label)}</div>`)\n    + inner + '</section>';\n}).join('');\n\nconst profile = clean(sections.find((node) => /Profile/i.test(clean(node.label)))?.data?.content?.value);\nconst field = (pattern) => (new RegExp(`\\\\*\\\\*${pattern}:\\\\*\\\\*\\\\s*(.+)`).exec(profile) || [])[1] || '';\nconst profession = clean(field('Profession')) || 'Archaeologist';\nconst born = (/\\d{4}/.exec(field('Born')) || [''])[0];\n\nconst detail = `<div style='container-type:inline-size;width:100%;height:100%;overflow:auto;background:#1c1712;font-family:${SERIF};color:${INK}'>`\n  + `<div style='box-sizing:border-box;min-height:100%;padding:3.4cqw 5cqw 4cqw;background:linear-gradient(160deg,#ecdcb0,#d8c08a 55%,#c8ae78);border:.5cqw solid ${GOLD}'>`\n  + `<div style='font:700 1.2cqw/1 ${MONO};letter-spacing:.3em;text-transform:uppercase;color:#8a6a3a'>Expedition file${born ? ` · born ${esc(born)}` : ''}</div>`\n  + `<div style='font:700 6.4cqw/1 ${SERIF};letter-spacing:.04em;text-transform:uppercase;color:${INK};margin:1.2cqw 0 .6cqw'>${esc(name)}</div>`\n  + `<div style='font:italic 1.9cqw/1.3 ${SERIF};color:#6b4a22'>${esc(profession)} · adventurer</div>`\n  + body\n  + `<div style='margin-top:3.6cqw;font:400 1.1cqw/1.4 ${MONO};letter-spacing:.12em;text-transform:uppercase;color:#8a6a3a;text-align:center'>${sections.length} sections, assembled in reading order</div>`\n  + `</div></div>`;\n\nconst fedora = `<svg viewBox='0 0 100 70' style='width:100%;height:auto;display:block' aria-hidden='true'><ellipse cx='50' cy='50' rx='47' ry='13' fill='#3c2f22' stroke='${GOLD}' stroke-width='1.6'/><path d='M23 48C22 22 33 9 50 9s28 13 27 39Z' fill='#5b4630' stroke='${GOLD}' stroke-width='1.6'/><path d='M40 11c3 5 17 5 20 0' fill='none' stroke='#2a2118' stroke-width='2' stroke-linecap='round'/><path d='M23.4 41c9 5 44 5 53.2 0l.4 6.2C67 52 33 52 23 47Z' fill='#1f1913' stroke='${GOLD}' stroke-width='1'/></svg>`;\nconst summary = `<div style='container-type:inline-size;width:100%;height:100%'>`\n  + `<div style='box-sizing:border-box;width:100%;height:100%;padding:6cqw 7cqw;border-radius:6cqw;background:linear-gradient(135deg,#322a1f,#1a1511);border:.9cqw solid ${GOLD};display:flex;align-items:center;gap:6cqw;color:#f3e7ce;overflow:hidden'>`\n  + `<div style='flex:0 0 34cqw'>${fedora}</div>`\n  + `<div style='min-width:0;flex:1'>`\n  + `<div style='font:700 3.2cqw/1 ${MONO};letter-spacing:.24em;text-transform:uppercase;color:${GOLD}'>Expedition file</div>`\n  + `<div style='font:700 11cqw/1.02 ${SERIF};letter-spacing:.01em;margin:2.4cqw 0 1.6cqw;color:#f3ddb1'>${esc(name)}</div>`\n  + `<div style='font:italic 4.6cqw/1.3 ${SERIF};color:#c9b48a'>${esc(profession)}</div>`\n  + `<div style='margin-top:3cqw;font:600 3.2cqw/1 ${MONO};letter-spacing:.14em;text-transform:uppercase;color:${GOLD}'>${sections.length} sections${born ? ` · ${esc(born)}` : ''}</div>`\n  + `</div></div></div>`;\n\nconst faces = nodes.filter((node) => clean(node.type) === 'face');\nconst faceFor = (level) => faces.find((node) => clean(node.data?.semanticLevel) === level);\nconst glyph = nodes.find((node) => clean(node.type) === 'glyph');\nfor (const [level, html] of [['detail', detail], ['summary', summary]]) {\n  const face = faceFor(level);\n  if (face) await api.updateView(face.id, { content: { kind: 'html', value: html } });\n}\nif (glyph) await api.updateNode(glyph.id, { data: { ...glyph.data, glyph: { kind: 'symbol', value: 'I', color: GOLD } } });\nreturn { sections: sections.length };\n",
        "effects": [
          {
            "kind": "update-node",
            "targets": [
              "start-with-your-ai-detail",
              "start-with-your-ai-summary",
              "start-with-your-ai-glyph"
            ]
          }
        ],
        "allowMutations": true,
        "dryRun": false,
        "identity": {
          "graphId": "033be310-e18a-4b72-88ee-3b51afbf2b5a"
        },
        "memo": "Reads every content card that has a documentOrder, in that order, and writes the Detail, the Summary and the Glyph. It runs whenever the graph changes."
      }
    }
  ],
