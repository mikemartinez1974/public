    { "id": "endpoint-anchor-glyph-edge", "type": "reference", "source": "endpoint-anchor-smoke-declaration", "target": "endpoint-anchor-glyph", "sourcePort": "glyph", "targetPort": "root", "label": "glyph", "data": { "role": "shared-glyph", "semanticRole": "shared-glyph" } },
    { "id": "endpoint-anchor-summary-edge", "type": "reference", "source": "endpoint-anchor-smoke-declaration", "target": "endpoint-anchor-summary-view", "sourcePort": "summary-view", "targetPort": "root", "label": "summary view", "data": { "role": "shared-summary", "semanticRole": "shared-summary" } },
    { "id": "endpoint-anchor-icon-edge", "type": "reference", "source": "endpoint-anchor-smoke-declaration", "target": "endpoint-anchor-icon-view", "sourcePort": "icon-view", "targetPort": "root", "label": "icon view", "data": { "role": "shared-icon", "semanticRole": "shared-icon" } },
    { "id": "named-to-root", "type": "reference", "source": "named-endpoint", "target": "implicit-root-target", "sourcePort": "section-output", "targetPort": "root", "sourceAnchor": "section-output-east", "targetAnchor": "root", "label": "named to root", "data": { "smokeCase": 1 } },
    { "id": "multi-anchor-edge", "type": "reference", "source": "multi-anchor-port", "target": "multi-anchor-target", "sourcePort": "result", "targetPort": "root", "sourceAnchor": "result-right-anchor", "targetAnchor": "root", "label": "same endpoint", "data": { "smokeCase": 3 } },
    { "id": "hidden-handle-edge", "type": "reference", "source": "hidden-handle-port", "target": "legacy-side-node", "sourcePort": "root", "targetPort": "left", "sourceAnchor": "root-focus-anchor", "targetAnchor": "left", "label": "hidden anchor survives", "data": { "smokeCase": 4 } },
    { "id": "legacy-side-edge", "type": "reference", "source": "legacy-side-node", "target": "edge-edit-target", "sourcePort": "right", "targetPort": "accept", "sourceAnchor": "right", "targetAnchor": "accept-left", "label": "legacy side", "data": { "legacyInterpretation": { "sourcePort": "root", "sourceAnchor": "right" }, "smokeCase": 5 } },
    { "id": "edge-edit-control", "type": "reference", "source": "multi-anchor-port", "target": "edge-edit-target", "sourcePort": "result", "targetPort": "accept", "sourceAnchor": "result-left-anchor", "targetAnchor": "accept-left", "label": "reassign me", "data": { "smokeCase": 6 } }
  ]
