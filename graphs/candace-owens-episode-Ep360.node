      "visible": true,
      "showLabel": true,
      "data": {
        "markdown": "## Edge Legend\n\n- **Slate** — sequence: chronological chapter flow\n- **Gray** — context: background detail, not a claim\n- **Amber** — testimony: sourced statement, recording, or report\n- **Red** — personal statement: subject's own stated belief\n- **Violet** — host opinion: host's interpretation/argument",
        "memo": "",
        "link": "",
        "html": "",
        "svg": "",
        "visibilityRole": "browser",
        "identity": {
          "graphId": "e2998c24-2b3b-4ecf-af85-e105ac64fafc"
        },
        "_placement": {
          "version": 1,
          "state": "manually-shaped",
          "source": "manual",
          "updatedAt": 1784175560085,
          "reason": "node-drag"
        }
