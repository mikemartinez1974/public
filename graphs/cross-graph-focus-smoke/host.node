        "source": "return await api.sendHandoff({\n  edgeId: 'focus-host-handoff-edge',\n  payload: {\n    schema: 'twilite://schema/text@1',\n    contentType: 'text/plain',\n    value: 'Hello from the host graph'\n  }\n});",
