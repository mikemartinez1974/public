    {
      "id": "glyph-tutorial-poster-what",
      "type": "page-section",
      "label": "What it is",
      "position": {
        "x": -270,
        "y": -200
      },
      "width": 1100,
      "height": 560,
      "data": {
        "title": "What it is",
        "body": "A Glyph is a node's mark: the small symbol that stands for it when it is too far away or too small to read. Every chain of faces ends in one. It is either a named icon (a house, a gear, a star) or a single character, like § or ⚑. A glyph is not a face. It has no page to show, only a mark.",
        "presentation": {
          "glyph": {
            "kind": "icon",
            "name": "Article"
          },
          "baseLevel": "detail"
        },
        "identity": {
          "graphId": "glyph-tutorial-poster"
        },
        "classRef": "tlz://twilite.zone/library/templates/page-template/classes/page-section.node-class.node"
      },
