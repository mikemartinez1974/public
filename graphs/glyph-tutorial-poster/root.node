    {
      "id": "glyph-tutorial-poster-try",
      "type": "page-section",
      "label": "Try it",
      "position": {
        "x": 930,
        "y": -200
      },
      "width": 1100,
      "height": 560,
      "data": {
        "title": "Try it",
        "body": "1. Switch to edit mode (the pencil).\n2. Press Add node and choose Glyph. A card with a small mark appears.\n3. Select it and press Edit, or double-click it. The editor opens in the side panel.\n4. Leave Kind on Material icon and type in the Icon box, say \"star\". Pick one from the list and the card changes.\n5. Change Kind to Text symbol and type one character. Only the first character counts.\n6. Zoom out. Faces fold down to their summary and then to the Glyph, so your mark is what you see at a distance.",
        "presentation": {
          "glyph": {
            "kind": "icon",
            "name": "Article"
          },
          "baseLevel": "detail"
        },
        "identity": {
          "graphId": "glyph-tutorial-poster"
        },
