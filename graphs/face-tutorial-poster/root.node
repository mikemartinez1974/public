    {
      "id": "face-tutorial-poster-try",
      "type": "page-section",
      "label": "Try it",
      "position": {
        "x": 930,
        "y": -200
      },
      "width": 1100,
      "height": 560,
      "data": {
        "title": "Try it",
        "body": "1. Switch to edit mode (the pencil).\n2. Press Add node and choose Face. A card appears.\n3. Select it and press Edit. Write what the face should show, or draw from its surface delegate handle to a Content node to show that instead.\n4. Add a second, smaller face and draw from the first face’s sequence-out handle to the second’s sequence-in. That joins them in a chain, the first for up close and the second for a glance.\n5. End the chain with a Glyph: draw from the last face’s sequence-out to it.\n6. Draw from the graph’s root, from its surfaces handle, to the first face. Now the graph shows itself through that chain.",
        "presentation": {
          "glyph": {
            "kind": "icon",
            "name": "Article"
          },
          "baseLevel": "detail"
        },
        "identity": {
          "graphId": "face-tutorial-poster"
        },
        "classRef": "tlz://twilite.zone/library/templates/page-template/classes/page-section.node-class.node"
