    {
      "id": "face-tutorial-poster-what",
      "type": "page-section",
      "label": "What it is",
      "position": {
        "x": -270,
        "y": -200
      },
      "width": 1100,
      "height": 560,
      "data": {
        "title": "What it is",
        "body": "A Face is one way a node or a graph looks. It shows material, either its own or a Content node’s, and a node can have several faces joined in a chain: a full one for up close, a short one for a glance. The chain ends in a Glyph, the node’s mark. Whoever is looking picks the face that fits the room it has. Faces are named by their author; Detail and Summary are the usual names, not required ones.",
        "presentation": {
          "glyph": {
            "kind": "icon",
            "name": "Article"
          },
          "baseLevel": "detail"
        },
        "identity": {
          "graphId": "face-tutorial-poster"
        },
        "classRef": "tlz://twilite.zone/library/templates/page-template/classes/page-section.node-class.node"
