          "label": "root",
          "direction": "input",
          "dataType": "any",
          "angle": 270,
          "portId": "root"
        }
      ],
      "visible": true,
      "showLabel": true,
      "data": {
        "identity": {
          "graphId": "red-hood-demo"
        },
        "view": {
          "intent": "node",
          "payload": "node.web.detail",
          "scroll": "page"
        },
        "semanticLevel": "detail",
        "content": {
          "kind": "html",
          "value": "<div style='container-type:inline-size;width:100%;height:100%;overflow:auto;background:#faf8ff;font-family:Georgia,Iowan Old Style,Palatino Linotype,serif;color:#1f2937'><div style='box-sizing:border-box;min-height:100%;padding:4.4cqw 7cqw 5cqw'><div style='font:700 1.3cqw/1 ui-monospace,SFMono-Regular,Menlo,Consolas,monospace;letter-spacing:.3em;text-transform:uppercase;color:#6d28d9'>Story <span style='display:inline-block;padding:.3cqw 1.3cqw;border-radius:9cqw;font:700 1.2cqw/1.4 Inter,system-ui,Segoe UI,Helvetica Neue,Arial,sans-serif;letter-spacing:.06em;text-transform:uppercase;vertical-align:middle;background:#fff;color:#6d28d9;border:1px solid #6d28d9'>Revising</span></div><div style='font:700 5.2cqw/1.12 Georgia,Iowan Old Style,Palatino Linotype,serif;margin:1.4cqw 0 .8cqw;color:#1f2937'>Little Red Riding Hood</div><div style='font:italic 2.1cqw/1.5 Georgia,Iowan Old Style,Palatino Linotype,serif;color:#334155;margin-top:2cqw;max-width:62cqw'>A girl is sent through the forest with a basket for her sick grandmother, and a wolf who has noticed her gets there first.</div><div style='margin-top:1.6cqw;font:600 1.6cqw/1.4 Inter,system-ui,Segoe UI,Helvetica Neue,Arial,sans-serif;color:#64748b'>5 scenes · 4 characters · 3 places · 2 threads (0 open)</div><div style='font:700 1.3cqw/1 ui-monospace,SFMono-Regular,Menlo,Consolas,monospace;letter-spacing:.24em;text-transform:uppercase;color:#6d28d9;margin:4cqw 0 1.6cqw;padding-top:2cqw;border-top:.15cqw solid rgba(109,40,217,.35)'>The cast</div><div style='margin-bottom:1.8cqw'><div style='font:700 1.9cqw/1.3 Georgia,Iowan Old Style,Palatino Linotype,serif;color:#1f2937'>Little Red Riding Hood<span style='margin-left:1.4cqw;font:600 1.3cqw/1 Inter,system-ui,Segoe UI,Helvetica Neue,Arial,sans-serif;color:#64748b'>in 4 scenes</span></div><div style='font:italic 1.6cqw/1.5 Georgia,Iowan Old Style,Palatino Linotype,serif;color:#be123c;margin-top:.3cqw'>Wants: To bring her grandmother the basket</div><div style='font:400 1.7cqw/1.55 Georgia,Iowan Old Style,Palatino Linotype,serif;color:#334155;margin-top:.4cqw'>A trusting child, known by the red hood her grandmother gave her.</div></div><div style='margin-bottom:1.8cqw'><div style='font:700 1.9cqw/1.3 Georgia,Iowan Old Style,Palatino Linotype,serif;color:#1f2937'>The Wolf<span style='margin-left:1.4cqw;font:600 1.3cqw/1 Inter,system-ui,Segoe UI,Helvetica Neue,Arial,sans-serif;color:#64748b'>in 4 scenes</span></div><div style='font:italic 1.6cqw/1.5 Georgia,Iowan Old Style,Palatino Linotype,serif;color:#be123c;margin-top:.3cqw'>Wants: To eat them both</div><div style='font:400 1.7cqw/1.55 Georgia,Iowan Old Style,Palatino Linotype,serif;color:#334155;margin-top:.4cqw'>Polite, patient and hungry. He talks his way into everything.</div></div><div style='margin-bottom:1.8cqw'><div style='font:700 1.9cqw/1.3 Georgia,Iowan Old Style,Palatino Linotype,serif;color:#1f2937'>The Grandmother<span style='margin-left:1.4cqw;font:600 1.3cqw/1 Inter,system-ui,Segoe UI,Helvetica Neue,Arial,sans-serif;color:#64748b'>in 2 scenes</span></div><div style='font:italic 1.6cqw/1.5 Georgia,Iowan Old Style,Palatino Linotype,serif;color:#be123c;margin-top:.3cqw'>Wants: To get well</div><div style='font:400 1.7cqw/1.55 Georgia,Iowan Old Style,Palatino Linotype,serif;color:#334155;margin-top:.4cqw'>Ill in bed, in a house at the far edge of the forest.</div></div><div style='margin-bottom:1.8cqw'><div style='font:700 1.9cqw/1.3 Georgia,Iowan Old Style,Palatino Linotype,serif;color:#1f2937'>The Hunter<span style='margin-left:1.4cqw;font:600 1.3cqw/1 Inter,system-ui,Segoe UI,Helvetica Neue,Arial,sans-serif;color:#64748b'>in 1 scene</span></div><div style='font:italic 1.6cqw/1.5 Georgia,Iowan Old Style,Palatino Linotype,serif;color:#be123c;margin-top:.3cqw'>Wants: To find out why the house is so quiet</div><div style='font:400 1.7cqw/1.55 Georgia,Iowan Old Style,Palatino Linotype,serif;color:#334155;margin-top:.4cqw'>Passing by, he hears the snoring and does not trust it.</div></div><div style='font:700 1.3cqw/1 ui-monospace,SFMono-Regular,Menlo,Consolas,monospace;letter-spacing:.24em;text-transform:uppercase;color:#6d28d9;margin:4cqw 0 1.6cqw;padding-top:2cqw;border-top:.15cqw solid rgba(109,40,217,.35)'>The places</div><div style='margin-bottom:1.6cqw'><div style='font:700 1.8cqw/1.3 Georgia,Iowan Old Style,Palatino Linotype,serif;color:#1f2937'>The cottage<span style='margin-left:1.4cqw;font:600 1.3cqw/1 Inter,system-ui,Segoe UI,Helvetica Neue,Arial,sans-serif;color:#64748b'>1 scene</span></div><div style='font:400 1.7cqw/1.55 Georgia,Iowan Old Style,Palatino Linotype,serif;color:#334155;margin-top:.4cqw'>Home, warm and safe: where the warning is given.</div></div><div style='margin-bottom:1.6cqw'><div style='font:700 1.8cqw/1.3 Georgia,Iowan Old Style,Palatino Linotype,serif;color:#1f2937'>The forest path<span style='margin-left:1.4cqw;font:600 1.3cqw/1 Inter,system-ui,Segoe UI,Helvetica Neue,Arial,sans-serif;color:#64748b'>1 scene</span></div><div style='font:400 1.7cqw/1.55 Georgia,Iowan Old Style,Palatino Linotype,serif;color:#334155;margin-top:.4cqw'>Sun between the trees, flowers just off the path: pretty, and not safe.</div></div><div style='margin-bottom:1.6cqw'><div style='font:700 1.8cqw/1.3 Georgia,Iowan Old Style,Palatino Linotype,serif;color:#1f2937'>The grandmother&#39;s house<span style='margin-left:1.4cqw;font:600 1.3cqw/1 Inter,system-ui,Segoe UI,Helvetica Neue,Arial,sans-serif;color:#64748b'>3 scenes</span></div><div style='font:400 1.7cqw/1.55 Georgia,Iowan Old Style,Palatino Linotype,serif;color:#334155;margin-top:.4cqw'>Alone at the edge of the wood, so nobody hears.</div></div><div style='font:700 1.3cqw/1 ui-monospace,SFMono-Regular,Menlo,Consolas,monospace;letter-spacing:.24em;text-transform:uppercase;color:#6d28d9;margin:4cqw 0 1.6cqw;padding-top:2cqw;border-top:.15cqw solid rgba(109,40,217,.35)'>The scenes, in order</div><div style='margin-bottom:2.6cqw;padding:2.2cqw 2.6cqw;border-radius:1.2cqw;background:#fff;border:1px solid #e2e8f0'><div style='display:flex;justify-content:space-between;gap:2cqw;align-items:baseline'><div style='font:700 2.1cqw/1.3 Georgia,Iowan Old Style,Palatino Linotype,serif;color:#1f2937'><span style='color:#4338ca;font:700 1.4cqw/1 ui-monospace,SFMono-Regular,Menlo,Consolas,monospace;letter-spacing:.14em;margin-right:1.4cqw'>SCENE 1</span>Mother sends Red</div><div style='flex:0 0 auto'><span style='display:inline-block;padding:.3cqw 1.3cqw;border-radius:9cqw;font:700 1.2cqw/1.4 Inter,system-ui,Segoe UI,Helvetica Neue,Arial,sans-serif;letter-spacing:.06em;text-transform:uppercase;vertical-align:middle;background:#4338ca;color:#fff'>Revised</span></div></div><div style='font:600 1.4cqw/1.6 Inter,system-ui,Segoe UI,Helvetica Neue,Arial,sans-serif;color:#64748b;margin-top:.6cqw'><span style='color:#0e7490'>The cottage</span> · <span style='color:#be123c'>Little Red Riding Hood</span></div><div style='font:400 1.7cqw/1.55 Georgia,Iowan Old Style,Palatino Linotype,serif;color:#334155;margin-top:.4cqw'>Her mother packs a basket and warns her to keep to the path and not to talk to strangers.</div><div style='margin-top:.8cqw;font:italic 1.5cqw/1.5 Georgia,Iowan Old Style,Palatino Linotype,serif;color:#b45309'>Carries <b style='font-style:normal'>Stay on the path</b> · she is warned</div></div><div style='margin-bottom:2.6cqw;padding:2.2cqw 2.6cqw;border-radius:1.2cqw;background:#fff;border:1px solid #e2e8f0'><div style='display:flex;justify-content:space-between;gap:2cqw;align-items:baseline'><div style='font:700 2.1cqw/1.3 Georgia,Iowan Old Style,Palatino Linotype,serif;color:#1f2937'><span style='color:#4338ca;font:700 1.4cqw/1 ui-monospace,SFMono-Regular,Menlo,Consolas,monospace;letter-spacing:.14em;margin-right:1.4cqw'>SCENE 2</span>The wolf on the path</div><div style='flex:0 0 auto'><span style='display:inline-block;padding:.3cqw 1.3cqw;border-radius:9cqw;font:700 1.2cqw/1.4 Inter,system-ui,Segoe UI,Helvetica Neue,Arial,sans-serif;letter-spacing:.06em;text-transform:uppercase;vertical-align:middle;background:#4338ca;color:#fff'>Revised</span></div></div><div style='font:600 1.4cqw/1.6 Inter,system-ui,Segoe UI,Helvetica Neue,Arial,sans-serif;color:#64748b;margin-top:.6cqw'><span style='color:#0e7490'>The forest path</span> · <span style='color:#be123c'>Little Red Riding Hood, The Wolf</span></div><div style='font:400 1.7cqw/1.55 Georgia,Iowan Old Style,Palatino Linotype,serif;color:#334155;margin-top:.4cqw'>He greets her kindly, learns where she is going, and sends her to pick flowers while he goes ahead.</div><div style='margin-top:.8cqw;font:italic 1.5cqw/1.5 Georgia,Iowan Old Style,Palatino Linotype,serif;color:#b45309'>Carries <b style='font-style:normal'>Stay on the path</b> · she strays</div><div style='margin-top:.8cqw;font:italic 1.5cqw/1.5 Georgia,Iowan Old Style,Palatino Linotype,serif;color:#b45309'>Carries <b style='font-style:normal'>The wolf&#39;s hunger</b> · he sizes her up</div></div><div style='margin-bottom:2.6cqw;padding:2.2cqw 2.6cqw;border-radius:1.2cqw;background:#fff;border:1px solid #e2e8f0'><div style='display:flex;justify-content:space-between;gap:2cqw;align-items:baseline'><div style='font:700 2.1cqw/1.3 Georgia,Iowan Old Style,Palatino Linotype,serif;color:#1f2937'><span style='color:#4338ca;font:700 1.4cqw/1 ui-monospace,SFMono-Regular,Menlo,Consolas,monospace;letter-spacing:.14em;margin-right:1.4cqw'>SCENE 3</span>The wolf at the house</div><div style='flex:0 0 auto'><span style='display:inline-block;padding:.3cqw 1.3cqw;border-radius:9cqw;font:700 1.2cqw/1.4 Inter,system-ui,Segoe UI,Helvetica Neue,Arial,sans-serif;letter-spacing:.06em;text-transform:uppercase;vertical-align:middle;background:#fff;color:#4338ca;border:1px solid #4338ca'>Drafted</span></div></div><div style='font:600 1.4cqw/1.6 Inter,system-ui,Segoe UI,Helvetica Neue,Arial,sans-serif;color:#64748b;margin-top:.6cqw'><span style='color:#0e7490'>The grandmother&#39;s house</span> · <span style='color:#be123c'>The Wolf, The Grandmother</span></div><div style='font:400 1.7cqw/1.55 Georgia,Iowan Old Style,Palatino Linotype,serif;color:#334155;margin-top:.4cqw'>He gets in by pretending to be Red, and swallows the grandmother.</div><div style='margin-top:.8cqw;font:italic 1.5cqw/1.5 Georgia,Iowan Old Style,Palatino Linotype,serif;color:#b45309'>Carries <b style='font-style:normal'>The wolf&#39;s hunger</b> · he swallows the grandmother</div></div><div style='margin-bottom:2.6cqw;padding:2.2cqw 2.6cqw;border-radius:1.2cqw;background:#fff;border:1px solid #e2e8f0'><div style='display:flex;justify-content:space-between;gap:2cqw;align-items:baseline'><div style='font:700 2.1cqw/1.3 Georgia,Iowan Old Style,Palatino Linotype,serif;color:#1f2937'><span style='color:#4338ca;font:700 1.4cqw/1 ui-monospace,SFMono-Regular,Menlo,Consolas,monospace;letter-spacing:.14em;margin-right:1.4cqw'>SCENE 4</span>Red at the bedside</div><div style='flex:0 0 auto'><span style='display:inline-block;padding:.3cqw 1.3cqw;border-radius:9cqw;font:700 1.2cqw/1.4 Inter,system-ui,Segoe UI,Helvetica Neue,Arial,sans-serif;letter-spacing:.06em;text-transform:uppercase;vertical-align:middle;background:#fff;color:#4338ca;border:1px solid #4338ca'>Drafted</span></div></div><div style='font:600 1.4cqw/1.6 Inter,system-ui,Segoe UI,Helvetica Neue,Arial,sans-serif;color:#64748b;margin-top:.6cqw'><span style='color:#0e7490'>The grandmother&#39;s house</span> · <span style='color:#be123c'>Little Red Riding Hood, The Wolf</span></div><div style='font:400 1.7cqw/1.55 Georgia,Iowan Old Style,Palatino Linotype,serif;color:#334155;margin-top:.4cqw'>She notices the changes one at a time, and asks about each: the ears, the eyes, the teeth.</div><div style='margin-top:.8cqw;font:italic 1.5cqw/1.5 Georgia,Iowan Old Style,Palatino Linotype,serif;color:#b45309'>Carries <b style='font-style:normal'>The wolf&#39;s hunger</b> · he swallows Red</div></div><div style='margin-bottom:2.6cqw;padding:2.2cqw 2.6cqw;border-radius:1.2cqw;background:#fff;border:1px solid #e2e8f0'><div style='display:flex;justify-content:space-between;gap:2cqw;align-items:baseline'><div style='font:700 2.1cqw/1.3 Georgia,Iowan Old Style,Palatino Linotype,serif;color:#1f2937'><span style='color:#4338ca;font:700 1.4cqw/1 ui-monospace,SFMono-Regular,Menlo,Consolas,monospace;letter-spacing:.14em;margin-right:1.4cqw'>SCENE 5</span>The hunter comes</div><div style='flex:0 0 auto'><span style='display:inline-block;padding:.3cqw 1.3cqw;border-radius:9cqw;font:700 1.2cqw/1.4 Inter,system-ui,Segoe UI,Helvetica Neue,Arial,sans-serif;letter-spacing:.06em;text-transform:uppercase;vertical-align:middle;background:#fff;color:#64748b;border:1px solid #64748b'>Idea</span></div></div><div style='font:600 1.4cqw/1.6 Inter,system-ui,Segoe UI,Helvetica Neue,Arial,sans-serif;color:#64748b;margin-top:.6cqw'><span style='color:#0e7490'>The grandmother&#39;s house</span> · <span style='color:#be123c'>Little Red Riding Hood, The Wolf, The Grandmother, The Hunter</span></div><div style='font:400 1.7cqw/1.55 Georgia,Iowan Old Style,Palatino Linotype,serif;color:#334155;margin-top:.4cqw'>He cuts the wolf open, and both of them walk out alive.</div><div style='margin-top:.8cqw;font:italic 1.5cqw/1.5 Georgia,Iowan Old Style,Palatino Linotype,serif;color:#b45309'>Carries <b style='font-style:normal'>Stay on the path</b> · the cost is paid</div><div style='margin-top:.8cqw;font:italic 1.5cqw/1.5 Georgia,Iowan Old Style,Palatino Linotype,serif;color:#b45309'>Carries <b style='font-style:normal'>The wolf&#39;s hunger</b> · he is stopped</div></div><div style='font:700 1.3cqw/1 ui-monospace,SFMono-Regular,Menlo,Consolas,monospace;letter-spacing:.24em;text-transform:uppercase;color:#6d28d9;margin:4cqw 0 1.6cqw;padding-top:2cqw;border-top:.15cqw solid rgba(109,40,217,.35)'>The threads</div><div style='margin-bottom:2cqw;padding:1.8cqw 2.2cqw;border-radius:1.2cqw;background:#fff;border:1px solid #fde68a'><div style='display:flex;justify-content:space-between;gap:2cqw;align-items:baseline'><div style='font:700 1.9cqw/1.3 Georgia,Iowan Old Style,Palatino Linotype,serif;color:#1f2937'>Stay on the path</div><div style='flex:0 0 auto'><span style='display:inline-block;padding:.3cqw 1.3cqw;border-radius:9cqw;font:700 1.2cqw/1.4 Inter,system-ui,Segoe UI,Helvetica Neue,Arial,sans-serif;letter-spacing:.06em;text-transform:uppercase;vertical-align:middle;background:#b45309;color:#fff'>Resolved</span></div></div><div style='font:600 1.4cqw/1.5 Inter,system-ui,Segoe UI,Helvetica Neue,Arial,sans-serif;color:#64748b;margin-top:.6cqw'>Runs through: Mother sends Red, The wolf on the path, The hunter comes</div><div style='font:400 1.7cqw/1.55 Georgia,Iowan Old Style,Palatino Linotype,serif;color:#334155;margin-top:.4cqw'>Red is told not to stray. Whether she will, and what it costs, is what the reader is waiting to see.</div></div><div style='margin-bottom:2cqw;padding:1.8cqw 2.2cqw;border-radius:1.2cqw;background:#fff;border:1px solid #fde68a'><div style='display:flex;justify-content:space-between;gap:2cqw;align-items:baseline'><div style='font:700 1.9cqw/1.3 Georgia,Iowan Old Style,Palatino Linotype,serif;color:#1f2937'>The wolf&#39;s hunger</div><div style='flex:0 0 auto'><span style='display:inline-block;padding:.3cqw 1.3cqw;border-radius:9cqw;font:700 1.2cqw/1.4 Inter,system-ui,Segoe UI,Helvetica Neue,Arial,sans-serif;letter-spacing:.06em;text-transform:uppercase;vertical-align:middle;background:#b45309;color:#fff'>Resolved</span></div></div><div style='font:600 1.4cqw/1.5 Inter,system-ui,Segoe UI,Helvetica Neue,Arial,sans-serif;color:#64748b;margin-top:.6cqw'>Runs through: The wolf on the path, The wolf at the house, Red at the bedside, The hunter comes</div><div style='font:400 1.7cqw/1.55 Georgia,Iowan Old Style,Palatino Linotype,serif;color:#334155;margin-top:.4cqw'>He has already decided. The question is who he reaches first, and who stops him.</div></div></div></div>"
        },
        "memo": "The Detail: the story as an outline, scene by scene, written from the cards. The Method writes it, so edit the cards and not this.",
