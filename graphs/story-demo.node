          "value": "<div style='container-type:inline-size;width:100%;height:100%'><div style='box-sizing:border-box;width:100%;height:100%;padding:7cqw 8cqw;border-radius:6cqw;background:#faf8ff;border:.9cqw solid #6d28d9;display:flex;align-items:center;gap:6cqw;color:#1f2937;overflow:hidden'><div style='flex:0 0 24cqw'><svg viewBox='0 0 64 64' style='width:100%;height:100%;display:block' aria-hidden='true'><g fill='none' stroke='#6d28d9' stroke-width='5' stroke-linecap='round' stroke-linejoin='round'><path d='M32 14C26 10 16 9 8 11V50C16 48 26 49 32 53'/><path d='M32 14C38 10 48 9 56 11V50C48 48 38 49 32 53'/><path d='M32 14V53'/></g></svg></div><div style='min-width:0;flex:1'><div style='font:700 3.2cqw/1 ui-monospace,SFMono-Regular,Menlo,Consolas,monospace;letter-spacing:.24em;text-transform:uppercase;color:#6d28d9'>Story</div><div style='font:700 8.2cqw/1.12 Georgia,Iowan Old Style,Palatino Linotype,serif;margin:2cqw 0 1.2cqw;display:-webkit-box;-webkit-line-clamp:3;-webkit-box-orient:vertical;overflow:hidden'>Little Red Riding Hood</div><div style='font:600 3.6cqw/1.3 Inter,system-ui,Segoe UI,Helvetica Neue,Arial,sans-serif;color:#334155'>5 scenes · 4 characters</div><div style='margin-top:2cqw;font:700 3.8cqw/1.3 Inter,system-ui,Segoe UI,Helvetica Neue,Arial,sans-serif;color:#64748b'>Revising</div><div style='margin-top:1.4cqw;font:600 3.2cqw/1.3 Inter,system-ui,Segoe UI,Helvetica Neue,Arial,sans-serif;color:#64748b'>3 places · 0 of 2 threads open</div></div></div></div>"
