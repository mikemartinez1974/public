    {
      "id": "red-hood-derive-method",
      "type": "method",
      "label": "Derive the story views",
      "position": {
        "x": -50,
        "y": 1233
      },
      "width": 420,
      "height": 260,
      "ports": [
        {
          "id": "call",
          "key": "call",
          "label": "Call",
          "direction": "input",
          "dataType": "event",
          "angle": 180
        },
        {
          "id": "result",
          "key": "result",
          "label": "Result",
          "direction": "output",
          "dataType": "value",
          "angle": 0
        }
      ],
      "handles": [
        {
          "id": "call",
          "key": "call",
          "label": "Call",
          "direction": "input",
          "dataType": "event",
          "angle": 180,
          "portId": "call"
        },
        {
          "id": "result",
          "key": "result",
          "label": "Result",
          "direction": "output",
          "dataType": "value",
          "angle": 0,
          "portId": "result"
        }
      ],
      "visible": true,
      "showLabel": true,
      "data": {
        "scriptName": "Derive the story views",
        "parameters": [],
        "source": "// Derives a story's views from its cards: nothing is typed into a view.\n// It reads the Story (the card of that type: title and premise), its Characters, Places, Scenes and Threads, and the edges between them: `precedes` (the order of the scenes), `appears-in` (a character to a\n// scene they are in), `set-in` (a scene to the place it happens in) and `weaves` (a thread to a scene it runs through; the label says what the scene does for it). It writes the Detail (the story as an\n// outline, scene by scene, with the cast, the places and the threads) and the Summary (a card), and the Glyph, and only those, which its declared effects say. It counts what there is and what is still open\n// and shows the counts; it never scores a story, and it never decides a story is finished. Anything a card marks `check` (\"I am not sure this is right\") is gathered in a notice at the top and on the card.\nconst clean = (value) => String(value ?? '').trim();\nconst esc = (value) => clean(value).replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/\"/g, '&quot;').replace(/'/g, '&#39;');\nconst SERIF = 'Georgia,Iowan Old Style,Palatino Linotype,serif'; const SANS = 'Inter,system-ui,Segoe UI,Helvetica Neue,Arial,sans-serif'; const MONO = 'ui-monospace,SFMono-Regular,Menlo,Consolas,monospace';\nconst VIOLET = '#6d28d9'; const INK = '#1f2937'; const PAPER = '#faf8ff'; const MUTED = '#64748b'; const AMBER = '#92400e'; const GOLD = '#b45309'; const ROSE = '#be123c'; const CYAN = '#0e7490'; const INDIGO = '#4338ca';\n\nconst nodes = await api.getNodes();\nconst edges = await api.getEdges();\nconst ofType = (type) => nodes.filter((node) => clean(node.type) === type);\nconst byId = (id) => nodes.find((node) => node.id === id);\nconst nameOf = (node) => clean(node?.data?.title || node?.label) || 'Untitled';\nconst edgesOf = (type) => edges.filter((e) => clean(e.type) === type);\n\n// a list in the order its `precedes` edges give; whatever they do not reach follows, in the order it came\nconst inOrder = (items) => {\n  const ids = new Set(items.map((item) => item.id));\n  const next = new Map(); const hasPrevious = new Set();\n  for (const e of edgesOf('precedes')) if (ids.has(e.source) && ids.has(e.target) && !next.has(e.source)) { next.set(e.source, e.target); hasPrevious.add(e.target); }\n  const out = []; const seen = new Set();\n  for (const head of items.filter((item) => !hasPrevious.has(item.id))) {\n    let current = head;\n    while (current && !seen.has(current.id)) { out.push(current); seen.add(current.id); current = byId(next.get(current.id)); }\n  }\n  for (const item of items) if (!seen.has(item.id)) out.push(item);\n  return out;\n};\nconst sourcesOf = (to, type, kind) => edgesOf(type).filter((e) => e.target === to.id).map((e) => ({ node: byId(e.source), label: clean(e.label) })).filter((r) => r.node && (!kind || clean(r.node.type) === kind));\nconst targetsOf = (from, type, kind) => edgesOf(type).filter((e) => e.source === from.id).map((e) => ({ node: byId(e.target), label: clean(e.label) })).filter((r) => r.node && (!kind || clean(r.node.type) === kind));\n\nconst story = ofType('story')[0] || null;\nconst characters = ofType('character');\nconst places = ofType('place');\nconst scenes = inOrder(ofType('scene'));\nconst threads = ofType('thread');\nconst flagged = [story, ...characters, ...places, ...scenes, ...threads].filter((node) => node && node.data?.check === true);\nconst openThreads = threads.filter((t) => t.data?.resolved !== true);\nconst status = clean(story?.data?.status) || 'idea';\nconst name = story ? nameOf(story) : 'Name the story';\nconst premise = clean(story?.data?.body);\nconst plural = (n, one, many) => `${n} ${n === 1 ? one : many}`;\nconst STATUS = { idea: 'Idea', drafting: 'Drafting', revising: 'Revising', done: 'Done' };\nconst standing = STATUS[status] || 'Idea';\n\nconst flag = (node) => (node?.data?.check === true ? `<span style='display:inline-block;margin-left:1cqw;padding:.2cqw 1cqw;border-radius:9cqw;background:#fffbeb;border:1px solid #fde68a;color:${AMBER};font:700 1.2cqw/1.4 ${SANS};letter-spacing:.06em;text-transform:uppercase;vertical-align:middle'>to check</span>` : '');\nconst heading = (text) => `<div style='font:700 1.3cqw/1 ${MONO};letter-spacing:.24em;text-transform:uppercase;color:${VIOLET};margin:4cqw 0 1.6cqw;padding-top:2cqw;border-top:.15cqw solid rgba(109,40,217,.35)'>${text}</div>`;\nconst para = (text, size = 1.7) => (clean(text) ? `<div style='font:400 ${size}cqw/1.55 ${SERIF};color:#334155;margin-top:.4cqw'>${esc(text)}</div>` : '');\nconst chip = (text, colour, solid = false) => `<span style='display:inline-block;padding:.3cqw 1.3cqw;border-radius:9cqw;font:700 1.2cqw/1.4 ${SANS};letter-spacing:.06em;text-transform:uppercase;vertical-align:middle;${solid ? `background:${colour};color:#fff` : `background:#fff;color:${colour};border:1px solid ${colour}`}'>${text}</span>`;\nconst stageChip = (scene) => ({ revised: chip('Revised', INDIGO, true), drafted: chip('Drafted', INDIGO) }[clean(scene.data?.stage)] || chip('Idea', MUTED));\n\nconst scenesOf = (node, type) => scenes.filter((scene) => (type === 'appears-in' ? sourcesOf(scene, 'appears-in', 'character') : sourcesOf(scene, 'weaves', 'thread')).some((r) => r.node.id === node.id));\nconst placeOf = (scene) => targetsOf(scene, 'set-in', 'place')[0]?.node || null;\nconst scenesAt = (place) => scenes.filter((scene) => placeOf(scene)?.id === place.id);\n\nconst characterBlock = (c) => `<div style='margin-bottom:1.8cqw'><div style='font:700 1.9cqw/1.3 ${SERIF};color:${INK}'>${esc(nameOf(c))}${flag(c)}<span style='margin-left:1.4cqw;font:600 1.3cqw/1 ${SANS};color:${MUTED}'>in ${plural(scenesOf(c, 'appears-in').length, 'scene', 'scenes')}</span></div>${clean(c.data?.want) ? `<div style='font:italic 1.6cqw/1.5 ${SERIF};color:${ROSE};margin-top:.3cqw'>Wants: ${esc(c.data.want)}</div>` : ''}${para(c.data?.body)}</div>`;\nconst placeBlock = (p) => `<div style='margin-bottom:1.6cqw'><div style='font:700 1.8cqw/1.3 ${SERIF};color:${INK}'>${esc(nameOf(p))}${flag(p)}<span style='margin-left:1.4cqw;font:600 1.3cqw/1 ${SANS};color:${MUTED}'>${plural(scenesAt(p).length, 'scene', 'scenes')}</span></div>${para(p.data?.body)}</div>`;\nconst sceneBlock = (scene, index) => {\n  const cast = sourcesOf(scene, 'appears-in', 'character').map((r) => nameOf(r.node));\n  const woven = sourcesOf(scene, 'weaves', 'thread');\n  const place = placeOf(scene);\n  return `<div style='margin-bottom:2.6cqw;padding:2.2cqw 2.6cqw;border-radius:1.2cqw;background:#fff;border:1px solid #e2e8f0'>`\n    + `<div style='display:flex;justify-content:space-between;gap:2cqw;align-items:baseline'><div style='font:700 2.1cqw/1.3 ${SERIF};color:${INK}'><span style='color:${INDIGO};font:700 1.4cqw/1 ${MONO};letter-spacing:.14em;margin-right:1.4cqw'>SCENE ${index + 1}</span>${esc(nameOf(scene))}${flag(scene)}</div><div style='flex:0 0 auto'>${stageChip(scene)}</div></div>`\n    + (place || cast.length ? `<div style='font:600 1.4cqw/1.6 ${SANS};color:${MUTED};margin-top:.6cqw'>${place ? `<span style='color:${CYAN}'>${esc(nameOf(place))}</span>` : ''}${place && cast.length ? ' · ' : ''}${cast.length ? `<span style='color:${ROSE}'>${cast.map(esc).join(', ')}</span>` : ''}</div>` : '')\n    + para(scene.data?.body)\n    + woven.map((r) => `<div style='margin-top:.8cqw;font:italic 1.5cqw/1.5 ${SERIF};color:${GOLD}'>Carries <b style='font-style:normal'>${esc(nameOf(r.node))}</b>${r.label ? ` · ${esc(r.label)}` : ''}</div>`).join('')\n    + `</div>`;\n};\nconst threadBlock = (t) => `<div style='margin-bottom:2cqw;padding:1.8cqw 2.2cqw;border-radius:1.2cqw;background:#fff;border:1px solid #fde68a'>`\n  + `<div style='display:flex;justify-content:space-between;gap:2cqw;align-items:baseline'><div style='font:700 1.9cqw/1.3 ${SERIF};color:${INK}'>${esc(nameOf(t))}${flag(t)}</div><div style='flex:0 0 auto'>${t.data?.resolved === true ? chip('Resolved', GOLD, true) : chip('Open', GOLD)}</div></div>`\n  + `<div style='font:600 1.4cqw/1.5 ${SANS};color:${MUTED};margin-top:.6cqw'>${scenesOf(t, 'weaves').length ? `Runs through: ${scenesOf(t, 'weaves').map((s) => esc(nameOf(s))).join(', ')}` : 'Not yet in any scene'}</div>`\n  + para(t.data?.body)\n  + `</div>`;\n\nconst notice = flagged.length\n  ? `<div style='margin-top:2.6cqw;padding:1.4cqw 2cqw;border-radius:1.2cqw;background:#fffbeb;border:1px solid #fde68a;color:${AMBER};font:600 1.5cqw/1.5 ${SANS}'>${plural(flagged.length, 'thing', 'things')} to check: ${flagged.map((node) => esc(nameOf(node))).join(', ')}</div>`\n  : '';\n\nconst detail = `<div style='container-type:inline-size;width:100%;height:100%;overflow:auto;background:${PAPER};font-family:${SERIF};color:${INK}'>`\n  + `<div style='box-sizing:border-box;min-height:100%;padding:4.4cqw 7cqw 5cqw'>`\n  + `<div style='font:700 1.3cqw/1 ${MONO};letter-spacing:.3em;text-transform:uppercase;color:${VIOLET}'>Story ${status === 'done' ? chip('Done', VIOLET, true) : chip(esc(standing), VIOLET)}</div>`\n  + `<div style='font:700 5.2cqw/1.12 ${SERIF};margin:1.4cqw 0 .8cqw;color:${INK}'>${esc(name)}</div>`\n  + (premise ? `<div style='font:italic 2.1cqw/1.5 ${SERIF};color:#334155;margin-top:2cqw;max-width:62cqw'>${esc(premise)}</div>` : '')\n  + `<div style='margin-top:1.6cqw;font:600 1.6cqw/1.4 ${SANS};color:${MUTED}'>${plural(scenes.length, 'scene', 'scenes')} · ${plural(characters.length, 'character', 'characters')} · ${plural(places.length, 'place', 'places')} · ${plural(threads.length, 'thread', 'threads')}${threads.length ? ` (${openThreads.length} open)` : ''}</div>`\n  + notice\n  + (characters.length ? heading('The cast') + characters.map(characterBlock).join('') : '')\n  + (places.length ? heading('The places') + places.map(placeBlock).join('') : '')\n  + (scenes.length ? heading('The scenes, in order') + scenes.map(sceneBlock).join('') : '')\n  + (threads.length ? heading('The threads') + threads.map(threadBlock).join('') : '')\n  + `</div></div>`;\n\nconst bookSvg = (size, colour) => `<svg viewBox='0 0 64 64' style='width:${size};height:${size};display:block' aria-hidden='true'><g fill='none' stroke='${colour}' stroke-width='5' stroke-linecap='round' stroke-linejoin='round'><path d='M32 14C26 10 16 9 8 11V50C16 48 26 49 32 53'/><path d='M32 14C38 10 48 9 56 11V50C48 48 38 49 32 53'/><path d='M32 14V53'/></g></svg>`;\nconst counts = `${plural(scenes.length, 'scene', 'scenes')} · ${plural(characters.length, 'character', 'characters')}`;\nconst summary = `<div style='container-type:inline-size;width:100%;height:100%'><div style='box-sizing:border-box;width:100%;height:100%;padding:7cqw 8cqw;border-radius:6cqw;background:${PAPER};border:.9cqw solid ${VIOLET};display:flex;align-items:center;gap:6cqw;color:${INK};overflow:hidden'>`\n  + `<div style='flex:0 0 24cqw'>${bookSvg('100%', VIOLET)}</div><div style='min-width:0;flex:1'>`\n  + `<div style='font:700 3.2cqw/1 ${MONO};letter-spacing:.24em;text-transform:uppercase;color:${VIOLET}'>Story</div>`\n  + `<div style='font:700 8.2cqw/1.12 ${SERIF};margin:2cqw 0 1.2cqw;display:-webkit-box;-webkit-line-clamp:3;-webkit-box-orient:vertical;overflow:hidden'>${esc(name)}</div>`\n  + `<div style='font:600 3.6cqw/1.3 ${SANS};color:#334155'>${counts}</div>`\n  + `<div style='margin-top:2cqw;font:700 3.8cqw/1.3 ${SANS};color:${status === 'done' ? VIOLET : MUTED}'>${esc(standing)}</div>`\n  + `<div style='margin-top:1.4cqw;font:600 3.2cqw/1.3 ${SANS};color:${MUTED}'>${plural(places.length, 'place', 'places')} · ${threads.length ? `${openThreads.length} of ${plural(threads.length, 'thread', 'threads')} open` : 'no threads'}</div>`\n  + (flagged.length ? `<div style='margin-top:2cqw;display:inline-block;padding:.8cqw 2.4cqw;border-radius:9cqw;background:#fffbeb;border:1px solid #fde68a;color:${AMBER};font:700 3cqw/1.3 ${SANS};letter-spacing:.06em;text-transform:uppercase'>${flagged.length} to check</div>` : '')\n  + `</div></div></div>`;\n\nconst faces = nodes.filter((node) => clean(node.type) === 'face');\nconst faceFor = (level) => faces.find((node) => clean(node.data?.semanticLevel) === level);\nconst glyph = nodes.find((node) => clean(node.type) === 'glyph');\nfor (const [level, html] of [['detail', detail], ['summary', summary]]) {\n  const target = faceFor(level);\n  if (target) await api.updateView(target.id, { content: { kind: 'html', value: html } });\n}\nif (glyph) await api.updateNode(glyph.id, { data: { ...glyph.data, glyph: { kind: 'icon', name: 'AutoStories', color: VIOLET } } });\nreturn { name, scenes: scenes.length, characters: characters.length, places: places.length, threads: threads.length, openThreads: openThreads.length, toCheck: flagged.length };\n",
        "effects": [
          {
            "kind": "update-node",
            "targets": [
              "red-hood-detail",
              "red-hood-summary",
              "red-hood-glyph",
              "red-hood-environment"
            ]
          }
        ],
        "allowMutations": true,
        "dryRun": false,
        "identity": {
          "graphId": "red-hood-declaration"
        }
      }
    },
