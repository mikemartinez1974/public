    {
      "id": "red-hood-detail",
      "type": "face",
      "label": "Story outline",
      "position": {
        "x": -1100,
        "y": 1233
      },
      "width": 450,
      "height": 300,
      "ports": [
        {
          "id": "root",
          "key": "root",
          "label": "root",
          "direction": "input",
