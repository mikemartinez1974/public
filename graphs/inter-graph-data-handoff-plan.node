    {
      "id": "data-handoff-goal",
      "type": "goal",
      "label": "Deliver typed data across a portal-port boundary",
      "position": { "x": 0, "y": -420 },
      "width": 600,
      "height": 300,
      "visible": true,
      "ports": [
        { "id": "top", "label": "top", "direction": "input", "dataType": "value", "angle": 270 },
        { "id": "bottom", "label": "bottom", "direction": "output", "dataType": "value", "angle": 90 }
      ],
      "data": {
        "title": "Deliver typed data across a portal-port boundary",
        "outcome": "A portal can navigate to an exposed port with a validated one-way JSON handoff, and the destination graph can receive it without turning graph authoring into programming.",
        "status": "todo",
        "priority": "high",
        "owner": "Michael",
        "_classBinding": { "key": "goal", "sourceRef": "github://twilite-zone/public/library/classes/nodes/task-planning/goal.node-class.node" }
      }
    },
    {
      "id": "decision-product-sequence",
      "type": "decision",
      "label": "Finish the person-template product first",
      "position": { "x": -360, "y": -40 },
      "width": 520,
      "height": 260,
      "visible": true,
      "ports": [
        { "id": "top", "label": "top", "direction": "input", "dataType": "value", "angle": 270 },
        { "id": "bottom", "label": "bottom", "direction": "output", "dataType": "value", "angle": 90 }
      ],
      "data": {
        "title": "Finish the person-template product first",
        "decision": "Complete and stabilize the person-template experience before implementing inter-graph data channels. Contract exploration may continue, but runtime implementation follows the template milestone.",
        "status": "accepted",
        "owner": "Michael",
        "rationale": "Data handoff opens a second product category: Twilite as an application runtime. The current graph-browser and authoring product should reach a coherent milestone before that boundary expands.",
        "_classBinding": { "key": "decision", "sourceRef": "github://twilite-zone/public/library/classes/nodes/task-planning/decision.node-class.node" }
      }
    },
    {
      "id": "decision-first-slice",
