      "label": "Begin with one-way navigation handoff",
      "position": { "x": 360, "y": -40 },
      "width": 520,
      "height": 260,
      "visible": true,
      "ports": [
        { "id": "top", "label": "top", "direction": "input", "dataType": "value", "angle": 270 },
        { "id": "bottom", "label": "bottom", "direction": "output", "dataType": "value", "angle": 90 }
      ],
      "data": {
        "title": "Begin with one-way navigation handoff",
        "decision": "The first runtime slice carries a JSON-serializable value during explicit portal navigation to a named destination input.",
        "status": "accepted",
        "owner": "Michael",
        "rationale": "This completes the channel ontology without prematurely taking on streaming, persistence, background execution, or automatic bidirectionality.",
        "_classBinding": { "key": "decision", "sourceRef": "github://twilite-zone/public/library/classes/nodes/task-planning/decision.node-class.node" }
      }
    },
