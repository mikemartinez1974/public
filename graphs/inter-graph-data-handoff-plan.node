    {
      "id": "risk-product-boundary",
      "type": "risk",
      "label": "Application-runtime scope overwhelms the browser product",
      "position": { "x": 400, "y": 1460 },
      "width": 460,
      "height": 280,
      "visible": true,
      "ports": [{ "id": "top", "label": "top", "direction": "input", "dataType": "value", "angle": 270 }],
      "data": {
        "title": "Application-runtime scope overwhelms the browser product",
        "description": "Streaming, persistence, remote execution, and automatic return channels could turn the first handoff into an unbounded programming system.",
        "probability": "medium",
        "impact": "high",
        "mitigation": "Ship one-way typed navigation handoff as the only first slice and treat later channel modes as separate capabilities.",
        "status": "open",
        "owner": "Michael",
        "_classBinding": { "key": "risk", "sourceRef": "github://twilite-zone/public/library/classes/nodes/task-planning/risk.node-class.node" }
      }
    },
