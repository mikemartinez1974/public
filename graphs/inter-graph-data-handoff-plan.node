        }
      ],
      "visible": true,
      "showLabel": true,
      "data": {
        "scriptName": "Inter-Graph Data Handoff Summary Updater",
        "summaryNodeId": "data-handoff-summary",
        "autoRun": true,
        "autoRunOnGraphChange": true,
        "autoRunOnLoad": true,
        "allowMutations": true,
        "dryRun": false,
        "source": "const SUMMARY_NODE_ID='data-handoff-summary';const DONE=new Set(['done','complete','completed','closed']);const ANSWERED=new Set(['answered','done','resolved','closed']);const norm=v=>String(v||'').trim().toLowerCase();const normalizeStatus=v=>{const s=norm(v);if(['open','todo','backlog'].includes(s))return 'todo';if(['active','in-progress','in progress'].includes(s))return 'in-progress';if(['achieved','done','complete','completed','closed','resolved'].includes(s))return 'done';if(s==='blocked')return 'blocked';if(['waiting','deferred','paused'].includes(s))return 'waiting';if(['cancelled','canceled','abandoned'].includes(s))return 'cancelled';return s||'todo';};const nodes=await api.getNodes();const summary=nodes.find(n=>n.id===SUMMARY_NODE_ID);const goal=nodes.find(n=>n.type==='goal');if(!summary)return {success:false,error:'Summary node missing'};const byCanvas=(a,b)=>(a.position?.y??0)-(b.position?.y??0)||(a.position?.x??0)-(b.position?.x??0);const tasks=nodes.filter(n=>n.type==='task'&&n.data?.countAsTask!==false).sort(byCanvas);const questions=nodes.filter(n=>n.type==='open-question').sort(byCanvas);const completed=tasks.filter(n=>DONE.has(norm(n.data?.status))).length;const answered=questions.filter(n=>ANSWERED.has(norm(n.data?.status))).length;const goalStatus=normalizeStatus(goal?.data?.status);const active=tasks.some(n=>normalizeStatus(n.data?.status)==='in-progress');const status=goalStatus==='todo'&&(completed>0||active)?'in-progress':goalStatus;const taskTitles=tasks.map(n=>n.data?.title||n.label).filter(Boolean);const questionTitles=questions.map(n=>n.data?.title||n.label).filter(Boolean);const next={...(summary.data||{}),goal:goal?.data?.title||goal?.label||summary.data?.goal||'Task graph',status,priority:goal?.data?.priority||summary.data?.priority||'medium',owner:goal?.data?.owner||summary.data?.owner||'',targetDate:goal?.data?.targetDate||summary.data?.targetDate||'',taskProgress:{completed,total:tasks.length},questionProgress:{answered,total:questions.length},taskTitles,questionTitles,taskListText:taskTitles.map((title,index)=>(index+1)+'. '+title).join('\\n'),questionListText:questionTitles.map((title,index)=>(index+1)+'. '+title).join('\\n'),summarySource:'node-updater',updatedAt:new Date().toISOString()};await api.updateNode(SUMMARY_NODE_ID,{data:next});return {success:true,summary:next};",
        "identity": {
          "graphId": "data-handoff-declaration"
        },
        "_semanticLevel": "detail",
        "scriptId": "",
        "lastResult": null,
        "lastRunAt": 1785371630429,
        "scriptRef": "",
        "_placement": {
          "version": 1,
          "state": "manually-shaped",
          "source": "manual",
          "updatedAt": 1785352008374,
          "reason": "node-drag"
        }
      }
    },
