                  "priorityOrder": [
                    "critical",
                    "high",
                    "medium",
                    "low"
                  ],
                  "tieBreaker": "rank"
                },
                "automation": {
                  "freshReads": true,
                  "retainFailures": true
                }
              },
              "presentation": {
                "glyph": {
                  "kind": "icon",
                  "name": "Dashboard"
                }
              }
            },
            "ports": [
              {
                "id": "root",
                "key": "root",
                "label": "root",
                "direction": "bidirectional",
                "dataType": "any",
                "angle": 180
              }
            ]
          },
          "nodeDef": {
            "key": "workboard",
            "ref": "github://twilite-zone/public/library/classes/nodes/task-planning/workboard.node-class.node",
            "source": "local",
            "version": ">=0.1.0",
            "defaults": {
              "label": "Workboard",
              "size": {
                "width": 720,
                "height": 260
              },
              "showLabel": false,
              "data": {
                "name": "Workboard",
                "description": "A focused operational view of source-owned task graphs.",
                "editorContributions": [
                  {
                    "id": "workboard-task-placement",
                    "match": {
                      "nodeType": "portal",
                      "pathExists": "data.board"
                    },
                    "section": {
                      "key": "placement",
                      "title": "Placement",
                      "summary": "Local workboard lane, ordering, and review state."
                    },
                    "fields": [
                      {
                        "key": "boardLaneMode",
                        "label": "Placement",
                        "type": "select",
                        "path": "data.board.laneMode",
                        "options": [
                          {
                            "label": "Automatic from task status",
                            "value": "auto"
                          },
                          {
                            "label": "Manual lane",
                            "value": "manual"
                          }
                        ],
                        "helperText": "Manual placement and pinning are synchronized for now. A pinned task keeps its selected lane; an unpinned task follows workboard policy."
                      },
                      {
                        "key": "boardLane",
                        "label": "Lane",
                        "type": "select",
                        "path": "data.board.lane",
                        "options": [
                          {
                            "label": "Inbox",
                            "value": "inbox"
                          },
                          {
                            "label": "Now",
                            "value": "now"
                          },
                          {
                            "label": "Next",
                            "value": "next"
                          },
                          {
                            "label": "Waiting",
                            "value": "waiting"
                          },
                          {
                            "label": "Recently Completed",
                            "value": "recently-completed"
                          }
                        ],
                        "visibleWhen": {
                          "path": "data.board.laneMode",
                          "equals": "manual"
                        }
                      },
                      {
                        "key": "boardPinned",
                        "label": "Pinned",
                        "type": "boolean",
                        "path": "data.board.pinned",
                        "helperText": "Pinned currently means manually placed: the task keeps its selected lane and is excluded from automatic placement."
                      },
                      {
                        "key": "boardRank",
                        "label": "Rank",
                        "type": "number",
                        "path": "data.board.rank",
                        "helperText": "Lower ranks appear first after pinning and priority rules."
                      },
                      {
                        "key": "boardReviewedAt",
                        "label": "Reviewed At",
                        "type": "text",
                        "path": "data.board.reviewedAt",
                        "placeholder": "YYYY-MM-DDTHH:mm:ss.sssZ"
                      }
                    ]
                  }
                ],
                "policy": {
                  "defaultLaneMode": "auto",
                  "unknownLane": "inbox",
                  "statusLanes": {
                    "todo": "next",
                    "in-progress": "now",
                    "blocked": "waiting",
                    "waiting": "waiting",
                    "done": "recently-completed",
                    "cancelled": "recently-completed"
                  },
                  "ordering": {
                    "pinnedFirst": true,
                    "priorityOrder": [
                      "critical",
                      "high",
                      "medium",
                      "low"
                    ],
                    "tieBreaker": "rank"
                  },
                  "automation": {
                    "freshReads": true,
                    "retainFailures": true
                  }
                },
                "presentation": {
                  "glyph": {
                    "kind": "icon",
                    "name": "Dashboard"
                  }
                }
              },
              "ports": [
                {
                  "id": "root",
                  "key": "root",
                  "label": "root",
                  "direction": "bidirectional",
                  "dataType": "any",
                  "angle": 180
                }
              ]
            }
          },
          "views": [
            {
              "key": "workboard",
              "intent": "editor",
              "payload": "editor.web",
              "ref": "github://twilite-zone/public/library/classes/nodes/task-planning/workboard.node-class.node",
