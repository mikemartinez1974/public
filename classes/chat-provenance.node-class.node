        "nodeClass": {
          "contractVersion": "1.0.0",
          "key": "chat-provenance",
          "label": "Chat",
          "meaning": "A durable graph record for exactly one external or locally archived conversation.",
          "description": "Use one Chat provenance node per conversation. A graph may contain many such nodes over its lifetime.",
          "requiredDataKeys": [
            "title"
          ],
          "cardinality": {
            "chatNodeToConversation": "one-to-one",
            "graphToChatNodes": "one-to-many"
          },
          "historyPolicy": {
            "exposeCommitHistory": false,
            "requireRevisionAnchors": false
          },
          "relationshipRoles": [
            "created",
            "revised",
            "reviewed",
            "explained",
            "inspired"
          ],
          "nodeDef": {
            "key": "chat-provenance",
