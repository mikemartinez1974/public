{"fileVersion":"1.0","metadata":{"title":"Chat Provenance Class","description":"Reusable node class for linking one conversation to the graph it created, revised, reviewed, or explained.","graphId":"chat-provenance-class","version":"0.1.1","kind":"node-class","created":"2026-08-05T23:24:00.000Z","modified":"2026-08-06T00:26:00.000Z","author":"Michael Martinez","tags":["node-class","chat","provenance","conversation","access"],"preferredViewer":"https://twilite.zone"},"nodes":[{"id":"chat-provenance-declaration","type":"declaration","label":"Chat Provenance Declaration","position":{"x":0,"y":-420},"width":250,"height":110,"ports":[{"id":"root","label":"root","direction":"bidirectional","dataType":"any","angle":210}],"visible":true,"showLabel":true,"data":{"identity":{"graphId":"chat-provenance-class","name":"Chat Provenance Class","version":"0.1.1","description":"Reusable node class for linking one conversation to the graph it created, revised, reviewed, or explained.","createdAt":"2026-08-05T23:24:00.000Z","updatedAt":"2026-08-06T00:26:00.000Z"},"intent":{"kind":"node-class","scope":"local"},"dependencies":{"nodeTypes":["declaration","port","markdown","bridge"],"portContracts":["core"],"schemaVersions":{"nodes":">=1.0.0","ports":">=1.0.0"}},"authority":{"mutation":{"allowCreate":true,"allowUpdate":true,"allowDelete":true,"appendOnly":false},"actors":{"humans":true,"agents":true,"tools":true},"styleAuthority":"descriptive","history":{"rewriteAllowed":false,"squashAllowed":false}},"declaration":{"kind":"node-class","targetMode":"artifact","defaultSurfaceId":"root","surfaces":[{"id":"root","kind":"port","label":"Overview","portNodeId":"chat-provenance-class-overview","viewNodeId":"chat-provenance-class-overview"},{"id":"detail","kind":"view","label":"Detail","viewNodeId":"chat-provenance-detail-view"},{"id":"summary","kind":"view","label":"Summary","viewNodeId":"chat-provenance-summary-view"},{"id":"icon","kind":"view","label":"Icon","viewNodeId":"chat-provenance-icon-view"},{"id":"editor","kind":"view","label":"Editor","viewNodeId":"chat-provenance-editor-view"}]},"nodeClass":{"contractVersion":"1.0.0","key":"chat-provenance","label":"Chat","meaning":"A durable graph record for exactly one external or locally archived conversation.","description":"Use one Chat provenance node per conversation. A graph may contain many such nodes over its lifetime.","requiredDataKeys":["title"],"cardinality":{"chatNodeToConversation":"one-to-one","graphToChatNodes":"one-to-many"},"historyPolicy":{"exposeCommitHistory":false,"requireRevisionAnchors":false},"relationshipRoles":["created","revised","reviewed","explained","inspired"],"nodeDef":{"key":"chat-provenance","ref":"github://mikemartinez1974/public/classes/chat-provenance.node-class.node","source":"local","version":">=0.1.1","defaults":{"label":"Chat","size":{"width":420,"height":300},"color":"linear-gradient(135deg, #dbeafe, #ddd6fe)","showLabel":false,"data":{"title":"Chat","provider":"openai","discussionUrl":"","access":"unknown","status":"unknown","capturedAt":"","summary":"","excerpt":"","notes":""},"ports":[{"id":"root","label":"root","direction":"bidirectional","dataType":"any","angle":210},{"id":"top","label":"top","direction":"bidirectional","dataType":"value","angle":270},{"id":"right","label":"right","direction":"bidirectional","dataType":"value","angle":0},{"id":"bottom","label":"bottom","direction":"bidirectional","dataType":"value","angle":90},{"id":"left","label":"left","direction":"bidirectional","dataType":"value","angle":180}]}}}}},{"id":"chat-provenance-notes","type":"markdown","label":"Chat Provenance Contract","position":{"x":-460,"y":-160},"width":380,"height":250,"ports":[{"id":"root","label":"root","direction":"bidirectional","dataType":"any","angle":210}],"visible":true,"showLabel":true,"data":{"identity":{"graphId":"chat-provenance-class"},"markdown":"# Chat Provenance\n\nOne node represents one conversation. Store external conversation links in `data.discussionUrl`; reserve `data.sourceRef` for Twilite-resolvable graph and class resources. Keep a local summary so the node remains useful if the link disappears. Relationship meaning belongs on the edge: `created`, `revised`, `reviewed`, `explained`, or `inspired`."}},{"id":"chat-provenance-editor-view","type":"port","label":"Chat Editor","position":{"x":-420,"y":140},"width":390,"height":270,"ports":[{"id":"root","label":"root","direction":"bidirectional","dataType":"any","angle":210}],"visible":true,"showLabel":true,"data":{"key":"editor.web","intent":"editor","payload":"editor.web","view":{"intent":"editor","payload":"editor.web","label":"Chat Editor"},"editor":{"web":{"fields":[{"key":"label","label":"Label","type":"text","path":"label"},{"key":"title","label":"Title","type":"text","path":"data.title"},{"key":"provider","label":"Provider","type":"text","path":"data.provider"},{"key":"discussionUrl","label":"Discussion URL","type":"text","path":"data.discussionUrl"},{"key":"access","label":"Access","type":"select","path":"data.access","options":[{"label":"Owner only","value":"owner-only"},{"label":"Shared","value":"shared"},{"label":"Local snapshot","value":"local"},{"label":"Unknown","value":"unknown"}]},{"key":"status","label":"Status","type":"select","path":"data.status","options":[{"label":"Available","value":"available"},{"label":"Unavailable","value":"unavailable"},{"label":"Revoked","value":"revoked"},{"label":"Deleted","value":"deleted"},{"label":"Unknown","value":"unknown"}]},{"key":"capturedAt","label":"Captured At","type":"text","path":"data.capturedAt"},{"key":"summary","label":"Summary","type":"markdown","path":"data.summary","multiline":true,"rows":7},{"key":"excerpt","label":"Optional Excerpt","type":"markdown","path":"data.excerpt","multiline":true,"rows":5},{"key":"notes","label":"Notes","type":"markdown","path":"data.notes","multiline":true,"rows":4}]}}}},{"id":"chat-provenance-detail-view","type":"port","label":"Chat Detail","position":{"x":20,"y":140},"width":440,"height":360,"ports":[{"id":"root","label":"root","direction":"bidirectional","dataType":"any","angle":210}],"visible":true,"showLabel":true,"data":{"key":"node.web.detail","intent":"node","payload":"node.web.detail","view":{"intent":"node","payload":"node.web.detail","controls":[{"id":"open-chat-discussion","type":"button","label":"Open Discussion","action":"navigate","url":"{{data.discussionUrl}}","variant":"contained","priority":"high"},{"id":"edit-chat-provenance","type":"button","label":"Edit","action":"openEditor","icon":"edit","variant":"outlined"}]},"html":"<div style='height:100%;box-sizing:border-box;border-radius:18px;overflow:hidden;background:#f8fafc;border:1px solid #c7d2fe;color:#172554;font-family:system-ui'><header style='padding:13px;background:linear-gradient(135deg,#1e3a8a,#6d28d9);color:white'><small>CHAT PROVENANCE</small><b style='display:block;font:800 18px Georgia'>{{data.title}}</b><small>{{data.provider}} · {{data.capturedAt}}</small></header><main style='padding:12px;display:grid;gap:8px'><div><b>{{data.access}}</b> · <b>{{data.status}}</b></div><section style='padding:9px;background:white;border-radius:12px'><small>CONTRIBUTION SUMMARY</small><div style='white-space:pre-wrap;font-size:13px'>{{data.summary}}</div></section><section style='padding:9px;background:white;border-radius:12px'><small>RETAINED EXCERPT</small><div style='white-space:pre-wrap;font-size:12px'>{{data.excerpt}}</div></section><a href='{{data.discussionUrl}}' target='_blank' rel='noopener noreferrer' style='padding:9px;border-radius:10px;background:#4f46e5;color:white;text-decoration:none;text-align:center;font-weight:800'>Open shared discussion ↗</a><small style='overflow:hidden;text-overflow:ellipsis;white-space:nowrap'>{{data.discussionUrl}}</small></main></div>"}},{"id":"chat-provenance-summary-view","type":"port","label":"Chat Summary","position":{"x":520,"y":140},"width":360,"height":240,"ports":[{"id":"root","label":"root","direction":"bidirectional","dat