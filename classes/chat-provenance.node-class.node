{"fileVersion":"1.0","metadata":{"title":"Chat Provenance Class","description":"Reusable node class for linking one conversation to the graph it created, revised, reviewed, or explained.","graphId":"chat-provenance-class","version":"0.1.2","kind":"node-class","created":"2026-08-05T23:24:00.000Z","modified":"2026-08-06T00:43:00.000Z","author":"Michael Martinez","tags":["node-class","chat","provenance","conversation","access"],"preferredViewer":"https://twilite.zone"},"nodes":[{"id":"chat-provenance-declaration","type":"declaration","label":"Chat Provenance Declaration","position":{"x":0,"y":-420},"width":250,"height":110,"ports":[{"id":"root","label":"root","direction":"bidirectional","dataType":"any","angle":210}],"visible":true,"showLabel":true,"data":{"identity":{"graphId":"chat-provenance-class","name":"Chat Provenance Class","version":"0.1.2","description":"Reusable node class for linking one conversation to the graph it created, revised, reviewed, or explained.","createdAt":"2026-08-05T23:24:00.000Z","updatedAt":"2026-08-06T00:43:00.000Z"},"intent":{"kind":"node-class","scope":"local"},"dependencies":{"nodeTypes":["declaration","port","markdown","bridge"],"portContracts":["core"],"schemaVersions":{"nodes":">=1.0.0","ports":">=1.0.0"}},"authority":{"mutation":{"allowCreate":true,"allowUpdate":true,"allowDelete":true,"appendOnly":false},"actors":{"humans":true,"agents":true,"tools":true},"styleAuthority":"descriptive","history":{"rewriteAllowed":false,"squashAllowed":false}},"declaration":{"kind":"node-class","targetMode":"artifact","defaultSurfaceId":"root","surfaces":[{"id":"root","kind":"port","label":"Overview","portNodeId":"chat-provenance-class-overview","viewNodeId":"chat-provenance-class-overview"},{"id":"detail","kind":"view","label":"Detail","viewNodeId":"chat-provenance-detail-view"},{"id":"summary","kind":"view","label":"Summary","viewNodeId":"chat-provenance-summary-view"},{"id":"icon","kind":"view","label":"Icon","viewNodeId":"chat-provenance-icon-view"},{"id":"editor","kind":"view","label":"Editor","viewNodeId":"chat-provenance-editor-view"}]},"nodeClass":{"contractVersion":"1.0.0","key":"chat-provenance","label":"Chat","meaning":"A durable graph record for exactly one external or locally archived conversation.","description":"Use one Chat provenance node per conversation. A graph may contain many such nodes over its lifetime.","requiredDataKeys":["title"],"cardinality":{"chatNodeToConversation":"one-to-one","graphToChatNodes":"one-to-many"},"historyPolicy":{"exposeCommitHistory":false,"requireRevisionAnchors":false},"relationshipRoles":["created","revised","reviewed","explained","inspired"],"nodeDef":{"key":"chat-provenance","ref":"github://mikemartinez1974/public/classes/chat-provenance.node-class.node","source":"local","version":">=0.1.2","defaults":{"label":"Chat","size":{"width":440,"height":430},"color":"linear-gradient(135deg, #dbeafe, #ddd6fe)","showLabel":false,"data":{"title":"Chat","provider":"openai","discussionUrl":"","access":"unknown","status":"unknown","capturedAt":"","summary":"","excerpt":"","notes":""},"ports":[{"id":"root","label":"root","direction":"bidirectional","dataType":"any","angle":210},{"id":"top","label":"top","direction":"bidirectional","dataType":"value","angle":270},{"id":"right","label":"right","direction":"bidirectional","dataType":"value","angle":0},{"id":"bottom","label":"bottom","direction":"bidirectional","dataType":"value","angle":90},{"id":"left","label":"left","direction":"bidirectional","dataType":"value","angle":180}]}}}}},{"id":"chat-provenance-notes","type":"markdown","label":"Chat Provenance Contract","position":{"x":-460,"y":-160},"width":380,"height":270,"ports":[{"id":"root","label":"root","direction":"bidirectional","dataType":"any","angle":210}],"visible":true,"showLabel":true,"data":{"identity":{"graphId":"chat-provenance-class"},"markdown":"# Chat Provenance\n\nOne node represents one conversation. External conversation links belong in `data.discussionUrl`; reserve `data.sourceRef` for Twilite-resolvable graph and class resources.\n\nThe detail card presents every human-facing field: title, provider, discussion URL, access, status, captured time, summary, excerpt, and notes. Class bindings, bridge provenance, and graph identity remain infrastructure rather than display content.\n\nRelationship meaning belongs on the edge: `created`, `revised`, `reviewed`, `explained`, or `inspired`."}},{"id":"chat-provenance-editor-view","type":"port","label":"Chat Editor","position":{"x":-420,"y":140},"width":390,"height":290,"ports":[{"id":"root","label":"root","direction":"bidirectional","dataType":"any","angle":210}],"visible":true,"showLabel":true,"data":{"key":"editor.web","intent":"editor","payload":"editor.web","view":{"intent":"editor","payload":"editor.web","label":"Chat Editor"},"editor":{"web":{"fields":[{"key":"label","label":"Label","type":"text","path":"label"},{"key":"title","label":"Title","type":"text","path":"data.title"},{"key":"provider","label":"Provider","type":"text","path":"data.provider"},{"key":"discussionUrl","label":"Discussion URL","type":"text","path":"data.discussionUrl","placeholder":"https://chatgpt.com/share/..."},{"key":"access","label":"Access","type":"select","path":"data.access","options":[{"label":"Owner only","value":"owner-only"},{"label":"Shared","value":"shared"},{"label":"Local snapshot","value":"local"},{"label":"Unknown","value":"unknown"}]},{"key":"status","label":"Status","type":"select","path":"data.status","options":[{"label":"Available","value":"available"},{"label":"Unavailable","value":"unavailable"},{"label":"Revoked","value":"revoked"},{"label":"Deleted","value":"deleted"},{"label":"Unknown","value":"unknown"}]},{"key":"capturedAt","label":"Captured At","type":"text","path":"data.capturedAt","placeholder":"YYYY-MM-DDTHH:mm:ssZ"},{"key":"summary","label":"Summary","type":"markdown","path":"data.summary","multiline":true,"rows":7},{"key":"excerpt","label":"Optional Excerpt","type":"markdown","path":"data.excerpt","multiline":true,"rows":5},{"key":"notes","label":"Provenance Notes","type":"markdown","path":"data.notes","multiline":true,"rows":4}]}}}},{"id":"chat-provenance-detail-view","type":"port","label":"Chat Detail","position":{"x":20,"y":140},"width":460,"height":460,"ports":[{"id":"root","label":"root","direction":"bidirectional","dataType":"any","angle":210}],"visible":true,"showLabel":true,"data":{"key":"node.web.detail","intent":"node","payload":"node.web.detail","view":{"intent":"node","payload":"node.web.detail","controls":[{"id":"open-chat-discussion","type":"button","label":"Open Discussion","action":"navigate","url":"{{data.discussionUrl}}","variant":"contained","priority":"high"},{"id":"edit-chat-provenance","type":"button","label":"Edit","action":"openEditor","icon":"edit","variant":"outlined"}]},"html":"<div style='width:100%;height:100%;box-sizing:border-box;display:flex;flex-direction:column;border-radius:20px;overflow:hidden;background:linear-gradient(180deg,#f8fafc,#eef2ff);border:1px solid rgba(79,70,229,.22);color:#172554;font-family:ui-sans-serif,system-ui,sans-serif;'>\n<header style='padding:14px 16px;background:linear-gradient(135deg,#1e3a8a,#6d28d9);color:white;display:flex;gap:12px;align-items:center;'>\n<div style='width:44px;height:40px;border-radius:15px 15px 15px 5px;background:rgba(255,255,255,.16);border:2px solid rgba(255,255,255,.72);display:flex;align-items:center;justify-content:center;font-size:21px;flex:0 0 auto;'>💬</div>\n<div style='min-width:0;flex:1;'><div style='font:800 10px/1 system-ui,sans-serif;letter-spacing:.14em;text-transform:uppercase;opacity:.8;'>Chat provenance</div><div style='font:800 19px/1.2 Georgia,serif;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;'>{{data.title}}</div><div style='font:600 11px/1.35 system-ui,sans-serif;opacity:.84;'>{{data.provider}} · {{data.capturedAt}}</div></div>\n</header>\n<main style='padding:12px 14px 14px;display:flex;flex-direction:column;gap:9px;min-height:0;'>\n<div style='display:flex;gap:7px;flex-wrap:wrap;'><span style='padding:4px 8px;border-radius:999px;background:#dbeafe;color:#1e40af;font:800 10px system-ui,sans-serif;text-transform:uppercase;'>{{data.access}}</span><span style='padding:4px 8px;border-radius:999px;background:#ede9fe;color:#5b21b6;font:800 10px system-ui,sans-serif;text-transform:uppercase;'>{{data.status}}</span></div>\n<section style='padding:10px 12px;border-radius:14px;background:rgba(255,255,255,.9);border:1px solid rgba(79,70,229,.12);'><div style='font:800 10px system-ui,sans-serif;letter-spacing:.12em;text-transform:uppercase;color:#4f46e5;margin-bottom:6px;'>Contribution summary</div><div style='font:500 12px/1.42 system-ui,sans-serif;white-space:pre-wrap;'>{{data.summary}}</div></section>\n<section style='padding:9px 12px;border-radius:14px;background:rgba(255,255,255,.68);border:1px solid rgba(79,70,229,.09);'><div style='font:800 10px system-ui,sans-serif;letter-spacing:.12em;text-transform:uppercase;color:#7c3aed;margin-bottom:5px;'>Retained excerpt</div><div style='font:500 11px/1.4 system-ui,sans-serif;white-space:pre-wrap;max-height:4.2em;overflow:hidden;'>{{data.excerpt}}</div></section>\n<section style='padding:8px 11px;border-radius:12px;background:#eef2ff;border-left:3px solid #818cf8;'><div style='font:800 9px system-ui,sans-serif;letter-spacing:.11em;text-transform:uppercase;color:#6366f1;margin-bottom:4px;'>Provenance note</div><div style='font:500 10px/1.35 system-ui,sans-serif;color:#475569;white-space:pre-wrap;max-height:3em;overflow:hidden;'>{{data.notes}}</div></section>\n<a href='{{data.discussionUrl}}' target='_blank' rel='noopener noreferrer' style='display:block;padding:9px 12px;border-radius:11px;background:linear-gradient(90deg,#4f46e5,#6d28d9);color:white;text-decoration:none;text-align:center;font:800 12px system-ui,sans-serif;'>Open shared discussion ↗</a>\n<div style='display:flex;gap:7px;align-items:center;padding:0 2px;min-width:0;'><span style='font:800 9px system-ui,sans-serif;letter-spacing:.08em;text-transform:uppercase;color:#64748b;flex:0 0 auto;'>Discussion source</span><span style='font:600 9px/1.3 ui-monospace,SFMono-Regular,monospace;color:#64748b;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;'>{{data.discussionUrl}}</span></div>\n</main></div>"}},{"id":"chat-provenance-summary-view","type":"port","label":"Chat Summary","position":{"x":520,"y":140},"width":380,"height":240,"ports":[{"id":"root","label":"root","direction":"bidirectional","dataType":"any","angle":210}],"visible":true,"showLabel":true,"data":{"key":"node.web.summary","intent":"node","payload":"node.web.summary","view":{"intent":"node","payload":"node.web.summary","controls":[{"id":"open-chat-discussion","type":"button","label":"Open Discussion","action":"navigate","url":"{{data.discussionUrl}}","variant":"contained","priority":"high"},{"id":"edit-chat-provenance","type":"button","label":"Edit","action":"openEditor","icon":"edit","variant":"outlined"}]},"html":"<div style='width:100%;height:100%;box-sizing:border-box;padding:14px;border-radius:18px;background:linear-gradient(135deg,#eff6ff,#f5f3ff);border:1px solid rgba(79,70,229,.18);display:flex;gap:12px;color:#172554;font-family:ui-sans-serif,system-ui,sans-serif;'>\n<div style='width:48px;height:42px;border-radius:16px 16px 16px 5px;background:linear-gradient(135deg,#1d4ed8,#7c3aed);color:white;display:flex;align-items:center;justify-content:center;font-size:22px;flex:0 0 auto;'>💬</div>\n<div style='min-width:0;flex:1;display:flex;flex-direction:column;gap:6px;'><div style='font:800 16px/1.15 Georgia,serif;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;'>{{data.title}}</div><div style='display:flex;gap:6px;align-items:center;font:800 9px system-ui,sans-serif;text-transform:uppercase;color:#4f46e5;'><span>{{data.provider}}</span><span>·</span><span>{{data.access}}</span><span>·</span><span>{{data.status}}</span></div><div style='font:500 12px/1.38 system-ui,sans-serif;color:#334155;max-height:4.2em;overflow:hidden;white-space:pre-wrap;'>{{data.summary}}</div><div style='display:flex;justify-content:space-between;gap:8px;align-items:center;'><span style='font:600 10px system-ui,sans-serif;color:#64748b;'>{{data.capturedAt}}</span><a href='{{data.discussionUrl}}' target='_blank' rel='noopener noreferrer' style='font:800 10px system-ui,sans-serif;color:#4f46e5;text-decoration:none;'>Open ↗</a></div></div>\n</div>"}},{"id":"chat-provenance-icon-view","type":"port","label":"Chat Icon","position":{"x":940,"y":140},"width":220,"height":220,"ports":[{"id":"root","label":"root","direction":"bidirectional","dataType":"any","angle":210}],"visible":true,"showLabel":true,"data":{"key":"node.web.icon","intent":"node","payload":"node.web.icon","semanticLevel":"icon","html":"<div style='width:100%;height:100%;box-sizing:border-box;border-radius:20px;background:linear-gradient(135deg,#1e3a8a,#6d28d9);border:2px solid #c4b5fd;color:white;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:8px;padding:12px;font-family:ui-sans-serif,system-ui,sans-serif;'><div style='width:58px;height:48px;border-radius:20px 20px 20px 7px;border:3px solid rgba(255,255,255,.9);display:flex;align-items:center;justify-content:center;font-size:25px;'>💬</div><div style='max-width:100%;font:800 12px/1.15 system-ui,sans-serif;text-align:center;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;'>{{data.title}}</div><div style='font:800 9px system-ui,sans-serif;text-transform:uppercase;opacity:.78;'>{{data.access}}</div></div>"}},{"id":"chat-provenance-class-overview","type":"port","label":"Chat Provenance Class","position":{"x":40,"y":-420},"width":520,"height":300,"ports":[{"id":"root","label":"root","direction":"bidirectional","dataType":"any","angle":210}],"visible":true,"showLabel":true,"data":{"identity":{"graphId":"chat-provenance-class","portId":"root","name":"Chat Provenance Class"},"title":"Chat Provenance Class","purpose":"Reusable one-conversation provenance node with durable summaries and honest access states.","view":{"intent":"node","payload":"node.web.summary","label":"Class Overview"},"html":"<div style='height:100%;box-sizing:border-box;padding:24px;border-radius:22px;background:linear-gradient(135deg,#172554,#6b21a8);color:white;font-family:system-ui;display:grid;align-content:center'><div style='font-size:40px'>💬</div><b style='font-size:26px'>Chat Provenance</b><span>One conversation, one durable node.</span></div>","payload":"node.web.summary","intent":"node","key":"node.web.summary","semanticLevel":"detail","visibilityRole":"editor"}},{"id":"chat-provenance-class-export","type":"bridge","label":"Chat Provenance Class Export","position":{"x":-500,"y":520},"width":360,"height":170,"ports":[{"id":"root","label":"root","direction":"bidirectional","dataType":"any","angle":210}],"visible":true,"showLabel":true,"data":{"memo":"Explicit export for the Chat provenance node class.","authority":"bridge","intent":"external","resourceKind":"node-class","surfaceId":"class-export","exportKind":"class","bridge":{"ref":"github://mikemartinez1974/public/classes/chat-provenance.node-class.node","resourceKind":"node-class","scope":"graph","role":"export","grants":[],"exposure":{"nodeClasses":{"mode":"allowlist","allowKeys":["chat-provenance"]}}},"target":{"mode":"bridge","ref":"github://mikemartinez1974/public/classes/chat-provenance.node-class.node","kind":"node-class","key":"chat-provenance","role":"export"}}}],"edges":[],"clusters":[],"nodeCount":8,"edgeCount":0,"timestamp":"2026-08-06T00:43:00.000Z","scripts":[]}