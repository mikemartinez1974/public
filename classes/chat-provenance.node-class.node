        "key": "editor.web",
        "intent": "editor",
        "payload": "editor.web",
        "view": {
          "intent": "editor",
          "payload": "editor.web",
          "label": "Chat Editor"
        },
        "editor": {
          "web": {
            "fields": [
              {
                "key": "label",
                "label": "Label",
                "type": "text",
                "path": "label",
                "placeholder": "Chat"
              },
              {
                "key": "title",
                "label": "Title",
                "type": "text",
                "path": "data.title",
                "placeholder": "What this discussion was about"
              },
              {
                "key": "provider",
                "label": "Provider",
                "type": "text",
                "path": "data.provider",
                "placeholder": "openai, anthropic, google, xai, local"
              },
              {
                "key": "sourceRef",
                "label": "Discussion Link",
                "type": "text",
                "path": "data.sourceRef",
                "placeholder": "https://chatgpt.com/share/..."
              },
              {
                "key": "access",
                "label": "Access",
                "type": "select",
                "path": "data.access",
                "options": [
                  {
                    "label": "Owner only",
                    "value": "owner-only"
                  },
                  {
                    "label": "Shared",
                    "value": "shared"
                  },
                  {
                    "label": "Local snapshot",
                    "value": "local"
                  },
                  {
                    "label": "Unknown",
                    "value": "unknown"
                  }
                ]
              },
              {
                "key": "status",
                "label": "Status",
                "type": "select",
                "path": "data.status",
                "options": [
                  {
                    "label": "Available",
                    "value": "available"
                  },
                  {
                    "label": "Unavailable",
                    "value": "unavailable"
                  },
                  {
                    "label": "Revoked",
                    "value": "revoked"
                  },
                  {
                    "label": "Deleted",
                    "value": "deleted"
                  },
                  {
                    "label": "Unknown",
                    "value": "unknown"
                  }
                ]
              },
              {
                "key": "capturedAt",
                "label": "Captured At",
                "type": "text",
                "path": "data.capturedAt",
                "placeholder": "YYYY-MM-DDTHH:mm:ssZ"
              },
              {
                "key": "summary",
                "label": "Summary",
                "type": "markdown",
                "path": "data.summary",
                "placeholder": "What the conversation contributed",
                "multiline": true,
                "rows": 7
              },
              {
                "key": "excerpt",
                "label": "Optional Excerpt",
                "type": "markdown",
                "path": "data.excerpt",
                "placeholder": "A short locally retained excerpt",
                "multiline": true,
                "rows": 5
              },
              {
                "key": "notes",
                "label": "Notes",
                "type": "markdown",
                "path": "data.notes",
                "placeholder": "Access caveats or context",
                "multiline": true,
                "rows": 4
              }
            ]
          }
        }
      }
    },
