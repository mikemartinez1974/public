            { "id": "detail", "kind": "view", "label": "Detail", "viewNodeId": "semantic-zoom-specimen-detail-view" },
            { "id": "summary", "kind": "view", "label": "Summary", "viewNodeId": "semantic-zoom-specimen-summary-view" },
