          "contractVersion": "1.0.0",
          "key": "semantic-zoom-specimen",
          "nodeDef": {
            "key": "semantic-zoom-specimen",
            "ref": "github://mikemartinez1974/public/classes/semantic-zoom-specimen.node-class.node",
            "source": "local",
            "version": ">=0.1.0",
            "label": "Semantic Zoom Specimen",
            "meaning": "Diagnostic specimen for semantic view selection.",
            "description": "Proves that zoom changes content as well as geometry.",
            "requiredDataKeys": ["title"],
            "defaults": {
              "label": "Semantic Zoom Specimen",
              "size": { "width": 440, "height": 320 },
              "color": "#0f766e",
              "showLabel": false,
              "data": {
                "title": "Semantic Zoom Specimen",
                "summary": "Summary-band content",
                "detail": "Detail-band content",
                "marker": "SZ"
              },
              "ports": [
                { "id": "root", "label": "root", "direction": "bidirectional", "dataType": "any", "angle": 210 },
