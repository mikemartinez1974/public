        "renderShape": { "kind": "html" },
        "html": "<div style='width:100%;height:100%;box-sizing:border-box;border-radius:24px;background:#042f2e;border:4px solid #2dd4bf;color:#ccfbf1;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:10px;font-family:system-ui,sans-serif;overflow:hidden;'><div style='width:64px;height:64px;border-radius:18px;background:#14b8a6;color:#042f2e;display:flex;align-items:center;justify-content:center;font:950 22px system-ui,sans-serif;'>{{data.marker}}</div><div style='font:900 12px system-ui,sans-serif;letter-spacing:.18em;'>ICON</div></div>"
      }
    },
