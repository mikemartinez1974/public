      "visible": true,
      "showLabel": true,
      "data": {
        "identity": {
          "graphId": "open-question-demo-class",
          "nodeId": "open-question"
        },
        "view": {
          "intent": "editor",
          "payload": "editor.web"
        },
        "editor": {
          "web": {
            "fields": [
              {
                "key": "title",
                "label": "Question",
                "type": "text",
                "path": "data.title",
                "placeholder": "What is unresolved?",
                "multiline": true,
                "rows": 2
              },
              {
                "key": "body",
                "label": "Details",
                "type": "markdown",
                "path": "data.body",
                "placeholder": "Why it matters, what has been tried, what you need to know.",
                "multiline": true,
                "rows": 5
              },
              {
                "key": "answer",
                "label": "Your answer",
                "type": "markdown",
                "path": "data.answer",
                "placeholder": "Write your answer here. Then set the status to Answered.",
                "multiline": true,
                "rows": 6
              },
              {
                "key": "status",
                "label": "Status",
                "type": "select",
                "path": "data.status",
                "options": [
                  {
                    "label": "Open",
                    "value": "open"
                  },
                  {
                    "label": "Investigating",
                    "value": "investigating"
                  },
                  {
                    "label": "Answered",
                    "value": "answered"
                  },
                  {
                    "label": "Resolved",
                    "value": "resolved"
                  }
                ]
              },
              {
                "key": "owner",
                "label": "Owner",
                "type": "text",
                "path": "data.owner",
                "placeholder": "who answers it"
              },
              {
                "key": "resolutionPath",
                "label": "Resolved by",
                "type": "text",
                "path": "data.resolutionPath",
                "placeholder": "A decision or node that answers it (optional)"
              },
              {
                "key": "prominence",
                "label": "Prominence",
                "type": "select",
                "path": "data.prominence",
                "options": [
                  {
                    "label": "High",
                    "value": "high"
                  },
                  {
                    "label": "Normal",
                    "value": "normal"
                  }
                ]
              },
              {
                "key": "label",
                "label": "List name",
                "type": "text",
                "path": "label",
                "placeholder": "Open Question"
              }
            ]
          }
        }
      }
    },
