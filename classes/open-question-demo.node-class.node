        "view": {
          "intent": "node",
          "payload": "node.web.detail",
          "controls": [
            {
              "id": "open-question-demo-answered",
              "type": "button",
              "label": "Answered",
              "icon": "bolt",
              "variant": "contained",
              "priority": "highest",
              "action": "setData",
              "bind": "data.status",
              "value": "answered"
            },
            {
              "id": "open-question-demo-investigating",
              "type": "button",
              "label": "Investigating",
              "icon": "play",
              "variant": "soft",
              "priority": "high",
              "action": "setData",
              "bind": "data.status",
              "value": "investigating"
            },
            {
              "id": "open-question-demo-reopen",
              "type": "button",
              "label": "Reopen",
              "icon": "edit",
              "variant": "outlined",
              "priority": "normal",
              "action": "setData",
              "bind": "data.status",
              "value": "open"
            },
            {
              "id": "open-question-demo-edit",
              "type": "button",
              "label": "Edit",
              "icon": "edit",
              "variant": "outlined",
              "priority": "high",
              "action": "openEditor"
            }
          ],
          "html": {
            "chrome": true
          }
        },
        "renderShape": {
          "kind": "html"
        },
        "html": "<div style='width:100%;height:100%;display:flex;flex-direction:column;box-sizing:border-box;padding:0;overflow:hidden;border-radius:18px;border:2px solid #8750c7;background:linear-gradient(180deg, rgba(255,255,255,.96), rgba(244,236,255,.94));color:#23160a;position:relative;'>\n  <div style='display:flex;align-items:center;justify-content:space-between;gap:10px;padding:10px 14px;background:linear-gradient(135deg, #ead6ff, #8750c7);color:#261339;border-bottom:1px solid rgba(0,0,0,.08);'>\n    <div style='display:flex;align-items:center;gap:10px;min-width:0;'>\n      <div style='width:28px;height:28px;border-radius:50%;display:flex;align-items:center;justify-content:center;background:rgba(0,0,0,.08);border:1px solid rgba(0,0,0,.10);font:800 14px system-ui,sans-serif;flex:0 0 auto;'>?</div>\n      <div style='min-width:0;'>\n        <div style='font:700 10px system-ui,sans-serif;letter-spacing:.16em;text-transform:uppercase;opacity:.68;margin-bottom:2px;'>Open Question</div>\n        <div style='font:800 17px/1.1 Georgia, \"Times New Roman\", serif;display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden;'>{{data.title || label}}</div>\n      </div>\n    </div>\n    <div style='display:inline-flex;align-items:center;justify-content:center;padding:5px 9px;border-radius:999px;background:rgba(255,255,255,.38);border:1px solid rgba(0,0,0,.08);font:700 10px system-ui,sans-serif;text-transform:uppercase;white-space:nowrap;'>{{data.status}}</div>\n  </div>\n  <div style='display:flex;flex-direction:column;gap:9px;padding:11px 14px 12px 14px;min-height:0;flex:1;color:#23160a;'>\n    <div style='padding:8px 11px;border-radius:12px;background:rgba(255,255,255,.72);border:1px solid rgba(0,0,0,.06);'>\n      <div style='font:700 10px system-ui,sans-serif;letter-spacing:.14em;text-transform:uppercase;opacity:.66;margin-bottom:3px;color:#6b533a;'>Details</div>\n      <div style='font:500 12px/1.4 system-ui,sans-serif;max-height:4.2em;overflow:hidden;color:#23160a;'>{{data.body}}</div>\n    </div>\n    <div style='flex:1;min-height:0;padding:8px 11px;border-radius:12px;overflow:hidden;{{eq(data.answer, '', 'color:#92400e;background:#fffbeb;border:1px solid #fde68a', 'color:#14532d;background:#f0fdf4;border:1px solid #bbf7d0')}}'>\n      <div style='font:700 10px system-ui,sans-serif;letter-spacing:.14em;text-transform:uppercase;opacity:.8;margin-bottom:3px;'>Answer</div>\n      <div style='font:600 13px/1.4 system-ui,sans-serif;white-space:pre-wrap;overflow:hidden;'>{{data.answer || 'Waiting for your answer'}}</div>\n    </div>\n    <div style='display:flex;justify-content:space-between;gap:10px;font:600 10px system-ui,sans-serif;color:#6b533a;'>\n      <span>Owner: {{data.owner || '—'}}</span><span>Resolved by: {{data.resolutionPath || '—'}}</span>\n    </div>\n  </div>\n</div>",
        "semanticLevel": "detail"
      }
    },
