        "svg": "<svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 640 360\" width=\"100%\" height=\"100%\" preserveAspectRatio=\"xMidYMid meet\" role=\"img\" aria-label=\"People collection graphic\">\n  <defs>\n    <linearGradient id=\"peopleBg\" x1=\"0\" y1=\"0\" x2=\"1\" y2=\"1\">\n      <stop offset=\"0%\" stop-color=\"#111827\"/>\n      <stop offset=\"52%\" stop-color=\"#1e293b\"/>\n      <stop offset=\"100%\" stop-color=\"#312e4f\"/>\n    </linearGradient>\n    <linearGradient id=\"peopleGold\" x1=\"0\" y1=\"0\" x2=\"1\" y2=\"1\">\n      <stop offset=\"0%\" stop-color=\"#fde68a\"/>\n      <stop offset=\"100%\" stop-color=\"#d97706\"/>\n    </linearGradient>\n    <linearGradient id=\"peopleRose\" x1=\"0\" y1=\"0\" x2=\"1\" y2=\"1\">\n      <stop offset=\"0%\" stop-color=\"#fecdd3\"/>\n      <stop offset=\"100%\" stop-color=\"#be185d\"/>\n    </linearGradient>\n    <linearGradient id=\"peopleBlue\" x1=\"0\" y1=\"0\" x2=\"1\" y2=\"1\">\n      <stop offset=\"0%\" stop-color=\"#bfdbfe\"/>\n      <stop offset=\"100%\" stop-color=\"#2563eb\"/>\n    </linearGradient>\n    <filter id=\"peopleShadow\" x=\"-30%\" y=\"-30%\" width=\"160%\" height=\"160%\">\n      <feDropShadow dx=\"0\" dy=\"8\" stdDeviation=\"10\" flood-color=\"#020617\" flood-opacity=\"0.5\"/>\n    </filter>\n  </defs>\n  <rect width=\"640\" height=\"360\" rx=\"30\" fill=\"url(#peopleBg)\"/>\n  <circle cx=\"535\" cy=\"42\" r=\"118\" fill=\"#8b5cf6\" opacity=\"0.08\"/>\n  <circle cx=\"72\" cy=\"318\" r=\"126\" fill=\"#f59e0b\" opacity=\"0.06\"/>\n  <g fill=\"none\" stroke=\"#cbd5e1\" stroke-width=\"3\" stroke-linecap=\"round\" opacity=\"0.35\">\n    <path d=\"M208 155 C255 119 286 119 320 151\"/>\n    <path d=\"M320 151 C360 116 395 119 432 155\"/>\n    <path d=\"M208 155 C268 230 375 230 432 155\"/>\n  </g>\n  <g filter=\"url(#peopleShadow)\">\n    <g transform=\"translate(150 92)\">\n      <circle cx=\"58\" cy=\"63\" r=\"58\" fill=\"#0f172a\" stroke=\"#fde68a\" stroke-width=\"5\"/>\n      <circle cx=\"58\" cy=\"48\" r=\"20\" fill=\"url(#peopleGold)\"/>\n      <path d=\"M21 98 C25 73 40 65 58 65 C76 65 91 73 95 98\" fill=\"url(#peopleGold)\"/>\n    </g>\n    <g transform=\"translate(262 69)\">\n      <circle cx=\"58\" cy=\"63\" r=\"64\" fill=\"#0f172a\" stroke=\"#fecdd3\" stroke-width=\"5\"/>\n      <circle cx=\"58\" cy=\"46\" r=\"22\" fill=\"url(#peopleRose)\"/>\n      <path d=\"M18 103 C23 75 39 66 58 66 C78 66 94 75 99 103\" fill=\"url(#peopleRose)\"/>\n    </g>\n    <g transform=\"translate(374 92)\">\n      <circle cx=\"58\" cy=\"63\" r=\"58\" fill=\"#0f172a\" stroke=\"#bfdbfe\" stroke-width=\"5\"/>\n      <circle cx=\"58\" cy=\"48\" r=\"20\" fill=\"url(#peopleBlue)\"/>\n      <path d=\"M21 98 C25 73 40 65 58 65 C76 65 91 73 95 98\" fill=\"url(#peopleBlue)\"/>\n    </g>\n  </g>\n  <text x=\"320\" y=\"261\" text-anchor=\"middle\" fill=\"#f8fafc\" font-family=\"ui-sans-serif,system-ui,sans-serif\" font-size=\"34\" font-weight=\"850\" letter-spacing=\"0.18em\">PEOPLE</text>\n  <text x=\"320\" y=\"289\" text-anchor=\"middle\" fill=\"#cbd5e1\" font-family=\"ui-sans-serif,system-ui,sans-serif\" font-size=\"13\" font-weight=\"650\" letter-spacing=\"0.2em\">SOURCED PUBLIC PROFILES</text>\n  <rect x=\"238\" y=\"311\" width=\"164\" height=\"30\" rx=\"15\" fill=\"#ffffff\" opacity=\"0.1\" stroke=\"#ffffff\" stroke-opacity=\"0.24\"/>\n  <text x=\"320\" y=\"331\" text-anchor=\"middle\" fill=\"#f8fafc\" font-family=\"ui-sans-serif,system-ui,sans-serif\" font-size=\"12\" font-weight=\"750\" letter-spacing=\"0.1em\">OPEN COLLECTION</text>\n</svg>",
