{"fileVersion":"1.0","metadata":{"title":"Alex Jones","description":"A sourced public-figure graph about American media host and Infowars founder Alex Jones.","graphId":"alex-jones-person-graph","version":"0.2.0","kind":"person","created":"2026-08-07T17:10:00.000Z","modified":"2026-08-07T17:30:00.000Z","author":"","tags":["person","public","lionel-v1","sourced-profile"],"preferredViewer":"https://twilite.zone"},"nodes":[{"id":"alex-jones-declaration","type":"declaration","label":"Alex Jones Declaration","position":{"x":-1200,"y":-900},"width":420,"height":300,"ports":[{"id":"root","label":"root","direction":"bidirectional","dataType":"any","angle":210}],"visible":false,"showLabel":true,"data":{"analytics":{"contentGroup":"people"},"identity":{"graphId":"alex-jones-person-graph","name":"Alex Jones","version":"0.2.0","description":"A sourced public-figure graph about American media host and Infowars founder Alex Jones.","createdAt":"2026-08-07T17:10:00.000Z","updatedAt":"2026-08-07T17:30:00.000Z"},"intent":{"kind":"person","scope":"public"},"dependencies":{"nodeTypes":["declaration","bridge","port","person","markdown"],"portContracts":["core"],"schemaVersions":{"nodes":">=1.0.0","ports":">=1.0.0"}},"authority":{"mode":"graph","mutation":{"allowCreate":true,"allowUpdate":true,"allowDelete":true,"appendOnly":false},"actors":{"humans":true,"agents":true,"tools":true},"history":{"rewriteAllowed":false,"squashAllowed":false}},"declaration":{"kind":"person","targetMode":"artifact","artifactKind":"graph","defaultSurfaceId":"root","surfaces":[{"id":"root","kind":"port","label":"Alex Jones","portNodeId":"alex-jones-detail","viewNodeId":"alex-jones-detail"}]}}},{"id":"alex-jones-person-bridge","type":"bridge","label":"Person","position":{"x":-1200,"y":-550},"width":260,"height":100,"ports":[{"id":"root","label":"root","direction":"bidirectional","dataType":"any","angle":210}],"visible":false,"showLabel":true,"data":{"authority":"bridge","target":{"mode":"bridge","ref":"github://mikemartinez1974/public/people/template/person.node-class.node","kind":"node-class","resourceKind":"node-class","scope":"focused-graph","grants":["create"],"key":"person","label":"Person"},"resourceKind":"node-class","scope":"focused-graph","grants":["create"],"bridge":{"ref":"github://mikemartinez1974/public/people/template/person.node-class.node","resourceKind":"node-class","scope":"focused-graph","grants":["create"]},"_classBinding":{"key":"person","sourceRef":"github://mikemartinez1974/public/people/template/person.node-class.node"},"_bridge":{"sourceRef":"github://mikemartinez1974/public/people/template/person.node-class.node","entryPort":"root","kind":"node-class","targetKind":"node-class","classKey":"person","classRef":"github://mikemartinez1974/public/people/template/person.node-class.node"}}},{"id":"alex-jones-detail","type":"port","label":"Alex Jones","position":{"x":0,"y":-900},"width":720,"height":520,"ports":[{"id":"root","label":"root","direction":"bidirectional","dataType":"any","angle":210}],"visible":true,"showLabel":false,"data":{"identity":{"graphId":"alex-jones-person-graph","portId":"root","name":"Alex Jones"},"view":{"intent":"node","payload":"node.web.summary","label":"Alex Jones"},"renderShape":{"kind":"markdown"},"markdown":"# 👤 Alex Jones\n\n![Portrait of Alex Jones](https://upload.wikimedia.org/wikipedia/commons/c/cd/Alex_Jones_Portrait.jpg)\n\n**media host · Infowars founder · conspiracy theorist**\n\nAmerican media host who built Infowars into a large conspiracy-oriented media business and was held liable in major Sandy Hook defamation cases.\n\n*Photo: Wikimedia Commons, Alex Jones portrait, 2017.*"}},{"id":"alex-jones-person","type":"person","label":"Alex Jones","position":{"x":0,"y":-300},"width":500,"height":340,"ports":[{"id":"root","label":"root","direction":"bidirectional","dataType":"any","angle":210},{"id":"top","label":"top","direction":"bidirectional","dataType":"value","angle":270},{"id":"right","label":"right","direction":"bidirectional","dataType":"value","angle":0},{"id":"bottom","label":"bottom","direction":"bidirectional","dataType":"value","angle":90},{"id":"left","label":"left","direction":"bidirectional","dataType":"value","angle":180}],"visible":true,"showLabel":false,"data":{"displayName":"Alex Jones","fullName":"Alexander Emerick Jones","aliases":[],"summary":"American media host who built Infowars into a large conspiracy-oriented media business and was held liable in major Sandy Hook defamation cases.","portrait":"https://upload.wikimedia.org/wikipedia/commons/c/cd/Alex_Jones_Portrait.jpg","birthDate":"1974-02-11","deathDate":"","pronouns":"","nationality":"American","primaryRoles":["media host","Infowars founder","conspiracy theorist","supplement seller"],"canonicalUri":"github://mikemartinez1974/public/people/alex-jones.node","status":"published","definitionKey":"person","_classBinding":{"key":"person","sourceRef":"github://mikemartinez1974/public/people/template/person.node-class.node"},"_bridge":{"classKey":"person","classRef":"github://mikemartinez1974/public/people/template/person.node-class.node","entryPort":"root","kind":"node-class","sourceRef":"github://mikemartinez1974/public/people/template/person.node-class.node","targetKind":"node-class"}}},{"id":"alex-jones-section-1","type":"markdown","label":"Early media career","position":{"x":-900,"y":180},"width":700,"height":380,"ports":[{"id":"root","label":"root","direction":"bidirectional","dataType":"any","angle":210},{"id":"top","label":"top","direction":"bidirectional","dataType":"value","angle":270},{"id":"right","label":"right","direction":"bidirectional","dataType":"value","angle":0},{"id":"bottom","label":"bottom","direction":"bidirectional","dataType":"value","angle":90},{"id":"left","label":"left","direction":"bidirectional","dataType":"value","angle":180}],"visible":true,"showLabel":false,"data":{"identity":{"graphId":"alex-jones-person-graph"},"markdown":"## Early media career\n\nAlex Jones was born in 1974, grew up in the Dallas area, and moved with his family to Austin as a teenager. He entered broadcasting through Austin public-access television and radio in the 1990s, then built Infowars into an internet and radio operation with a national audience."}},{"id":"alex-jones-section-2","type":"markdown","label":"Infowars and business model","position":{"x":0,"y":180},"width":700,"height":380,"ports":[{"id":"root","label":"root","direction":"bidirectional","dataType":"any","angle":210},{"id":"top","label":"top","direction":"bidirectional","dataType":"value","angle":270},{"id":"right","label":"right","direction":"bidirectional","dataType":"value","angle":0},{"id":"bottom","label":"bottom","direction":"bidirectional","dataType":"value","angle":90},{"id":"left","label":"left","direction":"bidirectional","dataType":"value","angle":180}],"visible":true,"showLabel":false,"data":{"identity":{"graphId":"alex-jones-person-graph"},"markdown":"## Infowars and business model\n\nJones' media business blended political broadcasting, conspiracy-oriented commentary, direct-to-audience fundraising, and the sale of dietary supplements and other products. Associated Press described the operation as a media empire that grew over decades while Jones promoted false or unsupported claims about major public events."}},{"id":"alex-jones-section-3","type":"markdown","label":"Sandy Hook litigation and judgments","position":{"x":900,"y":180},"width":700,"height":380,"ports":[{"id":"root","label":"root","direction":"bidirectional","dataType":"any","angle":210},{"id":"top","label":"top","direction":"bidirectional","dataType":"value","angle":270},{"id":"right","label":"right","direction":"bidirectional","dataType":"value","angle":0},{"id":"bottom","label":"bottom","direction":"bidirectional","dataType":"value","angle":90},{"id":"left","label":"left","direction":"bidirectional","dataType":"value","angle":180}],"visible":true,"showLabel":false,"data":{"identity":{"graphId":"alex-jones-person-graph"},"markdown":"## Sandy Hook litigation and judgments\n\nJones repeatedly and falsely described the 2012 Sandy Hook Elementary School shooting as staged or a hoax. Families of victims sued him in Texas and Connecticut for defamation and related harms. Juries and courts awarded roughly $1.5 billion in combined judgments. In 2024 a federal bankruptcy judge ordered liquidation of Jones' personal assets while dismissing the separate bankruptcy of Free Speech Systems, leaving the future disposition of Infowars contested."}},{"id":"alex-jones-section-4","type":"markdown","label":"Platform and political role","position":{"x":-450,"y":650},"width":700,"height":380,"ports":[{"id":"root","label":"root","direction":"bidirectional","dataType":"any","angle":210},{"id":"top","label":"top","direction":"bidirectional","dataType":"value","angle":270},{"id":"right","label":"right","direction":"bidirectional","dataType":"value","angle":0},{"id":"bottom","label":"bottom","direction":"bidirectional","dataType":"value","angle":90},{"id":"left","label":"left","direction":"bidirectional","dataType":"value","angle":180}],"visible":true,"showLabel":false,"data":{"identity":{"graphId":"alex-jones-person-graph"},"markdown":"## Platform and political role\n\nJones has been a recurring figure in American populist and far-right media. Major technology platforms removed or restricted his accounts beginning in the late 2010s; he later returned to X after Elon Musk restored his account. He has interviewed and supported Donald Trump and remains part of a broader network of alternative political media."}},{"id":"alex-jones-section-5","type":"markdown","label":"Lionel episode context","position":{"x":450,"y":650},"width":700,"height":380,"ports":[{"id":"root","label":"root","direction":"bidirectional","dataType":"any","angle":210},{"id":"top","label":"top","direction":"bidirectional","dataType":"value","angle":270},{"id":"right","label":"right","direction":"bidirectional","dataType":"value","angle":0},{"id":"bottom","label":"bottom","direction":"bidirectional","dataType":"value","angle":90},{"id":"left","label":"left","direction":"bidirectional","dataType":"value","angle":180}],"visible":true,"showLabel":false,"data":{"identity":{"graphId":"alex-jones-person-graph"},"markdown":"## Lionel episode context\n\nIn Lionel Template v1 Example 01, Jones appears in the Actor Field as one of several commentators Lionel evaluates while discussing changes inside the political movement around Trump. The graph records Jones as an actor in Lionel's alignment narrative, not as a source whose claims are presumed true."}},{"id":"alex-jones-sources","type":"markdown","label":"Sources","position":{"x":0,"y":1150},"width":900,"height":520,"ports":[{"id":"root","label":"root","direction":"bidirectional","dataType":"any","angle":210},{"id":"top","label":"top","direction":"bidirectional","dataType":"value","angle":270},{"id":"right","label":"right","direction":"bidirectional","dataType":"value","angle":0},{"id":"bottom","label":"bottom","direction":"bidirectional","dataType":"value","angle":90},{"id":"left","label":"left","direction":"bidirectional","dataType":"value","angle":180}],"visible":true,"showLabel":false,"data":{"identity":{"graphId":"alex-jones-person-graph"},"markdown":"## Sources and photo provenance\n\n- **Associated Press**, *Who is Alex Jones? The conspiracist and dietary supplement salesman built an empire over decades*  \n  https://apnews.com/article/d6299ea512cafd222dab580b30c151ee\n- **Associated Press**, *Alex Jones' personal assets to be sold to pay $1.5B Sandy Hook debt*  \n  https://apnews.com/article/3ccd113496caee18a085dfa54c6e6c0e\n- **Wikimedia Commons**, *Alex Jones Portrait.jpg*  \n  https://commons.wikimedia.org/wiki/File:Alex_Jones_Portrait.jpg\n- **Associated Press**, *Sandy Hook defamation judgment context*  \n  https://apnews.com/article/4162d053348a7327f60e205d4d1c545b\n\n**Portrait URL:** https://upload.wikimedia.org/wikipedia/commons/c/cd/Alex_Jones_Portrait.jpg\n**Photo note:** Photo: Wikimedia Commons, Alex Jones portrait, 2017.\n\n**Lionel context:** `github://mikemartinez1974/public/templates/lionel/v1/example-01-associative-realignment.node`"}}],"edges":[{"id":"alex-jones-section-edge-1","source":"alex-jones-person","target":"alex-jones-section-1","sourceHandle":"bottom","targetHandle":"top","type":"reference","label":"profile context"},{"id":"alex-jones-section-edge-2","source":"alex-jones-person","target":"alex-jones-section-2","sourceHandle":"bottom","targetHandle":"top","type":"reference","label":"profile context"},{"id":"alex-jones-section-edge-3","source":"alex-jones-person","target":"alex-jones-section-3","sourceHandle":"bottom","targetHandle":"top","type":"reference","label":"profile context"},{"id":"alex-jones-section-edge-4","source":"alex-jones-person","target":"alex-jones-section-4","sourceHandle":"bottom","targetHandle":"top","type":"reference","label":"profile context"},{"id":"alex-jones-section-edge-5","source":"alex-jones-person","target":"alex-jones-section-5","sourceHandle":"bottom","targetHandle":"top","type":"reference","label":"profile context"},{"id":"alex-jones-class","source":"alex-jones-declaration","target":"alex-jones-person-bridge","sourceHandle":"root","targetHandle":"root","type":"reference","label":"class authority"},{"id":"alex-jones-inst","source":"alex-jones-person-bridge","target":"alex-jones-person","sourceHandle":"root","targetHandle":"root","type":"reference","label":"instantiates"},{"id":"alex-jones-profile","source":"alex-jones-detail","target":"alex-jones-person","sourceHandle":"root","targetHandle":"top","type":"reference","label":"profile"},{"id":"alex-jones-source","source":"alex-jones-person","target":"alex-jones-sources","sourceHandle":"bottom","targetHandle":"top","type":"reference","label":"sourced by"}],"clusters":[],"settings":{"theme":null,"backgroundImage":null,"defaultNodeColor":"#1976d2","defaultEdgeColor":"#666666","snapToGrid":false,"gridSize":20,"edgeRouting":"auto","autoSave":false},"scripts":[]}