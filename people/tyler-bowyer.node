    {"id":"tyler-bowyer-biography","type":"biography","label":"Arizona Organizing and Turning Point","root":false,"position":{"x":-1000,"y":-250},"width":380,"height":260,"handles":[{"id":"root","label":"root","direction":"bidirectional","dataType":"any","angle":210},{"id":"top","label":"top","direction":"bidirectional","dataType":"value","angle":270},{"id":"right","label":"right","direction":"bidirectional","dataType":"value","angle":0},{"id":"bottom","label":"bottom","direction":"bidirectional","dataType":"value","angle":90},{"id":"left","label":"left","direction":"bidirectional","dataType":"value","angle":180}],"ports":[{"id":"root","label":"root","direction":"bidirectional","dataType":"any","angle":210},{"id":"top","label":"top","direction":"bidirectional","dataType":"value","angle":270},{"id":"right","label":"right","direction":"bidirectional","dataType":"value","angle":0},{"id":"bottom","label":"bottom","direction":"bidirectional","dataType":"value","angle":90},{"id":"left","label":"left","direction":"bidirectional","dataType":"value","angle":180}],"visible":true,"showLabel":false,"data":{"title":"Arizona Organizing and Turning Point","body":"A seventh-generation Arizonan and conservative activist, Bowyer held a series of Republican Party organizing roles in Arizona before joining Charlie Kirk at Turning Point USA in 2015. He later became TPUSA’s chief operating officer and moved full-time to Turning Point Action in 2022 as its COO.","period":"2010s–present","subjectRef":"tyler-bowyer","status":"active","definitionKey":"biography","_classBinding":{"key":"biography","sourceRef":"github://mikemartinez1974/public/people/template/biography.node-class.node","ref":"github://mikemartinez1974/public/people/template/biography.node-class.node"},"_bridge":{"sourceNodeId":"tyler-bowyer-declaration","sourceRef":"github://mikemartinez1974/public/people/template/biography.node-class.node","entryPort":"root","kind":"node-class","targetKind":"node-class","classKey":"biography"