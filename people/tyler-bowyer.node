    {"id":"tyler-bowyer-elector-case","type":"life-event","label":"Arizona Alternate-Elector Proceeding","root":false,"position":{"x":260,"y":80},"width":380,"height":260,"handles":[{"id":"root","label":"root","direction":"bidirectional","dataType":"any","angle":210},{"id":"top","label":"top","direction":"bidirectional","dataType":"value","angle":270},{"id":"right","label":"right","direction":"bidirectional","dataType":"value","angle":0},{"id":"bottom","label":"bottom","direction":"bidirectional","dataType":"value","angle":90},{"id":"left","label":"left","direction":"bidirectional","dataType":"value","angle":180}],"ports":[{"id":"root","label":"root","direction":"bidirectional","dataType":"any","angle":210},{"id":"top","label":"top","direction":"bidirectional","dataType":"value","angle":270},{"id":"right","label":"right","direction":"bidirectional","dataType":"value","angle":0},{"id":"bottom","label":"bottom","direction":"bidirectional","dataType":"value","angle":90},{"id":"left","label":"left","direction":"bidirectional","dataType":"value","angle":180}],"visible":true,"showLabel":false,"data":{"title":"Arizona Alternate-Elector Proceeding","date":"2020-12-14","endDate":"","placeRef":"Arizona","participants":["tyler-bowyer"],"description":"Bowyer signed an alternate Republican electoral certificate after the 2020 election. Arizona prosecutors charged him and others in 2024. Courts later required the matter to return to a grand jury, and in June 2026 the attorney general said it would be presented again.","status":"ongoing","definitionKey":"life-event","_classBinding":{"key":"life-event","sourceRef":"github://mikemartinez1974/public/people/template/life-event.node-class.node","ref":"github://mikemartinez1974/public/people/template/life-event.node-class.node"},"_bridge":{"sourceNodeId":"tyler-bowyer-declaration","sourceRef":"github://mikemartinez1974/public/people/template/life-event.node-class.node","entryPort":"root","kind":"node-class","targetKind":"node-class","cl