    {"id":"blake-neff-biography","type":"biography","label":"From Dartmouth to Political Media","root":false,"position":{"x":-1000,"y":-250},"width":380,"height":260,"handles":[{"id":"root","label":"root","direction":"bidirectional","dataType":"any","angle":210},{"id":"top","label":"top","direction":"bidirectional","dataType":"value","angle":270},{"id":"right","label":"right","direction":"bidirectional","dataType":"value","angle":0},{"id":"bottom","label":"bottom","direction":"bidirectional","dataType":"value","angle":90},{"id":"left","label":"left","direction":"bidirectional","dataType":"value","angle":180}],"ports":[{"id":"root","label":"root","direction":"bidirectional","dataType":"any","angle":210},{"id":"top","label":"top","direction":"bidirectional","dataType":"value","angle":270},{"id":"right","label":"right","direction":"bidirectional","dataType":"value","angle":0},{"id":"bottom","label":"bottom","direction":"bidirectional","dataType":"value","angle":90},{"id":"left","label":"left","direction":"bidirectional","dataType":"value","angle":180}],"visible":true,"showLabel":false,"data":{"title":"From Dartmouth to Political Media","body":"A 2013 Dartmouth graduate, Neff entered political journalism through a Collegiate Network fellowship at The Hill. He later became a top writer for Tucker Carlson Tonight, resigned from Fox News in July 2020, and subsequently worked as a producer and co-host of The Charlie Kirk Show.","period":"2013–present","subjectRef":"blake-neff","status":"active","definitionKey":"biography","_classBinding":{"key":"biography","sourceRef":"github://mikemartinez1974/public/people/template/biography.node-class.node","ref":"github://mikemartinez1974/public/people/template/biography.node-class.node"},"_bridge":{"sourceNodeId":"blake-neff-declaration","sourceRef":"github://mikemartinez1974/public/people/template/biography.node-class.node","entryPort":"root","kind":"node-class","targetKind":"node-class","classKey":"biography","classRef":"github://mik