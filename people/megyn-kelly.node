      "data": {
        "title": "Public Life",
        "body": "Megyn Marie Kelly trained and practiced as an attorney before moving into broadcast journalism. She rose to national prominence at Fox News, later hosted a morning program for NBC News, and launched an independent media company and The Megyn Kelly Show in 2020. The program subsequently expanded into a weekday SiriusXM broadcast, podcast, and video show.",
        "period": "1970–present",
        "subjectRef": "megyn-kelly",
        "status": "active",
        "definitionKey": "biography",
