{"fileVersion":"1.0","metadata":{"title":"Roger Stone","description":"A sourced public-figure graph about American political consultant and lobbyist Roger Stone.","graphId":"roger-stone-person-graph","version":"0.2.0","kind":"person","created":"2026-08-07T17:10:00.000Z","modified":"2026-08-07T17:30:00.000Z","author":"","tags":["person","public","lionel-v1","sourced-profile"],"preferredViewer":"https://twilite.zone"},"nodes":[{"id":"roger-stone-declaration","type":"declaration","label":"Roger Stone Declaration","position":{"x":-1200,"y":-900},"width":420,"height":300,"ports":[{"id":"root","label":"root","direction":"bidirectional","dataType":"any","angle":210}],"visible":false,"showLabel":true,"data":{"analytics":{"contentGroup":"people"},"identity":{"graphId":"roger-stone-person-graph","name":"Roger Stone","version":"0.2.0","description":"A sourced public-figure graph about American political consultant and lobbyist Roger Stone.","createdAt":"2026-08-07T17:10:00.000Z","updatedAt":"2026-08-07T17:30:00.000Z"},"intent":{"kind":"person","scope":"public"},"dependencies":{"nodeTypes":["declaration","bridge","port","person","markdown"],"portContracts":["core"],"schemaVersions":{"nodes":">=1.0.0","ports":">=1.0.0"}},"authority":{"mode":"graph","mutation":{"allowCreate":true,"allowUpdate":true,"allowDelete":true,"appendOnly":false},"actors":{"humans":true,"agents":true,"tools":true},"history":{"rewriteAllowed":false,"squashAllowed":false}},"declaration":{"kind":"person","targetMode":"artifact","artifactKind":"graph","defaultSurfaceId":"root","surfaces":[{"id":"root","kind":"port","label":"Roger Stone","portNodeId":"roger-stone-detail","viewNodeId":"roger-stone-detail"}]}}},{"id":"roger-stone-person-bridge","type":"bridge","label":"Person","position":{"x":-1200,"y":-550},"width":260,"height":100,"ports":[{"id":"root","label":"root","direction":"bidirectional","dataType":"any","angle":210}],"visible":false,"showLabel":true,"data":{"authority":"bridge","target":{"mode":"bridge","ref":"github://mikemartinez1974/public/people/template/person.node-class.node","kind":"node-class","resourceKind":"node-class","scope":"focused-graph","grants":["create"],"key":"person","label":"Person"},"resourceKind":"node-class","scope":"focused-graph","grants":["create"],"bridge":{"ref":"github://mikemartinez1974/public/people/template/person.node-class.node","resourceKind":"node-class","scope":"focused-graph","grants":["create"]},"_classBinding":{"key":"person","sourceRef":"github://mikemartinez1974/public/people/template/person.node-class.node"},"_bridge":{"sourceRef":"github://mikemartinez1974/public/people/template/person.node-class.node","entryPort":"root","kind":"node-class","targetKind":"node-class","classKey":"person","classRef":"github://mikemartinez1974/public/people/template/person.node-class.node"}}},{"id":"roger-stone-detail","type":"port","label":"Roger Stone","position":{"x":0,"y":-900},"width":720,"height":520,"ports":[{"id":"root","label":"root","direction":"bidirectional","dataType":"any","angle":210}],"visible":true,"showLabel":false,"data":{"identity":{"graphId":"roger-stone-person-graph","portId":"root","name":"Roger Stone"},"view":{"intent":"node","payload":"node.web.summary","label":"Roger Stone"},"renderShape":{"kind":"markdown"},"markdown":"# 👤 Roger Stone\n\n![Portrait of Roger Stone](https://ctmirror.org/wp-content/uploads/2017/01/Roger-Stone_window-portrait-e1485361014445.jpg)\n\n**political consultant · lobbyist · campaign strategist**\n\nAmerican political consultant and lobbyist with roots in Republican politics dating to Richard Nixon and a decades-long association with Donald Trump.\n\n*Portrait: CT Mirror archive / Roger Stone.*"}},{"id":"roger-stone-person","type":"person","label":"Roger Stone","position":{"x":0,"y":-300},"width":500,"height":340,"ports":[{"id":"root","label":"root","direction":"bidirectional","dataType":"any","angle":210},{"id":"top","label":"top","direction":"bidirectional","dataType":"value","angle":270},{"id":"right","label":"right","direction":"bidirectional","dataType":"value","angle":0},{"id":"bottom","label":"bottom","direction":"bidirectional","dataType":"value","angle":90},{"id":"left","label":"left","direction":"bidirectional","dataType":"value","angle":180}],"visible":true,"showLabel":false,"data":{"displayName":"Roger Stone","fullName":"Roger Joseph Stone Jr.","aliases":[],"summary":"American political consultant and lobbyist with roots in Republican politics dating to Richard Nixon and a decades-long association with Donald Trump.","portrait":"https://ctmirror.org/wp-content/uploads/2017/01/Roger-Stone_window-portrait-e1485361014445.jpg","birthDate":"1952-08-27","deathDate":"","pronouns":"","nationality":"American","primaryRoles":["political consultant","lobbyist","campaign strategist","author"],"canonicalUri":"github://mikemartinez1974/public/people/roger-stone.node","status":"published","definitionKey":"person","_classBinding":{"key":"person","sourceRef":"github://mikemartinez1974/public/people/template/person.node-class.node"},"_bridge":{"classKey":"person","classRef":"github://mikemartinez1974/public/people/template/person.node-class.node","entryPort":"root","kind":"node-class","sourceRef":"github://mikemartinez1974/public/people/template/person.node-class.node","targetKind":"node-class"}}},{"id":"roger-stone-section-1","type":"markdown","label":"Early political career","position":{"x":-900,"y":180},"width":700,"height":380,"ports":[{"id":"root","label":"root","direction":"bidirectional","dataType":"any","angle":210},{"id":"top","label":"top","direction":"bidirectional","dataType":"value","angle":270},{"id":"right","label":"right","direction":"bidirectional","dataType":"value","angle":0},{"id":"bottom","label":"bottom","direction":"bidirectional","dataType":"value","angle":90},{"id":"left","label":"left","direction":"bidirectional","dataType":"value","angle":180}],"visible":true,"showLabel":false,"data":{"identity":{"graphId":"roger-stone-person-graph"},"markdown":"## Early political career\n\nRoger Stone entered Republican politics as a young operative during the Nixon era and went on to work in campaigns, lobbying, and political consulting. He became known for aggressive campaign tactics and for cultivating a public persona built around political strategy and provocation."}},{"id":"roger-stone-section-2","type":"markdown","label":"Consulting and Trump relationship","position":{"x":0,"y":180},"width":700,"height":380,"ports":[{"id":"root","label":"root","direction":"bidirectional","dataType":"any","angle":210},{"id":"top","label":"top","direction":"bidirectional","dataType":"value","angle":270},{"id":"right","label":"right","direction":"bidirectional","dataType":"value","angle":0},{"id":"bottom","label":"bottom","direction":"bidirectional","dataType":"value","angle":90},{"id":"left","label":"left","direction":"bidirectional","dataType":"value","angle":180}],"visible":true,"showLabel":false,"data":{"identity":{"graphId":"roger-stone-person-graph"},"markdown":"## Consulting and Trump relationship\n\nStone was a partner in the lobbying firm Black, Manafort, Stone and Kelly and developed a long relationship with Donald Trump. PBS FRONTLINE documented Stone's role in encouraging and interpreting Trump's presidential ambitions well before the 2016 campaign. Stone briefly served as an adviser to Trump's 2016 campaign and remained a prominent ally and outside political voice afterward."}},{"id":"roger-stone-section-3","type":"markdown","label":"Federal conviction, commutation, and pardon","position":{"x":900,"y":180},"width":700,"height":380,"ports":[{"id":"root","label":"root","direction":"bidirectional","dataType":"any","angle":210},{"id":"top","label":"top","direction":"bidirectional","dataType":"value","angle":270},{"id":"right","label":"right","direction":"bidirectional","dataType":"value","angle":0},{"id":"bottom","label":"bottom","direction":"bidirectional","dataType":"value","angle":90},{"id":"left","label":"left","direction":"bidirectional","dataType":"value","angle":180}],"visible":true,"showLabel":false,"data":{"identity":{"graphId":"roger-stone-person-graph"},"markdown":"## Federal conviction, commutation, and pardon\n\nIn November 2019 a federal jury convicted Stone of obstruction of a congressional investigation, five counts of making false statements to Congress, and witness tampering. He was sentenced to 40 months in prison. President Trump commuted the prison sentence in July 2020 and granted Stone a full pardon in December 2020. The Justice Department's pardon records list the offenses and clemency."}},{"id":"roger-stone-section-4","type":"markdown","label":"Media and public persona","position":{"x":-450,"y":650},"width":700,"height":380,"ports":[{"id":"root","label":"root","direction":"bidirectional","dataType":"any","angle":210},{"id":"top","label":"top","direction":"bidirectional","dataType":"value","angle":270},{"id":"right","label":"right","direction":"bidirectional","dataType":"value","angle":0},{"id":"bottom","label":"bottom","direction":"bidirectional","dataType":"value","angle":90},{"id":"left","label":"left","direction":"bidirectional","dataType":"value","angle":180}],"visible":true,"showLabel":false,"data":{"identity":{"graphId":"roger-stone-person-graph"},"markdown":"## Media and public persona\n\nStone has remained active as an author, speaker, commentator, and political organizer. His distinctive style and long memory of Republican campaign politics make him a frequent reference point in discussions about Trump's political network and the history of modern conservative political operations."}},{"id":"roger-stone-section-5","type":"markdown","label":"Lionel episode context","position":{"x":450,"y":650},"width":700,"height":380,"ports":[{"id":"root","label":"root","direction":"bidirectional","dataType":"any","angle":210},{"id":"top","label":"top","direction":"bidirectional","dataType":"value","angle":270},{"id":"right","label":"right","direction":"bidirectional","dataType":"value","angle":0},{"id":"bottom","label":"bottom","direction":"bidirectional","dataType":"value","angle":90},{"id":"left","label":"left","direction":"bidirectional","dataType":"value","angle":180}],"visible":true,"showLabel":false,"data":{"identity":{"graphId":"roger-stone-person-graph"},"markdown":"## Lionel episode context\n\nIn Lionel Template v1 Example 01, Stone is one of the actors Lionel places inside a changing political field around Trump. The episode's claims about loyalties and political realignment remain Lionel's interpretation; this profile supplies durable identity and career context for the named actor."}},{"id":"roger-stone-sources","type":"markdown","label":"Sources","position":{"x":0,"y":1150},"width":900,"height":520,"ports":[{"id":"root","label":"root","direction":"bidirectional","dataType":"any","angle":210},{"id":"top","label":"top","direction":"bidirectional","dataType":"value","angle":270},{"id":"right","label":"right","direction":"bidirectional","dataType":"value","angle":0},{"id":"bottom","label":"bottom","direction":"bidirectional","dataType":"value","angle":90},{"id":"left","label":"left","direction":"bidirectional","dataType":"value","angle":180}],"visible":true,"showLabel":false,"data":{"identity":{"graphId":"roger-stone-person-graph"},"markdown":"## Sources and photo provenance\n\n- **PBS FRONTLINE**, *The FRONTLINE Interview: Roger Stone*  \n  https://www.pbs.org/wgbh/frontline/article/the-frontline-interview-roger-stone/\n- **U.S. Department of Justice**, *Roger Stone Found Guilty of Obstruction, False Statements, and Witness Tampering*  \n  https://www.justice.gov/usao-dc/pr/roger-stone-found-guilty-obstruction-false-statements-and-witness-tampering\n- **DOJ Office of the Pardon Attorney**, *Pardons Granted by President Donald J. Trump (2017-2021)*  \n  https://www.justice.gov/pardon/pardons-granted-president-donald-j-trump-2017-2021\n- **Reuters**, *Trump pardons former campaign chairman Manafort, associate Roger Stone*  \n  https://www.reuters.com/world/us/trump-pardons-former-campaign-chairman-manafort-associate-roger-stone-2020-12-24/\n- **CT Mirror**, *Roger Stone portrait / Trump phenomenon*  \n  https://ctmirror.org/2017/01/29/roger-stone-and-the-trump-phenomenon/\n\n**Portrait URL:** https://ctmirror.org/wp-content/uploads/2017/01/Roger-Stone_window-portrait-e1485361014445.jpg\n**Photo note:** Portrait: CT Mirror archive / Roger Stone.\n\n**Lionel context:** `github://mikemartinez1974/public/templates/lionel/v1/example-01-associative-realignment.node`"}}],"edges":[{"id":"roger-stone-section-edge-1","source":"roger-stone-person","target":"roger-stone-section-1","sourceHandle":"bottom","targetHandle":"top","type":"reference","label":"profile context"},{"id":"roger-stone-section-edge-2","source":"roger-stone-person","target":"roger-stone-section-2","sourceHandle":"bottom","targetHandle":"top","type":"reference","label":"profile context"},{"id":"roger-stone-section-edge-3","source":"roger-stone-person","target":"roger-stone-section-3","sourceHandle":"bottom","targetHandle":"top","type":"reference","label":"profile context"},{"id":"roger-stone-section-edge-4","source":"roger-stone-person","target":"roger-stone-section-4","sourceHandle":"bottom","targetHandle":"top","type":"reference","label":"profile context"},{"id":"roger-stone-section-edge-5","source":"roger-stone-person","target":"roger-stone-section-5","sourceHandle":"bottom","targetHandle":"top","type":"reference","label":"profile context"},{"id":"roger-stone-class","source":"roger-stone-declaration","target":"roger-stone-person-bridge","sourceHandle":"root","targetHandle":"root","type":"reference","label":"class authority"},{"id":"roger-stone-inst","source":"roger-stone-person-bridge","target":"roger-stone-person","sourceHandle":"root","targetHandle":"root","type":"reference","label":"instantiates"},{"id":"roger-stone-profile","source":"roger-stone-detail","target":"roger-stone-person","sourceHandle":"root","targetHandle":"top","type":"reference","label":"profile"},{"id":"roger-stone-source","source":"roger-stone-person","target":"roger-stone-sources","sourceHandle":"bottom","targetHandle":"top","type":"reference","label":"sourced by"}],"clusters":[],"settings":{"theme":null,"backgroundImage":null,"defaultNodeColor":"#1976d2","defaultEdgeColor":"#666666","snapToGrid":false,"gridSize":20,"edgeRouting":"auto","autoSave":false},"scripts":[]}