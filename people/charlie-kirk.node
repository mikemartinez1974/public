      "data": {
        "title": "Public Life",
        "body": "Charles James Kirk was born in Arlington Heights, Illinois. At 18, he co-founded Turning Point USA with activist William Montgomery. Kirk became the organization's principal public figure and remained its leader until his death in 2025. He also wrote political books, spoke frequently on college campuses, and hosted The Charlie Kirk Show.",
        "period": "1993–2025",
        "subjectRef": "charlie-kirk",
        "status": "active",
        "definitionKey": "biography",
