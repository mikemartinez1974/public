      "data": {
        "title": "Public Life",
        "body": "Tucker Carlson began in print journalism before moving into television at CNN, PBS, MSNBC, and Fox News. He hosted Tucker Carlson Tonight from 2016 until Fox ended the program in 2023. He subsequently launched The Tucker Carlson Show and Tucker Carlson Network as independent media ventures.",
        "period": "1969–present",
        "subjectRef": "tucker-carlson",
        "status": "active",
