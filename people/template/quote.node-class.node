        },
        "renderShape": {
          "kind": "html"
        },
        "html": "<article style=\"width:100%;height:100%;box-sizing:border-box;padding:20px;border-radius:20px;background:linear-gradient(135deg,#f3e8ff,white);border:1px solid #9333ea44;color:#172033;font-family:ui-sans-serif,system-ui,sans-serif;overflow:auto\"><div style=\"font-size:11px;font-weight:800;letter-spacing:.12em;text-transform:uppercase;color:#9333ea\">Quote</div><h2 style=\"margin:8px 0 14px;font-size:26px;line-height:1.15\">{{data.title}}</h2><blockquote style=\"margin:12px 0 16px;padding:14px 16px;border-left:5px solid #9333ea;background:white;border-radius:0 12px 12px 0;font-size:18px;line-height:1.5\">“{{data.quoteText}}”</blockquote><div style=\"display:grid;grid-template-columns:118px 1fr;gap:10px;padding:7px 0;border-top:1px solid rgba(100,116,139,.14)\"><strong style=\"font-size:11px;letter-spacing:.06em;text-transform:uppercase;color:#64748b\">Speaker</strong><span style=\"font-size:13px;line-height:1.45;overflow-wrap:anywhere\">{{data.speakerRef}}</span></div> <div style=\"display:grid;grid-template-columns:118px 1fr;gap:10px;padding:7px 0;border-top:1px solid rgba(100,116,139,.14)\"><strong style=\"font-size:11px;letter-spacing:.06em;text-transform:uppercase;color:#64748b\">Date</strong><span style=\"font-size:13px;line-height:1.45;overflow-wrap:anywhere\">{{data.date}}</span></div> <div style=\"display:grid;grid-template-columns:118px 1fr;gap:10px;padding:7px 0;border-top:1px solid rgba(100,116,139,.14)\"><strong style=\"font-size:11px;letter-spacing:.06em;text-transform:uppercase;color:#64748b\">Context</strong><span style=\"font-size:13px;line-height:1.45;overflow-wrap:anywhere\">{{data.context}}</span></div> <div style=\"display:grid;grid-template-columns:118px 1fr;gap:10px;padding:7px 0;border-top:1px solid rgba(100,116,139,.14)\"><strong style=\"font-size:11px;letter-spacing:.06em;text-transform:uppercase;color:#64748b\">Source</strong><span style=\"font-size:13px;line-height:1.45;overflow-wrap:anywhere\">{{data.citationSourceId}}</span></div> <div style=\"display:grid;grid-template-columns:118px 1fr;gap:10px;padding:7px 0;border-top:1px solid rgba(100,116,139,.14)\"><strong style=\"font-size:11px;letter-spacing:.06em;text-transform:uppercase;color:#64748b\">Locator</strong><span style=\"font-size:13px;line-height:1.45;overflow-wrap:anywhere\">{{data.locator}}</span></div> <div style=\"display:grid;grid-template-columns:118px 1fr;gap:10px;padding:7px 0;border-top:1px solid rgba(100,116,139,.14)\"><strong style=\"font-size:11px;letter-spacing:.06em;text-transform:uppercase;color:#64748b\">Verification</strong><span style=\"font-size:13px;line-height:1.45;overflow-wrap:anywhere\">{{data.verificationStatus}}</span></div><div style=\"margin-top:12px\"><span style=\"display:inline-flex;padding:5px 9px;border-radius:999px;background:rgba(100,116,139,.12);font-size:11px;font-weight:800;text-transform:uppercase\">{{data.status}}</span></div></article>"
      }
    },
