        "view": {
          "intent": "node",
          "payload": "node.web.detail",
          "controls": [
            {
              "id": "person-open-link",
              "type": "button",
              "label": "Open canonical page",
              "icon": "openInNew",
              "variant": "outlined",
              "priority": "high",
              "action": "navigate",
              "hrefPath": "data.canonicalUri"
