                "type": "text",
                "path": "data.fullName",
                "placeholder": ""
              },
              {
                "key": "aliases",
                "label": "Aliases",
                "type": "tags",
                "path": "data.aliases",
                "placeholder": "Candace Owens, Candace Farmer",
                "helperText": "Separate multiple aliases with commas."
              },
              {
                "key": "summary",
                "label": "Summary",
                "type": "markdown",
                "path": "data.summary",
                "placeholder": "",
                "multiline": true,
