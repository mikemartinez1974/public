          ]
        },
        "renderShape": {
          "kind": "html"
        },
        "html": "<article style=\"width:100%;height:100%;box-sizing:border-box;padding:20px;border-radius:20px;background:linear-gradient(135deg,#fef3c7,white);border:1px solid #d9770644;color:#172033;font-family:ui-sans-serif,system-ui,sans-serif;overflow:auto\"><div style=\"font-size:11px;font-weight:800;letter-spacing:.12em;text-transform:uppercase;color:#d97706\">Person</div><div style=\"display:flex;gap:18px;align-items:flex-start\"><img src=\"{{data.portrait}}\" alt=\"Portrait of {{data.displayName}}\" style=\"width:112px;height:140px;object-fit:cover;border-radius:14px;background:#fde68a\"/><div><h2 style=\"margin:8px 0 14px;font-size:26px;line-height:1.15\">{{data.displayName}}</h2><div style=\"font-size:13px;color:#6b7280\">{{data.fullName}}</div><div style=\"margin-top:10px\"><span style=\"display:inline-flex;padding:5px 9px;border-radius:999px;background:rgba(100,116,139,.12);font-size:11px;font-weight:800;text-transform:uppercase\">{{data.status}}</span></div></div></div><div style=\"margin:12px 0 16px;white-space:pre-wrap;line-height:1.6;color:#334155\">{{data.summary}}</div><div style=\"display:grid;grid-template-columns:118px 1fr;gap:10px;padding:7px 0;border-top:1px solid rgba(100,116,139,.14)\"><strong style=\"font-size:11px;letter-spacing:.06em;text-transform:uppercase;color:#64748b\">Aliases</strong><span style=\"font-size:13px;line-height:1.45;overflow-wrap:anywhere\">{{join(data.aliases, \", \")}}</span></div> <div style=\"display:grid;grid-template-columns:118px 1fr;gap:10px;padding:7px 0;border-top:1px solid rgba(100,116,139,.14)\"><strong style=\"font-size:11px;letter-spacing:.06em;text-transform:uppercase;color:#64748b\">Born</strong><span style=\"font-size:13px;line-height:1.45;overflow-wrap:anywhere\">{{data.birthDate}}</span></div> <div style=\"display:grid;grid-template-columns:118px 1fr;gap:10px;padding:7px 0;border-top:1px solid rgba(100,116,139,.14)\"><strong style=\"font-size:11px;letter-spacing:.06em;text-transform:uppercase;color:#64748b\">Died</strong><span style=\"font-size:13px;line-height:1.45;overflow-wrap:anywhere\">{{data.deathDate}}</span></div> <div style=\"display:grid;grid-template-columns:118px 1fr;gap:10px;padding:7px 0;border-top:1px solid rgba(100,116,139,.14)\"><strong style=\"font-size:11px;letter-spacing:.06em;text-transform:uppercase;color:#64748b\">Pronouns</strong><span style=\"font-size:13px;line-height:1.45;overflow-wrap:anywhere\">{{data.pronouns}}</span></div> <div style=\"display:grid;grid-template-columns:118px 1fr;gap:10px;padding:7px 0;border-top:1px solid rgba(100,116,139,.14)\"><strong style=\"font-size:11px;letter-spacing:.06em;text-transform:uppercase;color:#64748b\">Nationality</strong><span style=\"font-size:13px;line-height:1.45;overflow-wrap:anywhere\">{{data.nationality}}</span></div> <div style=\"display:grid;grid-template-columns:118px 1fr;gap:10px;padding:7px 0;border-top:1px solid rgba(100,116,139,.14)\"><strong style=\"font-size:11px;letter-spacing:.06em;text-transform:uppercase;color:#64748b\">Primary roles</strong><span style=\"font-size:13px;line-height:1.45;overflow-wrap:anywhere\">{{join(data.primaryRoles, \" · \")}}</span></div> <div style=\"display:grid;grid-template-columns:118px 1fr;gap:10px;padding:7px 0;border-top:1px solid rgba(100,116,139,.14)\"><strong style=\"font-size:11px;letter-spacing:.06em;text-transform:uppercase;color:#64748b\">Canonical</strong><span style=\"font-size:13px;line-height:1.45;overflow-wrap:anywhere\"><a href=\"{{data.canonicalUri}}\" target=\"_blank\" rel=\"noopener noreferrer\" style=\"color:#2563eb;font-weight:700;text-decoration:underline;overflow-wrap:anywhere\">Open canonical page ↗</a><div style=\"font-size:11px;color:#64748b;margin-top:4px;overflow-wrap:anywhere\">{{data.canonicalUri}}</div></span></div></article>"
      }
