        "html": "<article style=\"width:100%;height:100%;box-sizing:border-box;padding:20px;border-radius:20px;background:linear-gradient(135deg,#dbeafe,white);border:1px solid #2563eb44;color:#172033;font-family:ui-sans-serif,system-ui,sans-serif;overflow:auto\"><div style=\"font-size:11px;font-weight:800;letter-spacing:.12em;text-transform:uppercase;color:#2563eb\">Role</div><h2 style=\"margin:8px 0 14px;font-size:26px;line-height:1.15\">{{data.title}}</h2><div style=\"display:grid;grid-template-columns:118px 1fr;gap:10px;padding:7px 0;border-top:1px solid rgba(100,116,139,.14)\"><strong style=\"font-size:11px;letter-spacing:.06em;text-transform:uppercase;color:#64748b\">Organization</strong><span style=\"font-size:13px;line-height:1.45;overflow-wrap:anywhere\">{{data.organizationRef}}</span></div> <div style=\"display:grid;grid-template-columns:118px 1fr;gap:10px;padding:7px 0;border-top:1px solid rgba(100,116,139,.14)\"><strong style=\"font-size:11px;letter-spacing:.06em;text-transform:uppercase;color:#64748b\">Dates</strong><span style=\"font-size:13px;line-height:1.45;overflow-wrap:anywhere\">{{data.startDate}} — {{data.endDate}}</span></div> <div style=\"display:grid;grid-template-columns:118px 1fr;gap:10px;padding:7px 0;border-top:1px solid rgba(100,116,139,.14)\"><strong style=\"font-size:11px;letter-spacing:.06em;text-transform:uppercase;color:#64748b\">Location</strong><span style=\"font-size:13px;line-height:1.45;overflow-wrap:anywhere\">{{data.locationRef}}</span></div> <div style=\"margin:12px 0 16px;white-space:pre-wrap;line-height:1.6;color:#334155\">{{data.description}}</div><div><span style=\"display:inline-flex;padding:5px 9px;border-radius:999px;background:rgba(100,116,139,.12);font-size:11px;font-weight:800;text-transform:uppercase\">{{data.status}}</span></div></article>"
      }
