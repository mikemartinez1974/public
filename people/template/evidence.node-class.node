        "renderShape": {
          "kind": "html"
        },
        "html": "<article style=\"width:100%;height:100%;box-sizing:border-box;padding:20px;border-radius:20px;background:linear-gradient(135deg,#ccfbf1,white);border:1px solid #0f766e44;color:#172033;font-family:ui-sans-serif,system-ui,sans-serif;overflow:auto\"><div style=\"font-size:11px;font-weight:800;letter-spacing:.12em;text-transform:uppercase;color:#0f766e\">Evidence</div><h2 style=\"margin:8px 0 14px;font-size:26px;line-height:1.15\">{{data.title}}</h2><div style=\"margin:12px 0 16px;white-space:pre-wrap;line-height:1.6;color:#334155\">{{data.evidenceText}}</div> <div style=\"display:grid;grid-template-columns:118px 1fr;gap:10px;padding:7px 0;border-top:1px solid rgba(100,116,139,.14)\"><strong style=\"font-size:11px;letter-spacing:.06em;text-transform:uppercase;color:#64748b\">Claim</strong><span style=\"font-size:13px;line-height:1.45;overflow-wrap:anywhere\">{{data.claimRef}}</span></div> <div style=\"display:grid;grid-template-columns:118px 1fr;gap:10px;padding:7px 0;border-top:1px solid rgba(100,116,139,.14)\"><strong style=\"font-size:11px;letter-spacing:.06em;text-transform:uppercase;color:#64748b\">Source</strong><span style=\"font-size:13px;line-height:1.45;overflow-wrap:anywhere\">{{data.citationSourceId}}</span></div> <div style=\"display:grid;grid-template-columns:118px 1fr;gap:10px;padding:7px 0;border-top:1px solid rgba(100,116,139,.14)\"><strong style=\"font-size:11px;letter-spacing:.06em;text-transform:uppercase;color:#64748b\">Locator</strong><span style=\"font-size:13px;line-height:1.45;overflow-wrap:anywhere\">{{data.locator}}</span></div> <div style=\"display:grid;grid-template-columns:118px 1fr;gap:10px;padding:7px 0;border-top:1px solid rgba(100,116,139,.14)\"><strong style=\"font-size:11px;letter-spacing:.06em;text-transform:uppercase;color:#64748b\">Stance</strong><span style=\"font-size:13px;line-height:1.45;overflow-wrap:anywhere\">{{data.stance}}</span></div> <div style=\"display:grid;grid-template-columns:118px 1fr;gap:10px;padding:7px 0;border-top:1px solid rgba(100,116,139,.14)\"><strong style=\"font-size:11px;letter-spacing:.06em;text-transform:uppercase;color:#64748b\">Confidence</strong><span style=\"font-size:13px;line-height:1.45;overflow-wrap:anywhere\">{{data.confidence}}</span></div><div style=\"margin-top:12px\"><span style=\"display:inline-flex;padding:5px 9px;border-radius:999px;background:rgba(100,116,139,.12);font-size:11px;font-weight:800;text-transform:uppercase\">{{data.status}}</span></div></article>"
      }
