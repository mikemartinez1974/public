        "html": "<div style=\"width:100%;height:100%;box-sizing:border-box;padding:12px;border-radius:24px;background:linear-gradient(145deg,#fffaf0,#fef3c7);border:1px solid rgba(217,119,6,.28);box-shadow:0 12px 30px rgba(120,53,15,.16);display:flex;flex-direction:column;align-items:center;justify-content:center;gap:10px;font-family:ui-sans-serif,system-ui,sans-serif;color:#172033;overflow:hidden\">\n  <div style=\"width:118px;height:118px;flex:0 0 118px;padding:5px;border-radius:999px;background:linear-gradient(135deg,#fbbf24,#b45309);box-shadow:0 8px 20px rgba(146,64,14,.28)\">\n    <img src=\"{{data.portrait}}\" alt=\"Portrait of {{data.displayName}}\" style=\"display:block;width:100%;height:100%;object-fit:cover;object-position:center 20%;border-radius:999px;background:#fde68a\"/>\n  </div>\n  <div style=\"width:100%;font-size:17px;line-height:1.15;font-weight:850;text-align:center;white-space:nowrap;overflow:hidden;text-overflow:ellipsis\">{{data.displayName}}</div>\n</div>",
        "payload": "graph.web.icon",
