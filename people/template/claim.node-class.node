adding:7px 0;border-top:1px solid rgba(100,116,139,.14)\"><strong style=\"font-size:11px;letter-spacing:.06em;text-transform:uppercase;color:#64748b\">Disputed</strong><span style=\"font-size:13px;line-height:1.45;overflow-wrap:anywhere\">{{data.disputed}}</span></div><div style=\"margin-top:12px\"><span style=\"display:inline-flex;padding:5px 9px;border-radius:999px;background:rgba(100,116,139,.12);font-size:11px;font-weight:800;text-transform:uppercase\">{{data.status}}</span></div></article>"
