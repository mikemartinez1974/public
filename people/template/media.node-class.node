        "renderShape": {
          "kind": "html"
        },
        "html": "<article style=\"width:100%;height:100%;box-sizing:border-box;padding:20px;border-radius:20px;background:linear-gradient(135deg,#cffafe,white);border:1px solid #0891b244;color:#172033;font-family:ui-sans-serif,system-ui,sans-serif;overflow:auto\"><div style=\"font-size:11px;font-weight:800;letter-spacing:.12em;text-transform:uppercase;color:#0891b2\">Media</div><div style=\"height:150px;margin:10px 0 14px;border-radius:14px;background:#a5f3fc center/cover no-repeat url('{{data.uri}}');border:1px solid #0891b244\"></div><h2 style=\"margin:8px 0 14px;font-size:26px;line-height:1.15\">{{data.title}}</h2><div style=\"display:grid;grid-template-columns:118px 1fr;gap:10px;padding:7px 0;border-top:1px solid rgba(100,116,139,.14)\"><strong style=\"font-size:11px;letter-spacing:.06em;text-transform:uppercase;color:#64748b\">Type</strong><span style=\"font-size:13px;line-height:1.45;overflow-wrap:anywhere\">{{data.mediaType}}</span></div> <div style=\"display:grid;grid-template-columns:118px 1fr;gap:10px;padding:7px 0;border-top:1px solid rgba(100,116,139,.14)\"><strong style=\"font-size:11px;letter-spacing:.06em;text-transform:uppercase;color:#64748b\">Date</strong><span style=\"font-size:13px;line-height:1.45;overflow-wrap:anywhere\">{{data.date}}</span></div> <div style=\"display:grid;grid-template-columns:118px 1fr;gap:10px;padding:7px 0;border-top:1px solid rgba(100,116,139,.14)\"><strong style=\"font-size:11px;letter-spacing:.06em;text-transform:uppercase;color:#64748b\">Depicts</strong><span style=\"font-size:13px;line-height:1.45;overflow-wrap:anywhere\">{{data.depictsRef}}</span></div> <div style=\"display:grid;grid-template-columns:118px 1fr;gap:10px;padding:7px 0;border-top:1px solid rgba(100,116,139,.14)\"><strong style=\"font-size:11px;letter-spacing:.06em;text-transform:uppercase;color:#64748b\">Creator</strong><span style=\"font-size:13px;line-height:1.45;overflow-wrap:anywhere\">{{data.creator}}</span></div> <div style=\"display:grid;grid-template-columns:118px 1fr;gap:10px;padding:7px 0;border-top:1px solid rgba(100,116,139,.14)\"><strong style=\"font-size:11px;letter-spacing:.06em;text-transform:uppercase;color:#64748b\">Rights</strong><span style=\"font-size:13px;line-height:1.45;overflow-wrap:anywhere\">{{data.rights}}</span></div> <div style=\"margin:12px 0 16px;white-space:pre-wrap;line-height:1.6;color:#334155\">{{data.caption}}</div> <div style=\"display:grid;grid-template-columns:118px 1fr;gap:10px;padding:7px 0;border-top:1px solid rgba(100,116,139,.14)\"><strong style=\"font-size:11px;letter-spacing:.06em;text-transform:uppercase;color:#64748b\">Media link</strong><span style=\"font-size:13px;line-height:1.45;overflow-wrap:anywhere\"><a href=\"{{data.uri}}\" target=\"_blank\" rel=\"noopener noreferrer\" style=\"color:#2563eb;font-weight:700;text-decoration:underline;overflow-wrap:anywhere\">Open media ↗</a><div style=\"font-size:11px;color:#64748b;margin-top:4px;overflow-wrap:anywhere\">{{data.uri}}</div></span></div><div style=\"margin-top:12px\"><span style=\"display:inline-flex;padding:5px 9px;border-radius:999px;background:rgba(100,116,139,.12);font-size:11px;font-weight:800;text-transform:uppercase\">{{data.status}}</span></div></article>"
      }
