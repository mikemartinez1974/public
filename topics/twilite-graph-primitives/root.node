{"fileVersion":"1.0","metadata":{"title":"Twilite Graph Primitives","description":"A topic graph explaining Twilite's graph-native primitives and how relationships compose them.","graphId":"twilite-graph-primitives","version":"1.0.0","kind":"documentation","created":"2026-09-17T17:23:00.000Z","modified":"2026-09-17T17:23:00.000Z","author":"","tags":["twilite","graph-primitives","topic"],"preferredViewer":"https://twilite.zone"},"nodes":[{"id":"gp-decl","type":"declaration","label":"Twilite Graph Primitives","position":{"x":-900,"y":-1000},"width":400,"height":260,"ports":[{"id":"default-view","label":"default view","direction":"output","dataType":"any","angle":165},{"id":"summary-view","label":"summary view","direction":"output","dataType":"any","angle":180},{"id":"icon-view","label":"icon view","direction":"output","dataType":"any","angle":195},{"id":"glyph","label":"glyph","direction":"output","dataType":"any","angle":270},{"id":"landing-surface","label":"landing surface","direction":"output","dataType":"any","angle":0}],"visible":true,"showLabel":true,"data":{"identity":{"graphId":"twilite-graph-primitives","name":"Twilite Graph Primitives","version":"1.0.0","description":"Twilite's core graph-native primitives and how they compose."},"intent":{"kind":"documentation","scope":"public"},"dependencies":{"nodeTypes":["declaration","view","content","glyph","bridge","topic","topic-concept","topic-claim","topic-mechanism","topic-perspective","topic-source","topic-synthesis"],"portContracts":["core"],"skills":["topic-template"]},"authority":{"mutation":{"allowCreate":true,"allowUpdate":true,"allowDelete":true,"appendOnly":false},"actors":{"humans":true,"agents":true,"tools":true}},"settings":{"layout":{"mode":"manual"}},"declaration":{"kind":"graph","targetMode":"artifact","interfaceContract":{"version":1,"implicitRootPort":true},"defaultSurfaceId":"default-view","surfaces":[{"id":"default-view","kind":"view","label":"Detail","viewNodeId":"gp-detail"},{"id":"summary-view","kind":"view","label":"Summary","viewNodeId":"gp-summary"},{"id":"icon-view","kind":"view","label":"Icon","viewNodeId":"gp-icon"},{"id":"glyph","kind":"view","label":"Glyph","viewNodeId":"gp-glyph"},{"id":"landing-surface","kind":"view","label":"Landing","viewNodeId":"gp-land"}]},"document":{"url":"github://mikemartinez1974/public/topics/twilite-graph-primitives/root.node"}}},{"id":"gp-detail","type":"view","label":"Detail","position":{"x":-1700,"y":-520},"width":650,"height":320,"ports":[{"id":"root","label":"root","direction":"bidirectional","dataType":"any","angle":210}],"handles":[{"id":"root","portId":"root","label":"root","direction":"bidirectional","dataType":"any","angle":270}],"visible":true,"showLabel":true,"data":{"identity":{"graphId":"twilite-graph-primitives"},"content":{"kind":"markdown","value":"# Twilite Graph Primitives\n\nTwilite's graph-native vocabulary is deliberately small: **Declaration, Port, View, Content, Glyph, Portal, Bridge.** Each owns a distinct job. Relationships compose those jobs into interfaces, presentation, navigation, and authority."}}},{"id":"gp-summary","type":"view","label":"Summary","position":{"x":-1700,"y":-900},"width":520,"height":220,"ports":[{"id":"root","label":"root","direction":"bidirectional","dataType":"any","angle":210}],"handles":[{"id":"root","portId":"root","label":"root","direction":"bidirectional","dataType":"any","angle":0}],"visible":true,"showLabel":true,"data":{"identity":{"graphId":"twilite-graph-primitives"},"content":{"kind":"markdown","value":"## Graph primitives\n\n**Declaration · Port · View · Content · Glyph · Portal · Bridge**\n\nSmall roles. Explicit relationships. Composable graphs."}}},{"id":"gp-icon","type":"view","label":"Icon","position":{"x":-1450,"y":-1320},"width":320,"height":220,"ports":[{"id":"root","label":"root","direction":"bidirectional","dataType":"any","angle":210}],"handles":[{"id":"root","portId":"root","label":"root","direction":"bidirectional","dataType":"any","angle":90}],"visible":true,"showLabel":true,"data":{"identity":{"graphId":"twilite-graph-primitives"},"content":{"kind":"svg","value":"<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 320 220' role='img' aria-label='Graph primitives'><rect width='320' height='220' rx='28' fill='#0f172a'/><circle cx='160' cy='110' r='30' fill='#60a5fa'/><circle cx='80' cy='60' r='14' fill='#34d399'/><circle cx='160' cy='45' r='14' fill='#f59e0b'/><circle cx='240' cy='60' r='14' fill='#a78bfa'/><circle cx='80' cy='160' r='14' fill='#fb7185'/><circle cx='160' cy='175' r='14' fill='#22d3ee'/><circle cx='240' cy='160' r='14' fill='#facc15'/><path d='M96 70L135 95M160 62V80M224 70L185 95M96 150L135 125M160 158V140M224 150L185 125' stroke='#e2e8f0' stroke-width='5'/><text x='160' y='115' text-anchor='middle' fill='#0f172a' font-family='system-ui' font-size='12' font-weight='900'>PRIMITIVES</text></svg>"}}},{"id":"gp-glyph","type":"glyph","label":"Primitives Glyph","position":{"x":-780,"y":-1320},"width":180,"height":150,"ports":[{"id":"root","label":"root","direction":"bidirectional","dataType":"any","angle":210}],"handles":[{"id":"root","portId":"root","label":"root","direction":"bidirectional","dataType":"any","angle":90}],"visible":true,"showLabel":true,"data":{"identity":{"graphId":"twilite-graph-primitives"},"glyph":{"kind":"icon","name":"Hub"}}},{"id":"gp-land","type":"content","label":"Landing","position":{"x":360,"y":-620},"width":620,"height":240,"ports":[{"id":"root","label":"root","direction":"bidirectional","dataType":"any","angle":210}],"handles":[{"id":"root","portId":"root","label":"root","direction":"bidirectional","dataType":"any","angle":180}],"visible":true,"showLabel":true,"data":{"identity":{"graphId":"twilite-graph-primitives"},"content":{"kind":"markdown","value":"# The vocabulary of a Twilite graph\n\nSeven structural roles stay small and precise. **Relationships do the composition.**"}}},{"id":"gp-topic","type":"topic","label":"Topic","position":{"x":-80,"y":-160},"width":480,"height":300,"ports":[{"id":"root","label":"root","direction":"bidirectional","dataType":"any","angle":180}],"visible":true,"showLabel":false,"data":{"title":"Twilite's Graph Primitives","description":"The core graph-native roles used to build Twilite artifacts and interfaces.","scope":"Declaration, Port, View, Content, Glyph, Portal, Bridge, and the relationship semantics that compose them.","definitionKey":"topic","_classBinding":{"key":"topic","sourceRef":"github://mikemartinez1974/public/templates/topic-template/classes/nodes/topic.node-class.node"},"identity":{"graphId":"twilite-graph-primitives"}}},{"id":"gp-c-decl","type":"topic-concept","label":"Concept","position":{"x":-1000,"y":220},"width":440,"height":280,"ports":[{"id":"root","label":"root","direction":"bidirectional","dataType":"any","angle":180}],"visible":true,"showLabel":false,"data":{"title":"Declaration","definition":"The graph-backed artifact's identity and implicit root interface.","notes":"Owns identity, intent, authority, dependencies, and primary surface relationships.","definitionKey":"topic-concept","_classBinding":{"key":"topic-concept","sourceRef":"github://mikemartinez1974/public/templates/topic-template/classes/nodes/topic-concept.node-class.node"},"identity":{"graphId":"twilite-graph-primitives"}}},{"id":"gp-c-port","type":"topic-concept","label":"Concept","position":{"x":-500,"y":220},"width":440,"height":280,"ports":[{"id":"root","label":"root","direction":"bidirectional","dataType":"any","angle":180}],"visible":true,"showLabel":false,"data":{"title":"Port","definition":"An additional named semantic endpoint.","notes":"Exposes an interface; may point to Views and carry behavior, but does not own inline presentation.","definitionKey":"topic-concept","_classBinding":{"key":"topic-concept","sourceRef":"github://mikemartinez1974/public/templates/topic-template/classes/nodes/topic-concept.node-class.node"},"identity":{"graphId":"twilite-graph-primitives"}}},{"id":"gp-c-view","type":"topic-concept","label":"Concept","position":{"x":0,"y":220},"width":440,"height":280,"ports":[{"id":"root","label":"root","direction":"bidirectional","dataType":"any","angle":180}],"visible":true,"showLabel":false,"data":{"title":"View","definition":"A renderable surface.","notes":"Its semantic role comes from its relationship, not from a label or duplicated level field.","definitionKey":"topic-concept","_classBinding":{"key":"topic-concept","sourceRef":"github://mikemartinez1974/public/templates/topic-template/classes/nodes/topic-concept.node-class.node"},"identity":{"graphId":"twilite-graph-primitives"}}},{"id":"gp-c-content","type":"topic-concept","label":"Concept","position":{"x":500,"y":220},"width":440,"height":280,"ports":[{"id":"root","label":"root","direction":"bidirectional","dataType":"any","angle":180}],"visible":true,"showLabel":false,"data":{"title":"Content","definition":"Durable material rendered by a View.","notes":"Owns data.content.kind and data.content.value for markdown, HTML, SVG, text, JSON, images, and more.","definitionKey":"topic-concept","_classBinding":{"key":"topic-concept","sourceRef":"github://mikemartinez1974/public/templates/topic-template/classes/nodes/topic-concept.node-class.node"},"identity":{"graphId":"twilite-graph-primitives"}}},{"id":"gp-c-glyph","type":"topic-concept","label":"Concept","position":{"x":-750,"y":560},"width":440,"height":280,"ports":[{"id":"root","label":"root","direction":"bidirectional","dataType":"any","angle":180}],"visible":true,"showLabel":false,"data":{"title":"Glyph","definition":"Symbolic identity independent of an icon View.","notes":"Provides the smallest identity representation without becoming the rendered surface itself.","definitionKey":"topic-concept","_classBinding":{"key":"topic-concept","sourceRef":"github://mikemartinez1974/public/templates/topic-template/classes/nodes/topic-concept.node-class.node"},"identity":{"graphId":"twilite-graph-primitives"}}},{"id":"gp-c-portal","type":"topic-concept","label":"Concept","position":{"x":-250,"y":560},"width":440,"height":280,"ports":[{"id":"root","label":"root","direction":"bidirectional","dataType":"any","angle":180}],"visible":true,"showLabel":false,"data":{"title":"Portal","definition":"A consumer or opening node for an exposed interface.","notes":"Navigates or expands into another graph surface; it is not the remote View or Port.","definitionKey":"topic-concept","_classBinding":{"key":"topic-concept","sourceRef":"github://mikemartinez1974/public/templates/topic-template/classes/nodes/topic-concept.node-class.node"},"identity":{"graphId":"twilite-graph-primitives"}}},{"id":"gp-c-bridge","type":"topic-concept","label":"Concept","position":{"x":250,"y":560},"width":440,"height":280,"ports":[{"id":"root","label":"root","direction":"bidirectional","dataType":"any","angle":180}],"visible":true,"showLabel":false,"data":{"title":"Bridge","definition":"An explicit import, export, or authority boundary.","notes":"Makes cross-graph participation and external class authority visible.","definitionKey":"topic-concept","_classBinding":{"key":"topic-concept","sourceRef":"github://mikemartinez1974/public/templates/topic-template/classes/nodes/topic-concept.node-class.node"},"identity":{"graphId":"twilite-graph-primitives"}}},{"id":"gp-claim","type":"topic-claim","label":"Claim","position":{"x":800,"y":560},"width":480,"height":300,"ports":[{"id":"root","label":"root","direction":"bidirectional","dataType":"any","angle":180}],"visible":true,"showLabel":false,"data":{"title":"Semantic role lives in relationships","claim":"A View becomes default, summary, or icon because of its authored relationship to a Declaration or Port. The primitives stay small because edges carry composition semantics.","confidence":"high","definitionKey":"topic-claim","_classBinding":{"key":"topic-claim","sourceRef":"github://mikemartinez1974/public/templates/topic-template/classes/nodes/topic-claim.node-class.node"},"identity":{"graphId":"twilite-graph-primitives"}}},{"id":"gp-mech","type":"topic-mechanism","label":"Mechanism","position":{"x":-420,"y":940},"width":540,"height":320,"ports":[{"id":"root","label":"root","direction":"bidirectional","dataType":"any","angle":180}],"visible":true,"showLabel":false,"data":{"title":"Relationships compose the vocabulary","mechanism":"Roles such as default-view, shared-summary, shared-icon, shared-glyph, exposes-port, landing-surface, and view.content connect narrow primitives into a complete graph-backed interface.","conditions":"Endpoints must be explicit; required singular relationships stay singular; named Ports are authored rather than inferred.","definitionKey":"topic-mechanism","_classBinding":{"key":"topic-mechanism","sourceRef":"github://mikemartinez1974/public/templates/topic-template/classes/nodes/topic-mechanism.node-class.node"},"identity":{"graphId":"twilite-graph-primitives"}}},{"id":"gp-persp","type":"topic-perspective","label":"Perspective","position":{"x":180,"y":940},"width":540,"height":320,"ports":[{"id":"root","label":"root","direction":"bidirectional","dataType":"any","angle":180}],"visible":true,"showLabel":false,"data":{"title":"Small vocabulary, large compositional space","perspective":"Twilite favors a few orthogonal primitives and pushes specialization into relationships, content kinds, class authority, and graph composition.","distinction":"The graph remains general-purpose instead of becoming a catalog of application-specific node types.","definitionKey":"topic-perspective","_classBinding":{"key":"topic-perspective","sourceRef":"github://mikemartinez1974/public/templates/topic-template/classes/nodes/topic-perspective.node-class.node"},"identity":{"graphId":"twilite-graph-primitives"}}},{"id":"gp-source","type":"topic-source","label":"Source","position":{"x":-420,"y":1320},"width":540,"height":280,"ports":[{"id":"root","label":"root","direction":"bidirectional","dataType":"any","angle":180}],"visible":true,"showLabel":false,"data":{"title":"Graph-Native Node Composition Contract","citation":"github://twilite-zone/public/library/documentation/contracts/nodes/graph-native-node-composition.md","notes":"Current write-new authority for Declaration, Port, View, Content, Glyph, Portal, relationship roles, and interface geometry.","definitionKey":"topic-source","_classBinding":{"key":"topic-source","sourceRef":"github://mikemartinez1974/public/templates/topic-template/classes/nodes/topic-source.node-class.node"},"identity":{"graphId":"twilite-graph-primitives"}}},{"id":"gp-synth","type":"topic-synthesis","label":"Synthesis","position":{"x":180,"y":1320},"width":620,"height":340,"ports":[{"id":"root","label":"root","direction":"bidirectional","dataType":"any","angle":180}],"visible":true,"showLabel":false,"data":{"title":"Primitives stay small; graphs become expressive","summary":"Declarations establish identity and the implicit root interface. Ports expose additional named semantics. Views project renderable surfaces. Content owns durable material. Glyphs carry symbolic identity. Portals consume interfaces. Bridges cross graph and authority boundaries. Relationships assign semantic roles between them, producing rich artifacts without overloading any one primitive.","openQuestions":"As fragments, dynamic ports, scripting, collections, and spatial renderers mature, which capabilities deserve new primitives and which should remain relationships or behaviors?","definitionKey":"topic-synthesis","_classBinding":{"key":"topic-synthesis","sourceRef":"github://mikemartinez1974/public/templates/topic-template/classes/nodes/topic-synthesis.node-class.node"},"identity":{"graphId":"twilite-graph-primitives"}}},{"id":"gp-b-topic","type":"bridge","label":"Topic Class Authority","position":{"x":-1400,"y":-180},"width":340,"height":160,"ports":[{"id":"root","label":"root","direction":"bidirectional","dataType":"any","angle":210}],"visible":true,"showLabel":true,"data":{"identity":{"graphId":"twilite-graph-primitives"},"bridge":{"ref":"github://mikemartinez1974/public/templates/topic-template/classes/nodes/topic.node-class.node","role":"import","resourceKind":"node-class","scope":"focused-graph","grants":["read","create","update"]}}},{"id":"gp-b-topic-concept","type":"bridge","label":"Concept Class Authority","position":{"x":-1400,"y":80},"width":340,"height":160,"ports":[{"id":"root","label":"root","direction":"bidirectional","dataType":"any","angle":210}],"visible":true,"showLabel":true,"data":{"identity":{"graphId":"twilite-graph-primitives"},"bridge":{"ref":"github://mikemartinez1974/public/templates/topic-template/classes/nodes/topic-concept.node-class.node","role":"import","resourceKind":"node-class","scope":"focused-graph","grants":["read","create","update"]}}},{"id":"gp-b-topic-claim","type":"bridge","label":"Claim Class Authority","position":{"x":1350,"y":300},"width":340,"height":160,"ports":[{"id":"root","label":"root","direction":"bidirectional","dataType":"any","angle":210}],"visible":true,"showLabel":true,"data":{"identity":{"graphId":"twilite-graph-primitives"},"bridge":{"ref":"github://mikemartinez1974/public/templates/topic-template/classes/nodes/topic-claim.node-class.node","role":"import","resourceKind":"node-class","scope":"focused-graph","grants":["read","create","update"]}}},{"id":"gp-b-topic-mechanism","type":"bridge","label":"Mechanism Class Authority","position":{"x":1350,"y":600},"width":340,"height":160,"ports":[{"id":"root","label":"root","direction":"bidirectional","dataType":"any","angle":210}],"visible":true,"showLabel":true,"data":{"identity":{"graphId":"twilite-graph-primitives"},"bridge":{"ref":"github://mikemartinez1974/public/templates/topic-template/classes/nodes/topic-mechanism.node-class.node","role":"import","resourceKind":"node-class","scope":"focused-graph","grants":["read","create","update"]}}},{"id":"gp-b-topic-perspective","type":"bridge","label":"Perspective Class Authority","position":{"x":1350,"y":880},"width":340,"height":160,"ports":[{"id":"