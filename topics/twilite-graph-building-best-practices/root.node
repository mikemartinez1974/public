    {
      "id": "twilite-graph-building-best-practices-concept-presentation",
      "type": "topic-concept",
      "label": "Sparse presentation",
      "root": false,
      "position": {
        "x": -1200,
        "y": 320
      },
      "width": 480,
      "height": 380,
      "ports": [
        {
          "id": "root",
          "label": "root",
          "direction": "bidirectional",
          "dataType": "any",
          "angle": 270
        },
        {
          "id": "mechanism",
          "label": "Mechanism",
          "direction": "output",
