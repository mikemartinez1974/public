    {
      "id": "twilite-graph-building-best-practices-synthesis",
      "type": "topic-synthesis",
      "label": "Build outward from the declaration",
      "root": false,
      "position": {
        "x": 600,
        "y": -180
      },
      "width": 480,
      "height": 380,
      "ports": [
        {
          "id": "root",
          "label": "root",
          "direction": "bidirectional",
          "dataType": "any",
          "angle": 180
        }
      ],
      "visible": true,
      "showLabel": false,
      "data": {
        "title": "Build outward from the declaration, and keep everything explicit",
        "summary": "Good Twilite graphs start from a Declaration that says what the artifact is, author only the Views and Content they need, and let explicit relationships through declared ports carry meaning. Reusable meaning gets an edge class, and cross-graph capability is granted by a Bridge, never implied by a type name. Graphs derived from templates keep the template's structure and replace its content. Graphs that change over time keep their identity, migrate only settled rules, and are validated from structure through save and reload.",
        "implications": "These habits keep a graph readable by people and safe for tools and agents to change: a reader can trust what the graph says because nothing is inferred, and an agent can extend it without rewriting it.",
        "openQuestions": "Where does the line fall between a plain edge and an edge class? How will view fitting, camera rollover, and edge lanes be settled, and what will that change for existing graphs? What executable conformance profile will separate valid current graphs from valid legacy ones? How should View roles be normalized so an authored View cannot silently acquire conflicting roles?",
        "documentation": "A synthesis of the current graph. It introduces no conclusion the Claims above do not support.",
        "definitionKey": "topic-synthesis",
        "_classBinding": {
          "key": "topic-synthesis",
          "sourceRef": "github://mikemartinez1974/public/templates/topic-template/classes/nodes/topic-synthesis.node-class.node",
          "defaults": {
            "label": "Synthesis",
            "size": {
              "width": 480,
              "height": 380
            },
            "showLabel": false,
            "data": {
              "title": "Current Synthesis",
              "summary": "",
              "implications": "",
              "openQuestions": "",
              "documentation": ""
            },
            "ports": [
              {
                "id": "root",
                "label": "root",
                "direction": "bidirectional",
                "dataType": "any",
                "angle": 180
              }
            ]
          },
          "nodeDef": {
            "key": "topic-synthesis",
            "ref": "github://mikemartinez1974/public/templates/topic-template/classes/nodes/topic-synthesis.node-class.node",
            "source": "local",
