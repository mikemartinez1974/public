    {
      "id": "twilite-graph-building-best-practices-perspective-templates-vs-sparse",
      "type": "topic-perspective",
      "label": "Templates preserve; new graphs stay sparse",
      "root": false,
      "position": {
        "x": 300,
        "y": 1360
      },
      "width": 480,
      "height": 380,
      "ports": [
        {
          "id": "root",
          "label": "root",
          "direction": "bidirectional",
          "dataType": "any",
          "angle": 180
        }
      ],
      "visible": true,
      "showLabel": false,
      "data": {
        "title": "Templates preserve; new graphs stay sparse",
        "perspective": "A derived graph inherits a template's full structure, while a graph written from scratch is meant to author only what it needs.",
        "distinction": "Template packages preserve surfaces, bridges, and relationships so a derived graph starts whole. The write-new contract asks for sparse, purposeful structure.",
        "implications": "When deriving, trim only after the real content is in place and each remaining piece is true. When writing from scratch, add a View or relationship when it says something new.",
        "documentation": "An interpretation of how the template instructions and the write-new contract fit together, not a rule stated in either.",
        "definitionKey": "topic-perspective",
        "_classBinding": {
          "key": "topic-perspective",
