    {
      "id": "twilite-graph-building-best-practices-claim-declare-first",
      "type": "topic-claim",
      "label": "Declare first",
      "root": false,
      "position": {
        "x": -1800,
        "y": 840
      },
      "width": 480,
      "height": 380,
      "ports": [
        {
          "id": "root",
          "label": "Concept",
