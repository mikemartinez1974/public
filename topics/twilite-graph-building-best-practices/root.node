    {
      "id": "twilite-graph-building-best-practices-claim-authority-is-a-bridge",
      "type": "topic-claim",
      "label": "Authority is a Bridge",
      "root": false,
      "position": {
        "x": 600,
        "y": 840
      },
      "width": 480,
      "height": 380,
      "ports": [
        {
          "id": "root",
          "label": "Concept",
          "direction": "bidirectional",
          "dataType": "any",
          "angle": 180
        },
        {
          "id": "perspective",
