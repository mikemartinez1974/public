    {
      "id": "twilite-graph-building-best-practices-topic",
      "type": "topic",
      "label": "Best Practices for Twilite Graph Building",
      "root": false,
      "position": {
        "x": 0,
        "y": -180
      },
      "width": 480,
      "height": 380,
      "ports": [
        {
          "id": "root",
