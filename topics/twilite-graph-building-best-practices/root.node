    {
      "id": "twilite-graph-building-best-practices-concept-identity",
      "type": "topic-concept",
      "label": "Declaration-first identity",
      "root": false,
      "position": {
        "x": -1800,
        "y": 320
      },
      "width": 480,
      "height": 380,
      "ports": [
        {
          "id": "root",
          "label": "root",
          "direction": "bidirectional",
