    {
      "id": "twilite-graph-building-best-practices-mechanism-derivation",
      "type": "topic-mechanism",
      "label": "How derivation preserves structure",
      "root": false,
      "position": {
        "x": 1500,
        "y": 1360
      },
      "width": 480,
      "height": 380,
      "ports": [
        {
          "id": "root",
          "label": "root",
          "direction": "bidirectional",
          "dataType": "any",
          "angle": 180
        }
      ],
      "visible": true,
      "showLabel": false,
      "data": {
        "title": "How derivation preserves structure",
        "mechanism": "Deriving a graph copies the template's root structure and then changes only what belongs to the new graph: its identities, its content, and the truth of its relationships.",
        "conditions": "The template and its adjacent node classes are used as one versioned package, and the new graph has a real subject to replace the starter content.",
        "steps": "1. Copy the template root structurally.\n2. Retarget graph, declaration, View, landing, Glyph, GitHub, content, and bridge identities.\n3. Preserve the bridges and class bindings on typed nodes.\n4. Replace starter content with the real subject.\n5. Keep, retarget, or remove every starter relationship so each remaining one is true.\n6. Validate JSON, surfaces, bridge refs, class bindings, edge endpoints, handles, and edge-class refs.",
        "failureModes": "Starter content or relationships left in place assert things nobody authored. Identities left unretargeted leave nodes owned by the template's graph id.",
        "documentation": "Based on the idea template's derivation steps and the topic template's package and validation rules.",
        "definitionKey": "topic-mechanism",
        "_classBinding": {
          "key": "topic-mechanism",
          "sourceRef": "github://mikemartinez1974/public/templates/topic-template/classes/nodes/topic-mechanism.node-class.node",
