    {
      "id": "twilite-graph-building-best-practices-concept-composition",
      "type": "topic-concept",
      "label": "Cross-graph composition",
      "root": false,
      "position": {
        "x": 600,
        "y": 320
      },
      "width": 480,
      "height": 380,
      "ports": [
        {
          "id": "root",
          "label": "root",
          "direction": "bidirectional",
          "dataType": "any",
