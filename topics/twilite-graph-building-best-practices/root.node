    {
      "id": "twilite-graph-building-best-practices-claim-migrate-deliberately",
      "type": "topic-claim",
      "label": "Migrate deliberately",
      "root": false,
      "position": {
        "x": 1800,
        "y": 840
      },
      "width": 480,
      "height": 380,
      "ports": [
        {
