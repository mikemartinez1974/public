    {
      "id": "twilite-graph-building-best-practices-mechanism-safe-rewrite",
      "type": "topic-mechanism",
      "label": "How a safe rewrite proceeds",
      "root": false,
      "position": {
        "x": 2100,
        "y": 1360
      },
      "width": 480,
      "height": 380,
      "ports": [
        {
          "id": "root",
          "label": "root",
          "direction": "bidirectional",
          "dataType": "any",
          "angle": 180
        }
      ],
      "visible": true,
      "showLabel": false,
      "data": {
        "title": "How a safe rewrite proceeds",
        "mechanism": "A rewrite treats a graph as a set of identified parts, changes only the parts governed by settled rules, and proves the result by exercising it.",
        "conditions": "The rule being migrated is marked settled. Rewrites that depend on provisional contracts are deferred.",
        "steps": "1. Preserve `graphId`, `nodeId`, durable address, and semantic type.\n2. Identify the Declaration, implicit root, landing surface, Views, Glyph, exposed Ports, Portals, Bridges, and typed edges.\n3. Separate graph extent from presentation geometry.\n4. Migrate only rules marked settled.\n5. Defer render-size and lane rewrites until their contracts are ratified.\n6. Validate save and reload, navigation, semantic zoom, and edge endpoint integrity.",
        "failureModes": "Normalizing by shape can change meaning, and rewriting source node positions to make a preview fit changes the graph to fix its presentation.",
        "documentation": "Based on the rewrite rule in the model inventory.",
        "definitionKey": "topic-mechanism",
        "_classBinding": {
          "key": "topic-mechanism",
          "sourceRef": "github://mikemartinez1974/public/templates/topic-template/classes/nodes/topic-mechanism.node-class.node",
