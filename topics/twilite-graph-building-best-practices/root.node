    {
      "id": "twilite-graph-building-best-practices-claim-sparse-views",
      "type": "topic-claim",
      "label": "Author the Views you need",
      "root": false,
      "position": {
        "x": -1200,
        "y": 840
      },
      "width": 480,
      "height": 380,
      "ports": [
        {
          "id": "root",
          "label": "Concept",
          "direction": "bidirectional",
          "dataType": "any",
          "angle": 180
        },
        {
          "id": "perspective",
          "label": "Perspective",
          "direction": "bidirectional",
          "dataType": "any",
          "angle": 0
        },
        {
          "id": "source",
          "label": "Source",
          "direction": "bidirectional",
          "dataType": "any",
          "angle": 90
        }
      ],
      "visible": true,
      "showLabel": false,
      "data": {
        "title": "Author the Views a graph needs, not every band",
        "claim": "A graph should author the Views and Content it needs and let Twilite resolve the rest, reusing one View across roles when it does the job.",
        "rationale": "Semantic zoom selects among the Views that exist. A missing band uses the nearest authored View, and a graph with no usable View falls back to its Minimap and then its Glyph, so extra Views that repeat the same content add nothing to resolve and must all be kept true.",
        "evidence": "The composition contract says the semantic View collection may be sparse, that one View may serve several roles, and that Summary, Icon, and Glyph representations are added when they convey useful additional information. The model inventory adds that Detail, Summary, and Icon are useful roles, not a requirement to author three separate View nodes.",
        "caveats": "Templates ship each View role, and a derived graph keeps them until the author decides they are redundant.",
        "documentation": "See the Sparse presentation concept and the How sparse Views resolve mechanism.",
        "confidence": "high",
        "definitionKey": "topic-claim",
