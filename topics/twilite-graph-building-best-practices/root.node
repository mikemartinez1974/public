    {
      "id": "twilite-graph-building-best-practices-concept-relationships",
      "type": "topic-concept",
      "label": "Relationships and ports",
      "root": false,
      "position": {
        "x": -600,
        "y": 320
      },
      "width": 480,
      "height": 380,
      "ports": [
        {
          "id": "root",
          "label": "root",
          "direction": "bidirectional",
          "dataType": "any",
          "angle": 270
        },
        {
          "id": "mechanism",
