    {
      "id": "twilite-graph-building-best-practices-claim-edge-classes",
      "type": "topic-claim",
      "label": "Edge classes for reusable meaning",
      "root": false,
      "position": {
        "x": 0,
        "y": 840
      },
      "width": 480,
      "height": 380,
      "ports": [
        {
          "id": "root",
          "label": "Concept",
          "direction": "bidirectional",
          "dataType": "any",
          "angle": 180
        },
        {
          "id": "perspective",
          "label": "Perspective",
          "direction": "bidirectional",
          "dataType": "any",
          "angle": 0
        },
        {
          "id": "source",
          "label": "Source",
          "direction": "bidirectional",
          "dataType": "any",
          "angle": 90
        }
      ],
      "visible": true,
      "showLabel": false,
      "data": {
        "title": "Give reusable relationship meaning an edge class; keep one-off links plain",
        "claim": "When a relationship's meaning should be reusable across graphs, classify the edge with an edge class. A one-off link can stay a plain edge.",
        "rationale": "A class states the relationship's meaning, default edge type, and rendering defaults in one place, so every edge that uses it means the same thing. A precise class also preserves direction, such as evidence supporting an assumption, which a generic reference edge loses.",
        "evidence": "The edge contract says plain edges remain valid without classes and that edge classes are the canonical semantic upgrade path, with `data.edgeClassRef` as the authority and a matching `edgeClassKey`. The idea template says not to add a generic relationship when a more precise class applies.",
        "caveats": "A class adds a dependency: an `edgeClassRef` that points at a missing artifact, or a key that disagrees with the referenced class, is invalid.",
        "documentation": "See the Relationships and ports concept.",
