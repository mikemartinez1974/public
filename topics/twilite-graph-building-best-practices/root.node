    {
      "id": "twilite-graph-building-best-practices-claim-relationships-carry-meaning",
      "type": "topic-claim",
      "label": "Meaning lives in relationships",
      "root": false,
      "position": {
        "x": -600,
        "y": 840
      },
      "width": 480,
      "height": 380,
      "ports": [
        {
          "id": "root",
          "label": "Concept",
          "direction": "bidirectional",
          "dataType": "any",
          "angle": 180
        },
        {
          "id": "perspective",
          "label": "Perspective",
          "direction": "bidirectional",
          "dataType": "any",
          "angle": 0
        },
        {
          "id": "source",
          "label": "Source",
          "direction": "bidirectional",
          "dataType": "any",
          "angle": 90
        }
      ],
      "visible": true,
      "showLabel": false,
      "data": {
        "title": "Meaning belongs to relationships through declared ports, not to labels or positions",
        "claim": "Assign meaning with explicit relationships between declared ports. Do not infer a node's role from its label, and never invent a port.",
        "rationale": "A relationship is what tools, agents, and other graphs can read without guessing. A label can change wording without changing meaning, and a port that is not declared has no contract to enforce.",
        "evidence": "The composition contract says not to infer a View's semantic role from its label. The edge contract says a label is human-readable, not semantic logic, and forbids edges that reference missing nodes, reuse an id, or invent ports; omitted ports mean `root`. The port contract says tools and agents may not guess or invent port behavior.",
        "caveats": "Class definitions and payloads still carry typed contracts. The rule targets inference from labels and geometry, not the idea that edges hold everything.",
        "documentation": "See the Relationships and ports concept.",
        "confidence": "high",
        "definitionKey": "topic-claim",
