    {
      "id": "twilite-graph-building-best-practices-concept-derivation",
      "type": "topic-concept",
      "label": "Deriving from templates",
      "root": false,
      "position": {
        "x": 1200,
        "y": 320
      },
      "width": 480,
      "height": 380,
      "ports": [
        {
          "id": "root",
