    {
      "id": "twilite-graph-building-best-practices-claim-derive-structure",
      "type": "topic-claim",
      "label": "Derive by preserving structure",
      "root": false,
      "position": {
        "x": 1200,
        "y": 840
      },
      "width": 480,
      "height": 380,
      "ports": [
        {
          "id": "root",
          "label": "Concept",
          "direction": "bidirectional",
          "dataType": "any",
          "angle": 180
        },
        {
          "id": "perspective",
