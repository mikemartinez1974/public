    {
      "id": "twilite-graph-building-best-practices-mechanism-view-resolution",
      "type": "topic-mechanism",
      "label": "How sparse Views resolve",
      "root": false,
      "position": {
        "x": -900,
        "y": 1360
      },
      "width": 480,
      "height": 380,
      "ports": [
        {
          "id": "root",
          "label": "root",
          "direction": "bidirectional",
          "dataType": "any",
          "angle": 180
        }
      ],
      "visible": true,
      "showLabel": false,
      "data": {
        "title": "How sparse Views resolve",
        "mechanism": "The Declaration's relationships name the Views a graph exposes. When Twilite needs a representation, it selects among the Views the graph authored, uses the nearest authored View for a band that has none, and falls back to the graph's Minimap and then its Glyph when no authored View is usable.",
        "conditions": "The Declaration supplies a default View and a landing surface. Summary, Icon, and Glyph relationships are optional, and each View owns Content or delegates to a Content node.",
        "steps": "1. The Declaration relates to its Views.\n2. A representation is needed at some zoom level or size.\n3. The authored View for that role is used if one exists.\n4. Otherwise the nearest authored View is used.\n5. If no authored View is usable, the Minimap is shown, then the Glyph at the smallest size.",
        "failureModes": "A View that repeats another's content has to be kept truthful when either changes. A landing frame that is too small hides material from the unfocused node and its Minimap View.",
        "documentation": "Based on the composition contract and the model inventory.",
        "definitionKey": "topic-mechanism",
        "_classBinding": {
          "key": "topic-mechanism",
          "sourceRef": "github://mikemartinez1974/public/templates/topic-template/classes/nodes/topic-mechanism.node-class.node",
