    {
      "id": "osim-topic",
      "type": "topic",
      "label": "Topic",
      "position": {
        "x": -120,
        "y": -180
      },
      "width": 480,
      "height": 340,
      "ports": [
        {
          "id": "root",
          "label": "root",
