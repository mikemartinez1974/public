    {
      "id": "twilite-automation-readiness-concept",
      "type": "topic-concept",
      "label": "Client-Side Execution Is Real",
      "root": false,
      "position": {
        "x": -1800,
        "y": 320
      },
      "width": 400,
      "height": 280,
      "ports": [
        {
          "id": "root",
          "label": "root",
