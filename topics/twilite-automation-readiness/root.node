              "intent": "editor",
              "payload": "editor.web",
              "ref": "github://mikemartinez1974/public/templates/topic-template/classes/nodes/topic-synthesis.node-class.node",
              "source": "local",
              "version": ">=0.2.0",
              "defaultPorts": []
