{"fileVersion":"1.0","metadata":{"title":"How the model stays coherent","description":"An identity-preserving fragment that expands the Twilite graph model's coherence mechanism.","graphId":"twilite-graph-model-mechanism-fragment","version":"1.0.0","kind":"graph-fragment","created":"2026-09-17T16:35:00.000Z","modified":"2026-09-17T16:35:00.000Z","author":"","tags":["twilite","graph-model","fragment","coherence","topic"],"preferredViewer":"https://twilite.zone"},"nodes":[{"id":"twilite-graph-model-mechanism-fragment-declaration","type":"declaration","label":"How the model stays coherent Fragment","position":{"x":-900,"y":-900},"width":400,"height":260,"ports":[{"id":"root","label":"root","direction":"bidirectional","dataType":"any","angle":180}],"handles":[{"id":"root","label":"root","direction":"bidirectional","dataType":"any","angle":180,"portId":"root"}],"visible":true,"showLabel":true,"data":{"identity":{"graphId":"twilite-graph-model-mechanism-fragment","nodeId":"twilite-graph-model-mechanism","name":"How the model stays coherent","version":"1.0.0"},"intent":{"kind":"fragment","scope":"shared"},"dependencies":{"nodeTypes":["declaration","bridge","topic-mechanism","topic-concept","topic-claim","topic-perspective","topic-source","topic-synthesis"],"portContracts":["core"],"skills":["topic-template"]},"document":{"url":"github://mikemartinez1974/public/topics/twilite-graph-model/how-model-stays-coherent.node"},"declaration":{"kind":"graph","targetMode":"artifact","artifactKind":"fragment","defaultSurfaceId":"root","interfaceContract":{"version":1,"implicitRootPort":true},"surfaces":[{"id":"root","kind":"node","label":"How the model stays coherent","viewNodeId":"twilite-graph-model-mechanism"}]},"authority":{"mutation":{"allowCreate":true,"allowUpdate":true,"allowDelete":true,"appendOnly":false},"actors":{"humans":true,"agents":true,"tools":true}},"settings":{"expansion":{"allowGraphEntry":true},"layout":{"mode":"manual","direction":"DOWN"}},"agentGuidanceRef":"/agent-guidance/fragment-authoring.md"}},{"id":"twilite-graph-model-mechanism-return-to-host","type":"bridge","label":"Return to host","position":{"x":-420,"y":-900},"width":320,"height":160,"ports":[{"id":"root","label":"root","direction":"bidirectional","dataType":"any","angle":180}],"handles":[{"id":"root","label":"root","direction":"bidirectional","dataType":"any","angle":180,"portId":"root"}],"visible":true,"showLabel":true,"data":{"identity":{"graphId":"twilite-graph-model-mechanism-fragment","nodeId":"twilite-graph-model-mechanism"},"target":{"mode":"expand","kind":"graph","ref":"github://mikemartinez1974/public/topics/twilite-graph-model/root.node","nodeId":"twilite-graph-model-mechanism","graphId":"twilite-graph-model"},"bridge":{"ref":"github://mikemartinez1974/public/topics/twilite-graph-model/root.node","kind":"graph","nodeId":"twilite-graph-model-mechanism","graphId":"twilite-graph-model"},"authority":"bridge","extraction":{"role":"fragment-return","createdAt":"2026-09-17T16:35:00.000Z","hostRef":"github://mikemartinez1974/public/topics/twilite-graph-model/root.node"},"agentGuidanceRef":"/agent-guidance/fragment-authoring.md"}},{"id":"twilite-graph-model-mechanism","type":"topic-mechanism","label":"Mechanism","position":{"x":0,"y":-420},"width":520,"height":340,"ports":[{"id":"root","label":"root","direction":"bidirectional","dataType":"any","angle":180}],"visible":true,"showLabel":false,"data":{"title":"How the model stays coherent","mechanism":"Twilite keeps coherence by making different jobs explicit and composable: declarations anchor identity, ports carry semantics, handles carry geometry, views project presentation, portals preserve graph boundaries, bridges declare authority, and fragments preserve semantic identity across storage boundaries.","conditions":"Each layer must keep its contract. Identity must remain stable, ports must not be inferred from geometry, provider addresses must be preserved, external classes require explicit authority, and fragment contributions must close reciprocally.","definitionKey":"topic-mechanism","_classBinding":{"key":"topic-mechanism","sourceRef":"github://mikemartinez1974/public/templates/topic-template/classes/nodes/topic-mechanism.node-class.node"},"identity":{"graphId":"twilite-graph-model-mechanism-fragment","nodeId":"twilite-graph-model-mechanism"},"extraction":{"role":"fragment-authority","createdAt":"2026-09-17T16:35:00.000Z","hostRef":"github://mikemartinez1974/public/topics/twilite-graph-model/root.node"}}},{"id":"coherence-concept-identity","type":"topic-concept","label":"Concept","position":{"x":-1100,"y":100},"width":460,"height":300,"ports":[{"id":"root","label":"root","direction":"bidirectional","dataType":"any","angle":180}],"visible":true,"showLabel":false,"data":{"title":"Stable identity","definition":"A declaration gives the graph a durable identity, intent, authority model, dependencies, and exposed surfaces.","notes":"Renderers may change; the declared object remains addressable and interpretable.","definitionKey":"topic-concept","_classBinding":{"key":"topic-concept","sourceRef":"github://mikemartinez1974/public/templates/topic-template/classes/nodes/topic-concept.node-class.node"},"identity":{"graphId":"twilite-graph-model-mechanism-fragment"}}},{"id":"coherence-concept-interfaces","type":"topic-concept","label":"Concept","position":{"x":-560,"y":100},"width":460,"height":300,"ports":[{"id":"root","label":"root","direction":"bidirectional","dataType":"any","angle":180}],"visible":true,"showLabel":false,"data":{"title":"Semantic interfaces","definition":"Ports describe what can connect and what the connection means. Handles describe where that endpoint appears.","notes":"Semantic meaning does not move when a handle moves.","definitionKey":"topic-concept","_classBinding":{"key":"topic-concept","sourceRef":"github://mikemartinez1974/public/templates/topic-template/classes/nodes/topic-concept.node-class.node"},"identity":{"graphId":"twilite-graph-model-mechanism-fragment"}}},{"id":"coherence-concept-presentation","type":"topic-concept","label":"Concept","position":{"x":-20,"y":100},"width":460,"height":300,"ports":[{"id":"root","label":"root","direction":"bidirectional","dataType":"any","angle":180}],"visible":true,"showLabel":false,"data":{"title":"Presentation is projected","definition":"Views, content, and glyphs are separate presentation roles rather than the semantic object itself.","notes":"One graph can support detail, summary, icon, editor, 2D, and future spatial projections without becoming different objects.","definitionKey":"topic-concept","_classBinding":{"key":"topic-concept","sourceRef":"github://mikemartinez1974/public/templates/topic-template/classes/nodes/topic-concept.node-class.node"},"identity":{"graphId":"twilite-graph-model-mechanism-fragment"}}},{"id":"coherence-concept-boundaries","type":"topic-concept","label":"Concept","position":{"x":-1100,"y":460},"width":460,"height":300,"ports":[{"id":"root","label":"root","direction":"bidirectional","dataType":"any","angle":180}],"visible":true,"showLabel":false,"data":{"title":"Explicit graph boundaries","definition":"Portals and durable addresses compose graphs without flattening them into one file.","notes":"A remote graph remains independently addressable while still participating in a larger workspace.","definitionKey":"topic-concept","_classBinding":{"key":"topic-concept","sourceRef":"github://mikemartinez1974/public/templates/topic-template/classes/nodes/topic-concept.node-class.node"},"identity":{"graphId":"twilite-graph-model-mechanism-fragment"}}},{"id":"coherence-concept-authority","type":"topic-concept","label":"Concept","position":{"x":-560,"y":460},"width":460,"height":300,"ports":[{"id":"root","label":"root","direction":"bidirectional","dataType":"any","angle":180}],"visible":true,"showLabel":false,"data":{"title":"Authority is declared","definition":"Bridges and class bindings make external behavior and node-class authority explicit.","notes":"A type string alone does not silently grant executable behavior.","definitionKey":"topic-concept","_classBinding":{"key":"topic-concept","sourceRef":"github://mikemartinez1974/public/templates/topic-template/classes/nodes/topic-concept.node-class.node"},"identity":{"graphId":"twilite-graph-model-mechanism-fragment"}}},{"id":"coherence-concept-fragments","type":"topic-concept","label":"Concept","position":{"x":-20,"y":460},"width":460,"height":300,"ports":[{"id":"root","label":"root","direction":"bidirectional","dataType":"any","angle":180}],"visible":true,"showLabel":false,"data":{"title":"Fragments preserve identity","definition":"A semantic node can contribute across multiple graph files while retaining one nodeId.","notes":"Storage and contribution boundaries can change without manufacturing a second semantic object.","definitionKey":"topic-concept","_classBinding":{"key":"topic-concept","sourceRef":"github://mikemartinez1974/public/templates/topic-template/classes/nodes/topic-concept.node-class.node"},"identity":{"graphId":"twilite-graph-model-mechanism-fragment"}}},{"id":"coherence-claim-meaning-survives","type":"topic-claim","label":"Claim","position":{"x":620,"y":100},"width":460,"height":300,"ports":[{"id":"root","label":"root","direction":"bidirectional","dataType":"any","angle":180}],"visible":true,"showLabel":false,"data":{"title":"Meaning survives presentation changes","claim":"If semantic identity, ports, relationships, and authority remain explicit, the same graph can be rendered or edited in radically different ways without changing what the graph means.","confidence":"high","definitionKey":"topic-claim","_classBinding":{"key":"topic-claim","sourceRef":"github://mikemartinez1974/public/templates/topic-template/classes/nodes/topic-claim.node-class.node"},"identity":{"graphId":"twilite-graph-model-mechanism-fragment"}}},{"id":"coherence-claim-composition","type":"topic-claim","label":"Claim","position":{"x":620,"y":460},"width":460,"height":300,"ports":[{"id":"root","label":"root","direction":"bidirectional","dataType":"any","angle":180}],"visible":true,"showLabel":false,"data":{"title":"Composition does not require flattening","claim":"Twilite can assemble larger experiences from multiple graphs because addresses, portals, bridges, and fragment closure preserve boundaries while still allowing traversal and shared semantic identity.","confidence":"high","definitionKey":"topic-claim","_classBinding":{"key":"topic-claim","sourceRef":"github://mikemartinez1974/public/templates/topic-template/classes/nodes/topic-claim.node-class.node"},"identity":{"graphId":"twilite-graph-model-mechanism-fragment"}}},{"id":"coherence-mechanism-separation","type":"topic-mechanism","label":"Mechanism","position":{"x":-540,"y":860},"width":500,"height":320,"ports":[{"id":"root","label":"root","direction":"bidirectional","dataType":"any","angle":180}],"visible":true,"showLabel":false,"data":{"title":"Separation prevents accidental coupling","mechanism":"Identity, connection semantics, geometry, presentation, navigation, and authority are modeled as different contracts. A change in one layer therefore does not automatically rewrite the others.","conditions":"The runtime and authored graphs must respect those ownership boundaries.","definitionKey":"topic-mechanism","_classBinding":{"key":"topic-mechanism","sourceRef":"github://mikemartinez1974/public/templates/topic-template/classes/nodes/topic-mechanism.node-class.node"},"identity":{"graphId":"twilite-graph-model-mechanism-fragment"}}},{"id":"coherence-mechanism-closure","type":"topic-mechanism","label":"Mechanism","position":{"x":20,"y":860},"width":500,"height":320,"ports":[{"id":"root","label":"root","direction":"bidirectional","dataType":"any","angle":180}],"visible":true,"showLabel":false,"data":{"title":"Reciprocal closure reassembles fragments","mechanism":"When a semantic node spans graph files, each contribution points to the other and shares the same nodeId. The loader resolves the reciprocal closure before treating the node as complete.","conditions":"Both bridge halves must be authored atomically and the semantic nodeId must remain stable.","definitionKey":"topic-mechanism","_classBinding":{"key":"topic-mechanism","sourceRef":"github://mikemartinez1974/public/templates/topic-template/classes/nodes/topic-mechanism.node-class.node"},"identity":{"graphId":"twilite-graph-model-mechanism-fragment"}}},{"id":"coherence-perspective-separations","type":"topic-perspective","label":"Perspective","position":{"x":580,"y":860},"width":500,"height":320,"ports":[{"id":"root","label":"root","direction":"bidirectional","dataType":"any","angle":180}],"visible":true,"showLabel":false,"data":{"title":"Coherence through separation","perspective":"Twilite does not stay coherent by forcing everything into one schema blob. It stays coherent by giving identity, semantics, presentation, navigation, authority, and storage boundaries distinct contracts that agree at explicit interfaces.","distinction":"The center of gravity is the semantic graph, while UI and storage remain projections and contributions.","definitionKey":"topic-perspective","_classBinding":{"key":"topic-perspective","sourceRef":"github://mikemartinez1974/public/templates/topic-template/classes/nodes/topic-perspective.node-class.node"},"identity":{"graphId":"twilite-graph-model-mechanism-fragment"}}},{"id":"coherence-source-onboarding","type":"topic-source","label":"Source","position":{"x":-540,"y":1260},"width":500,"height":280,"ports":[{"id":"root","label":"root","direction":"bidirectional","dataType":"any","angle":180}],"visible":true,"showLabel":false,"data":{"title":"Graph-native composition contract","citation":"https://twilite.zone/library/documentation/contracts/onboarding.md","notes":"Defines primitive ownership, declaration-first composition, provider addresses, ports, views, portals, bridges, and class authority.","definitionKey":"topic-source","_classBinding":{"key":"topic-source","sourceRef":"github://mikemartinez1974/public/templates/topic-template/classes/nodes/topic-source.node-class.node"},"identity":{"graphId":"twilite-graph-model-mechanism-fragment"}}},{"id":"coherence-source-fragments","type":"topic-source","label":"Source","position":{"x":20,"y":1260},"width":500,"height":280,"ports":[{"id":"root","label":"root","direction":"bidirectional","dataType":"any","angle":180}],"visible":true,"showLabel":false,"data":{"title":"Fragment authoring contract","citation":"github://TwiliteLLC/twilite/public/agent-guidance/fragment-authoring.md","notes":"Defines identity-preserving extraction, reciprocal bridge contributions, authoritative ownership, and complete same-node closure.","definitionKey":"topic-source","_classBinding":{"key":"topic-source","sourceRef":"github://mikemartinez1974/public/templates/topic-template/classes/nodes/topic-source.node-class.node"},"identity":{"graphId":"twilite-graph-model-mechanism-fragment"}}},{"id":"coherence-synthesis","type":"topic-synthesis","label":"Synthesis","position":{"x":580,"y":1260},"width":560,"height":340,"ports":[{"id":"root","label":"root","direction":"bidirectional","dataType":"any","angle":180}],"visible":true,"showLabel":false,"data":{"title":"Coherence is agreement between contracts","summary":"Twilite's coherence comes from stable semantic identity plus explicit boundaries between concerns. Declarations say what an artifact is; ports say how it can connect; handles place those semantics; views/content/glyphs project presentation; portals preserve addressable graph boundaries; bridges declare authority; fragments preserve one semantic node across storage boundaries. Because these contracts meet explicitly, the graph can grow into new renderers, workspaces, agents, and dimensions without dissolving into application-specific glue.","openQuestions":"Which additional semantics should become explicit contracts as Twilite expands into dynamic ports, derived instances, 3D/VR spaces, and richer multi-graph composition?","definitionKey":"topic-synthesis","_classBinding":{"key":"topic-synthesis","sourceRef":"github://mikemartinez1974/public/templates/topic-template/classes/nodes/topic-synthesis.node-class.node"},"identity":{"graphId":"twilite-graph-model-mechanism-fragment"}}},{"id":"coherence-bridge-topic-mechanism","type":"bridge","label":"Mechanism Class Authority","position":{"x":-1450,"y":-420},"width":360,"height":180,"ports":[{"id":"root","label":"root","direction":"bidirectional","dataType":"any","angle":210}],"visible":true,"showLabel":true,"data":{"identity":{"graphId":"twilite-graph-model-mechanism-fragment"},"bridge":{"ref":"github://mikemartinez1974/public/templates/topic-template/classes/nodes/topic-mechanism.node-class.node","role":"import","resourceKind":"node-class","scope":"focused-graph","grants":["read","create","update"]}}},{"id":"coherence-bridge-topic-concept","type":"bridge","label":"Concept Class Authority","position":{"x":-1450,"y":-180},"width":360,"height":180,"ports":[{"id":"root","label":"root","direction":"bidirectional","dataType":"any","angle":210}],"visible":true,"showLabel":true,"data":{"identity":{"graphId":"twilite-graph-model-mechanism-fragment"},"bridge":{"ref":"github://mikemartinez1974/public/templates/topic-template/classes/nodes/topic-concept.node-class.node","role":"import","resourceKind":"node-class","scope":"focused-graph","grants":["read","create","update"]}}},{"id":"coherence-bridge-topic-claim","type":"bridge","label":"Claim Class Authority","position":{"x":-1450,"y":60},"width":360,"height":180,"ports":[{"id":"root","label":"root","direction":"bidirectional","dataType":"any","angle":210}],"visible":true,"showLabel":true,"data":{"identity":{"graphId":"twilite-graph-model-mechanism-fragment"},"bridge":{"ref":"github://mikemartinez1974/public/templates/topic-template/classes/nodes/topic-claim.node-class.node","role":"import","resourceKind":"node-class","scope":"focused-graph","grants":["read","create","update"]}}},{"id":"coherence-bridge-topic-perspective","type":"bridge","label":"Perspective Class Authority","position":{"x":1200,"y":60},"width":360,"height":180,"ports":[{"id":"root","label":"root","direction":"bidirectional","dataType":"any","angle":210}],"visible":true,"showLabel":true,"data":{"identity":{"graphId":"twilite-graph-model-mechanism-fragment"},"bridge":{"ref":"github://mikemartinez1974/public/templates/topic-template/classes/nodes/topic-perspective.node-class.node","role":"import","resourceKind":"node-class","scope":"focused-graph","grants":["read","create","update"]}}},{"id":"coherence-bridge-topic-source","type":"bridge","label":"Source Class Authority","position":{"x":1200,"y":300},"width":360,"height":180,"ports":[{"id":"root","label":"root","direction":"bidirectional","dataType":"any","angle":210}],"visible":true,"showLabel":true,"data":{"identity":{"graphId":"twilite-graph-model-mechanism-fragment"},"bridge":{"ref":"github://mikemartinez1974/public/templates/topic-template/classes/nodes/topic-source.node-class.node","role":"import","resourceKind":"node-class","scope":"focused-graph","grants":["read","create","update"]}}},{"id":"coherence-bridge-topic-synthesis","type":"bridge","label":"Synthesis Class Authority","position":{"x":1200,"y":540},"width":360,"height":180,"ports":[{"id":"root","label":"root","direction":"bidirectional","dataType":"any","angle":210}],"visible":true,"showLabel":true,"data":{"identity":{"graphId":"twilite-graph-model-mechanism-fragment"},"bridge":{"ref":"github://mikemartinez1974/public/templates/topic-template/classes/nodes/topic-synthesis.node-class.node","role":"import","resourceKind":"node-class","scope":"focused-graph","grants":["read","create","update"]}}}],"edges":[{"id":"twilite-graph-model-mechanism-to-coherence-concept-identity","type":"reference","source":"twilite-graph-model-mechanism","target":"coherence-concept-identity","sourceHandle":"root","targetHandle":"root","label":"keeps coherent","style":{},"data":{}},{"id":"twilit