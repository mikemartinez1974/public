    {
      "id": "dd91b469-332a-4c5f-b871-2cc314bc89b2",
      "type": "content",
      "label": "Chat GPT Comments",
      "root": false,
      "position": {
        "x": -310.3403842493668,
        "y": -497.2729204076297
      },
      "width": 420,
      "height": 300,
      "ports": [
        {
          "id": "root",
