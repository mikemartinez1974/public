    {
      "id": "twilite-scripting-properties-mechanism",
      "type": "topic-mechanism",
      "label": "How it works",
      "position": {
        "x": 120,
        "y": 220
      },
      "width": 400,
      "height": 280,
      "ports": [
        {
          "id": "root",
          "label": "root",
          "direction": "bidirectional",
          "dataType": "any",
          "angle": 180
        }
      ],
      "visible": true,
      "showLabel": false,
      "data": {
        "title": "How it works",
        "mechanism": "Resolve the first supplied value under an explicit precedence policy, preserving null and source provenance. A write request checks authority and validation, commits a stored value if allowed, then compares the effective value before and after to determine whether a change occurred.",
        "conditions": "Computed evaluation, inheritance order, persistence, and event names remain bounded follow-up contracts; reading a graph must not execute a mutating method.",
        "identity": {
          "graphId": "twilite-scripting-properties"
        },
        "classRef": "github://mikemartinez1974/public/templates/topic-template/classes/nodes/topic-mechanism.node-class.node"
      }
    },
