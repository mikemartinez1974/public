rty; it does not authorize a mutation."},"_placement":{"version":1,"state":"manually-shaped","source":"manual","updatedAt":1788114389974,"reason":"node-drag"}}},{"id":"twilite-scripting-properties-summary-view","type":"view","label":"Topic Template Summary View","root":false,"position":{"x":-1967.6044323504902,"y":-1121.047422526648},"width":520,"height":240,"ports":[{"id":"root","label":"root","direction":"bidirectional","dataType":"any","angle":210}],"handles":[{"id":"root","portId":"root","label":"root","direction":"bidirectional","dataType":"any","angle":0}],"visible":true,"showLabel":true,"data":{"identity":{"graphId":"twilite-scripting-properties"},"content":{"kind":"markdown","value":"## Properties\n\nName state, resolve an effective value with provenance, and distinguish a requested write from an actual change."},"_placement":{"version":1,"state":"manually-shaped","source":"manual","updatedAt":1788114500849,"reason":"node-drag"}}},{"id":"twilite-scripting-properties-icon-view","type":"view","label":"Topic Template Icon View","root":false,"position":{"x":-1644.5763632248054,"y":-1563.0509088165368},"width":360,"height":240,"ports":[{"id":"root","label":"root","direction":"bidirectional","dataType":"any","angle":210}],"handles":[{"id":"root","portId":"root","label":"root","direction":"bidirectional","dataType":"any","angle":90}],"visible":true,"showLabel":true,"data":{"identity":{"graphId":"twilite-scripting-properties"},"content":{"kind":"svg","value":"<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 320 220'><rect width='320' height='220' rx='28' fill='#0f172a'/><circle cx='160' cy='110' r='35' fill='#60a5fa'/><circle cx='72' cy='62' r='18' fill='#34d399'/><circle cx='248' cy='62' r='18' fill='#f59e0b'/><circle cx='72' cy='164' r='18' fill='#a78bfa'/><circle cx='248' cy='164' r='18' fill='#fb7185'/><path d='M91 72 L131 94 M229 72 L189 94 M91 154 L131 126 M229 154 L189 126' stroke='#e2e8f0' stroke-width='6' stroke-linecap='round'/><text x='160' y='116' te