      "data": {
        "title": "Current synthesis",
        "summary": "A property declares named state. Resolution distinguishes absent, explicit null, stored, computed, declared default, and effective value with provenance. Writes are requests; only accepted writes can produce a value-change outcome.",
        "openQuestions": "What is the precedence order among instance, class, template, and graph contributions? How are computed dependencies, errors, and cycles represented? What event contract follows an accepted but unchanged write?",
        "identity": {
          "graphId": "twilite-scripting-properties"
        },
        "classRef": "github://mikemartinez1974/public/templates/topic-template/classes/nodes/topic-synthesis.node-class.node"
