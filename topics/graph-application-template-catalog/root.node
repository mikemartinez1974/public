        "content": {
          "kind": "markdown",
          "value": "# Automation & workflows\n\nApplication → required template types → priority. Priority is a proposed Twilite integration order, not a claim about vendor support."
        }
      }
    },
    {
      "id": "graph-application-template-catalog-item-19",
      "type": "content",
      "label": "n8n",
      "root": false,
      "position": {
        "x": 0,
        "y": 900
      },
      "width": 470,
      "height": 300,
      "ports": [
        {
          "id": "root",
