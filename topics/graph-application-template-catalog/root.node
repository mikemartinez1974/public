          "direction": "bidirectional",
          "dataType": "any",
          "angle": 270
        }
      ],
      "visible": true,
      "showLabel": true,
      "data": {
        "content": {
          "kind": "markdown",
          "value": "## n8n\n\n**Priority:** P1\n\n**Required templates:** Workflow, Trigger, Action, Condition, Transformation, Execution\n\n**Integration goal:** Faithful graph representation first; live data access and execution only with a separate provider."
        }
      }
    },
