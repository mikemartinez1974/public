    {
      "id": "edge-class-page-settings-region",
      "type": "page-region",
      "label": "Settings",
      "root": false,
      "position": {
        "x": -60,
        "y": -180
      },
      "width": 1740,
      "height": 460,
      "ports": [
        {
          "id": "root",
          "key": "root",
          "label": "root",
          "direction": "bidirectional",
          "dataType": "any",
          "angle": 270,
          "position": {
            "side": "top",
            "offset": 0.2
          }
        }
      ],
      "handles": [
        {
          "id": "root",
          "key": "root",
          "label": "root",
          "direction": "bidirectional",
          "dataType": "any",
          "angle": 270,
          "position": {
            "side": "top",
            "offset": 0.2
          },
          "portId": "root"
        }
      ],
      "visible": true,
