    {
      "id": "assemble-page-method",
      "type": "method",
      "label": "Assemble the page",
      "position": {
        "x": 2800,
        "y": 0
      },
      "width": 420,
      "height": 260,
      "visible": true,
      "showLabel": true,
      "ports": [
        {
          "id": "call",
          "key": "call",
          "label": "Call",
          "direction": "input",
          "dataType": "event",
          "angle": 180
        },
        {
          "id": "result",
          "key": "result",
          "label": "Result",
          "direction": "output",
          "dataType": "value",
          "angle": 0
        }
      ],
      "handles": [
        {
          "id": "call",
          "key": "call",
          "label": "Call",
          "direction": "input",
          "dataType": "event",
          "angle": 180,
          "portId": "call"
        },
        {
          "id": "result",
          "key": "result",
          "label": "Result",
          "direction": "output",
          "dataType": "value",
          "angle": 0,
          "portId": "result"
        }
      ],
      "data": {
        "scriptName": "Assemble the page",
        "parameters": [],
        "source": "// Assembles the page from its pieces and writes it into the views the Declaration exposes.\n// Every piece class has a change Handler, and the graph structure has one, and all of them call this Method,\n// so the stored page is always current. It reads the pieces in graph order and writes only the three\n// exposed views, which its declared effects say.\n//\n// A region is a piece too: a titled place on the canvas that other nodes sit inside. Whatever is inside it (by the\n// centre of the node) is listed in its band on the page, and is not repeated as a piece of its own. Its text stays in a\n// narrow column so the rest of the band is free.\nconst ROLES = ['page-masthead', 'page-route', 'page-section', 'page-settings', 'page-region'];\nconst MACHINERY = ['declaration', 'view', 'glyph', 'bridge', 'method', 'event-handler', 'script', 'port'];\n\nconst clean = (value) => String(value ?? '').trim();\nconst escapeHtml = (value) => clean(value)\n  .replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/\"/g, '&quot;').replace(/'/g, '&#39;');\nconst paragraphs = (value) => clean(value).split(/\\n{2,}/).map((part) => part.trim()).filter(Boolean)\n  .map((part) => `<p style='margin:0 0 12px;font:400 16px/1.6 system-ui;color:#334155'>${escapeHtml(part).replace(/\\n/g, '<br>')}</p>`).join('');\n// Rows are { label, value } pairs, or \"label: value\" lines.\nconst settingRows = (rows) => (Array.isArray(rows) ? rows : []).map((row) => {\n  if (row && typeof row === 'object') return [clean(row.label), clean(row.value)];\n  const text = clean(row);\n  const cut = text.indexOf(':');\n  return cut < 0 ? [text, ''] : [clean(text.slice(0, cut)), clean(text.slice(cut + 1))];\n}).filter(([name, value]) => name || value);\nconst roleOf = (node) => clean(node?.data?.definitionKey || node?.type);\n\n// --- Regions: what sits inside one --------------------------------------------------------------\nconst isRegion = (node) => roleOf(node) === 'page-region';\nconst centreOf = (node) => ({ x: Number(node?.position?.x || 0) + Number(node?.width || 0) / 2, y: Number(node?.position?.y || 0) + Number(node?.height || 0) / 2 });\nconst membersOf = (region, nodes) => {\n  const left = Number(region.position?.x || 0); const top = Number(region.position?.y || 0);\n  const right = left + Number(region.width || 0); const bottom = top + Number(region.height || 0);\n  return nodes.filter((node) => node !== region && !isRegion(node) && !MACHINERY.includes(clean(node.type).toLowerCase()))\n    .filter((node) => { const c = centreOf(node); return c.x >= left && c.x <= right && c.y >= top && c.y <= bottom; });\n};\nconst entryText = (node) => {\n  const data = node.data || {};\n  if (Array.isArray(data.rows)) return settingRows(data.rows).map(([name, value]) => `${name}: ${value}`).join('\\n');\n  for (const key of ['body', 'markdown', 'text', 'value', 'description', 'meaning']) if (clean(data[key])) return clean(data[key]);\n  return typeof data.content?.value === 'string' ? clean(data.content.value) : '';\n};\nconst entry = (node) => `<article data-role='entry' style='box-sizing:border-box;padding:16px 18px;border-radius:14px;background:#f8fafc;border:1px solid #e2e8f0'>`\n  + `<h3 style='margin:0 0 6px;font:800 16px/1.3 system-ui;color:#0f172a'>${escapeHtml(node.data?.title || node.data?.name || node.label || node.id)}</h3>`\n  + entryText(node).split(/\\n{2,}/).filter(Boolean).map((part) => `<p style='margin:0 0 8px;max-width:60ch;font:400 14px/1.55 system-ui;color:#475569'>${escapeHtml(part).replace(/\\n/g, '<br>')}</p>`).join('') + `</article>`;\n\n// --- One renderer per role: what that piece contributes to the stack ----------------------------\nconst RENDER = {\n  'page-region': (data, members = []) => `<section data-role='region' style='display:grid;grid-template-columns:minmax(200px,280px) 1fr;gap:16px 40px;padding:28px 40px;border-top:1px solid #e2e8f0'>`\n    + `<div><h2 style='margin:0 0 10px;font:800 26px/1.2 system-ui;color:#0f172a'>${escapeHtml(data.title)}</h2>`\n    + (clean(data.hint) ? `<p style='margin:0;max-width:26ch;font:400 14px/1.55 system-ui;color:#64748b'>${escapeHtml(data.hint)}</p>` : '') + `</div>`\n    + `<div style='display:grid;grid-template-columns:repeat(auto-fill,minmax(220px,1fr));gap:16px;align-content:start'>`\n    + (members.length ? members.map(entry).join('') : `<p style='margin:0;font:italic 400 14px/1.5 system-ui;color:#94a3b8'>Nothing here yet. Add nodes to this region.</p>`) + `</div></section>`,\n  'page-masthead': (data) => `<header data-role='masthead' style='padding:56px 40px 32px'>`\n    + (clean(data.eyebrow) ? `<div style='font:800 12px/1 system-ui;letter-spacing:.18em;color:#7c3aed;margin-bottom:16px'>${escapeHtml(data.eyebrow)}</div>` : '')\n    + `<h1 style='margin:0 0 14px;font:850 44px/1.05 system-ui;color:#0f172a'>${escapeHtml(data.title)}</h1>`\n    + (clean(data.subtitle) ? `<p style='margin:0;font:400 20px/1.5 system-ui;color:#475569'>${escapeHtml(data.subtitle)}</p>` : '')\n    + `</header>`,\n  'page-route': (data) => {\n    const primary = clean(data.prominence).toLowerCase() !== 'secondary';\n    return `<section data-role='route' data-prominence='${primary ? 'primary' : 'secondary'}' style='margin:0 40px 16px;padding:22px 26px;border-radius:18px;`\n      + `${primary ? 'background:#ede9fe;border:1px solid #c4b5fd' : 'background:#f8fafc;border:1px solid #e2e8f0'}'>`\n      + `<h2 style='margin:0 0 8px;font:800 ${primary ? 24 : 18}px/1.2 system-ui;color:#0f172a'>${escapeHtml(data.title)}</h2>`\n      + (clean(data.body) ? `<p style='margin:0 0 12px;font:400 15px/1.55 system-ui;color:#475569'>${escapeHtml(data.body)}</p>` : '')\n      + `<span style='font:700 13px/1 system-ui;color:#6d28d9'>${escapeHtml(data.destinationLabel || 'Open')} →</span></section>`;\n  },\n  'page-settings': (data) => `<section data-role='settings' style='padding:24px 40px'>`\n    + `<h2 style='margin:0 0 12px;font:800 26px/1.2 system-ui;color:#0f172a'>${escapeHtml(data.title || 'Settings')}</h2>`\n    + `<dl style='margin:0;display:grid;grid-template-columns:max-content 1fr;gap:8px 24px;padding:18px 22px;border-radius:14px;background:#f8fafc;border:1px solid #e2e8f0'>`\n    + settingRows(data.rows).map(([name, value]) => `<dt style='font:700 13px/1.5 system-ui;color:#64748b'>${escapeHtml(name)}</dt><dd style='margin:0;font:500 15px/1.5 system-ui;color:#0f172a'>${escapeHtml(value)}</dd>`).join('')\n    + `</dl></section>`,\n  'page-section': (data) => `<section data-role='section' style='padding:24px 40px'>`\n    + `<h2 style='margin:0 0 12px;font:800 26px/1.2 system-ui;color:#0f172a'>${escapeHtml(data.title)}</h2>${paragraphs(data.body)}</section>`\n};\n\n// --- The three views --------------------------------------------------------------------------\nconst stackPage = (pieces) => `<div style='min-height:100%;box-sizing:border-box;background:#ffffff;font-family:system-ui'>`\n  + pieces.map(({ role, data, members }) => RENDER[role](data, members)).join('') + `</div>`;\nconst stackSummary = (pieces) => {\n  const title = pieces.find((piece) => piece.role === 'page-masthead')?.data.title;\n  const routes = pieces.filter((piece) => piece.role === 'page-route').map((piece) => clean(piece.data.title)).filter(Boolean);\n  return `<div style='box-sizing:border-box;width:100%;height:100%;min-height:100%;padding:24px;background:#ffffff;font-family:system-ui;color:#0f172a'>`\n    + `<div style='font:850 24px/1.1 system-ui'>${escapeHtml(title || 'Untitled page')}</div>`\n    + (routes.length ? `<div style='margin-top:12px;font:600 13px/1.6 system-ui;color:#6d28d9'>${routes.map(escapeHtml).join(' · ')}</div>` : '')\n    + `<div style='margin-top:12px;font:500 12px/1 system-ui;color:#94a3b8'>${pieces.length} piece${pieces.length === 1 ? '' : 's'}</div></div>`;\n};\nconst stackIcon = (pieces) => {\n  const title = pieces.find((piece) => piece.role === 'page-masthead')?.data.title;\n  return `<div style='box-sizing:border-box;width:100%;height:100%;min-height:100%;padding:16px;background:#ede9fe;border-radius:18px;display:flex;align-items:center;justify-content:center;text-align:center;font:800 22px/1.15 system-ui;color:#0f172a'>${escapeHtml(title || 'Page')}</div>`;\n};\n\n// --- Run --------------------------------------------------------------------------------------\nconst nodes = await api.getNodes();\nconst edges = await api.getEdges();\n// The page, in graph order. What sits inside a region is listed in the region's band, not repeated as its own piece.\nconst held = new Set(nodes.filter(isRegion).flatMap((region) => membersOf(region, nodes).map((node) => node.id)));\nconst pieces = nodes.filter((node) => ROLES.includes(roleOf(node)) && !held.has(node.id))\n  .map((node) => ({ role: roleOf(node), data: node.data || {}, ...(isRegion(node) ? { members: membersOf(node, nodes) } : {}) }));\n\nconst declaration = nodes.find((node) => node?.type === 'declaration');\nconst exposed = [['default-view', stackPage], ['summary-view', stackSummary], ['icon-view', stackIcon]];\nconst updated = [];\nfor (const [handle, build] of exposed) {\n  const viewId = edges.find((edge) => edge.source === declaration?.id && edge.sourceHandle === handle)?.target;\n  if (!viewId) continue;\n  await api.updateView(viewId, { content: { kind: 'html', value: build(pieces) } });\n  updated.push(viewId);\n}\nreturn { updated, pieces: pieces.length };\n",
        "effects": [
          {
            "kind": "update-node",
            "targets": [
              "edge-class-page-icon",
              "edge-class-page-summary",
              "edge-class-page-detail"
            ]
          }
        ],
        "allowMutations": true,
        "dryRun": false
      }
    },
    {
      "id": "edge-class-page-masthead",
