      "data": {
        "identity": {
          "graphId": "edge-class-page"
        },
        "title": "Description and rationale",
        "body": "A supports edge connects a piece of evidence to the claim it backs. It reads: this evidence supports that claim.\n\nEvidence and claims used to be linked by a plain reference edge, which hid which way the support ran and which links were about evidence at all. A class of its own lets a page list a claim's evidence and lets a check confirm the two ends.",
        "presentation": {
          "glyph": {
            "kind": "icon",
            "name": "Article"
          }
        },
        "definitionKey": "page-section",
        "_classBinding": {
