      ],
      "data": {
        "title": "Templates",
        "purpose": "Browse reusable graph templates stored directly under the templates directory.",
        "capabilityRole": "collection-surface",
        "collectionView": {
          "columns": 3,
          "cardWidth": 500,
          "cardHeight": 320,
          "gapX": 100,
          "gapY": 80,
          "origin": {
            "x": -60,
